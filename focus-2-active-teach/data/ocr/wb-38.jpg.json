[{"x":0.098765432785102192,"text":"3.","y":0.056686046763290143,"w":0.0411522626876831,"h":0.02761627863911742},{"x":0.13374485537133446,"h":0.020348837600802305,"y":0.059593023156963243,"text":"4","w":0.026748971939086902},{"text":"READING","x":0.21806435940010238,"y":0.028901780157000401,"h":0.019231323215252338,"w":0.14823342323303224},{"y":0.069726390105537606,"h":0.011668958605019708,"w":0.22839506149291994,"text":"Readers • books • film reviews","x":0.2181069982864618},{"h":0.013239187996469504,"x":0.21604938444100419,"y":0.084289496869007885,"w":0.18518518447875976,"text":"• cinema • phrasal verbs"},{"text":"Read book reviews A-F. Mark them as Ffor fiction or","w":0.39711933135986327,"x":0.098765430582071337,"y":0.13662790737240604,"h":0.010327079500230374},{"h":0.011679221756776048,"text":"N for non-fiction.","w":0.12551440238952638,"y":0.15116279076618688,"x":0.1111111136543451},{"x":0.10905349787398601,"y":0.16860465130397762,"w":0.016460905075073237,"text":"A","h":0.011627906839719149},{"x":0.18106995903646758,"w":0.010288065671920782,"y":0.16860465165535188,"h":0.01017441795867613,"text":"B"},{"w":0.037037036418914815,"h":0.014534883760080164,"x":0.45679012350864956,"text":"FU","y":0.16715116295280874},{"h":0.01191526919682262,"y":0.18887908200525105,"text":"2 Read descriptions 1-5 about people's taste in books","w":0.40329216003417973,"x":0.08641976763723104},{"text":"and book reviews A-F. Decide which book would be","y":0.20344218902032618,"w":0.37860080718994144,"h":0.010220601299854915,"x":0.10905351060256006},{"text":"most suitable for each person to read. There is one","x":0.10905349401918273,"w":0.37037036895751951,"y":0.2165697677676035,"h":0.013081394879037145},{"w":0.094650201797485387,"text":"extra review.","h":0.010174417958676241,"x":0.10905350028438489,"y":0.23255813973069095},{"text":"1 Gareth","x":0.10895024554215073,"w":0.072222967147827152,"y":0.24816898482774497,"h":0.010929472132899076},{"y":0.26301843881527365,"w":0.063826088905334477,"text":"2 Karen","x":0.10903345824297606,"h":0.01030033158708854},{"w":0.010288065671920754,"h":0.010174417958676241,"text":"5","x":0.32098765432967746,"y":0.26308139554464449},{"h":0.010233292407097361,"w":0.035013718605041488,"x":0.34566186532696075,"y":0.24851707468249029,"text":"Sean"},{"text":"Jemma","x":0.34362140006101105,"y":0.26308139550225107,"w":0.053497939109802273,"h":0.010174417958676241},{"h":0.010493031878020975,"w":0.074160604476928724,"x":0.10901023348206258,"y":0.27745697239266676,"text":"3 Nathan"},{"w":0.098765430450439451,"x":0.092592593896865305,"text":"1 Gareth, 16","y":0.3110465114870935,"h":0.015988372641123183},{"text":"I'm training to be a professional chef, so I'm very","y":0.33575581378293895,"h":0.010228299294965826,"x":0.10905350316714689,"w":0.34979423522949216},{"y":0.34863195077139963,"x":0.10905350914540229,"text":"busy. When I find time to read, I like books that","w":0.33744853973388672,"h":0.01191526919682262},{"y":0.36319505749510061,"w":0.34567901611328128,"x":0.10905349132607561,"text":"help me forget about my work and studies. I love","h":0.011915269196822509},{"x":0.10905350499303239,"w":0.35185184478759762,"h":0.010323231133968602,"text":"reading about the real lives of successful, famous","y":0.37775816424006925},{"y":0.39389534869572973,"text":"people. I'm not really into romantic stories.","w":0.31069957733154296,"x":0.10905350662229431,"h":0.010341191439110942},{"text":"2 Karen, 18","h":0.011768565805002518,"x":0.13989925346587603,"y":0.43452269403662791,"w":0.088514251708984387},{"y":0.45763459859407374,"x":0.15226337633659462,"text":"I'm a student and I don't have much time to","w":0.28600822448730467,"h":0.010591350397175736},{"y":0.47219770533881333,"w":0.27777776718139646,"x":0.15226337631156525,"text":"read for pleasure. I enjoy practical books","h":0.01191526919682262},{"y":0.48676081197465582,"h":0.011915269196822509,"w":0.27983537673950193,"x":0.15226338625301977,"text":"- one of my favourites is 101 Things Every"},{"w":0.28395061492919921,"y":0.50132391868635884,"text":"Student Needs to Know.I hate books about","x":0.15226337093046227,"h":0.010303988040072265},{"y":0.51588702576728873,"h":0.010275764583173475,"w":0.1378600788116455,"text":"monsters and space.","x":0.15226337852970531},{"text":"3 Nathan, 16","w":0.098857650756835946,"h":0.013432782620112715,"y":0.55796384096748952,"x":0.10283454981315554},{"w":0.32716049194335939,"text":"I love getting lost in great stories. I enjoy reading","x":0.11728394746967843,"y":0.58120035284645055,"h":0.011915269196822509},{"h":0.010341191439110942,"x":0.11728394471811314,"w":0.3230452728271484,"text":"stories about the lives, love and relationships of","y":0.59576345989422907},{"w":0.31687242507934565,"x":0.11728395603028588,"h":0.010312967982212151,"text":"people from the past. I like a book to make me","y":0.61032656648767836},{"text":"laugh and cry, and to show me what life was like","x":0.11522633825083312,"h":0.01162790683971926,"w":0.33333332061767579,"y":0.62354651174486908},{"y":0.63808139520735752,"w":0.22016460418701173,"h":0.010197510260559262,"x":0.11728395525217315,"text":"in other countries, at other times."},{"w":0.082304525375366228,"h":0.01326099624701127,"text":"4 Sean, 15","x":0.14403292308539156,"y":0.68005295693378653},{"h":0.011627906839719149,"text":"1 like books where the heroes are teenagers","w":0.28600822448730467,"x":0.15843621998371382,"y":0.70203488393479152},{"x":0.15843622425831805,"w":0.26748970031738278,"y":0.71656976746192336,"text":"like me. I prefer stories that don't follow","h":0.01162790683971926},{"x":0.15843622057911211,"h":0.010289876522054153,"text":"the rules of the real world. My favourite","w":0.26337448120117191,"y":0.73110465141310377},{"y":0.74563953500068303,"w":0.25102880477905276,"x":0.15843621071061101,"h":0.011642018357737371,"text":"books have incredible people, strange"},{"text":"aliens and amazing events. I don't like","w":0.25308641433715817,"y":0.76017441872161329,"x":0.15843621248162684,"h":0.011670241393773595},{"x":0.16049383610668624,"y":0.77316857900042302,"w":0.19341562271118165,"text":"stories with romance in them.","h":0.010261653065155363},{"text":"5 Jemma, 18","w":0.098847904205322273,"x":0.11106987629160095,"y":0.8166833800399792,"h":0.011982076902465333},{"x":0.12551439791427221,"h":0.01191526919682262,"text":"I'm studying Science, but I prefer fictional books","y":0.83848190638239495,"w":0.32304527282714846},{"x":0.12345679881692252,"h":0.010327079500230374,"text":"that make me forget about the real world. When","y":0.85304501310919489,"w":0.33127571105957027},{"x":0.12345679798178757,"text":"I was a little giri, l used to imagine 1 had magic","y":0.86627906964215584,"w":0.31275718688964849,"h":0.011627906839719149},{"y":0.88081395375068305,"x":0.12551440150843512,"h":0.01162790683971926,"text":"powers. I killed monsters and fought dragons -","w":0.31893003463745118},{"w":0.3148147964477539,"h":0.011627906839719149,"text":"things like that. Now I'm older, I like stories that","x":0.12139918212591741,"y":0.8953488374716132},{"x":0.12345678987163439,"y":0.9084302324328537,"w":0.18312757492065429,"h":0.01169333327479416,"text":"mix romance with fantasy."},{"h":0.01162790683971926,"x":0.08641975346882734,"y":0.94767441861087143,"w":0.024691357612609863,"text":"36"},{"x":0.54305666811934938,"h":0.0092760912633426118,"y":0.046234047455285143,"text":"•0G","w":0.031170613765716615},{"h":0.011627906839719149,"x":0.55555555598445783,"w":0.020576131343841508,"text":"A","y":0.065406976740024159},{"x":0.55761317293778534,"h":0.014729879434826287,"y":0.081200353026609218,"text":"The Great Gatsby by F. Scott Fitzgerald","w":0.32716049194335939},{"y":0.10900264783943636,"w":0.3559670639038085,"text":"The Great Gatsby is the story of rich, successful","h":0.013239187996469504,"x":0.55349794656318485},{"w":0.3559670639038085,"h":0.013081394879037256,"text":"Jay Gatsby and his beautiful friend Daisy","x":0.55349794596990654,"y":0.12209302356338836},{"x":0.55555556863108591,"text":"Buchanan. They live in a magical world of love,","w":0.35596706390380861,"h":0.013081394879037367,"y":0.13662790723586893},{"x":0.55349794837216981,"y":0.15116279109609176,"w":0.3559670639038085,"text":"jazz and champagne in 1920s New York. There is","h":0.013081394879037367},{"text":"romance and happiness, but like in many classic","y":0.16548985015578133,"w":0.3559670639038085,"x":0.55349794507998884,"h":0.011915269196822509},{"y":0.1787290380920622,"text":"novels, there is also sadness and heartbreak.","h":0.013239187996469615,"x":0.55349793781971879,"w":0.32510288238525398},{"w":0.29629629135131841,"h":0.014563106796116498,"text":"Real Food, Real Fast by Sam Stern","y":0.2180052958228893,"x":0.55761317415973166},{"w":0.3559670639038085,"text":"Teenage chef Sam Stern introduces delicious","x":0.55349794531147045,"h":0.013081394879037256,"y":0.24563953533664418},{"y":0.26017441860048929,"w":0.3559670639038085,"h":0.011670241393773484,"text":"healthy recipes which you can have on your plate","x":0.55349795397916557},{"x":0.55136565577752994,"y":0.27287673808198487,"w":0.35820114135742187,"text":"in just a few minutes. This useful book is great for","h":0.013576094281431472},{"text":"amateur chefs and busy students. Sam's recipes","y":0.28773168563603657,"h":0.013239187996469504,"w":0.35596706390380861,"x":0.55349795189583229},{"text":"are cheap, fast and delicious.","x":0.55349795066781571,"y":0.3022947925716174,"w":0.21193414688110346,"h":0.013239187996469615},{"text":"Ritz Paris: Haute Cuisine","y":0.3401162792610628,"h":0.013081394879037145,"x":0.55555556019044472,"w":0.22016460418701178},{"text":"Do you want to learn to cook like a protessional","x":0.55349795397916557,"y":0.36918604647112874,"w":0.3559670639038085,"h":0.011661261451633709},{"x":0.55144033219908439,"h":0.013239187996469504,"y":0.38217122669855796,"w":0.35802467346191402,"text":"chef? Are you interested in thehistory of great"},{"w":0.35596706390380861,"x":0.5514403304280685,"y":0.3967343336857746,"h":0.01191526919682262,"text":"French food? This is not a cookbook for the"},{"text":"average home cook. The recipes are long and","x":0.55144033191126451,"y":0.41129744046696604,"h":0.01166767581626571,"w":0.35596706390380861},{"x":0.55144033191126451,"h":0.011639452780229487,"y":0.42586054722393252,"w":0.35596706390380861,"text":"challenging, the ingredients are unusual and"},{"text":"expensive and the food ... is absolutely delicious!","y":0.43895348854961713,"h":0.011627906839719149,"w":0.3539094543457032,"x":0.55144033013167526},{"h":0.014741425375336625,"text":"Twilight by Stephenie Meyer","x":0.55555556122149763,"w":0.23251028060913093,"y":0.47819767430213034},{"y":0.50573698156571012,"w":0.35596706390380861,"h":0.013239187996469504,"x":0.55144033618938504,"text":"This is a fantastic story about a young student"},{"text":"called Bella. She falls in love with Edward and","w":0.35596706390380861,"y":0.51889534883304744,"x":0.55144033932724523,"h":0.011627906839719149},{"text":"then finds out he's a vampire. Vampires are usually","h":0.011648432722369373,"w":0.35596706390380861,"y":0.53486319500708324,"x":0.55144034081044135},{"w":0.36008228302001954,"text":"found in stories of the past, but Stephenie Meyer's","x":0.54732511329966105,"y":0.54796511644118084,"h":0.014700373610036066},{"y":0.56250000039841752,"text":"book brings them to modern America. This book","x":0.551440333865997,"w":0.35596706390380861,"h":0.013081394879037256},{"text":"will make you laugh, cry and dream of romance","x":0.55144034081044135,"h":0.01166767581626571,"y":0.57703488371676837,"w":0.35596706390380861},{"y":0.59135039716585236,"w":0.31893003463745118,"h":0.01191526919682262,"text":"with vampires! We think it is a future classic.","x":0.54938272462228921},{"y":0.62930273632308698,"text":"Night of the Purple Moon by Scott Cramer","x":0.55144032744698235,"h":0.01459261262090672,"w":0.34979423522949216},{"h":0.011629190049335603,"y":0.65842894961083409,"w":0.35390945434570309,"x":0.55144033181205943,"text":"Scientists say a comet from deep space is passing"},{"w":0.35596706390380861,"x":0.55144033592361008,"text":"Earth and it will make the moon purple. Teenager","h":0.013239187996469504,"y":0.66990291248720435},{"h":0.011658695874125824,"y":0.68604651160921015,"x":0.55144033809463811,"text":"Abby Leigh is looking forward to watching this","w":0.35390945434570309},{"y":0.70058139530833807,"w":0.35802467346191402,"x":0.54938272947274658,"h":0.011686918910162158,"text":"happen. But the comet carries a terrible secret -"},{"x":0.5493827187425403,"text":"an alien virus that kills all the world's adults. Abby","w":0.35596706390380861,"h":0.01191526919682262,"y":0.71359223286424533},{"y":0.7281553398749232,"text":"is suddenly responsible for her brother and young","w":0.35596706390380861,"h":0.011670241393773595,"x":0.54938272675179933},{"h":0.011642018357737371,"y":0.74271844679904075,"x":0.54938271773854963,"text":"sister's survival in this world without adults.","w":0.31069957733154296},{"x":0.55349794477445124,"text":"Steve Jobs: The Exclusive Biography","h":0.013081394879037256,"y":0.780523255976179,"w":0.32510288238525398},{"x":0.55349794398795671,"y":0.79346866705991059,"h":0.014670867785245845,"w":0.15226337432861325,"text":"by Walter Isaacson"},{"x":0.54938272912491304,"y":0.81976744183207828,"w":0.3559670639038085,"h":0.011653564298247598,"text":"This is the lifestory of Apple's former boss"},{"h":0.010357868534636938,"x":0.54938272764171703,"y":0.83430232584987707,"w":0.35596706390380861,"text":"Steve Jobs. Walter Isaacson tells us about the"},{"w":0.3539094543457032,"x":0.54938272492591378,"y":0.84863195045712625,"h":0.01191526919682262,"text":"professional and personal life of one of modern"},{"x":0.54938272764171703,"w":0.35596706390380861,"text":"America's most successful businessmen. We","h":0.01167537296965182,"y":0.8618711385170682},{"text":"learn about Jobs' family, his loves and the ideas","x":0.54732510409061996,"y":0.87643424553732163,"w":0.35596706390380861,"h":0.013239187996469504},{"w":0.35596706390380861,"y":0.89098837224313643,"text":"he had for the future of Apple before his sad death","h":0.013248167938609501,"x":0.54732511298979658},{"h":0.013295958132630181,"y":0.90468923026395476,"w":0.062316775321960449,"x":0.54908852694731236,"text":"in 2011."}]
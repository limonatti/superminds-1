[{"w":0.037037036418914801,"h":0.018895348719759286,"text":"7.9","x":0.10699588511701723,"y":0.013081395250100991},{"y":0.013081395298436105,"w":0.25514402389526369,"text":"EXAM SPEAKING","x":0.18724280463085136,"h":0.020457881378685538},{"text":"1 In pairs, ask and answer the questions.","y":0.07848837234609185,"h":0.013081394879037256,"x":0.094650203891305296,"w":0.30658435821533203},{"y":0.097277673409408183,"w":0.045348596572875974,"x":0.11930101025247268,"text":"PART 1","h":0.0089330252355320772},{"x":0.11728395263754131,"y":0.11473962938244253,"w":0.12551440238952638,"text":"Talk about work.","h":0.010260370276401365},{"y":0.12790697693548136,"text":"1 Do you want a job where you can work indoors","w":0.34979423522949216,"x":0.11728395584204396,"h":0.013081394879037256},{"h":0.010250107545507592,"w":0.090534973144531239,"x":0.14197531301621169,"y":0.14244186061853004,"text":"or outdoors?"},{"w":0.32098766326904299,"x":0.11728394213091071,"text":"2 What kind of skills do social workers need?","y":0.15697674456353983,"h":0.010278330581543815},{"text":"3 Would you like to be a journalist?","h":0.013239187996469615,"x":0.11728396015088741,"y":0.16990291255987866,"w":0.25720163345336911},{"y":0.18446601933501383,"x":0.13786008226908886,"text":"Why?\/Why not?","w":0.11316872596740724,"h":0.013239187996469504},{"h":0.013269976610013612,"w":0.34362140655517581,"x":0.11522632803242601,"y":0.19767441886377601,"text":"4 What kind of job do you think your best friend"},{"y":0.21359223281337325,"x":0.1399176938656177,"text":"would like to do in the future? Why?","w":0.25102880477905276,"h":0.01191526919682262},{"text":"5 Do you want to do a job where you have to spend","x":0.11719573601060748,"w":0.36846416473388666,"y":0.22805500571576087,"h":0.011886384565011565},{"text":"a lot of time away from home? Why?\/Why not?","x":0.1399176968425985,"y":0.24271844643279872,"w":0.32304527282714846,"h":0.010188529897556808},{"w":0.3148148155212403,"text":"2 Look at the photos of people shopping.","h":0.014674716151507616,"x":0.092592595387527968,"y":0.26875551639713713},{"text":"PART 2","x":0.56160358967445478,"w":0.04963232517242433,"y":0.098470677488002312,"h":0.0094539940304601},{"text":"Talk about shopping.","y":0.11606354827855803,"w":0.16049381256103512,"h":0.01191526919682262,"x":0.56172840503635468},{"h":0.013239187996469504,"y":0.12930273608765874,"text":"1 Do you ever shop in charity shops?","w":0.26748970031738284,"x":0.56172839752649395},{"w":0.11522633552551265,"h":0.013081394879037256,"x":0.58230452627016549,"text":"Why?\/Whynot?","y":0.14389534912661506},{"x":0.56172839846060285,"h":0.011629189628473036,"y":0.15842894977975863,"text":"2 When was the last time you bought an item on","w":0.34773662567138675},{"y":0.17151162797835928,"h":0.013081394879037256,"w":0.22839506149291988,"x":0.58436213877514509,"text":"special offer? What did you buy?"},{"h":0.013081394879037256,"x":0.56172841138396079,"y":0.18604651177196396,"w":0.38271602630615231,"text":"3 In what situations is window shopping useful? Why?"},{"x":0.56172840034192228,"text":"4 Why do you need to keep your receipts?","y":0.20058139574725464,"w":0.30658435821533203,"h":0.013081394879037256},{"x":0.56172839624146997,"w":0.25925926208496097,"h":0.013239187996469615,"text":"5 What's your favourite shop? Why?","y":0.21359223284894679},{"h":0.013081394879037256,"y":0.53779069789114997,"text":"Take turns to talk about what you can see in the photos.","w":0.41769546508789057,"x":0.11111112041387347},{"x":0.11111111920114773,"w":0.18106994628906248,"y":0.55232558143479149,"h":0.011663827029141594,"text":"1 Talk about the people."},{"h":0.011692050486040162,"text":"2 Talk about the places.","w":0.17283950805664064,"y":0.56686046514845445,"x":0.1111111123297043},{"y":0.57987643428916602,"w":0.35185184478759768,"x":0.11111112050743557,"text":"3 Talk about the other things in the photographs.","h":0.013239187996469504},{"text":"Read the instructions on your card. In pairs, take turns to role-play the conversation.","x":0.11111112086927605,"y":0.60900264776070567,"h":0.013239187996469504,"w":0.61111110687255854},{"text":"Student A","w":0.076187081336975104,"x":0.13371716018924076,"y":0.63797712903443782,"h":0.01038295067419337},{"h":0.010394080381738613,"x":0.55552558769858695,"y":0.63942505275751527,"text":"Student B","w":0.07413401126861574},{"x":0.13374485939472958,"w":0.3148148155212403,"h":0.013290502071801491,"y":0.66279069807283597,"text":"You are a shop assistant in a clothes shop."},{"x":0.1337448483219604,"h":0.011627906839719149,"text":"A customer, Student B, comes to the checkout","w":0.34567901611328122,"y":0.67732558146386146},{"h":0.010174417958676241,"w":0.0411522626876831,"y":0.69040697693999331,"x":0.1337448558475165,"text":"desk."},{"x":0.1316872474166349,"h":0.01324560194023916,"text":"• Greet Student B and ask if you can help","w":0.30452672958374022,"y":0.70784883746842708},{"w":0.063821091651916489,"x":0.15430344700676987,"h":0.010284547561685953,"y":0.72232865642932653,"text":"him\/her."},{"y":0.73691860468333803,"w":0.32098766326904299,"text":"• Ask him\/her what is wrong with the jacket.","x":0.13374485550539611,"h":0.01162790683971926},{"h":0.011627906839719149,"y":0.75145348840426829,"text":"• Ask when he\/she bought the jacket.","w":0.27777776718139646,"x":0.133744864737491},{"w":0.25720163345336916,"h":0.013273825397137839,"y":0.76434245346195451,"x":0.13168724483024291,"text":"• Ask if he\/she has his\/her receipt."},{"w":0.32921810150146485,"y":0.7789055604127193,"x":0.13168724479110572,"text":"• Offer to exchange the jacket for a new one.","h":0.013245602361101616},{"text":"• Agree and give him\/her a refund.","x":0.13168724754609354,"w":0.2613168716430665,"h":0.01191526919682262,"y":0.79346866715768793},{"h":0.013290502071801491,"text":"You are a customer in a clothes shop and you","w":0.33539093017578125,"y":0.66279069807283597,"x":0.55555556739667722},{"text":"want to make a complaint. Talk to Student B,","w":0.33539093017578125,"y":0.67732558146386135,"h":0.01162790683971926,"x":0.55555556791108041},{"y":0.69186046541504176,"x":0.55555556035010145,"w":0.14403291702270504,"text":"the shop assistant.","h":0.010257804698893591},{"x":0.55349794741823788,"y":0.70917917028133193,"w":0.32716049194335939,"h":0.01191526919682262,"text":"• Say yes and explain that you want to return"},{"y":0.72238372080494662,"h":0.01162790683971926,"text":"a leather jacket.","x":0.57407407366385543,"w":0.11522633552551265},{"h":0.013302048012311718,"y":0.73691860504958029,"x":0.55349794436105471,"text":"• Explain that the zip doesn't work and that you","w":0.34567901611328122},{"h":0.01162790683971926,"w":0.11111110687255876,"text":"think it's faulty.","y":0.75145348848905513,"x":0.57407407434149849},{"x":0.55349794193121526,"y":0.76598837219787297,"w":0.25308641433715817,"h":0.011627906839719149,"text":"• Say that you bought it last week."},{"text":"• Say yes and give Student A your receipt.","y":0.77890556039753533,"w":0.30864196777343744,"x":0.55349794190203316,"h":0.01324560194023916},{"y":0.79346866716968578,"x":0.55349794870057067,"text":"• Say no thank you and explain that you want","w":0.3292181015014648,"h":0.013239187996469504},{"text":"a refund.","w":0.065948414802551314,"h":0.010517768489504253,"y":0.80796785991883102,"x":0.57607929136394398},{"h":0.013081394879037256,"x":0.91152263379657572,"w":0.024691357612609877,"y":0.94912790727523433,"text":"99"}]
2338923214635259,"w":0.35185184478759768,"text":"A The photography is fantastic and the 'remake \/","h":0.013239187996469504,"x":0.55555556495187997},{"w":0.34979423522949216,"h":0.013239187996469504,"text":"screenplay holds your attention from beginning to","x":0.57818930796824419,"y":0.24845542789652919},{"x":0.57818930977110061,"text":"end. Alex is very interesting and at times he is quite","w":0.35802467346191402,"h":0.013239187996469504,"y":0.26301853494419336},{"x":0.57818930928805368,"y":0.27758164165040222,"w":0.3539094543457032,"text":"funny. The final thirty minutes is probably the most","h":0.011662544240387596},{"text":"amazing thing l've ever watched on the big ?screen \/","y":0.28905560495599913,"w":0.36008228302001954,"x":0.57818931407126595,"h":0.014723464649331719},{"y":0.30801518024698293,"text":"scene.","h":0.0089696394271380209,"x":0.57814390948036964,"w":0.047415885925293},{"w":0.37448558807373045,"h":0.01191526919682262,"text":"B I don't usually watch documentaries, but Free Solo","y":0.32259488077821008,"x":0.55555555612774388},{"w":0.3193712997436523,"text":"has totally changed my opinion. The film stars","x":0.57796527320766988,"h":0.018046118996360105,"y":0.33314136061909405},{"y":0.35029069754913267,"w":0.36213989257812507,"h":0.011627906839719149,"text":"American rock climber Alex Honnold as he prepares","x":0.57818931070682222},{"x":0.57818930934879764,"y":0.36482558155107059,"w":0.36213989257812496,"text":"to climb a 900-metre vertical rock face without using","h":0.011627906839719149},{"text":"a rope. 'Directed \/ Starring by Jimmy Chin and","y":0.37775816400663298,"h":0.013239187996469504,"w":0.32510288238525387,"x":0.57818929591299739},{"text":"Elizabeth Chai Vasarhelyi, the film was *awarded \/","x":0.58024690976253568,"y":0.39232127114514004,"w":0.34362140655517581,"h":0.013239187996469615},{"text":"based an Oscar for the best documentary in 2018.","y":0.40688437771436425,"h":0.013239187996469615,"x":0.57818930796824419,"w":0.34979423522949216},{"text":"C In my view, Free Solo is Sa masterpiece \/ suitable for","x":0.55555557274688339,"y":0.42441860478431859,"w":0.38477363586425783,"h":0.013081394879037256},{"x":0.57801598437776081,"h":0.015663691568669202,"y":0.43659865440342971,"w":0.34390178680419925,"text":"anyone who has a dream. Alex is one of the most"},{"w":0.35207477569580081,"x":0.57601931580056431,"y":0.45170055464623171,"h":0.015042053316929427,"text":"inspiring people I've ever seen, so get up from the"},{"text":"sofa and go watch it now!","x":0.57818930245070821,"y":0.46646072368085378,"h":0.013239187996469615,"w":0.17901233673095696},{"x":0.55555556714788989,"h":0.013081394879037256,"y":0.4840116280510337,"w":0.35596706390380861,"text":"D The 'screenplay \/ action takes place in Yosemite"},{"text":"National Park and in every 'scene \/ plot we see","y":0.49854651208083034,"h":0.013081394879037145,"w":0.32510288238525387,"x":0.57818930009681058},{"h":0.013081394879037256,"text":"stunning mountains and fantastic views. At first you","x":0.5761316904417858,"w":0.3559670639038085,"y":0.51308139580176049},{"y":0.52761627905107067,"w":0.34979423522949216,"h":0.011659978662879711,"x":0.57613169246755846,"text":"think this is a film only about climbing, but there is"},{"text":"nothing unsurprising about this film. The 'soundtrack \/","w":0.3559670639038085,"y":0.54060017648611214,"x":0.57613168993595598,"h":0.013239187996469615},{"text":"plot also focuses on Alex's life and his relationship","h":0.013239187996469504,"w":0.34567901611328122,"y":0.55516328351859234,"x":0.57818930284870906},{"w":0.34362140655517581,"text":"with his girlfriend, Sanni. Climbing without a rope","x":0.57613168002145188,"y":0.56972639012722537,"h":0.013239187996469615},{"y":0.58284883743197546,"text":"is very dangerous, and it's fascinating to hear Alex","x":0.57613168411218052,"w":0.34773662567138675,"h":0.014679847306523386},{"text":"and Sanni talk about their life together.","x":0.57613168949131588,"h":0.013
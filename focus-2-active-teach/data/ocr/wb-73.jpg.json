0986911476,"w":0.13580246925353989,"y":0.11773255844435371,"h":0.010246258758383364},{"text":"1 What's your dream school like?","y":0.13062665498388881,"w":0.23868312835693362,"h":0.013268693400397269,"x":0.56378601154169772},{"h":0.010174417958676241,"y":0.14534883740510951,"text":"2","w":0.012345678806304883,"x":0.56378600823059244},{"w":0.24485595703124996,"h":0.013240470785223502,"x":0.58847736898951908,"text":"Do you think there shouldn't be Art","y":0.14518976170153353},{"x":0.58847736270602136,"w":0.22427984237670906,"y":0.1597528683762871,"h":0.010305271249688608,"text":"classes in the school curriculum?"},{"text":"Why?\/Why not?","x":0.58436213765930067,"y":0.17431597549098021,"h":0.013239187996469504,"w":0.11316872596740724},{"h":0.013294350858925719,"y":0.18750000039841741,"text":"3 What's your favourite after-school activity?","w":0.31481481552124024,"x":0.5637860059482277},{"h":0.014534883760080275,"text":"Why?","w":0.041152262687683128,"y":0.20203488388304125,"x":0.58641975368702259},{"h":0.011627906839719149,"x":0.56172840097688492,"y":0.21656976746192336,"w":0.31893003463745118,"text":"4 Do you think school should be compulsory"},{"x":0.58641975085121445,"h":0.011627906839719149,"y":0.23110465130397762,"text":"until the age of 18? Why?\/Why not?","w":0.25102880477905276},{"x":0.56378601184001897,"text":"5 Do you want to have a gap year before","y":0.24404236549530178,"w":0.29423868179321289,"h":0.013239187996469615},{"x":0.58641975560311055,"y":0.25860547216501517,"w":0.22016460418701167,"text":"you start work? Why?\/Why not?","h":0.01191526919682262},{"y":0.28773168579527109,"h":0.013239187996469504,"w":0.40123455047607426,"text":"2 Look at the photos of people doing voluntary work.","x":0.094650218486242679},{"text":"Take turns to talk about what you can see in the photos.","w":0.40946502685546882,"x":0.11522633942720376,"y":0.51308139556556864,"h":0.013081394879037256},{"w":0.18312757492065429,"x":0.11522633904858907,"text":"1 Talk about the people.","y":0.52761627928044263,"h":0.013081394879037256},{"w":0.17695472717285154,"h":0.011688201698916045,"text":"2 Talk about the places.","y":0.54215116285921017,"x":0.11522634306652335},{"w":0.010288065671920782,"text":"3","x":0.11522633761157047,"h":0.0087209299193582446,"y":0.55668604677723943},{"y":0.55514548180618362,"w":0.33970073699951175,"h":0.015067549164276217,"text":"Talk about the other things in the photographs.","x":0.12747304919848187},{"x":0.090534992080901808,"y":0.58428949706886257,"w":0.63580245971679694,"text":"3 Read the instructions on your card. In pairs, take turns to role-play the conversation.","h":0.013239187996469504},{"text":"Student A","y":0.61317393860922564,"h":0.010570727295298954,"w":0.074181303977966295,"x":0.13986408126280414},{"text":"You and Student B are talking about your","x":0.13991770309887788,"y":0.63808139534467523,"w":0.30864196777343744,"h":0.01162790683971926},{"text":"school. Share your ideas and say if you agree","y":0.65116279100524876,"h":0.013081394879037256,"x":0.13786008487781604,"w":0.3353909301757812},{"text":"or disagree.","x":0.1378105586278961,"y":0.6654888623119678,"w":0.096806869506835952,"h":0.012045531176089863},{"x":0.13786007815293055,"h":0.011915269196822509,"y":0.68446601927763795,"w":0.28189300537109374,"text":"• Give your opinion about your school"},{"w":0.084393501281738281,"x":0.16047814781644298,"y":0.69906272513238499,"h":0.010304782628381748,"text":"curriculum."},{"text":"• Give your opinion about the food","x":0.13786008596344615,"y":0.71220930228508228,"h":0.011627906839719149,"w":0.26131687164306638},{"x":0.16049383052714566,"h":0.010237278816243367,"y":0.72674418634527427,"w":0.15843621253967288,"text":"in the school canteen."},{"text":"• Ask Student B if he\/she has any ideas.","y":0.73962930254316162,"h":0.01191526919682262,"w":0.29012344360351561,"x":0.13786009252437378},{"h":0.01191526919682262,"text":"• Listen to his\/her opinion about homework,","x":0.13786008550490381,"w":0.3251028
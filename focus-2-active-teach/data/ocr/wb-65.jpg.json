[{"w":0.52880657196044922,"x":0.23251029096164785,"text":"LISTENING LANGUAGE PRACTICE","y":0.029069767878781905,"h":0.0218023247983955},{"y":0.056686046880376706,"h":0.02761627863911742,"w":0.057613167762756351,"text":"5.3","x":0.11934156435821944},{"x":0.23251028512724795,"text":"Expressions with prepositions","y":0.069726390112041403,"w":0.21810699462890623,"h":0.013239187996469504},{"x":0.23045267289439764,"y":0.085613415661272896,"w":0.12962963104248049,"text":"• synonyms • get","h":0.01191526919682262},{"x":0.10082304557627139,"h":0.0087209299193582446,"y":0.1366279070364449,"text":"1","w":0.012345678806304938},{"text":"Read the dialogue between Grace and Tom. Choose","w":0.38683128356933594,"x":0.11522632868858317,"y":0.13662790722981277,"h":0.013081394879037256},{"h":0.011679221756776048,"x":0.12139918549744401,"y":0.15116279076618688,"w":0.18106994628906253,"text":"the correct prepositions."},{"h":0.01162790683971926,"text":"Extract from Students' Book recording (4)) 2.29","w":0.28395061492919921,"y":0.28052325583401638,"x":0.13580247267943324},{"h":0.013081394879037256,"y":0.30087209321455111,"text":"G: Hi Tom. Are you coming out 'with \/ by \/ for us","w":0.33744853973388678,"x":0.11111112445404427},{"text":"tonight?","x":0.12962963012008794,"y":0.31540697705176046,"h":0.013081394879037256,"w":0.063786005973815896},{"x":0.10905350298204858,"w":0.36831275939941405,"y":0.32833186263494452,"h":0.014691393247033613,"text":"T: Oh no, I can't. I'm revising 'to \/ about \/ for exams."},{"w":0.36831275939941405,"h":0.016328331862312417,"x":0.12757201785687727,"text":"I need to learn fifty French verbs 'on \/ by \/ with heart","y":0.342894969288841},{"h":0.01191526919682262,"y":0.37202118252461935,"text":"G: But the exams don't start until next month.","w":0.31481481552124024,"x":0.11111111469308348},{"text":"T: I know, but | get really nervous *on \/ about \/ for","y":0.3865842896443088,"w":0.34979423522949216,"h":0.011671524182527593,"x":0.10905350316714689},{"text":"exams. If I don't revise every night, l'll get stressed","x":0.13144319554633699,"w":0.34621723175048824,"y":0.39680561897312683,"h":0.018854998111303978},{"w":0.37290069580078122,"text":"G: I don't know why you're so worried. You always get","h":0.017507218094074073,"x":0.10879020138058401,"y":0.4115962313647914},{"text":"good marks in class.","x":0.13168724626804551,"w":0.13786007881164553,"y":0.42877906979961722,"h":0.011644584356107601},{"y":0.44174757280434007,"w":0.36008228302001954,"text":"T: I know, but that's different. In exams, I panic. And","x":0.10699589102599859,"h":0.013239187996469504},{"w":0.33127571105957032,"h":0.011915269196822509,"text":"I really want to get good grades for my A levels.","x":0.12757201549216293,"y":0.45763459846072285},{"h":0.013239187996469504,"w":0.32098762512207024,"x":0.1275720364101581,"y":0.4708737863243293,"text":"I want to get Sinto \/ with \/ in a good university."},{"text":"G: Listen, you need to take it easy. If you continue like","x":0.10685521120862056,"y":0.48395014824152693,"w":0.37268230438232419,"h":0.01545833173517841},{"x":0.12962962742267503,"w":0.11316872596740724,"h":0.01162790683971926,"text":"this, you'll get i!l","y":0.49854651155107066},{"y":0.52761627918672949,"x":0.10493827322258778,"text":"G: Okay, first you need to make a revision timetable. If","w":0.37860080718994149,"h":0.011659978662879711},{"y":0.54215116300137289,"text":"you make a timetable, you'll see that you have plenty","w":0.36831275939941405,"x":0.12757202150056712,"h":0.013081394879037256},{"y":0.55648720208193292,"w":0.16872426986694339,"x":0.12757202355418257,"text":"of time to do everything.","h":0.01191526919682262},{"text":"T: Um, yeah, that's quite a good idea.","h":0.013239187996469504,"x":0.10493827635267791,"y":0.56972639030583982,"w":0.26131687164306638},{"y":0.584289496872194,"w":0.33333332061767573,"x":0.10493828351832239,"text":"G: And I think you spend too much time alone -","h":0.011640735568983374},{"h":0.01162790683971926,"w":0.37037036895751951,"x":0.12551441017144579,"y":0.59883720932238849,"text":"sometimes it's good to study •about \/by \/ with other"},{"y":0.6133720932735689,"x":0.12757201715144922,"text":"people.","w":0.051440329551696778,"h":0.010174417958676241},{"text":"T: Is it? I'm not so sure. They might know more than","y":0.62645348856338834,"h":0.013081394879037256,"x":0.10288067279040171,"w":0.36008228302001954},{"y":0.65401588701580826,"h":0.011681787334283933,"w":0.15432098388671878,"x":0.10288066224902742,"text":"G: You're so negative."},{"w":0.32921810150146485,"y":0.66857899392099374,"text":"T: Well, it's okay for you, you don't get nervous.","x":0.10082305212992594,"h":0.013239187996469504},{"y":0.68313953528213833,"h":0.013241753153114932,"w":0.37448558807373045,"text":"G: Of course | get nervous. But I try to be positive. For","x":0.10288066553103593},{"text":"example, before \/ in \/ on an exam, I imagine myself","w":0.36246932983398439,"h":0.016747918259434558,"y":0.69493575366174998,"x":0.12329623810635859},{"w":0.35832519531250001,"text":"Bto \/ in \/ on the exam - 1 know all the answers, and I","x":0.12328609078919768,"y":0.70999613436269837,"h":0.014237054553793649},{"h":0.013081394879037256,"x":0.123456795730662,"w":0.31069957733154296,"text":"pass the exam lon \/ by \/ with the best marks.","y":0.72529069812734182},{"w":0.26748970031738278,"x":0.10082305441949778,"h":0.01191526919682262,"text":"T: Hm. It's true, I'm not very confident.","y":0.73962930257949888},{"text":"2 Complete the sentences with a preposition in each gap.","x":0.084188203045289955,"h":0.015791871962248516,"w":0.42008358001708979,"y":0.77026737384642252},{"y":0.78905560438404776,"w":0.37242797851562504,"h":0.01191526919682262,"x":0.10699588107826453,"text":"1 l am getting nervous about tomorrow. Jake asked"},{"w":0.10137556076049806,"h":0.013608770042210616,"text":"me to study '_","x":0.12953409881842784,"y":0.80322554730543139},{"h":0.011915269196822509,"text":"_him. He's so handsome. I don't","w":0.22839506149291994,"x":0.27572016853337528,"y":0.80361871151342712},{"x":0.12962963170135444,"w":0.16255144119262699,"y":0.81818181809177926,"text":"think l'll learn anything!","h":0.011915269196822509},{"x":0.1068891828988735,"h":0.014703836466291809,"text":"2 Vince stayed up too late revising and then he actually","w":0.39320636749267579,"y":0.83126014565705242},{"y":0.84399679290894969,"w":0.086078376770019532,"x":0.12670617917880211,"h":0.015620229103243233,"text":"fell asleep -"},{"text":"the English exam.","w":0.12962962150573726,"y":0.84593023262665212,"x":0.26131687865042347,"h":0.011627906839719149},{"x":0.10677289015463116,"y":0.85759835287328912,"w":0.3666920852661133,"text":"3 Our exams don't start until May, so we've still got","h":0.016261381063436109},{"text":"three months to revise •","w":0.16872426986694339,"x":0.12757202355418257,"y":0.87334510139981081,"h":0.010591350397175625},{"x":0.34773663081512446,"h":0.011647149933615486,"text":"_ them. I'm going to","y":0.8764342452740348,"w":0.13991768836975099},{"x":0.12757202154737335,"h":0.01191526919682262,"text":"study hard because wanttopassb","y":0.88790820826865891,"w":0.25102880477905276},{"x":0.12757202227163636,"text":"marks and get","y":0.90247131502562539,"w":0.11316871643066406,"h":0.01191526919682262},{"y":0.90406976778907266,"x":0.29012346323150495,"h":0.010316816348474034,"text":"_ university to study Medicine.","w":0.20987653732299805},{"w":0.23513936996459961,"h":0.014697326565883073,"text":"4 We have to learn 15 words _","x":0.10466889067599106,"y":0.91427185294933999},{"x":0.37037037010555401,"y":0.91703442173414218,"w":0.11934156417846681,"h":0.01191526919682262,"text":"heart for a test"},{"h":0.010191095475064693,"x":0.12551440817283344,"y":0.93023255837167917,"w":0.17695472717285154,"text":"tomorrow. I'll come outb"},{"x":0.34979424171592177,"h":0.01191526919682262,"y":0.93159752853955835,"text":"_ you another time.","w":0.13374485015869142},{"h":0.01162790683971926,"x":0.54526748864440666,"w":0.36419754028320306,"text":"3 Match the words below to underlined words in","y":0.072674418644093852},{"x":0.56968506585277146,"h":0.014755233872389195,"y":0.085839366581769716,"text":"Exercise 1 with similar meanings.","w":0.24127784729003898},{"y":0.10610465128584867,"w":0.026748971939086874,"text":"sick","h":0.0087209299193581336,"x":0.5925925921168762},{"w":0.010288065671920865,"h":0.0087209299193581336,"text":"1","x":0.56790123457659103,"y":0.11918604655921627},{"x":0.56790123455087083,"text":"2","w":0.010288065671920754,"h":0.010174417958676241,"y":0.13226744201387897},{"x":0.56790123475663223,"y":0.14680232607395638,"w":0.010288065671920754,"text":"3","h":0.010174417958676241},{"text":"4","y":0.16133720938625118,"w":0.010288065671920754,"x":0.56790123478235233,"h":0.0087209299193581336},{"y":0.17441860510133045,"text":"5","h":0.010174417958676241,"x":0.56790123473091203,"w":0.010288065671920865},{"h":0.011661261451633709,"x":0.59053497832796498,"y":0.11915269201667555,"text":"more than enough","w":0.1316872406005859},{"x":0.59050205471889949,"w":0.07002469539642342,"h":0.010402422717263549,"y":0.13360692826424259,"text":"optimistic"},{"x":0.59053498118306225,"h":0.01162790683971926,"text":"study for exams","w":0.11111110687255854,"y":0.14680232550455896},{"h":0.011627906839719149,"w":0.041152262687683128,"y":0.16133720917703964,"x":0.59053497914998554,"text":"begin"},{"x":0.59046346658931625,"h":0.010736973855943632,"text":"pessımistic","w":0.078332324028015154,"y":0.17704430394667647},{"w":0.16255144119262699,"x":0.55555555376925581,"h":0.013239187996469504,"y":0.2034421890473066,"text":"REMEMBER BETTER"},{"y":0.22674418606338831,"w":0.37448558807373056,"text":"Synonyms are different words with the same or similar","x":0.55967078010579607,"h":0.013081394879037256},{"h":0.013239187996469615,"y":0.24271844665357756,"text":"meanings. When you learn a new word and you have","w":0.36625514984130858,"x":0.5617283963413483},{"w":0.35802467346191402,"h":0.013081394879037256,"y":0.25581395370510351,"x":0.55967079531636799,"text":"time, check in the dictionary and see if you can also"},{"w":0.38271602630615242,"y":0.26875551618395876,"x":0.55761317395254817,"text":"learn a synonym. Knowledge of synonyms will help you","h":0.014674716151507727},{"text":"understand more when you read and listen, especially","x":0.55967078068045906,"w":0.37242797851562504,"h":0.013081394879037367,"y":0.28488372120873717},{"h":0.011915269196822509,"text":"more advanced texts.","w":0.15226336479187008,"y":0.29788172983442895,"x":0.55967078756291277},{"text":"Replace the underlined words in the sentences with","w":0.37654319763183586,"y":0.31818181802076362,"h":0.013239187996469504,"x":0.55967079178078993},{"y":0.33274492480316609,"x":0.55761317200160387,"w":0.27160493850708012,"text":"synonyms. The first letters are given.","h":0.013239187996469615},{"x":0.58218237440474208,"y":0.35024698467677728,"w":0.31505897521972659,"h":0.013179747908912853,"text":"Today Naomi and Leon had their final exams,"},{"y":0.36482558168475465,"h":0.013081394879037256,"text":"so tonight they are going to go out and enjoy","x":0.58024690509387367,"w":0.32098766326904304},{"h":0.011636887202721491,"y":0.37936046511211718,"x":0.58024691876554757,"text":"themselves. (have a good time)","w":0.22016460418701167},{"h":0.010174417958676241,"w":0.012345678806304994,"text":"1","y":0.39244186069726072,"x":0.55761316898162117},{"x":0.56995885480865749,"y":0.39389534885727229,"w":0.30658435821533203,"h":0.011665110238757825,"text":"The teacher said we should try to relax (t"},{"text":".it","y":0.39534883746280158,"w":0.028806583881378245,"x":0.89300411498660848,"h":0.0087209299193580225},{"y":0.40843023264206513,"x":0.58024691383758831,"text":"e","w":0.012345678806304883,"h":0.0087209299193581336},{"text":".) the night before the exam.","w":0.19958847045898431,"h":0.011915269196822509,"y":0.40688437771755059,"x":0.62962962975679049},{"h":0.016024920336461523,"x":0.55741446861023947,"w":0.37280780792236323,"y":0.41979753825301458,"text":"2 I don't like studying with other people. I work best"},{"y":0.43601059143432275,"x":0.57818930105929278,"w":0.059670782089233376,"h":0.011663827029141483,"text":"alone (o"},{"text":"m","h":0.0087209299193581336,"x":0.68106995871074871,"y":0.43750000025349922,"w":0.016460905075073251},{"text":"WORD STORE 5D | get","h":0.015162940164214156,"w":0.18153333663940419,"x":0.53677106830131671,"y":0.46189487075376423},{"x":0.53703703558893012,"y":0.48234774929154256,"w":0.39711933135986321,"text":"4 Complete the mini-dialogues with the phrases from","h":0.014745273741598397},{"y":0.49854651188703181,"text":"the box. Change the form of get if necessary.","x":0.55761317129756904,"w":0.33539093017578125,"h":0.013081394879037145},{"y":0.52470930251687675,"text":"get a job get exhausted get good grades","w":0.31687242507934565,"x":0.57818930503234356,"h":0.013243036362731386},{"w":0.35185184478759768,"h":0.013271259398767721,"y":0.53924418619662473,"x":0.57818930687574843,"text":"get ill get into trouble get nervous get rid of"},{"h":0.014563106796116498,"text":"A: Did you get rid of those horrible old slippers?","x":0.58230454280942212,"y":0.55957634638296105,"w":0.33950614929199219},{"text":"B: Yes, 1 got a new pair for my birthday. Not the","h":0.013250733516117386,"x":0.58230453910449609,"y":0.57412790715713824,"w":0.33539093017578125},{"x":0.60493827640864373,"w":0.23045267105102529,"h":0.01162790683971926,"text":"most exciting present, but useful.","y":0.58866279072984973},{"y":0.60319767454437845,"w":0.32510288238525387,"x":0.55761317094729068,"text":"1 A: Were you sick after the school field trip?","h":0.014631098808699283},{"h":0.013239187996469504,"x":0.58024691929736549,"y":0.61915269211038859,"text":"B: Yes, I was cold and wet all day. I think that was","w":0.34773662567138675},{"x":0.60288065823101156,"text":"when 1","w":0.049382715225219753,"h":0.010179549955416811,"y":0.633715798649648},{"text":". I still feel pretty bad","x":0.78395062048874431,"y":0.63371579881571949,"w":0.14609052658081056,"h":0.014563106796116498},{"y":0.64960282452362328,"x":0.55555556127789019,"w":0.30864196777343744,"h":0.013239187996469615,"text":"2 A: How is your nephew doing at school?"},{"y":0.66548984977412606,"text":"B: Not very well. He often","w":0.18930040359497069,"x":0.57818930674160929,"h":0.013289219703909949},{"w":0.039094648361206019,"x":0.88683127619662616,"text":"with","y":0.66715116328325863,"h":0.010174417958676241},{"w":0.32949813842773434,"h":0.013941230336228738,"text":"his teachers. They say he talks too much during","x":0.6006881685272123,"y":0.67944672120715421},{"w":0.057613167762756268,"h":0.010174417958676241,"text":"lessons.","x":0.60082304646841611,"y":0.69331395379319094},{"w":0.39300411224365239,"x":0.55555556032193221,"h":0.013239187996469504,"y":0.70917917043560708,"text":"3 A: Are you prepared for your presentation tomorrow?"},{"h":0.013081394879037256,"text":"B: Well, yes, 1 am. But I'm already","x":0.57818930392852896,"w":0.2386831283569335,"y":0.72529069812734182},{"text":"thinking about talking in front of such a large","y":0.73962930277011119,"h":0.013277673763399722,"w":0.31275718688964838,"x":0.59876543426436657},{"text":"group of people.","x":0.59876543535883398,"h":0.014573369947872949,"w":0.1234567832946778,"y":0.75286849035513237},{"w":0.25514402389526358,"h":0.013239187996469504,"y":0.76875551618714488,"x":0.55349794945154518,"text":"4 A: You can't work all night. You'll"},{"w":0.32510288238525387,"text":"and won't be able to focus in school tomorrow.","h":0.01191526919682262,"y":0.78331862327126089,"x":0.60082304846786683},{"y":0.79920564888194956,"x":0.5740740762396751,"w":0.31275718688964849,"h":0.013294350858925719,"text":"B: 1 know. But I have to finish this project for"},{"x":0.59876543798247694,"w":0.13991768836975094,"text":"tomorrow morning.","y":0.81540697676424878,"h":0.01162790683971926},{"h":0.013081394879037256,"w":0.33950614929199219,"y":0.82994186062734177,"x":0.55144034665030006,"text":"5 A: It's not fair. I always work hard, but I never"},{"w":0.33539093017578125,"text":"B: I wouldn't worry too much about that. What's","y":0.86046511654138069,"x":0.57613169420566224,"h":0.01162790683971926},{"x":0.59465021636659376,"text":"really important is that you're trying!","w":0.25720163345336911,"h":0.011627906839719149,"y":0.87499999997161326},{"y":0.88953488398324121,"h":0.011627906839719149,"text":"6 A: Are you free at the weekend?","w":0.25102880477905265,"x":0.55144032868043258},{"x":0.57407408685768235,"h":0.01162790683971926,"text":"B: Not during the day. Last week, I","w":0.24897117614746089,"y":0.90552325578556658},{"x":0.59454452162259119,"h":0.014787963503562374,"w":0.34180812835693353,"y":0.91839561554156568,"text":"in a bookshop near my house and Saturday is my"},{"text":"first day at work.","x":0.5966307837114988,"w":0.1174380207061767,"y":0.93278618090428855,"h":0.01378810374166517},{"text":"63","w":0.024691357612609877,"x":0.91358024687270722,"h":0.013081394879037256,"y":0.95058139565641164}]
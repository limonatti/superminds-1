0966156,"y":0.52761627923199306,"h":0.013081394879037256,"w":0.26543209075927732},{"x":0.38065844425145939,"h":0.014534883760080275,"y":0.54215116272267294,"w":0.26748970031738278,"text":"city into private houses and housing"},{"text":"estates. This recycling of energy","y":0.55648720221198311,"h":0.013280239340907607,"w":0.26543209075927732,"x":0.38271605780966156},{"h":0.013252016725733728,"text":"is saving both money and the","x":0.38065844010193972,"w":0.26748970031738284,"y":0.57105030883878494},{"y":0.58428949682968612,"w":0.26337448120117191,"h":0.013239187996469615,"x":0.38271605173480494,"text":"resources which generate* heat in"},{"text":"the first place.","w":0.10926203727722167,"y":0.59843687312416816,"x":0.38055416790966923,"h":0.015335556057208599},{"text":"5","h":0.01162790683971926,"w":0.010288065671920754,"y":0.54215116266541175,"x":0.66460905348091204},{"w":0.063786005973815896,"text":"Another","x":0.66255144225486162,"y":0.556686046507466,"h":0.01162790683971926},{"y":0.55377906950561884,"text":"aim of the lighthouse","x":0.73045267524229029,"w":0.1975308609008789,"h":0.01462340207617574},{"text":"city project is to make people","x":0.66460905832945516,"h":0.013239187996469504,"y":0.56972639025739025,"w":0.26337448120117191},{"y":0.58284883722617908,"w":0.26543209075927732,"h":0.013081394879037256,"text":"understand how to save on natural","x":0.66460906165053957},{"y":0.59738372138315576,"text":"resources. Residents in all cities","x":0.66255144251473719,"h":0.013081394879037256,"w":0.26543209075927743},{"h":0.013081394879037256,"y":0.61191860466803949,"w":0.26337448120117191,"x":0.66460905919365276,"text":"will be able to use apps to monitor"},{"w":0.26543209075927732,"x":0.66255144167797453,"text":"how much energy they are using","h":0.013081394879037256,"y":0.62645348865059769},{"h":0.01191526919682262,"y":0.64077669906730039,"x":0.66255143990842724,"text":"and when is the best time to clean","w":0.26543209075927732},{"y":0.65401588683312961,"w":0.26748970031738284,"x":0.66049383198122624,"h":0.016042252293962944,"text":"the house, for example, or dothe"},{"x":0.66049383147711116,"text":"washing. There may even be prizes","w":0.26748970031738273,"h":0.015990937376906045,"y":0.66715116315851808},{"y":0.68168604652850462,"text":"for the","w":0.063786005973816007,"h":0.013081394879037256,"x":0.66049382736288631},{"h":0.014695242455020407,"y":0.6816860465647272,"x":0.72222221898302619,"text":"greenest' residents. The","w":0.20576131820678711},{"x":0.66049383631250191,"text":"idea here is that if people can save","h":0.013081394879037256,"y":0.6962209304129523,"w":0.26748970031738284},{"x":0.66460905358665701,"y":0.71075581435190582,"h":0.013081394879037256,"w":0.26337448120117191,"text":"money and save the environment at"},{"x":0.66049383082920909,"y":0.72529069844194816,"w":0.26543209075927732,"h":0.016103829521051272,"text":"thesame time, they will probably"},{"text":"act more responsibly.","y":0.73962930272771776,"x":0.66255144009837708,"w":0.16049383163452147,"h":0.013277673763399722},{"y":0.76017441933220975,"text":"That's why the lighthouse cities like","x":0.66049383292772834,"w":0.26748970031738273,"h":0.016083303217538591},{"text":"Stockholm, Cologne and Barcelona,","y":0.77449249781163731,"w":0.26543209075927732,"h":0.013298199646049946,"x":0.66255144765019669},{"y":0.78905560421290366,"text":"like the lighthouses of the past, are","w":0.26543209075927732,"h":0.014723465491056631,"x":0.6604938330595147},{"w":0.26131687164306638,"y":0.8022947927622297,"text":"*showing the way' to a safer future.","h":0.014565672373624383,"x":0.66049383081941326},{"w":0.05967078208923339,"h":0.010174417958676241,"y":0.85029069794290024,"text":"GEOSSAI","x":0.092592593240362717},{"x":0.094650222846739851,"text":"vehicle (n) - a machine with an engine such as a car,","y":0.87202118290914465,"h":0.01191526919682262,"w":0.36213989257812501},{"y":0.88649116145449891,"h":0.011901398412127007,"text":"bus, or truckd","w":0.096773071289062471,"x":0.094617578999919252},{"h":0.013239187996469615,"text":"lighthouse (n) - a tower with a powerful flashing light","x":0.094650203381322628,"y":0.90114739626550189,"w":0.37037036895751951},{"h":0.011915269196822509,"x":0.092592596633107288,"text":"that guides ships away from danger","y":0.9170344218552664,"w":0.25102880477905276},{"text":"106","y":0.94476744199362095,"h":0.013081394879037256,"x":0.080246914259678392,"w":0.037037036418914801},{"y":0.86918604683737088,"text":"efficient (adj) - if someone or something is efficient,","w":0.36419754028320317,"x":0.51028805658164966,"h":0.013081394879037256},{"y":0.88517441877898906,"w":0.37860080718994138,"h":0.013081394879037256,"text":"they work well without wasting time, money, or energy","x":0.5123456900950154},{"text":"generate (v) - to produce or cause something","y":0.9011473963684572,"x":0.51234567848888768,"w":0.31893003463745118,"h":0.013239187996469615}]
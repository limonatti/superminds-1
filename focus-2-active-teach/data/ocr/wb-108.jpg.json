[{"text":"8.4","x":0.094650205107281338,"y":0.045058140457606921,"h":0.039244184637111768,"w":0.069958848953247083},{"x":0.2180635891731578,"text":"READING","y":0.02598933979615603,"w":0.15029257774353025,"h":0.019242250487958024},{"y":0.066860465530109603,"w":0.19547325134277344,"x":0.21810699328437466,"text":"Green cities • collocations","h":0.010368131265530822},{"h":0.015238841865721331,"text":"• pollution • word families","w":0.20001846313476562,"y":0.079607166542233432,"x":0.21581103496594933},{"text":"1 Read the text quickly and decide why it was written.","w":0.4137456512451172,"x":0.52460526702386401,"y":0.039179678390594885,"h":0.01552789019780787},{"h":0.011644583935245256,"y":0.05957634614159113,"text":"1 To explain how to do more recycling in cities","w":0.33333332061767584,"x":0.55555556524671756},{"x":0.55555556086375557,"w":0.33539093017578125,"h":0.013250733516117386,"text":"2 To present a particular environmental project","y":0.074127907375161617},{"x":0.55555555990093197,"w":0.34773662567138675,"y":0.088662790714551187,"h":0.013278956973016065,"text":"3 To give advice on how to save energy at home"},{"h":0.045058140161283622,"x":0.10493827108078946,"y":0.14825581392190179,"w":0.82716049194335939,"text":"Greener and cleaner cities"},{"y":0.21220930252138859,"h":0.010174417958676241,"w":0.012345678806304938,"x":0.38477366255158002,"text":"3"},{"x":0.38683128055167743,"h":0.011690767276423819,"y":0.22529069765572185,"text":"One of the major technological","w":0.26337448120117185},{"w":0.26543209075927737,"h":0.011915269196822509,"x":0.38477367097838594,"text":"inventions these cities are using is","y":0.23962930290346218},{"h":0.013239187996469615,"y":0.25286849071861894,"text":"connected to recycling. But not the","w":0.26337448120117185,"x":0.3847736673829531},{"text":"recycling of plastic, glass and paper","y":0.26743159745741685,"w":0.26543209075927737,"h":0.013239187996469615,"x":0.38477366987241896},{"text":"which we all know. The lighthouse","x":0.38477366550366637,"w":0.26337448120117185,"y":0.28052325583083015,"h":0.013081394879037367},{"w":0.1975308609008789,"text":"cities want to recycle heat.","h":0.013081394879037367,"x":0.38477366625737941,"y":0.29505813955176041},{"text":"When it comes to fighting pollution,","x":0.66460906087011518,"y":0.22374227687753656,"w":0.26748970031738284,"h":0.014629816019945396},{"text":"lighthouse cities aim to encourage","x":0.66666667105922184,"w":0.26337448120117191,"y":0.23830538397376488,"h":0.013239187996469504},{"y":0.25286849069758033,"x":0.66460905418311855,"text":"the use of car-sharing to help reduce","w":0.26543209075927732,"h":0.011666393027511823},{"h":0.011627906839719149,"w":0.26748970031738273,"x":0.66460906376449091,"y":0.26598837220998539,"text":"the number of vehicles on the roads."},{"y":0.28052325610335926,"x":0.66460905418311855,"text":"In Cologne, there are plans to build","w":0.26543209075927732,"h":0.013081394879037256},{"text":"special car parks for electric cars","h":0.013081394879037256,"x":0.66460905307715168,"y":0.2950581398424581,"w":0.26543209075927732},{"w":0.26337448120117191,"x":0.66666667215661557,"text":"which local people can \"book' and","y":0.30803177403864845,"h":0.013239187996469615},{"h":0.013290502492663947,"w":0.26748970031738273,"x":0.66255144422696421,"y":0.32391879964992776,"text":"then share with other passengers"},{"y":0.33715798746162395,"w":0.26748970031738273,"x":0.6625514427939837,"text":"on their journeys. When the cars are","h":0.014586198677137063},{"text":"parked, they transfer energy to each","y":0.34929679892103815,"h":0.015589974985013244,"x":0.6664642858572114,"w":0.26370037078857422},{"y":0.36482558172109181,"text":"other so that each vehicle is ready","w":0.26337448120117191,"x":0.6646090524035293,"h":0.013081394879037256},{"y":0.37936046541174107,"w":0.26337448120117191,"text":"for a journey and that energy is used","x":0.66460905350092303,"h":0.013081394879037256},{"w":0.082304525375366255,"h":0.014534883760080164,"text":"efficiently.","x":0.66255144183906589,"y":0.39389534878856458},{"x":0.1028806668631595,"y":0.35304501303927605,"w":0.26543209075927737,"text":"Today, there are around 7.4 billion","h":0.013239187996469615},{"w":0.26543209075927732,"y":0.36760812019893652,"text":"people living on the planet. The","x":0.10288066575719249,"h":0.013239187996469504},{"y":0.38217122675593385,"h":0.014631098808699283,"w":0.15637859344482424,"text":"Earth's population,","x":0.10288066408005697},{"text":"however,","w":0.082363967895507817,"h":0.011839348135642691,"y":0.38216172128365988,"x":0.25717192654606641},{"w":0.026748969554901081,"text":"is","x":0.34156378638167156,"y":0.38226744225612697,"h":0.010174417958676241},{"h":0.014624684864929738,"x":0.10082305441949778,"w":0.26748970031738278,"text":"growing at 1.1% each year, which","y":0.39534883711705293},{"w":0.26131687164306644,"x":0.10493826938422814,"h":0.013081394879037256,"text":"means that by the year 2030","y":0.40988372123780692},{"text":"there will be about 8.4 billion","x":0.10082305148250122,"h":0.013081394879037256,"w":0.26543209075927737,"y":0.42441860482550076},{"y":0.43895348852781479,"w":0.26337448120117191,"h":0.01162790683971926,"x":0.10288065800023716,"text":"people. What's more, most people"},{"w":0.26543209075927732,"h":0.01191526919682262,"text":"choose to live in cities because it","x":0.10288066509361229,"y":0.4518976169173835},{"h":0.011915269196822731,"text":"is easier to find work. Busier and","w":0.26543209075927737,"x":0.10082304661624615,"y":0.46646072379062908},{"x":0.1008230532097458,"w":0.22222221374511722,"y":0.48102383030446949,"text":"larger cities, however, use","h":0.014615704501927285},{"x":0.32098765534623908,"h":0.011915269196822509,"text":"a lot","w":0.0473251008987427,"y":0.48102383071652022},{"y":0.49318480273493859,"w":0.26381772994995117,"x":0.1026675982205844,"h":0.015835895858185456,"text":"of natural resources such as gas"},{"text":"and electricity. It also means more","w":0.26543209075927737,"y":0.51015004409710218,"x":0.10082305116651064,"h":0.013239187996469504},{"x":0.1008230555340382,"y":0.52325581411571398,"w":0.26748970031738284,"text":"vehicles* on the roads and greater","h":0.013081394879037256},{"text":"use of public transport by people","w":0.26337448120117191,"x":0.10288065800023716,"y":0.53618711382677609,"h":0.014684979303264067},{"x":0.10288066510768054,"h":0.011663827029141594,"text":"who commute to work.","y":0.55232558143479149,"w":0.16872426986694336},{"x":0.10082304929628727,"h":0.014704221976297838,"text":"One key question, then, is this: what","y":0.57267441876676228,"w":0.26543209075927732},{"x":0.10082304842180165,"text":"can we do to protect the environment","y":0.5872093025394427,"w":0.26543209075927732,"h":0.011643301146491258},{"y":0.60017652246471398,"x":0.10082305441949778,"h":0.013239187996469615,"text":"and deal with the larger number of","w":0.26748970031738278},{"w":0.20370370864868162,"h":0.013239187996469504,"text":"people living on the planet?","x":0.10288065800076204,"y":0.6147396292107794},{"x":0.10082304526762943,"y":0.63662790717255147,"w":0.012345678806304924,"h":0.010174417958676241,"text":"2"},{"h":0.014641361960455734,"x":0.10082305192488804,"y":0.64960282404749137,"w":0.26543209075927732,"text":"One idea might be the construction"},{"x":0.09876544013623309,"h":0.0146131389244194,"y":0.66416593083837272,"text":"of lighthouse* cities. At present,","w":0.26748970031738284},{"h":0.013239187996469504,"x":0.10082304483151287,"w":0.26337448120117191,"text":"Stockholm, Barcelona and Cologne","y":0.6787290379176435},{"x":0.10082304780451772,"h":0.013081394879037256,"y":0.69186046518766164,"text":"are part of an experimental project","w":0.26543209075927732},{"y":0.70639534885408606,"w":0.26337448120117185,"text":"to create cleaner, more energy","h":0.013081394879037256,"x":0.10082304629927691},{"w":0.26748970031738284,"h":0.014727313857318403,"text":"efficient* cities for people to live in.","
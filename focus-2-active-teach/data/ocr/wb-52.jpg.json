[{"text":"READING","w":0.14842204093933106,"x":0.21591243683249992,"y":0.027107370140413201,"h":0.021366654721804657},{"y":0.069726389936613176,"h":0.011668959025882053,"w":0.23045267105102538,"text":"W.J. Cavendish-Scott-Bentinck","x":0.21604938196419929},{"text":"• landscape features","x":0.21399177128170319,"y":0.084289496956980847,"h":0.011640735568983374,"w":0.15637859344482427},{"x":0.21399177140652376,"text":"• describing places • collocations","y":0.098837209700742945,"w":0.25308641433715823,"h":0.013254581882379157},{"h":0.013081394879037256,"text":"1 Read the text quickly and choose the best title.","w":0.37654319763183597,"y":0.042151163080103471,"x":0.52469135944025491},{"x":0.5555555593339162,"h":0.013239187996469504,"y":0.059576345901651062,"text":"1 England's Shyest Man","w":0.17489711761474602},{"h":0.013250733516117275,"x":0.55349794218367809,"y":0.074127907429667461,"w":0.23045267105102529,"text":"2 England's Most Unusual Duke"},{"x":0.55555555929142197,"y":0.088662790693512461,"w":0.20781892776489264,"text":"3 England's Strangest House","h":0.01162790683971926},{"x":0.38683127188961841,"w":0.25925926208496086,"y":0.17732558216287841,"h":0.015988370957673359,"text":"they had to stand completely still,"},{"w":0.25514402389526369,"h":0.013239187996469615,"x":0.38888888914976205,"text":"say nothing, and look down at the","y":0.19329214475212941},{"h":0.014658039055981731,"y":0.20917917050816692,"text":"ground until he was gone. Inside","w":0.25308641433715823,"x":0.39094650082181887},{"text":"Welbeck Abbey, there was a mini-","y":0.22674418619056858,"w":0.25514402389526369,"h":0.013081394879037256,"x":0.38888889659146275},{"text":"railway and, to avoid any face-to-","x":0.38888889580271102,"w":0.25514402389526358,"y":0.24127906950561884,"h":0.0146785653594943},{"w":0.25514402389526369,"text":"face contact, the servants from the","h":0.01457721831413461,"x":0.38888889659146275,"y":0.2572674417682157},{"text":"kitchen used to send meals to his","x":0.38888888914976205,"w":0.25514402389526369,"y":0.27449249767553074,"h":0.01191526919682262},{"y":0.29069767434176841,"w":0.1769547271728516,"text":"room on the mini-train.","x":0.38888889119752484,"h":0.011627906839719149},{"w":0.25925926208496097,"h":0.013239187996469615,"text":"As well as this unusual form of","x":0.38683127689990626,"y":0.31685789925106445},{"h":0.014638795541222938,"w":0.25514402389526364,"x":0.38888889595360271,"y":0.33274492532137534,"text":"transport,there were manyother"},{"text":"amazing","x":0.38888889009436783,"y":0.35174418596967527,"w":0.063786005973815896,"h":0.011627906839719149},{"x":0.4567901232747773,"w":0.18724279403686517,"h":0.013081394879037256,"text":"things in the Duke's","y":0.35029069796382439},{"y":0.36610551512213285,"x":0.38882106043071074,"text":"house.","w":0.051575984954834009,"h":0.010521527632926242},{"y":0.36482558164884804,"text":"3","w":0.012345678806304938,"x":0.43827160483553074,"h":0.0087209299193581336},{"h":0.014697808032528292,"w":0.16255144119262693,"x":0.48148148375896765,"y":0.3648255814242235,"text":"_ Also underground*."},{"y":0.3808139532871111,"w":0.25308641433715817,"x":0.3888888945032315,"text":"he built many tunnels and used","h":0.014596461828893403},{"y":0.39673433330698948,"x":0.38888889470531735,"text":"them to move around his giant","w":0.25514402389526375,"h":0.01460287577266306},{"y":0.41424418626918469,"w":0.25514402389526369,"x":0.38888889230476875,"text":"house and garden without seeing","h":0.014705504765051836},{"w":0.25774776458740234,"x":0.38651675031833976,"text":"anyone. One of the tunnels went","y":0.42827827281029895,"h":0.018304821462201915},{"text":"all the way from Welbeck Abbey","y":0.4461606354474994,"h":0.016048667079457624,"x":0.38683128205589545,"w":0.25514402389526381},{"text":"to the nearby town of Worksop","h":0.013081394879037145,"x":0.38683127704413783,"y":0.4636627909870803,"w":0.25514402389526364},{"y":0.47965116285833198,"h":0.014611855293940601,"w":0.25514402389526364,"x":0.38683127768199782,"text":"- almost 3 km away! Welbeck"},{"w":0.25514402389526369,"h":0.01458748146589095,"text":"Abbey wasn't the Dukes only","y":0.49558693708566071,"x":0.38683128235963837},{"w":0.063786005973815896,"text":"home. 4","x":0.38683127723942945,"h":0.014563106796116498,"y":0.51015004376995277},{"y":0.51147396282683022,"w":0.15226337432861342,"h":0.013239187996469504,"text":"He didn't build this","x":0.49176954930688671},{"x":0.3868312841820945,"y":0.52761627871093064,"w":0.25720163345336916,"text":"one though; the Duke's grandfather","h":0.016073041749232075},{"text":"won it in a game of cards! In total,","y":0.17587209300368079,"h":0.014534883760080275,"w":0.25514402389526369,"x":0.67078190176978925},{"text":"nearly 1,500","x":0.66870617624237239,"y":0.19324471164033663,"w":0.11114731788635257,"h":0.01467336770821126},{"text":"people worked","y":0.1919205992991031,"h":0.015310532417533107,"x":0.79386321588118902,"w":0.13034008026123045},{"text":"for W.J. Cavendish-Scott-Bentinck.","x":0.66666666905373984,"y":0.20917917016009335,"w":0.25514402389526369,"h":0.013239187996469615},{"x":0.6707818986270313,"h":0.013081394879037256,"y":0.22529069812734182,"w":0.25308641433715817,"text":"Sometimes he was a moody and"},{"w":0.25514402389526369,"x":0.66872428383426108,"y":0.24127907016585926,"h":0.013081394879037256,"text":"unusual boss, but at other times"},{"text":"he was very kind. 5 He also","x":0.66872428465730649,"y":0.25581395385619232,"h":0.016030706353452828,"w":0.25514402389526369},{"x":0.66872428393714189,"h":0.014622119287421853,"y":0.27316857864881983,"w":0.25514402389526369,"text":"built a boating lake, an area for"},{"text":"ice-skating and","y":0.29002422504443903,"h":0.014172277088619789,"w":0.12784548759460446,"x":0.66863445496402862},{"h":0.013269976610013723,"text":"a horse-riding","x":0.79629629642673283,"w":0.12757201194763179,"y":0.28905560462310964},{"y":0.30523255815641159,"w":0.25514402389526358,"h":0.013081394879037256,"x":0.66872428187952881,"text":"school for his servants to use. The"},{"text":"horse-riding school had a glass","w":0.25720163345336911,"y":0.32122092988583373,"x":0.66666667482240427,"h":0.015988372641123183},{"text":"roof over 100 metres long!","h":0.014715767916808176,"w":0.19958847045898431,"y":0.33848190664249556,"x":0.66666667168065874},{"w":0.25720163345336922,"text":"When the Duke died in 1879,","x":0.66666667512859656,"y":0.36482558135154897,"h":0.014697808032528292},{"y":0.37936046543596591,"text":"his relatives found that most of","x":0.66872428222246427,"w":0.25514402389526369,"h":0.013081394879037256},{"text":"the rooms in his house had no","x":0.66872428860106481,"h":0.01191526919682262,"y":0.39673433358887544,"w":0.25514402389526369},{"y":0.41262135901864161,"w":0.25514402389526369,"h":0.011915269196822731,"text":"furniture and the walls were all","x":0.66872428690010477},{"y":0.42877906950561884,"text":"pink. In one room, there was","x":0.66872428613192914,"h":0.014733728642812971,"w":0.25514402389526358},{"h":0.014595178198414605,"y":0.44616063586185806,"w":0.25720163345336911,"x":0.66666667041323313,"text":"only a toilet - nothing else at all!"},{"w":0.25925926208496097,"x":0.66460905506863066,"text":"In another room were hundreds of","h":0.014566955162378381,"y":0.4607237423499293},{"h":0.014741425375336514,"y":0.47819767430213045,"x":0.66872428860106481,"text":"green boxes, and in each one there","w":0.25514402389526369},{"y":0.49418604667373889,"w":0.25308641433715828,"x":0.6687242856554948,"h":0.014640078329976824,"text":"was a dark brown wig. Nobody"},{"x":0.66872428860106481,"text":"knows how many of them he","w":0.25514402389526369,"h":0.014563106796116498,"y":0.51015004381840245},{"y":0.52748645210486678,"text":"actually wore.","w":0.10705899238586425,"h":0.013341049335745758,"x":0.66663511464370218},{"h":0.014705504765051725,"y":0.41424418593003742,"x":0.10905349911449204,"text":"W.J. Cavendish-Scott-Bentinck","w":0.24897119522094729},{"x":0.10699589132372694,"text":"the fifth Duke* of Portland, was","h":0.016057646600735054,"y":0.42877907013526217,"w":0.25720163345336916},{"x":0.10905350275940442,"y":0.44616063567774944,"h":0.014595178198414605,"w":0.25308641433715817,"text":"a very wealthy and very odd"},{"x":0.11111110959607046,"y":0.46366279109609176,"w":0.25102880477905276,"h":0.013081394879037367,"text":"Englishman. He was born in 1800"},{"x":0.10699588316602923,"w":0.25102880477905276,"h":0.014611855293940601,"text":"and lived to be nearly 80 years old","y":0.47965116285833198},{"y":0.4955869374734867,"w":0.14814814567565918,"x":0.11111111022115541,"text":"The Duke was","h":0.011680504124667479},{"h":0.011680504545529935,"x":0.25720164581328342,"y":0.49558693739177151,"text":"a successful","w":0.10493826866149908},{"x":0.10879999749142222,"text":"businessman with lots of money","w":0.25354290008544922,"h":0.017153202066985451,"y":0.50913746944721661},{"text":"and an amazing home, but he was","x":0.10905350180775834,"y":0.52761627886850637,"w":0.25308641433715817,"h":0.014749122949585081},{"y":0.54633715790787984,"x":0.10905349667033129,"w":0.18312757492065432,"h":0.01191526919682262,"text":"not an average aristocrat."},{"y":0.57105030851163552,"text":"The first unusual thing about him","w":0.25514402389526358,"x":0.10699589019228586,"h":0.014705505606776748},{"w":0.19547325134277344,"x":0.10699588657141162,"text":"was his choice of clothes.'_","y":0.58561341587776883,"h":0.014677281729015501},{"w":0.049382715225219753,"h":0.013081394879037256,"text":"He","x":0.3127572021953462,"y":0.58720930234245816},{"w":0.25308641433715817,"h":0.013081394879037367,"text":"also liked wearing wigs*, and","x":0.10905350381393113,"y":0.6031976745626616},{"w":0.25359224319458007,"x":0.10875715017695654,"h":0.016947207572916789,"y":0.61689644669785604,"text":"pieces of material tied around his"},{"h":0.016328331862312417,"text":"ankles (nobody knows why!).","x":0.10493827947493188,"w":0.22427982330322266,"y":0.63503971773605972},{"text":"Another unusual thing about","y":0.66279069807283597,"h":0.013290502071801491,"w":0.25308641433715817,"x":0.10905350232216157},{"text":"him was his incredible shyness.","x":0.10905350486845783,"h":0.013239187996469504,"w":0.25308641433715823,"y":0.67872903784981409},{"w":0.25102880477905271,"h":0.014686262092017954,"y":0.69461606375120044,"x":0.10905349932515122,"text":"He lived in a huge house called"},{"w":0.25720163345336916,"text":"Welbeck Abbey, but spent most of","h":0.016075606485015048,"y":0.71075581436127955,"x":0.10699589341734829},{"y":0.72361851689291801,"x":0.1087366678434266,"w":0.25366733551025389,"h":0.019333688747746103,"text":"his time in just one or two of the"},{"x":0.10699588503453565,"w":0.25514402389526369,"text":"rooms. He had many servants*,","y":0.74404236526823786,"h":0.013239187996469504},{"h":0.014534883760080164,"w":0.25308641433715817,"y":0.76017441882732428,"x":0.10905350089040582,"text":"but he was too shy to talk to them."},{"w":0.010288065671920782,"text":"2","y":0.77470930247899528,"x":0.10699588475663219,"h":0.010174417958676241},{"x":0.15390529548161413,"text":"_ If servants did meet him","w":0.20844614028930664,"h":0.017348905632375899,"y":0.77343863754300235},{"y":0.79214474858510486,"h":0.014563106796116609,"text":"anywhere in the house or garden,","w":0.25514402389526364,"x":0.10699589251052992},{"x":0.088435284333526709,"h":0.014768122364121616,"text":"GLOSSARY","w":0.080331077575683585,"y":0.84290663631044893},{"x":0.10493827480718913,"h":0.01191526919682262,"w":0.30452674865722656,"y":0.86760812003618271,"text":"duke (n) - a very important English aristocrat"},{"text":"wig (n) - false hair worn on the head","x":0.1046890307866688,"w":0.24739522933959962,"y":0.87982806363896671,"h":0.015876128625154307},{"text":"servant (n) - in the past, people paid servants to cook","w":0.36831275939941405,"x":0.10493827630166454,"h":0.013300765644420398,"y":0.89534883722617908},{"h":0.01166767581626571,"text":"and clean, etc. for them","w":0.16049383163452147,"x":0.10493826988232768,"y":0.91129744024894277},{"h":0.013081394879037256,"y":0.86482558153940592,"text":"underground (adj, adv) - below the ground, e.g. you can","x":0.51646090809162903,"w":0.38888889312744135},{"text":"leave your car in the underground car park; rabbits live","y":0.87936046526033607,"x":0.51440329934815454,"h":0.013081394879037367,"w":0.37242797851562492},{"text":"underground","x":0.51440329418905129,"y":0.8968023259952258,"w":0.090534973144531294,"h":0.010174417958676241},{"x":0.088477367271542637,"text":"50","y":0.9476744190030687,"h":0.013081394879037256,"w":0.02263374328613281}]
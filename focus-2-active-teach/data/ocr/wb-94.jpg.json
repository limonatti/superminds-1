[{"w":0.072016458511352535,"x":0.10288065969036854,"text":"7.4","y":0.053779069674943503,"h":0.037790697439518683},{"text":"READING","w":0.14827294349670411,"x":0.22215982358878406,"y":0.030294469069719221,"h":0.020806411042848971},{"x":0.22222222382241077,"h":0.013081394879037256,"y":0.072674418748708169,"text":"Shopping • antonyms","w":0.16255144119262696},{"x":0.54762670414719561,"text":"HICH STREET","y":0.091497816643322682,"w":0.22143568038940431,"h":0.048267320732258145},{"y":0.16527703699282181,"h":0.054622980102646768,"w":0.29082622528076169,"text":"Sale now on","x":0.43418188954248477},{"text":"Globalholidays.com","x":0.10905349924154273,"y":0.31976744181182037,"h":0.014534883760080164,"w":0.13580246925354003},{"h":0.013081394879037256,"y":0.31976744222617903,"text":"Home | Search Contact","w":0.13991768836975099,"x":0.33127572338714101},{"h":0.014715767916808176,"text":"you searched for 'Boxing Day'","w":0.2695473289489746,"y":0.3384819066667204,"x":0.1069958804020559},{"h":0.01167537296965182,"x":0.11111111507467882,"y":0.36187113848073105,"w":0.30452674865722656,"text":"In Britain, Canada, New Zealand and parts of"},{"x":0.11111111652411307,"y":0.37500000003217526,"w":0.31687242507934577,"text":"Australia, the 26th of December is Boxing Day.","h":0.01162790683971926},{"x":0.11111112346663603,"w":0.33539093017578125,"y":0.38790820845321505,"h":0.013254581882379157,"text":"Originally, this was the day when rich people gave"},{"w":0.34362140655517576,"h":0.011643301146491258,"x":0.11111111171726794,"text":"their servants small Christmas gifts, but these days","y":0.40114739638674046},{"h":0.01162790683971926,"y":0.41424418618769854,"text":"Boxing Day is all about shopping. There are big","w":0.32098766326904293,"x":0.1111111026247379},{"text":"sales with reductions on everything, and customers","y":0.42718446617466832,"w":0.34567901611328128,"h":0.01191526919682262,"x":0.11111111354829756},{"text":"spend huge amounts of money. Shops and shopping","x":0.11111112181352772,"w":0.35596706390380861,"y":0.44040697672548923,"h":0.011627906839719371},{"w":0.31275718688964849,"text":"centres open very early (some of them as early","h":0.011648432722369484,"x":0.11111112161690415,"y":0.45348837207432646},{"text":"as 5 a.m.) and shoppers often start queuing* for","x":0.11111111431148821,"w":0.32510288238525387,"y":0.4636627908780685,"h":0.013081394879037256},{"y":0.47758441306526056,"w":0.32329933166503905,"text":"bargains in the middle of the night, hours before","x":0.11098116028271292,"h":0.013936516255903197},{"w":0.37684162139892574,"h":0.015855314451724389,"text":"The shopping centre opened at half past nine. They met","x":0.55951972102848657,"y":0.37422418181126771},{"h":0.017138204212643338,"w":0.36252079010009763,"x":0.55743618524325345,"y":0.38660415032382534,"text":"by the entrance at twenty-five past. There was no one"},{"text":"else around. They waited next to the sign that showed","x":0.55967079872122549,"y":0.40114739646228492,"w":0.36213989257812507,"h":0.013239187996469504},{"y":0.41424418649943484,"x":0.55761318367125368,"text":"the centre rules - no smoking: no dogs: no radios; no","w":0.36419750213623048,"h":0.013081394879037256},{"x":0.55967080004626613,"w":0.38477363586425783,"h":0.013239187996469504,"text":"skateboards. They looked at each other nervously. At half","y":0.42718446590202475},{"y":0.43859391365105482,"x":0.55940723634360834,"text":"past, the cleaner unlocked the doors. They were still the","w":0.37491405487060547,"h":0.016435355500425852},{"y":0.4510754864517792,"w":0.37904464721679687,"x":0.55943937845836611,"text":"only people waiting. It looked safe. It was time. Through","h":0.017136418072396742},{"y":0.46646072377169689,"text":"the doors, boards ready and then suddenly, full speed!","w":0.36419754028320317,"x":0.55967078173597029,"h":0.013239187996469615},{"h":0.015600384596902939,"w":0.3603892135620117,"x":0.55952480262117776,"y":0.47811208823945162,"text":"They flew through the shopping centre, the wheels of"},{"text":"their skateboards speeding silently on the perfectly flat","y":0.49117387484806541,"h":0.013239187996469504,"x":0.5596707847807455,"w":0.3683127593994141},{"text":"floor. The feeling was fantastic, amazing: just as they","h":0.015769249763724402,"x":0.55951660581240015,"y":0.5041429293645473,"w":0.35628959655761727},{"y":0.51845159200608204,"w":0.3439908599853515,"x":0.55744193265186426,"text":"imagined. And then... they saw the security guard.","h":0.015341382476995236},{"y":0.56395348870043149,"h":0.013081394879037256,"w":0.17489711761474608,"x":0.1111111120774006,"text":"Saveourcitycentre.net"},{"h":0.010315533980582492,"x":0.33333333422190348,"y":0.56250000019580726,"text":"discussion forum","w":0.12551440238952638},{"x":0.11111111354829756,"w":0.34567901611328128,"h":0.01162790683971926,"y":0.58866279069351235,"text":"share your opinion and help save our city centre"},{"x":0.11111111682822966,"h":0.01191526919682262,"text":"Safari_23 says: For the last ten years, I have owned","w":0.34773662567138669,"y":0.60591350377747},{"h":0.015060131884420791,"w":0.362523193359375,"y":0.61828249287834824,"x":0.11092138952401158,"text":"a clothes shop called 'Safari' on the main street of our"},{"x":0.10905350113403134,"h":0.013239187996469504,"text":"town. About six months ago, a big shopping centre","w":0.34567901611328122,"y":0.63371579867355676},{"w":0.36213989257812507,"x":0.1111111281965341,"h":0.01162790683971926,"y":0.6482558139493263,"text":"opened just outside the town and since then business"},{"y":0.66279069763391951,"w":0.34362140655517576,"text":"has been bad. Every month fewer customers come","x":0.11111111171726794,"h":0.011627906839719149},{"h":0.013081394879037256,"y":0.67587209323393105,"text":"into the shop and it is getting harder to make a living.","w":0.35596706390380861,"x":0.11111112418664146},{"w":0.34773662567138675,"h":0.013285370916785721,"y":0.69020300083959341,"x":0.11111111450998563,"text":"I used to love my job, but standing there all day with"},{"w":0.34402801513671877,"y":0.7039340580709994,"x":0.11094498686011051,"text":"hardly any customers is really boring. The little café","h":0.015447803440077235},{"text":"opposite had to close down* last month. I know that","x":0.11111111314657073,"w":0.34979423522949216,"h":0.013239187996469504,"y":0.71800529558019377},{"h":0.016238973504762555,"text":"other small businesses on the street are having big","w":0.34191387176513677,"y":0.73236489176391584,"x":0.11094849848055979},{"text":"problems too. Some of them have actually moved to","w":0.34773662567138669,"y":0.74845542791909525,"h":0.011915269196822509,"x":0.11111110776101456},{"y":0.76301853503878447,"x":0.11111110755525321,"w":0.34773662567138669,"text":"the shopping centre recently. I am not sure what the","h":0.01169076727642393},{"x":0.11111111932473701,"y":0.77616279077157013,"w":0.33539093017578131,"h":0.011627906839719149,"text":"solution is, but I feel sad and angry, and I'm afraid"},{"y":0.79214474850999117,"h":0.0088261253309797061,"text":"that I will have to close down my shop too.","x":0.11111111400683989,"w":0.28189300537109374},{"h":0.016028140775944832,"y":0.57267441901244232,"x":0.67283950835558615,"text":"We are looking for","w":0.14814814567565915},{"h":0.027802294792586002,"w":0.27572015762329094,"text":"'secret shoppers'","y":0.5900264780076413,"x":0.60905350295275784},{"x":0.63374486306546685,"y":0.61915269224638059,"w":0.22427982330322271,"h":0.016021725990450264,"text":"to work for our large chain*"},{"text":"of clothing shops","y":0.63503971729052489,"w":0.13991768836975105,"x":0.67695473746121504,"h":0.014669584996491958},{"y":0.65352128997515069,"x":0.5718440399228687,"text":"Our secret shoppers travel around the UK, visit different","w":0.35220710754394535,"h":0.014706787553805833},{"text":"stores* and pretend to be real customers. On a typical","w":0.35428794860839841,"h":0.01611243110784677,"y":0.66364992563706127,"x":0.56977393862601344},{"h":0.011677938547159705,"x":0.57201646883562485,"w":0.35185184478759768,"y":0.67872903801950235,"text":"visit, they go into one of our stores and ask questions"},{"y":0.68873010279326852,"x":0.57188106225027679,"w":0.35208881378173829,"h":0.013640176902696921,"text":"about our clothes and shoes. Their main job is to"},{"text":"check that our in-store sales assistants are friendly, and","h":0.01162790683971926,"x":0.57201646304391163,"y":0.70203488384229684,"w":0.35185184478759768},{"text":"know a lot about our products. Secret shoppers have","h":0.01191526919682262,"w":0.35185184478759768,"x":0.57201647030167424,"y":0.71359223307919695},{"x":0.56995885122221024,"y":0.72529069812734182,"w":0.35390945434570309,"text":"to listen carefully, remember all the details and then","h":0.013081394879037256},{"y":0.73521966715176812,"text":"send a report to our London office to describe their","x":0.56974052015601695,"w":0.35432659149169932,"h":0.015666535757120292},{"y":0.74999999995950084,"text":"visit. If you are offered a job as a secret shopper, you","w":0.35185184478759768,"x":0.57201646883562485,"h":0.011694616063548047},{"w":0.35185184478759757,"h":0.013081394879037256,"y":0.76162790704812677,"x":0.57201646852698307,"text":"will have to keep your job and your identity secret."},{"h":0.01191526919682262,"text":"For an application form.","x":0.66666666764099802,"y":0.78331862307746225,"w":0.16255144119262699},{"text":"email targetstores.gm@css.net.","h":0.010257804698893591,"x":0.64403292554656599,"y":0.79788172980733407,"w":0.20781892776489264},{"h":0.01035401974751271,"x":0.6563786048390079,"y":0.80959302366964447,"w":0.18106994628906259,"text":"Interviews start in October."},{"w":0.090720987319946281,"x":0.090441974569892489,"y":0.84269470013282743,"h":0.013738506785137772,"text":"GLOSSARY"},{"x":0.11522635349292727,"w":0.36419750213623048,"text":"to queue (v) - to stand in a line of people waiting to","h":0.014568238792857069,"y":0.86627906950561884},{"text":"do something, e.g. pay in a shop","x":0.11728395301897208,"y":0.88372093039478372,"w":0.22839506149291988,"h":0.013081394879037256},{"w":0.36419754028320311,"y":0.89805825245789617,"text":"to close down (phr. v) - if a business closes down, it","h":0.01191526919682262,"x":0.11522632818658785},{"h":0.01162790683971926,"y":0.91424418621192349,"w":0.2037036895751953,"x":0.11522634111775226,"text":"stops operating permanently"},{"y":0.86319505718414491,"text":"chain (of shops) (n) - a number of shops (also hotels,","w":0.3683127593994141,"h":0.014711919550546293,"x":0.53703703962128058},{"y":0.87936046545292323,"text":"cinemas, restaurants, etc.) owned by the same company","x":0.53909464419759634,"w":0.38888889312744135,"h":0.013081394879037256},{"x":0.53904547693265226,"h":0.010516791246890644,"y":0.89808462751695783,"text":"or person","w":0.070057196617126505},{"text":"store (n) - a large shop that sells many different things","h":0.014534883760080275,"w":0.36831275939941399,"y":0.90843023229631648,"x":0.53909465222759057},{"y":0.95058139552014709,"text":"92","h":0.013081394879037367,"w":0.024691357612609863,"x":0.098765432459127153}]
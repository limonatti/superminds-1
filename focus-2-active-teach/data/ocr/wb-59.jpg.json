263671875,"y":0.27576789647384548,"h":0.016798202905208726},{"w":0.047424845695495654,"text":"PART 2","h":0.0089945544843008651,"x":0.56373613634912456,"y":0.10015388560394567},{"text":"Talk about homes.","x":0.56378601227456127,"w":0.13786007881164553,"y":0.11606354827855803,"h":0.01191526919682262},{"text":"1 What does your home look like?","y":0.13062665493862535,"w":0.248971176147461,"h":0.01191526919682262,"x":0.56378602101406083},{"h":0.010174417958676241,"y":0.14389534899062317,"text":"2","w":0.012345678806304994,"x":0.56378600819629876},{"w":0.35390945434570309,"h":0.013239187996469504,"x":0.57818930026199089,"text":"Do you like modern architecture? Why?\/Why not?","y":0.14386584302929584},{"x":0.56378600841918369,"w":0.010288065671920754,"y":0.15843023305070059,"h":0.010174417958676241,"text":"3"},{"x":0.5884773695324681,"y":0.15842894980156086,"w":0.27160493850708012,"text":"Where do you want to live in the future:","h":0.011629189628473147},{"h":0.013266127822889384,"x":0.58641975742338193,"y":0.172965116731993,"w":0.32716049194335939,"text":"in the city, in a small town or in a village? Why?"},{"x":0.56172839502757455,"h":0.010174417958676241,"y":0.18604651178132081,"text":"4","w":0.012345678806304883},{"text":"5","x":0.56172839507041816,"y":0.20058139554464449,"h":0.010174417958676241,"w":0.010288065671920865},{"text":"Can you describe your ideal bedroom?","w":0.27160493850708012,"x":0.58641974957362053,"y":0.18750000010484968,"h":0.011627906839719149},{"h":0.013081394879037367,"text":"Would you prefer to live in a treehouse near the","w":0.33127571105957032,"y":0.20058139580176038,"x":0.58641975499833565},{"y":0.21491615179669821,"h":0.013281522550523839,"w":0.35596706390380861,"text":"ocean or in a house on stilts in the rainforest? Why?","x":0.58641976442155241},{"x":0.11109539633773338,"text":"PART 2","y":0.6046084844502978,"w":0.047356534004211415,"h":0.0088062867167136849},{"h":0.013244319151485273,"y":0.62047661087039774,"text":"In pairs, ask and answer the questions.","w":0.29012344360351561,"x":0.10905349970029996},{"x":0.11111111904138625,"w":0.35185184478759762,"h":0.013239187996469504,"text":"1 What are the most attractive things about living","y":0.6350397175849708},{"y":0.64954664885049518,"w":0.08445094108581544,"x":0.13164284272958859,"text":"in a village?","h":0.011953214155501879},{"h":0.017441859838716378,"x":0.10699588897803029,"y":0.66279069816203717,"text":"2 Why do you think so many people live in the city?","w":0.37037036895751946},{"x":0.10905350453398292,"text":"3 What are the good things about living on a lake?","w":0.36213989257812496,"h":0.013081394879037256,"y":0.67732558141222554},{"text":"4 What are the good things about living in the suburbs","x":0.10905350251525114,"y":0.69186046529667311,"w":0.39094650268554687,"h":0.013081394879037367},{"y":0.70408639515088534,"x":0.13157549146296119,"w":0.28420286178588872,"h":0.014072562147849244,"text":"of a city instead of the centre of the city?"},{"y":0.63662790737516162,"text":"5 What are the health benefits of living near the sea?","w":0.37654319763183597,"x":0.55555556391556338,"h":0.013081394879037256},{"w":0.34567901611328122,"x":0.55349794482401782,"text":"6 Would you prefer to live in a small flat in a city","y":0.64960282463837504,"h":0.016094849158048818},{"w":0.25308641433715817,"h":0.0146131389244194,"text":"or a big house in the country? Why?","x":0.57613169175852263,"y":0.66416593077954089},{"w":0.36625514984130858,"h":0.013239187996469504,"text":"7 Which of these locations do you like best for your","x":0.55555555631391362,"y":0.67872903780136451},{"w":0.13991768836975094,"x":0.574074075876853,"h":0.013239187996469615,"y":0.69329214464917399,"text":"future home? Why?"},{"h":0.014654189847994936,"text":"3 Discuss this question together. 'Is it better to live in the countryside or the city?' What do you think?","x":0.084362142800263051,"w":0.75308639526367194,"y":0.73389232161780105},{"text":"For the countryside:","y":0.76598837230688455,"h":0.01162790683971926,"w":0.15843621253967285,"x":0.13374485769621294},{"text":"Living in the countryside ...","x":0.13168724556052955,"h":0.011627906839719149,"w":0.20576131820678709,"y":0.79069767448711725},{"w":0.29423868179321283,"h":0.01191526919682262,"y":0.80803177396310399,"x":0.12962962539283129,"text":"• is quieter, healthier and more relaxing."},{"w":0.23662549972534178,"text":"• means you're closer to nature.","h":0.01162790683971926,"y":0.82122093010727215,"x":0.12962963323060769},{"y":0.83575581382820241,"x":0.12962963141055009,"w":0.15432098388671875,"h":0.011627906839719149,"text":"• is usually cheaper."},{"x":0.12962964323665566,"w":0.28189298629760745,"text":"• means you usually have more space.","y":0.85029069774293109,"h":0.011627906839719149},{"h":0.015082043667125844,"w":0.093118162155151341,"y":0.76498804787022678,"x":0.55117754536042363,"text":"For the city:"},{"w":0.12757201194763179,"text":"Living in a city ...","y":0.79069767445804751,"x":0.55349794591918811,"h":0.011627906839719149},{"x":0.55144032907240981,"text":"• is more interesting (restaurants, exhibitions,","w":0.33127571105957032,"h":0.013260996667873726,"y":0.80668604652850462},{"y":0.82122093010727215,"h":0.01162790683971926,"text":"cafés, shows, etc).","w":0.12757201194763179,"x":0.57407407482179451},{"x":0.55144033478500287,"h":0.013081394879037256,"text":"• can help you to find a job.","w":0.20987653732299805,"y":0.83575581417021971},{"x":0.55144033173431284,"h":0.018895348719759286,"w":0.26748970031738284,"y":0.84447674400857964,"text":"• gives you the opportunity to meet"},{"text":"more people.","x":0.57389239352533583,"w":0.09912878990173335,"y":0.86399973572087763,"h":0.013279598367393008},{"text":"• means that you are closer to airports,","w":0.2880658340454102,"x":0.54938272563847446,"h":0.011636886781859146,"y":0.87936046518479161},{"h":0.010341191018248486,"text":"stations, etc, so it's easier to travel.","w":0.24485595703124996,"x":0.57407407603684424,"y":0.89389534921470259},{"h":0.017441859838716378,"y":0.94622093067034274,"text":"57","x":0.90946502084590708,"w":0.028806583881378134}]
75308609008789,"x":0.66460905267713255},{"h":0.013244319572347729,"x":0.57407407683624967,"y":0.36627906983276826,"text":"\"All of the sudden, someone\"","w":0.20576131820678711},{"x":0.85586679619759454,"w":0.051640892028808616,"h":0.010691677271951527,"y":0.3674739286422023,"text":"(start)"},{"x":0.57407409334587001,"h":0.013239187996469615,"text":"shaking me. I was the only person left on the bus.","w":0.34156375885009771,"y":0.38217122702252115},{"h":0.014624684023204715,"w":0.33539093017578125,"y":0.39534883718972735,"x":0.57201647242239739,"text":"\"What was going up? I slowly realised I was lost."},{"x":0.56995884855860335,"h":0.014574652736626836,"text":"\"Lhave to saying I was scared. I'","w":0.23251028060913093,"y":0.41129744030620397},{"w":0.32510288238525398,"x":0.57201646329296973,"h":0.013239187996469504,"y":0.42586054730311063,"text":"(not\/have) any money and my phone was dying."},{"y":0.44040697672461104,"w":0.12345678329467769,"text":"\"I was by trouble.","x":0.56995884991644719,"h":0.014579783891642495},{"h":0.013239187996469615,"y":0.46072374220171031,"text":"While I","w":0.067901234626770002,"x":0.5720164614160389},{"w":0.15226337432861325,"h":0.013243036362731386,"y":0.46204766097504302,"x":0.71810699748589912,"text":"(think) what to do. 1°"},{"w":0.33950614929199219,"y":0.47661076782152689,"x":0.57201647511394882,"text":"(see) a woman. She was wearing a pilot's uniform.","h":0.01466830220773796},{"text":"*Lucky, she helped me. 'She was incredible kind","x":0.56995885655280976,"w":0.33744853973388667,"h":0.014534883760080275,"y":0.4927325582653086},{"h":0.013287936494293606,"text":"and told me how to get to the airport and even gave","w":0.35185184478759768,"y":0.50706090040743435,"x":0.57201647030167424},{"text":"me ten dollars for the ticket.","w":0.19753086090087901,"y":0.52162400707068779,"h":0.01191526919682262,"x":0.57201646502281145},{"y":0.54215116269844832,"x":0.56995885269422486,"w":0.1234567832946778,"text":"When I finally\"_","h":0.014534883760080164},{"x":0.76131687188077701,"y":0.54360465121589008,"w":0.13168724060058601,"h":0.014647775904225391,"text":". (get) on the plane."},{"y":0.55648720206938973,"h":0.016328331862312417,"text":"the pilot\"-","x":0.56995884872751745,"w":0.076131687164306627},{"h":0.010191095475064693,"y":0.55957634615325591,"x":0.7160493825340366,"text":"_(make) an announcement.","w":0.18724279403686528},{"h":0.013081394879037256,"w":0.31687242507934565,"text":"I recognised her voice immediately. It was the","y":0.57267441881532632,"x":0.57201646763865344},{"x":0.57201646331617573,"y":0.58720930224874512,"w":0.18518518447875976,"h":0.011643301567353714,"text":"woman from the bus. She \""},{"text":"_ (invite) me","y":0.58824123128266925,"w":0.088692016601562451,"x":0.8270531697584278,"h":0.012471025640314326},{"y":0.60174418606338831,"x":0.56995885546891312,"text":"to the front of the plane and '","w":0.21193414688110357,"h":0.013081394879037256},{"text":"_(explain)","w":0.072349138259887646,"h":0.014025638509617355,"y":0.60272555291721053,"x":0.85580073860958894},{"h":0.014659321844735507,"x":0.56790123614089028,"w":0.34567901611328122,"y":0.61773255809089023,"text":"how everything worked. -T'll always forget the day."},{"y":0.63371579887341134,"x":0.56995885078624842,"w":0.17489711761474602,"h":0.013239187996469615,"text":"Ltravelled with the pilot."},{"text":"4 Read the story again. Choose the correct words.","h":0.017456664938055422,"x":0.088302783417510328,"y":0.64670988812562835,"w":0.38306777954101567},{"text":"Hitting the JACKPOT","h":0.043487111131174871,"w":0.51997901916503908,"x":0.11242182904821889,"y":0.67834026802350256},{"x":0.6296296278423984,"y":0.68168604674555211,"w":0.080246915817260733,"text":"{24","h":0.023255813679438408},{"y":0.67877906984941594,"text":"12%","x":0.70781892944587421,"w":0.067901234626770113,"h":0.029069767520160439},{"y":0.68459302319027426,"text":"·32","w":0.061728396415710485,"x":0.84156378489032235,"h":0.024709302560481317},{"w":0.76543205261230474,"h":0.013239187996469504,"y":0.72815533989661096,"x":0.11728397287080242,"text":"It was four years ago when my luck started to change. I was walking home from work when a man rushed out"},{"h":0.013239187996469504,"text":"of a newsagent's and jumped on a bus. \"Unfortunately \/ Incredibly, a small piece of paper fell from his pocket.","x":0.11522637009302436,"y":0.7427184464173856,"w":0.76543205261230463},{"text":"It was a lottery ticket. I put it in my bag and forgot all about it until a few weeks later when I found it again in my","h":0.013239187996469504,"x":0.11522634103382678,"y":0.76301853476250725,"w":0.79423866271972654},{"h":0.013081394879037256,"x":0.11316872542148161,"y":0.77616279080539408,"w":0.22633745193481447,"text":"handbag. I checked the ticket. '"},{"w":0.45679012298583976,"x":0.44444444924782078,"y":0.77758164186039436,"h":0.013239187996469615,"text":"It wasn't the winning ticket, but it won a small amount of money."},{"x":0.1131687177730025,"w":0.79012344360351561,"text":"\"Anyhow \/ I must admit 1 thought about taking the money, but I decided to keep the ticket for good luck instead.","h":0.014609290558157628,"y":0.79651162764515371},{"text":"*Actually \/ While, my luck did change after that. ?","x":0.1131687234138144,"y":0.81244483654888755,"w":0.35185184478759768,"h":0.013239187996469504},{"w":0.8251028442382814,"y":0.8327449247777301,"text":"1 met my husband, Paul. On our wedding day, he said he felt like the luckiest man alive. At that moment, 1 decided to","h":0.013239187996469504,"x":0.11316875074094149},{"h":0.013239187996469504,"y":0.84730803159646995,"w":0.77160491943359377,"x":0.11316874334390249,"text":"tell him the story of my lottery ticket to show him I was lucky too. Then \/ Unfortunately Paul started to laugh."},{"y":0.86918604661934762,"text":"the next thing he told me. He used to play the lottery and the numbers on the ticket were his lucky","w":0.66255142211914064,"h":0.013081394879037256,"x":0.22633746594660231},{"y":0.88217122703451911,"text":"numbers. \"During \/ Suddenly I knew who he was. It was Paul who dropped the ticket. 1 couldnt","x":0.11316873233264119,"w":0.67695472717285154,"h":0.014631098808699283},{"x":0.1131687386171442,"h":0.013239187996469504,"y":0.89673433378554379,"text":"believe it! We weren't rich, but we were very happy 'anyway \/ luckily.","w":0.48765430450439456},{"text":"• Hit the Jackpot - to be very successful or lucky","h":0.010174417958676241,"w":0.2304526710510254,"y":0.91569767468708618,"x":0.11728395542098929},{"y":0.94186046511211718,"text":"26","h":0.011627906839719149,"w":0.024691357612609863,"x":0.094650206173118936}]
4522,"h":0.013239187996469615,"text":"4 Amy doesn't like classic oil \/ modern abstract \/ black"},{"text":"and white paintings because she doesn't understand","x":0.57407406659169136,"y":0.64077669904307566,"h":0.01191526919682262,"w":0.36625514984130869},{"x":0.57580828813810425,"h":0.014563823104009943,"y":0.6538231341201638,"w":0.1425923252105713,"text":"what they are about."},{"text":"; Ilove the picture that hangs in my parents' living","y":0.66715116315851808,"h":0.015990937376906045,"w":0.35185184478759768,"x":0.55967078329035758},{"h":0.013241753573977388,"text":"room. It's an 18th-century photo \/ painting \/ landscape","x":0.57407407015086986,"w":0.37037036895751951,"y":0.68313953517312676},{"y":0.69532573438861889,"w":0.35419486999511718,"h":0.016266554304697034,"x":0.5739317926266041,"text":"of a group of young children sitting in front of their"},{"text":"house.","w":0.04744389057159426,"y":0.71061646506401821,"x":0.57401468101704411,"h":0.01045311644134117},{"text":"6","h":0.0087209299193582446,"w":0.010288065671920754,"y":0.72529069772200683,"x":0.54938271605807254},{"w":0.36419750213623048,"text":"There's an exhibition of old movie posters copied\/","x":0.56378601652447757,"y":0.72529069793354339,"h":0.013081394879037256},{"y":0.73962930280039207,"text":"taken \/ pasted on walls and buildings in the city","x":0.57201646131692274,"w":0.33127571105957032,"h":0.013277673763399722},{"text":"centre. Shall we go and see it?","x":0.57201646478451063,"h":0.01191526919682262,"y":0.75419240940913979,"w":0.21399175643920898},{"y":0.76744186091528399,"w":0.010288065671920754,"h":0.010174417958676241,"text":"7","x":0.54938271621239354},{"y":0.76743159752403511,"text":"Art in public places \/ in an art gallery \/ at a museum","x":0.57201647766008601,"h":0.013239187996469504,"w":0.36008228302001954},{"h":0.013257147880749498,"y":0.78197674463896971,"w":0.36419750213623048,"x":0.57201647550938817,"text":"is great because everybody can see it for free - even"},{"w":0.30864196777343755,"x":0.57201646853097654,"text":"when they walk to work. Yes, I love street art.","h":0.011627906839719149,"y":0.79651162797548936},{"h":0.01164201835773726,"y":0.74271844680630839,"x":0.12757201415184244,"text":"What is this street artist called?","w":0.21604938507080074},{"y":0.75726744235302634,"w":0.0411522626876831,"x":0.12551440425286622,"h":0.010174417958676241,"text":"What"},{"x":0.22839506191320219,"text":"his age?","w":0.059670782089233376,"h":0.011627906839719149,"y":0.7572674420743265},{"y":0.77180232569835738,"text":"he paint people?","w":0.11934156417846678,"h":0.01162790683971926,"x":0.18724279716316719},{"h":0.010174417958676241,"y":0.78488372112603977,"x":0.10288065844490384,"text":"3","w":0.010288065671920768},{"x":0.10288065844490384,"text":"4","h":0.0087209299193581336,"y":0.79941860469875115,"w":0.010288065671920768},{"x":0.10288065841918365,"y":0.81395348844148374,"h":0.0087209299193581336,"w":0.010288065671920768,"text":"5"},{"x":0.12315332000639018,"y":0.78378474215711302,"w":0.09626085281372071,"h":0.024886554674247829,"text":"Where —"},{"w":0.069958844184875468,"y":0.78633720926182638,"text":"he paint?","x":0.23456790388492849,"h":0.011627906839719149},{"y":0.79941860499837514,"h":0.010174417958676241,"w":0.049382715225219725,"text":"What","x":0.1255144045273078},{"text":"_ he do in his home town last month?","w":0.25720163345336916,"h":0.01191526919682262,"y":0.79920564873978683,"x":0.21810699791666266},{"w":0.22427982330322263,"text":"he worked in the United States?","x":0.18518519347184545,"y":0.81376875567855389,"h":0.010359151323390936},{"h":0.0087209299193582446,"x":0.10288065865066512,"w":0.010288065671920782,"text":"a","y":0.83575581403741384},{"w":0.36419750213623048,"x":0.12345679841748165,"h":0.013081394879037256,"text":"He spray paints images on the walls of old buildings","y":0.83430232579207053},{"text":"in public places.","x":0.12345679300541917,"h":0.01191526919682262,"w":0.1152263355255127,"y":0.8486319505443356},{"y":0.86187113892251765,"w":0.38477363586425778,"h":0.01458234946915038,"x":0.10082305219818682,"text":"b He painted a graffiti picture of a running dog on the"},{"w":0.16872426986694333,"h":0.011647149933615597,"text":"side of the local factory.","x":0.12345679299862709,"y":0.87643424541938364},{"h":0.01324816793860939,"text":"c No, he usually creates images of animals.","w":0.31069957733154296,"x":0.1008230547241461,"y":0.89098837230975458},{"x":0.10082304626467603,"w":0.11934156417846681,"y":0.90406976745223333,"text":"d No, he hasn't.","h":0.011640735568983374},{"x":0.098765433468112923,"h":0.013081394879037367,"text":"e We don't know his identity. He wants to be","w":0.32304527282714846,"y":0.91860465134318481},{"y":0.93459302355457663,"w":0.08641975402832032,"x":0.12345679109283565,"h":0.010174417958676241,"text":"anonymous."},{"text":"PULL THE FLUG","w":0.23456789016723634,"y":0.9068843777589245,"x":0.6193415678793448,"h":0.022065313327449321},{"x":0.9053497940887556,"y":0.95348837208886139,"w":0.026748971939086874,"text":"35","h":0.01162790683971926}]
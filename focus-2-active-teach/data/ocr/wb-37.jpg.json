[{"y":0.061046512040491052,"h":0.027616278639117531,"w":0.05967078208923339,"x":0.11111111111587714,"text":"3.3"},{"y":0.13947287573438061,"w":0.39330570220947264,"x":0.094480816247809477,"text":"1 Complete the dialogue between the presenter and","h":0.015661291810967426},{"y":0.15299946370342565,"x":0.11712523288693909,"text":"Katy West with the correct form of the auxiliary verbs","w":0.39130130767822269,"h":0.016121217032396329},{"text":"do, be or have.","h":0.011653564298247598,"x":0.11728395202178575,"y":0.168578993743705,"w":0.10905349731445312},{"y":0.19902912636749392,"text":"Extract from Students' Book recording (4)1.49","w":0.28395061492919926,"x":0.14197530659575711,"h":0.013239187996469615},{"x":0.10493827161543592,"w":0.018518518209457394,"h":0.01162790683971926,"text":"P:","y":0.21947674413827989},{"y":0.22093023276881474,"w":0.32510288238525392,"x":0.12551439701039108,"text":"It's two thirty on Saturday afternoon, and you","h":0.013081394879037145},{"y":0.23389232119406844,"x":0.13991769501156898,"text":"are listening to the Culture Programme. In this","w":0.32098766326904293,"h":0.013239187996469504},{"text":"part of the programme, we invite a guest to talk","y":0.24845542810001753,"h":0.013239187996469504,"x":0.13991770181589383,"w":0.33127571105957032},{"w":0.32098766326904293,"x":0.13786008184284471,"text":"about their 'Artist of the Week'. This week, we","y":0.26301853467166425,"h":0.013239187996469504},{"h":0.013081394879037145,"w":0.34567901611328122,"x":0.1378600760997381,"y":0.2761627909870803,"text":"have Katy West in the studio. Katy is the Editor of"},{"text":"Photo Monthly Magazine. Welcome to the Culture","x":0.13991770119036953,"y":0.29069767462927976,"w":0.34773662567138675,"h":0.013081394879037367},{"h":0.013696614136658014,"w":0.08660250663757324,"x":0.13982631732288822,"y":0.30347146016529525,"text":"Programme."},{"w":0.10776851654052734,"h":0.012343169731685588,"text":"KW: Thankyou.","x":0.10662539381732299,"y":0.31848181354713234},{"y":0.33284883745961535,"w":0.024691357612609863,"text":"P:","x":0.10493827222250164,"h":0.010174417958676241},{"text":"Katy, tell us about your 'Artist of the Week'.","x":0.13786009397380805,"w":0.30246912002563481,"y":0.33274492483950335,"h":0.013239187996469504},{"w":0.37242797851562492,"text":"KW: My 'Artist of the Week' is a French photographer.","h":0.014616987290681283,"x":0.10493827072161142,"y":0.34593023239321563},{"text":"He takes photographs and makes them enormous.","x":0.13786008004104361,"w":0.35185184478759762,"y":0.36046511629594646,"h":0.013081394879037256},{"text":"Then he pastes them in public places.","y":0.37492285975076922,"w":0.26577308654785159,"h":0.014982922142412702,"x":0.13562976383980974},{"h":0.01191526919682262,"y":0.38790820837767059,"text":"P: 1","w":0.049382715225219725,"x":0.10493827263430369},{"w":0.12139917373657227,"h":0.010288593733300266,"x":0.19547325117183739,"text":"he have a name?","y":0.38953488391673741},{"x":0.1008230521086767,"w":0.22427982330322271,"y":0.40247131532206326,"h":0.014679847306523386,"text":"KW: Ah, well, he's called JR. |...]"},{"x":0.1028806712198222,"y":0.41703442197320428,"w":0.24897117614746095,"text":"P: So what kind of photographs2","h":0.013239187996469504},{"h":0.011627906839719149,"text":"he take,","w":0.059670782089233376,"y":0.42005813960339622,"x":0.39917695538028042},{"text":"and where can we see them?","w":0.20164608001708983,"x":0.13580247237828635,"y":0.43159752877211655,"h":0.011915269196822731},{"h":0.013239187996469615,"x":0.10288065426805712,"y":0.44616063564459851,"w":0.3683127593994141,"text":"KW: He takes black and white portraits of people and"},{"y":0.46072374245607084,"h":0.013239187996469504,"w":0.33333332061767579,"text":"pastes them on buildings, walls and bridges. He","x":0.13374485815824039},{"text":"had exhibitions in museums such as","x":0.19547325261586376,"y":0.47528684916667707,"h":0.010178267166663035,"w":0.24897119522094732},{"x":0.13374485916745532,"h":0.011627906839719149,"y":0.48837209305543106,"text":"the Pompidou Centre in Paris, but his favourite","w":0.32510288238525387},{"x":0.13361346545071867,"text":"art gallery is in the street. He wants people who","y":0.50113076769426801,"w":0.32947807312011718,"h":0.015395638380867105},{"h":0.011684352911791818,"y":0.51744186058207831,"text":"usually go to museums to see his work.","w":0.26954730987548825,"x":0.19341564098132324},{"h":0.013246885149855614,"x":0.084362135270333136,"y":0.54941860472254522,"w":0.41358024597167969,"text":"2 Complete the questions with the correct forms of the"},{"w":0.37242797851562504,"x":0.1090535041784014,"y":0.56531332731251749,"h":0.01191526919682262,"text":"auxiliary verbs be, do or have. Match them with the"},{"x":0.10699588939194349,"w":0.30452672958374022,"text":"answers a-d. There is one extra question.","h":0.01169333327479416,"y":0.57987643414700341},{"text":"STREET","x":0.271501806421305,"y":0.6233065336211302,"w":0.10102931022644041,"h":0.022282281389093384},{"w":0.10507974624633787,"y":0.64807257633900373,"text":"RUNNER","h":0.020715312839922229,"x":0.31062885039393379},{"h":0.020409132039136635,"y":0.033430232300097229,"w":0.52880657196044922,"x":0.22633745853770607,"text":"LISTENING LANGUAGE PRACTICE"},{"y":0.074127907157138351,"text":"Auxiliaries • radio programmes","w":0.22839506149291991,"h":0.013250733516117386,"x":0.22633745153234655},{"y":0.088662790729849728,"text":"• art and artists","x":0.2242798377927992,"w":0.1152263355255127,"h":0.011627906839719149},{"x":0.55349793997467434,"h":0.013081394879037256,"y":0.082848837280684817,"text":"REMEMBER BETTER","w":0.16255144119262688},{"text":"Use diagrams to record groups of connected words.","h":0.013081394879037256,"w":0.36419750213623048,"y":0.10755813979400852,"x":0.557613189158222},{"y":0.12047661068265547,"text":"This will help you remember them better.","h":0.013244319151485273,"w":0.28600822448730479,"x":0.55761316818330253},{"text":"A Complete the spider diagram with unde
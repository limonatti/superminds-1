[{"text":"7","w":0.012345678806304938,"x":0.096707818930180878,"y":0.23837209321906305,"h":0.01017441795867613},{"h":0.010174417958676241,"x":0.096707818938730983,"y":0.27616279089348161,"w":0.010288065671920768,"text":"8"},{"x":0.10288065865066512,"w":0.010288065671920782,"h":0.010174417958676241,"text":"6","y":0.045058139803365371},{"h":0.01191526919682262,"text":"Find and correct the mistakes.","w":0.22222221374511719,"y":0.046337158183393345,"x":0.12551440382703},{"text":"What do you enjoy to do?","x":0.14197531190347981,"y":0.063953488440605444,"h":0.01162790683971926,"w":0.18106994628906251},{"h":0.014057911925892452,"y":0.076163559981098472,"text":"What do you enjoy doing?","w":0.18363059997558595,"x":0.14379126658923147},{"y":0.091392057036614571,"h":0.011983327705672786,"w":0.092680864334106439,"text":"A Bye 5 now.","x":0.12752788174725904},{"x":0.12551441480922867,"y":0.11915269212007851,"w":0.33539093017578125,"text":"B I write to tell you about the plans for Saturday.","h":0.013239187996469615},{"x":0.12551440090976501,"text":"C How are you going?","y":0.14825581407045041,"w":0.15637860298156742,"h":0.01162790683971926},{"x":0.12551440718194151,"h":0.01168307012303782,"y":0.17587209309176832,"text":"D Hay Steven,","w":0.10082304000854492},{"x":0.12345680087469475,"w":0.31069957733154296,"y":0.20344218920158164,"h":0.014581066680396493,"text":"E Waiting forward to hearing from you soon."},{"w":0.38065841674804679,"h":0.013277673763399833,"x":0.12139918034339789,"text":"Put the sentences in Exercise 6 in the order they are","y":0.2396293027216615},{"h":0.013239187996469615,"y":0.2528684905732701,"text":"usually used in an email.","w":0.17695472717285157,"x":0.12345679094032327},{"text":"Read the task below. Then read the email and","y":0.27758164173761157,"w":0.33333332061767579,"h":0.011662544240387596,"x":0.12139917775700589},{"text":"complete the questions with the missing question","x":0.12139919404015551,"w":0.36213989257812496,"y":0.29214474860645967,"h":0.013239187996469615},{"w":0.051440329551696792,"text":"words.","h":0.010174417958676241,"x":0.12139917695940537,"y":0.30523255829294871},{"text":"You have received an email from your English-","x":0.12139919070771964,"w":0.33539093017578125,"y":0.33274492479710993,"h":0.013239187996469504},{"y":0.34730803174181868,"w":0.30041151046752934,"text":"speaking friend. Read the excerpt below.","x":0.11934157213249044,"h":0.013239187996469504},{"w":0.34362140655517581,"h":0.013081394879037256,"text":"Thanks for inviting me to visit you next month. I'm","x":0.12139917670183592,"y":0.36482558158664413},{"text":"really excited about coming to Spain for the first","y":0.37936046556920222,"h":0.013081394879037367,"x":0.11934157404105307,"w":0.33539093017578125},{"h":0.016162882415152069,"w":0.35428276062011721,"x":0.11918124914258765,"y":0.39096965145563178,"text":"time. Please tell me more about what sort of things"},{"h":0.016160884160229427,"w":0.35629787445068356,"x":0.11918609019210884,"y":0.4056062042313533,"text":"you do there in your free time. Do you like going to"},{"text":"the cinema or doing sports? What places do you like","x":0.11934156271848068,"y":0.42144748442288127,"w":0.36419754028320311,"h":0.013239187996469504},{"y":0.43601059141978782,"text":"visiting with your friends?","w":0.17695472717285154,"x":0.11934156822427376,"h":0.011663827029141594},{"y":0.45371590735130174,"x":0.11906937932263816,"text":"Write an email with a reply. Include and develop","w":0.35036853790283201,"h":0.017355293482673506},{"w":0.09684318542480469,"x":0.11721626603019392,"text":"these points:","y":0.46922273688563365,"h":0.01358940910682771},{"y":0.48982558142752419,"x":0.11111111652411307,"text":"• Say how you feel about your friend visiting you.","w":0.31687242507934577,"h":0.01162790683971926},{"text":"• Tell him\/her about some of the things you do in your","h":0.013291785281417834,"x":0.10905350052663039,"y":0.50436046527850453,"w":0.36831275939941405},{"y":0.51889534918442159,"w":0.065843620300292963,"x":0.12345679177029244,"text":"free time.","h":0.010230864451611255},{"y":0.53486319522797643,"w":0.38477363586425783,"x":0.10905351609564874,"text":"• Write about some of the places you visit with your friends.","h":0.013239187996469504},{"h":0.01191526919682262,"x":0.10905350457712175,"y":0.55075022058462075,"w":0.23251028060913081,"text":"• Ask about your friend's interests."},{"w":0.05967078208923339,"x":0.09465020616045873,"y":0.60591350387436926,"h":0.011915269196822509,"text":"Hi Barry,"},{"x":0.19547326086705838,"w":0.30041151046752934,"text":"are you? I'm really excited about your visit.","h":0.013081394879037256,"y":0.62645348855248717},{"text":"I'd love 'to tell \/ telling you about what I spend my free","x":0.090534976900420366,"y":0.64244186039709172,"w":0.38477367401123042,"h":0.014663170210997389},{"w":0.33575489044189449,"y":0.65749914035298374,"text":"time \"to do \/ doing and the places I like visiting.","h":0.015931522541096643,"x":0.092428040406956666},{"h":0.013239187996469615,"y":0.67872903781953309,"w":0.38271602630615237,"x":0.092592608914824973,"text":"As you know, I'm keen on 'do \/ doing sports. I hope you"},{"y":0.69461606326670433,"text":"don't mind*to wake\/ waking up early to go running O.","w":0.38477363586425783,"h":0.014686262092017954,"x":0.092592602198186713},{"y":0.71220930251687675,"text":"_ you like sports? Of course, I also enjoy","x":0.18312758009242927,"w":0.27777776718139646,"h":0.013298199646050057},{"x":0.090534985676204369,"h":0.013239187996469615,"y":0.72815533966041912,"text":"$to go \/ going to the cinema but | refuse to watch \/","w":0.36008228302001954},{"text":"watching romantic films!\"","h":0.013817075071141272,"w":0.18758926391601566,"y":0.74408399693679417,"x":0.090396025888894019},{"y":0.74563953504583191,"text":"_kind of films do","h":0.014731162223580285,"w":0.12345678329467769,"x":0.35596708031768176},{"text":"you like?'","x":0.090431137728369221,"y":0.75983229580635192,"w":0.084569826126098618,"h":0.013765640629147979},{"y":0.7630185347415831,"text":"you have a favourite film?","x":0.24897120109835902,"h":0.010237279237105823,"w":0.19135801315307621},{"h":0.013257147880749387,"w":0.29012344360351561,"x":0.18312757377437408,"text":"_ you ever heard of la Barceloneta? I hope","y":0.78197674454207056},{"text":"*to take \/ taking you there with my friends.","y":0.797516883038624,"h":0.013583961042385684,"x":0.088329873153226615,"w":0.30276933670043948},{"h":0.01180679695014919,"text":"I'm sure we'll have fun.","w":0.16291696548461915,"y":0.81387413350417892,"x":0.088308506840024711},{"w":0.084500913619995108,"h":0.012140303508223149,"y":0.8340461275013169,"text":"All the best,","x":0.090465593912478395},{"w":0.047325100898742672,"h":0.011627906839719149,"x":0.088477366654538148,"text":"Miguel","y":0.85465116289554743},{"text":"9 Read the email again. Choose the correct forms of","y":0.89389534929013248,"h":0.013081394879037256,"x":0.084362140003002392,"w":0.39300411224365234},{"w":0.078321566581726051,"x":0.10692975038449569,"y":0.9081706693947198,"h":0.010693545059513809,"text":"the verbs."},{"text":"SHOW WHAT YOU'VE LEARNT","y":0.053779070087128678,"h":0.013299482434803833,"x":0.54732509811508123,"w":0.24691358566284183},{"w":0.39711933135986321,"h":0.013081394879037256,"text":"10 Some family friends from the UK and their teenage","x":0.54526749878508884,"y":0.082848837400597675},{"w":0.3806584167480469,"text":"son are coming to stay with you and your family this","h":0.013081394879037145,"x":0.56995886127618234,"y":0.097383721092458186},{"y":0.11191860510408602,"h":0.013081394879037256,"x":0.5679012532871659,"w":0.36419750213623037,"text":"summer. You would like to learn something about"},{"y":0.12488967341091772,"text":"him before their visit. Write a personal email to him","w":0.37654319763183597,"x":0.56995885481062514,"h":0.013239187996469504},{"h":0.013239187996469504,"x":0.56995885881929542,"y":0.13945278034044239,"w":0.37860080718994138,"text":"giving some information about yourself. Include and"},{"text":"develop these points:","y":0.15401588696417245,"x":0.56995885243004496,"w":0.16049381256103512,"h":0.013239187996469615},{"h":0.013266127822889384,"text":"•Introduce yourself and say why you are writing.","w":0.33333332061767573,"y":0.17296511653819457,"x":0.5596707938063884},{"w":0.33369762420654292,"text":"• Tell him some basic information about yourself","h":0.017581663611497045,"x":0.55741720285977536,"y":0.18511865420302309},{"text":"(age, the place where you live, etc.)","w":0.24074073791503903,"y":0.20344218876872133,"h":0.013239187996469504,"x":0.57407407531545718},{"h":0.01191526919682262,"text":"• Tell him about your hobbies.","x":0.55761317700526436,"y":0.21932921428888308,"w":0.21193414688110346},{"x":0.5572778775887347,"h":0.015121584536223365,"text":"• Ask him about his interests.","w":0.20442985534667979,"y":0.23299206370875658},{"w":0.25308641433715817,"y":0.50872093023877829,"text":"SHOW THAT YOU'VE CHECKED","x":0.53909465472148554,"h":0.011627906839719149},{"y":0.53486319525825754,"h":0.013239187996469615,"w":0.26954730987548825,"text":"Finished? Always check your writing.","x":0.54115227548063705},{"text":"Can you tick \/ everything on this list?","w":0.27572015762329105,"h":0.014700373610036066,"y":0.547965116295832,"x":0.53703703708341632},{"w":0.15843621253967288,"text":"In my personal email:","x":0.53703703578263284,"y":0.56972639020001425,"h":0.011668958605019708},{"h":0.017910904307756881,"x":0.53679865293074269,"w":0.30512252807617191,"text":"• I have started with a friendly greeting e.g","y":0.58734758000743592},{"w":0.14609052658081056,"x":0.55555556218970437,"h":0.010235996027489369,"text":"Dear Nick or Hi Kate.","y":0.60458958506909677},{"text":"• the first paragraph says why l am writing.","x":0.53703704628740023,"h":0.013239187996469504,"w":0.29835390090942382,"y":0.62488967327162503},{"y":0.64518976179536103,"w":0.29218105316162102,"h":0.013240470364361046,"x":0.53703704394388085,"text":"• the second paragraph gives some basic"},{"w":0.31746131896972651,"h":0.017655623453650349,"text":"information about me (age, home town, etc.).","x":0.55111767185602423,"y":0.65721940698247239},{"h":0.016030763590746178,"text":"• I have included some information about my","w":0.31934408187866214,"x":0.53685860683797826,"y":0.67450699685490589},{"x":0.55144033265773928,"w":0.18518518447875976,"y":0.6918604651847915,"text":"likes\/dislikes\/hobbies, etc.","h":0.011627906839719149},{"x":0.5370370413822001,"h":0.013239187996469615,"text":"• I have included some questions to show","w":0.29423868179321289,"y":0.70917917046588796},{"y":0.7237422771473101,"w":0.12757201194763179,"x":0.55144032988009362,"h":0.01191526919682262,"text":"that I want a reply."},{"text":"• I have used contractions (e.g. I'm \/ aren't\/ that's).","w":0.34979423522949227,"y":0.744042365372519,"x":0.53703704226179705,"h":0.01191526919682262},{"x":0.53497942085750883,"y":0.76598837219787297,"w":0.29423868179321289,"text":"• I have perhaps used some emoticons ©","h":0.011627906839719149},{"text":"and abbreviations (info \/ CU\/ gr8), but","w":0.27160493850708012,"x":0.54938271867512922,"y":0.78052325626687669,"h":0.013081394879037256},{"x":0.54938271699847108,"h":0.010325796711476376,"text":"not too many!","y":0.79505813993054553,"w":0.10082304000854492},{"x":0.53497941766352408,"h":0.014637512752469051,"text":"• I have finished with a friendly goodbye, e.g. CU","y":0.81104651164466923,"w":0.34567901611328133},{"x":0.54938271406408257,"text":"(= See you) soon \/ next week \/ in a few months.","y":0.82558139536571395,"w":0.32921810150146491,"h":0.013081394879037256},{"y":0.84593023277850465,"x":0.53497942625593253,"h":0.013293068070171832,"text":"• I have checked my spelling and punctuation.","w":0.32510288238525387},{"w":0.18930040359497069,"h":0.011661261451633709,"text":"• My text is neat and clear.","x":0.53292181655642412,"y":0.86918604652200093},{"x":0.90740740761344807,"y":0.95058139545292319,"w":0.024691357612609877,"h":0.013081394879037256,"text":"13"}]
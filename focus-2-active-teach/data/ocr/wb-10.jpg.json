[{"y":0.022976606700168212,"h":0.020907251369816415,"w":0.1483000946044922,"text":"READING","x":0.22831908942485421},{"w":0.22633745193481444,"h":0.013239187996469615,"text":"Classroom psychology • verbs","x":0.22839506287004127,"y":0.065313327417131695},{"y":0.079876434446741862,"w":0.21810699462890626,"text":"& nouns • verb + preposition","x":0.22839506508266616,"h":0.011693332853931704},{"text":"1 Read the text quickly and choose the best title.","y":0.036187113497318735,"h":0.014684979303264067,"x":0.54732511077648094,"w":0.37242797851562504},{"y":0.055163283445917921,"w":0.22222221374511719,"x":0.57201646792168004,"text":"1 Where you sit is how you feel","h":0.013239187996469504},{"x":0.57201646387802552,"y":0.072674418748708169,"w":0.22839506149291999,"text":"2 Where you sit is where you are","h":0.013081394879037256},{"y":0.090026478529837362,"text":"3 Where you sit is how you fit","w":0.20987653732299805,"x":0.5720164664722458,"h":0.013239187996469615},{"h":0.0087209299193582446,"w":0.037037036418914759,"x":0.66872428076173596,"y":0.15116279075737515,"text":"HOME"},{"w":0.14609052658081056,"x":0.70576131863689251,"text":"I ARTICLES FORUM","y":0.151162790902724,"h":0.0087209299193582446},{"text":"1 CONTACT","h":0.008827407698871137,"x":0.86008230520934437,"y":0.14960282455731955,"w":0.072016458511352521},{"y":0.28633720942809937,"x":0.12345678970812138,"text":"Today's hot article","w":0.15226337432861328,"h":0.014633664386207279},{"h":0.020310880857974389,"w":0.36284988403320317,"x":0.13332391713430922,"y":0.33014892730737533,"text":"-For more than 70 years, psychologists and teachers"},{"y":0.34863195077139963,"x":0.12139918627863526,"text":"have studied the link between the place where students","w":0.37448558807373045,"h":0.01191526919682262},{"text":"choose to sit in class and what they are like as people and","x":0.12345681144519677,"w":0.3868312454223633,"y":0.36187113853810693,"h":0.013239187996469504},{"text":"Learners. Where do you usually decide to sit? Have you ever","x":0.12139918420200171,"y":0.37775816397105944,"w":0.39506172180175791,"h":0.011915269196822509},{"w":0.33950614929199213,"text":"really thought about the reasons for your decision?","h":0.01191526919682262,"x":0.12139918307005348,"y":0.39232127091213442},{"text":"1 At the back","x":0.11934156813299608,"w":0.1069958782196045,"y":0.41424418620873715,"h":0.013081394879037367},{"text":"People often think that students who sit at the back are","y":0.42877906976327995,"w":0.37242797851562504,"h":0.011644584356107601,"x":0.12345679729054133},{"h":0.011672807392143936,"y":0.44331395361502413,"text":"lazy. But is this really true? Well, some researchers say","w":0.36008228302001954,"x":0.12345679727599851},{"w":0.37242797851562504,"h":0.011915269196822509,"x":0.12345679729054133,"text":"it is not. In fact, shy students often choose the back row","y":0.45763459840016085},{"x":0.12139918320706851,"h":0.011684353332654274,"y":0.47087378620639142,"text":"because it is far away from the teacher and they don't","w":0.3600822830200196},{"y":0.4840116282630007,"h":0.013081394879037367,"w":0.37654319763183591,"x":0.12139917680136619,"text":"want to answer questions or be involved* in discussions."},{"h":0.01162790683971926,"x":0.12345679635947139,"y":0.49999999998130318,"w":0.37242797851562498,"text":"At the back, students probably won't speak much, but in"},{"x":0.12333856597037357,"text":"big classrooms, it can be hard to see the whiteboard and","y":0.51187264998978932,"w":0.37266944885253905,"h":0.014425715406911066},{"x":0.12139918554489071,"w":0.22427982330322266,"h":0.013239187996469504,"text":"hear what the teacher is saying. 2","y":0.52603706989564769},{"h":0.011659978662879711,"y":0.52761627902926833,"text":"_. For students with","w":0.13991768836975099,"x":0.35596708349002154},{"x":0.12139917353352374,"w":0.39300411224365234,"y":0.54215116296822174,"h":0.011688201698915934,"text":"poor sight or hearing, a seat at the back of the classroom is"},{"text":"definitely not a good choice.","x":0.12139918511584867,"y":0.55813953491589618,"h":0.01162790683971926,"w":0.19135801315307616},{"y":0.57987643440753456,"w":0.1111111068725586,"x":0.12139917768511993,"text":"Il On one side","h":0.010239844393751252},{"h":0.011627906839719149,"text":"Students who sit on one side of the class, are normally","w":0.36213989257812501,"y":0.59302325568866754,"x":0.12139919026786479},{"text":"interested in lessons, but they like watching and listening","w":0.38477363586425778,"x":0.12139918548865307,"y":0.60755813967607064,"h":0.011627906839719149},{"w":0.38683124542236325,"y":0.6220930237087372,"text":"rather than joining in. These students are usually also very","x":0.12139918977167163,"h":0.013081394879037256},{"y":0.63503971748201538,"h":0.013239187996469504,"w":0.15637859344482422,"text":"good at taking notes. 3","x":0.12139918325015295},{"text":"-.On the sides of the classroom,","w":0.2330052947998047,"h":0.016108045721096143,"y":0.63376420748320039,"x":0.27537924492299359},{"w":0.36625514984130858,"text":"you will generally find modest* and thoughtful people.","x":0.11934156546000402,"y":0.64960282406929382,"h":0.014641361960455623},{"h":0.013239187996469615,"x":0.11934155782968865,"w":0.36625514984130864,"text":"These people usually get good marks at school and are","y":0.66416593120185929},{"w":0.12345678329467774,"x":0.12139917964895744,"h":0.01191526919682262,"text":"keen* on learning.","y":0.68005295669472454},{"text":"IIl In the middle","x":0.12139918048708942,"h":0.010233430449981484,"w":0.12757201194763185,"y":0.70203488357945065},{"y":0.71656976765572178,"w":0.33333332061767584,"h":0.011627906839719149,"x":0.12345679298334328,"text":"Do you sit in the middle of the classroom? Yes? Then"},{"w":0.31687242507934571,"h":0.01325329909362527,"text":"the statistics say you probably like your teacher. 4","x":0.12139918216197315,"y":0.72947925864749219},{"h":0.013239187996469615,"text":"Caring, outgoing and cheerful people usually sit in the","w":0.34773662567138669,"x":0.12139918122294852,"y":0.74404236547713321},{"x":0.12139917125193918,"w":0.3683127593994141,"y":0.75860547226756692,"text":"middle. They are normally serious about learning and feel","h":0.01191526919682262},{"x":0.1213991765035371,"h":0.013239187996469504,"text":"disappointed* with low marks in tests and exams.","w":0.31687242507934571,"y":0.77316857891839175},{"y":0.59576345963975419,"w":0.11728394508361817,"x":0.53703703882650378,"h":0.01191526919682262,"text":"IV At the front"},{"text":"Are you passionate about knowledge? Do you like being","w":0.37037036895751951,"y":0.60900264771831225,"x":0.53909465399860634,"h":0.013239187996469504},{"x":0.53703703261183766,"y":0.62488967338999357,"w":0.34773662567138663,"text":"in control? Are you worried about missing important","h":0.010284744946175928},{"text":"information in lessons? Yes? Then you probably sit right","w":0.37037036895751951,"x":0.53703704144716613,"y":0.63808139533014041,"h":0.01162790683971926},{"x":0.53909465725640682,"h":0.011627906839719149,"text":"at the front of the class. Students at the front usually","y":0.65261627905107067,"w":0.35185184478759768},{"x":0.53703703828710214,"h":0.013289219283047604,"text":"want to discuss things with the teacher and are often very","y":0.66548985008597683,"w":0.38888889312744146},{"x":0.53909466387407801,"text":"enthusiastic about school. They want to be in the best","y":0.68005295664627496,"w":0.36008228302001954,"h":0.01191526919682262},{"y":0.6946160634880284,"x":0.53909466729118438,"h":0.01191526919682262,"text":"place to see and hear everything the teacher does and","w":0.36213989257812496},{"w":0.37242797851562504,"h":0.01191526919682262,"text":"says. The only problem with sitting at the front is that it","x":0.5390946573728459,"y":0.70917917024499477},{"x":0.53909465562714498,"y":0.72238372091153569,"w":0.39300411224365239,"h":0.01162790683971926,"text":"can be difficult to see and hear what other students do and"},{"h":0.011851984109903846,"x":0.53884013147597098,"y":0.73766292132973965,"w":0.095172348022460995,"text":"say in class. 5"},{"x":0.53693442864727703,"h":0.014456593243295068,"y":0.75627827300356454,"text":"We need YOUR opinion. Tell us what you think of this article.","w":0.38704929351806638},{"h":0.01191526919682262,"x":0.53909465398412204,"w":0.17489711761474613,"text":"Add your comments below.","y":0.77316857886707224},{"x":0.12139917958118077,"h":0.01162790683971926,"y":0.83139534881851251,"text":"GLOSSARY","w":0.078189296722412094},{"y":0.84593023243285348,"w":0.37860080718994144,"text":"involved (adj) - someone who is involved in an activity or event","h":0.011627906839719149,"x":0.1193415734283489},{"w":0.18156789779663085,"h":0.013480561029984628,"text":"gives it a lot of time, attention","x":0.11909169839921084,"y":0.85733230421811224},{"x":0.11934157182741913,"text":"modest (adj) - someone who is modest doesn't like talking about","w":0.39300411224365239,"h":0.011661261451633709,"y":0.86918604648324105},{"x":0.1193415682081183,"y":0.88217122665946524,"w":0.24074073791503903,"text":"their abilities, skills, success, talents, etc.","h":0.010270633428157705},{"text":"keen (adi) - someone who is keen on something is very interested","y":0.84289496923775031,"w":0.3950617218017578,"x":0.53292182030625379,"h":0.01191526919682262},{"y":0.85745807590100376,"text":"in it or enjoys doing it very much","h":0.010274481794419588,"x":0.53292181931930149,"w":0.20164608001708983},{"w":0.38683128356933594,"h":0.01191526919682262,"text":"disappointed (adj)- unhappy because something you hoped for","y":0.86760812001438026,"x":0.53497942477911797},{"w":0.37654319763183597,"text":"did not happen, or because someone or something was not as","x":0.53292182309766201,"h":0.011636887202721602,"y":0.87936046508789223},{"y":0.89232127112708604,"w":0.13786007881164553,"h":0.01191526919682262,"text":"good as you expected","x":0.53292181416927997},{"x":0.10905349792535649,"y":0.94331395336308599,"w":0.010288065671920782,"text":"8","h":0.01162790683971926}]
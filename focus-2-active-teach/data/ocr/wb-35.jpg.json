[{"text":"WORD STORE 3B | Adjectives","h":0.013239187996469615,"x":0.088477371921086109,"y":0.045013239181021736,"w":0.23251028060913081},{"y":0.065311871240070984,"w":0.24521715164184571,"x":0.090377000838391341,"text":"5 Choose the correct adjectives.","h":0.013750146998837254},{"y":0.084289497062806307,"x":0.11316872943951665,"text":"1 Evelyn doesn't understand what's happening in this","w":0.38271602630615231,"h":0.013239187996469504},{"y":0.097383720947109231,"text":"crime drama. The story is too complex \/ gripping \/","w":0.34979423522949216,"x":0.1378600814250345,"h":0.013081394879037256},{"x":0.13786008702609209,"w":0.11728394508361817,"h":0.010323230713106146,"text":"addictive for her.","y":0.11191860499837503},{"y":0.12936046518566979,"w":0.010288065671920782,"x":0.11316872426280504,"text":"2","h":0.0087209299193581336},{"y":0.12866687760552342,"x":0.13569781506056139,"text":"This comedy isn't funny - it's excellent \/ embarrassing\/","w":0.37466983795166015,"h":0.013895849579746322},{"text":"entertaining. We both feel silly and uncomfortable","y":0.14386584304447991,"h":0.013239187996469504,"x":0.1378600815867064,"w":0.34567901611328122},{"w":0.082339172363281254,"x":0.13578514770024161,"text":"watching it.","y":0.1583688363199216,"h":0.011750698931324521},{"h":0.010174417958676241,"w":0.010288065671920768,"x":0.1131687244428462,"y":0.17441860510133045,"text":"3"},{"text":"Carrie isn't coming to the theatre. She's watching","x":0.13580247538829762,"y":0.17431597525478837,"w":0.33950614929199219,"h":0.013239187996469504},{"h":0.013239187996469504,"w":0.35596706390380861,"x":0.13580247281489968,"y":0.18887908201175485,"text":"a really addictive \/ imaginative \/ embarrassing soap"},{"w":0.22633745193481444,"h":0.011674090180897934,"text":"opera and she can't leave home.","x":0.13580246621366279,"y":0.20344218867500818},{"y":0.21941571184625652,"w":0.39533973693847657,"text":"4 A good crime drama needs to be gripping \/ inspiring \/","x":0.11094201021121051,"h":0.015788691083835737},{"text":"moving, which normally means you don't know how it","x":0.13580246860766004,"w":0.37037036895751957,"y":0.23389232141507632,"h":0.013239187996469504},{"w":0.055675716400146485,"text":"will end","h":0.010506299987685264,"x":0.13368477484927443,"y":0.24838057102307665},{"text":"Have you seen the animation film The Lion King?","x":0.12139917608871159,"w":0.35185184478759762,"y":0.26598837234609185,"h":0.013081394879037145},{"text":"It's so addictive \/ engaging \/ moving that everyone","y":0.28052325583401638,"w":0.35185184478759768,"h":0.01162790683971926,"x":0.13374486243130398},{"h":0.011649715511123482,"y":0.29505813960339622,"text":"usually cries at the end.","w":0.16460905075073246,"x":0.13374486008416731},{"w":0.37242797851562504,"h":0.014637513594193852,"x":0.11111111734712573,"text":"6 I thought the film was fascinating \/ disappointing \/","y":0.31104651152112273},{"x":0.13374485236476497,"w":0.3683127593994141,"y":0.32558139508701411,"h":0.014665736630230186,"text":"gripping, to be honest. I was expecting it to be much"},{"x":0.13168724324918835,"y":0.34011627926557475,"w":0.047325100898742672,"text":"better.","h":0.010174417958676241},{"h":0.013239187996469615,"text":"7 Walter found the documentary very inspiring \/","w":0.34362140655517581,"y":0.35745807597764501,"x":0.10905349081706241},{"text":"imaginative \/ addictive. Now he wants to volunteer to","w":0.37242797851562504,"x":0.13168724996543837,"y":0.37202118290914465,"h":0.011915269196822509},{"h":0.013081394879037256,"x":0.1316872419047499,"y":0.3851744186215279,"w":0.18724279403686522,"text":"help homeless people too."},{"x":0.10878657737155734,"text":"8 That was one of the most imaginative \/ embarrassing\/","y":0.39989864845611622,"w":0.39347446441650397,"h":0.018031329048069256},{"y":0.41703442193081086,"h":0.013239187996469504,"w":0.35390945434570309,"text":"complex things I've ever seen. How is it possible to","x":0.13168724911315668},{"text":"9","x":0.10699588477380226,"y":0.44912790702433258,"h":0.0087209299193582446,"w":0.012345678806304938},{"x":0.11712320155750078,"h":0.015192648002981368,"y":0.44734553669947541,"text":"I watched a documentary about how to make glass","w":0.36657665252685545},{"h":0.013081394879037367,"y":0.46366279109609176,"text":"bottles. I know it sounds boring, but it was actually","w":0.34979423522949216,"x":0.13168724884615915},{"w":0.29218105316162102,"h":0.013239187996469615,"text":"really moving \/ fascinating \/ disappointing","y":0.47661076792459689,"x":0.12962963437597966},{"w":0.36419750213623042,"text":"WORD STORE 3C | Elements of a film\/TV drama","x":0.082304535042996077,"h":0.01162790683971926,"y":0.50436046523324107},{"y":0.52470930239696401,"w":0.41563785552978516,"h":0.013243036362731275,"text":"6 Jake and Angela have just watched a film at the cinema.","x":0.082304523881198077},{"x":0.10699588979984498,"y":0.53924418611789415,"w":0.38065841674804685,"text":"Complete their dialogue with the missing words. The","h":0.01327125939876761},{"text":"definitions in brackets are given to help you.","y":0.55377906997811699,"h":0.013299482434803833,"w":0.3209876251220703,"x":0.10699590472291526},{"text":"J: What did you think of the movie, Angela? Excellent, eh?","x":0.10699588809113675,"y":0.57105030878427909,"w":0.39300411224365234,"h":0.013252016725733728},{"text":"A: Erm. Not really. The plot (what happens in the story)","y":0.58866279096891172,"h":0.013278956552153609,"x":0.10905350450320568,"w":0.3806584167480469},{"text":"was really silly. For example, why did they go to the","x":0.12962963939093433,"y":0.60319767459899876,"w":0.35390945434570309,"h":0.013081394879037256},{"x":0.12950550294895144,"h":0.014028524784313712,"y":0.61547377020972205,"w":0.29449714660644533,"text":"island with no food, no water and no map?"},{"w":0.35596706390380861,"x":0.1069958978491929,"y":0.63503971738830234,"h":0.011915269196822509,"text":"J: Because it's a film! What did you think about the"},{"text":"(what the actors do)? That was good.","x":0.22427984428154579,"y":0.64960282416464865,"h":0.01191526919682262,"w":0.25720163345336916},{"x":0.12962962655077034,"h":0.013081394879037256,"y":0.66133720931920226,"w":0.30658435821533203,"text":"Some of the actors might even win an Oscar."},{"text":"A: Well, I don't think they'Il win any Oscars for the","y":0.68005295678193378,"h":0.01191526919682262,"w":0.33950614929199219,"x":0.10699589994248125},{"h":0.010325796711476376,"text":"(the text in a drama). What the","x":0.22016462101368831,"w":0.21604936599731447,"y":0.69461606335797799},{"y":0.70917917041214595,"w":0.25102880477905276,"h":0.011915269196822509,"x":0.22222222061458893,"text":"(people in a drama) said was clichéd"},{"text":"and not very realistic. But I have to say that the","w":0.32535354614257811,"y":0.72131949270762885,"x":0.12743861842168797,"h":0.014736490342223574},{"text":"(music during a drama) was great.","h":0.011694616063548047,"w":0.23868312835693362,"y":0.73830538381948985,"x":0.2181069994703671},{"w":0.34362140655517581,"text":"It created a very frightening atmosphere. And the","x":0.12551440533009361,"y":0.75145348839215587,"h":0.011627906839719149},{"y":0.76598837225843508,"text":"(illusions created by computers) were","x":0.21810699192195115,"w":0.26131687164306644,"h":0.011627906839719149},{"text":"also very good. The monsters on the island looked","x":0.12551440165823069,"h":0.011627906839719149,"y":0.78052325607626438,"w":0.34979423522949216},{"y":0.81104651184176835,"w":0.23045267105102538,"h":0.011627906839719149,"text":"J: lagree. And I think all of the •","x":0.10288065871317045},{"y":0.81243387156097646,"text":"(clothes","x":0.41355849930677818,"h":0.010306675667691167,"w":0.061771888732910174},{"h":0.011627906839719149,"y":0.82558139522355134,"w":0.2880658340454102,"x":0.12551440355342677,"text":"the actors wear) were good. I thought the"},{"w":0.24485595703124999,"x":0.2119341585471323,"text":"_(the place or time of a drama) was","h":0.011627906839719149,"y":0.84011627928362875},{"h":0.01191526919682262,"y":0.85304501322107662,"x":0.12345679424054591,"text":"really original and the ®","w":0.16460905075073246},{"y":0.86635352387036813,"w":0.37063392639160153,"x":0.12537931072533645,"h":0.014845705831987299,"text":"finishes) was a big surprise for me. I really enjoyed the"},{"x":0.12551440401267164,"text":"film.","w":0.028806583881378189,"h":0.0087209299193581336,"y":0.88226744201706508},{"y":0.89805825229724878,"text":"A: Really? They're showing Hitchcock's The Birds next","w":0.37037036895751951,"h":0.013278956552153609,"x":0.10288065543893588},{"h":0.011627906839719149,"y":0.91424418596967527,"x":0.1213991789926451,"text":"week. Maybe you'd like to see a really good film?","w":0.34362140655517581},{"x":0.5493827174308431,"text":"REMEMBER THIS","h":0.013299482855666289,"y":0.053779069838824411,"w":0.13580246925353989},{"x":0.55349795397916557,"y":0.081200352958332167,"h":0.013276390974645724,"w":0.3559670639038085,"text":"Actors and actresses can be, appear or star in films,"},{"x":0.5534979453604657,"y":0.094439541224746959,"w":0.34773662567138675,"h":0.013239187996469615,"text":"plays and TV shows, but the verb play is used with"},{"w":0.31893003463745118,"y":0.10900264803334925,"text":"information about the character from the film.","x":0.55349794963086285,"h":0.011636886781859146},{"y":0.12288816670877312,"h":0.014056088749750062,"w":0.067540082931518475,"text":"Compare","x":0.55258919456554589},{"text":"Johnny Depp stars in the Pirates of the Caribbean films.","w":0.3806584167480469,"h":0.01191526919682262,"y":0.14077669901885081,"x":0.55349795846411065},{"w":0.022633743286132879,"text":"VS","x":0.54732510343923801,"y":0.16279069764921805,"h":0.010174418800401042},{"h":0.013081394879037256,"x":0.55349794112268014,"w":0.32098766326904293,"text":"He plays a pirate called Captain Jack Sparrow.","y":0.18168604670292321},{"w":0.010288065671920754,"x":0.53292181088831947,"h":0.01017441795
7242797851562504,"h":0.011627906839719149},{"y":0.47819767429331872,"w":0.28395061492919926,"x":0.16666666839273922,"text":"_ as a conservationist. I have \/ must admit","h":0.011652281509493712},{"y":0.49273255839865959,"h":0.013081394879037256,"w":0.28395061492919926,"x":0.17695472895515366,"text":"about the environment, but thanks to him,"},{"h":0.013244321676660009,"x":0.10271402380866761,"y":0.50433778397369777,"w":0.26579586029052732,"text":"I started to think about it more carefully."},{"w":0.35596706390380861,"x":0.10493828230735489,"y":0.52162400704161793,"h":0.01191526919682262,"text":"Anyway, one day he wasn't there. And he wasn't there"},{"x":0.1028806709645162,"w":0.35802467346191408,"text":"the next day. What ®was going \/ went on? I went to his","h":0.011915269196822509,"y":0.53618711376951478},{"text":"house to look for him. Unfortunately, I found out he died","x":0.10273429855207639,"y":0.54790471898796833,"w":0.37064903259277343,"h":0.014155939208230217},{"w":0.10288065910339357,"y":0.56250000006851253,"text":"the day before.","h":0.011639452780229487,"x":0.10288065981730181},{"h":0.013239187996469504,"y":0.5798764340621021,"w":0.34773662567138675,"x":0.10288066408474542,"text":"Then, a few weeks later when I 'wasn't \/ was walking"},{"y":0.59210881548844052,"text":"home from school, a young woman came and gave me a","w":0.36863594055175786,"h":0.014518188988331238,"x":0.1027106191942094},{"y":0.6053781756626837,"text":"letter. It was from the old man's wife. He told her about","x":0.10068422333336585,"w":0.36450870513916017,"h":0.013856314602723074},{"x":0.10288066194123935,"h":0.011915269196822509,"y":0.62047661064344828,"text":"our conversations and that he felt cheerful when he was","w":0.36831275939941405},{"text":"talking to me. He decided that he ®was wanting \/ wanted","h":0.013239187996469504,"w":0.3744855880737305,"y":0.63371579863423499,"x":0.1008230526195133},{"y":0.64825581425225109,"text":"to give me a gift.","h":0.010174417958676241,
[{"h":0.016868587941694213,"x":0.0903102778537615,"y":0.040769919424102019,"w":0.37700256347656252,"text":"7 Read the task below. Then complete gaps 1-6 in"},{"text":"the story with the phrases from the box. There is","x":0.11316873919496871,"y":0.056487202260432801,"h":0.013280239340907496,"w":0.35802467346191402},{"text":"one extra phrase.","w":0.13168724060058595,"x":0.11316872757350666,"y":0.071050308875236556,"h":0.01191526919682262},{"y":0.094439541065512445,"h":0.013239187996469504,"w":0.35596706390380861,"text":"Your school is holding a competition for the best","x":0.11316872786291057},{"h":0.016172005029663206,"text":"short story about a surprising event. Write a story.","w":0.36875026702880864,"y":0.10755871565826181,"x":0.11297710268208191},{"x":0.11111111332059628,"y":0.12354651166008224,"w":0.24897119522094727,"text":"Include and develop these points:","h":0.011627906839719149},{"x":0.11092955699912686,"text":"• Give information to set the scene.","y":0.14028223070018386,"w":0.2514331817626953,"h":0.013848087162647515},{"x":0.11111112308541327,"h":0.014691393247033724,"y":0.15697674440871956,"text":"• Describe what happened on that day using different","w":0.37860080718994138},{"x":0.12551440673181338,"w":0.18518518447875978,"y":0.17296511634758227,"h":0.011627906839719149,"text":"past tenses and structures."},{"w":0.38683128356933588,"h":0.013294350858925719,"x":0.10905349401780118,"text":"• Use different words and phrases to show the order of","y":0.18750000039841741},{"h":0.010220601299854915,"y":0.20344218905666345,"text":"events and add interest.","w":0.16666666030883789,"x":0.12551440855442877},{"text":"• Give your story a strong ending.","y":0.21800529572917626,"w":0.24074073791503908,"h":0.013239187996469504,"x":0.10905350176264506},{"text":"didn't use to care","x":0.12962963458722901,"w":0.12345678329467771,"y":0.24845542803912246,"h":0.01026550185227959},{"w":0.13168724060058595,"text":"didn't use to smile","h":0.010370696843038707,"x":0.2716
 a virus.","y":0.38517441890341386,"w":0.20781892776489258,"h":0.010235996027489369,"x":0.092592597194371185},{"h":0.013081394879037256,"y":0.41424418630563642,"text":"You're probably allergic to...","w":0.2037036895751953,"x":0.094650216220632688},{"w":0.076131687164306627,"h":0.0087209299193581336,"x":0.09465020675220881,"text":"Treatment","y":0.46220930240950697},{"x":0.094650205325864892,"h":0.011652281509493712,"y":0.4781976743999079,"text":"You should eat more slowly \/","w":0.20370370864868165},{"y":0.49602690528378846,"h":0.010164816402694621,"w":0.090807037353515613,"x":0.094403532817872199,"text":"go on a diet."},{"h":0.010328362288984261,"x":0.094650211023564523,"y":0.51147396291491776,"w":0.16666666030883787,"text":"You need to drink more"},{"x":0.094650205448681246,"w":0.043209877014160153,"y":0.52906976748944878,"h":0.0087209299193581336,"text":"water."},{"x":0.09465020779978435,"w":0.15020575523376467,"h":0.013239187996469504,"text":"I'm going to give you","y":0.54501323938087642},{"h":0.011915269196822509,"y":0.56090026490402278,"text":"a prescription.","w":0.10288065910339358,"x":0.09465020671373528},{"h":0.011627906839719149,"text":"I'm going to make","w":0.12962963104248049,"y":0.57848837208886128,"x":0.094650206675261792},{"text":"an appointment for you","w":0.16666666030883789,"x":0.094650210003331375,"y":0.59302325583083026,"h":0.013081394879037256},{"x":0.094650209574130312,"text":"(to see the specialist).","y":0.60900264799701209,"w":0.15432098388671875,"h":0.011636886781859146},{"y":0.62645348864057471,"w":0.18518518447875976,"x":0.094650208429344365,"text":"Take one tablet after each","h":0.010351454170004826},{"text":"meal.","x":0.094650206992236446,"y":0.64244186061853015,"h":0.010174417958676241,"w":0.039094648361206047},{"y":0.040600176467943561,"h":0.013239187996469504,"w":0.38271602630615231,"text":"2 Complete the dialogue between Victoria and her","x":0.55967078960412553},{"w":0.33950614929199219,"h":0.01191526919682262,"text":"docto
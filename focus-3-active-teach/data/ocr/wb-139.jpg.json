[{"h":0.018895349169332887,"y":0.0058139534797715386,"text":"4.9","w":0.039301309585571292,"x":0.017467249100955255},{"w":0.27510915756225585,"text":"EXAM SPEAKING","y":0.0058139532405515615,"x":0.10262009542738731,"h":0.018895349169332887},{"y":0.0058139534040689833,"w":0.1768558883666993,"h":0.018895349169332887,"x":0.75764192370693417,"text":"STUDENT B"},{"h":0.013081395090518977,"x":0.0087336242706857799,"text":"1 In pairs, ask and answer the questions.","w":0.32314411163330076,"y":0.072674418690205633},{"h":0.010399334442595776,"x":0.030567689580026106,"y":0.09442595692356448,"text":"Talk about food.","w":0.13100436210632327},{"w":0.3908296966552734,"h":0.011654509482486919,"x":0.030567690937282989,"y":0.10898502510137043,"text":"1 Describe a healthy, balanced diet including food"},{"w":0.29912662506103516,"text":"products and other ingredients you like.","y":0.12354409309557113,"x":0.056768568937822936,"h":0.011647254575707144},{"y":0.13341720015977088,"text":"2 What three-course meal would you make for your","w":0.39993995666503906,"x":0.03039421442949326,"h":0.018090255248566445},{"y":0.15099833574085542,"h":0.013311148483225677,"x":0.056768567458204584,"text":"best friend on his\/her birthday?","w":0.23799125671386717},{"w":0.41048034667968747,"x":0.03275109576495968,"h":0.013311148483225566,"y":0.16555740412570308,"text":"3 When was the last time you ate tinned food instead"},{"w":0.21834060668945315,"h":0.013311147689819336,"text":"of a home-made meal? Why?","y":0.18011647275037623,"x":0.056768563292827992},{"w":0.60480346679687502,"h":0.013311148483225677,"text":"Discuss this question together. 'Should we all be vegetarian?' What do you think?","y":0.20923460890776757,"x":0.030567688835915093},{"x":0.058951969085080339,"y":0.24273255848784814,"w":0.12882095336914062,"text":"For eating meat:","h":0.011627906570815361},{"w":0.11790392875671385,"h":0.013311148086522451,"y":0.26580698822697868,"x":0.058951963860362187,"text":"Eating meat..."},{"y":0.28327787014827444,"h":0.013311148086522451,"x":0.056768583532563532,"w":0.48034931182861329,"text":"• is natural for humans - our bodies are designed to eat meat."},{"w":0.54803493499755862,"h":0.013311148086522451,"y":0.29783693839988556,"text":"• is a good way to eat a balanced diet, e.g. protein is important for our","x":0.056768565552530535},{"y":0.31239600656670996,"text":"bones, muscles, skin and blood.","w":0.23799125671386723,"h":0.013311148086522451,"x":0.082969436308277481},{"y":0.32695507502423193,"h":0.013311148086522451,"w":0.54585151672363286,"x":0.056768571605432284,"text":"• doesn't necessarily mean being cruel to animals if we treat them well"},{"y":0.34151414317096851,"x":0.080786032288019574,"text":"while they are alive.","h":0.011683531093121369,"w":0.15283842086791993},{"y":0.35607321145399151,"text":"• is delicious!","x":0.056768562108138312,"h":0.010399334442595665,"w":0.11572052001953125},{"x":0.50873364233738694,"w":0.37117900848388674,"text":"4 What are the benefits of eating organic food?","h":0.013311148483225566,"y":0.10898502494578455},{"h":0.010174418051111855,"x":0.50873362500064245,"w":0.013100435733795157,"text":"5","y":0.12354651207425027},{"text":"Have you ever eaten food past its sell-by date?","h":0.013083813789481979,"w":0.37117904663085943,"x":0.51965065233959218,"y":0.12354409322162052},{"y":0.13808139539320952,"w":0.12663755416870115,"text":"Why?\/Why not?","x":0.53056768685305844,"h":0.013081395090518977},{"h":0.013081395090518866,"x":0.0087336241865380512,"y":0.4026162791262522,"w":0.75545852661132828,"text":"3 Look at these two meals. What can you see in the photos? Which would you prefer to eat? Why?"},{"w":0.5218340301513672,"h":0.013311148086522451,"text":"4 Read the instructions on your card and role-play the conversation.","x":0.0065502251353792926,"y":0.66555740431344523},{"y":0.69876731438931206,"x":0.058858001678400419,"text":"Student B:","h":0.010895603706753465,"w":0.08534076690673828},{"w":0.46288208007812498,"text":"You are the waiter in a restaurant. Take Student A's order.","x":0.058951978847400284,"y":0.72379367734332634,"h":0.010399334442595776},{"text":"• Respond to Student A and ask what you can get him\/her.","x":0.058951982850149846,"w":0.45414844512939451,"y":0.74126455921696099,"h":0.013095905697484533},{"h":0.013081395090518866,"w":0.28820959091186527,"x":0.058951977906512631,"text":"• Say it's chicken and pumpkin soup.","y":0.7558139535933065},{"text":"• Say that you have a salad with beetroot, cauliflower and avocado.","w":0.51746723175048814,"x":0.058951978819078939,"h":0.01168111279086137,"y":0.77034883738319704},{"text":"• Say no, it's quite mild","h":0.011705297003569926,"x":0.058951960913245928,"w":0.18558952331542969,"y":0.7848837211695342},{"y":0.79941860478145277,"w":0.46943229675292969,"h":0.011729481612981485,"text":"• Say yes, it comes with fresh, home-made wholemeal bread.","x":0.05895197976218132},{"h":0.011753666222393044,"y":0.81395348857505745,"w":0.28384279251098632,"text":"• Say yes and end the conversation.","x":0.058951970920634762},{"text":"137","w":0.037117903232574467,"y":0.9622093025092463,"h":0.013081395090518866,"x":0.89519650643502269}]
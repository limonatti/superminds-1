3321295248,"w":0.33916847229003899},{"text":"then the underground, then a bus to get to school. It","x":0.14223195630246088,"y":0.36627907020727668,"w":0.33698028564453125,"h":0.011729228546015991},{"x":0.14223194472018527,"y":0.37925311217052493,"w":0.24945295333862302,"text":"takes nearly two hours and I hate it. &","h":0.010373443983402564},{"text":"Sonia_16","w":0.059212450981140134,"h":0.014771889650970094,"x":0.061203402872102276,"y":0.39377684605530006},{"x":0.14223195074519418,"text":"My family lives on a very small '","w":0.20568927764892575,"y":0.3924418605783897,"h":0.013081394686243808},{"y":0.39279541217796843,"h":0.013434945893980199,"x":0.42882244587661844,"w":0.03649432659149171,"text":", So \/"},{"w":0.32822757720947265,"x":0.14223194853968368,"y":0.40697674438921583,"text":"get a boat every day to get to school. I can't be late","h":0.010174418089300863},{"h":0.011685805103096358,"text":"because there's only one boat in the morning.","w":0.29321662902832035,"x":0.14223194325389257,"y":0.41860465126347823},{"x":0.063457340740732948,"w":0.2100656318664551,"y":0.43153526962523014,"h":0.013278008298755251,"text":"Bret@home Australia is a huge 2"},{"w":0.11378555297851561,"h":0.010373443983402564,"text":"_and my parents","x":0.34354485837580429,"y":0.43443983386073692},{"h":0.011790745683725512,"text":"own a farm hundreds of kilometres from the nearest","w":0.33916847229003905,"x":0.14442014587540336,"y":0.44605809118264128},{"text":"big town. There's no secondary school in our little","w":0.31509845733642572,"h":0.011652031182253553,"y":0.45930232580320685,"x":0.14442013938430351},{"text":"community, so I have all my lessons online.","y":0.47219917014627,"w":0.27571115493774412,"h":0.010373443983402453,"x":0.14223195447861137},{"y":0.48691860451406954,"text":"pinky","w":0.0371991229057312,"h":0.01308139547767484,"x":0.061269147890679249},{"y":0.48672199161936769,"x":0.14223195051341919,"w":0.32385120391845701,"h":0.010373443983402453,"text":"I go to school near Cape Town in South Africa, and"},{"x":0.14442012751437253,"text":"about 20 kilometres from my school is the point where","y":0.49834024898972151,"h":0.012033195020746956,"w":0.35229759216308598},{"x":0.14223194751056531,"y":0.51017441899603633,"w":0.039387307167053243,"text":"two 3","h":0.011817282364081527},{"x":0.26039387635628913,"w":0.23632385253906252,"h":0.0089103057671384711,"y":0.51308139552125209,"text":"meet. The Atlantic and the Indian. I think"},{"h":0.010174418089300752,"text":"our school has the most beautiful location in the world.","x":0.14223195217554949,"w":0.33916847229003899,"y":0.52470930267409965},{"w":0.054704594612121585,"text":"8ball_16","x":0.061269147305536578,"h":0.013081394686243808,"y":0.55087209319103503},{"x":0.14004375531087795,"w":0.35667396545410157,"y":0.55228215783861367,"h":0.010373443983402564,"text":"I go to school in Istanbul, which is famous for being the"},{"y":0.56390041500705046,"text":"only city in the world where two 4","x":0.14223194498436384,"w":0.21881837844848631,"h":0.011680980144200048},{"text":"meet.","x":0.44420131408605767,"h":0.0072674414923576958,"y":0.56686046524582701,"w":0.039387307167053243},{"y":0.57703488416455317,"x":0.14223193911831772,"w":0.35667396545410157,"h":0.023380053983189764,"text":"My school is in Asia, but when Ilock out of the window."},{"h":0.010373443983402564,"text":"I can see Europe.","x":0.14223194827628105,"y":0.5900414937223748,"w":0.1094091892242432},{"text":"hellokaty_14 Everyone has heard of the famous 5","x":0.063219034564918564,"h":0.017545131825807192,"w":0.31127607345581049,"y":0.60092569832082798},{"x":0.45941195952044434,"text":"In our","y":0.60731002930028055,"w":0.037412405014038086,"h":0.0077636623778283287},{"w":0.33260391235351572,"y":0.61773255862781917,"h":0.01172802240522075,"text":"city, but most people don't know that the city is also","x":0.1444201484913675},{"text":"called Niagara Falls. In fact, my school is called Niagara","x":0.14442013889547461,"y":0.6293604653744278,"w":0.34792121887207028,"h":0.011718372883143813},{"y":0.64232365158842819,"w":0.11597373962402341,"h":0.011746115704295068,"x":0.14223194848667536,"text":"Falls High School!"},{"w":0.04376367568969726,"h":0.015988371283186864,"x":0.061269147012919412,"y":0.65697674475084844,"text":"Kid_16"},{"text":"My family lives in Dubai very close tothe","y":0.65684647284834774,"w":0.26477024078369138,"x":0.14442013367817616,"h":0.011758177903677947},{"h":0.011684598566585547,"y":0.67005813982936968,"x":0.1422319418773873,"text":"It hardly ever rains, but we regularly have storms -","w":0.32385120391845701},{"h":0.010373443983402564,"w":0.31947483062744142,"x":0.14442013711516324,"y":0.68298755186042603,"text":"sand storms! When that happens, we have to stay"},{"text":"indoors, so it's impossible to get to school.","x":0.1444201392422812,"y":0.69622093041755906,"h":0.010174418089300752,"w":0.27133478164672853},{"h":0.014534882984715392,"w":0.061269145011901859,"text":"Yoda_347","x":0.061269147581576429,"y":0.71075581446694458},{"h":0.01180160134659769,"x":0.14442014381630827,"text":"My parents own a restaurant high in the 7","w":0.26695840835571294,"y":0.70912863077170707},{"text":"and I have to get a cable car down to the town to get","w":0.3413566589355469,"x":0.14442013420837554,"h":0.011641175123665914,"y":0.72238372103092008},{"text":"to school every day. Sometimes, if it's really windy, I","y":0.73526970941034575,"w":0.33260395050048824,"h":0.011823313463772966,"x":0.1422319449248105},{"text":"just have to stay at home.","w":0.16849014282226563,"h":0.010174418089300752,"x":0.14223195546705822,"y":0.7500000001365511},{"x":0.53829322553002412,"text":"WORD STORE 5A | Phrasal verbs","y":0.082848837455338664,"w":0.26914659500122073,"h":0.011756971762882706},{"x":0.53829321871143554,"text":"2 Choose the correct particles.","y":0.10610465145727666,"w":0.25164113998413085,"h":0.01173767232301326},{"x":0.56236325266483222,"w":0.36761486053466796,"y":0.124896265
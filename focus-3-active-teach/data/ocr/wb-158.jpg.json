7033000250482,"text":"5 'Isn't that Sue?' 'I'm not sure, but it","y":0.82351003689819335,"x":0.076009677550543844},{"x":0.43349852718118326,"y":0.8268779387743711,"w":0.067643470764160163,"text":"be Sue","h":0.010488308438849736},{"y":0.83846794347295128,"w":0.33986927032470704,"h":0.011822753702968924,"text":"after all. She's iust come back from Australia'","x":0.10021787565827082},{"h":0.011710202267128267,"w":0.32244007110595707,"text":"6 'Yesterday I saw Sandra at the concert.'","x":0.074074076720079068,"y":0.85465116314384737},{"h":0.011627907161410933,"text":"'It","w":0.019607843160629274,"x":0.098039215511188632,"y":0.86918604646774422},{"text":"Sandra. She's in India at the moment!","x":0.21786493701859336,"y":0.86627907048982322,"w":0.31372547149658203,"h":0.014653485383121945},{"x":0.074074078038380509,"w":0.24400871276855468,"y":0.88372093016018183,"text":"7 When | lived in the country, l","h":0.010174418567717836},{"text":"gofor","x":0.4192839156688743,"h":0.014415826726019376,"y":0.88173664581909605,"w":0.052291507720947261},{"w":0.12418300628662109,"y":0.89825581422185119,"h":0.011819123229218187,"text":"a run every day.","x":0.10021786660069811},{"h":0.010810296203969005,"text":"8 She","y":0.91101927046544329,"w":0.054727053642272955,"x":0.076122312504544987},{"x":0.2331154714582854,"h":0.011656952539550347,"text":"be happy when she lived in Paris.","w":0.25054466247558593,"y":0.91132389664250202},{"w":0.039215686321258547,"x":0.050108932046342411,"text":"156","y":0.94912790724331864,"h":0.013081394961037107},{"text":"Summative Practice","x":0.54030501278966869,"y":0.059533722077922735,"w":0.18518518447875987,"h":0.013322231473771873},{"x":0.87563234737179751,"w":0.089693908691406254,"y":0.059010698149604801,"h":0.014246044905358413,"text":"Units 1-3"},{"text":"4","x":0.52505446646434761,"y":0.08720930255760706,"w":0.019607843160629246,"h":0.01162790636734401},{"text":"Choose the correct forms.","w":0.21786491394042973,"x":0.54248366645026436,"h":0.011826384573752957,"y":0.087010824278523691},{"y":0.10610465131308611,"w":0.41176467895507807,"h":0.013081394961037107,"text":"1 'How long have you been working \/ are you working","x":0.55337692389936721},{"text":"on this project?' 'We have been working \/ are","w":0.33769062042236331,"x":0.57952070708184666,"h":0.013081394961037107,"y":0.1206395350231152},{"h":0.011702940922593386,"w":0.35729846954345701,"x":0.57952070433502512,"text":"working on this project since September, but we","y":0.13655287265352045},{"w":0.27717655181884759,"x":0.57930796889303993,"y":0.14875872196799167,"h":0.015827460848818586,"text":"might not \/ must not finish it in time!"},{"text":"2","y":0.16715116286182485,"h":0.0087209299740247381,"x":0.5555555557904498,"w":0.010893245935440166},{"x":0.5729847454639091,"text":"'I have seen \/ have been seeing Leonardo's Last","w":0.36165576934814447,"y":0.16694421298950357,"h":0.011834856473238231},{"text":"Supper twice.' When did you last see \/ have you last","h":0.013081394961037107,"y":0.18023255827892914,"x":0.57952069945178719,"w":0.39215686798095706},{"h":0.010658078745541033,"x":0.57944018637049355,"w":0.067699146270751909,"text":"seen it?'","y":0.19597910006048735},{"y":0.21075581391744924,"h":0.010174418567717836,"x":0.55555555581768301,"text":"3","w":0.010893245935440055},{"y":0.2106577853279431,"w":0.38126361846923829,"h":0.013322231473771873,"text":"I was sitting \/ sat on top of a hill when I heard \/ was","x":0.57952070256639732},{"x":0.58169935021527186,"h":0.013322231870805279,"w":0.38126361846923817,"text":"hearing the sound of dogs and horses approaching.","y":0.2252289758260535},{"w":0.01525054454803465,"x":0.55337690662939587,"text":"4","y":0.24127906979980929,"h":0.0087209299740247381},{"h":0.011656952539550236,"text":"Francis was sure he has met \/ had met the man","w":0.35511981964111328,"y":0.2398001665924252,"x":0.57298475804436688},{"text":"before.","y":0.25436046542097923,"w":0.056644878387451136,"h":0.011627906367343899,"x":0.5795206987692374},{"y":0.2703488372416698,"w":0.013071894645690918,"h":0.0087209299740247381,"x":0.55555555616299335,"text":"5"},{"w":0.37037036895751951,"text":"He wanted to know \/ know what had provoked\/","x":0.56862744551397826,"y":0.27019150705896877,"h":0.011785236822377643},{"h":0.01174892970266983,"w":0.19607843399047842,"text":"provoked my bad temper.","x":0.57952069830977171,"y":0.28476269786326958},{"h":0.011712622979995535,"w":0.41394332885742191,"text":"6 l encouraged her to talk \/ talk about the episode but","x":0.55555557282619106,"y":0.29933388828507179},{"text":"she decided to keep \/ keeping it to herself.","x":0.57952070872281203,"w":0.32026142120361323,"h":0.013322231870805279,"y":0.31390507900037501},{"text":"So she didn't call you again? That's a pity because","y":0.32847626993791224,"w":0.38126361846923829,"h":0.013093497334273008,"x":0.56862744367024676},{"w":0.30501089096069334,"text":"I might have helped\/may help her then.","x":0.57734204673098233,"y":0.34302325611240092,"h":0.014595394626842895},{"x":0.55555557588193782,"y":0.35886761028779601,"text":"8 I can't help feeling \/ to feel nervous before an exam.","w":0.41176467895507807,"h":0.011771924291224756},{"x":0.5708061037671367,"w":0.39433551788330068,"h":0.013322231870805279,"y":0.3734388008386238,"text":"Believe or not, once Tim would break \/ broke his leg"},{"h":0.010174418567717947,"x":0.57952070159152824,"y":0.38953488372122824,"text":"near this lake.","w":0.10457515716552734},{"h":0.013322231473771873,"y":0.40258118248088681,"text":"10 lt was \/ has been a surprise. I haven't \/ hadn't","w":0.36165576934814458,"x":0.55555555977037197},{"h":0.015249417485245886,"x":0.57936432391281789,"text":"expected to win anything at that moment.","w":0.31408443450927725,"y":0.41645707787870767},{"w":0.40522872924804687,"text":"11 What was he thinking \/ had he thought about when","y":0.43168604692355128,"x":0.55555557321185145,"h":0.013081394961037107},{"y":0.4462209302084349,"w":0.28322439193725579,"h":0.013081394961037107,"x":0.57952069698707309,"text":"he painted \/ was painting the picture?"},{"w":0.40087142944335941,"h":0.010174418567717725,"x":0.5533769147627069,"y":0.46075581404462951,"text":"12 'Where is \/ was Don?' 'Check the kitchen. He can \/"},{"w":0.11546840667724612,"text":"could be there.","y":0.47529069771711008,"x":0.58169934978410753,"h":0.010174418567717725},{"y":0.4970857618189457,"text":"- 5 Choose the correct forms.","w":0.27450979232788092,"x":0.48583878918464335,"h":0.011656952539550347},{"y":0.51744186044099316,"h":0.013081394961037107,"x":0.58169934089934794,"text":"A group of athletes are at the station, ready to leave","w":0.38562091827392586},{"w":0.084967317581176705,"x":0.57952069992400856,"h":0.01173682732943393,"y":0.53197674453919619,"text":"for Paris..."},{"w":0.40958602905273434,"h":0.011716253453746273,"text":"A: I can't 'see \/ to see Susan anywhere. I'm afraid she","y":0.54787676954581721,"x":0.54466231633783058},{"w":0.30065359115600587,"h":0.010174418567717836,"text":"won't turn up. The train's about to leave.","y":0.56395348846323412,"x":0.5795206939644808},{"x":0.55337690672341922,"y":0.57701915084982036,"w":0.34640522003173824,"text":"B: Well, that's strange. She's never late. Surely","h":0.013097127808023745},{"w":0.33551197052001946,"h":0.013322231473771873,"y":0.59283930041783994,"x":0.57952070878501549,"text":"something 2may have \/ must have happened"},{"y":0.60741049140382675,"h":0.013322231473771762,"x":0.55555555230161957,"w":0.35729846954345701,"text":"A: She 3might have \/ must have missed the bus."},{"w":0.3246187210083008,"h":0.013322231473771873,"y":0.62198168195376702,"text":"B: Or she 4may have \/ can't have overslept.","x":0.55555556051981481},{"y":0.63808139576076062,"text":"Let's call her. Hello, is that you, Sue? Where are you?","w":0.38997821807861333,"h":0.013081394961037107,"x":0.57952069520905936},{"y":0.65261627930727206,"h":0.013081394961037107,"w":0.38344226837158202,"x":0.57952069204514589,"text":"We Sare waiting \/ have been waiting for you for half"},{"y":0.66860465125393176,"x":0.57952069580821242,"text":"an hour and the train is about to leave!","h":0.010174418567717836,"w":0.2897603416442871},{"y":0.68313953515208392,"text":"C: Oh, I'm so sorry, lan! I was about to call you. I'm","x":0.54030501256687258,"h":0.011698100290925773,"w":0.39651416778564452},{"x":0.58169934270428669,"w":0.36165576934814458,"text":"afraid you'll have to go without me. I °went \/ was","h":0.013081394961037107,"y":0.69767441858052803},{"h":0.01171867416661343,"x":0.58169935265689088,"w":0.36383441925048832,"text":"going to the bus stop when I 'was meeting \/ met","y":0.71357202313043067},{"text":"Julie. Julie and | 8would \/ used to be close friends","h":0.010407993338884314,"w":0.36819171905517578,"x":0.58169935112600679,"y":0.7281432141109383},{"y":0.74036181556770242,"w":0.38821208953857422,"text":"when we were at school. We 'would go \/ were going","x":0.58152417231351361,"h":0.016684008875456957},{"h":0.011814282200517168,"x":0.58169935174128373,"y":0.75853455463141073,"w":0.37037036895751951,"text":"camping together. I 1°hadn't \/ haven't seen her for"},{"w":0.36165576934814458,"h":0.011777975477842761,"text":"ages before today, so I wanted \"know \/ to know","x":0.57952069317632748,"y":0.77310574524458897},{"y":0.78767693583392306,"x":0.58169935267925188,"text":"all her gossip. I just couldn't help 12to go \/ going","h":0.013322231870805279,"w":0.35729846954345701},{"w":0.37690631866455071,"text":"for a coffee with her and I completely forgot about","x":0.57952070158820379,"y":0.80224812666365986,"h":0.013322231076738467},{"text":"the time!","x":0.58169934869603868,"w":0.067538123130798322,"y":0.81831395343416435,"h":0.010174418567717836},{"h":0.011659372855384209,"w":0.41176467895507818,"x":0.55773422340372447,"text":"A: Well, that's a pity! But I suppose you may just as well","y":0.83430232577708374},{"text":"join us later. You know our team can't do without you!","w":0.39869277954101567,"x":0.57734205674365369,"h":0.011695679578058504,"y":0.84883720970392507},{"text":"C: Yes, I'll join you tomorrow. And Julie 13might come \/","h":0.011731986697766317,"x":0.54901961580004721,"w":0.41394332885742191,"y":0.8633720933642931},{"x":0.58169935143665585,"text":"might have come with me. She's thinking about it.","w":0.36601306915283205,"h":0.011768293420440723,"y":0.87790697699074671},{"text":"B: All right. See you tomorrow ... and try 14not to miss \/","h":0.013081394961037107,"w":0.41394332885742191,"y":0.89244186073169085,"x":0.55555556178770171},{"text":"not missing the train!","x":0.58169934991815664,"y":0.90697674416192331,"w":0.15686273574829102,"h":0.01308986686052227}]
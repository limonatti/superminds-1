[{"y":3.0519464733202994e-10,"h":0.018895348541742574,"text":"URAMIMAR: Traih and Try Again","w":0.47276687622070318,"x":0.054466238087905482},{"h":0.015506620510333136,"x":0.89743449444021794,"y":-0.0004858683462243274,"w":0.091841249465942409,"text":"UNIT 3"},{"h":0.010174418567717836,"text":"1","x":0.047930283168808659,"w":0.010893245935440068,"y":0.087209302368272845},{"h":0.0087209299740247381,"text":"2","y":0.42151162794903418,"w":0.010893245935440068,"x":0.050108932478903065},{"text":"3.2 Present and past speculation","w":0.32244007110595702,"h":0.015988371354356379,"x":0.058823534207370118,"y":0.058139535296659051},{"text":"Choose the correct forms.","w":0.20697166442871096,"h":0.011826384573752957,"x":0.074074084089202893,"y":0.087010824423872535},{"h":0.011782816109510486,"x":0.074074079702694751,"y":0.10449625315943289,"text":"1 Tom is late. He must have missed \/ can't have missed","w":0.42265792846679689},{"x":0.097971105493597332,"y":0.12044911093395716,"w":0.063317046165466295,"h":0.010555266142884046,"text":"the bus."},{"x":0.074074086148822604,"h":0.013322231870805279,"y":0.13363863429315792,"text":"2 I don't know why Tom's late. He must have missed \/","w":0.41176467895507807},{"w":0.20479301452636717,"h":0.011673895544453861,"y":0.14820982508107861,"text":"might have missed the bus.","x":0.10021787438169653},{"x":0.07407407431840364,"y":0.16279069752331166,"w":0.013071894645690918,"h":0.010174418567717836,"text":"3"},{"x":0.095860558401163698,"y":0.16278101578669169,"text":"'Where's Sue?' 'I don't know. She may be \/ must be","w":0.38562091827392581,"h":0.013091077018439257},{"text":"in the garden'","x":0.098007224580375543,"y":0.17574841380493234,"w":0.11335373878479003,"h":0.01332875393907984},{"text":"4","x":0.074074074118336608,"y":0.19186046500756548,"w":0.010893245935440068,"h":0.010174418567717836},{"x":0.089324609951252784,"h":0.011719884324530305,"w":0.38997821807861333,"text":"'Is Sue in the garden?' 'She can't be \/ might not be in","y":0.19186046542097923},{"h":0.01332223187080539,"y":0.20482930888670425,"x":0.10021785763548038,"w":0.40087146759033199,"text":"the garden. She's always at work at this time of the day.!"},{"text":"5 'Who is that man at the door?' 'Oh, it must be \/ can be","w":0.41830062866210938,"y":0.22093023297911862,"h":0.011792498166912524,"x":0.07407408797831351},{"x":0.10021785939655516,"h":0.013322231473771873,"text":"the courier with my beautiful new shoes. Just a minute!'","y":0.2339716902739023,"w":0.4008714675903321},{"h":0.01162790636734401,"text":"6 We don't really know who burgled their house.","y":0.25000000030470015,"x":0.074074078799724247,"w":0.37472766876220698},{"y":0.26308139549913256,"text":"It might have been \/ can have been a complete","w":0.35076251983642576,"h":0.013081394961037107,"x":0.10021787212971738},{"h":0.013081394961037107,"text":"stranger or one of their neighbours.","x":0.098039222002746132,"w":0.27015249252319334,"y":0.27761627904564423},{"text":"7 I have absolutely no idea. The photo is not clear.","y":0.29215116294099308,"x":0.074074075999011127,"w":0.38779956817626954,"h":0.013081394961037107},{"y":0.30668604648750475,"x":0.10021788695989407,"h":0.013081394961037107,"text":"It looks like a snake, a python, but it could be \/ could","w":0.39651412963867189},{"h":0.015325512119772733,"y":0.31926693432521314,"text":"have been a piece of thick rope.","x":0.097832979424127303,"w":0.24232749938964845},{"w":0.40305007934570308,"h":0.013322231076738467,"x":0.091503276049734017,"y":0.33555370549145347,"text":"That can't be \/ mustn't be true. Felicity was here with"},{"w":0.35947711944580074,"text":"me when it all happened, so she might not have","y":0.35012489625336096,"x":0.10021787178581412,"h":0.013322231076738356},{"x":0.10021786667616758,"text":"done \/ can't have done it.","w":0.19172113418579104,"h":0.011757401602155104,"y":0.36469608646523777},{"x":0.058823535240156669,"w":0.22875816345214844,"h":0.014599025100593632,"y":0.39092423005154031
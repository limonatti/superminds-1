[{"w":0.056644878387451164,"h":0.029069766998291002,"x":0.017429194439172024,"text":"8.9","y":0.0058139537828312271},{"x":0.10675381647222519,"y":0.0087209307672840852,"w":0.27450979232788086,"h":0.01889534791310632,"text":"EXAM SPEAKING"},{"text":"STUDENT B","y":0.00872093063101953,"w":0.17864923477172845,"h":0.01889534791310632,"x":0.76034858634507263},{"x":0.013071907170141443,"y":0.077034883693834044,"h":0.01171511650085455,"w":0.32461872100830075,"text":"1 In pairs, ask and answer the questions."},{"x":0.037037040696141117,"text":"Talk about crime and criminals.","w":0.24618736267089847,"h":0.011782945791880328,"y":0.097383720939473561},{"text":"1 Which crimes are the biggest problem in your town","x":0.037037045713284339,"y":0.11191860492808026,"w":0.40958602905273434,"h":0.013081395228703774},{"text":"or in your country?","h":0.0118313952287038,"w":0.13943354606628416,"y":0.12624999996554354,"x":0.063180831977751137},{"y":0.14083333323230895,"w":0.41830062866210938,"h":0.011782945791880217,"text":"2 Ifyou were a judge, would you release criminals from","x":0.037037054732126012},{"x":0.063180830935183507,"y":0.15541666683942512,"h":0.013333332935969056,"w":0.37037036895751957,"text":"prison earlier if they behaved well in prison? Why?"},{"text":"4 Do you know anyone who has been a victim","y":0.11191860462406655,"x":0.51198257766816713,"w":0.35947711944580074,"h":0.011831395228703911},{"text":"of identity theft? What happened?","x":0.54030501176233903,"h":0.013333333333333308,"y":0.12624999986129171,"w":0.26143791198730459},{"y":0.1408333334164098,"x":0.5141612241430531,"w":0.37254901885986325,"text":"5 When did you last see something vandalised?","h":0.013333333333333308},{"x":0.53812636562756311,"y":0.15541666683942512,"text":"What happened?","w":0.13289759635925291,"h":0.013333332935969056},{"w":0.010893245935440062,"x":0.037037037081299573,"text":"3","y":0.17005813973082606,"h":0.008720929622650142},{"w":0.39433551788330079,"x":0.054466234558712474,"y":0.16999999993306836,"text":"At what age do you think people are old enough to","h":0.011686046520868909},{"x":0.061002181641354125,"text":"take responsibility for criminal actions?","y":0.18313953492444657,"h":0.013110465208689304,"w":0.29193899154663089},{"y":0.20784883723921965,"text":"2","h":0.010174418290456066,"w":0.013071894645690916,"x":0.013071895705476984},{"y":0.20784883749227601,"text":"Discuss this question together. 'Is the main purpose of a prison to punish a criminal or to help him\/her","x":0.037037055032524149,"w":0.7952069091796875,"h":0.013081394831339521},{"x":0.037037036161681552,"h":0.013081394831339521,"text":"not to break the law again when he\/she is released?' What do you think?","y":0.22238372126165584,"w":0.56862743377685554},{"x":0.013071895705476984,"text":"3","h":0.010174418290456178,"y":0.25145348840201032,"w":0.013071894645690916},{"text":"Look at the two photos showing two stages of the justice system.","h":0.013333333333333419,"w":0.50762523651123048,"x":0.026143800299214384,"y":0.25124999998726061},{"y":0.2658333335726597,"h":0.013333332935969056,"w":0.52505443572998045,"text":"Which of the jobs in the justice system would you prefer to do? Why?","x":0.037037045724334555},{"w":0.4967320251464844,"x":0.03921569298231322,"h":0.013110464811325051,"text":"Read the instructions on your card and role-play the conversation.","y":0.74563953512430114},{"h":0.012206647396087567,"x":0.065272369377268186,"y":0.775873420297433,"w":0.085141534805297847,"text":"Student B:"},{"text":"The situation:","h":0.01041666666666663,"w":0.11111110687255861,"x":0.065359481095311048,"y":0.80083333344772401},{"x":0.065359493444199043,"h":0.013081394831339521,"w":0.56427013397216796,"y":0.81831395369261506,"text":"You and Student A are discussing placements for voluntary work. There are"},{"w":0.58387798309326155,"x":0.065359493130202465,"y":0.83284883739537674,"text":"two places available: one is at a youth centre helping young people with their","h":0.013081394831339521},{"w":0.56427013397216796,"h":0.013081394831339521,"text":"Maths and one is at an old people's home, keeping elderly people company.","y":0.84738372117081284,"x":0.067538142681671895},{"w":0.55773418426513677,"h":0.013081395228703774,"x":0.067538142202943519,"y":0.86191860483723726,"text":"Discuss the advantages and disadvantages of both placements, talk about"},{"x":0.065359478187404674,"text":"your skills and interests and decide which you will do.","y":0.87624999994486719,"w":0.40087146759033204,"h":0.013333333333333308},{"text":"Your goal:","y":0.90533938573464678,"x":0.065302168565702048,"h":0.011995646953582795,"w":0.082903289794921883},{"y":0.92291666682241769,"x":0.065359484423528902,"h":0.011676356395085574,"text":"You want to work at the youth centre.","w":0.28322439193725585},{"h":0.011627906958262102,"x":0.89978213569395593,"y":0.96511627900633412,"w":0.037037036418914759,"text":"141"}]
[{"x":0.15434783198847235,"y":0.021739130731978862,"w":0.56956520080566408,"h":0.020484949832775823,"text":"LISTENING LANGUAGE PRACTICE"},{"x":0.028260870032180571,"y":0.040697673959938174,"h":0.049418605689619755,"w":0.086956520080566396,"text":"2.3"},{"text":"Collocations • phrasal verbs","h":0.013377926022711373,"w":0.21956520080566405,"y":0.065217391652178214,"x":0.15652174782180567},{"text":"1 Look at the recording extract. Put questions 1-4 in","x":0.019565222117194844,"y":0.13372093013507014,"w":0.41739128112792973,"h":0.013081395107766847},{"x":0.043478261062763653,"text":"gaps A-D.","w":0.080434780120849619,"h":0.011705685618729089,"y":0.14966555193127207},{"text":"So, why did you take up windsurfing?","y":0.1671511630420468,"w":0.27826086044311527,"h":0.013081395107766847,"x":0.06521739508279023},{"w":0.27173912048339838,"h":0.011627906939656429,"x":0.067391306606126911,"text":"What other water sports did you do?","y":0.18168604655924159},{"y":0.19622093055482437,"w":0.010869565010070803,"h":0.0087209298060489937,"text":"2","x":0.043478261054747197},{"x":0.067391314677734335,"y":0.19607023408739765,"h":0.011778603030686341,"w":0.2956521606445312,"text":"Areyourmumand your cousin still your"},{"text":"role models?","y":0.20930232572706764,"x":0.067391309005533806,"w":0.097826080322265613,"h":0.010179279639968009},{"text":"3","x":0.04130434797150654,"h":0.010174417974159411,"y":0.2238372096902459,"w":0.013043477535247802},{"y":0.22366220755846478,"x":0.067391304165596397,"w":0.26739130020141599,"text":"Was your cousin a good windsurfer?","h":0.013377926022711373},{"x":0.054347827701243537,"y":0.2382943142295425,"text":"Who inspired you?","w":0.15217391014099119,"h":0.013159174185532807},{"w":0.24130434036254883,"x":0.069565225072348649,"text":"Extract from Students' Book recording","y":0.27325581416583078,"h":0.011627906939656318},{"w":0.058695650100707986,"x":0.31304347856377646,"y":0.27325581404470667,"text":"L) 1.24","h":0.011627906939656429},{"x":0.032608695740095339,"text":"P:","y":0.29505813949113524,"h":0.011627906939656429,"w":0.0195652174949646},{"y":0.29347826067598037,"text":"First of all, congratulations Jackie. Last month you","h":0.013377926820097974,"w":0.36739128112792963,"x":0.069565233593643722},{"y":0.30959302324528803,"text":"became the world under eighteen windsurfing","x":0.069565214999373667,"w":0.34130435943603515,"h":0.011627906939656429},{"x":0.069496129710194018,"h":0.012050969146167212,"text":"champion!","y":0.32391637574168963,"w":0.078399043083190914},{"x":0.032608695806804831,"text":"J:","h":0.013081395107766847,"y":0.33866279068739558,"w":0.017391303777694697},{"text":"P:","h":0.01162790693965654,"w":0.0195652174949646,"x":0.032608695448169876,"y":0.35465116269296248},{"y":0.37063953472759903,"h":0.010174418771546012,"w":0.017391303777694697,"text":"J:","x":0.032608696111152649},{"w":0.2043478202819824,"x":0.065217396761182655,"h":0.014632107023411334,"text":"Yes, that's right. Thank you.","y":0.33862876244908668},{"h":0.013377926421404673,"x":0.067391302316814963,"y":0.35451505028341779,"w":0.29347826004028327,"text":"So, why did you take up windsurfing? A"},{"text":"Two people really: my mum and my cousin, Rachel.","h":0.013892334839173515,"w":0.37630393981933596,"x":0.069449207828291004,"y":0.36870166634823942},{"x":0.067391304891304321,"h":0.01162790693965654,"w":0.049999999999999989,"y":0.38226744168521054,"text":"Ifirst1"},{"w":0.23478260040283205,"x":0.16304347849423628,"y":0.38372093047421729,"text":"_ windsurfing with my mum. We","h":0.013081395107766847},{"w":0.34782608032226564,"h":0.011705685618729089,"text":"lived near the sea, and we spent every summer","y":0.39966555166479911,"x":0.069565225056258409},{"w":0.35434780120849607,"h":0.013081395107766847,"x":0.069565226287056345,"y":0.41424418623972126,"text":"on the beach. My mum had entered windsurfing"},{"x":0.069565219149605145,"text":"competitions when she was a teenager. She","y":0.43018394634245127,"w":0.32173912048339848,"h":0.011705685618728978},{"text":"2","y":0.44331395360472736,"x":0.067391304627364326,"h":0.0087209298060489937,"w":0.015217391252517712},{"y":0.44476744198802054,"x":0.12391304307256291,"h":0.011754297093802935,"text":"_ anything, but she really enjoyed it. She","w":0.29782608032226565},{"h":0.012445211809215762,"text":"started to 3","x":0.069447111515800228,"w":0.087192735671997076,"y":0.45744018441017131},{"w":0.23103988647460943,"text":"_me how to windsurf as soon","x":0.18657544189356012,"h":0.015806175793293797,"y":0.45684715522418129},{"x":0.069565222948189176,"w":0.35652172088623046,"y":0.475290697751102,"h":0.011749436225380716,"text":"as I could swim [...]. I was only about 7 years old"},{"y":0.48982558134121823,"text":"My cousin Rachel was there too. She and her","x":0.069565229012451088,"w":0.33260868072509764,"h":0.011627906939656429},{"text":"family lived near us. My mum gave us both lessons","x":0.069565220433827124,"h":0.013377926022711373,"y":0.50418060228597283,"w":0.3760869598388672},{"y":0.51881270919222655,"x":0.067391305853359992,"w":0.34782608032226564,"h":0.013164034655261503,"text":"together. Rachel's two years older than me and"},{"h":0.013377926421404673,"text":"l've always looked up to her. I still do.","x":0.069565222532065582,"y":0.53469899670664678,"w":0.27826086044311521},{"text":"P:","x":0.032608695437300314,"h":0.011627906939656429,"w":0.0195652174949646,"y":0.55087209309024932},{"x":0.032608695410126398,"text":"J:","y":0.56540697693225161,"w":0.0195652174949646,"h":0.010174417974159522},{"w":0.013043477535247802,"y":0.54941860503908313,"h":0.010174417974159411,"text":"B","x":0.069565217536723928},{"text":"Yes, but she was good at a wide range of sports. [...]","x":0.06956523134226035,"y":0.56521739125948922,"w":0.38043476104736329,"h":0.011817492370222782},{"y":0.57984949843125155,"w":0.3760869598388672,"h":0.013377926022711484,"x":0.069565222000856047,"text":"She was a really good example for me - I wanted to"},{"w":0.1630434799194336,"h":0.013081395107766847,"x":0.069565214931587571,"y":0.59447674435018638,"text":"be sporty like her. [...]"},{"text":"P:","y":0.61046511613506027,"w":0.017391303777694697,"x":0.034782609125645403,"h":0.010174418771546012},{"h":0.010174417974159411,"y":0.62645348859649597,"x":0.032608695844908997,"text":"J:","w":0.0195652174949646},{"h":0.011725130288497199,"w":0.23260868072509769,"x":0.069565227762451082,"y":0.61036789283976123,"text":"So you grew up near the sea. C"},{"text":"All sorts. At first, windsurfing wasn't my favourite","x":0.071739143122102111,"y":0.62499999996040423,"h":0.0117056856187292,"w":0.35652172088623052},{"h":0.013081395107766847,"w":0.33913043975830082,"text":"thing. I liked other water sports like swimming","x":0.069565211352733775,"y":0.63953488362344213},{"h":0.016229050613964624,"x":0.069330457095560127,"text":"and sailing. Rachel talked me into 4","w":0.26146205902099606,"y":0.65253555319824719},{"text":"children's sailing club. We5_","w":0.20652173995971679,"x":0.067391306188619785,"h":0.014661273828716959,"y":0.66847826065079141},{"text":"weekends there, even in winter. We did lots of","y":0.6845930233470322,"w":0.34347824096679691,"h":0.011627906939656429,"x":0.06956522304921034},{"text":"sailing, and then Rachel thought we should try out","w":0.3739130401611328,"h":0.011793186832032454,"x":0.069565223723781322,"y":0.70058139529470675},{"x":0.069565227368907079,"text":"rowing. I wasn't sure about rowing at first, [...] but","y":0.71511627935382005,"w":0.36956520080566402,"h":0.013144590384186694},{"x":0.071739128354216281,"text":"my mum thought it was a good idea. Now I'm glad","y":0.7311046512394741,"w":0.3739130401611328,"h":0.011788325166223745},{"x":0.069565216288372478,"w":0.36521739959716798,"y":0.74563953482959033,"text":"I did it because it made my arms strong, and that","h":0.011627906939656429},{"h":0.013377926820097863,"w":0.20434782028198242,"x":0.069565216887994413,"text":"helped my windsurfing. [...]","y":0.76003344479391866},{"text":"P: D.","y":0.77616279118249387,"h":0.010208446445273744,"x":0.036956522382217631,"w":0.047826085090637203},{"y":0.79069767423341308,"x":0.032608695448169876,"text":"J:","w":0.0195652174949646,"h":0.010174418771546012},{"x":0.069565214629578695,"h":0.013081395107766958,"y":0.78924418594902346,"text":"Yes, definitely. I think | take after my mum - I hope","w":0.37391304016113275},{"y":0.80518394642990765,"w":0.34565216064453125,"text":"I have some of the same qualities anyway. And","x":0.069565220569038785,"h":0.013130006981533882},{"w":0.23260868072509766,"h":0.013081395107766958,"x":0.071739137789625082,"text":"Rachel is like a big sister to me.","y":0.819767441762977},{"y":0.066860465367628241,"w":0.015217391252517642,"h":0.013081395107766847,"text":"3","x":0.48913043491721953},{"y":0.068143812746117804,"w":0.38695652008056636,"h":0.011798047700454561,"text":"Choose the combination which is not possible in","x":0.50652173351044172},{"h":0.011866599022345437,"y":0.082729491182522152,"w":0.095716438293456996,"text":"each group.","x":0.51735917375181106},{"text":"1","w":0.013043477535247816,"y":0.10174418611441727,"h":0.0087209298060491047,"x":0.51739130456570948},{"w":0.049999999999999933,"x":0.5413043483695652,"text":"spend","y":0.10029069749916397,"h":0.01162790693965654},{"text":"sports ...\/ hours ... \/ the weekend ...","x":0.62173913318423957,"w":0.27826086044311527,"y":0.10029069749916397,"h":0.011749436225380827},{"x":0.51739130456018201,"h":0.010174417974159411,"text":"2","y":0.11627907025226136,"w":0.010869565010070859},{"h":0.010174417974159411,"w":0.028260869979858438,"x":0.54347826058072291,"text":"win","y":0.11627906995550752},{"y":0.11622073571854175,"h":0.011705685618729089,"w":0.22608695983886717,"text":"a competition \/ a goal \/ a race","x":0.62173913103708811},{"h":0.0087209298060489937,"text":"3","x":0.51739130436996461,"w":0.010869565010070859,"y":0.13226744196470808},{"y":0.13169296723730217,"x":0.54108445589703535,"w":0.
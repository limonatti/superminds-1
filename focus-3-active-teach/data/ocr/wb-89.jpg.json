011642405715270199,"text":"10 Complete the text with the correct form of the words","x":0.48471615791303491,"y":0.48254364073129707},{"y":0.497090606668805,"x":0.50873362930188559,"text":"in the box. There are two extra words.","h":0.011637572734829571,"w":0.30786026000976563},{"w":0.29475982666015621,"text":"day dislocate interesting obvious","x":0.54585153140245457,"y":0.52325581398221177,"h":0.01165690426021837},{"text":"operate sprain stitch surgeon","x":0.54148472156915772,"w":0.26637554168701172,"y":0.53779069770314203,"h":0.011668986513133084},{"h":0.014685910637935673,"w":0.42139736175537101,"x":0.50000000606866513,"text":"Medical help to get you back on track","y":0.56816292618886755},{"text":"Professional athletes depend on their bodies working well in order","w":0.4257641983032226,"x":0.49781659388878169,"h":0.016209476309226978,"y":0.58561928532038665},{"text":"to succeed. Interestingly, recent studies have shown that many","h":0.014659329840072677,"x":0.50000000723425975,"w":0.42358078002929678,"y":0.60016625110217903},{"x":0.5000000044540559,"y":0.61471321680174895,"w":0.42358078002929689,"h":0.016209476309226978,"text":"of them have a reaction to pain that is different to what most"},{"x":0.49781659506236237,"y":0.63081395380285299,"w":0.42576419830322271,"h":0.015988371318712447,"text":"of us experience. This is because physical pain is so much a part"},{"h":0.014623083081328647,"w":0.069868993759155229,"text":"of their '","x":0.49563318783657961,"y":0.64380714916179516},{"w":0.23580785751342781,"h":0.013300083521892936,"text":"lives. For example, a ballet dancer","x":0.68777292699292214,"y":0.64671654194752504},{"x":0.49781659435275544,"h":0.016209476309226978,"y":0.66126350794118927,"w":0.4257641983032226,"text":"who experiences muscle pain might simply assume that they've"},{"y":0.67581047369244951,"text":"had a hard workout and just stretch or take a hot bath to feel","w":0.42576419830322271,"h":0.022028262676641708,"x":0.49781659506236237},{"w":0.16157205581665035,"text":"better. A runner who has","h":0.011677443931623954,"x":0.50000000031219882,"y":0.6903574396152341},{"h":0.014706450705714524,"y":0.69186046561298087,"x":0.79039301247671867,"w":0.13318777084350586,"text":"an ankle might just"},{"y":0.70490440568103807,"w":0.42358078002929689,"text":"wrap it in an elastic bandage and keep on running, hoping it","h":0.016209476309226867,"x":0.49999999783105764},{"y":0.71869058727398649,"w":0.24540205001831061,"text":"will get better on its own. This is 3","h":0.018875039624652534,"x":0.49746092496752703},{"text":"the wrong","x":0.85508423136060063,"y":0.72295250920511545,"h":0.011712970876337048,"w":0.069166235923767028},{"h":0.014546965918536992,"text":"approach, as any doctor will tell you, and can lead to long-lasting","w":0.4257641983032226,"x":0.49781659384589333,"y":0.73690773092676409},{"x":0.50000000829321167,"y":0.75145348872344597,"w":0.42358078002929689,"h":0.014548174064553776,"text":"injuries. Fortunately, more and more professional athletes have"},{"text":"easy access to doctors and physical therapists, which means that","y":0.76724854556258126,"w":0.42794757843017583,"h":0.014728198126763514,"x":0.49781660914735737},{"text":"they can more easıly prevent and deal with injuries. They dont","h":0.011665361678709241,"x":0.50218342221547285,"y":0.78343023256263822,"w":0.42139736175537112},{"text":"even need to go to a doctor's 4","x":0.49958169209079351,"y":0.7926932101253249,"w":0.20868238449096688,"h":0.020244441424819404},{"x":0.82302279343063733,"y":0.79748338228876692,"w":0.10067930221557619,"text":",because most","h":0.012591374683459389},{"text":"services are available where they train. Of course, nothing makes","w":0.42576416015624996,"h":0.013081395219785352,"x":0.49781660278213735,"y":0.81250000008875078},{"x":0.49781658725668565,"text":"an athlete happier than to hear the words, 'l don't think you need","w":0.42576419830322265,"y":0.82703488421763194,"h":0.014611000828413934},{"y":0.83998337451497773,"h":0.016209476309226978,"x":0.49781659514492121,"w":0.045851526260375974,"text":"a(n) 5"},{"w":0.25764190673828125,"x":0.6681222823659394,"y":0.84156976786588777,"text":": Because they are getting help earlier,","h":0.014623083081328536},{"h":0.01754455851795067,"text":"they are more likely to avoid serious problems and to have longer","w":0.42576419830322265,"x":0.49781659579926185,"y":0.8561046517310974},{"x":0.499905113632647,"w":0.098443050384521502,"y":0.8717281293651481,"h":0.012357694351564086,"text":"careers as well."},{"w":0.021834061145782457,"h":0.011627906773948538,"text":"\/5","x":0.91048034930338251,"y":0.90697674419054519},{"h":0.011627906773948538,"text":"Total","w":0.050218338966369624,"x":0.80567685660851818,"y":0.93459302333193373},{"text":"\/20","w":0.034934496879577615,"h":0.011627906773948427,"y":0.93459302328453742,"x":0.89301310119631028},{"text":"87","y":0.96220930245551417,"w":0.02401746749877931,"h":0.013081395219785463,"x":0.9039301309776846}]
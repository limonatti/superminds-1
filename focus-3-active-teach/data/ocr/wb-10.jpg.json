[{"h":0.029069768697594145,"text":"1.4","y":0.03924418549131925,"w":0.067538127899169909,"x":0.063180826780262545},{"w":0.16128919601440428,"x":0.18515060997185118,"text":"READING","y":0.011506035937765113,"h":0.020592579138864586},{"x":0.18500850309900216,"h":0.014731133212455561,"text":"Unusual appearances • synonyms","w":0.27047864913940434,"y":0.055143293321730957},{"w":0.27450979232788086,"y":0.069767442078589981,"h":0.013081394961037107,"text":"• clothing • compound adjectives","x":0.18300653716939308},{"text":"Read the texts. Match pictures A-C with texts 1-3.","x":0.55119825875423645,"y":0.02906976774656056,"w":0.39651416778564452,"h":0.011729565984899049},{"text":"C","x":0.55119825768804775,"h":0.0087209299740247381,"y":0.07994186054593333,"w":0.013071894645690918},{"x":0.054466231665461745,"w":0.034858386516571055,"y":0.12500000032471403,"h":0.013081394961037107,"text":"•00"},{"text":"NEWS","x":0.43562218654439305,"y":0.15092286117829024,"w":0.13093427658081053,"h":0.026642649298802112},{"text":"35-year-old Herbert Chavez from the Philippines","w":0.41176467895507818,"x":0.076252737406992524,"h":0.017541099249770653,"y":0.18895348845620785},{"y":0.19025811819906324,"w":0.40522872924804687,"h":0.014683741713245158,"text":"When he's not making dresses, Herbert can often","x":0.51633988880734905},{"text":"has transformed* himself from an ordinary dress-","w":0.4099656677246093,"x":0.078262607117931288,"h":0.017871693111677023,"y":0.20218586547630601},{"h":0.011756191444238229,"w":0.40522876739501956,"x":0.51633986872079074,"text":"be seen in the streets around his home dressed as","y":0.20639534908376977},{"w":0.40958602905273439,"x":0.078431391464918079,"y":0.2209302328729672,"h":0.015988371354356379,"text":"maker into a real-life Superman. After nineteen"},{"text":"Superman. He aims to teach children good morals","y":0.22231473788694922,"h":0.014603866526328169,"x":0.51633988744569326,"w":0.40522872924804687},{"x":0.076252721447350499,"text":"surgeries that copy the comic book hero's look,","w":0.40958606719970703,"y":0.23688592831397715,"h":0.016021048000313454},{"text":"and have some fun at the same time.","h":0.013114071606994182,"y":0.23688592821727439,"x":0.51633987515203605,"w":0.29847494125366203},{"h":0.014574821148188644,"x":0.078431381056065952,"w":0.33769062042236331,"text":"Chavez has become a real-life Clarke Kent.","y":0.25145348882800167},{"y":0.26308139586530788,"h":0.014603866526328169,"x":0.51633987867663034,"text":"Herbert says he feels like a superhero whenever he","w":0.40522872924804687},{"y":0.27761627937853883,"w":0.40958606719970703,"h":0.015988371354356379,"text":"Herbert first fell in love with the superhero when he","x":0.078431370684823282},{"x":0.51614399733719973,"h":0.016338845474535346,"w":0.40554500579833985,"text":"puts on the costume,* but his mission is not to save","y":0.27732951249023496},{"w":0.40740737915039055,"x":0.078431381194594293,"text":"was five years old. Since then he has spent around","y":0.29350541209895487,"h":0.014634122062384569},{"h":0.014683741713245158,"text":"the world but to help in his own small way and","w":0.40522872924804687,"y":0.29505814019670318,"x":0.51633988782695683},{"text":"300,000 pesos (£4,400) on his obsession - a huge","y":0.30959302391763344,"w":0.40958602905273434,"h":0.01472004883295297,"x":0.078431391192586977},{"y":0.30959302364937213,"w":0.33986927032470704,"h":0.015988371354356379,"x":0.51633988030605593,"text":"bring a smile to the faces of local children."},{"w":0.41176467895507818,"text":"amount of money compared to the average wage","x":0.076252732657537264,"y":0.32412790732248686,"h":0.017441859948049476},{"h":0.014722469148786832,"w":0.14814814567565918,"text":"in the Philippines.","x":0.076252726399643117,"y":0.3413821814975333},{"h":0.011627906367344121,"w":0.017429193258285527,"text":"2","x":0.041394336050595795,"y":0.3851744188366768},{"text":"3","x":0.51851851846672337,"w":0.01525054454803465,"h":0.010174418567717725,"y":0.38662790692253646},{"text":"Sleepily, Fiona switched off the alarm clock and tried","y":0.39966694404346592,"w":0.41830062866210938,"h":0.016236469608659432,"x":0.058823538890233847},{"w":0.41830062866210938,"text":"to wake up fully. It was Monday again and she had","x":0.058823538890233847,"y":0.41840133247010647,"h":0.014738201995773359},{"x":0.061002194601407073,"y":0.43588676118238756,"text":"another busy week ahead. With only four weeks","w":0.41830062866210938,"h":0.014694633928564294},{"x":0.061002189953622193,"w":0.41830062866210938,"h":0.013081394961037107,"y":0.45494186087703969,"text":"until her final exams, there was lots of hard work to"},{"x":0.061002196344326444,"y":0.47238372103328952,"w":0.41830062866210938,"h":0.013081394961037107,"text":"do and no time for her social life. She really wanted"},{"x":0.058823545750453121,"y":0.48982558169200785,"w":0.42047927856445311,"h":0.016002894837493065,"text":"to be older, already finished with school, already"},{"h":0.014724889464620583,"w":0.41830062866210938,"text":"earning. Perhaps because winter was coming and it","x":0.061002185886810383,"y":0.507077435745653},{"w":0.41612197875976564,"h":0.015988371354356379,"text":"was still cold and dark outside, she found it especially","x":0.061002187286783922,"y":0.52616279113968223},{"x":0.058823540521695,"h":0.015988371354356379,"y":0.54360465137224034,"w":0.42047927856445311,"text":"difficult to get out of bed this morning. Her legs felt"},{"y":0.56244795968303496,"text":"heavy and she seemed to have less energy than usual.","w":0.41612197875976559,"h":0.014586923521424655,"x":0.061002196649528814},{"w":0.41830062866210938,"text":"Maybe she had slept badly. Finally, she made it to","h":0.015996843253841542,"x":0.061002195298574903,"y":0.57993338889135992},{"h":0.016236469608659432,"y":0.59866777664621074,"x":0.058823547052387466,"w":0.41830062866210938,"text":"the bathroom, switched on the light and stood by"},{"y":0.61615320578078947,"w":0.41830062866210938,"text":"the washbasin. When she saw her reflection* in the","h":0.011753770731370849,"x":0.061002185886810383},{"y":0.63363863417362587,"w":0.41830062866210938,"text":"mirror, she screamed. Looking back at her was the","h":0.014617179057481056,"x":0.061002184724864211},{"text":"face of a terrified old woman - herself, but wrinkled,*","x":0.058823546583786385,"y":0.65261627963895552,"h":0.015993212780090804,"w":0.42047927856445311},{"h":0.014734571522022621,"text":"pale and grey-haired...","w":0.19172113418579104,"x":0.061002180401657814,"y":0.66985845125365784},{"x":0.59912854587079867,"y":0.39825581391744924,"w":0.30065359115600587,"h":0.010174418567717725,"text":"At Oddfaces we like our models to"},{"text":"be fabulously fat or superbly skinny,","y":0.41132389695053795,"w":0.32026142120361334,"h":0.013094707492189883,"x":0.5882353056727031},{"text":"ten feet tall or shockingly short.","h":0.013322231870805279,"x":0.60566449443967729,"y":0.42422980812001232,"w":0.28540304183959964},{"text":"We love odd models with tattoos,","x":0.60130718831126895,"y":0.43750000024840585,"w":0.29629629135131841,"h":0.013081394961037107},{"x":0.60784314526230876,"y":0.45203488398929315,"w":0.28322439193725579,"text":"piercings and memorable faces.","h":0.011745299228919093},{"text":"We have over 1,000 unique character","w":0.30528186798095702,"h":0.013919465845570134,"x":0.59679929950830091,"y":0.47083254452872181},{"x":0.6034858389979264,"text":"models between the ages of 18 and","w":0.29193899154663094,"y":0.484011628298886,"h":0.011825174415836193},{"y":0.49708576202218069,"h":0.011656952539550458,"x":0.59259260064078945,"w":0.3115468215942383,"text":"98 and sizes 7 and 27. Our models can"},{"w":0.27450979232788086,"x":0.61220044427178932,"y":0.51162790722330487,"text":"bring a truly eye-catching look to","h":0.011685997917689761},{"h":0.011774344607058618,"text":"music videos, TV shows and films, and","w":0.30936819076538091,"x":0.59477123844083901,"y":0.5245628644632413},{"x":0.60130719571867619,"w":0.2962962913513183,"y":0.53779069794278156,"h":0.011751350415537098,"text":"of course print and film advertising."},{"w":0.32244007110595696,"h":0.011708992109211391,"text":"For over a decade, we have successfully","x":0.58823530751165454,"y":0.55079100753763888},{"h":0.011816702913384325,"text":"provided the most unusual faces","w":0.26797384262084956,"x":0.61655773798514535,"y":0.56395348848299465},{"text":"and bodies for top fashion designers,","w":0.30501089096069334,"h":0.013097128205057151,"y":0.57701915065627529,"x":0.5969498952603941},{"text":"photographers and film directors.","y":0.58992506282305168,"w":0.28104574203491217,"h":0.013322231076738356,"x":0.6100217959760077},{"y":0.61032472918635727,"text":"If you need beautifully strange","w":0.25272331237792967,"h":0.013322231870805279,"x":0.62309368438837709},{"y":0.62246636789114895,"x":0.62073196677287823,"w":0.26182300567626959,"h":0.015707706829391821,"text":"and strangely beautiful people,"},{"x":0.6644880219284357,"text":"then look no further.","y":0.63808139534913522,"h":0.010174418567717836,"w":0.17211328506469725},{"x":0.58387800578086968,"y":0.65695253927098995,"w":0.32897602081298827,"text":"Pretty faces are everywhere these days","h":0.014571190674438017},{"x":0.61437909444120919,"w":0.26797384262084956,"h":0.014734571522022621,"y":0.66985845122458809,"text":"- choose something different."},{"h":0.011791288008995537,"text":"Choose Oddfaces.","x":0.67102396700889899,"w":0.15686274528503419,"y":0.68442964191886246},{"w":0.028322439193725568,"text":"в","x":0.49891067606399409,"h":0.018895348541742463,"y":0.71220930238852798},{"x":0.052287583267852149,"w":0.089324617385864252,"y":0.85610465128401636,"h":0.013081394961037107,"text":"GLOSSARY"},{"y":0.87635303928536501,"text":"transform (v) - change completely","x":0.065359483044391528,"w":0.25490194320678711,"h":0.013322231473771873},{"text":"costume (n) - clothes that make you look like something,","x":0.065359495429676742,"h":0.01
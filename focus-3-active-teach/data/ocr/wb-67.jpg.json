[{"h":0.013081395367350201,"text":"2 Read the text again. Complete gaps 1-4 with","y":0.042151162617923732,"w":0.37391304016113286,"x":0.010869562256390247},{"text":"sentences A-E. There is one extra sentence.","x":0.034782620333729641,"h":0.011761365629396781,"y":0.056686046530727952,"w":0.34130432128906252},{"x":0.034782626189230115,"h":0.0131056607267096,"text":"A The huge mirrors were carried there by helicopters,","w":0.40434780120849612,"y":0.078464106742575868},{"w":0.34347824096679686,"y":0.093023256130050358,"h":0.013081394571294647,"text":"as part of a project which cost 5 million kroner","x":0.058695667849934734},{"w":0.08695652008056641,"x":0.05652173909015161,"text":"(£500,000).","y":0.10755813956923199,"h":0.01308139536735009},{"text":"C","x":0.43260869535577856,"y":0.10610465124437729,"w":0.019565217494964593,"h":0.01308139536735009},{"x":0.052173912870191685,"w":0.35869564056396486,"y":0.12500000026134817,"h":0.011627906550947142,"text":"This happens because between September and"},{"text":"March the sun is so low in the sky that its light and","x":0.060869580224078561,"y":0.13939899842001668,"w":0.36739128112792968,"h":0.013355592654423987},{"text":"warmth don't reach the small town at the bottom","w":0.36304347991943359,"x":0.05869565739535549,"h":0.01043405676126874,"y":0.15400667767953791},{"y":0.16834249140204705,"w":0.095810279846191393,"h":0.013605714839368566,"text":"of the valley.","x":0.060790513845263787},{"text":"C Environmentalists disapprove of the project,","w":0.35000000000000003,"x":0.034782613070652071,"h":0.01308139536735009,"y":0.18604651160048191},{"h":0.010325596607189125,"w":0.067442250251770003,"x":0.058670178170371144,"text":"however.","y":0.20050580618035352},{"w":0.37608695983886714,"x":0.036956523841435891,"y":0.21786310491748861,"h":0.013355593052451598,"text":"D However, Rjukan is not the only place to benefit"},{"text":"from this kind of scheme.","y":0.23110465133353864,"h":0.013081394571294758,"x":0.058695659911215933,"w":0.18913042068481445},{"x":0.03695653927394691,"text":"E The idea was first suggested 100 years ago","w":0.34130432128906246,"y":0.24999999993623767,"h":0.013081395367350201},{"text":"by Sam Eyde, who was responsible for building","h":0.013081395367350201,"y":0.26453488367533651,"x":0.06086957473208212,"w":0.3456521606445313},{"h":0.018775336531446474,"x":0.058092533257512076,"w":0.14703907966613769,"text":"the town of Rjukan.","y":0.27492422687337159},{"y":0.29924874830593784,"h":0.013355592256396376,"x":0.013043492647036281,"text":"3 Read the texts again. Choose the correct answer A-D.","w":0.44347824096679689},{"y":0.32122093005978425,"w":0.37173912048339841,"h":0.013086248518827559,"text":"1 Which is true about the importance of the sun?","x":0.036956529459387648},{"x":0.060869582085969258,"h":0.013355592256396265,"w":0.35434780120849607,"text":"A It prevents humans from becoming frustrated","y":0.33555926579587092},{"w":0.33478260040283203,"x":0.060869573548583841,"text":"B It is both practical and pleasant for people.","y":0.3501669448714988,"h":0.013355592654424098},{"h":0.013132352462793984,"text":"C Its warmth is appreciated everywhere on Earth.","w":0.36521739959716792,"y":0.36477462427247986,"x":0.060869565636198539},{"text":"D Every animal and plant needs it to live.","y":0.37936046505251686,"w":0.30434782028198243,"h":0.01308139536735009,"x":0.060869571924226096},{"y":0.3968023255115769,"w":0.34999999999999998,"h":0.01308139536735009,"x":0.036956524655797053,"text":"2 For half a year the town of Rjukan in Norway"},{"w":0.38913043975830081,"text":"A doesn't get direct sunlight because of its location.","x":0.060869569215052266,"y":0.41133720966687204,"h":0.013120219385086562},{"h":0.011790483742206037,"w":0.38043476104736329,"text":"B isn't the only Scandinavian town without sunlight.","x":0.060869579802405233,"y":0.42570951598675588},{"h":0.01335559305245182,"w":0.38260868072509768,"text":"C hasn't been able to find a solution to its problem.","x":0.060869577463538001,"y":0.4403171952055529},{"text":"D doesn't allow its citizens to stay in the valley.","x":0.06086955938405815,"w":0.35000000000000003,"h":0.011686143572620988,"y":0.4549248748953072},{"text":"3 Now the people of Rjukan","y":0.47238372153702701,"w":0.217391300201416,"h":0.013081394571294869,"x":0.036956523522480397},{"w":0.29130434036254882,"text":"A can finally stand in its central square.","x":0.060869572590464639,"y":0.48691860486406136,"h":0.011829308157970231},{"x":0.060869573609321888,"y":0.50125208675849109,"text":"B are able to feel the sun in winter.","w":0.25869564056396488,"h":0.01043405676126874},{"x":0.060869579754134297,"w":0.29999998092651364,"h":0.011756512477919423,"y":0.51585976637894948,"text":"C have sunlight everywhere in the town."},{"h":0.011686143572621099,"text":"D are organising more activities in cold months.","x":0.063043479345915324,"w":0.35217391967773437,"y":0.53046744574359339},{"w":0.26304347991943361,"text":"4 The newly installed giant mirrors","x":0.036956523540283184,"h":0.013081395367350201,"y":0.54796511619713884},{"x":0.060869578308910273,"w":0.26304346084594721,"y":0.56250000021289848,"h":0.011790483742206037,"text":"A make the town of Rjukan unique."},{"y":0.5770348837397874,"text":"B can wash and move themselves.","x":0.060869571299226093,"w":0.25434782028198244,"h":0.010193830738481569},{"text":"C give the town a new meeting place.","x":0.063043490434552471,"h":0.011795336893683506,"y":0.59140233731202263,"w":0.28260868072509765},{"y":0.6060100167130037,"x":0.06304348303942682,"w":0.23695652008056639,"h":0.011722541213632698,"text":"D aren't a completely new idea."},{"h":0.01308139536735009,"text":"4 Match the beginnings with the correct endings to","x":0.013043491448189037,"y":0.62645348829016212,"w":0.4065217208862304},{"text":"make extracts from the text.","x":0.036956533691370766,"h":0.011766218780874138,"w":0.21956520080566405,"y":0.64098837235437134},{"x":0.060682397342703712,"text":"...many Scandinavian towns suffer","y":0.65820424292283553,"w":0.25905092239379884,"h":0.014005451648183564},{"w":0.18913042068481445,"y":0.67732558148688038,"h":0.010174418530599527,"text":"1 The mirrors (...) adjust","x":0.036956526423897171},{"text":"O","x":0.43478260903531163,"y":0.67296511609029463,"w":0.023913042545318619,"h":0.015988372204100765},{"y":0.69323873118832768,"w":0.34999999999999998,"h":0.011703129005750545,"x":0.036956525239130331,"text":"2 They installed mirrors (...) to take advantage"},{"w":0.19130434036254884,"h":0.011831734932722715,"x":0.056521739673798151,"y":0.70909849755786714,"text":"...the town now benefits"},{"text":"4 Sam Eyde (...) was responsible","y":0.7252906979236543,"w":0.24782608032226563,"x":0.036956521958432485,"h":0.011771071534323996},{"h":0.015648704936388924,"y":0.7390156905557157,"x":0.038816956333080056,"text":"5 ... residents have had to cope","w":0.24620351791381836},{"h":0.013081394571294758,"w":0.25869564056396482,"x":0.036956524464394465,"y":0.76162790714749218,"text":"a of the sunlight that shone there."},{"text":"b from a 600-square-metre area of light...","x":0.039130438618907241,"y":0.77754590993718942,"h":0.013355592256396376,"w":0.31956520080566408},{"h":0.011703129005750545,"w":0.28043478012084966,"text":"c with a complete lack of sunlight...","x":0.036956527656966359,"y":0.79505813974778228},{"h":0.011739527044789866,"x":0.039130438643329872,"text":"d for building the town of Rjukan.","w":0.25652173995971678,"y":0.81093489134696273},{"text":"e to the best angle to catch the rays ...","w":0.29782608032226565,"x":0.036956520092490557,"h":0.011627906550947142,"y":0.827034884030728},{"text":"f from freezing cold temperatures in the winter ...","y":0.84302325578652837,"w":0.3782608413696289,"h":0.01308139536735009,"x":0.036956540565185422},{"text":"5","w":0.010869565010070803,"h":0.010174418530599527,"x":0.48478260888083413,"y":0.043604651326996757},{"x":0.50652174150671914,"text":"Complete the sentences with the combinations in","y":0.043405676072716615,"w":0.38913043975830075,"h":0.011826881781245357},{"x":0.50652174609286094,"text":"italics in Exercise 4.","y":0.058013355394724186,"w":0.15652173042297357,"h":0.010434056761268851},{"x":0.53478262031679891,"w":0.33260868072509764,"y":0.075542570869310821,"text":"The air pollution in this city means that many","h":0.013120219783114284},{"h":0.011720114836907713,"w":0.28043478012084955,"x":0.53260870157000983,"text":"residents suffer from serious allergies.","y":0.090116279282665968},{"text":"1","y":0.10465116290452969,"h":0.0087209297141964681,"x":0.50869565201866873,"w":0.015217391252517642},{"y":0.10465116300359623,"x":0.53260869892890395,"text":"People in this region have learned to","w":0.27608694076538087,"h":0.011792910516958632},{"x":0.53478261667060278,"h":0.0131177930083618,"y":0.11769616011546391,"text":"the destructive effects of tropical storms.","w":0.30434782028198248},{"y":0.13355592651578241,"w":0.24347826004028317,"text":"2 Every person on the planet is","x":0.50869564954507585,"h":0.011792910516958521},{"w":0.069148879051208478,"h":0.013500342584014557,"x":0.86438336142480554,"text":"reducing","y":0.13239569085220038},{"y":0.14680232575214336,"w":0.39565216064453124,"h":0.013081394571294758,"text":"global warming. We all need to change our behaviour.","x":0.5347826140980243},{"x":0.50869565346610701,"y":0.16277128547520581,"w":0.21086956024169923,"h":0.011686143572621099,"text":"3 It may take some time to"},{"x":0.83208341493109228,"y":0.16091652864339756,"w":0.072800993919372559,"h":0.012287896941221677,"text":"life in the"},{"h":0.013355592654423987,"w":0.38695652008056647,"text":"countryside after living in the city for so many years.","x":0.53478261436189056,"y":0.17570951580457184},{"w":0.21304347991943362,"h":0.013355593052451709,"text":"4 We invite hotel guests to","x":0.50869565489535562,"y":0.19031719515104717},{"x":0.83467852662661657,"h":0.012104218312615322,"y":0.19016882126267087,"w":0.058903818130493169,"text":"our free"},{"y":0.20277128963598612,"text":"airport bus service","w":0.13997202873229975,"h":0.01591752168531213,"x":0.53427672145614413},{"w":0.0173913037776946,"text":"5","h":0.011627906550947253,"x":0.50652173952419621,"y":0.21947674454429378},{"h":0.011741953421514628,"y":0.21947674435049547,"x":0.52826087770917352,"w":0.16521738052368162,"text":"The only people who"},{"y":0.21915728283414759,"w":0.10669397354125987,"text":"illegal logging","h":0.013720318152629862,"x":0.80643562086043341},{"y":0.23401162807142573,"w":0.20434782028198251,"text":"are the loggers themselves.","h":0.011814749101565436,"x":0.53478261500393609},{"text":"VOCABULARY PRACTICE | In the woods","x":0.48478262278066608,"y":0.25709515855008003,"h":0.011800190045160974,"w":0.33043476104736325},{"h":0.013083821744074964,"text":"6 Look at the vocabulary in lesson 5.4 in the Students'","w":0.43478260040283201,"x":0.48478261253771449,"y":0.27906976756341795},{"x":0.51086956800927197,"y":0.29505813955374105,"w":0.25652173995971683,"h":0.010174418530599416,"text":"Book. Choose the correct words."},{"text":"1 l was so thirsty that when I saw the fresh water","y":0.31250000014022405,"w":0.37173912048339841,"h":0.011790484140233759,"x":0.50869566179634418},{"text":"flowing from the spring \/ pond \/ clearing, 1 ran ano","h":0.013120219783114173,"x":0.53478261017114603,"y":0.32554257083902982,"w":0.3760869598388672},{"text":"quickly began to drink.","x":0.5347826158180834,"y":0.34140233723934821,"w":0.17173912048339846,"h":0.011795336893683506},{"x":0.50869565194620492,"y":0.35610465147042114,"w":0.015217391252517753,"text":"2","h":0.0087209297141964681},{"text":"The Grigson twins found a lovely little clearing \/ trail \/","w":0.41086956024169918,"h":0.013081394571294647,"x":0.52391304411828088,"y":0.35465116296144572},{"x":0.53478262285803735,"text":"path in the woods, so we decided to sit there and","w":0.36956520080566413,"y":0.36918604653072795,"h":0.011627906550947253},{"y":0.38355592644310799,"h":0.011792910516958632,"x":0.53478261142406958,"w":0.1021739101409912,"text":"have a picnic."},{"w":0.4065217208862304,"x":0.50869566637753683,"y":0.39816360600179324,"text":"3 It really is true that you can tell the age of a tree by","h":0.013355593052451598},{"h":0.011686143572621099,"text":"counting the rings in its branches \/ leaves \/ trunk.","w":0.36521739959716792,"x":0.53478259998402478,"y":0.41277128535408181},{"x":0.50869565430731312,"w":0.36956520080566413,"y":0.42732558150504896,"h":0.010174418530599527,"text":"4 Often a tree's leaves \/ roots \/ branches do not"},{"w":0.38695652008056647,"h":0.011812322724840563,"text":"actually reach deep underground. In fact, they grow","x":0.53478261436189056,"y":0.44186046525650324},{"h":0.011627906550947142,"text":"horizontally and usually only sixty centimetres below","w":0.38913043975830075,"x":0.53478261107193648,"y":0.45639534897743339},{"text":"the surface.","w":0.08923183441162108,"h":0.01057729577779376,"y":0.47072879394062561,"x":0.53473191036637402},{"text":"Don't get too close to that hedgehog \/ skunk \/","y":0.48539232041388969,"w":0.36304347991943353,"h":0.011700702629025672,"x":0.52173912355477614},{"y":0.49999999986332044,"text":"squirrel - it might get scared and spray you with its","w":0.38043476104736329,"h":0.011686143572621099,"x":0.53478261313573883},{"y":0.51293823073000677,"x":0.53478261325276688,"w":0.17391304016113285,"h":0.013355592256396376,"text":"horrible smelling scent."},{"x":0.51086956905368996,"text":"6 Most people know that foxes \/ squirrels \/ hedgehogs","y":0.52754590997520823,"h":0.013355592654423987,"w":0.41956520080566406},{"x":0.53695652481478917,"y":0.54215116339749203,"w":0.38695652008056636,"text":"are related to dogs. But not many people know that","h":0.013081394571294869},{"x":0.53695652964352814,"w":0.20217390060424789,"h":0.010174418530599416,"y":0.55668604648809183,"text":"over 10,000 live in London!"},{"y":0.57122093049390643,"w":0.40434780120849612,"h":0.011834161309447588,"text":"7 Cats might be cute but they are natural predators \/","x":0.51086957428705626},{"h":0.011824455006492762,"y":0.58555926562363203,"w":0.32826087951660154,"text":"prey \/ roots and hunt birds and mice for fun!","x":0.53695652004604699},{"text":"WORD STORE 5E | Verb phrases","w":0.2673913002014161,"y":0.60893155245495678,"h":0.013355592654424098,"x":0.48478261280690071},{"w":0.4067194747924805,"x":0.48467554516169853,"text":"7 Complete the text with the correct prepositions.","y":0.63077017467675378,"h":0.01353663713585751},{"text":"The last of our food had gone off and I was sure we","x":0.51304348238010578,"w":0.38478260040283196,"y":0.65552325596821448,"h":0.013091101272277306},{"x":0.51299881715575024,"h":0.010510864958341304,"text":"would die 1","y":0.66988991632136297,"w":0.084871931076049845},{"h":0.013355592256396376,"w":0.25652173995971672,"x":0.63913043116144597,"text":"hunger. Bradley and Cooper were","y":0.6698664442760649},{"y":0.68604651175359621,"h":0.011783204612031417,"w":0.3413043594360351,"text":"speaking, trying to decide what we should do","x":0.51304347586893884},{"h":0.013127498913288904,"text":"next. But I slept2","x":0.51304348255429022,"w":0.14565217018127441,"y":0.69908180285394772},{"y":0.70058139575553413,"x":0.66956522778962491,"w":0.23260868072509766,"h":0.011627906550947142,"text":"most of their discussion, too"},{"h":0.011802616421885737,"y":0.71494156946017695,"text":"exhausted to join in with them. One thing was sure,","w":0.38695652008056647,"x":0.51304348553942669},{"y":0.72819767443770478,"x":0.51304348687584023,"h":0.01178563098875629,"w":0.21521738052368167,"text":"we couldn't continue to sit 3"},{"h":0.010174418530599527,"text":"doing nothing.","x":0.76521739240632425,"y":0.73110465125432234,"w":0.11086956024169925},{"y":0.74415692836533742,"x":0.51086956982694298,"text":"just waiting to die. I was about to fall asleep again","w":0.3760869598388672,"h":0.013110513082131625},{"x":0.51304348081330664,"h":0.01043405676126874,"text":"when a noise awoke me. Cooper was close by,","y":0.76001669457767074,"w":0.35217391967773437},{"text":"searching 4-","h":0.013757739122801538,"x":0.51293724419824971,"y":0.77291764190822876,"w":0.09151681900024411},{"text":"_his bag. Then I heard another","w":0.22826086044311533,"x":0.63478260945235543,"y":0.77462437387762084,"h":0.011712835308705483},{"x":0.51304347369469694,"h":0.013127499311316626,"text":"noise - off to my left. I turned and suddenly found","y":0.78779069750164465,"w":0.3760869598388672},{"text":"myself face to face 5","x":0.51304348640482578,"y":0.8021702839514897,"w":0.16521738052368162,"h":0.013355592654424098},{"text":"what | believed to be a wild","w":0.22173912048339839,"x":0.70000000396119944,"y":0.80377907004493987,"h":0.011746806572992208},{"w":0.17826086044311529,"h":0.011819602253043016,"text":"dog. Slowly, I reached •","y":0.818313953773945,"x":0.51521739437989167},{"y":0.81831395348179337,"w":0.15869565010070807,"h":0.010174418530599527,"x":0.73043478523225458,"text":"a food tin which was"},{"text":"lying beside me, to throw it for the animal and gain","h":0.011627906550947142,"w":0.38260868072509768,"x":0.51304348955049461,"y":0.83284883736406135},{"x":0.51304348293860402,"h":0.013355592256396376,"y":0.84724540930710002,"w":0.39565216064453124,"text":"time to defend myself if it decided to attack me. But"},{"h":0.011627906550947142,"x":0.51304348165428293,"w":0.39347824096679684,"text":"at that moment the dog jumped at me and violently","y":0.86337209328460396},{"w":0.36304347991943364,"h":0.013081395367350201,"text":"began to lick my face! Then I heard a deep voice","y":0.87645348830833059,"x":0.5130434819696309},{"x":0.51521740421673312,"y":0.89232053420657054,"w":0.36956520080566413,"text":"calmly saying: 'Lilly, leave that man alone. I'm sure","h":0.011749232949717081},{"y":0.9055232559847014,"w":0.38913043975830075,"h":0.013091101272277306,"text":"he doesn't want to be kissed by an old dog like you!'","x":0.51304348204113925},{"h":0.011710408533952887,"w":0.34782608032226559,"text":"And then I burst into laughter. We were saved!","x":0.51304348505625852,"y":0.92151162803266606},{"h":0.01308139536735009,"text":"65","w":0.026086955070495632,"x":0.9000000005392863,"y":0.96366279076109251}]
[{"w":0.041484713554382324,"y":0.0072674423065782756,"h":0.020348836656223224,"text":"4.9","x":0.019650656305050463},{"x":0.10480349176063658,"w":0.27729257583618161,"y":0.0058139538744580443,"h":0.018895348210386298,"text":"EXAM SPEAKING"},{"text":"STUDENT A","x":0.75974690917387244,"h":0.020974622997559811,"y":0.005501060526787116,"w":0.18137954711914073},{"w":0.3951964950561524,"x":0.013100446380220702,"text":"Student A, look below. Student B, go to page 137.","y":0.071072319205896073,"h":0.013300083125519557},{"h":0.013300083125519557,"text":"1 In pairs, ask and answer the questions.","y":0.10307564418617177,"w":0.32314411163330076,"x":0.013100437305620218},{"text":"Talk about travel.","x":0.034934502019592806,"y":0.12500000016249457,"w":0.13973798751831054,"h":0.010174418328111612},{"x":0.034934504338444479,"h":0.011753561887162367,"text":"1 Describe your journey to school.","w":0.26637554168701172,"y":0.13953488382232804},{"text":"2 Have you ever got stuck in a long traffic jam?","x":0.034934509982579555,"y":0.15406976743424661,"w":0.36026199340820309,"h":0.011765644140077081},{"text":"What happened?","w":0.13100436210632327,"x":0.058951969056008621,"h":0.011777726392991794,"y":0.16860465115517687},{"y":0.18162926009149838,"w":0.38209606170654298,"h":0.013300083125519557,"text":"3 Would you prefer to work as a travel agent, tour","x":0.034934506674020975},{"text":"leader or travel guide? Why?","w":0.21615720748901368,"x":0.0589519666430477,"h":0.011801890502447732,"y":0.19767441859703738},{"h":0.013300083125519557,"w":0.6266375350952148,"x":0.013100451648171188,"text":"2 Discuss this question together. 'Should we all be vegetarian?' What do you think?","y":0.22527015798275207},{"w":0.12735276222229003,"x":0.062912763774555638,"y":0.25857658001081507,"h":0.014494937950635389,"text":"For vegetarians:"},{"text":"Eating a vegetarian diet ...","y":0.28343023265953737,"h":0.011665361678709352,"x":0.063318782321642175,"w":0.21179039001464844},{"x":0.061135369346931971,"text":"• is healthier than eating meat.","w":0.24235807418823241,"y":0.30087209317310326,"h":0.011679860223657523},{"text":"• is better because we don't have to kill animals to make our food.","h":0.011691942476572237,"y":0.31540697674868468,"x":0.061135393484128074,"w":0.50873359680175778},{"h":0.021802325102060038,"x":0.063318786013087588,"w":0.24454147338867188,"text":"• isbetter for the environment.","y":0.32994186054126651},{"y":0.3444767443237815,"h":0.011716106982401664,"x":0.074235808249787608,"text":"is delicious!","w":0.10043667793273926},{"y":0.13953488371278167,"w":0.30786026000976563,"h":0.013081395219785463,"text":"4 What places would you like to visit on","x":0.51310044075930927},{"x":0.53711790538533966,"h":0.013081395219785463,"w":0.22270742416381828,"text":"a round-the-world trip? Why?","y":0.15406976772440961},{"w":0.3384279251098633,"x":0.51310045215576694,"text":"5 When was the last time you missed a bus,","y":0.16860465126418855,"h":0.011777725996618305},{"h":0.013081395219785463,"text":"train or a plane? What happened?","w":0.25764190673828125,"y":0.1831395349724716,"x":0.53711790696564843},{"text":"3 Look at these two meals. What can you see in the photos? Which would you prefer to eat? Why?","y":0.38944305916317745,"w":0.75764190673828125,"h":0.013300082729146179,"x":0.010917025269869924},{"y":0.65253532818014581,"w":0.52183403015136709,"h":0.013300083125519557,"x":0.013100458696150277,"text":"4 Read the instructions on your card and role-play the conversation."},{"w":0.085152835845947267,"text":"Student A:","x":0.063318780002790509,"y":0.68604651174195186,"h":0.010174418328111612},{"h":0.013081395219785463,"w":0.54585151672363286,"text":"You are in a restaurant. Order your food from the waiter (Student B).","x":0.063318788581414931,"y":0.70930232557324679},{"h":0.013300083125519557,"w":0.40829692840576171,"text":"• Get the waiter's attention and ask if you can order.","x":0.061135385396827786,"y":0.7281795510795338},{"text":"• Ask politely what the soup is.","x":0.063318780988206133,"w":0.24672489166259765,"h":0.011637572734829571,"y":0.74272651711447546},{"text":"• Say you're vegetarian and ask if he\/she has any vegetarian dishes.","y":0.75726744191341333,"w":0.51965065002441413,"h":0.011643613861286983,"x":0.061135382338593301},{"w":0.20087335586547855,"text":"• Ask politely if it's spicy.","x":0.061135371121118179,"y":0.77180232568279317,"h":0.011655696114201586},{"x":0.063318778694892469,"y":0.7847049045186747,"text":"• Ask politely if it comes with anything else on the side.","w":0.4301309967041016,"h":0.013300083125519446},{"x":0.063318785487239071,"w":0.17248907089233398,"h":0.011679860223657523,"y":0.80087209305197926,"text":"• Say you'll have that."},{"h":0.014534882872875632,"x":0.9061135366003128,"y":0.96220930256792259,"text":"57","w":0.026200873851776163}]
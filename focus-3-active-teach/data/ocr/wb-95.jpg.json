"y":0.88662790718086071,"h":0.013081394686243919,"text":"finding that very hard with Edward Lowell's The Paper Plant. This novel"},{"y":0.90248962686677703,"text":"is 8","x":0.50328227557164107,"w":0.024070022106170708,"h":0.013278007903039679},{"text":"(BASE) on the real life of a nineteenth century factory","x":0.6039387416512586,"h":0.011700279584069384,"y":0.90116279091948615,"w":0.31291027069091804},{"y":0.91569767425244175,"x":0.50547046807425933,"w":0.40481399536132812,"h":0.013081395477674729,"text":"owner and seems an inappropriate subject for a book of any kind. What"},{"h":0.011778683484342523,"text":"was Lowell thinking?'","x":0.5054704644129312,"y":0.93153526956419463,"w":0.1269146537780762},{"text":"93","x":0.89934354551215945,"h":0.015988371283186864,"w":0.030634572505950919,"y":0.96656976778621662}]
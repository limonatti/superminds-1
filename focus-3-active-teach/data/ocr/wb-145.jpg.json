09,"x":0.24183006936318052,"y":0.443313953461276,"w":0.1416121959686279},{"text":"Wh-questions","w":0.091503267288208012,"x":0.0283224415737609,"y":0.47383720940491725,"h":0.010174418290456178},{"x":0.091503267665633381,"h":0.0087209296226502531,"text":"have","y":0.49709302360921748,"w":0.037037036418914815},{"text":"1\/you\/we\/they","x":0.16109660762717518,"y":0.49661186442111938,"w":0.098286085128784201,"h":0.0125902247428894},{"text":"What","w":0.03921568632125854,"x":0.028322439573575532,"y":0.50872093061018653,"h":0.008720929622650142},{"w":0.052287578582763672,"h":0.010174418290456178,"text":"learnt?","y":0.50872093031698118,"x":0.31372549227724561},{"y":0.52034883731189396,"w":0.026143789291381836,"h":0.010174418290456178,"x":0.093681918317272045,"text":"has"},{"text":"he\/she\/it","h":0.008720929622650142,"w":0.06535947322845459,"x":0.16122004661017353,"y":0.52180232583789976},{"x":0.028322441946608379,"h":0.01041666666666663,"y":0.54499999990158376,"w":0.11328975677490236,"text":"Subject questions"},{"h":0.008720929622650142,"x":0.028322441164372415,"w":0.034858386516571048,"text":"Who","y":0.5683139537569889},{"w":0.18954248428344728,"h":0.010174418290456066,"text":"has studied French before?","y":0.56831395357279524,"x":0.093681920058711968},{"x":0.019607849313447511,"y":0.59583333349137124,"w":0.29629629135131835,"text":"Spelling rules - the past participle form","h":0.013333332935968945},{"y":0.61041666665768879,"w":0.095860567092895504,"h":0.011676356395085685,"text":"Regular verbs","x":0.019607841290153603},{"h":0.013333333333333308,"w":0.35947711944580074,"text":"• general rule: infinitive + -ed, e.g. work - worked","x":0.019607841911086582,"y":0.62625000000664044},{"h":0.013333332935969056,"text":"• verbs ending in -e: + -d, e.g. like - liked","w":0.30283224105834966,"x":0.019607848397840365,"y":0.64375000029728024},{"text":"• verbs ending in a consonant + -y: y + -ied, e.g. cry - cried","x":0.019607860798515162,"y":0.66125000002098977,"w":0.43137252807617188,"h":0.011715116103490186},{"x":0.019607858233347278,"w":0.4291938781738282,"y":0.67875000013592213,"text":"• one-syllable verbs ending in a single vowel + consonant*:","h":0.011666666666666603},{"h":0.013333333333333419,"x":0.034858382797354356,"y":0.69166666685117373,"text":"the consonant is doubled + -ed, e.g. stop - stopped","w":0.37690631866455071},{"h":0.013081394831339521,"y":0.7078488372500279,"text":"*except -x and -w, e.g. boxed, flowed","w":0.27233114242553713,"x":0.034858389462612854},{"h":0.011792635917663552,"x":0.019607839829327674,"text":"• two-syllable verbs ending in a vowel + consonant:","w":0.3725490188598633,"y":0.72529069756738052},{"w":0.42047927856445311,"text":"the consonant is doubled when the stress is on the second","y":0.73982558160695211,"x":0.034858394677468568,"h":0.010174418290456178},{"y":0.75290697722095823,"w":0.20261436462402344,"h":0.013081394831339521,"x":0.034858393686535899,"text":"syllable, e.g. refer - referred"},{"w":0.38779956817626954,"h":0.013081394831339521,"x":0.019607846703440898,"y":0.77034883768607443,"text":"• travel: although the stress is on the first syllable, -\/ is"},{"w":0.22004356384277346,"text":"doubled, e.g. travel - travelled","y":0.78333333320915988,"x":0.037037043808460728,"h":0.011724806229273521},{"y":0.80069551313459453,"text":"Irregular verbs","w":0.100308837890625,"x":0.01956235498392541,"h":0.01198106686274214},{"y":0.81666666666948784,"h":0.013333333333333308,"x":0.021786499531678095,"text":"Many verbs have an irregular past participle form","w":0.35076251983642576},{"w":0.4291938781738282,"x":0.019607858233347278,"h":0.011773255666096993,"y":0.83125000008047589,"text":"(e.g. write, go, lose). A list of irregular verbs can be found in"},{"w":0.2352941131591797,"h":0.013081394831339521,"text":"the Students' Book on page 152.","y":0.84447674446902021,"x":0.021786498540235719},{"w":0.38997821807861327,"h":0.013081395228703774,"text":"Pay attention to how we use the past participle for go,","y":0.86191860493413652,"x":0.02178649658887032},{"x":0.019607845915468155,"y":0.87499999981544263,"w":0.14161219596862792,"text":"i.e. been and gone:","h":0.011666666666666714},{"w":0.4186623764038086,"h":0.015696754455566397,"y":0.88615960220612311,"x":0.023796159795037682,"text":"Monica has been to the USA. (Sometime in the past, she is"},{"y":0.90249999999990715,"h":0.01041666666666663,"x":0.02178649505558056,"w":0.10457515716552734,"text":"not there now)"},{"w":0.3790849685668945,"h":0.01169573624928788,"y":0.91708333342170367,"text":"Monica has gone to the USA. (She is there right now)","x":0.02396514477973348},{"y":0.0070833336753642895,"text":"FOCUS 2 GRAMMAR REVIEW","w":0.44008712768554692,"h":0.020532944997151636,"x":0.51198258309155587},{"y":0.063953488438347472,"h":0.010174418290456178,"w":0.013071894645690918,"x":0.48583878050939849,"text":"1"},{"y":0.063749999745012609,"x":0.50326796690917197,"text":"Complete the sentences and questions with the","h":0.013333333730697672,"w":0.38126361846923817},{"y":0.078333333365545377,"text":"correct forms of the verbs in brackets. Use the","x":0.50980391683970627,"h":0.011782945791880217,"w":0.36601306915283194},{"x":0.51198256651854679,"w":0.36383441925048832,"text":"Present Simple, the Present Continuous or the","h":0.013333333333333308,"y":0.092916666855248797},{"h":0.01041666666666663,"x":0.5119825721778487,"w":0.12636165618896489,"text":"Present Perfect.","y":0.10750000011120586},{"text":"Hi Clara, I'm driving (drive). Can I call you back later?","h":0.013081394831339521,"w":0.39215686798095695,"x":0.53812636230581778,"y":0.12500000017396196},{"y":0.13940026396534178,"w":0.087215890884399405,"text":"1 Graham","x":0.5097689617476362,"h":0.010443658034006709},{"h":0.011715116500854439,"x":0.68627451210136992,"y":0.13953488358482247,"w":0.24618736267089847,"text":"(not\/clean) the bathroom for two"},{"w":0.39433551788330079,"h":0.011734496355056745,"text":"weeks now, so he really needs to do it this weekend.","x":0.53594770870540842,"y":0.15541666662019837},{"y":0.16860465109935729,"x":0.50980392175285261,"text":"2","h":0.011627906958262102,"w":0.01525054454803465},{"w":0.19172113418579106,"text":"Every September, Helen","x":0.527233114388586,"y":0.16860465163956273,"h":0.013081394831339521},{"text":"(order) all the","x":0.80388759254150566,"w":0.10682176589965831,"y":0.16846458284599242,"h":0.011908043225606346},{"h":0.011627906958262102,"w":0.2483660125732422,"x":0.53594771577220246,"text":"stuff she needs for school online.","y":0.18313953489296197},{"text":"3","w":0.017429193258285514,"x":0.50762527252118406,"h":0.011627906958262102,"y":0.19767441849761314},{"text":"What","h":0.011627906958262213,"x":0.53159041323766942,"w":0.047930283546447794,"y":0.19767441846854328},{"x":0.66666667126354739,"text":"(wait) for? The washing-up isn't","w":0.2352941131591797,"h":0.013333333730697561,"y":0.19749999970554089},{"text":"going to do itself, you know.","h":0.014660852750142395,"w":0.21350761413574226,"y":0.21075581382213271,"x":0.53594771856756818},{"text":"4","x":0.51198257135907166,"y":0.22674418627879123,"w":0.013071894645690918,"h":0.008720929622650142},{"x":0.51198257135907166,"y":0.24127906999972148,"h":0.008720929622650142,"w":0.013071894645690918,"text":"5"},{"x":0.6318082868745093,"y":0.22666666660260637,"w":0.28322439193725579,"h":0.011705426375071215,"text":"(never\/live) in a house with a balcony."},{"text":"(you\/really enjoy) tidying up? If so, you","y":0.23982558174848934,"w":0.28758169174194337,"h":0.014534883499145446,"x":0.62527233699032092},{"w":0.25925924301147463,"h":0.013081394831339521,"x":0.5359477229750178,"text":"can do my room any time you like!","y":0.25581395396514417},{"y":0.27616279063424098,"w":0.01525054454803465,"h":0.011627906958262213,"text":"2","x":0.4836601309031795},{"x":0.51198258683413955,"y":0.27616279064877591,"h":0.011753876209259051,"w":0.42265792846679684,"text":"Complete the text with the correct forms of the verbs"},{"text":"
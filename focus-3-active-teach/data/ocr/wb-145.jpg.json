[{"h":0.014718991915384949,"text":"Present tenses - review","y":0.069583333506668454,"w":0.2352941131591797,"x":0.019607847341978745},{"text":"We use the Present Perfect to talk about actions and events","x":0.019607858390724858,"h":0.011734495957692492,"y":0.092916666787426938,"w":0.43572982788085934},{"w":0.35511981964111328,"y":0.10750000005419236,"h":0.011686046520868909,"text":"which started in the past and continue up to now:","x":0.019607841731731027},{"text":"We've had this TV for three years.","x":0.021786497651861705,"y":0.12063953511824499,"w":0.24183006286621095,"h":0.013110464811325051},{"w":0.38779956817626948,"x":0.01960784575935964,"text":"When describing actions which started in the past and","y":0.13791666686620785,"h":0.013333332935969056},{"x":0.019607837415707756,"h":0.011744186083475827,"text":"continue into the present, we often use since and for:","w":0.38126361846923829,"y":0.15250000002646924},{"x":0.017304641821096603,"w":0.35975761413574214,"y":0.16784006459643008,"h":0.014075293540954603,"text":"• since describes when the action or state began:"},{"text":"since 2012\/Sunday\/last month\/my birthday\/l moved here","x":0.034858408422071212,"y":0.18313953484451229,"w":0.40958602905273439,"h":0.011627906958262213},{"text":"• for describes how long the action or state has continued:","w":0.42483657836914057,"x":0.019607848106642685,"h":0.013081394831339521,"y":0.19912790701746974},{"y":0.21366279089586127,"w":0.40522876739501951,"h":0.013081394831339521,"text":"for five minutes\/a week\/a long time\/ages\/most of my life","x":0.034858386563928041},{"text":"Affirmative","w":0.072252192497253426,"x":0.028144057156731676,"h":0.010137824217478442,"y":0.24202411112851252},{"h":0.010174418290456178,"w":0.058823528289794924,"x":0.24183006665575613,"text":"Negative","y":0.24418604657788245},{"w":0.034858386516571041,"x":0.030501090401845187,"y":0.265988372195615,"h":0.010174418290456066,"text":"I\/You"},{"text":"We","y":0.27906976742938427,"h":0.0101
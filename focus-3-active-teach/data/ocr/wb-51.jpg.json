[{"h":0.0087209299740247381,"x":0.015250544897203712,"y":0.1351744186757784,"text":"1","w":0.010893245935440065},{"h":0.01178402626742725,"y":0.30087209352175437,"text":"Extract from Students' Book recording","w":0.24183006286621095,"x":0.065359482328695429},{"h":0.010174418567717836,"x":0.31154684031827939,"text":"4) 2.8","w":0.047930283546447794,"y":0.30087209311439689},{"w":0.38997821807861327,"text":"S1: I'm interested in having a natural diet, and so for","y":0.3212209304791187,"x":0.034858389413852324,"h":0.011834856473238231},{"y":0.33430232555727213,"w":0.37690631866455077,"h":0.013081394961037107,"x":0.063180828140491488,"text":"the last two years, l've only 'eaten \/ cooked \/ used"},{"w":0.37690631866455077,"h":0.013081394961037107,"x":0.063180829738167507,"y":0.34883720927820239,"text":"raw food. I believe that when you 2cook \/ eat \/ buy"},{"w":0.37037036895751951,"text":"fresh food, you lose the goodness and vitamins in","y":0.36337209305363838,"x":0.065359474181371058,"h":0.013081394961037107},{"y":0.3779069767200629,"text":"[the food]. I eat raw vegetables [...], but of course I","w":0.37908496856689455,"x":0.063180822107257339,"h":0.013081394961037107},{"y":0.39383846805930456,"h":0.011684787362739479,"x":0.065359481223663071,"text":"also need protein. [...] So [...] | eat raw eggs. [...]|","w":0.37254901885986325},{"w":0.38126361846923834,"x":0.063180822165163131,"h":0.01308986686052227,"y":0.40697674439811515,"text":"feel healthy and | 3feel \/ have \/ need lots of energy,"},{"w":0.37472766876220703,"h":0.013322231473771762,"text":"but [...] it's difficult to 4stay \/ live \/ eat with the rest","y":0.4213155704283249,"x":0.065359477456224016},{"w":0.26361654281616209,"h":0.013322231473771762,"text":"of my family, [and that's a problem].","y":0.43588676110544555,"x":0.065359481287997456},{"x":0.034858392220012038,"y":0.45045795183707182,"w":0.37690631866455077,"text":"S4: I'm a vegan. [....] That means that I don't eat or","h":0.013322231473771873},{"w":0.33769062042236325,"h":0.013322231870805279,"y":0.46502914228067638,"x":0.065359487038273587,"text":"Slike \/ use \/ make any animal products for any"},{"y":0.47960033288053094,"h":0.013322231473771873,"x":0.065359476606458702,"w":0.35511981964111333,"text":"purpose. I don't eat meat, fish, dairy or anything"},{"w":0.35076251983642581,"h":0.010188941256787598,"y":0.4941715237683505,"text":"that comes from animals. I don't wear \/ make \/","x":0.065359484330153067},{"y":0.50872093068260704,"text":"sell clothes made from animals either. [...] When","w":0.35511981964111328,"h":0.011678736176121585,"x":0.065359483180532613},{"y":0.52164862637005605,"h":0.013322231076738467,"w":0.36165576934814453,"x":0.063180823967903241,"text":"1 was a child, I ate meat and drank milk like most"},{"y":0.53779069806632795,"x":0.065359474835348763,"text":"people. But then when I was 13, I started thinking","h":0.011751350415537098,"w":0.36601306915283205},{"y":0.55079100745106369,"text":"about where my food came from. I learnt about","x":0.065359486372445125,"h":0.013322231473771873,"w":0.35294116973876954},{"x":0.065359483115073683,"w":0.37690631866455082,"text":"how animals suffer and I was shocked. I decided to","h":0.011672685386536985,"y":0.56536219802969312},{"h":0.01308986686052227,"x":0.063180831696753259,"w":0.38126361846923829,"text":"'eat \/ become \/ cook a vegan. [| ®eat \/ respect \/ kill","y":0.57993338866868815},{"text":"animals and I don't want them to suffer].","h":0.013081394961037107,"w":0.29847494125366214,"x":0.065359482123713591,"y":0.59447674421642915},{"y":0.62936046534830481,"w":0.39433551788330085,"text":"Complete gaps 1-4 in the diagrams with the verbs","x":0.039215688253338606,"h":0.011771924291224756},{"h":0.010174418567717836,"x":0.039215684149648773,"y":0.64389534891018185,"w":0.3594771194458008,"text":"from the box. There are two extra verbs. Then"},{"w":0.39869277954101562,"h":0.013105599707509019,"text":"complete gaps a-d with the underlined wor
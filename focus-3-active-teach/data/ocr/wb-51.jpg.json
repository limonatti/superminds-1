,"h":0.01113332578482773,"x":0.51394090124021574},{"w":0.13804710388183594,"text":"meat \/ vegetables","h":0.015299205478283895,"x":0.73819468430710411,"y":0.23351531486450283},{"h":0.0087209299740247381,"y":0.25000000005659229,"x":0.73856209428616182,"w":0.15032679557800288,"text":"out \/ in a restaurant"},{"y":0.26453488407834769,"w":0.067538123130798433,"text":"healthily","h":0.013081394961037107,"x":0.73638344467098416},{"y":0.52592380127338878,"w":0.29043018341064453,"text":"Aceyourexams.com","h":0.023132151112171262,"x":0.55735272622437459},{"text":"Eat well, perform well - today Emma Peel tells","x":0.5098039228722665,"y":0.55813953500494651,"h":0.013081394961037107,"w":0.39215686798095706},{"h":0.014518386815410178,"text":"us about the relationship between diet and study","w":0.39247005462646478,"x":0.50965785432662747,"y":0.57422408111743961},{"x":0.50980392693287302,"y":0.59866777673030658,"w":0.35947711944580074,"h":0.011797339592646949,"text":"Are your exams coming up soon? Are you studying"},{"text":"hard and feeling stressed? In order to do your best, you","y":0.61482558173638602,"w":0.39433551788330079,"h":0.011735617171517054,"x":0.50762526445159595},{"text":"need to think carefully about what you eat. A healthy","h":0.011717464008696554,"x":0.50762526575850186,"y":0.63072439620016929,"w":0.37690631866455082},{"text":"diet means a b","x":0.50980392429954957,"y":0.64529558704259571,"w":0.11328975677490227,"h":0.010407993338884203},{"x":0.68627451773585901,"y":0.6468023258134209,"w":0.215686264038086,"text":"d diet, so living off mostly light","h":0.011815492755467449},{"text":"snacks or 2c","w":0.089776430130004914,"h":0.013275273932108367,"x":0.50957801654634405,"y":0.6605135254682436},{"x":0.65795207524560329,"text":"d snacks like sandwiches is not","w":0.22875816345214839,"y":0.66133720980082411,"h":0.01162790636734401},{"y":0.67732558179694824,"h":0.011683577204822604,"x":0.50762526575850186,"w":0.37690631866455082,"text":"recommended. To stay energised, try to eat plenty of"},{"w":0.021786491870880109,"x":0.50544662352715974,"y":0.69331395334758916,"text":"30","h":0.011627907161410822},{"h":0.011769503578357599,"text":"c food if possible and avoid too much","w":0.27233114242553713,"x":0.5860566555483061,"y":0.69317235653360898},{"x":0.50980392250419404,"w":0.36601306915283194,"y":0.70930232569229701,"h":0.011763452788772999,"text":"processed or fast food. You don't need to change to"},{"w":0.27668844223022471,"h":0.01168962839144061,"text":"n diet but it might be a good idea to","x":0.57952069802069028,"y":0.72522897600347169},{"h":0.01162790636734401,"text":"reduce the amount of meat you eat. Avoid 5h","w":0.3180827713012695,"x":0.50762528221428882,"y":0.74127907021749073},{"text":"meals in the evenings, especially if you are going to sit","w":0.38779956817626948,"h":0.011675105702370847,"y":0.75726744207795593,"x":0.50980392349356451},{"text":"at your desk and study until late. If you get hungry","y":0.77310574534148813,"w":0.35511981964111328,"h":0.011777975477842761,"x":0.50980392710754785},{"y":0.78767693593987809,"text":"while revising, choose a h","w":0.1938997840881348,"h":0.011741668358134949,"x":0.50762527458628837},{"y":0.78924418649656058,"x":0.75816993389936471,"w":0.12200435638427731,"h":0.011754980889287836,"text":"y snack such as"},{"x":0.50980392691070353,"text":"fruit, low-fat yoghurt or some nuts rather than crisps","y":0.80377907001400251,"h":0.011791288008995537,"w":0.36383441925048821},{"x":0.50980392336578706,"y":0.8183139536477233,"w":0.11982570648193358,"text":"or sweets. Eat 7f","h":0.01182759512870335},{"x":0.67973855788331117,"w":0.1938997840881348,"h":0.010174418567717836,"y":0.82122093032369925,"text":"g food such as chocolate,"},{"text":"chips, pizzas and burgers only occasionally, perhaps","x":0.50980392755951809,"h":0.011830015444537101,"y":0.83555370513254579,"w":0.37690631866455082},{"w":0.35947711944580074,"y":0.85174418629307214,"h":0.011702940922593386,"text":"as a reward for a hard-working week rather than as","x":0.50980392753200154},{"h":0.011750140257620223,"text":"part of your daily diet. And remember, just because","y":0.86761032474775734,"w":0.36383441925048821,"x":0.50980391916923684},{"x":0.50762528352959857,"h":0.011782816109510486,"text":"you don't have time to prepare and enjoy a full","w":0.32897602081298838,"y":0.88372093073105673},{"w":0.023965141773223952,"x":0.50762527249029443,"text":"8t","y":0.89825581422911882,"h":0.01162790636734401},{"text":"e meal does not mean you","x":0.64923746818994599,"y":0.90116279092384022,"w":0.19607843399047853,"h":0.0089121464388653981},{"x":0.50980392248114836,"w":0.095860567092895588,"y":0.91423813470878668,"h":0.010180469754335841,"text":"can't eat well."},{"text":"49","x":0.90413943371468408,"y":0.96366279096424889,"w":0.028322439193725568,"h":0.013081394961037107}]
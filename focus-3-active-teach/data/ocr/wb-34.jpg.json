:0.80680767527028741,"w":0.25746467590332034,"h":0.015123661114313847,"x":0.71663753447626422,"text":"stuck in traffic and that's why we're"},{"w":0.084967317581176705,"text":"a little late.","x":0.5882352950583587,"y":0.82264779365324703,"h":0.011656952539550458},{"h":0.0087209299740247381,"w":0.010893245935440055,"text":"3","x":0.56427015276757397,"y":0.83866279075426664},{"h":0.013081394961037107,"w":0.34422657012939462,"text":"My school bag was so heavy this morning that","x":0.5882352987406767,"y":0.83720930230145807},{"text":"_a lift in the car from my mum.","x":0.68175955404928312,"w":0.23771558761596689,"h":0.01387088245198087,"y":0.85103922344727023},{"text":"4","y":0.86773255818159212,"w":0.010893245935440055,"h":0.0087209299740247381,"x":0.56427015252247603},{"w":0.045751633644103951,"text":"Janet","x":0.58823529505158634,"y":0.86773255822035211,"h":0.0087209299740247381},{"x":0.73420479233108571,"y":0.86761032484823342,"text":"the train and there isn't another","w":0.23529411315917959,"h":0.0088431634672675452},{"x":0.58812392990265694,"w":0.38152172088623049,"h":0.0155606924941597,"y":0.87864866611536818,"text":"one until tomorrow morning. She'll have to stay the"},{"h":0.011811862281716823,"x":0.58823529582058998,"y":0.89534883732020387,"w":0.11764705657958985,"text":"night in a hotel."},{"y":0.91133720934438311,"h":0.0087209299740247381,"text":"5","w":0.010893245935440055,"x":0.56427015252247603},{"h":0.013097128205057262,"text":"Before bridges existed, the only way to","y":0.90988372114835725,"w":0.29193899154663083,"x":0.58823529238935723},{"text":"a valley was to climb down one side and then","w":0.3376906204223632,"h":0.011816702913384325,"x":0.58823529418242804,"y":0.92422980850672176},{"h":0.013322231870805279,"text":"climb up the other.","x":0.58823529580089751,"w":0.14379084587097168,"y":0.93880099896065039}]
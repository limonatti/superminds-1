0125732422,"x":0.093681914846276582,"text":"The longest journey made by a","y":0.79505813951076043},{"text":"is","y":0.79651162797994923,"h":0.010174418567717836,"x":0.45098039225974618,"w":0.017429193258285514},{"y":0.8095930235023745,"x":0.10675381393980458,"text":"7,455 metres. It's in China and goes from Zhangjiajie","w":0.392156867980957,"h":0.0118058106980653},{"x":0.10675380716975169,"h":0.013108020420376176,"y":0.82264779341188665,"text":"city centre to the top of Heaven's Gate Mountain.","w":0.37037036895751951},{"y":0.83720930273750482,"w":0.17647058486938477,"text":"4 If more people used","x":0.082788672815852282,"h":0.013081394961037107},{"w":0.1111111068725586,"h":0.010174418567717836,"x":0.37037037110075777,"text":"like buses and","y":0.83720930239855385},{"y":0.8482992867337088,"w":0.37293678283691412,"h":0.016712658808292868,"text":"trams, there'd be less traffic on the roads and less","x":0.10655567544749868},{"text":"pollution in the air.","x":0.10627131182674379,"h":0.014527079465486592,"y":0.86356875270772571,"w":0.14238186836242675},{"w":0.18300653457641602,"y":0.87926727745122468,"h":0.011721094482447292,"text":"5 Sorry we're late. It's a","x":0.082788671001552391},{"h":0.010407993338884203,"text":"and there are","y":0.87926727736217014,"w":0.10239650726318356,"x":0.3725490243368178},{"x":0.1065765032732784,"h":0.013166855614350159,"text":"always awfulb","w":0.10710843086242676,"y":0.89167238628808865},{"w":0.15250544548034667,"x":0.30936819345445266,"text":"_at this time of day.","y":0.89244186044099316,"h":0.013081394961037107},{"text":"6 There's a wonderful","x":0.082788671937513381,"y":0.90697674426507524,"w":0.17211328506469725,"h":0.010175628725634711},{"x":0.36601307459537835,"w":0.14379084587097168,"y":0.90549542056960775,"h":0.013109230181259757,"text":"through the forest."},{"text":"It turns left and right and then left and right again","x":0.10457515719478636,"y":0.92005813988803342,"w":0.37472766876220698,"h":0.011665423644968698},{
9437255862,"x":0.50759220181588982,"text":"throwing yourself down after it. The first person to","y":0.61918604662454746},{"text":"the bottom of the hill wins the 3","y":0.63221757309701898,"h":0.011715481171548081,"x":0.50759219902896713,"w":0.26247287750244142},{"y":0.63662790711281336,"x":0.88937093352752017,"text":"- a","w":0.028199565410613969,"h":0.0087209302511175313},{"x":0.50759219403574773,"h":0.011766566192754735,"y":0.64811715473312081,"text":"large 'wheel' of Gloucester cheese!","w":0.28416484832763678},{"y":0.67280334698299371,"w":0.40780910491943356,"text":"Chris Anderson, 29, from nearby Brockworth is","x":0.50976138604353727,"h":0.013389121737939047},{"w":0.40780910491943367,"h":0.011715481171548192,"x":0.50976139521924191,"text":"the current champion and has now equalled the","y":0.68744769880726631},{"y":0.70203488376889189,"w":0.41214748382568367,"h":0.011772647761899568,"text":"record of 20 wins held by one person. Chris first","x":0.5075922068398695},{"x":0.50759219080672091,"y":0.71366279058377902,"w":0.013015184402465851,"h":0.010174418493294812,"text":"4"},{"x":0.6355748390954008,"y":0.716569767635171,"w":0.28416484832763678,"h":0.011627906735472093,"text":"in for the competition at the age of"},{"h":0.011770214894825437,"w":0.40997829437255862,"text":"16 and won his first race one year later. Next year","x":0.50976139921285291,"y":0.73096234303686414},{"w":0.40997829437255862,"h":0.011715481171548081,"text":"he hopes to break the record and become the first","x":0.50976139139831955,"y":0.74560669443690719},{"x":0.51193059106283767,"h":0.011792108304330973,"y":0.76017441872528713,"w":0.18872016906738287,"text":"person to win 21 races."},{"y":0.77868023297993927,"text":"If you fancy 5.","w":0.10219420433044435,"h":0.0153139521387331,"x":0.51180962375246664},{"w":0.20449577331542967,"text":"Chris on at cheese rolling,","h":0.01463309252112488,"x":0.7155835052905356,"y":0.77920725970396243},{"h":0.013160454977506397,"y":0.79497907967701598,"x":0.50976139521924191,"w":0.40780910491943367,"text":"you'd better be quick - he is thinking of retiring"},{"y":0.80959302330377558,"w":0.40997829437255862,"text":"soon. Plus, you should also know that Cooper's Hill","h":0.011745889017272693,"x":0.50976140023779859},{"y":0.82412790702470584,"w":0.40997829437255862,"text":"has an angle of 70 degrees and the cheeses travel","h":0.011627906735472093,"x":0.50976140023779859},{"text":"downhill at over 110 kilometres per hour!","x":0.50976139928972808,"y":0.83849372366065222,"h":0.011796974038479235,"w":0.32754878997802739},{"h":0.011627906735472093,"text":"\/5","w":0.021691973209381099,"x":0.43383947994628558,"y":0.87936046535319423},{"x":0.80694143206274727,"y":0.93459302330377558,"w":0.052060737609863295,"h":0.011627906735472093,"text":"Total"},{"text":"15","y":0.9069767443171346,"w":0.023861169815063477,"h":0.013081394977649374,"x":0.91106290779854204},{"text":"120","h":0.013081394977649374,"x":0.89154013045631131,"y":0.93459302349591356,"w":0.036876354217529328},{"text":"31","x":0.90455531428773195,"y":0.96220930238392499,"w":0.023861172199249325,"h":0.011627906735472093}]
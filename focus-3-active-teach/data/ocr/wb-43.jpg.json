[{"h":0.010407993338884314,"x":0.017429195706972642,"y":0.039134055017645886,"text":"6 Read the task below. Then read the email and choose","w":0.44008712768554692},{"text":"the correct verbs.","w":0.13943354606628416,"h":0.01170173076467651,"x":0.041394340401861456,"y":0.053705245674809499},{"h":0.011773134846175148,"text":"SHOW WHAT YOU'VE LEARNT","y":0.04651162775235107,"w":0.26579521179199217,"x":0.50544662258206186},{"h":0.013111650894126914,"text":"8 You received the following message from a friend.","x":0.49891069338155491,"w":0.41612197875976564,"y":0.071190674475199778},{"h":0.013322231473771873,"x":0.041394333184539639,"y":0.084096586045341315,"w":0.39215686798095706,"text":"You received the following message from a friend."},{"text":"Hi Sam,","w":0.054466228485107425,"h":0.010407993338884314,"x":0.045751635893611857,"y":0.12489592006690919},{"y":0.15403830132673058,"h":0.013112861052043789,"text":"U OK? I've read that book you lent me. You're right - it's","w":0.39215686798095706,"x":0.045751624905672764},{"x":0.045751633369249659,"y":0.16985845119450349,"w":0.37690631866455082,"h":0.01182759512870335,"text":"excellent! Unfortunately, however, I'm a bit sad at the"},{"x":0.045751632688138207,"h":0.013081394961037107,"y":0.18313953485959766,"text":"moment &.I hurt my back a few days ago and the","w":0.35947711944580085},{"w":0.37908496856689455,"h":0.013322231473771873,"y":0.19900083246969025,"text":"doctor told me I need to stay in bed. Why is that bad?","x":0.045751633799341392},{"x":0.045751640543792577,"y":0.21511627930179311,"w":0.36165576934814458,"h":0.011777975477842761,"text":"Because there's a school trip to Marburg Castle this"},{"x":0.045751636533163165,"y":0.22965116303725819,"text":"weekend and I planned to take photographs and write","w":0.38344226837158202,"h":0.011814282597550574},{"text":"about it on my blog. Now I have to lie in bed and do","x":0.045751639933387767,"y":0.24418604677999078,"w":0.36601306915283205,"h":0.011627906367344121},{"text":"nothing. I can't read all the time - any ideas about","x":0.045751641154197317,"y":0.2601744188366768,"w":0.35729846954345701,"h":0.011682367046905728},{"x":0.045751638906238658,"h":0.010174418567717836,"w":0.1350762462615967,"text":"what else l can do?","y":0.27470930228954227},{"h":0.011147289847851183,"y":0.29021123873295751,"x":0.045629168256973503,"w":0.087390899658203125,"text":"Speak soon!"},{"text":"Eddie","w":0.043572983741760253,"y":0.31976744201981633,"h":0.01162790636734401,"x":0.043572984763106816},{"x":0.041394336364916878,"h":0.011808231013899162,"text":"Write a personal email with a reply.","y":0.34429641984419146,"w":0.2766884422302246},{"h":0.011771924291224867,"text":"Include and develop these points:","y":0.35886761021512159,"x":0.041394345961008445,"w":0.26579519271850588},{"y":0.37635303921715502,"text":"• Express sympathy for your friend's situation.","w":0.33986927032470704,"h":0.011728355826982173,"x":0.04139434653699272},{"h":0.011692049104307767,"text":"• Offer some advice based on your own experience.","x":0.041394338101216129,"w":0.38997821807861333,"y":0.39092422966075957},{"text":"• Change the subject and share some news about","y":0.40549542044325815,"x":0.041394339300813598,"w":0.37472766876220703,"h":0.011656952539550236},{"y":0.42005813979113416,"x":0.056644883211480736,"h":0.011665424042002104,"text":"your life.","w":0.06535947322845459},{"h":0.01170173076467651,"y":0.43459302356051399,"text":"• Reassure your friend at the end of the email.","x":0.041394345648618651,"w":0.34640522003173829},{"w":0.061138734817504869,"h":0.010542803660320565,"x":0.52280753951991943,"y":0.11173441208341328,"text":"Hi Peter,"},{"w":0.35729846954345701,"text":"U OK? I've got that book you wanted to borrow. I'Il","y":0.14098837250494656,"x":0.52287581983974574,"h":0.013081394961037107},{"x":0.52287582141391187,"text":"bring it tomorrow. I'm not feeling good today, in fact,","w":0.37690631866455071,"h":0.011656952539550347,"y":0.15695253970793754},{"x":0.52069716942961763,"w":0.39651416778564452,"h":0.013322231473771762,"y":0.1698584513462893,"text":"I'm super stressed out &. I haven't even started revising"},{"w":0.39433551788330079,"x":0.5206971678920459,"text":"for the final exams and I'm totally disorganised! I don't","y":0.18604651203983025,"h":0.013081394961037107},{"x":0.52287581890062862,"y":0.20191507077554693,"w":0.38344226837158213,"h":0.011747719941786361,"text":"know where to begin. Have you started? Have you got"},{"text":"any advice or ideas to make revision easier?","y":0.21648626136450033,"x":0.5206971636474278,"w":0.31372549057006827,"h":0.01171141282207866},{"x":0.51851853914102553,"y":0.2485428810133733,"text":"Write a personal email in reply. Include and develop","w":0.40958602905273434,"h":0.011656952539550347},{"h":0.011913838334921323,"text":"these points:","x":0.51848300696784888,"w":0.10464618682861326,"y":0.26293842961613256},{"w":0.33115467071533211,"text":"• Express sympathy for your friend's situation.","x":0.51851852934821618,"h":0.011733196855683303,"y":0.28052325608231632},{"x":0.51851852354937111,"w":0.37254901885986325,"y":0.29505813976690942,"h":0.011769503975391005,"text":"• Offer some advice and share a similar experience"},{"y":0.30939672259512419,"text":"you have had","x":0.5315408423404504,"w":0.10249566078186034,"h":0.012020508117421613},{"text":"• Change the subject and suggest some other","x":0.51633986860833392,"h":0.01162790636734401,"y":0.32412790732989394,"w":0.34204792022705077},{"y":0.33689177031800066,"x":0.53294822482974968,"w":0.093037691116332977,"h":0.015004474058635586,"text":"future plans."},{"h":0.013081394961037107,"text":"• Reassure your friend at the end of the email.","x":0.51633987888993393,"y":0.35174418622224302,"w":0.33986927032470693},{"text":"Hi,","x":0.030501089543671284,"h":0.013081394961037107,"w":0.023965141773223876,"y":0.48982558157108025},{"x":0.032679739625313182,"text":"A Sorry to hear about your bad back. B' Must \/ Might be.","y":0.50416319737248705,"w":0.40087146759033199,"h":0.011825174415836193},{"w":0.38562091827392575,"y":0.51873438815498552,"h":0.01178886729612838,"text":"horrible to be stuck in bed all day. I 2had \/ would have a","x":0.032679740797677576},{"text":"similar problem last year when | 3used to break \/ broke my","x":0.032679753894495039,"y":0.53197674416192331,"w":0.40522872924804687,"h":0.013081394961037107},{"y":0.54787676917300865,"w":0.40305011749267577,"h":0.011716253850779679,"x":0.032679729243858306,"text":"ankle. How did you hurt yourself? You 4might have lifted \/"},{"w":0.28758169174194331,"h":0.011679946731071977,"x":0.032679738769551284,"y":0.56244796001364661,"text":"might lift something too heavy, perhaps?"},{"text":"Anyway, | Sunderstand \/ am understanding how boring it","y":0.58139534908561519,"w":0.392156867980957,"x":0.032679731042201322,"h":0.013109230578293163},{"h":0.011804600540148424,"y":0.59575353880631421,"x":0.03267973464107872,"text":"can be and I remember how active you 'used to be \/ would","w":0.40740741729736324},{"h":0.011768293420440612,"w":0.40522876739501956,"x":0.03267972989726154,"y":0.61032472958881279,"text":"be, so it's even harder to do nothing every day. Why don't"},{"text":"you download some audio books? I?did \/ had done this last","x":0.032679756257180476,"y":0.62489591990160342,"h":0.011731986697766206,"w":0.41830062866210938},{"h":0.011695679578058615,"w":0.40305011749267577,"text":"year. C Much better than reading to yourself all the time!","x":0.032679738312485537,"y":0.63946711072770646},{"h":0.013093497731306414,"x":0.034858405380848688,"text":"By the way, I'm visiting Hohenzollern Castle near Stuttgart","w":0.41176467895507818,"y":0.65843023267936518},{"text":"with my parents next month. D Want to join us? I'm sure","w":0.39869277954101567,"x":0.032679758777059219,"h":0.011820333387135062,"y":0.67277268937018042},{"text":"you'll be back on your feet by then and we can &pick you up \/","y":0.68734388002759728,"w":0.40087146759033199,"h":0.013322231473771873,"x":0.032679738405269665},{"text":"put you up on our way there and hold you up \/ drop you off","w":0.41394332885742191,"h":0.013322231473771873,"x":0.032679745084724307,"y":0.7019150709554447},{"x":0.032679739206497624,"text":"on the way back. No problem. E Would be great to have","y":0.71648626139904914,"w":0.39433551788330079,"h":0.013322231870805279},{"x":0.032679739788804035,"text":"you come along!","y":0.73255813956313343,"w":0.11764705657958985,"h":0.010174418567717836},{"x":0.032679735210591296,"w":0.3725490188598633,"y":0.76017441896749072,"text":"P.S. F Pleased you liked the book. G Will recommend","h":0.011682367046905728},{"h":0.01171867416661343,"w":0.24618736267089844,"x":0.032679736681980015,"text":"something else next time I write ;-)","y":0.77470930271749083},{"text":"7 Look at the underlined parts of the text. Write them","y":0.80959302366773722,"h":0.013081394961037107,"x":0.017429204371500119,"w":0.43137252807617188},{"y":0.82412790735411867,"x":0.041394344547898428,"text":"in the full form. Sometimes more than one answer is","w":0.40740737915039066,"h":0.01162790636734401},{"x":0.041227074451558911,"h":0.013945794720931604,"y":0.83968407953701951,"text":"possible.","w":0.074408597946166999},{"y":0.85755813995586294,"w":0.015250544548034671,"text":"A","x":0.041394335678052376,"h":0.01162790636734401},{"w":0.010893245935440062,"h":0.0087209299740247381,"x":0.043572984766484767,"text":"B","y":0.87209302329787131},{"y":0.90116279075426664,"w":0.013071894645690918,"h":0.0087209299740247381,"text":"D","x":0.04357298530242687},{"x":0.043572984766484774,"y":0.91424418589540468,"w":0.010893245935440062,"h":0.010174418567717836,"text":"E"},{"x":0.043572984957116569,"y":0.93023255837781316,"w":0.010893245935440062,"h":0.0087209299740247381,"text":"F"},{"h":0.010174418567717836,"w":0.013071894645690918,"text":"G","x":0.043572985030095719,"y":0.94331395337965862},{"w":0.27450979232788086,"h":0.013322231870805279,"text":"SHOW THAT YOU'VE CHECKED","x":0.5054466261454279,"y":0.6219816818474313},{"x":0.50326798022360808,"h":0.011815492755467449,"y":0.64680232585702557,"w":0.2897603416442871,"text":"Finished? Always check your writing."},{"y":0.65986677750417233,"text":"Can you tick \/ everything on this list?","w":0.29411764144897456,"h":0.013098338362974027,"x":0.50544662143237562},{"w":0.16993463516235352,"text":"In my personal email:","h":0.011705361635460654,"x":0.5032679782358167,"y":0.68604651184539778},{"h":0.013322231473771873,"y":0.70774354713288645,"x":0.50544663222548314,"w":0.2766884422302246,"text":"• I have used a friendly greeting, e.g"},{"y":0.72231473753646314,"w":0.18954248428344733,"text":"Dear Sam or Hi Charlotte","h":0.010407993338884203,"x":0.52287581857723053},{"y":0.7398001665058499,"w":0.37037036895751951,"text":"• I have started with some general news and\/or a","h":0.013106810262459301,"x":0.50544662467156709},{"text":"reference to what my friend wrote in their","x":0.52069717747448574,"y":0.75436046552820246,"h":0.013081394961037107,"w":0.3115468215942383},{"h":0.010782858017183705,"text":"last email","w":0.076431012153625466,"x":0.51842937504959152,"y":0.76859112906882643},{"x":0.50544662812453456,"y":0.78633720944171981,"w":0.37254901885986325,"h":0.013081394961037107,"text":"• I have included everything in the bullet points in"},{"text":"the question, i.e. expressed sympathy, offered","y":0.80087209305363838,"w":0.34204792022705077,"h":0.013081394961037107,"x":0.52069717597035248},{"text":"advice, changed the subject and given some","h":0.013081394961037107,"x":0.5206971689270109,"y":0.81540697701076059,"w":0.33115467071533211},{"text":"positive news, and reassured my friend at the end","x":0.52270000625132151,"y":0.82844697847958348,"w":0.36198665618896486,"h":0.014617802399977564},{"x":0.50544662723023881,"y":0.85012489608984332,"w":0.36383441925048821,"text":"• I have used contractions (e.g. I'm \/ aren't \/ that's).","h":0.013322231473771873},{"text":"• I have perhaps used some emoticons and","w":0.33986927032470704,"h":0.013081394961037107,"x":0.50326798232130654,"y":0.87209302328619664},{"x":0.52069716563113022,"text":"abbreviations (info \/ CU \/ gr8) - but not too many.","w":0.35947711944580074,"y":0.88800999164471317,"h":0.011699310448842648},{"y":0.90840965859011846,"h":0.011656952539550347,"x":0.50544663263806855,"w":0.35076251983642581,"text":"• I have checked my spelling and punctuation."},{"w":0.20261438369750973,"x":0.50544662281355446,"y":0.93168604675818845,"text":"• My text is neat and clear.","h":0.011694469420141629},{"h":0.013081394961037107,"text":"C","w":0.019607843160629246,"x":0.90631808297306238,"y":0.71366279081889994},{"x":0.90631808297306238,"w":0.019607843160629246,"y":0.85029069779564426,"h":0.013081394961037107,"text":"C"},{"w":0.021786491870880109,"h":0.014534882760663281,"text":"C","x":0.90413943371597616,"y":0.87790697707897059},{"h":0.014534882760663281,"text":"C","w":0.019607843160629246,"x":0.90631808266805136,"y":0.90697674452083099},{"text":"C","w":0.021786491870880109,"h":0.014534882760663281,"y":0.9302325584743194,"x":0.90413943371597616},{"text":"41","y":0.96220930268842109,"w":0.026143789291381836,"h":0.01162790636734401,"x":0.90849673254385155}]
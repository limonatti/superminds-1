[{"y":-1.3709322566057836e-10,"w":0.27789934158325197,"h":0.013278008694470711,"x":0.1466083114476156,"text":"EAAM OPCANING"},{"h":0.013081394686243919,"x":0.063457329398168519,"y":0.059593023369087339,"text":"In pairs, ask and answer the questions.","w":0.31947483062744148},{"h":0.011756971762882706,"y":0.082848837445648749,"text":"Talk about looks and personality.","w":0.26695842742919917,"x":0.074398250661767987},{"w":0.39824943542480473,"text":"1 Do you enjoy being the centre of attention when","y":0.09585062228913499,"x":0.0743982600228274,"h":0.013278008694470711},{"h":0.013278008298755251,"x":0.10065645644659021,"text":"you're in a group? Why?\/Why not?","w":0.26258205413818358,"y":0.11037344415189199},{"w":0.013129101991653444,"h":0.010174418089300752,"x":0.07439824966062844,"y":0.12500000033034964,"text":"2"},{"w":0.36761486053466796,"text":"How much do you care about your appearance?","y":0.12489626581878821,"x":0.10065647082675767,"h":0.013278007903039679},{"y":0.15406976757235546,"text":"3","w":0.013129101991653444,"x":0.074398249770037617,"h":0.010174418089300752},{"y":0.14098837258783736,"h":0.013081394686243808,"x":0.098468272830368797,"text":"Why?","w":0.045951857566833509},{"w":0.38110286712646485,"x":0.10047722838251523,"h":0.015588866427726389,"y":0.15207933496458836,"text":"When was the last time you didn't want to go with"},{"w":0.2078774642944336,"h":0.013278008298755251,"text":"the flow? What happened?","y":0.16846473033498066,"x":0.10065645731303106},{"w":0.31728664398193362,"h":0.011744909563499828,"text":"4 Have you ever fallen out with a friend?","y":0.09738372113750926,"x":0.55798687811844228},{"x":0.58424508284907317,"y":0.11191860484874949,"w":0.13347920417785641,"text":"What happened?","h":0.011732847364117061},{"w":0.35229759216308587,"h":0.013081394686243808,"y":0.12645348892141295,"x":0.56017505690897484,"text":"5 Do you like wearing cutting-edge fashions?"},{"y":0.14098837243595885,"h":0.011708722965351193,"x":0.58424507859896291,"w":0.12035010337829599,"text":"Why?\/Why not?"},{"w":0.90382835388183602,"h":0.015073705016330097,"y":0.19746185309072106,"text":"2 Look at the photo of the young people wearing fashionable clothes. Take turns to talk about what you can see in your","x":0.050270011297820855},{"y":0.2136627909630906,"text":"photos. Talk about the people, the clothes and the other things in the photo.","w":0.57549232482910151,"h":0.011648412364152483,"x":0.076586447279103423},{"y":0.47501387909936899,"h":0.015202226282649889,"w":0.89288093566894544,"x":0.063406064924849015,"text":"You and your friend want to buy a birthday present for a fashionable female friend. Here are some of the presents you"},{"y":0.48962655592338677,"x":0.074398243832083891,"text":"could choose. Talk together about the different presents and say which would be best.","h":0.013280420580345509,"w":0.64332603454589843},{"y":0.8298755186755824,"text":"4 Talk about buying presents.","x":0.05032823899624489,"h":0.013278007903039679,"w":0.23851202011108397},{"x":0.07439825551655406,"w":0.34792121887207028,"text":"• Do you enjoy buying presents for people?","h":0.014615699166578788,"y":0.84730290487422855},{"h":0.01308139547767484,"x":0.098468272759436107,"w":0.12472647666931151,"text":"Why?\/Why not?","y":0.86337209285709271},{"text":"• Where do you usually go to buy presents?","h":0.011719579023938942,"w":0.34792121887207034,"x":0.07439824690969811,"y":0.87790697708712151},{"y":0.88953488384678958,"w":0.40700218200683597,"text":"• What sort of presents do you like receiving? Why?","x":0.074398245903949126,"h":0.01461449381721458},{"h":0.01327800790303979,"x":0.56236322901059754,"y":0.84439834027586025,"w":0.38949672698974602,"text":"• Do you think it's easy or hard to buy fashionable"},{"w":0.20350109100341796,"h":0.013278007903039679,"text":"presents for friends? Why?","x":0.58862144264562888,"y":0.85892116196092516},{"y":0.87344398370376941,"x":0.56236323252459042,"text":"• Who is the hardest person you know to buy","h":0.013278007903039679,"w":0.35667396545410157},{"w":0.15317286491394044,"text":"a present for? Why?","x":0.58862144719292031,"y":0.88796680460830457,"h":0.013278008694470711},{"text":"134","x":0.050328227555104021,"w":0.037199125289916993,"y":0.95058139521174401,"h":0.01308139547767484}]
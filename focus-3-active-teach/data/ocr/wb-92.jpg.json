[{"text":"7.2","w":0.063318777084350589,"h":0.029069767220444742,"x":0.074235807713283239,"y":0.03924418601187063},{"y":0.011627906883356798,"h":0.018895349169332887,"text":"GRAMMAR","w":0.18777292251586916,"x":0.19650655050126695},{"h":0.011746410918910155,"text":"Reported speech","y":0.053660565694985896,"w":0.13973798751831051,"x":0.19650655034564829},{"h":0.0088104130622749244,"text":"- statements","x":0.19650654792963554,"w":0.10480349540710451,"y":0.07113144752164402},{"text":"SHOW WHAT YOU KNOW","w":0.22489082336425784,"h":0.013081395090518866,"x":0.06986900040458352,"y":0.12936046517276378},{"h":0.0087209303248146908,"x":0.061135371539196688,"y":0.15697674406724382,"w":0.019650654792785653,"text":"1"},{"h":0.011782687436324379,"x":0.080786041360735472,"y":0.15682196347505228,"text":"Put the words in order to complete the conversation","w":0.41484714508056647},{"x":0.082969440423567922,"y":0.17138103173643382,"w":0.24454147338867188,"h":0.013311148086522451,"text":"between Mum, Dad and Kristy."},{"x":0.085152857912181759,"h":0.010399334442595665,"y":0.19176372729759983,"text":"D: Kirsty, please tell me we are not watching The X Factor.","w":0.41266372680664065},{"w":0.41048034667968752,"h":0.010399334442595665,"y":0.20632279521306984,"text":"K: You watch \/ said \/ could\/ I said I could watch it tonight.","x":0.085152846601931842},{"x":0.082969434836908246,"y":0.21947674409718243,"w":0.26200872421264654,"h":0.013081395090518866,"text":"D: No, l 'could \/ you \/ watch \/ said"},{"x":0.2816203592183229,"y":0.23534384097044314,"text":"it upstairs.","w":0.08086408615112306,"h":0.011870457209683827},{"text":"K: Dad!","x":0.082969432527693704,"y":0.25124791995440887,"w":0.063318777084350575,"h":0.0089264987114066052},{"text":"D: What? The other day | 21 \/ television \/ said \/ was \/ taking","x":0.082969437955213832,"y":0.26580698847035755,"w":0.41703056335449218,"h":0.011809290347995827},{"x":0.1069225453908994,"h":0.011997304621234717,"w":0.074364514350891114,"text":"back \/ my","y":0.28033855706900213},{"h":0.013311148086522451,"y":0.29492512488766232,"x":0.10698689130932248,"w":0.37772926330566409,"text":"on Saturday nights. I want to watch the Grand Prix."},{"text":"K: (shouting) Mum! The X Factor has started!","w":0.33842792510986325,"y":0.31104651197622024,"h":0.011748829221170043,"x":0.082969441675417699},{"x":0.080786025779677431,"h":0.016222961730449237,"text":"D: Kirsty! Last Saturday night, | 3told \/ you \/ bought \/ 1\/","y":0.32404326153397189,"w":0.41921398162841794},{"h":0.0087209303248145797,"text":"had","y":0.34156976736219025,"x":0.10698690017051402,"w":0.030567684173583992},{"y":0.35607321145286064,"text":"a second television for exactly this kind of situation.","w":0.38646286010742192,"h":0.011659346483709809,"x":0.10698691699869055},{"h":0.01308865079070487,"text":"M: (enters room) Oh. Did you 4The X Factor \/ that \/ say \/","x":0.082969443850516994,"w":0.39301307678222663,"y":0.37063227953071731},{"text":"started\/had","y":0.38662790683371662,"x":0.10698690194017385,"w":0.093886461257934567,"h":0.0087209303248148018},{"y":0.38517441866226676,"x":0.48689956359088349,"h":0.011627906570815361,"text":"?","w":0.01528384208679201},{"h":0.010399334442595665,"y":0.40099833613071401,"text":"D: But ... the Grand Prix.","x":0.082969437068120655,"w":0.18777292251586913},{"w":0.3384279251098633,"h":0.013311148086522451,"x":0.082969445278037735,"y":0.41555740445273792,"text":"M: There's another television upstairs, Walter."},{"w":0.34497814178466796,"text":"* Write reported speech as direct speech.","y":0.44622093034354871,"x":0.074235824249587315,"h":0.013081395090518866},{"x":0.082969443215049454,"text":"Pay attention to the underlined words.","w":0.30567684173583987,"h":0.011690786396604258,"y":0.46214642270275696},{"x":0.10917030841908812,"w":0.39082969665527345,"h":0.011661765182672812,"y":0.47961730432366512,"text":"Margaret Mead said that thanks to television, for the"},{"w":0.39956329345703123,"x":0.10698691721799079,"text":"first time the young were seeing history before it was","y":0.49273255825052553,"h":0.013091069092964647},{"x":0.10698690564518688,"y":0.5070715472244407,"w":0.1834061050415039,"h":0.01182380135166472,"text":"censored by their elders."},{"text":"Margaret Mead: 'Thanks to television, for the","y":0.51980416999120072,"x":0.10907275594639053,"w":0.33643527984619137,"h":0.013846316472464482},{"x":0.10698689736629312,"y":0.53488372120587135,"text":"first time the young are seeing history before it is","w":0.36899562835693356,"h":0.011705297003569815},{"x":0.10917030686077794,"y":0.54783693838284775,"w":0.19213973999023437,"h":0.011756084524652932,"text":"censored by their elders.'"},{"x":0.10043667281908174,"y":0.56239600646183519,"w":0.38427947998046869,"h":0.011731900311944488,"text":"Peter J. Laurence said that television had changed"},{"h":0.011773013433878488,"w":0.38209606170654292,"text":"the American child from an irresistible force into an","x":0.10698690666492343,"y":0.57558139574560008},{"w":0.13973798751831057,"h":0.011797198043290047,"text":"immovable object.","x":0.1069869028929553,"y":0.59011627946653034},{"x":0.10917030938451951,"h":0.010399334442595665,"y":0.60316139769647004,"w":0.14628820419311528,"text":"Peter J. Laurence: '"},{"y":0.63226744171743765,"text":"2","w":0.013100435733795157,"h":0.0087209303248146908,"x":0.082969433006464866},{"w":0.37117900848388674,"text":"Christine Amanpour said she believed that good","h":0.011659346483709809,"x":0.10043670172603317,"y":0.63226744225722797},{"h":0.013311148086522451,"y":0.64517470868608406,"x":0.10480350127816691,"w":0.38646286010742187,"text":"journalism, good television could make our world a"},{"y":0.65807055603715947,"w":0.098463859558105452,"text":"better place.","h":0.013800747184309015,"x":0.10688160577056575},{"y":0.67296511659831326,"w":0.16375545501708985,"text":"Christine Amanpour: '","h":0.011727062914018371,"x":0.10917030827748128},{"text":"3","x":0.056768559644019431,"y":0.7093023254383678,"h":0.0087209303248146908,"w":0.013100435733795171},{"h":0.015497845540229149,"text":"* * Match the reporting verbs with the definitions.","w":0.41941596984863283,"x":0.074137832316503352,"y":0.70776138669439825},{"x":0.069868997818912565,"y":0.73401162814401666,"w":0.42576419830322265,"h":0.014740451996814397,"text":"Minister for Culture Embarrassed in Television Interview"},{"text":"Last night on Channel 10 News, the Minister for Culture claimed that","y":0.75707154723413073,"w":0.42576416015625002,"h":0.011823801351664609,"x":0.072052424834538512},{"text":"young people were happier these days than when he had been","h":0.010174418051111855,"x":0.072052408980984625,"y":0.77325581415758371,"w":0.42358078002929689},{"text":"young. The journalist Mandy Striker pointed out that there was no","x":0.069868997873497665,"y":0.78779069789668243,"w":0.42576419830322271,"h":0.010174418051111966},{"x":0.069869004528862105,"y":0.80232558164676271,"w":0.42576416015624996,"text":"real proof of that, and politely suggested that happiness was very","h":0.011734318614204486},{"text":"difficult to measure. The minister explained that his statement was","w":0.42358078002929689,"h":0.010174418051111966,"x":0.072052408980984625,"y":0.81686046534944412},{"x":0.072052405836879885,"text":"based on meetings he had had with young people and parents in","w":0.42358078002929689,"y":0.83277870208009042,"h":0.011698042096790151},{"y":0.84733777054066228,"h":0.011673857090675588,"x":0.072052410039936565,"w":0.42358078002929689,"text":"local schools in his area. He added that his own teenage children"},{"w":0.42139736175537112,"x":0.072052409115036437,"y":0.86189683874988021,"text":"were also living full and happy lives. The minister then asked Ms.","h":0.011649672481263917},{"h":0.010399334442595776,"text":"Striker if this was reasonable evidence. Ms Striker replied that not all","w":0.42358078002929689,"x":0.072052399450417179,"y":0.87770382699112925},{"x":0.072052410039936565,"w":0.42358078002929689,"y":0.89226289512048573,"h":0.011806872045735939,"text":"young people were as lucky as those who lived in the area where the"},{"w":0.42139736175537107,"h":0.011782687436324379,"text":"minister lived. This morning the red-faced minister promised there","x":0.074235812972387336,"y":0.90682196332970355},{"h":0.011727063310721486,"text":"would be a nation-wide survey into young people's levels of happiness.","w":0.42139736175537107,"x":0.072052415039344911,"y":0.92296511642389467},{"text":"90","w":0.026200873851776121,"h":0.013081395090518977,"y":0.94912790703322891,"x":0.065502183423456928},{"text":"gave a reason for something","y":0.026162790802608749,"w":0.21397378921508792,"h":0.013081395090518866,"x":0.58733625306348936},{"y":0.040697674765787006,"text":"said that something was true","w":0.21397378921508792,"h":0.013081395090518977,"x":0.58733625080730323},{"y":0.027616279114139775,"x":0.91048035066116639,"w":0.074235806465148935,"h":0.013081395090518866,"text":"explained"},{"x":0.56331877742643643,"text":"2","y":0.055232558020732236,"h":0.0087209303248145797,"w":0.010917030572891173},{"x":0.58733624723317834,"y":0.055232558289124323,"w":0.072052397727966233,"text":"answered","h":0.010174418051111855},{"x":0.58709356274974756,"w":0.20585592269897457,"h":0.015791083730992694,"y":0.06573268286794387,"text":"said more about something"},{"y":0.082848837211623616,"w":0.013100435733795157,"h":0.0087209303248146908,"text":"4","x":0.5611353714344125},{"h":0.011698041700087036,"y":0.082778702331444687,"w":0.25982532501220701,"text":"told someone something that they","x":0.58515283534688067},{"text":"didn't know or hadn't thought of","w":0.24235807418823241,"y":0.095930232905321988,"h":0.013081395090518866,"x":0.58951965559147312},{"w":0.27292575836181643,"x":0.56331878293699555,"text":"5 said something in an indirect way","y":0.11046511642389467,"h":0.011831056655147498},{"text":"4 * * * Read the direct speech. Choose the correct","x":0.53711790125777725,"w":0.42576419830322265,"y":0.12936046540895563,"h":0.013081395090518977},{"x":0.56113537311324979,"h":0.013081395090518866,"text":"reporting verb. Then complete the gaps with the","y":0.1438953487483452,"w":0.38209606170654298},{"h":0.013081395090518866,"w":0.39301307678222652,"x":0.56331879421441788,"text":"correct forms of the verbs in brackets. Change any","y":0.15843023290532199},{"y":0.16972006292991892,"h":0.015194875428363175,"w":0.19715414047241209,"text":"other words if necessary.","x":0.56304919175674417},{"h":0.013311147689819336,"text":"'Honestly, please believe me, I really didn't know she","x":0.58733625491310804,"w":0.39301307678222652,"y":0.18885191363776599},{"y":0.20203488363206612,"x":0.58733625067086914,"w":0.14410479545593269,"h":0.013081395090518977,"text":"was a drug dealer.'"},{"h":0.013081395090518866,"y":0.21656976749834522,"text":"The TV presenter asuggested \/claimedhe hadn't","w":0.3733624267578125,"x":0.58733626009270923},{"y":0.2311046513173054,"x":0.58951965097089432,"h":0.01182380135166472,"w":0.37772926330566403,"text":"known (not\/know) that the woman had been a drug"},{"h":0.011627906570815472,"text":"dealer. He begged the court to believe him","x":0.58951965824710217,"y":0.24563953505034808,"w":0.32751091003417965},{"y":0.25872093028904286,"x":0.58951966753968255,"text":"'We don't think the programme is suitable for","w":0.33842792510986319,"h":0.013081395090518977},{"x":0.58733624460166678,"h":0.011775432132841601,"text":"When a journalist asked why the programme had","y":0.28618968383425214,"w":0.36462882995605472},{"text":"been banned, the members of the panel added \/","h":0.013081395090518866,"x":0.58951965475166412,"y":0.29941860491113592,"w":0.36899562835693367},{"text":"replied that, inb","w":0.12459724426269536,"x":0.58726469835379147,"y":0.3121914862613,"h":0.01369842157982748},{"x":0.7770109921719609,"h":0.013079022012415398,"text":"_ opinion, they c","y":0.31421736977417103,"w":0.11862334251403805},{"text":"(not\/think) the programme was suitable for children.","x":0.58951966110451592,"y":0.32695507474259666,"w":0.38209606170654298,"h":0.013311148483225566},{"text":"'Don't tell everyone, but maybe you should wait until","w":0.39956329345703123,"x":0.58078604385554544,"y":0.34151414304984451,"h":0.011683531093121369},{"w":0.3951964950561524,"h":0.013081395090518866,"text":"next week. There's probably going to be a sale here.'","y":0.35465116270183361,"x":0.58733625658400512},{"y":0.3677204658004708,"w":0.38427947998046885,"h":0.013093487395224646,"x":0.58733624308836818,"text":"I was in the electrical store a few weeks ago and the"},{"text":"assistant winked at me and areplied \/ suggested that","h":0.013311147689819336,"w":0.39082969665527345,"x":0.58733624697803999,"y":0.38352745449785441},{"x":0.68723554702898104,"h":0.013246246661600347,"y":0.39634491793461502,"w":0.11875895500183098,"text":"_ week there c"},{"h":0.014629175182983567,"x":0.86443141767304499,"w":0.10956511497497556,"text":"(probably\/be)","y":0.3974819239262084},{"w":0.35807857513427732,"h":0.011731900311944488,"text":"'Leo can take my car. I won't need it because I'm","y":0.42587209315354579,"x":0.58951966887390927},{"x":0.58951966049469728,"y":0.43749999991113586,"w":0.20305675506591803,"text":"working from home today!","h":0.013081395090518866},{"y":0.45341098151611048,"w":0.36026199340820309,"h":0.010399334442595665,"text":"Leo wanted to borrow his dad's car, but his mum","x":0.58733625820856195},{"h":0.013081395090518866,"w":0.2183406066894531,"text":"aadded\/suggested that heb","x":0.58733624323460387,"y":0.46656976759524438},{"h":0.010370983260245215,"text":"(take) hers.","w":0.080841417312622066,"x":0.88206837565967899,"y":0.46792497330875227},{"text":"She c","x":0.58951965161072739,"y":0.48110465150012238,"w":0.041484713554382324,"h":0.010174418051111966},{"x":0.70305677049450988,"w":0.22270742416381839,"y":0.4811046513959556,"text":"(not\/need) it because she was","h":0.010174418051111966},{"text":"working from homed","x":0.58951965768424175,"h":0.013091068696261643,"y":0.49417637286547067,"w":0.15938863754272459},{"w":0.032751090526580762,"y":0.49563953488206614,"h":0.013081395090518866,"text":"day.","x":0.82096069899435153},{"h":0.011690786396604258,"text":"SHOW WHAT YOU'VE LEARNT","y":0.5261627909733132,"w":0.2641921424865723,"x":0.55021833703546208},{"x":0.54366813112816947,"h":0.013311148483225566,"text":"5 Rewrite the direct speech as reported speech.","w":0.38209606170654287,"y":0.55074875178492866},{"w":0.3733624267578125,"x":0.58951965897371383,"text":"\"I will miss the last part of this TV series tomorrow.'","y":0.56821963404236542,"h":0.013311147689819336},{"text":"It was a long time ago, but I remember she said","x":0.58951966338002548,"y":0.58277870218609584,"w":0.35371177673339849,"h":0.011698041700087036},{"x":0.58951964890522646,"w":0.35807861328125001,"y":0.59733777024683421,"h":0.010399334442595665,"text":"she would miss the last part of that TV series the"},{"text":"following day","x":0.58733624443618571,"y":0.61046511637189171,"w":0.10480349540710443,"h":0.013081395090518866},{"text":"'We're going to be on television next week'","w":0.33406112670898436,"x":0.58515284832673031,"h":0.013083813392778754,"y":0.62354409328523264},{"y":0.63808139545490228,"w":0.2008733558654785,"h":0.011669020486155701,"text":"Two months ago, they said","x":0.58951965729287936},{"text":"2","w":0.017467248439788863,"x":0.55895196551809689,"h":0.011627906570815361,"y":0.66569767454889461},{"h":0.013311148086522451,"w":0.31877727508544917,"x":0.5764192174063294,"text":"'I'm meeting your sister here later today.'","y":0.66555740426499577},{"w":0.27947597503662103,"x":0.58951965906101977,"y":0.67877907001998672,"h":0.010174418051111966,"text":"We were in the café and Dad told me"},{"text":"3","y":0.70784883705416246,"h":0.0087209303248146908,"x":0.56331877720809587,"w":0.010917030572891284},{"x":0.58515283856853306,"text":"'We saw you both last month.'","w":0.23144104003906241,"y":0.70784883741226678,"h":0.011785106135287382},{"text":"It was back in January when they told us","h":0.01167627578963859,"y":0.72088186348414118,"x":0.58951965989306321,"w":0.29912662506103516},{"h":0.010174418051111966,"x":0.56331877798463081,"w":0.013100435733795157,"text":"4","y":0.74854651183200216},{"y":0.74854651177523479,"h":0.013100742698707535,"x":0.58733624169271548,"text":"'I can't give you her phone number now.'","w":0.30786026000976563},{"y":0.76289517451219313,"w":0.078602619171142529,"h":0.0089071511032180473,"text":"Jason said","x":0.58951965100394832},{"x":0.56331877706107347,"h":0.0087209303248146908,"w":0.013100436925888026,"text":"5","y":0.79069767426346471},{"w":0.2074235725402831,"x":0.58296943384448729,"text":"'Your concert is cancelled.'","y":0.78910149732830692,"h":0.011770595528321715},{"h":0.013311147689819336,"text":"We were very disappointed when the organiser told","w":0.38209606170654298,"y":0.80366056598881397,"x":0.58951965091528757},{"text":"us that","y":0.81794958983203936,"w":0.054881744384765563,"h":0.010903145826596794,"x":0.58937135556567599},{"y":0.84593023270772894,"w":0.010917030572891284,"h":0.010174418051111966,"x":0.56331877720809587,"text":"6"},{"w":0.17903928756713872,"text":"I'll see you tomorrow.'","x":0.5807860324900842,"y":0.84593023295490233,"h":0.011806872045735939},{"h":0.013311148086522451,"w":0.19213973999023437,"text":"Six days ago she told him","x":0.58951965205728452,"y":0.85898502506995877},{"h":0.011647254575707144,"w":0.24017467498779288,"text":"_, but then she never came back.","x":0.7314410487870352,"y":0.87354409305923408},{"text":"16","x":0.94759825317286328,"w":0.021834061145782457,"h":0.010174418844518196,"y":0.89680232540493721},{"text":"GRAMMAR: Train and Try Again page 160","y":0.92587209300593554,"w":0.31877727508544917,"h":0.014643714352574388,"x":0.60480350617998269}]
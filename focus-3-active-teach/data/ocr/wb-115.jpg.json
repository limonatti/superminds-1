[{"h":0.017441859428393047,"x":0.021739130244165832,"text":"8.9","w":0.0391304349899292,"y":0.010174419297431347},{"h":0.020521120157385053,"y":0.0070951589255400238,"text":"EXAM SPEAKING","w":0.28260868072509771,"x":0.097826091593972958},{"w":0.17826086044311529,"text":"STUDENT A","y":0.007095158911005095,"x":0.75434782916250043,"h":0.020521120157385053},{"w":0.39565216064453129,"h":0.013134778839518857,"x":0.010869575808169074,"y":0.072621035079621254,"text":"Student A, look below. Student B, go to page 141."},{"w":0.32391304016113281,"text":"1 In pairs, ask and answer the questions.","y":0.10308848071448284,"x":0.013043485317984178,"h":0.013355592654424098},{"y":0.12500000021289859,"w":0.20652173995971679,"h":0.011627906550947031,"x":0.034782610862532849,"text":"Talk about entertainment."},{"h":0.013355592654424098,"x":0.034782629097793991,"y":0.13939899818382484,"text":"1 Tell me about the last live concert you attended","w":0.37826084136962895},{"y":0.15400667783118571,"text":"2 If you were a musician, would you rather sign","w":0.35869564056396486,"x":0.034782620478886944,"h":0.011690996326070735},{"y":0.16860465130301483,"h":0.011695849477548204,"x":0.060869581419730708,"text":"a recording contract with a big music company or","w":0.36739128112792968},{"w":0.24347826004028322,"x":0.06086956621174245,"h":0.013355593052451709,"y":0.18155258760392623,"text":"make music in small clubs? Why?"},{"w":0.36521736145019529,"h":0.013142057969693588,"text":"3 Would you prefer to be a great drummer, lead","y":0.1961602670049073,"x":0.034782622028525549},{"w":0.26521738052368166,"h":0.013081394571294758,"text":"guitarist or singer-songwriter? Why?","y":0.21075581412423638,"x":0.060869574738159071},{"x":0.50652173928506572,"y":0.13953488381754964,"w":0.017391303777694711,"text":"4","h":0.011627906550947142},{"w":0.30652172088623042,"h":0.013355592654423987,"y":0.13939899847452253,"x":0.52391304952065298,"text":"Have you ever been to a music festival?"},{"y":0.15400667776432464,"h":0.01043405676126874,"x":0.5347826107547351,"w":0.12608695030212402,"text":"What was it like?"},{"w":0.41304347991943358,"h":0.013081395367350201,"y":0.16860465118987145,"text":"5 Would you ever sign up for a reality TV programme?","x":0.51086956094608038},{"y":0.1831395349108017,"text":"Why?\/Whynot?","w":0.12173913002014158,"h":0.01308139536735009,"x":0.53260869484500173},{"y":0.23982558131341802,"h":0.013095954423754774,"w":0.86739128112792963,"x":0.013043498544730596,"text":"2 Discuss this question together. 'Is the main purpose of a prison to punish a criminal or to help him\/her not to break"},{"y":0.25417362247161734,"x":0.036956522910704628,"text":"the law again when he\/she is released?' What do you think?","h":0.01335559305245182,"w":0.43913043975830074},{"y":0.28488372084830171,"text":"3 Look at the two photos showing criminal activity. What can you see in the photos? Which do you think is more serious? Why?","x":0.013043496423612737,"h":0.013112940254911942,"w":0.91739128112792978},{"x":0.013043478514984797,"w":0.013043477535247804,"text":"4","h":0.010174418530599527,"y":0.74854651153775253},{"h":0.013139631990996437,"x":0.036956522177734499,"w":0.49565216064453121,"text":"Read the instructions on your card and role-play the conversation.","y":0.74854651167315622},{"text":"Student A:","h":0.0087209297141965791,"w":0.082608690261840811,"x":0.065217394825601321,"y":0.7848837211312738},{"y":0.80801335544317388,"w":0.11086956024169924,"text":"The situation:","x":0.063043478900889585,"h":0.01043405676126874},{"h":0.013120219783114284,"x":0.063043499340119671,"y":0.82554257085114224,"w":0.61521736145019534,"text":"You and Student B are discussing placements for voluntary work. There are two places"},{"w":0.63913040161132817,"h":0.013081394571294758,"text":"available: one is at a youth centre helping young people with their Maths and one is at an","x":0.063043484194336308,"y":0.84011627953121315},{"y":0.85465116272693542,"x":0.065217409924210018,"text":"old people's home, keeping elderly people company. Discuss the advantages and disadvantages","h":0.01308139536735009,"w":0.69347824096679689},{"w":0.60652172088623046,"text":"of both placements, talk about your skills and interests and decide which you will do.","x":0.06521741053514532,"y":0.8691860468761744,"h":0.013117793008361689},{"text":"Your goal:","x":0.065188410582027637,"w":0.080492744445800776,"y":0.89380550556242322,"h":0.01180759375799878},{"h":0.013120218987058951,"w":0.32391304016113276,"x":0.063043481694795844,"text":"You want to work at the old people's home.","y":0.91133720990912004},{"text":"113","w":0.039130434989929186,"x":0.89347826027677457,"h":0.01308139536735009,"y":0.96075581399873766}]
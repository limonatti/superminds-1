w":0.13943354606628419,"h":0.013092287176356132,"y":0.24562864269878459,"text":"now,' they told us.","x":0.10021786661827406},{"y":0.27616279071792948,"text":"6","w":0.010893245935440068,"h":0.0087209299740247381,"x":0.074074074118336608},{"y":0.27470930230145818,"h":0.013081394961037107,"w":0.28540304183959964,"x":0.098039220365603225,"text":"'It was hot yesterday,' he pointed out."},{"y":0.32412790718517914,"x":0.058823529704677441,"text":"7.5","h":0.013081394961037107,"w":0.034858386516571055},{"y":0.32412790749840581,"text":"Reported Speech - questions and","x":0.10893245909774976,"h":0.014534882760663281,"w":0.31590414047241211},{"x":0.10671105499063359,"w":0.11555392265319823,"text":"imperatives","h":0.014838394177744241,"y":0.33705754695474832},{"h":0.013081394961037107,"x":0.05010894730284008,"w":0.39869277954101562,"text":"2 Change the direct questions or imperatives into","y":0.36627907017936512},{"text":"reported speech.","h":0.011775554764975604,"w":0.13725489616394043,"x":0.074074078688182249,"y":0.38081395379307215},{"y":0.39825581420189415,"w":0.37472766876220703,"text":"1 'Did you see the film yesterday?' he asked me.","x":0.07407406943153276,"h":0.013081394961037107},{"h":0.010174418567717836,"x":0.071895425046244105,"y":0.4287790697132341,"w":0.01525054454803465,"text":"2"},{"w":0.31590414047241211,"h":0.013322231870805279,"text":"'How's your grandmother?' he asked me.","x":0.091503271403227379,"y":0.42714404636957481},{"y":0.45628642789000928,"x":0.074074077239624614,"text":"3 'What's your name?' he asked her.","h":0.01332223187080539,"w":0.28104574203491212},{"w":0.3594771194458008,"text":"4 'Where did you find the key?' she asked me.","x":0.074074082433962116,"y":0.48542880946406219,"h":0.011664213487051711},{"text":"5 'Are you writing a new book?' I asked her.","x":0.074074075545899093,"w":0.33769062042236331,"y":0.51453488406196757,"h":0.011693259262224642},{"h":0.010174418567717836,"w":0.015250544548034664,"x":0.074074073995045855,"text":"6",
[{"h":0.023255814322821755,"x":0.017429193400685092,"y":0.007267441584955403,"w":0.052287583351135258,"text":"6.9"},{"text":"EXAM SPEAKING","w":0.27450979232788086,"h":0.019150707743547102,"x":0.10457517072059112,"y":0.0070774352315667866},{"h":0.021124600768585577,"text":"STUDENT B","y":0.0068795600205376894,"w":0.17666908264160153,"x":0.75807068841837832},{"text":"1 In pairs, ask and answer the questions.","w":0.3246187210083008,"h":0.013104389549592144,"x":0.010893259285246693,"y":0.074104912557864444},{"y":0.095753538660965476,"h":0.011804600540148424,"text":"Talk about health.","w":0.14161219596862795,"x":0.034858391449237212},{"h":0.013081394961037107,"text":"1 Have you ever been bitten by an animal or","x":0.034858393081826797,"w":0.34204792022705072,"y":0.10901162788285357},{"h":0.010668697404821792,"x":0.058750708556398232,"y":0.12475286068456892,"text":"an insect?","w":0.076398363113403325},{"x":0.034858398553792538,"y":0.13808139545189424,"w":0.26361654281616215,"h":0.013081394961037107,"text":"2 Do you have any food allergies?"},{"x":0.034858395882440621,"h":0.013081394961037107,"y":0.1526162791728245,"text":"3 Have you ever burnt any part of your body?","w":0.35076251983642581},{"w":0.01525054454803465,"h":0.0087209299740247381,"y":0.11046511633566203,"text":"4","x":0.50980392181639655},{"x":0.52505446666446387,"y":0.11032472953067329,"w":0.33551197052001958,"h":0.011768293420440612,"text":"Has anyone ever helped you when you had"},{"x":0.53594771728797752,"y":0.12354651160378372,"text":"health problems? What happened?","w":0.26797384262084967,"h":0.013081394961037107},{"text":"5","x":0.50762527248850431,"y":0.13808139550818854,"w":0.017429193258285514,"h":0.011627906367343899},{"text":"When was the last time you laughed your head off?","x":0.52505447504430725,"y":0.13808139556696208,"w":0.39869277954101556,"h":0.013081394961037107},{"x":0.53594771819655351,"h":0.011659372458350692,"w":0.13289759635925302,"text":"What happened?","y":0.15403830155865461},{"h":0.010174418567717836,"y":0.18168604669966826,"x":0.010893246422258179,"w":0.010893245935440062,"text":"2"},{"text":"Discuss this question together. Take different sides of the argument during your discussion. 'Is it acceptable to test new","w":0.8910675048828125,"y":0.18151540374356634,"h":0.013322231473771873,"x":0.023965143382849875},{"x":0.034858416660452037,"h":0.013322231473771984,"text":"medicines on animals?' Decide who is going to take each side. Then share your ideas.","y":0.1960865945842043,"w":0.62962959289550779},{"h":0.016169007275126268,"text":"3 Look at the two photos showing people who have been injured. What can you see in the photos?","y":0.22278150295633536,"x":0.010809823251560857,"w":0.75832946777343746},{"y":0.23980016644707636,"text":"Which injury do you think is worse? Why?","w":0.31154684066772459,"h":0.011656952539550458,"x":0.034858385348781162},{"h":0.010174418567717836,"text":"4","x":0.013071895659730944,"w":0.010893245935440062,"y":0.74563953507176139},{"text":"Read the instructions on your card and role-play the conversation.","y":0.74562864283807717,"x":0.034858396280959596,"w":0.49891067504882808,"h":0.013092287176356132},{"y":0.77746277240389072,"x":0.063139874744955943,"h":0.010481431819715725,"text":"Student B:","w":0.085049228668212878},{"h":0.010174418567717836,"y":0.8008720929981179,"text":"The situation:","x":0.063180831427746609,"w":0.10893245697021484},{"w":0.58387798309326167,"h":0.013081394961037107,"x":0.061002194655256969,"y":0.81831395365804738,"text":"You are a patient at a doctor's surgery. Student A is the doctor. You have hurt"},{"w":0.58387798309326178,"text":"your leg. Think about how it happened and what symptoms you have. Tell the","y":0.83284883735959792,"x":0.061002190762737246,"h":0.013112861052043789},{"x":0.06318083557850955,"text":"doctor. Listen to his\/her advice. Ask if you need to go to hospital. Ask if you","w":0.572984733581543,"h":0.013322231473771873,"y":0.84721065765859493},{"x":0.063180842361504647,"w":0.43355117797851561,"h":0.013322231473771873,"y":0.86178184864821561,"text":"need to have an operation. Ask if you need any medicine."},{"w":0.080681991577148435,"x":0.063144843235577744,"text":"Your goal:","y":0.89088958417930397,"h":0.013278971504509962},{"x":0.063180837190396064,"y":0.90840965846114985,"w":0.34204792022705077,"h":0.013101969233758282,"text":"To get treatment from the doctor for your leg."},{"text":"139","y":0.96220930244680702,"x":0.89760348641239129,"w":0.03703703641891487,"h":0.013081394961037107}]
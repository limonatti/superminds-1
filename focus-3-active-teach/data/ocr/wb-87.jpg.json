[{"text":"EXAM SPEAKING","x":0.10021786691282721,"w":0.28104574203491212,"y":0.0058139537087799065,"h":0.018895348541742574},{"y":0.0055884432274634355,"w":0.17876413345336917,"h":0.020799857591411453,"text":"STUDENT A","x":0.76029113700465667},{"h":0.013111650894126914,"y":0.071190674478833538,"w":0.39433551788330079,"text":"Student A, look below. Student B, go to page 139.","x":0.013071896417826672},{"w":0.31372547149658203,"x":0.023965156190706622,"text":"In pairs, ask and answer the questions.","y":0.10319767472330477,"h":0.011706571793377529},{"x":0.034749188931862421,"h":0.012034552778232954,"text":"Talk about the environment.","y":0.1231834659613078,"w":0.22684627532958984},{"text":"1 Tell me about three things you have done at school","w":0.40522876739501956,"y":0.13808139544099307,"h":0.013081394961037107,"x":0.037037036476782068},{"h":0.011659372855384209,"w":0.18300653457641602,"x":0.061002177955074545,"text":"to help the environment.","y":0.15403830145231878},{"y":0.16715116263959073,"h":0.010174418567717725,"w":0.010893245935440062,"text":"2","x":0.037037037054066461},{"h":0.013322231870805279,"text":"Is it the responsibility of each individual person","x":0.052287578814156709,"w":0.35511981964111333,"y":0.16694421290292838},{"y":0.18151540363634311,"x":0.061002177590191095,"w":0.3790849685668945,"h":0.011798549353530419,"text":"or the government to take action on environmental"},{"h":0.01179740867646506,"y":0.19613617941691552,"text":"issues? Why?","w":0.098084344863891615,"x":0.060979612834801668},{"y":0.13808139576076051,"x":0.51416121944340065,"h":0.013081394961037107,"w":0.30501089096069334,"text":"3 What do you think is the best form of"},{"h":0.011659372855384209,"text":"renewable energy? Why?","x":0.53812635897483418,"y":0.15403830133119478,"w":0.18954248428344722},{"y":0.16694421280602911,"x":0.51416122958795962,"text":"4 Would you prefer to come face to face with","w":0.35076251983642581,"h":0.013322231870805279},{"x":0.5378956105248186,"h":0.016019553566455458,"text":"a skunk or a bear? Why?","y":0.1790516619366378,"w":0.18361730575561519},{"text":"5 In what ways can oceans be dangerous?","h":0.013322231473771873,"x":0.51416123043629991,"y":0.19608659447519272,"w":0.3246187210083008},{"text":"2","w":0.010893245935440063,"x":0.013071895641575538,"y":0.22529069763232323,"h":0.010174418567717836},{"x":0.039215687949840969,"h":0.013322231870805279,"text":"Discuss this question together. Take different sides of the argument during your discussion. 'Is it acceptable","y":0.22522897577154777,"w":0.79084968566894531},{"text":"to test new medicines on animals?' Decide who is going to take each side. Then share your ideas.","x":0.037037050455968272,"y":0.23980016666669157,"w":0.72113288879394521,"h":0.013106809865425784},{"text":"3","w":0.013071894645690921,"x":0.013071895669166167,"y":0.26889534868610232,"h":0.010174418567717836},{"w":0.7647058868408203,"h":0.013081394961037218,"text":"Look at the two photos showing people raising money for charity. What can you see in the photos?","y":0.26889534905533408,"x":0.023965126623163257},{"y":0.28343023258852218,"w":0.44008712768554686,"h":0.013081394961037107,"x":0.039215698738925865,"text":"Have you ever done something to raise money for charity?"},{"text":"128","h":0.017441859948049476,"w":0.039215686321258492,"x":0.50544662298316156,"y":0.42877907020039385},{"x":0.4967320273083547,"h":0.013081394961037107,"y":0.67441860468154546,"w":0.03267973661422735,"text":"DONAT"},{"h":0.013081394961037107,"x":0.4967320273083547,"w":0.03267973661422735,"text":"WELC","y":0.68459302328619653},{"w":0.026143789291381891,"h":0.0087209299740247381,"text":"THAN","y":0.69912790720291007,"x":0.49891067572467945},{"x":0.037037028888077153,"y":0.75145348859021788,"w":0.49891067504882813,"text":"Read the instructions on your card and role-play the conversation.","h":0.013081394961037107},{"y":0.78633720938314278,"w":0.08496731758117676,"h":0.0088334818068988019,"text":"Student A:","x":0.065359479880435528},{"h":0.010174418567717836,"w":0.10893245697021485,"text":"The situation:","x":0.065359480937550493,"y":0.80959302321977478},{"h":0.013098338362974138,"text":"You are a doctor and Student B is a patient. Ask about what the problem is,","w":0.56862743377685554,"x":0.065359492833794303,"y":0.82703488393299895},{"text":"how it happened and his\/her symptoms. Then decide what advice to give.","x":0.065359492965470736,"y":0.84138218132936748,"w":0.55773418426513677,"h":0.011815492755467449},{"x":0.065359499548246588,"w":0.52069713592529299,"y":0.85595337239446556,"text":"Will you send the patient to hospital? Will he\/she need an operation?","h":0.013322231076738467},{"h":0.011742878913085342,"x":0.065359479934379863,"y":0.8705245627880287,"w":0.23747276306152343,"text":"Will he\/she need any medicine?"},{"y":0.89912984477883162,"h":0.012786822354763805,"text":"Your goal:","w":0.083139171600341802,"x":0.065184227058392927},{"h":0.01311165129116032,"text":"To treat your patient successfully.","y":0.91569767439448135,"w":0.25054466247558593,"x":0.065359479982250474},{"text":"85","w":0.026143789291381836,"h":0.011627907161410933,"x":0.90631808378568168,"y":0.96220930216057365}]
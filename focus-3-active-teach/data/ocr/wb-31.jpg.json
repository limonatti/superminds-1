[{"x":0.11231101129636173,"y":0.010084034012508236,"w":0.27213823318481445,"h":0.01898573306428275,"text":"EXAM SPEAKING"},{"x":0.75801511555329937,"y":0.0098425558015011738,"w":0.17511447906494138,"h":0.021012561862208234,"text":"STUDENT A"},{"h":0.014713210418444755,"w":0.3909287261962891,"text":"Student A, look below. Student B, go to page 135.","x":0.019438440969530148,"y":0.073949579645596786},{"x":0.01943846178150313,"h":0.011627906510809916,"y":0.10610465139575787,"w":0.32181423187255853,"text":"1 In pairs, ask and answer the questions."},{"w":0.25917924880981447,"h":0.013081395125188688,"text":"Talk about looks and personality.","x":0.043196549893149021,"y":0.12645348826589409},{"y":0.14098837242287077,"text":"1 How do you find out about clothes that are in fashion","w":0.41468681335449215,"h":0.013213308318322459,"x":0.043196546310514991},{"w":0.1425485897064209,"text":"and out of fashion?","h":0.011764705882352899,"x":0.066954646759460529,"y":0.15546218502115461},{"h":0.010174417896431032,"y":0.17005813981631934,"x":0.043196544675245342,"w":0.012958962917327885,"text":"2"},{"y":0.17005813967093275,"w":0.38876888275146493,"text":"Do you think it's important to have a break from your","h":0.013135137477842673,"x":0.064794817803533494},{"y":0.18445378138026836,"w":0.26565874099731451,"text":"routine sometimes? Why?\/Why not?","h":0.01322063718523292,"x":0.066954642352314797},{"text":"3 Do you think you come across as friendly when you","x":0.043196554708855611,"y":0.19912790703406258,"h":0.013081395125188688,"w":0.39956802368164068},{"h":0.011627906510809805,"text":"first meet someone? Why?\/Why not?","w":0.26997838973999022,"x":0.066954646922661495,"y":0.21366279098878116},{"x":0.51403888067356718,"y":0.14243697466502292,"w":0.313174934387207,"h":0.011764705882352899,"text":"4 Have you ever lost touch with a friend?"},{"text":"What happened?","y":0.15697674445535093,"w":0.12958963394165046,"h":0.011627906510809805,"x":0.53779697406589189},{"text":"5 When was the last time you wore brightly-coloured","h":0.01176470588235301,"x":0.51187904030285847,"y":0.17142857157020785,"w":0.40172786712646491},{"text":"clothes? Why?","x":0.53991495544998425,"y":0.18587218955371454,"w":0.10591523170471195,"h":0.01197655140852727},{"x":0.019394705969187527,"y":0.24126307603792718,"w":0.80569503784179686,"text":"2 Discuss this question together. 'Is winning more important than taking part in a sport?' What do you think?","h":0.015067369797650554},{"text":"For taking part:","w":0.12201221466064452,"h":0.01464008363355096,"x":0.068551622367877235,"y":0.27448816616421579},{"x":0.069114474309821497,"text":"Taking part in a sport ...","w":0.19006479263305665,"y":0.29941860488412997,"h":0.011627906510809916},{"y":0.31680672263826337,"h":0.013135137878546144,"x":0.069114482869778157,"w":0.36717060089111325,"text":"• is fun and thrilling! It doesn't matter who wins!"},{"w":0.4751619720458985,"x":0.069114473588281947,"y":0.33139534899263823,"text":"• is a great experience that helps you learn about yourself and","h":0.013142465944049775},{"h":0.013619506258924496,"text":"other people.","w":0.10381927490234377,"x":0.094958614816872983,"y":0.34566117708784683},{"x":0.069114497658442395,"w":0.54859607696533208,"y":0.36046511636666922,"h":0.013081395125188688,"text":"• is great exercise for your body and mind (without the pressure to win!)."},{"w":0.55939521789550783,"h":0.013098494746104028,"text":"• is good preparation for life. You don't always win but you can learn a lot","x":0.069114483744830799,"y":0.3735294119007927},{"h":0.013179108675788531,"text":"by fighting hard along the way!","w":0.23110151290893555,"x":0.095032400744956155,"y":0.38808139538798703},{"text":"Look at the two photos showing people at sporting events. What can you see in the photos?","w":0.69546432495117183,"h":0.013113152079221591,"y":0.43604651176395604,"x":0.041036724421462764},{"text":"Which activity would you prefer to do? Why?","y":0.45042016802016471,"w":0.33693302154541016,"h":0.013445378551963927,"x":0.043196551970275582},{"y":0.65261627995340188,"text":"12","w":0.077753777503967336,"h":0.033430230918050752,"x":0.34989200925017611},{"y":0.71220930218814493,"x":0.023758099696843615,"w":0.012958962917327878,"h":0.010174418697838084,"text":"4"},{"x":0.036717059762650411,"text":"Read the instructions on your card and role-play the conversation.","y":0.71218487411917231,"h":0.011764705882352899,"w":0.50107990264892588},{"x":0.073434127509051345,"y":0.74563953477656553,"w":0.082073431015014658,"text":"Student A:","h":0.01024281798290605},{"x":0.073434135126657765,"w":0.5572354125976563,"h":0.013081395125188799,"y":0.76889534887635902,"text":"You and your friend (Student B) are discussing a suggestion that sports"},{"y":0.78343023288800606,"w":0.31749458312988277,"h":0.011627906510809805,"text":"should be removed from the curriculum.","x":0.071274301415620342},{"h":0.013113152079221591,"y":0.80084033616287853,"w":0.43844490051269525,"text":"• Greet Student B and ask his\/her opinion on the subject.","x":0.073434142697215918},{"text":"• Half agree with Student B's opinion, but give your own opinion too: say","w":0.55291576385498042,"y":0.8154069768124057,"h":0.013164451743374328,"x":0.073434132240976238},{"w":0.45356369018554688,"x":0.097192244540055692,"text":"that doing a sport is important for general health and fitness.","y":0.82983193275820311,"h":0.013191322919701265},{"text":"Disagree with Student B's opinion. Explain that students don't have a lot","x":0.086393088930991346,"w":0.5507559204101562,"y":0.84447674446746324,"h":0.011825776701213875},{"x":0.099059417771210967,"h":0.017312096347327999,"text":"of free time, so it's hard to organise sports.","y":0.85686469451423708,"w":0.3202417373657227},{"h":0.01176470588235301,"w":0.44060474395751958,"x":0.07127430923074321,"text":"• Say that you'll have to agree to disagree on the subject.","y":0.87352941183925537},{"y":0.96220930263122317,"h":0.011627906510809916,"w":0.025917925834655686,"text":"29","x":0.90280777541960522}]
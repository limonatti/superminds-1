[{"h":0.029069765969430783,"x":0.070021882867949345,"y":0.037790698249134724,"w":0.067833695411682118,"text":"7.4"},{"y":0.011286647104228442,"h":0.019577868449737523,"text":"READING","w":0.16210332870483404,"x":0.19684768054121474},{"h":0.013081394686243808,"text":"Television • collocations • phrases","x":0.19693654638561683,"w":0.27789934158325191,"y":0.053779070316761768},{"text":"related to reading • word building","w":0.28008752822875976,"h":0.01327800829875514,"x":0.19474835492281933,"y":0.069709543530943718},{"h":0.010174418089300752,"text":"1","y":0.027616279157869017,"w":0.010940918922424325,"x":0.53829321657817519},{"text":"Read the text and match headings A-F with parts 1-4.","w":0.4245076370239258,"h":0.01308139547767484,"x":0.56455143666673879,"y":0.027616278969011421},{"h":0.016198356121902124,"x":0.56423296785465138,"y":0.039366517460748041,"text":"There are two extra headings.","w":0.2369920730590821},{"x":0.56455142659047786,"y":0.059593023369087339,"w":0.21006563186645499,"h":0.013081394686243919,"text":"A Getting a Clearer Picture"},{"x":0.56455142226745303,"h":0.0087209297908292793,"y":0.075581395627841164,"text":"B","w":0.010940918922424325},{"w":0.18380743026733404,"h":0.010373443983402453,"y":0.07551867235223253,"text":"Television Goes Mobile","x":0.57986871068690204},{"x":0.56455142739419872,"y":0.088662790798361923,"w":0.22319473266601564,"h":0.011752146803986507,"text":"C Hi-tech Becomes Old-tech"},{"x":0.56455142291008142,"y":0.10465116293888777,"text":"D","w":0.013129101991653513,"h":0.0087209297908291683},{"text":"What Day? What Time? What Channel?","x":0.58862145038691893,"y":0.10456431520599618,"w":0.2954047966003418,"h":0.011714754460758203},{"text":"E","x":0.56455142226745314,"y":0.1177325582276364,"w":0.010940918922424214,"h":0.010174418089300752},{"x":0.58862145263920951,"h":0.01172802240522075,"w":0.24070020675659176,"text":"The Internet Replaces Television","y":0.11773255837588126},{"h":0.010174418089300752,"y":0.13226744194856666,"x":0.56455142226745314,"w":0.010940918922424214,"text":"F"},{"text":"Stay in your Seat, Stay in Control","w":0.24726476669311526,"y":0.13226744221598663,"h":0.013081394686243808,"x":0.58862144185402598},{"x":0.054704595749716207,"h":0.011650824645742852,"text":"If your grandma or grandpa were","y":0.21075581429642387,"w":0.24288839340209961},{"h":0.011638762842075434,"text":"lucky enough to have a television","y":0.22529069791076506,"x":0.056892787431332081,"w":0.24070020675659182},{"y":0.23982558183518365,"text":"in their bedroom when they were","w":0.24070020675659179,"h":0.011627906387772335,"x":0.056892786993695349},{"h":0.011631525205873294,"text":"your age, they probably felt pretty","x":0.054704602226740097,"w":0.24288839340209964,"y":0.25435684653452451},{"text":"cool, even if it was black and","y":0.26887966791229423,"x":0.054704596989686965,"w":0.24288839340209958,"h":0.011643587800971744},{"y":0.28340248954854941,"x":0.054704602226740097,"h":0.011655649604639051,"text":"white, weighed about 20 kg and","w":0.24288839340209964},{"h":0.010373443983402453,"y":0.29792531107689069,"text":"had an antenna that looked like","x":0.054704602226740097,"w":0.24288839340209964},{"w":0.17943105697631834,"h":0.011679773607689459,"x":0.054704605793387026,"y":0.3124481329776696,"text":"a metal coat hanger. A"},{"w":0.028446388244628917,"text":"The","y":0.31250000021407054,"x":0.26914660922560679,"h":0.010174418089300752},{"x":0.052516410486772643,"text":"technology of televisions has","w":0.24507658004760741,"h":0.011691836202787576,"y":0.3269709542004009},{"x":0.054704599254095571,"w":0.24507658004760743,"h":0.011703898402170565,"y":0.3414937759157467,"text":"changedso quickly that it's not"},{"w":0.45514221191406246,"x":0.054704600024004651,"text":"surprising some of the most sophisticated features of the TV","y":0.35601659743729397,"h":0.011715960601553332},{"x":0.05470460593210074,"y":0.37053941895884135,"w":0.45514221191406251,"h":0.011728022800936211,"text":"sets of the past seem rather silly these days. In this week's"},{"text":"article, check out these old TV technologies, but while you are","y":0.38506224060963135,"x":0.054704610891983876,"w":0.45514221191406257,"h":0.011740084604603629},{"x":0.054704599513428424,"y":0.39958506220385315,"text":"laughing, remember that many modern gadgets will seem just as","w":0.45514221191406257,"h":0.011752146803986396},{"x":0.054704599024545983,"y":0.41410788391919895,"w":0.20131290435791016,"h":0.011764209003369386,"text":"ridiculous to the youngsters"},{"x":0.054704595199034076,"y":0.42732558152584388,"w":0.0940919017791748,"h":0.010174418089300641,"text":"of tomorrow."},{"h":0.014534882984715281,"w":0.074398250579833958,"text":"DEPT","x":0.27789934351283385,"y":0.42587209332907094},{"w":0.010940918922424311,"h":0.010174418089300863,"text":"2","x":0.054704595161326142,"y":0.44912790710723915},{"x":0.05251640953111391,"h":0.011812457405185217,"y":0.47219917015885593,"w":0.20350109100341796,"text":"'Stay tuned!' is something"},{"y":0.48837209319008801,"text":"you stilloccasionally hear","w":0.20350109100341798,"h":0.010174418089300752,"x":0.054704599274002098},{"w":0.20131290435791013,"text":"people on television say","h":0.011630319065078165,"x":0.054704596106967679,"y":0.50290456416756768},{"h":0.011810044727879498,"y":0.51889534932549364,"x":0.054704601431548081,"w":0.20131290435791016,"text":"when they are really asking"},{"y":0.5334302330464239,"w":0.20350109100341796,"text":"younot to switchoffor","h":0.01179798252849662,"x":0.054704593630311535},{"y":0.54937759327911873,"w":0.20131290435791016,"text":"change the channel. The","h":0.010373443983402564,"x":0.05470460016240157},{"text":"phrase has lost its original","x":0.054704597079247463,"y":0.565406977056367,"h":0.010174418089300752,"w":0.19912471771240237},{"h":0.011759384044473187,"text":"meaning, which referred","w":0.19912471771240237,"x":0.056892785366993548,"y":0.57994186067239295},{"x":0.05470460016240157,"y":0.59447674442239284,"w":0.20131290435791016,"h":0.011747321845090308,"text":"to 'tuning' early analogue"},{"text":"televisions (adjusting* them to get the best quality picture) by","y":0.60901162802025011,"w":0.45733039855957031,"h":0.013081394686243919,"x":0.052516417678639404},{"text":"turning a big dial,* or wheel, on the front. Later televisions had","h":0.01173164122332182,"x":0.054704610891983876,"y":0.62489626538626197,"w":0.45514221191406257},{"text":"individual channel buttons, but for each button there was still","x":0.054704609754128379,"y":0.64098837227802408,"w":0.45514221191406246,"h":0.010174418089300752},{"x":0.054704609500302259,"y":0.65684647283697306,"w":0.45733039855957031,"text":"a tuning dial located behind alittle plastic door on the front","h":0.010373443983402564},{"text":"of the set. These dials were often tiny and tricky to turn, so","w":0.45514221191406257,"h":0.011770240103060714,"x":0.054704610891983876,"y":0.6713692944134998},{"x":0.054643698705750372,"text":"some manufacturers used to sell their sets with a little plastic","w":0.4552771759033204,"y":0.68569938949795273,"h":0.012201075336250478},{"y":0.70203488408809056,"h":0.011658061886229421,"x":0.054704599513428424,"w":0.45514221191406257,"text":"stick that you would put into a hole and turn until the picture"},{"w":0.23851202011108399,"x":0.05470460661112455,"y":0.717842323500826,"text":"was clear enough to watch.B","h":0.010373443983402453},{"h":0.011808838982799719,"text":"Nowadays, thank goodness,","w":0.21663019180297854,"x":0.29540481296065529,"y":0.71784232356186162},{"x":0.052418945748295018,"w":0.3175206184387207,"y":0.73047572722392451,"h":0.013775397336334705,"text":"televisions 'tune' themselves automatically."},{"w":0.010940918922424325,"h":0.010174418089300752,"text":"3","x":0.53829321657817519,"y":0.18895348846019455},{"h":0.01180401402390352,"text":"When your grandparents were young, 'channel surfing' actually","w":0.44857769012451176,"x":0.53829321556867038,"y":0.21203319493548656},{"text":"required physical effort because to change the channel you","w":0.44857769012451176,"h":0.011636350164769604,"y":0.228197674654951,"x":0.53829321631629989},{"text":"had to stand up, walk across the room and press a button on","y":0.2427325585793696,"w":0.44857765197753907,"h":0.011627906387772335,"x":0.53829323355718217},{"y":0.25872093045342259,"text":"the television. C","w":0.129102840423584,"h":0.0089139241895239696,"x":0.53829322088959386},{"y":0.25872093047859446,"x":0.67177244098568589,"w":0.31291027069091804,"h":0.011818488504876656,"text":"_ Eventually, remote controls were invented"},{"x":0.53829323016549746,"text":"but the first ones actually had a wire that stretched across","y":0.27325581439332314,"h":0.011806426305493889,"w":0.44857765197753907},{"x":0.53829321631629989,"y":0.28921161808481921,"w":0.44857769012451176,"text":"the room from the remote to the television. Later more boxes","h":0.010373443983402453},{"x":0.53829322554295944,"w":0.44857765197753907,"h":0.011672536367202668,"y":0.30373443988869897,"text":"appeared - video recorders, satellite tuners and so on - and"},{"y":0.31976744210650143,"w":0.45076583862304687,"h":0.011767827425754995,"text":"with those came additional remote controls. Eventually, when it","x":0.53829323699773968},{"h":0.010373443983402453,"y":0.33568464719926627,"w":0.44857769012451165,"text":"became impossible to open the living room door because of","x":0.53829320734474639},{"text":"all the different remotes, universal controllers became popular","w":0.45076583862304698,"y":0.35020746903706079,"h":0.011711135246941562,"x":0.53829323511954863},{"w":0.44857765197753907,"x":0.53829323651123029,"text":"and one small device could finally control all the different boxes","y":0.36473029059494533,"h":0.01172319744632444},{"text":"in your living room! Now, with the help of the right app, it is","x":0.53829321631629989,"w":0.44857769012451176,"y":0.38081395372471849,"h":0.011717166742348573},{"x":0.53829323511954863,"h":0.010373443983402453,"text":"becoming more and more common to use a mobile phone or","y":0.39668049804565642,"w":0.45076583862304698},{"h":0.010373443983402453,"w":0.35667396545410157,"x":0.63019693768870411,"text":"tablet to control all the various media devices in","y":0.41120331957810496},{"y":0.42732558188363323,"h":0.011678567466894219,"w":0.35667396545410157,"text":"your house, though some homes still have more","x":0.63019693116791642},{"h":0.010373443983402453,"text":"remote controls than hands to operate them.","x":0.63019694177380969,"w":0.32166301727294921,"y":0.4431535271092315},{"y":0.46366279080952721,"x":0.63019693651800013,"w":0.010940918922424325,"h":0.0087209297908292793,"text":"4"},{"h":0.011627906387772446,"y":0.47529069791076495,"text":"-0000","w":0.059080963134765629,"x":0.55579868751358008},{"y":0.48672199172885289,"x":0.6301969281773987,"h":0.011824519604568207,"w":0.35667396545410157,"text":"Not so many years ago, viewers had no choice but"},{"h":0.011824519604568207,"text":"to wait a week for the next episode of their favourite","x":0.6301969348878288,"y":0.50145348886037733,"w":0.35667396545410157},{"y":0.51742738579570424,"x":0.63238512289329607,"text":"TV programmes to be shown. D It was not","w":0.35448577880859378,"h":0.011642381264461044},{"x":0.63019693029264301,"h":0.011654443068128462,"text":"unusual for people to plan their week around the","y":0.5319502076063779,"w":0.35667396545410157},{"text":"TV schedule and, if they were busy at the time of","h":0.011785920724829202,"x":0.63019692963290252,"y":0.54796511657355573,"w":0.35448577880859378},{"text":"their favourite show, they either missed it or found","w":0.35667396545410157,"x":0.63019692941736949,"y":0.56250000010068746,"h":0.011773858921161895},{"x":0.63019693386667641,"h":0.011693042343582927,"text":"space on a video tape, set the video recorder for","y":0.57842323662549699,"w":0.35667396545410157},{"text":"the right time and hoped the tape didn't run out","x":0.63019693768870411,"y":0.59447674437104725,"w":0.35667396545410157,"h":0.010174418089300752},{"text":"before the programme had finished. These days, TV schedules","w":0.44857769012451176,"x":0.53829321631629989,"y":0.6090116281433231,"h":0.011735259645707319},{"w":0.44857765197753907,"h":0.011723197842040012,"text":"are still printed in magazines and some newspapers. However,","y":0.62354651172859443,"x":0.53829322495944365},{"y":0.63808139546211062,"w":0.45076583862304687,"h":0.013081394686243919,"x":0.53610505209620785,"text":"they are much less significant because of 'catch-up'TV"},{"text":"channels, on-demand Internet TV services such as Netflix or","h":0.010174418089300752,"w":0.44857769012451176,"x":0.53829321631629989,"y":0.65552325599895434},{"x":0.53610503445041902,"h":0.011684598566585547,"y":0.67005813982936979,"w":0.38730854034423823,"text":"I-player, and of course legal and illegal downloading."},{"h":0.014012253630705351,"x":0.538188965580916,"w":0.44659069061279288,"text":"Television and the technology associated with it is changing","y":0.69909524478886997},{"w":0.44857765197753907,"h":0.011806426305493889,"text":"constantly and if you have children, by the time they are your","y":0.7149377593738574,"x":0.53829323651123029},{"x":0.5382932291866469,"y":0.7294605807868666,"w":0.44638946533203117,"text":"age, flat-screen, HD and 3D will probably seem as silly and","h":0.013278008298755251},{"y":0.74563953510553249,"w":0.44857765197753907,"h":0.011627906387772335,"text":"old-fashioned as black and white, two channels only, and a coat","x":0.53829323651123029},{"h":0.013278008298755251,"w":0.14879649162292485,"text":"hanger for an aerial.","x":0.53829321968817279,"y":0.7601659749409273},{"h":0.011928400063415778,"text":"GLOSSARY","w":0.087616891860961915,"x":0.063412561727581973,"y":0.889384637101163},{"text":"adjust (v) -to change or move something slightly to","x":0.070021894599189879,"y":0.91120331958584599,"w":0.36980304718017576,"h":0.011761796326063445},{"x":0.06783369342412314,"w":0.23632385253906246,"y":0.92572614121593144,"text":"improve it ormake itwork better","h":0.010373443983402564},{"text":"dial (n) - the wheel-like part of a radio or old-fashioned television that","x":0.4770240699257795,"h":0.011761796721778905,"y":0.91120331945660338,"w":0.49671772003173831},{"w":0.32166301727294916,"y":0.92441860520048269,"h":0.013081394686243919,"text":"you turn to find a different station or channel","x":0.47483588235550217},{"h":0.013081394686243919,"text":"92","y":0.95203488421574434,"w":0.028446388244628903,"x":0.061269147480530181}]
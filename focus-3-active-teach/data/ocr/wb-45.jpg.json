[{"h":0.018895347913106209,"x":0.021786492315042479,"text":"3.9","w":0.039215686321258547,"y":0.0072674424799779036},{"w":0.2766884422302246,"text":"EXAM SPEAKING","y":0.0058139537444276135,"x":0.10675382086745841,"h":0.020436046123504581},{"y":0.0070833330388742066,"w":0.18082788467407229,"h":0.019166666666666665,"x":0.75816993746688521,"text":"STUDENT A"},{"h":0.014622093041737894,"x":0.010893261594105219,"y":0.074127907058566755,"text":"Student A, look below. Student B, go to page 136.","w":0.42701522827148436},{"h":0.011812015374501494,"y":0.10610465117203172,"text":"1 In pairs, ask and answer the questions.","w":0.32244007110595702,"x":0.013071907475343848},{"w":0.13507624626159667,"h":0.011676356792450049,"x":0.03703704161865698,"y":0.12790697672435725,"text":"Talk about sport."},{"w":0.36601306915283199,"text":"1 Have you ever disagreed with a decision from","y":0.14083333335463655,"x":0.037037042057570808,"h":0.013333333333333308},{"y":0.1554166668552488,"text":"a referee? What happened?","w":0.20915031433105469,"x":0.061002182340645597,"h":0.013333333333333308},{"y":0.17000000015835137,"h":0.013333332935968945,"x":0.03703704455365614,"text":"2 What's the hardest sport you've ever tried?","w":0.34858386993408197},{"w":0.15032679557800294,"x":0.06100218143213141,"h":0.011627906958262213,"y":0.18604651152813634,"text":"Why was it so hard?"},{"w":0.37472766876220703,"h":0.013081394831339521,"text":"3 Have you ever felt that you let your teammates","y":0.19912790718098727,"x":0.037037041762687226},{"w":0.25925924301147463,"h":0.013081394831339521,"text":"down in a sport? What happened?","y":0.2136627907384,"x":0.063180837426724493},{"x":0.51198257061287533,"y":0.14244186094188838,"w":0.38126361846923829,"text":"4 When was the last time you cheered your team","h":0.013081394831339521},{"w":0.28997093200683599,"h":0.013584574063618904,"y":0.15691961381129516,"x":0.53804052251093792,"text":"on as a supporter at a sporting event?"},{"y":0.17151162780720619,"h":0.011821705500284829,"x":0.51416122080159221,"w":0.40305011749267583,"text":"5 Why do you think sportspeople try to break world"},{"w":0.26579519271850593,"h":0.011627906958262213,"y":0.18604651178249676,"text":"records? Would you like to do this?","x":0.5381263687278931},{"y":0.24273255861630694,"text":"2 Look at the photo of an interesting journey. Take turns to talk about what you can see in your photos.","w":0.77559913635253896,"h":0.013100774685541827,"x":0.01307189783680208},{"y":0.25708333341712952,"h":0.011812015374501494,"w":0.49455337524414061,"x":0.037037044050042878,"text":"Talk about the people, the place and the other things in the photo."},{"y":0.51598837212294069,"x":0.013071895705476984,"text":"3","h":0.010174418290456066,"w":0.013071894645690916},{"y":0.51583333353632255,"text":"You and your friend are planning to take a gap year. Here are some of the places where you could work when you travel.","x":0.037037042160798991,"h":0.013333332935968945,"w":0.89324615478515634},{"x":0.037037053051850746,"w":0.5664487838745117,"text":"Talk together about the places and say which would be the most interesting.","h":0.011734495957692381,"y":0.5304166668237642},{"h":0.013081394831339521,"x":0.015250546244451844,"w":0.18736383438110349,"text":"4 Talk about a gap year.","y":0.84156976764004732},{"text":"• What are the advantages of having a gap year","h":0.014738372166951508,"w":0.37254901885986325,"x":0.037037038827148941,"y":0.85901162777562112},{"y":0.87354651194116173,"w":0.21132896423339842,"text":"before you go to university?","x":0.063180831145828051,"h":0.013120154539744022},{"h":0.013333333730697561,"x":0.037037035865902193,"y":0.88791666643016132,"w":0.39433551788330085,"text":"• What are the disadvantages of having a gap year"},{"w":0.20915031433105469,"h":0.013333333333333419,"text":"before you go to university?","x":0.065359485100267845,"y":0.90250000011851583},{"y":0.91708333328838199,"x":0.039215692859181889,"text":"• What would you like to do most during your","h":0.013333333730697561,"w":0.35511981964111328},{"w":0.32244007110595702,"text":"gap year and how would you organise this?","x":0.065359487831189889,"y":0.93166666683138755,"h":0.013100774685541716},{"text":"• Which places would you include on your itinerary?","x":0.51851850985368853,"w":0.40522876739501956,"y":0.85610465146514414,"h":0.013081394831339521},{"h":0.013081394831339521,"w":0.045751633644103951,"x":0.54248366050443408,"text":"Why?","y":0.87063953523590842},{"text":"• Would you rather take a gap year on your own or","w":0.39869277954101556,"x":0.51851853466667452,"h":0.013333333333333308,"y":0.88499999999623846},{"text":"with a friend? Why?","h":0.011753876209259051,"x":0.54466231193322079,"w":0.15032679557800288,"y":0.89958333322917416},{"h":0.011627906958262102,"x":0.90413943406890607,"y":0.96220930239296198,"w":0.026143789291381836,"text":"43"}]
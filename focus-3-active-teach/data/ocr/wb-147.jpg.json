[{"y":0.063803169388347958,"w":0.44226577758789065,"h":0.011778225791364894,"text":"4 Complete the sentences with a one-word quantifier in","x":0.015250557894507751},{"text":"each gap.","w":0.076382379531860362,"y":0.079720993249936645,"h":0.010616152558951097,"x":0.039150858927419492},{"x":0.063180828688983615,"h":0.011627906754774431,"text":"Lots of people find it difficult to eat healthily.","y":0.097383721089667086,"w":0.33333332061767573},{"h":0.010425354462051728,"y":0.1117597998358334,"w":0.1350762462615967,"text":"I'm sure there was","x":0.063180832468330159},{"text":"chicken in the","x":0.30065359658063506,"w":0.10457515716552734,"y":0.11175979970986438,"h":0.010425354462051728},{"w":0.054466228485107418,"x":0.063180828277417264,"text":"freezer.","y":0.12645348828927938,"h":0.011627906754774542},{"h":0.010174418012732001,"w":0.010893245935440062,"x":0.03921568650940415,"text":"2","y":0.14244186093064948},{"y":0.15697674465157974,"h":0.01017441801273189,"w":0.010893245935440062,"text":"3","x":0.03921568650940415},{"h":0.012000437872523251,"text":"Have you got","x":0.065311678816269952,"w":0.10031346321105958,"y":0.14225559494765938},{"y":0.15697674442750031,"x":0.065359478201409457,"w":0.034858386516571041,"h":0.01017441801273189,"text":"How"},{"h":0.010185329192275328,"y":0.14244186030281814,"text":"friends in London?","w":0.13943354606628416,"x":0.26797385993708306},{"y":0.1567973307776187,"x":0.20261438616704006,"h":0.013344454109121884,"w":0.2178649139404297,"text":"days off school do we get for"},{"h":0.011915629262025385,"text":"Christmas?","x":0.065313408174402662,"y":0.17136776656677977,"w":0.080702161788940421},{"y":0.18750000024145375,"x":0.039215686827481333,"text":"4","w":0.013071894645690918,"h":0.010174418012732001},{"x":0.056644877885822675,"h":0.010174418012732001,"text":"There aren't","y":0.18750000032018432,"w":0.098039216995239264},{"text":"cakes left - just three -","h":0.01308381945217918,"x":0.25708061256024395,"y":0.18750000048722326,"w":0.17211328506469725},{"text":"help yourself!","w":0.10246395111083983,"x":0.063147111118120519,"y":0.20191637621369496,"h":0.013318410210056641},{"x":0.039215686291539223,"h":0.010174418012732001,"text":"5","y":0.21656976756824642,"w":0.010893245935440068},{"text":"l've read a","x":0.056644882204328083,"y":0.21643035870660843,"w":0.08496731758117676,"h":0.011767315407212875},{"text":"positive reviews for that new","w":0.21132896423339845,"x":0.24618737008918309,"y":0.21643035894961038,"h":0.013344453313730464},{"w":0.25708061218261719,"h":0.011812169120349547,"text":"sushi restaurant in the High Street.","y":0.23255813964586858,"x":0.063180830019802417},{"y":0.25290697691296549,"w":0.010893245935440062,"h":0.01017441801273189,"x":0.01525054470657191,"text":"5"},{"text":"Use one of the words in brackets to write sentences","h":0.010174418012732001,"w":0.40522872924804687,"x":0.03921569567009435,"y":0.2543604654667444},{"x":0.039215694511649524,"h":0.013081394701425553,"y":0.26889534914274649,"w":0.21350761413574221,"text":"with the opposite meaning."},{"h":0.013081394701425664,"x":0.065359483323010184,"w":0.3246187210083008,"text":"He drinks a lot of fizzy drinks. (much \/ many)","y":0.28633720940800811},{"w":0.25490194320678711,"h":0.013081394701425442,"text":"He doesn't drink many fizzy drinks.","y":0.3023255817432795,"x":0.065359490161312192},{"x":0.039215686291539223,"y":0.31831395362975035,"w":0.010893245935440068,"text":"1","h":0.0087209300660808786},{"y":0.31686046522196154,"w":0.24400871276855468,"h":0.013081394701425664,"text":"I eat lots of meat. (many\/much)","x":0.061002178183623954},{"h":0.010174418012732001,"w":0.013071894645690918,"text":"2","x":0.039215686555150189,"y":0.34738372109901194},{"h":0.013092305085577571,"text":"There are some good restaurants near my house.","w":0.37472766876220703,"x":0.05446623566246938,"y":0.34737281085161786},{"text":"(some \/ any)","x":0.060957523354299534,"y":0.36322485897166734,"w":0.095949878692626958,"h":0.013375863718728009},{"x":0.039215699964641998,"w":0.32026142120361323,"y":0.39241034213791659,"text":"3 I drink lots of cola. (very little \/ very few)","h":0.013112913279656691},{"h":0.010174418012732001,"x":0.039215686809325925,"y":0.42296511674460291,"text":"4","w":0.013071894645690918},{"h":0.011740646330489102,"y":0.42285237681434007,"text":"My mother bakes a lot of cakes. (much\/many)","w":0.35729846954345701,"x":0.052287578445410363},{"h":0.013081394701425664,"x":0.039215689132067695,"text":"5 I had some cereal for breakfast. (any \/ many)","w":0.35294116973876954,"y":0.45203488382661283},{"w":0.013071894645690918,"text":"6","y":0.48255813970366312,"x":0.039215686555150189,"h":0.01017441801273189},{"y":0.48248540451872923,"w":0.39433551788330079,"h":0.013344453313730575,"x":0.061002169126614166,"text":"I used to eat lots of vegetables. (very little \/ very few)"},{"w":0.34858386993408208,"h":0.01178186271864734,"x":0.039215685947991796,"y":0.51292743953228637,"text":"7 I do lots of cooking at home. (much \/many)"},{"w":0.37254901885986336,"text":"6 Complete the text with much, many, a lot of,","y":0.54941860513838603,"x":0.015250548113641252,"h":0.013133521473735921},{"y":0.56330871024533813,"text":"lots of, (a) few, (a) little, some or any.","w":0.29022790908813473,"x":0.038989378481432378,"h":0.015286295288696738},{"y":0.58284883746033367,"h":0.013081394701425553,"x":0.041394338151593504,"text":"Although we meet a lot of different people","w":0.31590414047241211},{"w":0.34858386993408202,"x":0.041394337146248787,"h":0.013125036238033294,"y":0.59738372109042093,"text":"every day, finding a person we get on well with"},{"w":0.36601306915283199,"h":0.011732160299395056,"text":"and trust is not so easy. That might be the reason","y":0.61337209320691499,"x":0.039215683070642944},{"w":0.10021786689758302,"h":0.010174418012732001,"text":"I don't have1","y":0.62790697711282006,"x":0.039215684285413312},{"x":0.24174965222511133,"y":0.62759009692700474,"w":0.10037869453430179,"text":"close friends,","h":0.012261666686859019},{"w":0.045315904617309569,"h":0.014883813706907945,"y":0.64162785999385219,"x":0.035250545199141017,"text":"Just 2"},{"y":0.64386989135302852,"h":0.014595496246872397,"x":0.17647058555435488,"w":0.1895424842834473,"text":".We're all really busy so,"},{"w":0.17864923477172853,"h":0.013344454109121884,"y":0.65679733074854896,"text":"unfortunately, we have 3","x":0.041394338648994077},{"y":0.67296511643925805,"text":"opportunities to hang out together as often","w":0.32026142120361334,"h":0.013081394701425664,"x":0.04139434715963116},{"y":0.68890742289420881,"h":0.011676396997497895,"w":0.31590412139892582,"x":0.041394349794364127,"text":"as we would like to. However, every month"},{"y":0.7029545730646769,"x":0.041258734377141476,"text":"we try to find-","h":0.014148993726766923,"w":0.11138231277465821},{"y":0.70348837226180272,"text":"time to meet and","x":0.24618736853586828,"h":0.010174418012732001,"w":0.13507624626159662},{"x":0.041394343218867674,"w":0.29411764144897456,"text":"catch up on what's going on in our lives.","h":0.013081394701425664,"y":0.71802325611343443},{"h":0.011812169120349547,"x":0.039215688178403277,"w":0.12418300628662109,"text":"We don't need 5","y":0.73255813945207005},{"text":"to enjoy","h":0.011072911253762974,"w":0.069998936653137167,"x":0.2591181798960922,"y":0.73501586989685974},{"y":0.7485404504294817,"w":0.28104574203491212,"text":"ourselves - good company is enough.","x":0.041394343121977428,"h":0.011676396997497895},{"h":0.013081394701425553,"x":0.03921569573245904,"y":0.7630813955453627,"w":0.2047930145263672,"text":"I can't imagine not having ."},{"w":0.24400871276855468,"h":0.013081394701425553,"text":"friends at all. Even if I have very?","x":0.041394339203957922,"y":0.77761627922995591},{"y":0.79357798175090632,"x":0.039215694634397877,"text":"free time on my hands, I can always find an hour","h":0.011676396997497895,"w":0.35947711944580074},{"w":0.22875816345214844,"text":"to get together with my mates.","x":0.039215692375232918,"y":0.8094245204165128,"h":0.01179640963238604},{"text":"FOCUS 2 GRAMMAR REVIEW","x":0.51633987632263223,"w":0.43790847778320319,"y":0.0070892406525076002,"h":0.020527038701481426},{"h":0.016263552960800731,"w":0.32679737091064459,"x":0.48801743545971049,"text":"Present Perfect and Past Simple","y":0.06964136769913809},{"text":"We use the Present Perfect to talk about actions and events","w":0.4422657775878906,"x":0.48583878323764523,"h":0.010205936590963027,"y":0.097383721280697944},{"text":"which:","h":0.010648316995017781,"x":0.48574147711278931,"w":0.054660835266113261,"y":0.11458863229693539},{"x":0.48583879643070643,"text":"• finished in the past, but either we don't know when they","w":0.42701522827148436,"h":0.013344453313730464,"y":0.13219349458905105},{"text":"happened, or this information is not important:","h":0.013094729836331087,"w":0.33986927032470704,"y":0.14678899069752127,"x":0.50544663185289695},{"text":"My dad has been to many concerts.","x":0.50544662652784045,"y":0.16133720946176,"w":0.26143789291381836,"h":0.011723674665996775},{"x":0.49013320166313545,"y":0.1786531460943328,"h":0.013728059859351327,"w":0.41190650939941409,"text":"Common time expressions used with the Present Perfect:"},{"x":0.49019607926818581,"y":0.19766472043533867,"w":0.19825708389282221,"h":0.011676396997497895,"text":"• ever - used in questions:"},{"text":"Have you ever danced in a shopping centre?","y":0.21059216041255102,"w":0.32679737091064454,"h":0.013344453313730464,"x":0.50762528377125704},{"w":0.27886709213256838,"h":0.011800046559668598,"x":0.48801743781171142,"text":"• never - used in negative sentences:","y":0.2296511628290081},{"y":0.24418604662261278,"w":0.37254901885986325,"h":0.011627906754774542,"text":"My grandparents have never watched a film online.","x":0.50762527891429476},{"x":0.48801743173858286,"y":0.26146788989196534,"h":0.011787923998987759,"w":0.4357298278808594,"text":"• already and just - used in affirmative sentences, between"},{"text":"have and the past participle form of the main verb:","y":0.2747093026056826,"x":0.50762527705193283,"w":0.36819171905517578,"h":0.013081394701425442},{"text":"I have already read this book. They have just arrived.","x":0.50544661701246607,"h":0.011676396997497784,"y":0.29065888253082628,"w":0.38344226837158202},{"y":0.30942452052552438,"x":0.48801742778837592,"w":0.35511981964111333,"text":"• yet- used in negative sentences or questions,","h":0.011796409632386151},{"x":0.50326797388673072,"y":0.32267441868656621,"text":"at the end of the sentence:","w":0.20043573379516599,"h":0.011770952334495544},{"w":0.3028322410583496,"x":0.50544662707431098,"text":"She hasn't called yet. Has she called yet?","y":0.33569641383794879,"h":0.016047772016994477},{"w":0.41394332885742191,"x":0.48583878791333701,"y":0.36613844889124425,"text":"We use the Past Simple to talk about actions and events","h":0.010425354462051617},{"x":0.48366013723718992,"text":"which started and finished in the past. We often say when","y":0.37936046529993828,"h":0.011798833985444013,"w":0.42265792846679684},{"y":0.39330084285489275,"text":"they happened:","h":0.015723895787993936,"w":0.12230997085571294,"x":0.48568597165371341},{"y":0.40697674479514767,"text":"My dad went to a concert yesterday.","x":0.48366013308442568,"w":0.27450979232788097,"h":0.014624589278958489},{"x":0.4967320273281704,"h":0.011627906754774542,"text":"Affirmative","y":0.4418604653726127,"w":0.076252722740173307},{"x":0.71673701420308045,"text":"Negative","h":0.01180941030519822,"y":0.44176971338089177,"w":0.061079349517822346},{"text":"I\/You\/He\/She\/lt","h":0.011627906754774542,"w":0.11546840667724612,"x":0.49455337691736823,"y":0.48110465131011271},{"y":0.49241507996928746,"h":0.015169840439644422,"w":0.067839097976684526,"text":"We\/They","x":0.4965815411221115},{"w":0.058857398033142161,"x":0.64268459133184164,"h":0.011704398752551359,"text":"danced.","y":0.48688035870435464},{"h":0.011627906754774431,"x":0.71459695031340731,"y":0.46802325598307792,"w":0.041394333839416486,"text":"I\/You"},{"text":"He\/She","h":0.01356525914285267,"w":0.054723105430603103,"x":0.71664716227169689,"y":0.47940923084524867},{"x":0.71241830025311148,"h":0.013081394701425553,"w":0.045751633644103951,"y":0.49273255851774644,"text":"It\/We"},{"w":0.039215686321258492,"x":0.71459694937749707,"y":0.50726744220233944,"text":"They","h":0.013081394701425553},{"w":0.047930283546447794,"h":0.011627906754774431,"text":"didn't","y":0.47383720936486085,"x":0.78867102420353719},{"w":0.034858386516571027,"h":0.013081394701425442,"x":0.78649237502058156,"y":0.48691860504754314,"text":"(did"},{"x":0.7864923749334356,"text":"not)","y":0.50145348855575234,"w":0.034858386516571027,"h":0.011627906754774542},{"text":"dance.","y":0.48691860481135119,"x":0.86056644945570326,"h":0.013081394701425442,"w":0.054466228485107404},{"y":0.53336113429046139,"x":0.49673202644351205,"h":0.011697005191577015,"text":"Yes\/No questions","w":0.11546840667724606},{"h":0.0087900285028834624,"x":0.7189542498526279,"y":0.53336113416823827,"w":0.091503267288208012,"text":"Short answers"},{"y":0.57994186068840148,"h":0.010174418012732001,"text":"Did","w":0.028322439193725568,"x":0.49891067611119821},{"h":0.013081394701425664,"text":"l\/you","y":0.55959302363402552,"w":0.041394333839416486,"x":0.56862745129924608},{"text":"he\/she","w":0.052410821914672834,"h":0.01187694301398412,"x":0.56856583034924368,"y":0.57254990064167588},{"h":0.013081394701425553,"text":"it\/we","x":0.5686274522306185,"w":0.041394333839416486,"y":0.58575581420451972},{"text":"they","w":0.034858386516571138,"h":0.014534882648076675,"x":0.57080610055435055,"y":0.59883720969340348},{"h":0.011627906754774431,"x":0.6427015266559476,"y":0.57994186050342678,"text":"dance?","w":0.056644878387451247},{"x":0.71459694694811593,"y":0.55959302324238613,"w":0.19607843399047842,"h":0.013081395496817083,"text":"Yes, l\/you\/he\/she\/it\/we\/they"},{"x":0.71677559898137699,"h":0.011627906754774542,"y":0.57267441859935697,"text":"did.","w":0.030501089096069411},{"w":0.1938997840881348,"h":0.014534884238859513,"y":0.58575581381564767,"text":"No, l\/you\/he\/she\/it\/we\/they","x":0.71677559704453098},{"x":0.71677559926708112,"y":0.59883720916474548,"w":0.047930283546447794,"h":0.013081395496817083,"text":"didn't."},{"x":0.49673202569102498,"y":0.62645348859935701,"text":"Wh-questions","w":0.095860567092895532,"h":0.011627906754774431},{"text":"Where","x":0.49673202622222734,"y":0.65261627932610111,"w":0.050108933448791526,"h":0.011627906754774431},{"text":"did","x":0.56862745082233568,"y":0.65116279085786277,"w":0.0305010890960693,"h":0.013081394701425664},{"x":0.64270152977940953,"h":0.013081395496816972,"w":0.16557733535766606,"text":"l\/you\/he\/she\/it\/we\/they","y":0.65261627893521557},{"h":0.013081394701425664,"y":0.65116279089056628,"x":0.86274509954829592,"w":0.054466228485107515,"text":"dance?"},{"text":"Subject questions","w":0.11546840667724612,"y":0.67877907011790728,"h":0.010174418012732001,"x":0.49891067539231382},{"x":0.49673202686134871,"h":0.011627906754774431,"text":"Who","y":0.70494186072145004,"w":0.037037036418914815},{"h":0.010174418012732001,"text":"danced","y":0.70494186068840137,"x":0.57298475158896411,"w":0.054466228485107404},{"y":0.70475396171727644,"text":"in the shopping centre?","w":0.16339868545532221,"h":0.01181580564993634,"x":0.64488017592702307},{"h":0.010174418012732001,"text":"Common time phrases in the Past Simple:","x":0.50108933160743319,"w":0.28540304183959964,"y":0.73255813975816886},{"text":"yesterday, last (year), (three days) ago, when, in the past, then.","y":0.74562135108101013,"x":0.49891069216074541,"w":0.42483657836914063,"h":0.011676396997497895},{"y":0.77761627975154313,"x":0.48801743213594734,"h":0.014710659380253399,"text":"Spelling rules - the Past Simple form","w":0.28322439193725585},{"h":0.012183317450109032,"y":0.79623392286017436,"text":"Regular verbs","x":0.49012379333972889,"w":0.098183784484863312},{"w":0.42701522827148436,"h":0.01334445371142623,"x":0.49019608245104079,"y":0.81234361963330415,"text":"The rules for forming the Past Simple form of regular verbs"},{"w":0.43355117797851561,"text":"are the same as those for the past participle form of regular","y":0.8269391159153906,"x":0.49019608679142479,"h":0.01334445371142623},{"x":0.49012475730550564,"text":"verbs.","w":0.045894274711608896,"h":0.010463576201501734,"y":0.8428786770833725},{"x":0.48801743019881683,"w":0.10675380706787108,"h":0.01017441801273189,"y":0.86191860497134731,"text":"Irregular verbs"},{"w":0.42483657836914063,"x":0.48583879673590885,"text":"Many verbs have an irregular Past Simple form (e.g. write,","y":0.87781484566808787,"h":0.013344453711426119},{"x":0.48583878545108061,"y":0.89098837272634934,"w":0.41830062866210938,"h":0.014534882648076675,"text":"go, lose). There is a list of irregular verbs in the Students'"},{"text":"Book on page 152.","y":0.90697674429703135,"x":0.49019608272900206,"w":0.14379084587097168,"h":0.011705490824975406},{"x":0.89978213565382104,"y":0.95930232601460608,"text":"145","w":0.041394333839416486,"h":0.015988371390119216}]
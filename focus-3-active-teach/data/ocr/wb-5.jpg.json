[{"h":0.013389121338912124,"y":0.095815899635705026,"w":0.12581344604492189,"text":"DON'T MISS","x":0.026030369354359664},{"text":"TheSHOW WHAT YOU KNOW","x":0.026030376434114294,"w":0.18004337310791016,"y":0.132217573390355,"h":0.0087866108786610608},{"w":0.20390455245971681,"x":0.02603037273977277,"text":"tasks in the Vocabulary and Grammar","y":0.14225941418999499,"h":0.010460251046025104},{"text":"lessons serve as a warm-up and","w":0.17787418365478513,"y":0.15397489528054553,"h":0.008815802490362068,"x":0.028199568866750582},{"y":0.16276150634784914,"w":0.16919738769531251,"h":0.010203609705968786,"text":"revise vocabulary or grammar","x":0.026030372602090707},{"x":0.026030369459536934,"h":0.010460251046025104,"text":"students should already know.","y":0.17280334740350989,"w":0.17136659622192382},{"h":0.0072674420089402503,"w":0.13449023246765138,"x":0.023861172757497561,"text":"SHOW WHAT YOU KNOW","y":0.19912790695701243},{"y":0.21366279061572024,"h":0.0087209302511175313,"w":0.25596529006958008,"text":"1 Label the forms of transport. The first letters are given.","x":0.02169197855523157},{"h":0.0072832538493008414,"text":"3 h_","x":0.02819956690217856,"w":0.021691973209381103,"y":0.3589958159197042},{"y":0.3589958159197042,"x":0.10845987075406693,"w":0.019522775411605825,"h":0.0072832538493008414,"text":"4 d"},{"h":0.0072832538493008414,"y":0.3589958159197042,"text":"5 h","w":0.021691973209381099,"x":0.20607375345315468},{"y":0.40988372088461567,"x":0.028199573831077417,"h":0.0087209302511175313,"w":0.18004337310791016,"text":"The REMEMBER BETTER boxes"},{"h":0.0088936458571684529,"text":"provide tips on learning, remembering","x":0.028199569626974536,"y":0.4213389122335065,"w":0.20390455245971681},{"y":0.43012552319248076,"x":0.028199570713756436,"text":"and enriching vocabulary.","w":0.13665943145751952,"h":0.010460251046025215},{"x":0.023861169620794768,"h":0.008851075272181097,"text":"REMEMBER BETTER","y":0.45481171528942421,"w":0.10412147521972656},{"text":"Try to learn phrases rather than single words. This will","h":0.0087878271126846652,"x":0.023861167275855487,"y":0.4723837209694024,"w":0.23427331924438474},{"text":"help you in exam tasks where you have to fill in gaps.","w":0.23210411071777345,"x":0.023861179646536196,"y":0.48242677819784263,"h":0.0088522915062045904},{"x":0.023861174542044488,"h":0.0087866108786610608,"text":"Often the missing word will form a fixed phrase with","y":0.4912133891790682,"w":0.22776571273803711},{"text":"other words that appear before and after the gap.","x":0.023861175638688864,"y":0.50125523019770934,"w":0.21908893585205078,"h":0.0089191883677717243},{"text":"Complete the sentences with the correct form","w":0.21258134841918946,"x":0.023861172265459432,"y":0.51297071118727799,"h":0.0088316143307226591},{"w":0.22776571273803708,"h":0.0073124454610018486,"text":"of a phrase in bold from the extract in Exercise 1.","y":0.52175732200059033,"x":0.023861181185211341},{"y":0.53179916318714493,"w":0.21258132934570312,"h":0.008898511192289793,"x":0.047722354054552503,"text":"Everybody gets spots sometimes no matter how"},{"text":"often they wash their face. It just happens naturally","h":0.0088328305647462635,"w":0.22125812530517577,"x":0.04772235101335557,"y":0.54058577404724661},{"x":0.032404926403699984,"h":0.01039671718326074,"y":0.55070896341146269,"w":0.22150365829467775,"text":"1 All good things must come to an end. Nothing"},{"h":0.0088936462561953755,"x":0.032537963342626069,"w":0.08676789283752441,"text":"2 A couple should","y":0.56976744179304595},{"w":0.17787418365478513,"h":0.0087866108786610608,"text":"extremely well before they get engaged.","y":0.57991631784833408,"x":0.047722347145853876},{"x":0.19301248132354157,"y":0.58998095461716127,"w":0.056491308212280267,"text":"to qualify as","h":0.0089915790318444433},{"y":0.59874476992859216,"w":0.091106290817260738,"h":0.0075313807531380839,"text":"a lawyer or a doctor.","x":0.045553143745382697},{"h":0.0073063638918570151,"w":0.041214747428894041,"text":"4 Colin","x":0.032537963198061987,"y":0.60901162776006468},{"h":0.007306363891856904,"text":"to talk to","w":0.043383946418762198,"x":0.21691974052886909,"y":0.60901162771161521},{"text":"girls. He gets embarrassed very easily.","x":0.047722345065457202,"y":0.61757322183837815,"w":0.16702819824218754,"h":0.0088802664848550705},{"x":0.032537962790208229,"w":0.088937091827392567,"y":0.6279069766154427,"text":"5 I'm afraid | can't","h":0.0072674420089402503},{"h":0.0087209302511175313,"x":0.047722345059486651,"y":0.63662790682211579,"text":"with anyone who turns out to be untrustworthy.","w":0.20607374191284183},{"h":0.010174418493294812,"y":0.68313953491517432,"text":"The SPEAKING BANK lists the key","w":0.19739696502685544,"x":0.028199568498864257},{"h":0.010182932530486855,"x":0.028199569215052095,"text":"phrases from the Speaking lesson.","w":0.19305856704711913,"y":0.69330543945235235},{"w":0.086767892837524424,"text":"SPEAKING BANK","y":0.71947674424944119,"x":0.023861171802495952,"h":0.0087209302511175313},{"y":0.73546511615032639,"w":0.047722339630126953,"h":0.0072674420089402503,"x":0.023861173514654509,"text":"Treatment"},{"w":0.12798264503479004,"h":0.0073002823227120706,"x":0.021691976795692406,"y":0.74560669447148675,"text":"You need to take antibiotics."},{"w":0.10629066467285156,"text":"You need to put a fresh","y":0.76443514658476119,"x":0.021691976087290836,"h":0.0088206674264564855},{"y":0.77322175744486288,"text":"bandage \/ a plaster on it.","w":0.11279826164245604,"x":0.021691973589473418,"h":0.0087866108786610608},{"y":0.79205020925259173,"h":0.0075313807531380839,"x":0.021691978418097797,"text":"You need a few stitches.","w":0.10845986366271974},{"w":0.12147504806518555,"x":0.021691978570444075,"h":0.0088887805220472238,"y":0.81087866127502306,"text":"I need to check your blood"},{"w":0.093275489807128908,"h":0.0072674420089402503,"text":"pressure\/pulse, etc.","y":0.82122093021282638,"x":0.021691971934830363},{"w":0.099783077239990234,"h":0.0087209302511175313,"text":"I don't think you need","y":0.82994186038316209,"x":0.021691976727076429},{"x":0.023861175506677785,"y":0.84011627892285556,"w":0.11062906265258789,"text":"an X-ray \/ operation, etc.","h":0.0072674420089402503},{"w":0.11496746063232421,"h":0.0087866108786610608,"y":0.85899581598466201,"x":0.021691976110085137,"text":"I'm not going to give you"},{"y":0.86773255813797168,"h":0.0072674420089402503,"x":0.021691973779552322,"w":0.056399130821228029,"text":"an injection."},{"w":0.097613878250122077,"h":0.0088036389530453674,"y":0.87782426796030411,"text":"We need to bring the","x":0.021691977496414001},{"y":0.88661087863940236,"text":"swelling down.","w":0.069414315223693845,"h":0.0087866108786610608,"x":0.021691974853807441},{"y":0.89665271956114434,"h":0.0088705362136394239,"w":0.12581344604492189,"x":0.021691977555991625,"text":"You need to take painkillers"},{"y":0.90836820075486591,"x":0.02169197419702561,"text":"to ease the pain.","h":0.0046025104602509526,"w":0.073752703666687014},{"y":0.92426778249378727,"text":"You need to put ice \/","x":0.021691975481948303,"h":0.0088717524476630283,"w":0.095444679260253906},{"x":0.021691976262431415,"w":0.12798264503479004,"text":"ointment, etc. on your ankle.","h":0.0088060718201194987,"y":0.93305439323276496},{"h":0.0087866108786610608,"x":0.34490238894054231,"w":0.20607374191284172,"text":"The SHOW WHAT YOU'VE LEARNT","y":0.13221757313667692},{"text":"tasks in the Vocabulary and Grammar","h":0.010460251046025104,"w":0.20607374191284172,"x":0.34490238960033986,"y":0.14225941407492715},{"y":0.15397489551968868,"w":0.20390455245971684,"text":"lessons help students to check their","x":0.344902390093352,"h":0.0088158020913351454},{"h":0.010203609705968786,"x":0.34490239405839307,"y":0.16276150639024256,"w":0.20173534393310544,"text":"progress and be aware of their own"},{"w":0.047722339630126953,"h":0.0087209302511175313,"text":"learning.","x":0.34707158586100301,"y":0.1744186045934335},{"y":0.1991279068947901,"x":0.34490239194432593,"text":"SHOW WHAT YOU'VE LEARNT","h":0.0088218840595070125,"w":0.15835140228271483},{"w":0.15401301383972171,"text":"5 Find and correct the mistakes.","x":0.33839479716546078,"y":0.21506276148205128,"h":0.0073209594981940018},{"text":"1","x":0.34924078075610621,"w":0.013015184402465851,"y":0.23401162775234818,"h":0.0087209302511175313},{"h":0.0072674420089402503,"w":0.22125812530517586,"x":0.36442517096997162,"text":"I played rugby when I broke my arm. was playing","y":0.22674418594804924},{"text":"We went to the Alps in April, but we couldn't ski","w":0.21908893585205075,"x":0.36225596631114015,"h":0.0088413446019384168,"y":0.2338912134015273},{"text":"because the snow already melted.","h":0.0072783889132065349,"x":0.3665943633259815,"w":0.15401301383972166,"y":0.24418604636471586},{"h":0.010174418493294812,"text":"2 I watched the race when Hope won the gold medal","x":0.34924077749797311,"w":0.2451193046569824,"y":0.25145348825819758},{"w":0.12364424705505367,"text":"and broke the world record.","x":0.36659436391824324,"h":0.0075313807531380839,"y":0.26150627626315637},{"x":0.3492407840865131,"w":0.22776571273803708,"y":0.27029288689214437,"h":0.0087866108786611719,"text":"3 Were City beating Arsenal in last night's game?"},{"y":0.28779069762880172,"text":"4 The referee didn't concentrate when Burton","x":0.35140998474460028,"w":0.21041213989257812,"h":0.0088620221764472706},{"text":"touched the ball with his hand.","x":0.36659436065410361,"h":0.0075313807531380839,"y":0.29790794970532386,"w":0.13665943145751952},{"y":0.30668604638288444,"x":0.35140998320592515,"w":0.21475053787231452,"h":0.0072674420089402503,"text":"5 In yesterday's Brazilian Grand Prix, Lewis was"},{"h":0.0088608055433968547,"text":"finishing in second place.","x":0.36659436346655211,"y":0.31540697668645667,"w":0.11279826164245604},{"text":"6 Boxer Joe Foster was fighting over 100 opponents","x":0.3492407901126886,"h":0.0089264865699671958,"w":0.24295009613037111,"y":0.3241279068947901},{"x":0.36659436453523447,"text":"when he retired in 1994.","y":0.3328488370805589,"w":0.1084598636627197,"h":0.0073185270301467931},{"w":0.19088935852050781,"y":0.36482558143451871,"h":0.008814585857311652,"text":"GRAMMAR: Train and Try Again page 155","x":0.3752711526992546},{"text":"The REMEMBER THIS boxes focus on","x":0.34707158595163995,"y":0.40988372088461567,"w":0.20824295043945312,"h":0.0087209302511175313},{"y":0.42133891194106876,"w":0.14533621788024903,"h":0.0088936462561954865,"x":0.34490238755300645,"text":"useful language nuances."},{"w":0.091106290817260738,"h":0.0072674420089402503,"x":0.34490238756316999,"y":0.44767441845773925,"text":"REMEMBER THIS"},{"text":"Adverbs of manner tell us how we do an action. We form","y":0.46220930217866929,"w":0.25379608154296879,"x":0.34273319990096668,"h":0.0072674420089402503},{"h":0.0087209302511175313,"y":0.47093023247618548,"x":0.34273319638312411,"text":"adverbs by adding -ly to adjectives, or -ily to adjectives","w":0.24728849411010739},{"h":0.008874184915710237,"w":0.21258134841918946,"x":0.34490238701600179,"y":0.47949790804415082,"text":"ending in -y. (quick - quickly, cheeky - cheekily)."},{"text":"We make online friends very quick + ly.","x":0.34490238978865945,"y":0.48982558131339471,"h":0.0089191883677718353,"w":0.17787418365478519},{"h":0.0089191883677718353,"w":0.15618221282958983,"text":"The adverb from from good is well.","x":0.34490238404073653,"y":0.5012552302824963},{"h":0.0088535077402281948,"x":0.34490238957173974,"text":"How good + ly well do you know them?","w":0.17787418365478508,"y":0.51004184099724914},{"text":"Some irregular adverbs (early, fast, hard, high, late,","w":0.22559652328491214,"x":0.34490239287670504,"h":0.0072881191844221815,"y":0.52325581385502595},{"text":"long and low) have the same form as the adjective.","y":0.53179916316292009,"w":0.22342733383178703,"h":0.0088985111922899041,"x":0.34490238793768557},{"text":"It takes a long time to become close friends. (adj)","w":0.21908893585205075,"h":0.010174418493294812,"x":0.34490238771388776,"y":0.53924418593261614},{"x":0.34490239232298209,"text":"Making online friends ... doesn't take long at all. (adv)","y":0.55087209291707684,"w":0.24078090667724611,"h":0.0087209302511175313},{"x":0.3470715908273912,"text":"Speaking tasks in the exam format help","y":0.68313953491517432,"w":0.21041213989257807,"h":0.010174418493294812},{"x":0.34490238248092425,"w":0.20824295043945312,"y":0.69330543918050569,"text":"students to prepare for their exams.","h":0.010182932929513777},{"h":0.010230368849622695,"w":0.075921907424926771,"x":0.35140997777705224,"text":"L EXAM SPEAKING","y":0.71947674426594943},{"text":") EXAM SPEAKING","y":0.74127906962052981,"h":0.0072674420089402503,"x":0.46637744290055094,"w":0.060737524032592805},{"y":0.13221757313667692,"x":0.67028199124593668,"text":"The SHOW THAT YOU'VE CHECKED","w":0.21258134841918952,"h":0.0087866108786610608},{"x":0.6702820008718029,"h":0.0088243165275541102,"y":0.14389534875525523,"text":"section in the Writing lessons is","w":0.1735357856750489},{"y":0.15397489526601071,"w":0.19739696502685544,"text":"a useful checklist that accompanies","x":0.67028199224253771,"h":0.008815802490361957},{"w":0.11930584907531738,"h":0.010203609705968786,"x":0.6702819983473739,"text":"the final writing task.","y":0.16276150634784914},{"y":0.19186046503713106,"w":0.16268980026245117,"h":0.0073027147907592793,"text":"SHOW THAT YOU'VE CHECKED","x":0.66811280041253951},{"x":0.66594359715295726,"y":0.20494186031048778,"w":0.17136659622192385,"h":0.0088656708785180838,"text":"Finished? Always check your writing."},{"x":0.6659436049521823,"y":0.21366279073684424,"w":0.17570497512817373,"h":0.0087209302511175313,"text":"Can you tick \/ everything on this list?"},{"h":0.0072674420089402503,"w":0.13665943145751946,"text":"In my 'for and against' essay:","x":0.6659436048515005,"y":0.22965116266195429},{"w":0.19739696502685544,"h":0.0087209302511175313,"text":"• the first paragraph begins with general or","x":0.66594360320602264,"y":0.24127906970971258},{"x":0.67678958742322948,"h":0.0072674420089401393,"y":0.25145348835236137,"w":0.15184381484985354,"text":"factual comments about the topic."},{"y":0.26017441845002265,"text":"• the first paragraph ends with a statement that","w":0.21475053787231446,"h":0.008863238410470875,"x":0.66594359957432725},{"w":0.1475054168701172,"text":"mentions both sides of the issue.","h":0.0075313807531380839,"x":0.6767895933726058,"y":0.27029288710508936},{"h":0.0089094580965560777,"y":0.28033472788656089,"x":0.66594360576557809,"w":0.21475053787231435,"text":"• the second paragraph presents arguments for"},{"y":0.2891213387708873,"w":0.19739696502685555,"text":"the topic and supports them with examples.","h":0.0088437774690126592,"x":0.67678959019083829},{"y":0.29941860456920866,"w":0.22342733383178714,"text":"• the third paragraph presents arguments against","h":0.0087209302511175313,"x":0.66594360268822783},{"text":"the topic and supports them with examples.","x":0.67678959490606017,"y":0.3095930231270706,"h":0.0072674420089401393,"w":0.19522775650024415},{"h":0.0088231002935305058,"text":"• the final paragraph includes a summarising","w":0.20173534393310555,"x":0.6659436053382195,"y":0.31966527184510962},{"x":0.67678959281888285,"y":0.32845188293026872,"w":0.16268980026245117,"h":0.0073039310247827727,"text":"statement and my personal opinion."},{"text":"• I have not used contractions (e.g. I'm \/ aren't\/","y":0.33849372383286402,"w":0.2190889358520508,"h":0.0088899971550977508,"x":0.66594359783680912},{"text":"that's) or abbreviations (info \/ CU \/ v. good).","h":0.010174418493294812,"x":0.67678958975915915,"y":0.34593023244424415,"w":0.19305856704711921},{"text":"• I have checked my spelling.","x":0.6659436056208381,"y":0.35899581602099917,"w":0.13449023246765135,"h":0.0087866108786611719},{"x":0.66594360109286388,"y":0.37354651162634389,"w":0.12364424705505372,"text":"• My text is neat and clear.","h":0.0072674420089402503},{"text":"Thestar coding system shows the","w":0.19522775650024415,"h":0.0087866108786611719,"x":0.672451200112134,"y":0.41129707110343117},{"x":0.6724512024461814,"text":"different levels of difficulty ofthe","w":0.19088935852050781,"y":0.42005813956633709,"h":0.010174418493294701},{"y":0.43168604664769705,"h":0.0088997274263133974,"x":0.67028199337448824,"w":0.1930585670471191,"text":"activities in the Grammar lessons."},{"w":0.24728849411010734,"x":0.68112798324140333,"y":0.45930232542676674,"text":"*Complete the second sentence with must, might or","h":0.0088985115913167157},{"h":0.0072674420089402503,"text":"can't.","w":0.026030368804931703,"x":0.68329718016730989,"y":0.46802325561859193},{"x":0.69414317289545768,"w":0.11930584907531738,"y":0.47819767427169269,"h":0.0072674420089402503,"text":"It's possible that's our taxi."},{"w":0.12364424705505372,"h":0.0072674420089402503,"text":"2 I'm sure that's our plane.","x":0.68112798647789619,"y":0.48691860452241942},{"h":0.0043604649260452488,"text":"3m se those aren't","w":0.10629066467285153,"x":0.68112798122105855,"y":0.49563953515126902},{"text":"That might be our taxi.","w":0.10195227622985836,"h":0.0072674420089402503,"y":0.47819767432014215,"x":0.82212581586193267},{"text":"That","y":0.48691860450425084,"w":0.023861169815063477,"h":0.0072674420089402503,"x":0.82212581462247547},{"y":0.48691860452241942,"text":"be our plane","w":0.058568329811096165,"h":0.0072674420089402503,"x":0.87201735426473392},{"y":0.49563953515126902,"x":0.82212581642604821,"w":0.028199563026428232,"h":0.004360464726531843,"text":"Those"},{"x":0.87632611842792696,"text":"be our bags.","y":0.49410287119006246,"h":0.0088872801808632662,"w":0.054289193153381321},{"x":0.69848156406574091,"y":0.50290697659727401,"w":0.041214747428894083,"text":"our bags.","h":0.0072674420089402503},{"x":0.68112798218981563,"w":0.16268980026245117,"h":0.0075313807531380839,"y":0.51
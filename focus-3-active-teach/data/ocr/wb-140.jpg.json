[{"text":"CAAM SPCANING","h":0.011627906783487796,"w":0.27571115493774412,"y":-7.2159833663931749e-11,"x":0.14879649854863344},{"x":0.072210068772335212,"text":"In pairs, ask and answer the questions.","w":0.31072208404541013,"h":0.011678567862609568,"y":0.060995850447555622},{"x":0.076586441113388054,"y":0.082848837448808887,"w":0.22757110595703126,"h":0.010174418089300752,"text":"Talk about the environment."},{"x":0.076586438967617382,"y":0.097383721418516922,"h":0.011744909167784368,"w":0.42669582366943359,"text":"1 What do you think is the most serious environmental"},{"text":"issue the world is facing? Why?","x":0.10065645504301748,"y":0.11037344388941295,"w":0.23851203918457034,"h":0.013278008694470711},{"text":"2","y":0.12500000008810153,"w":0.010940918922424311,"h":0.010174418089300752,"x":0.076586433208372093},{"w":0.35448577880859372,"h":0.013278007903039679,"x":0.10284464149285842,"text":"How can teenagers influence politicians on the","y":0.12489626581878821},{"y":0.13941908678509651,"w":0.20568927764892575,"h":0.0132780086944706,"text":"subject of climate change?","x":0.10065645734621541},{"x":0.076586433408955587,"y":0.15406976763897362,"h":0.010174418089300752,"w":0.010940918922424311,"text":"3"},{"text":"What forms of renewable energy are the most","y":0.15173171748078473,"x":0.10040688559278017,"w":0.35496585845947265,"h":0.01696821584741115},{"text":"popular in your country?","x":0.1028446427722475,"h":0.01327800829875514,"y":0.1684647303543606,"w":0.1881838035583496},{"y":0.097383721425046699,"x":0.56017506524994776,"w":0.33916847229003899,"text":"4 Have you ever been in danger because of","h":0.013081394686243808},{"x":0.58424509109458311,"y":0.1119186052004828,"text":"a rough sea, a strong current or a rising tide?","w":0.33698028564453131,"h":0.013081394686243808},{"w":0.13129102706909179,"x":0.58424507778565837,"text":"What happened?","y":0.12645348892141295,"h":0.013081394686243808},{"w":0.010940918922424325,"x":0.56017505487139174,"y":0.14098837225574823,"text":"5","h":0.0087209297908291683},{"x":0.57330416908606707,"text":"What natural disasters do you think will become","y":0.14098837233905959,"h":0.011708722965351304,"w":0.37417942047119146},{"y":0.15552325625378827,"text":"more common in the future? Why?","h":0.011696660765968425,"w":0.26039386749267579,"x":0.58643326622630976},{"y":0.19719763591447181,"text":"2 Look at the photo of a natural landscape. Take turns to talk about what you can see in your photos.","x":0.050269441574069373,"w":0.76817138671875007,"h":0.015270142139735654},{"x":0.076586458593366866,"h":0.011648412364152483,"text":"Talk about the people, the place and the other things in the photo.","y":0.21366279099216035,"w":0.503282241821289},{"x":0.063457332062885494,"text":"You and your friend are discussing ways you can help to stop climate change in your school. Here are some ideas.","h":0.013081394686243808,"y":0.47965116309776956,"w":0.85776802062988278},{"text":"Talk together about the different ideas and say which would be most useful and why.","h":0.013282832861935878,"w":0.63676147460937493,"x":0.076586450550891957,"y":0.49418604681869982},{"y":0.80954356862455923,"h":0.013278008298755251,"w":0.2319474792480469,"text":"4 Talk about climate change.","x":0.050328233607194545},{"w":0.32822757720947271,"x":0.074398243123928967,"h":0.0132780086944706,"text":"• Are you worried about climate change?","y":0.82697095428081613},{"h":0.015472928122366225,"x":0.098348023174624793,"y":0.84110074538994151,"w":0.12496697425842285,"text":"Why?\/Why not?"},{"text":"• What do you do at home to help stop climate","h":0.013278008298755251,"w":0.3741794204711914,"x":0.07439825943070616,"y":0.85601659762151594},{"x":0.10277609952549728,"h":0.01338754709330825,"w":0.065782594680786136,"y":0.87048645879721342,"text":"change?"},{"w":0.34573303222656249,"x":0.074398258722604846,"y":0.88506224050109328,"text":"• Is it easy to recycle things where you live?","h":0.013278008298755251},{"w":0.12488122940063477,"h":0.015131479476992005,"text":"Why?\/Why not?","y":0.89941100463198098,"x":0.098390895718922164},{"w":0.35667396545410157,"h":0.013278008694470711,"x":0.56455142321751506,"y":0.82406638999263915,"text":"• What sources of renewable energy are used"},{"x":0.58862144229991775,"text":"in your country?","y":0.83858921170351752,"w":0.12472647666931147,"h":0.011701485724864846},{"text":"• What are the dangers to animals from climate","y":0.85311203303573391,"x":0.56455142983806683,"h":0.0132780086944706,"w":0.36980304718017576},{"y":0.86746618142162812,"x":0.59070474974683906,"h":0.012160660518155564,"text":"change?","w":0.065855269432067876},{"h":0.01308139547767484,"x":0.052516411362543848,"y":0.95058139521174401,"w":0.037199125289917,"text":"138"}]
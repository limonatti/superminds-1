:0.40481399536132812,"x":0.067833701261713772,"text":"a dictionary or online for more interjections like these.","y":0.66556016577548582},{"text":"2 Read REMEMBER THIS. Complete the dialogues with","w":0.44420131683349606,"x":0.052516414559181754,"h":0.013278008694470711,"y":0.70041493738838756},{"text":"the correct words fromthe box.","h":0.011806426305493889,"x":0.078774626659560532,"w":0.25382930755615235,"y":0.71493775941746196},{"x":0.080962805296769816,"y":0.7398255818184355,"w":0.31072208404541019,"h":0.016191015599674285,"text":"(achoo phew oops ouch wow)"},{"x":0.10065647607460136,"y":0.76453488401541614,"w":0.38949668884277344,"h":0.011813663545980457,"text":"A: Look! I fell over and didn't scratch or cut myself."},{"h":0.01180160174231315,"w":0.19474836349487307,"text":"B: Wow! That was lucky.","x":0.10065645526022206,"y":0.77906976770000913},{"w":0.046086721420288079,"h":0.0090391447929920599,"text":"1 A:","x":0.074330819487512301,"y":0.79489903201367351},{"x":0.2188183809516569,"h":0.0087209297908291683,"y":0.79505813985264739,"w":0.013129101991653458,"text":"!"},{"y":0.8095435686119733,"text":"B: Bless you. Here's a tissue.","w":0.22538291931152343,"h":0.011677361326098978,"x":0.098468281518563502},{"w":0.3785557937622071,"text":"2 A: Did you just put my ointment on your arms","h":0.013278008298755251,"x":0.074398255700953334,"y":0.82406639009765692},{"h":0.011701485724864624,"y":0.83858921146126963,"x":0.1269146656056433,"w":0.1684901428222656,"text":"instead of sun cream?"},{"y":0.85465116300476829,"w":0.017505470514297489,"text":"B:","h":0.010174418089300752,"x":0.10065645528989721},{"y":0.87053941903868726,"w":0.045951857566833496,"text":"3 А:","h":0.0088210458082776944,"x":0.074398251413519786},{"text":"_!I nearly dropped this bottle of","x":0.21225383383397059,"y":0.86918604672180044,"h":0.013081394686243919,"w":0.24945295333862302},{"h":0.010174418089300752,"text":"medicine.","w":0.076586432456970222,"x":0.129102846317102,"y":0.88517441888655102},{"x":0.098468271898512677,"y":0.89958506223971668,"w":0.24288839340209964,"h":0.010373443983402453,"text":"B: You should be more careful."},{"text":"4 A: This won't hurt.","y":0.9156976746520552,"w":0.17286651611328124,"h":0.010174418089300752,"x":0.074398254671295086},{"text":"B:","h":0.010174418089300752,"x":0.10065645581217542,"y":0.93023255832453577,"w":0.019693653583526607},{"text":"! What did you just say?","x":0.21881838245933088,"y":0.93023255848247044,"w":0.18380743026733398,"h":0.011676155185303738},{"x":0.061269146456766316,"y":0.95639534867368747,"w":0.026258206367492681,"text":"84","h":0.011627907179203367},{"text":"3 Choose the correct words.","w":0.23413566589355472,"h":0.011654443463843922,"x":0.56455142599742403,"y":0.031950207404460862},{"x":0.59080963852443336,"text":"1 You're bleeding again. We need to take \/ put \/","w":0.37417942047119135,"y":0.050872093572575716,"h":0.013081394686243808},{"y":0.064416473592166512,"h":0.016151203456261309,"x":0.61668444536604927,"w":0.26326183319091789,"text":"bring a fresh bandage on your arm."},{"w":0.36761486053466796,"x":0.59080964216154996,"y":0.079941860741907123,"text":"2 I'm afraid this cut is going to need \/ put \/ take","h":0.013081394686243808},{"h":0.011747322240805658,"text":"a few stitches.","w":0.10940918922424314,"x":0.61269146541705422,"y":0.094476744286734027},{"x":0.59080964263966496,"w":0.36542667388916017,"y":0.11037344387245562,"h":0.013278008694470711,"text":"3 The doctor checked \/ brought \/ put my blood"},{"w":0.25382930755615229,"h":0.011720785164734182,"text":"pressure and listened to my lungs.","x":0.61706784498195277,"y":0.12645348861812933},{"h":0.013081394686243808,"text":"4 Did you take \/ put \/ bring that ointment on your","w":0.38293216705322264,"x":0.59080962839899032,"y":0.14098837264234321},{"text":"elbow?","w":0.054783449172973619,"h":0.0089413417325474587,"y":0.15686653841830633,"x":0.61702840659952718},{"text":"5 Fortunately, I don't think you bring \/ take \/ need"
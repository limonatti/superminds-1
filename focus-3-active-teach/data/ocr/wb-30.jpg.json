[{"x":0.067538127837028464,"h":0.029069765521326674,"text":"2.8","w":0.067538123130798336,"y":0.043604652330698768},{"w":0.18147399902343755,"x":0.18921942901250413,"text":"SPEAKING","y":0.013177235809682997,"h":0.023064132931826076},{"w":0.26361654281616209,"y":0.058139535004946508,"h":0.013081394961037107,"text":"Asking for and giving an opinion","x":0.191721144750234},{"text":"• agreeing and disagreeing","x":0.18954248975053503,"y":0.074104912644439747,"w":0.22222221374511716,"h":0.011656952539550347},{"text":"Translate the phrases into your own language.","x":0.074074069345152871,"h":0.011764662946689985,"y":0.12645348867679307,"w":0.36601306915283205},{"h":0.013081394961037107,"text":"SPEAKING BANK","y":0.15261627919099308,"w":0.15250544548034667,"x":0.058823531072462812},{"x":0.058823531516690883,"w":0.16775598526000973,"y":0.17860116580963081,"h":0.013322231473771873,"text":"Asking for someone's"},{"text":"opinion","x":0.058707131315398849,"y":0.19307868137253437,"w":0.059056324958801275,"h":0.013551939139258895},{"text":"What do you think about ...?","w":0.21786491394042967,"x":0.058823532136539,"h":0.01177071413330788,"y":0.21220930268842109},{"y":0.23105745205978956,"w":0.13943354606628419,"h":0.011675105702370847,"text":"Giving an opinion","x":0.058823533720670514},{"text":"I think ...","w":0.071895422935485842,"x":0.056644881306403772,"h":0.011656952539550347,"y":0.24854288086802445},{"h":0.013322231076738467,"w":0.15904139518737792,"x":0.054466232101300104,"text":"I (just) don't think ...","y":0.26727726921287664},{"w":0.12239728927612306,"x":0.058627064947067764,"y":0.28401749933793718,"h":0.014813838453713646,"text":"If you ask me..."},{"text":"The thing is...","y":0.31831395366410353,"h":0.013081394961037107,"x":0.056644883377254693,"w":0.11328975677490234},{"x":0.058823531699120329,"text":"To be honest ...","w":0.11982570648193361,"y":0.33555370518099525,"h":0.011830015444537212},{"text":"Agreeing with an opinion","h":0.011750139860586817,"y":0.36761032490254264,"x":0.058823540315267507,"w":0.20043571472167968},{"h":0.011790077851078773,"x":0.056644879090013728,"w":0.06318082809448243,"text":"I agree.","y":0.38662790708764583},{"y":0.40450638037280562,"h":0.010754680554138196,"x":0.058532643609758385,"text":"That's true.","w":0.087727737426757824},{"y":0.42289206500925269,"w":0.087189769744873039,"h":0.01177400990787103,"text":"Absolutely!","x":0.058801630449995909},{"x":0.056644882892017884,"h":0.013081394961037107,"w":0.14814814567565918,"text":"Half agreeing with","y":0.44040697686541153},{"w":0.082932291030883773,"x":0.058751718372573161,"text":"an opinion","y":0.45471136903019505,"h":0.01208888998039559},{"h":0.010407993338884314,"text":"I'm not so sure about that.","w":0.20261436462402344,"y":0.4737718568047764,"x":0.058823539174916346},{"text":"I'm not convinced","y":0.50581395341599578,"w":0.13725489616394043,"h":0.010174418567717836,"x":0.058823534025872884},{"y":0.53745022748561144,"w":0.093867616653442398,"h":0.012308847298729275,"x":0.060909330099729077,"text":"Disagreeing"},{"w":0.1182249641418457,"text":"That's not true.","x":0.058556802741965439,"y":0.55511456119542768,"h":0.011864506533302732},{"h":0.011656952539550458,"w":0.17429193496704101,"text":"I'm sorry, I don't agree","x":0.058823533170074251,"y":0.57410491263474983},{"h":0.012742275600131636,"w":0.072284522056579592,"text":"with you.","x":0.058628981698955425,"y":0.58810560613716756},{"text":"Disagreeing strongly","x":0.058823531727676584,"w":0.16339868545532227,"h":0.014628071272800081,"y":0.60610465169137373},{"text":"No way! (informal)","y":0.62354651160378383,"w":0.13943354606628416,"h":0.013081394961037107,"x":0.061002181723575397},{"w":0.20479303359985349,"text":"Are you kidding? (informal)","x":0.061002174303922206,"y":0.65695253941991583,"h":0.011656952539550347},{"x":0.058823533911006434,"y":0.67441860479055704,"text":"I'm afraid I completely","w":0.17211328506469725,"h":0.013081394961037107},{"x":0.060901284445781627,"w":0.069918565750122064,"h":0.012175095468436981,"y":0.69013338246885481,"text":"disagree."},{"h":0.011733197252716709,"text":"Not having strong opinions","x":0.061002185996762145,"w":0.21350761413574215,"y":0.7077435469529888},{"w":0.16993463516235352,"text":"Personally, I don't feel","x":0.061002181275032402,"h":0.013322231076738356,"y":0.72522897600773961},{"x":0.060585804372279756,"w":0.18154287338256833,"y":0.73753505286021703,"h":0.016680365696636335,"text":"strongly one way or the"},{"y":0.75581395367641258,"text":"other.","x":0.061002179510555088,"w":0.045751633644104006,"h":0.010174418567717836},{"text":"WORLD WAR 3","x":0.22875816988013972,"h":0.011712622979995424,"y":0.79933388840135089,"w":0.11764705657958988},{"y":0.80668604701464208,"x":0.084967316944013119,"w":0.013071901798248298,"h":0.049418602656762345,"text":"WESTLAND"},{"h":0.053779068437841526,"text":"EASTLAND","x":0.49237472406800464,"y":0.80377906976000368,"w":0.015250551700592085},{"text":"2 Choose the appropriate response.","x":0.56209151097485899,"h":0.011736827726467336,"w":0.29411764144897468,"y":0.031976744490746611},{"x":0.58605664401376101,"text":"1 Tim:","y":0.049418605149661343,"w":0.063180828094482444,"h":0.011780395793676512},{"w":0.27886709213256833,"y":0.049418604897723317,"h":0.011780395793676623,"text":"What do you think about the fact that","x":0.67320262229972883},{"text":"professional footballers are paid so much","x":0.67320261130977688,"y":0.062447960009182402,"w":0.30501089096069334,"h":0.013322231870805279},{"y":0.077034884132853532,"w":0.061002178192138712,"h":0.013081394961037107,"x":0.67320261526122904,"text":"money?"},{"w":0.041394333839416597,"h":0.010174418567717836,"x":0.61220043708355965,"y":0.091569767405821345,"text":"Tom:"},{"text":"To be honest \/ No way, I think it's","y":0.091569767795010137,"w":0.24618736267089836,"x":0.67320261085772448,"h":0.011677526018204709},{"h":0.010174418567717836,"y":0.10610465116308876,"x":0.67320261561793071,"text":"ridiculous.","w":0.076252722740173362},{"h":0.011351648913533574,"w":0.07008380413055415,"x":0.58805178072518671,"y":0.11859743131745482,"text":"2 Jane:"},{"text":"Do you think we will win the next Worlo","x":0.67320261473866705,"y":0.11906744394218483,"h":0.011746509386836079,"w":0.29193899154663094},{"h":0.010174418567717836,"w":0.045751633644103951,"text":"Jean:","x":0.61220043666378676,"y":0.14680232557563722},{"h":0.014534882760663392,"x":0.67102396586332458,"text":"Cup?","w":0.043572983741760329,"y":0.13226744248594735},{"text":"Are you kidding? \/ That's true. With our","w":0.29193899154663083,"x":0.673202616808384,"h":0.013081394961037107,"y":0.14680232593881282},{"text":"current team we don't have a chance.","y":0.16133720934501705,"w":0.27886709213256844,"h":0.010186520940953736,"x":0.67320262415884269},{"text":"3","w":0.010893245935440055,"h":0.010174418567717836,"x":0.5882352943253083,"y":0.17441860479680971},{"x":0.61220043594884654,"text":"Paul:","y":0.17441860450005586,"w":0.041394333839416486,"h":0.010174418567717836},{"x":0.61437908469736446,"text":"Paula:","y":0.18895348851773996,"w":0.047930283546447683,"h":0.010174418567717725},{"x":0.67320262439421374,"w":0.20697166442871084,"y":0.17441860495586292,"text":"Aerobics is only for women.","h":0.011676315860287723},{"h":0.011712622979995535,"w":0.25054466247558593,"x":0.67538126666525711,"text":"That's not true \/ I agree. There are","y":0.18895348860411865},{"text":"several men in my class.","y":0.20191507084822136,"h":0.011747719544752955,"x":0.6732026187070913,"w":0.17864923477172856},{"y":0.21589660714305758,"x":0.58805042799841312,"text":"4 Sarah:","w":0.078801107406616278,"h":0.01152073910194662},{"x":0.66448801606965047,"h":0.013081394961037107,"y":0.21511627933634192,"text":"Oh come on, referee! That was clearly","w":0.2897603416442871},{"y":0.22965116314811518,"w":0.215686264038086,"text":"a foul. Don't you think, Sam?","x":0.67320261953324456,"h":0.013081394961037107},{"w":0.041394333839416486,"h":0.010174418567717725,"x":0.61220043610316766,"text":"Sam:","y":0.24418604640291441},{"y":0.24418604685266521,"w":0.30065359115600587,"h":0.01162790636734401,"text":"I'm not convinced \/ Absolutely. It looked","x":0.67320261242853319},{"y":0.25726744216516517,"w":0.078431372642517094,"h":0.011675105702370847,"text":"OK to me.","x":0.6753812645502012},{"h":0.01100132923936159,"y":0.27138887003021095,"w":0.069979071617126576,"text":"5 Matt:","x":0.58810414680686951},{"text":"I just don't think we do enough sport at","w":0.29847494125366203,"y":0.27180232593454501,"h":0.011711412425045253,"x":0.6688453130696107},{"w":0.054466228485107404,"x":0.67320261492411304,"text":"school.","y":0.28633720941163532,"h":0.010174418567717836},{"text":"Mary:","x":0.61437908549276277,"w":0.045751633644103951,"y":0.29941860510121177,"h":0.011627906367343899},{"x":0.67538126918674268,"h":0.01171262337702883,"text":"The thing is \/ l agree I don't really enjoy","y":0.29933388829476182,"w":0.29193899154663083},{"h":0.013081394961037107,"w":0.16557733535766606,"x":0.6732026164896493,"text":"sport, so I don't mind.","y":0.31250000041192327},{"y":0.32677844176648696,"h":0.010687301994660503,"w":0.065535688400268466,"text":"6 Neil:","x":0.58814718929557874},{"h":0.011627906367344121,"text":"Helen thinks motor-racing is too","x":0.67538126948594113,"w":0.23747276306152343,"y":0.32703488397718061},{"y":0.34138218150378608,"x":0.67320261178489149,"w":0.25272331237792967,"h":0.011815492755467449,"text":"dangerous and should be banned"},{"h":0.011865380006864767,"y":0.35453242635029147,"text":"Noel:","w":0.045886898040771507,"x":0.61213280332252251},{"y":0.35465116313173495,"x":0.66230936624116932,"h":0.011710202267128267,"w":0.30065359115600587,"text":"Well, l agree \/ If you ask me the drivers"},{"h":0.013322231473771873,"text":"have a choice, don't they? They don't","x":0.67538127107242307,"y":0.36761032477963018,"w":0.27886709213256833},{"y":0.38218151550182,"x":0.675381268746854,"text":"have to take part.","w":0.13071894645690918,"h":0.013322231076738467},{"x":0.58823529433492017,"h":0.010407993338884314,"text":"7 Jack:","y":0.39675270627336046,"w":0.065359477996826176},{"text":"I'm glad they have decided to let girls","h":0.011677526018204598,"x":0.67320261530588199,"y":0.396752706271572,"w":0.28322439193725579},{"text":"play in the school football team, aren't","w":0.28540304183959964,"x":0.67538126750612604,"y":0.40988372096061521,"h":0.013097128205057151},{"x":0.67320261457357555,"h":0.01162790636734401,"text":"you?","y":0.42441860481051408,"w":0.039215686321258603},{"text":"Jackie: Personally, I don't feel strongly one way","x":0.61437909047900763,"y":0.43750000035741743,"w":0.35511981964111328,"h":0.013081394961037107},{"text":"or the other \/ Absolutely. I suppose it's","w":0.28758169174194337,"x":0.6753812701057893,"y":0.45203488413285353,"h":0.013081394961037107},{"w":0.2897603416442871,"h":0.013322231473771984,"text":"good for the girls who are into football.","y":0.4650291425686981,"x":0.6753812691833031},{"y":0.47960033301230287,"w":0.20479301452636722,"h":0.013322231870805279,"x":0.67538126915293839,"text":"I'd prefer to go to the gym."},{"text":"3 Complete the dialogue between Scott and Owen.","h":0.011832435760370963,"w":0.41612197875976564,"x":0.56427016946543307,"y":0.50124895925469637},{"x":0.5904139531182715,"h":0.011796129037696668,"y":0.5158201496910334,"w":0.20261436462402338,"text":"The first letters are given."},{"h":0.013322231076738467,"x":0.58823530099691179,"w":0.37037036895751962,"text":"Scott: Did you see that there's going to be a big","y":0.53330557891873831},{"w":0.28540304183959952,"h":0.011716253453746273,"text":"boxing match at the new stadium next","y":0.54787676944891794,"x":0.65141613089574113},{"x":0.6492374753066652,"y":0.56104651187631283,"w":0.21568626403808588,"text":"month? Do you fancy going?","h":0.013081394961037107},{"y":0.57558139520805418,"w":0.36819171905517578,"h":0.011627907161410933,"text":"Owen: Boxing? No thanks. In my opinion, boxing","x":0.59041394746224507},{"h":0.011670265070703123,"w":0.27450979232788086,"text":"isn't even a sport. I think it's horrible.","x":0.64923748103286416,"y":0.5886627908085762},{"h":0.01170657179337764,"text":"Scott: Really? Well, I'm 's_","w":0.21786491394042973,"x":0.58823529538998864,"y":0.60319767477175423},{"text":"..I think it's really","x":0.8409586077503135,"y":0.61773255858958387,"w":0.12854029655456545,"h":0.011742878516051825},{"x":0.64923748497639333,"w":0.33115467071533211,"y":0.63072439615171949,"text":"exciting to watch. Boxers are skilled athletes.","h":0.011717464008696665},{"x":0.65141612720339592,"y":0.65843023297006287,"w":0.31808277130126961,"h":0.013093497334273008,"text":"men try and kill each other is not what I call"},{"x":0.64923747152439371,"y":0.67277268936074375,"w":0.30065359115600587,"h":0.011820333784168469,"text":"exciting. Personally, I don't find violence"},{"h":0.01174166835813506,"w":0.15250544548034672,"text":"_. People have been","x":0.80392156847260821,"y":0.7005813958473357},{"w":0.26361654281616209,"h":0.013322231473771873,"text":"playing and watching violent sports","x":0.65141612681268868,"y":0.71357202331032821},{"x":0.64923747827938971,"h":0.011682367046905728,"y":0.72814321399529358,"w":0.16993463516235352,"text":"for thousands of years."},{"y":0.74271440463269656,"text":"_, but that doesn't make","w":0.18300653457641602,"h":0.011656952539550347,"x":0.771241827700899},{"w":0.3180827713012695,"text":"it right. People have been fighting wars for","h":0.013081394961037107,"x":0.64923748602692488,"y":0.75436046509215582},{"h":0.013081394961037107,"y":0.76889534886759192,"x":0.65141612660294412,"w":0.27450979232788086,"text":"thousands of years. Do you think war"},{"y":0.7834302326690411,"w":0.11546840667724612,"text":"is exciting too?","h":0.011740458597251591,"x":0.6492374758552768},{"y":0.7964196501575912,"w":0.2287581634521485,"text":"Scott: Of course not, but 5l d","h":0.011719884324530416,"x":0.5904139504090018},{"text":"t","x":0.86928104579589638,"y":0.79796511629932487,"h":0.0087209299740247381,"w":0.010893245935440166},{"h":0.010174418567717836,"text":"_you","w":0.037037036418914759,"x":0.92374727688858171,"y":0.79941860483920313},{"x":0.6514161254337284,"y":0.81099084102245411,"w":0.31590414047241211,"h":0.011683577204822604,"text":"can compare boxing to war. For a start, the"},{"text":"boxers have a choice. They don't have","y":0.82164068258457346,"w":0.28381282806396491,"h":0.016969710960674012,"x":0.65111558051338192},{"text":"to fight.","h":0.011763203451774396,"x":0.64920847630901379,"y":0.83859514226684539,"w":0.061060171127319318},{"text":"Owen: Well, if you 'a","x":0.59259259798240693,"y":0.85174418645843486,"w":0.16122003555297848,"h":0.013081394961037107},{"x":0.80392156915170587,"y":0.85465116297625865,"w":0.021786491870880109,"text":"m","h":0.0072674413803316407},{"text":"_, there's","w":0.067538123130798322,"h":0.011786446980294518,"x":0.86928104821128926,"y":0.85303913403767984},{"x":0.6514161343766155,"text":"always a choice whether it's boxing","w":0.25925924301147463,"y":0.86627907017936523,"h":0.013081394961037107},{"y":0.88357134936698101,"h":0.007566603693140217,"x":0.65136803424061096,"w":0.050205106735229488,"text":"or war."},{"w":0.38344226837158202,"x":0.59041394590135488,"y":0.89383846796303956,"text":"Scott: Well, perhaps. Hey, how about this - maybe","h":0.013322231473771873},{"h":0.01308986686052227,"text":"instead of fighting wars, we could put world","w":0.32244007110595696,"x":0.64923747817251187,"y":0.90697674416192331},{"x":0.64923748167994544,"w":0.3246187210083008,"y":0.9213155700467841,"h":0.013322231870805279,"text":"leaders in the boxing ring. I bet you'd watch"},{"w":0.034858386516571027,"h":0.010174418567717836,"text":"that.","x":0.65141612226459034,"y":0.93604651151919327},{"h":0.011627907161410933,"text":"28","w":0.026143789291381836,"x":0.063180828883720855,"y":0.95639534867220166}]
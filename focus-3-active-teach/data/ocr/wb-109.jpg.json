15258487952296,"text":"suspicion"},{"x":0.80610021755670092,"h":0.0087209299740247381,"y":0.13372093041027444,"text":"time","w":0.037037036418914759},{"w":0.37472766876220698,"h":0.01162790636734401,"y":0.15552325607020401,"text":"A true favour is when you ask for nothing in return","x":0.53376906946784319},{"x":0.50762527492038811,"y":0.16985845140258349,"w":0.38997821807861333,"h":0.011827594731669944,"text":"1 |like doing volunteer work because | feel like I'm"},{"x":0.5337690649232375,"y":0.18442964196731204,"text":"making a real","w":0.10239650726318361,"h":0.011791288008995648},{"text":"2 The woman in the shop gave me back too much","x":0.50762527522559064,"y":0.1990008329548909,"w":0.38779956817626959,"h":0.013322231076738356},{"text":"money. When I tried to explain the mistake, I was","x":0.53376905771441396,"y":0.21357202325155478,"w":0.37037036895751962,"h":0.01171867416661343},{"x":0.53376906367062116,"h":0.0087753906535864568,"w":0.067538123130798322,"text":"met with","y":0.22814321396520887},{"h":0.011682367046905728,"y":0.22814321416002215,"x":0.69716775544620557,"w":0.12200435638427742,"text":"_. Unbelievable!"},{"text":"3 It costs nothing to do a good","w":0.24618736267089847,"y":0.24271440452368487,"h":0.011656952539550347,"x":0.50762526983557488},{"x":0.85824292836816785,"h":0.010912759417201157,"text":"such as","y":0.24236338791039369,"w":0.056934623718261634},{"h":0.013322231076738356,"text":"help somebody with their bags or hold a door open","y":0.25562031668357443,"x":0.53376905483706527,"w":0.38779956817626948},{"y":0.27014331115986234,"text":"for them.","w":0.072903547286987336,"h":0.012040809628171445,"x":0.5333038567439683},{"h":0.011748929702669941,"text":"4 Don't rush, Will. Take","x":0.50762527547466241,"w":0.1873638343811036,"y":0.28476269785115715},{"text":"to do it properly","y":0.28633720965547527,"x":0.79520696936376023,"w":0.12636165618896489,"h":0.011747719544752955},{"y":0.30087209324942177,"x":0.53376906231668297,"h":0.0088697885295730972,"text":"or don't do it at all!","w":0.14596949577331542},{"h":0.013322231870805279,"y":0.31390507909727416,"text":"5 When somebody doesn't thank me for helping them,","x":0.50980394041438648,"w":0.42265792846679684},{"w":0.20261436462402349,"h":0.011656952539550347,"x":0.53376907378820604,"y":0.32847626962745402,"text":"I always feel they've taken."},{"w":0.05010892868041994,"text":"of me.","y":0.327034883696807,"x":0.83442265937075588,"h":0.013098338760007544},{"x":0.50544662327807321,"text":"6","w":0.019607843160629246,"h":0.011627906367343899,"y":0.34302325603144435},{"x":0.52723311627068303,"w":0.33333332061767573,"h":0.011681156888988853,"y":0.34302325611865359,"text":"Look at that poster. The owners are offering"},{"w":0.27886709213256844,"x":0.6492374736141806,"text":"of f200 to the person who finds their","y":0.35595337213226053,"h":0.014686162029078909},{"x":0.53591701144349391,"y":0.37345745401948327,"w":0.056706280708312962,"h":0.0088990451295012374,"text":"lost cat."},{"text":"7 When Alice agreed to go out with me on Saturday,","y":0.38509575335798285,"x":0.50762527146025083,"w":0.40740741729736329,"h":0.013322231473771762},{"x":0.5359477131634961,"y":0.40116279094423501,"text":"it really made my","w":0.12854030609130862,"h":0.011826384573752957},{"x":0.50980392166207555,"y":0.41569767460664497,"w":0.01525054454803465,"h":0.010174418567717725,"text":"8"},{"x":0.53594770871257846,"y":0.41423813470036497,"w":0.37472766876220709,"h":0.013087446544688519,"text":"Mina is so kind. She's always offering me a helping"},{"h":0.010407993338884314,"w":0.25272331237792967,"text":"because she knows I have trouble","x":0.6361655800855448,"y":0.43005828464355855},{"w":0.29847494125366203,"h":0.013081394961037107,"text":"working and studying at the same time.","x":0.53376906484884079,"y":0.44331395346424884},{"x":0.48148148483538322,"h":0.014614758741647194,"y":0.4679433802404287,"w":0.2483660125732422,"text":"WORD STORE 8E | Synonyms"},{"y":0.48982558177272328,"text":"6 Complete the radio interview with the correct words.","w":0.44444442749023438,"h":0.011627906367344121,"x":0.48366013364050386},{"w":0.23747276306152343,"text":"The first few letters are given.","h":0.011825174415836082,"x":0.50980392644854111,"y":0.50416319733614989},{"h":0.013081394961037107,"y":0.52906976758125468,"x":0.50980392393145246,"w":0.1873638343811036,"text":"C: On the line right now"},{"y":0.54360465166128913,"w":0.15686273574829102,"text":"we have a caller who","h":0.011765872707573455,"x":0.53376907039745936},{"y":0.55953372190854544,"w":0.15250544548034672,"text":"would like to remain","h":0.010407993338884314,"x":0.53594771489599224},{"text":"anonymous. Let's call","x":0.5359477179204869,"y":0.57410491254754048,"h":0.011656952539550458,"w":0.16339868545532221},{"h":0.016336486301850917,"text":"him Jim. Hello, Jim.","w":0.14936854362487795,"x":0.53532392300651988,"y":0.58653060267790191},{"x":0.50980392809791764,"y":0.60319767452950623,"w":0.20697166442871096,"h":0.01170657179337764,"text":"J: Hi, Carol. First I'd like to"},{"text":"ON AIR","y":0.60148848913443842,"w":0.087335634231567427,"h":0.015046276915182566,"x":0.7842188922512906},{"text":"say that | know I have","h":0.011746509386835968,"x":0.53376906413508396,"y":0.61906744389373525,"w":0.16339868545532221},{"text":"a 'sus","x":0.53594771234461458,"y":0.63226744201981644,"w":0.045751633644104062,"h":0.011779185635759637},{"x":0.63834422709464445,"y":0.63372093037214883,"w":0.039215683937072754,"text":"mind","h":0.010174418567717836},{"text":"sometimes. After all, l am a detective. However,","w":0.35947711944580085,"h":0.013322231870805279,"x":0.53376905955814546,"y":0.64820982504295288},{"x":0.53159041459517464,"text":"1 really feel that the2cyn_","w":0.19607843399047853,"y":0.66278101603901041,"h":0.014571190674437906},{"y":0.66424418649656047,"h":0.01162790636734401,"x":0.75816993340763161,"w":0.14814814567565915,"text":"_remarks made by"},{"w":0.37908496856689455,"x":0.53594771558583376,"y":0.6786011656832811,"text":"your colleague Brian Fray about rising crime are no","h":0.011805810698065411},{"h":0.010174418567717836,"text":"3triv","w":0.034858386516571027,"x":0.53594771349552706,"y":0.69331395345233304},{"x":0.62309368248433972,"w":0.28540304183959964,"y":0.69317235629403684,"h":0.011769503975390894,"text":"matter. It's a big deal! And as a police"},{"w":0.33115467071533211,"h":0.01176345278877311,"text":"officer I took the comments very personally.","x":0.53594772462780949,"y":0.70930232583764574},{"h":0.010174418567717836,"text":"C: OK, Jim. Please continue...","w":0.2352941131591797,"x":0.50980392773413552,"y":0.72383720934501716},{"text":"J: Well, to begin with I know that both myself and","w":0.37908496856689444,"h":0.01162790636734401,"y":0.73837209324074671,"x":0.50980392473616054},{"text":"my colleagues are 4ful","y":0.75270607863386663,"w":0.16993463516235352,"h":0.013322231076738356,"x":0.5359477149533185},{"y":0.75436046533376977,"text":"_ in our work. We get","w":0.16339868545532232,"h":0.011667844357835966,"x":0.74727669376471351},{"y":0.7672772685532574,"x":0.53594770741609066,"w":0.37690631866455082,"h":0.01332223187080539,"text":"a great sense of satisfaction catching criminals and"},{"x":0.53594770885476517,"text":"protecting.innocent people. So, when somebody","y":0.78343023297185121,"h":0.011740458200218074,"w":0.36819171905517578},{"x":0.53594771805955799,"y":0.79796511651109547,"w":0.36819171905517578,"text":"says the police do not care about crime ... for me","h":0.011776765319925775},{"x":0.53570918980748561,"w":0.096337614059448295,"h":0.013515551818796934,"y":0.81155617748267184,"text":"that's a mai"},{"h":0.013081394961037107,"text":"_issue. Furthermore, I think it's","x":0.67320261928661462,"w":0.23311546325683596,"y":0.81250000012122581},{"w":0.40087142944335941,"text":"highly irresponsible of your journalist colleague to say","x":0.53594772623692588,"h":0.013098338760007544,"y":0.827034883696807},{"x":0.53594772065668139,"w":0.22004356384277346,"y":0.84302325611865359,"h":0.011681156888988742,"text":"this and I want him to resign."},{"y":0.85755813949100002,"text":"C: You want Brian Fray to resign? Because of what he said?","x":0.51198257873481967,"w":0.42483657836914057,"h":0.011717464008696554},{"text":"J: That would be 'wel","x":0.50980392301584543,"h":0.010174418567717836,"y":0.87209302321977478,"w":0.1938997840881348},{"y":0.87343880087674941,"x":0.72331154958828536,"w":0.20915031433105469,"h":0.01173561756855046,"text":"news, yes. Today, ideally."},{"h":0.011699310448842648,"text":"C: Well, we'll need to ... oh, hang on! Brian has just","x":0.50980391241475043,"y":0.88800999157203864,"w":0.39215686798095706},{"text":"walked into the studio. Brian? Brian, are you OK?","x":0.53594770921443369,"h":0.011663003329134947,"w":0.36601306915283205,"y":0.90258118248535102},{"x":0.51198257561249216,"text":"B: I've just been mugged. Right outside the studio.","y":0.91715116296037291,"w":0.38562091827392586,"h":0.013081394961037107},{"w":0.36601306915283205,"y":0.93168604692355128,"h":0.013081394961037107,"text":"What do you think about that, Jim? Jim? Are you","x":0.53594771916359829},{"text":"there, Jim?","x":0.53594771487842852,"y":0.94754371376830793,"w":0.087145967483520437,"h":0.011758611363038574},{"y":0.96366279053266668,"w":0.039215686321258603,"h":0.011627907161410822,"x":0.89542483690473018,"text":"107"}]
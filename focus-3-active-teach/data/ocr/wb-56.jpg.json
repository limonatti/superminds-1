960755034129,"text":"Have you thought about my idea for changing the menu in","y":0.62936046554796288,"w":0.39869281768798825,"h":0.01468616202907902},{"x":0.54901960115151671,"w":0.38779956817626948,"y":0.64389534913565682,"text":"the school canteen? Most students I spoke to understand","h":0.014722469148786721},{"h":0.013093497334273008,"w":0.40958602905273434,"x":0.5511982759965085,"text":"the value of a balanced diet but would like to have a greater","y":0.65843023269753376},{"text":"choice from time to time.","y":0.67277268936074375,"h":0.011820333784168469,"x":0.55119825838105996,"w":0.16993463516235352},{"y":0.69025811830807493,"x":0.5468409772163606,"text":"'Is it possible to add just one or two fast food items such as","w":0.41176467895507818,"h":0.014683741713245047},{"x":0.55119825776295106,"h":0.011756191444238118,"y":0.70639534905470003,"text":"pizzas or burgers one day of the week? Maybe on Fridays?","w":0.39651416778564452},{"y":0.71940049995301369,"w":0.41176467895507818,"text":"Let me know if we can have something other to drink than","x":0.54684096692224327,"h":0.014611127473829533},{"w":0.38562091827392575,"h":0.013322231473771873,"x":0.55119825811067669,"text":"still or sparkling water. Even some fruit juice would make","y":0.73397169032840814},{"y":0.74977828567449023,"w":0.09815592765808101,"h":0.012071335146965123,"text":"a nice change.","x":0.55113990231979926},{"h":0.014611127473829533,"x":0.54684094964709995,"y":0.76598837257315677,"text":"3Have you spoken about this to the other teachers and the","w":0.4008714675903321},{"h":0.010407993338884314,"y":0.78184845945197801,"text":"school authorities?","w":0.13071895599365235,"x":0.55119825751515639},{"h":0.013081394961037107,"x":0.55119826307344022,"text":"I look forward to receiving your reply.","w":0.25490194320678716,"y":0.79796511625494648},{"w":0.10465016365051272,"text":"Yours sincerely,","y":0.81670940012753912,"x":0.55116075800063069,"h":0.011930036902129904},{"y":0.83091997261833039,"
[{"w":0.039301309585571292,"x":0.061135371899354071,"text":"0.7","y":0.0014534884660457603,"h":0.011627906570815472},{"h":0.017441860649629382,"y":-6.8031802413770492e-11,"w":0.25545850753784183,"text":"LAAMSFEANIN","x":0.14410480523762939},{"y":1.8106949273288819e-10,"w":0.17467248916625977,"h":0.013081395090518866,"text":"STUDENT D","x":0.8034934484923536},{"x":0.052401746858750882,"h":0.0087209303248145797,"text":"1","y":0.06104651150910434,"w":0.010917030572891236},{"text":"In pairs, ask and answer the questions.","x":0.074235812707999213,"w":0.30786026000976563,"y":0.061046511830871397,"h":0.011748829221170043},{"text":"Talk about travel.","w":0.14192139625549316,"y":0.082778702332575449,"h":0.010399334442595665,"x":0.076419216901365411},{"h":0.013081395090518866,"w":0.40174671173095705,"x":0.076419224571202662,"text":"1 Tell me about the most dangerous journey you've","y":0.0959302326146243},{"y":0.11039944883064323,"h":0.01175924109143156,"w":0.085193119049072258,"text":"ever made.","x":0.10259994771776693},{"h":0.010174418051111855,"text":"2","x":0.076419213742296141,"w":0.013100436925888068,"y":0.12500000014958945},{"y":0.12500000007465339,"x":0.10262010133179235,"w":0.3733624267578125,"h":0.013103161397670537,"text":"What's the best form of transport when you're on"},{"h":0.013311148086522451,"y":0.13935108168586219,"text":"holiday in a foreign country? Why?","w":0.26200872421264648,"x":0.10262009422555445},{"y":0.1540697676459557,"x":0.076419214665853497,"h":0.010174418051111855,"w":0.013100435733795171,"text":"3"},{"h":0.013311147689819336,"text":"Have you ever tried immersing yourself in a foreign","x":0.10262010219519727,"y":0.15391015002831643,"w":0.38646286010742181},{"y":0.16841390699575975,"x":0.10038578864980596,"text":"culture? Why?","w":0.1092720890045166,"h":0.013462883065425313},{"x":0.55676856528781937,"h":0.013081395090518866,"text":"4 Would you like to go on a package holiday or would","y":0.0959302326146243,"w":0.41703056335449218},{"text":"you prefer to organise it yourself? Why?","h":0.011649672877967032,"x":0.58296942894084358,"y":0.11189683854173771,"w":0.29912664413452139},{"text":"5 How can travel challenge your beliefs about yourself","w":0.41921398162841794,"x":0.55895195765740679,"y":0.12645348862350703,"h":0.011649672877967032},{"x":0.58296943489285236,"h":0.013311148086522451,"text":"and the place you live?","y":0.13935108155262577,"w":0.17467248916625977},{"text":"2 Look at the photo of an interesting journey. Take turns to talk about what you can see in your photos.","x":0.05240177928989169,"y":0.19758735428044139,"w":0.77947593688964845,"h":0.013311148086522451},{"text":"Talk about the people, the place and the other things in the photo.","w":0.50218338012695318,"x":0.076419227476552512,"y":0.21214642280763163,"h":0.013311147689819336},{"w":0.89519645690917971,"h":0.013311148086522451,"text":"You and your friend are planning to take a gap year. Here are some of the places where you could work when you travel.","y":0.47670549090478775,"x":0.076419249984274559},{"y":0.49126455896673737,"w":0.57205238342285147,"h":0.011647254575707144,"x":0.076419213601529423,"text":"Talk together about the places and say which would be the most interesting."},{"text":"4 Talk about a gap year.","h":0.015201452766202661,"w":0.19511075973510744,"x":0.051934229660732779,"y":0.80627314407139739},{"x":0.076419212428517014,"h":0.013081395090518866,"y":0.82558139549616505,"w":0.4301309967041016,"text":"• What are the advantages of having a gap year before"},{"h":0.011797198439993162,"x":0.10262008832166018,"w":0.16157205581665035,"text":"you go to university?","y":0.84011627917583254},{"w":0.39956329345703123,"h":0.013081395090518866,"text":"• What are the disadvantages of having a gap year","y":0.85465116293802545,"x":0.07641922163938844},{"x":0.10480349207418968,"y":0.86772046574596495,"w":0.21179039001464842,"text":"before you go to university?","h":0.013093487395224646},{"y":0.88352745418898815,"w":0.43231441497802736,"h":0.013311148086522451,"text":"• What would you like to do most during your gap year","x":0.076419217128890118},{"h":0.013081395090518977,"w":0.25764190673828125,"text":"and how would you organise this?","x":0.10262009401077207,"y":0.89680232549253125},{"h":0.013311148086522451,"text":"• Which places would you include on your itinerary?","w":0.401746711730957,"x":0.56331877885067883,"y":0.82113144767876278},{"text":"Why?","x":0.58733624522134031,"y":0.83720930257699533,"w":0.04585152626037603,"h":0.011627906570815361},{"x":0.56331877979179301,"w":0.39519649505615229,"y":0.85024958412142315,"text":"• Would you rather take a gap year on your own or","h":0.013311148086522451},{"h":0.01455906821963393,"x":0.58733624971887854,"y":0.86480865192975698,"text":"with a friend? Why?","w":0.15283842086791988},{"h":0.011627906570815472,"y":0.94912790710703421,"text":"136","w":0.037117903232574481,"x":0.054585153496522085}]
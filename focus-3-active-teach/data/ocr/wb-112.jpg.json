[{"y":0.040697675361203833,"h":0.030523254267902367,"text":"8.7","w":0.070021882057189941,"x":0.070021881825769225},{"h":0.021335046222101139,"text":"WRITING","y":0.012588290912518563,"w":0.1512795352935791,"x":0.19678911554166276},{"text":"An opinion essay","w":0.13785557746887206,"h":0.013081394686243808,"x":0.19693654609415617,"y":0.05668604706094782},{"text":"1","w":0.013129101991653437,"h":0.010174418089300752,"x":0.054704595466609461,"y":0.12500000008810153},{"h":0.01173164122332182,"text":"Complete the linkers in the sentences. The first and","x":0.07002187232117571,"w":0.4157549285888672,"y":0.12489626550738608},{"h":0.011708722965351193,"x":0.078774624349261024,"y":0.14098837235117201,"w":0.16849014282226563,"text":"last letters are given."},{"h":0.013081394686243808,"x":0.080962813052134486,"y":0.15843023267141298,"text":"1 To begin with, I think it's wrong to suggest...","w":0.36323848724365237},{"x":0.080962802245195573,"y":0.17441860485433214,"w":0.050328226089477526,"h":0.010174418089300863,"text":"2Iw"},{"x":0.18380744312539793,"h":0.011772652384651083,"y":0.17427385890032032,"text":"d like to p_","w":0.085339164733886697},{"w":0.024070022106170652,"h":0.0087209297908292793,"y":0.17587209318598074,"text":"to","x":0.31509846839986871},{"x":0.39168490065700001,"y":0.17587209329256992,"w":0.076586432456970166,"h":0.0087752096880520103,"text":"t that not"},{"x":0.10503282185366444,"y":0.18750000018642132,"text":"everyone feels the same about..","w":0.24945295333862302,"h":0.014574688796680557},{"text":"3","x":0.080962801042070112,"y":0.20494186062784125,"w":0.010940918922424311,"h":0.0087209297908291683},{"text":"Fori","x":0.10065645772347645,"y":0.20494186063753117,"w":0.052516407966613776,"h":0.0087209297908291683},{"x":0.19474836609348153,"h":0.011655649604639051,"w":0.26914659500122073,"text":"e, there are currently several female","y":0.20494186090495103},{"h":0.011643587405256173,"y":0.21947674448053245,"x":0.10503282797545267,"w":0.17286651611328124,"text":"prime ministers who ..."},{"text":"4","w":0.010940918922424311,"y":0.23401162799507824,"h":0.010174418089300752,"x":0.080962800823251732},{"x":0.096280087152468566,"h":0.010174418089300752,"text":"Its","y":0.2354651165609698,"w":0.032822756767272962},{"h":0.0089163368668299103,"text":"s to met","y":0.23526970952083281,"x":0.18161925461595513,"w":0.080962800979614225},{"y":0.23526970940065584,"text":"t we need to change our","w":0.19256017684936527,"h":0.011823313463772966,"x":0.30415755154614144},{"h":0.010174418089300752,"text":"attitude towards ...","x":0.10503282549273749,"w":0.14660831451416015,"y":0.25000000028189995},{"text":"5 L","y":0.2645348839604369,"x":0.080962801651869074,"w":0.043763675689697273,"h":0.010174418089300641},{"y":0.26453488416076509,"x":0.1597374191586107,"h":0.011813663545980457,"text":"_y, we must not forget that...","w":0.22757110595703126},{"h":0.0087209297908291683,"y":0.28052325594760863,"text":"6","x":0.080962800823251732,"w":0.010940918922424311},{"w":0.032822756767272948,"h":0.010373443983402453,"x":0.1028446386477275,"y":0.28049792536249418,"text":"In c"},{"w":0.31509845733642583,"text":"n, if we are really serious about saving the","y":0.27906976760963975,"x":0.18818380951559469,"h":0.013081394686243808},{"x":0.10503282715771511,"text":"planet, then ...","w":0.11378555297851564,"h":0.01166529952243156,"y":0.29502074669471035},{"x":0.080962801014717825,"w":0.010940918922424311,"h":0.010174418089300752,"y":0.30959302364066943,"text":"7"},{"w":0.089715538024902369,"x":0.17067833593831469,"text":"t another w","y":0.30954356844798236,"h":0.010373443983402453},{"x":0.31291028677590077,"y":0.30954356857610965,"w":0.19256017684936527,"h":0.01327800829875514,"text":"y, it is not acceptable for"},{"text":"children to ...","y":0.32346333761375112,"x":0.10487503296549751,"w":0.10534840583801268,"h":0.012957045843987047},{"x":0.078774616041167089,"y":0.34011627940011713,"text":"8 M","w":0.048140044212341304,"h":0.010174418089300641},{"x":0.16630196506279113,"y":0.34011627946115253,"w":0.29321662902832035,"h":0.011750940267475807,"text":"_r, such changes would also benefit ..."},{"x":0.054704615835951674,"y":0.36182572618127273,"w":0.42013126373291015,"h":0.01327800790303979,"text":"2 Match linkers from Exercise 1 to each description."},{"h":0.011717166742348573,"w":0.23194747924804687,"text":"A introduce body paragraphs","x":0.080962805944904306,"y":0.38081395371018356},{"w":0.013129101991653402,"h":0.0087209297908291683,"text":"&","x":0.47045951891664595,"y":0.38081395360022496},{"x":0.080962799752553993,"h":0.013081394686243808,"y":0.39534883732257575,"w":0.18818380355834963,"text":"B give personal opinion"},{"y":0.41120331958584599,"text":"C give examples","w":0.13566739082336426,"h":0.011761796326063445,"x":0.080962805190068377},{"w":0.17286651611328124,"text":"D add further support","h":0.01327800829875514,"x":0.080962804552768552,"y":0.42572614098468042},{"h":0.0087209297908292793,"y":0.44186046522813194,"x":0.080962800850604033,"w":0.010940918922424311,"text":"E"},{"y":0.44024896241538469,"w":0.25601749420166015,"text":"emphasise a point by repeating it","h":0.0132780086944706,"x":0.10503282412455299},{"y":0.45477178442507959,"w":0.2100656318664551,"text":"F introduce the conclusion","h":0.011797982528496509,"x":0.080962805000397611},{"text":"3 Read the sentences A-I from an opinion essay and","x":0.054704602190441029,"y":0.47674418621429093,"h":0.013081394686243808,"w":0.42231945037841789},{"h":0.012033195020746956,"text":"then put the essay in the correct order.","w":0.30853391647338868,"x":0.080962797977747691,"y":0.49253112031646817},{"x":0.070021887341428904,"y":0.52614107898494367,"w":0.4245076370239258,"h":0.014556595101890779,"text":"A (1 I grew up with two loving parents, both of whom spent as"},{"text":"much time with me as possible and gave me the attention and care","y":0.53924418615978509,"w":0.4245076370239258,"h":0.013081394686243808,"x":0.070021892866592883},{"text":"that I needed.","h":0.012808389386695485,"x":0.069860590438924286,"y":0.55464231675148479,"w":0.092226305007934578},{"text":"B This is because they carry the baby for nine months when","x":0.072210083530341751,"y":0.57122093053962997,"w":0.4245076370239258,"h":0.013081394686243808},{"x":0.070021896892851029,"y":0.58713692936563067,"w":0.42450763702392574,"text":"they are pregnant and then, in most cases, feed them directly when","h":0.011700279584069495},{"text":"they are first born.","w":0.12035010337829591,"h":0.011712341783452374,"x":0.070021886057022725,"y":0.60165975091624779},{"x":0.070021884117143399,"text":"C However, I do believe that women make better parents than","w":0.42669582366943365,"y":0.61773255854350606,"h":0.013081394686243808},{"y":0.63509335853294147,"h":0.0088830504674634048,"x":0.069976390934392368,"w":0.035101921558380128,"text":"men."},{"w":0.42669582366943359,"x":0.070021887399418933,"y":0.64813277992310381,"text":"D To begin with, mothers have a greater physical connection","h":0.016182572614107937},{"h":0.013081394686243808,"text":"to their child than a father.","w":0.17286651611328124,"x":0.067833701434606611,"y":0.66424418621429093},{"x":0.070021887355655218,"w":0.42669582366943359,"y":0.68008298742879425,"h":0.016182572614107937,"text":"E Finally, in many households it is still traditionally women"},{"w":0.40043762207031253,"h":0.014567451160478417,"text":"who stay at home to look after a child while fathers go to work.","x":0.067833701371846009,"y":0.69622093065880508},{"h":0.017617967217789632,"text":"F For example, many young girls prefer to play with dolls and","w":0.42669582366943359,"x":0.070021896562438429,"y":0.71203319505850471},{"text":"look after them like real children rather than play (or fight) in the","w":0.43107219696044918,"h":0.014540914480122291,"y":0.7281976748230492,"x":0.065645515387390427},{"text":"park like young boys tend to do.","y":0.7427325585076423,"w":0.2078774642944336,"h":0.014534882984715392,"x":0.067833699335277664},{"y":0.75872093056432832,"text":"G Secondly, women tend to be less aggressive and more","w":0.4245076370239258,"h":0.014723052820229454,"x":0.072210081761559977},{"y":0.77468879659523759,"x":0.070021898340337674,"w":0.42669582366943365,"h":0.011648412364152483,"text":"sensitive than men. They also have a natural tendency to show"},{"x":0.070021886131109601,"text":"affection and care for others.","y":0.78921161816523455,"h":0.01166047456353525,"w":0.18818380355834963},{"x":0.072210083530341751,"y":0.80523255841074304,"w":0.4245076370239258,"text":"H In conclusion, there are a number of physical and social","h":0.014684453940490449},{"x":0.070021896562438429,"w":0.42669582366943359,"h":0.011687011243891376,"y":0.82116182559825057,"text":"factors which make women better parents. Although more and"},{"h":0.013081394686243808,"text":"more fathers are looking after their children at home nowadays, the","x":0.072210070547118227,"w":0.4245076370239258,"y":0.83430232569466878},{"w":0.42669582366943359,"text":"physical bond between a father and child can never be as close as","x":0.070021886496793154,"h":0.013081394686243808,"y":0.84883720979713972},{"x":0.070021886497647678,"w":0.26258205413818358,"y":0.86337209331774178,"h":0.01173164122332182,"text":"that between mothers and their children."},{"y":0.87925311180698484,"text":"IIn my view, young children are therefore very familiar and","x":0.067833709576300194,"w":0.42888401031494139,"h":0.016182572614107826},{"text":"comfortable with being cared for by the mother and many young","x":0.070021885895042643,"h":0.013081394686243808,"y":0.89534883759510486,"w":0.42669582366943359},{"y":0.90988372133373019,"x":0.070021888517350667,"w":0.39387306213378914,"h":0.011693042343582816,"text":"girls see this as a role that they themselves will have one day."},{"h":0.013081394686243808,"text":"110","x":0.056892779239230515,"y":0.95348837226080241,"w":0.039387307167053215},{"text":"4","x":0.53610503308513602,"h":0.0087209297908291683,"w":0.013129101991653513,"y":0.030523256107492402},{"x":0.55142231884289739,"text":"Read another essay below and decide which question","y":0.030523256108439423,"w":0.43107219696044929,"h":0.01180039520580245},{"w":0.21006563186645499,"y":0.045058139774390327,"h":0.010174418089300752,"text":"the student has answered.","x":0.56236324796173964},{"text":"1 Do children really need both a mother and","x":0.5623632403112232,"y":0.062500000330823147,"w":0.34354484558105469,"h":0.011773858525446323},{"y":0.075518672127037778,"w":0.19912471771240237,"h":0.0132780086944706,"x":0.58643326145743857,"text":"a father to bring them up?"},{"w":0.38512035369873043,"h":0.011749734522396138,"x":0.56236324153137873,"y":0.091569767663671975,"text":"2 Why are mothers generally thought to be better"},{"text":"parents than fathers?","y":0.10610465157355575,"w":0.15754922866821286,"x":0.58862144557836615,"h":0.011737671927297688},{"h":0.013278008298755251,"y":0.119087136748248,"x":0.56236323321628034,"text":"3 Which of your parents had the biggest influence","w":0.38512035369873043},{"h":0.011713547924247503,"w":0.13566739082336432,"x":0.58862144512442283,"y":0.13517441897181148,"text":"on you as a child?"},{"text":"5","x":0.53829321727550805,"y":0.15552325599895434,"h":0.010174418089300641,"w":0.013129101991653402},{"h":0.013081394686243919,"w":0.42888401031494139,"text":"Replace the words in bold with linkers from Exercise 1.","x":0.56017506975135478,"y":0.15552325636327335},{"h":0.013081394686243808,"x":0.5623632583442536,"text":"Sometimes more than one answer is possible.","w":0.36105030059814447,"y":0.17005813984195561},{"text":"I was raised by my mother and father and benefited","w":0.38730854034423823,"x":0.55142231303357025,"h":0.011658061886229421,"y":0.20203488406386583},{"text":"from the influence of them both during my childhood.","y":0.21656976770000913,"w":0.40481399536132812,"h":0.011646000082562113,"x":0.55361051284997032},{"text":"As far as l am concerned 2 or 4, men and women may","w":0.41159282684326171,"h":0.01418221026535349,"x":0.55351730416555911,"y":0.22860531761909963},{"x":0.55361050485217467,"text":"provide different things for their children and influence","y":0.24398340248283268,"w":0.41575492858886709,"h":0.013284039398446579},{"x":0.55342919125487766,"text":"them in different ways, but it is incorrect to suggest","y":0.25794509974847091,"w":0.38983100891113287,"h":0.016006642258513448},{"x":0.55361051408014272,"w":0.31291027069091804,"y":0.27468879660734991,"text":"that women are better parents than men.","h":0.011648412364152483},{"h":0.012278755472903358,"w":0.1051920127868653,"x":0.55353090957871975,"text":"First of all\/a","y":0.29182573842546922},{"text":", it seems to me that in the early","y":0.29211618250112359,"h":0.01327800829875514,"x":0.6892779020199632,"w":0.24726476669311526},{"y":0.30813953527510607,"x":0.5514223288794855,"text":"years the physical connection between mother and","w":0.38730850219726565,"h":0.011777477343547393},{"x":0.55142232261232882,"h":0.01308139547767484,"y":0.32267441867104629,"text":"child is often stronger than with the father. This is","w":0.37636760711669914},{"y":0.33720930252316816,"w":0.40481399536132812,"text":"almost certainly because the woman carried the child","x":0.5536105145366953,"h":0.011753352944781637},{"w":0.40043762207031253,"h":0.010174418089300863,"x":0.55142233349438396,"text":"inside her for nine months and because she is able to","y":0.35174418627996196},{"y":0.36627907025572626,"w":0.40919036865234371,"h":0.01172922854601588,"text":"feed the child with her own milk. However, in my view","x":0.55361051031277753},{"text":"_this does not mean she is a better parent. For","x":0.60612692116206834,"h":0.011717166346633112,"y":0.38081395397665641,"w":0.34792121887207028},{"w":0.38949672698974602,"y":0.39377593327186788,"h":0.013278008694470711,"text":"instance, fathers who hold, bathe, dress and change","x":0.55361050254451416},{"h":0.013278007903039679,"text":"their babies can also develop strong physical bonds","y":0.40829875557394513,"w":0.38949672698974613,"x":0.55361050351825591},{"x":0.55361051063075262,"h":0.011771445848140605,"text":"with their children. In addition \/c","w":0.2560174942016602,"y":0.42282157691938904},{"w":0.12035010337829588,"x":0.83150985134695699,"text":"_, many babies","y":0.42441860487297434,"h":0.011680980144199937},{"text":"are fed from a bottle meaning that a father can feed his","x":0.55361050113226229,"y":0.43734439804363223,"w":0.4157549285888672,"h":0.0132780086944706},{"x":0.55361050093221531,"w":0.22100656509399419,"y":0.45186721961968535,"h":0.0132780086944706,"text":"child just as well as a mother."},{"text":"Next, I would like to point out that both parents are","x":0.5557986891462583,"y":0.47219917014916601,"w":0.38512035369873054,"h":0.011812457405185328},{"text":"equally able to entertain, educate and care for their","w":0.39168487548828135,"x":0.5536105212000606,"h":0.011824519604568096,"y":0.48672199165617847},{"y":0.50145348873925344,"w":0.40262580871582032,"h":0.011824519604568207,"text":"child as it grows. Often women spend more time with","x":0.55361050417600677},{"text":"young children because many couples decide that the","w":0.40700218200683591,"x":0.55361051044078324,"h":0.011812457405185328,"y":0.51598837232936967},{"h":0.01180039520580245,"w":0.39824943542480473,"x":0.55579869087621914,"text":"man will go to work and the woman will stay with the","y":0.53052325618111384},{"w":0.38074398040771484,"x":0.55579869130598925,"y":0.54505813978091999,"h":0.011788333402135032,"text":"children. However, this does not make the man any"},{"text":"worse as a parent. For example \/d","y":0.55668604663748733,"h":0.014683247799695209,"x":0.55361051289187591,"w":0.25601749420166009},{"x":0.83150984984517295,"text":"_, if the woman","w":0.11597373962402346,"y":0.55959302350185036,"h":0.011776271202752153},{"text":"went to work and the man stayed at home, there is no","h":0.010174418089300752,"y":0.57412790719081475,"x":0.55579869983683183,"w":0.39824943542480462},{"h":0.011752146803986507,"x":0.55361051138335948,"w":0.41794307708740241,"text":"reason why he could not look after the child just as well","y":0.58866279104060992},{"y":0.60319767490688903,"h":0.011740084604603629,"x":0.55361050531165346,"text":"as his partner.","w":0.10722100257873535},{"y":0.62166204815037329,"w":0.096508026123046764,"h":0.012489857020714479,"text":"Finally \/•","x":0.55568471899378336},{"x":0.65864333732469627,"h":0.0132780086944706,"w":0.26695840835571294,"text":"_, men and women are equally able","y":0.62199170085545941},{"w":0.37636760711669925,"x":0.55361051343654433,"text":"to provide good role models for their children. Of","y":0.6365145228167044,"h":0.011741290745398758},{"h":0.013081394686243808,"text":"course, it seems logical that girls will learn more about","w":0.41356674194335941,"y":0.64970930263265325,"x":0.55361050900643827},{"text":"being female from their mother, but the opposite is","y":0.66556016589855882,"w":0.38730854034423834,"h":0.011765415144164515,"x":0.55361050394166622},{"y":0.67877907002606408,"w":0.39387306213378903,"h":0.013081394686243919,"x":0.5557987052569564,"text":"also probably true. In other words \/*_, boys will"},{"w":0.39168487548828135,"text":"probably learn more about what it means to be male","x":0.55579870402828813,"y":0.69460580894165358,"h":0.011789539542930272},{"h":0.011801601346597579,"w":0.4179430770874023,"text":"from their father. In addition, it is almost certainly more","x":0.55361052531479604,"y":0.70912863086860645},{"h":0.011813663545980457,"w":0.4113785552978515,"text":"important that parents teach their children to be good","x":0.55361049839046161,"y":0.72365145247494056},{"text":"people, regardless of their gender, and men and women","x":0.55579868830732015,"w":0.417943115234375,"h":0.011825725745363336,"y":0.73817427388747625},{"text":"are equally able to do this.","y":0.75290697703867204,"w":0.20131290435791016,"h":0.011823313463772966,"x":0.55579869340820753},{"w":0.11597373962402335,"text":"In summary \/ 9","x":0.5536105032076819,"y":0.77178423223923098,"h":0.011646000082562113},{"x":0.70021882031952376,"y":0.77178423251866746,"text":"_, I think men and women are","w":0.22100656509399408,"h":0.011645999686846653},{"x":0.55579869285107097,"w":0.40919036865234371,"h":0.011658061886229421,"y":0.78630705404021495,"text":"equally good at being parents, and I also think that the"},{"h":0.011670124085612299,"x":0.55361049813188812,"y":0.8008298756683514,"text":"ideal approach for parents and children is for partners","w":0.40919036865234382},{"h":0.013278007903039679,"y":0.81535269712375402,"text":"to share the responsibility for raising a family.","w":0.34573303222656249,"x":0.55361051227840363}]
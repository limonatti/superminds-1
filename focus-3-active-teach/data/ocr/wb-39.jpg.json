[{"y":0.039134055065899065,"w":0.43137252807617188,"h":0.013322231473771873,"x":0.019607859001129633,"text":"2 Read the three blogs. For questions 1-3, choose the"},{"h":0.010174418567717836,"x":0.043572986616742124,"text":"correct answer A-C.","w":0.15686274528503419,"y":0.055232558139832966},{"w":0.29193899154663078,"h":0.011656952539550347,"x":0.043572988812741222,"y":0.074104912441204762,"text":"1 Jo experienced two problems which"},{"h":0.013322231473771873,"y":0.087010824276735232,"text":"A created difficulties for the rest of his trip","w":0.31372549057006832,"x":0.069716778026512605},{"w":0.27886709213256838,"text":"B he managed to solve quite quickly.","y":0.10319767458827989,"x":0.069716785378886315,"h":0.013081394961037107},{"h":0.013081394961037218,"x":0.069716784597612047,"y":0.1177325583152663,"text":"C added to the initial excitement of travelling.","w":0.34422657012939456},{"w":0.33986927032470704,"text":"2 Alex's trip to Austria was different because","y":0.1365528724363847,"x":0.041394338403369133,"h":0.013322231473771873},{"y":0.15112406316979943,"text":"A she had never met her Austrian relatives before.","w":0.37472766876220698,"x":0.069716780324778724,"h":0.01166663419991909},{"y":0.16694421335019971,"h":0.011834856076204825,"x":0.069716785818421514,"text":"B she was going there to study the language","w":0.33551197052001958},{"w":0.36601306915283199,"x":0.069716783070642593,"h":0.013322231473771762,"y":0.18151540369511676,"text":"C she was travelling on her own for the first time."},{"w":0.010893245935440062,"h":0.0087209299740247381,"text":"3","y":0.20058139539089459,"x":0.043572984766484767},{"w":0.37037036895751957,"h":0.013322231870805279,"text":"Which of the following does Adél not talk about","y":0.19900083227589183,"x":0.054466225470405298},{"x":0.06505505301244742,"y":0.21580512860226875,"w":0.08351881027221679,"text":"positively?","h":0.013483846316627468},{"w":0.1938997840881348,"h":0.011814282597550574,"y":0.22965116305906053,"x":0.069716777046346504,"text":"A The English city of York."},{"y":0.24562864290042763,"h":0.011656952539550347,"x":0.069716774981310431,"w":0.20261438369750975,"text":"B The people that she met."},{"w":0.2309368133544922,"h":0.013081394961037107,"y":0.26017441877432645,"text":"C The place where she stayed.","x":0.06971678235688597},{"y":0.28184845923037805,"text":"3 Match statements A-D with blogs 1-3. One blog has","w":0.43355117797851561,"h":0.013322231870805279,"x":0.019607857612049317},{"y":0.29796511677756832,"h":0.011776764922892369,"w":0.2047930145263672,"x":0.043572991720113412,"text":"two matching statements."},{"y":0.31490305611317537,"x":0.045614404676038819,"text":"In this blog...","h":0.014089236549294837,"w":0.10484962463378907},{"y":0.32994186044099305,"text":"A the blogger suggests that he\/she won't be","x":0.043572986333652433,"h":0.013105600104542314,"w":0.3398692703247071},{"x":0.069716779038760918,"w":0.18518518447875978,"text":"updating the blog again.","h":0.011688418233523734,"y":0.34593023286283953},{"h":0.017441859948049476,"x":0.4422657958771849,"w":0.026143789291381836,"text":"O","y":0.34156976755504509},{"text":"B it is clear that the blogger is not","h":0.011757401205121587,"w":0.26361654281616215,"x":0.043572995503683563,"y":0.36469608678959697},{"y":0.37926727737855037,"w":0.18300653457641602,"text":"an experienced traveller.","x":0.067538124759722359,"h":0.011721094482447181},{"h":0.017441859948049476,"x":0.4422657962475553,"y":0.37500000017132407,"w":0.026143789291381836,"text":"O"},{"w":0.331154670715332,"h":0.013322231076738467,"text":"C the blogger describes two potentially big","x":0.043572985920475024,"y":0.39675270614865954},{"y":0.41279069795004886,"x":0.069716777089519233,"text":"problems which are solved quickly.","h":0.011627906367344121,"w":0.25708061218261719},{"w":0.34858386993408202,"text":"D the blogger mentions that this is not his\/her","x":0.0457516415035472,"y":0.43168604672911881,"h":0.011694469420141518},{"text":"first visit to the country he\/she is currently in.","x":0.069716786937177699,"w":0.33115467071533206,"y":0.44622093064448154,"h":0.013081394961037107},{"h":0.013298480933552237,"w":0.44461791992187505,"x":0.019521160349043463,"text":"4 Match the definitions with underlined words in the blogs.","y":0.46645287109088274},{"text":"completely relaxed","w":0.14161219596862792,"x":0.069716776416557519,"h":0.011832435760370963,"y":0.48691860501400241},{"text":"totally chilled","h":0.011832436157404369,"x":0.31808278649836635,"w":0.10239651679992678,"y":0.48691860463150394},{"h":0.01558323843493048,"x":0.069437552633053665,"y":0.50238279855456514,"w":0.24238849639892579,"text":"two weeks (from fourteen nights)"},{"y":0.52325581414152866,"h":0.010174418567717836,"text":"2","w":0.010893245935440062,"x":0.045751634221822449},{"h":0.011715043295829286,"text":"begin well","y":0.52325581425818846,"w":0.082788667678833,"x":0.065359477416937928},{"text":"think","w":0.039348266124725334,"h":0.0089882700568333362,"x":0.067471835947492648,"y":0.54201749295457802},{"h":0.013322231473771762,"text":"4 luxurious or expensive","x":0.045751636834311105,"w":0.18954248428344728,"y":0.55953372206581031},{"text":"5 find it difficult to believe","w":0.20479301452636722,"h":0.011656952539550347,"x":0.045751644298181571,"y":0.57701915078161026},{"h":0.011699310448842759,"x":0.021786507160171064,"y":0.600290697920979,"text":"5 Complete the sentences with words and expressions","w":0.43137252807617182},{"x":0.043572989875362643,"y":0.61482558161347367,"w":0.42047927856445316,"h":0.013081394961037107,"text":"from Exercise 4. Change any verb forms as necessary."},{"x":0.069716780405520526,"h":0.013322231473771873,"y":0.63363863445399959,"text":"Katrina reckons we'll be in Prague by midday, but in","w":0.38562091827392575},{"w":0.30065359115600587,"h":0.014580871937773243,"y":0.64820982520806225,"text":"this weather, I think it'll take a bit longer.","x":0.067538130674720337},{"x":0.04575165156821253,"y":0.66424418629307214,"w":0.41176467895507818,"h":0.01162790636734401,"text":"1 Jenna's uncle and aunt are really rich, so they always"},{"x":0.069716777671409491,"y":0.68023255832757512,"text":"stay in","w":0.050108928680419926,"h":0.010174418567717836},{"text":"hotels when they go on holiday.","x":0.21786491985716994,"y":0.67860116574142071,"w":0.2483660125732422,"h":0.0118058106980653},{"text":"2 Simon and his friends have gone camping for","x":0.045751642050691502,"y":0.6931723560015508,"w":0.36165576934814453,"h":0.013322231870805279},{"x":0.17211329624174354,"h":0.013081394961037107,"w":0.29411764144897462,"text":"_, so he won't be back until the end of","y":0.70930232564811513},{"h":0.010331572342871742,"y":0.72375863226143611,"x":0.069695108630007746,"w":0.082832002639770502,"text":"the month."},{"text":"3 Amy's birthday party","w":0.17502445220947266,"y":0.73776152737515677,"h":0.014455418900387373,"x":0.045382356748727835},{"x":0.32244008951568603,"h":0.010174418567717836,"text":"when her favourite","y":0.73837209291454231,"w":0.1416121959686279},{"h":0.013322231473771873,"text":"cousins from Italy turned up unexpectedly.","y":0.75270607819781998,"x":0.06971678138477834,"w":0.31590412139892582},{"y":0.76889534880117016,"text":"4 We","w":0.052287578582763672,"h":0.010174418567717836,"x":0.045751636198814227},{"h":0.011704151080510372,"text":"how much you've grown! How tall","x":0.19172113596301571,"w":0.26361654281616209,"y":0.76889534928725822},{"text":"are you now?","y":0.78476269788928288,"x":0.069716780754755264,"w":0.10239650726318361,"h":0.010407993338884203},{"y":0.79933388827053697,"x":0.045751635660554513,"h":0.011712622979995535,"text":"5 Mum had a massage in the hotel spa. She loved it","w":0.39651416778564452},{"h":0.0093910942268212727,"y":0.81507189448426332,"text":"and was","x":0.069616046821152799,"w":0.06338228702545165},{"w":0.084967317581176816,"h":0.0087209299740247381,"x":0.24400871452095851,"y":0.81540697697035203,"text":"afterwards."},{"w":0.17211328506469725,"text":"REMEMBER BETTER","y":0.84883720926023021,"x":0.034858391581667335,"h":0.010174418567717836},{"x":0.037037052453338465,"text":"Go to a travel blogs section of a site dedicated to travel.","w":0.40087142944335941,"h":0.013322231076738356,"y":0.87343880119664419},{"x":0.037037058547917959,"w":0.40305007934570308,"h":0.013322231473771873,"y":0.88800999173714801,"text":"Read some of the blogs and make a note of any useful"},{"w":0.35294116973876954,"x":0.034858391383338516,"text":"vocabulary. Don't worry if you don't understand","y":0.9025811824808867,"h":0.013322231473771873},{"x":0.037037048171937099,"y":0.91840133219604347,"w":0.32897602081298827,"h":0.011831225602454198,"text":"everything. Check new words in a dictionary."},{"text":"WORD STORE 3E | Negative adjectives","y":0.039134055065899065,"x":0.49455338895682532,"w":0.32244007110595696,"h":0.013322231473771873},{"x":0.49455339634432649,"y":0.061046511749132559,"text":"6 Complete the sentences with the correct negative","w":0.41830062866210938,"h":0.013081394961037107},{"x":0.51851852300825496,"y":0.075581395750436542,"w":0.3115468215942383,"h":0.01162790636734401,"text":"adjective form of the verbs in brackets."},{"x":0.54684096760414791,"y":0.094476744418072189,"w":0.3442265701293945,"h":0.011684787759772886,"text":"Now that there's the Internet, there's very little"},{"h":0.011721094482447292,"w":0.39869277954101556,"text":"excuse for being uninformed (INFORM) about how to","x":0.54466231818156219,"y":0.10901162830857603},{"w":0.22004356384277346,"h":0.011731986697766317,"text":"behave when you are abroad","x":0.54466231760657247,"y":0.12489591987737858},{"x":0.52069718095417683,"h":0.013322231076738356,"y":0.14238134901085997,"w":0.41612197875976564,"text":"1 There's no real reason why mobile devices should be"},{"y":0.1569525394154514,"text":"(CONNECT) from the Internet during","w":0.2766884422302246,"h":0.013105599707509019,"x":0.65577342460021082},{"w":0.241830062866211,"text":"a flight. It's not at all dangerous.","h":0.011820333387135173,"x":0.54466231464532566,"y":0.17277268956397873},{"h":0.011719884324530416,"y":0.19186046532407997,"x":0.51851853736427744,"w":0.42265792846679684,"text":"2 Ialways think that having problems while travelling is"},{"y":0.20639534906923496,"w":0.25272331237792967,"text":"(AVOID) - that way I don't get too","h":0.011756191444238118,"x":0.65795207246027243},{"y":0.22093023273387102,"w":0.25272331237792978,"text":"upset when they actually happen.","h":0.013081394961037107,"x":0.5446623121116887},{"text":"3 Ifyou are completely","x":0.5206971664082336,"y":0.23837209299913265,"h":0.013085026228854657,"w":0.18300653457641602},{"h":0.010174418567717836,"text":"(FAMILIARISE)","w":0.10893245697021492,"x":0.81481481545098555,"y":0.23982558148648991},{"x":0.54466230148863304,"y":0.25436046536468493,"w":0.39433551788330079,"h":0.013081394961037107,"text":"with a country's culture, you need to aim to be polite"},{"text":"at all times.","y":0.27020793960919798,"w":0.087219362258911137,"h":0.010456213843911821,"x":0.54462561444078328},{"text":"4 For me, the idea of going backpacking around","h":0.013322231870805279,"x":0.52069717185547137,"y":0.28767693577578357,"w":0.37254901885986325},{"text":"Europe is completely","x":0.54684096559879292,"y":0.30377907002369242,"w":0.15904138565063475,"h":0.011791288008995537},{"x":0.81045751957025658,"y":0.3037790697132341,"w":0.11111110687255854,"text":"_(THINK). I like","h":0.010174418567717725},{"text":"my comfort, so l prefer to stay in hotels.","w":0.2962962913513183,"h":0.011827594731669944,"x":0.54684096601642496,"y":0.31831395379307215},{"x":0.52069717198208409,"text":"5 When we arrived in Athens, the weather was","w":0.35729846954345701,"y":0.3355537053037112,"h":0.013322231473771984},{"y":0.35168252819012569,"h":0.011751222570770326,"x":0.54682148230800787,"w":0.082827625274658256,"text":"particularly"},{"w":0.19825706481933603,"x":0.74291939798248885,"y":0.35012489608984354,"text":"(PLEASE) but fortunately it","h":0.013322231473771762},{"h":0.013081394961037107,"text":"got better after a few days.","w":0.20261436462402349,"x":0.54684096921304259,"y":0.36627906993711712},{"x":0.53159041253315065,"w":0.34640522003173835,"y":0.38509575339674251,"h":0.013322231473771762,"text":"Kyle believes that people who find travelling"},{"w":0.2897603416442871,"h":0.013322231473771873,"text":"(REWARD) should probably just stay at","x":0.65577342032709396,"y":0.39966694426766147},{"h":0.013087446147655113,"text":"home. That's a bit hard, don't you think?","w":0.3028322410583496,"x":0.5446623119690096,"y":0.41423813483577043},{"text":"VOCABULARY PRACTICE | Verb phrases","w":0.33551197052001952,"h":0.014687372981062596,"y":0.43880099877717593,"x":0.49237473596003384},{"text":"7 Look at the vocabulary in lesson 3.4 in the Students'","y":0.46075581397781473,"w":0.43790847778320313,"h":0.013081394961037107,"x":0.49455339367920431},{"y":0.47529069781381295,"text":"Book. Complete the travel advice with words from","w":0.39651416778564452,"h":0.013081394961037107,"x":0.52069716942961763},{"y":0.48960502813142925,"x":0.52062113434024493,"w":0.065511546134948806,"h":0.010615525098764178,"text":"the box."},{"x":0.52287581277853235,"text":"(challenge cut immerse retrieve take )","y":0.50999167361009801,"h":0.01762460491043838,"w":0.36383441925048832},{"x":0.64696634294068278,"y":0.57533013157942337,"w":0.15051176071166994,"text":"Gap year","h":0.025211829726245472},{"x":0.52723311810802043,"w":0.31590414047241211,"h":0.013322231473771873,"y":0.62198168209911586,"text":"Young people choose to take a gap year"},{"h":0.013322231473771873,"text":"for different reasons. Some want to1","x":0.5250544691335175,"w":0.29847494125366203,"y":0.63655287243638481},{"w":0.37254901885986325,"text":"themselves off from their family and home for","x":0.52723312049926208,"h":0.013081394961037107,"y":0.65261627920916165},{"x":0.52505446490271512,"w":0.36383441925048821,"y":0.66860465171559857,"h":0.01457603130610563,"text":"a while in order to develop a greater sense of"},{"y":0.68442964222932068,"text":"independence. Some view it as an opportunity","x":0.52505446002703027,"w":0.37472766876220698,"h":0.013322231076738356},{"text":"beliefs that may have become","x":0.64488017795104302,"h":0.011741668358134949,"y":0.70058139558086285,"w":0.24618736267089836},{"y":0.71648626137840121,"x":0.52723312471667161,"w":0.35294116973876954,"h":0.010407993338884314,"text":"too familiar. Still others see it as a chance to"},{"h":0.011821544339118861,"text":"_ oneself in a foreign culture and","x":0.62527232977451308,"y":0.73255813945085602,"w":0.25925926208496086},{"text":"experience a different way of life. Whatever","x":0.52723311513061544,"h":0.013106809865425895,"w":0.35294116973876954,"y":0.74709302361323149},{"x":0.52505445994877054,"text":"your reasons, don't feel like you should give up","y":0.76308139576076062,"w":0.37690631866455071,"h":0.013081394961037107},{"w":0.36819171905517578,"y":0.77893422149024094,"h":0.013322231473771873,"text":"your modern day comforts. Your smartphone","x":0.52505447340632627},{"text":"is an invaluable gadget wherever you go, both","x":0.52723312049983662,"y":0.79350541198229507,"w":0.36601306915283205,"h":0.013322231870805279},{"y":0.80959302350162432,"w":0.38126361846923829,"h":0.013081394961037107,"x":0.52723311178934595,"text":"for contacting people when you feel lonely or if"},{"w":0.38562091827392575,"h":0.013100759075841406,"x":0.52723310902752529,"y":0.82556203148243879,"text":"needed in an emergency. And always carry your"},{"text":"bank card with you - you never know when you","y":0.8413821816827961,"w":0.38126361846923829,"x":0.52941176851592542,"h":0.011815492358434043},{"h":0.011710202664161784,"y":0.85465116290159915,"x":0.52941176668239753,"text":"might need to 4","w":0.12418300628662104},{"h":0.011717463611663148,"w":0.16122003555297848,"x":0.74074074295335834,"y":0.85755813998493269,"text":"_cash from an ATM"},{"text":"in order to get hold of some local currency.","x":0.525054464451986,"y":0.87209302352238849,"h":0.013081394961037107,"w":0.34858386993408208},{"h":0.013081394961037107,"w":0.026143789291381836,"text":"37","x":0.91067538231509326,"y":0.96220930268299887}]
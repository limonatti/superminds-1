[{"x":0.091703056880101427,"h":0.013081395219785463,"text":"ITING BAN","w":0.16375545501708982,"y":7.9060757940396797e-11},{"w":0.20087335586547853,"x":0.045851533109057346,"text":"Describing a place","y":0.050706567001238656,"h":0.017607386074557696},{"w":0.44978164672851562,"y":0.081395348938607115,"h":0.011705232875503735,"text":"The most fascinating\/interesting\/lively part of the city is...","x":0.045851540336615385},{"text":"The most famous attraction is ...","x":0.045851535450511349,"h":0.011724564400892423,"y":0.10465116289209553,"w":0.25545850753784177},{"h":0.010390689941812137,"text":"The town is well known for its...","y":0.12926018281740592,"w":0.25764190673828125,"x":0.045851540007860694},{"text":"It is the kind of place that\/where...","x":0.045851536790277335,"y":0.15253532822253923,"w":0.27947597503662114,"h":0.013300083125519446},{"x":0.045851537573002206,"w":0.19650653839111326,"y":0.17732558149674671,"h":0.011784975269092501,"text":"The place I like best is ..."},{"text":"It is situated in a quiet residential area.","x":0.045851533232016663,"y":0.2019950125891965,"w":0.30786026000976563,"h":0.011667777970742921},{"text":"The place is surrounded by ...","w":0.23580785751342773,"x":0.045851533688700846,"h":0.01164844644535401,"y":0.22527015810441087},{"y":0.25000000010139778,"w":0.34934497833251954,"h":0.011627906773948649,"text":"It lies in the north\/south\/east\/west of Spain.","x":0.045851534123405244},{"text":"It is the most thrilling\/picturesque\/fabulous place.","w":0.39301307678222652,"x":0.045851545124170418,"h":0.013300083125519446,"y":0.2730673317263983},{"h":0.011677443931624065,"w":0.22489082336425784,"x":0.045851534360447449,"text":"The sights are worth seeing.","y":0.29796511634413037},{"w":0.30786026000976563,"x":0.045851529847737285,"y":0.32252701540990181,"h":0.017589263091558949,"text":"Disagreeing with an opinion"},{"text":"I disagree that\/with ...\/l don't agree that\/with ...","y":0.3531976745073554,"h":0.013081395219785352,"x":0.043668139706114141,"w":0.38646286010742187},{"x":0.045851537297646593,"text":"I am totally against...","w":0.17248907089233398,"y":0.37780548623819932,"h":0.011729397381333051},{"text":"I see what you mean but ...","h":0.011764435597686917,"y":0.402616279134828,"x":0.045851529961824976,"w":0.21615720748901365},{"h":0.011783767123075717,"x":0.045851540674578715,"w":0.24017465591430662,"text":"I see your point of view but ...","y":0.42587209312465357},{"y":0.44912790682324677,"h":0.013081395219785463,"x":0.045851533978800207,"text":"I'm afraid I can't agree with ...","w":0.24017465591430665},{"y":0.47381546118992757,"w":0.21397378921508789,"h":0.011649654987744285,"text":"I'm not convinced about ...","x":0.045851536014726725},{"x":0.045851534239412073,"h":0.010181667600585809,"w":0.28384279251098632,"text":"I don't think it's the best solution ...","y":0.49854651179040155},{"w":0.39956329345703129,"x":0.045851547703798554,"text":"I must say I do not agree\/strongly disagree with ...","y":0.5216126352506818,"h":0.013300083125519557},{"h":0.011676235785607281,"text":"I am of a different\/the opposite opinion because ...","w":0.40393013000488276,"y":0.54651162800837449,"x":0.045851533933147975},{"text":"Contrary to popular belief ...","y":0.57107231922096569,"w":0.22707422256469728,"h":0.01177651785060152,"x":0.048034943957825933},{"y":0.59725685798548289,"w":0.28384279251098632,"h":0.016209476309226867,"x":0.045851531536147475,"text":"Encouraging participation"},{"w":0.3951964950561524,"text":"Come on, don't be afraid\/it's not difficult\/it's easy!","x":0.048034944196814561,"y":0.62635078963288027,"h":0.011730605527349836},{"h":0.014618250497261398,"w":0.45196506500244138,"text":"Why don't you come and meet some interesting people\/","x":0.043668119292291474,"y":0.64962593516675116},{"h":0.014682286199885208,"w":0.18558952331542972,"text":"see some great things?","x":0.069868995438355022,"y":0.66279069795309709},{"text":"Come and tell us what you think.","x":0.048034945047889861,"w":0.25764190673828125,"h":0.011679860223657634,"y":0.68744804665168879},{"text":"Come and have fun!","y":0.71220930240328906,"w":0.15720523834228517,"h":0.010174418328111612,"x":0.048034936724053914},{"w":0.1048034954071045,"text":"Don't miss it!","x":0.045851526657021677,"y":0.73690773070795523,"h":0.011638780880846356},{"x":0.048034934290183795,"y":0.94912790687775261,"text":"164","w":0.039301309585571292,"h":0.013081395219785463},{"x":0.5262008799052702,"w":0.27947597503662114,"h":0.017607386074557696,"y":0.050706567005391445,"text":"Ending emails and letters"},{"x":0.52567189948005932,"text":"Informal phrases","w":0.13420864105224606,"h":0.016034994339407804,"y":0.077295413781092726},{"text":"It was good to hear from you.","h":0.013081395219785352,"w":0.23362443923950194,"y":0.10465116307324684,"x":0.52838428500179191},{"text":"Email me soon.","x":0.52838428035239671,"y":0.1292601827750125,"w":0.12008733749389655,"h":0.010390689941812137},{"x":0.52620087642259905,"y":0.15253532825282023,"h":0.013300083125519557,"w":0.41484714508056642,"text":"I'd better get going.\/I must go now.\/Got to go now.\/"},{"x":0.55240175358992527,"y":0.16708229415089171,"w":0.1659388542175293,"h":0.011696775457012754,"text":"I must be going now."},{"text":"Bye for now.","y":0.18946806112414061,"w":0.10098257064819338,"h":0.013284903611129995,"x":0.52798769472193341},{"w":0.44759822845458985,"h":0.013081395219785463,"x":0.52838429934621289,"text":"Looking forward to your news\/to hearing from you again.","y":0.21511627911006848},{"y":0.23981712387568088,"w":0.11572052001953126,"h":0.011637572734829571,"text":"Say hello to ...","x":0.52620087437888075},{"x":0.52838428293959849,"y":0.26308139545023512,"h":0.011648446445354121,"w":0.37772926330566403,"text":"Give my love\/my regards to (everyone at home)."},{"text":"Have a nice (trip).","y":0.28761429771894642,"x":0.5283842830967399,"w":0.13973798751831046,"h":0.011804306794481301},{"text":"See you (soon\/in the summer).","x":0.52838428514328339,"h":0.013300083125519446,"y":0.31088944301893884,"w":0.24017465591430665},{"y":0.33575581407358945,"x":0.52838428274617433,"w":0.091703052520751949,"text":"Write soon.","h":0.010174418328111612},{"x":0.5283842810746594,"y":0.35901162781457607,"text":"Keep in touch!","w":0.11572052001953126,"h":0.011728189235316266},{"w":0.12663755416870126,"x":0.52838427995713422,"text":"Neutral phrases","y":0.38226744210721175,"h":0.011747520364331687},{"w":0.36244541168212885,"x":0.52838428468295295,"y":0.40689941810541264,"text":"I look forward to hearing from you\/your reply.","h":0.013300083521892825},{"x":0.52620087422676365,"text":"I hope to hear from you soon.","y":0.43168604666147536,"h":0.011788600103516123,"w":0.23799125671386712},{"y":0.45494186054888031,"text":"Formal phrases","h":0.010174418328111501,"w":0.12227073669433597,"x":0.52838428383623803},{"y":0.47963424767744356,"text":"I wonder what other readers think about ...","x":0.52620087673118621,"w":0.34279476165771483,"h":0.010390689941812248},{"x":0.5262008714724169,"h":0.011639989026863251,"text":"I hope you will publish more articles about this problem.","y":0.50290697689403352,"w":0.44323143005371091},{"x":0.52620087179913722,"text":"I would be grateful if you could publish my letter.","h":0.013081395219785352,"y":0.52616279078642514,"w":0.38864627838134769}]
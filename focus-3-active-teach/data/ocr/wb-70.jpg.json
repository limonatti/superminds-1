[{"h":0.029069765969430672,"text":"5.7","x":0.07002188229180803,"w":0.065645513534545896,"y":0.042151163708598616},{"w":0.15340833663940431,"text":"WRITING","x":0.19463062270951134,"h":0.021144179981279154,"y":0.014137212402917765},{"x":0.19474836206928473,"w":0.15098467826843262,"y":0.056686047121983441,"h":0.014683247799695209,"text":"A 'for and against'"},{"y":0.061046511848771412,"text":"essay","x":0.3457330405488257,"w":0.048140044212341304,"h":0.0087209297908292793},{"text":"Read the sentences of the essay below. Put them in","x":0.080962809430933258,"h":0.011720785164734182,"y":0.12645348860843941,"w":0.40481399536132812},{"y":0.1409883724000951,"x":0.078774636335225523,"w":0.422319450378418,"h":0.013081394686243919,"text":"the correct order. Use the linkers in bold to help you."},{"h":0.018543713518198057,"text":"Countries often take pride in their cultural","x":0.095952281745098775,"y":0.17435190035349879,"w":0.31571937561035157},{"text":"heritage and spend billions on protecting","x":0.096280089403352601,"h":0.014572275723659156,"w":0.31072210311889653,"y":0.19040697711229349},{"x":0.096280086757212016,"text":"and promoting it.","y":0.2049418605783897,"w":0.13129102706909179,"h":0.013081394686243808},{"w":0.32166301727294921,"y":0.24273255839863073,"h":0.014534882984715281,"text":"Personally, I hope that there will always be","x":0.10940919560313141},{"text":"individuals who can give their time and energy to","x":0.10722101525346012,"y":0.25726141096125632,"w":0.37199123382568361,"h":0.01327800790303979},{"y":0.26955765847239088,"w":0.35519199371337895,"h":0.018259277976894861,"x":0.1089778587385868,"text":"preserving culture until circumstances allow the"},{"w":0.1910487937927246,"h":0.014263225887820807,"x":0.10900146331362233,"y":0.28678820073996292,"text":"government to take over."},{"text":") On the one hand, it seems obvious that all cultures","y":0.32664751339582199,"w":0.3964395904541016,"x":0.089538127415011354,"h":0.015358246609383119},{"h":0.017261180640256168,"y":0.34075491956099646,"x":0.09602657520209025,"text":"are worth protecting, since every country has","w":0.33968494415283201},{"h":0.0132780086944706,"w":0.33698028564453131,"x":0.09628009366569952,"y":0.35601659733481217,"text":"something unique to contribute to the world"},{"text":"On the other hand, the physical well-being of","x":0.078774627045585813,"y":0.3982558141576048,"h":0.013081394686243919,"w":0.3741794204711914},{"h":0.015774143583052513,"w":0.34832248687744138,"text":"a country may have to be the main focus of its","x":0.10045438040255139,"y":0.41139148694984384},{"h":0.011776270807036693,"x":0.10284464149285842,"text":"government. A country whose population lacks","w":0.35448577880859372,"y":0.42863070555545413},{"text":"jobs, homes, medical care or education may not be","w":0.38730854034423823,"x":0.10065645580162258,"h":0.01308139547767484,"y":0.44186046497918585},{"text":"able to afford to preserve or promote their cultural","y":0.45639534884546495,"w":0.38074398040771479,"h":0.01308139547767484,"x":0.10284463618563937},{"text":"heritage because the population has more urgent","w":0.37636760711669914,"h":0.013081394686243919,"x":0.10284464487345193,"y":0.47093023267141298},{"x":0.1028446415309163,"text":"needs.","y":0.48691860487202721,"w":0.052516407966613776,"h":0.0087209297908291683},{"x":0.078401034969096839,"text":"For instance, there are a number of unique languages","y":0.51867495671027974,"w":0.4295857238769531,"h":0.019272281124384061},{"x":0.10035708311120921,"w":0.38347629547119139,"y":0.53479631281296425,"text":"in central Europe which are spoken by few people.","h":0.017124350140203526},{"h":0.017104583360347481,"w":0.39005104064941409,"x":0.10036798414746922,"text":"These languages are important to their regions, and","y":0.54929305421866381},{"text":"they should be protected and promoted, along with","y":0.56540697708322363,"h":0.014676010163493181,"x":0.10065647208080464,"w":0.39168487548828124},{"y":0.57994186075960219,"x":0.10065646037337213,"text":"the art, music and traditions of these areas.","w":0.32166301727294927,"h":0.011759384044473076},{"x":0.067671059914734322,"h":0.015755637552728352,"y":0.6147022226036909,"text":"• Furthermore, countries which are engaged in","w":0.36573638916015622},{"y":0.63070539424324634,"w":0.40262580871582032,"text":"conflicts may not be able to focus on cultural matters.","x":0.091903722337932411,"h":0.013278008298755251},{"w":0.39864551544189453,"h":0.016152218070762392,"x":0.080789783326677952,"text":"• However, is it really a good idea when they could","y":0.66563198797751144},{"y":0.67932932842408589,"w":0.39233379364013665,"h":0.01785939877458631,"text":"use the money to improve the lives of their citizens?","x":0.10470947078843455},{"x":0.094091905628509942,"y":0.71784232381970514,"w":0.34354484558105469,"h":0.016182572614107826,"text":"In conclusion, the current circumstances in"},{"x":0.11597374216206219,"y":0.73691860500668438,"w":0.34354484558105469,"h":0.013081394686243808,"text":"a country may decide if they can protect their"},{"h":0.011629112924282925,"w":0.129102840423584,"text":"cultural heritage.","x":0.11597374605370757,"y":0.75145228213006832},{"w":0.45295402526855466,"h":0.01179677678341684,"text":"2 Look at the essay and the linkers in bold in Exercise 1.","x":0.056892794958720357,"y":0.78488372119564886},{"x":0.080962802223068592,"h":0.011784714584033962,"y":0.79941860506192786,"w":0.41356674194335941,"text":"Which of the linkers in the text can be replaced with"},{"y":0.81395348870244255,"text":"the linkers in the box?","w":0.17724288940429689,"h":0.010174418089300752,"x":0.080962798602009153},{"w":0.29102844238281256,"text":"First of all For example In addition","h":0.013081394686243808,"x":0.10284464580348782,"y":0.84011627932838973},{"h":0.011715960205837872,"y":0.85601659756653681,"x":0.10065646078342957,"w":0.29102844238281256,"text":"In my opinion Secondly To sum up"},{"y":0.8792531119574426,"w":0.26914659500122068,"text":"Personally, I think = In my opinion","h":0.01327800829875514,"x":0.10722101565584474},{"y":0.89534883750284133,"w":0.13785557746887206,"text":"On the one hand","h":0.0088005402276130074,"x":0.098468270811515879},{"text":"2 In conclusion","x":0.080962806517234628,"y":0.90988372110264759,"h":0.0087884780282301289,"w":0.12691465377807615},{"h":0.010373443983402564,"text":"For instance","w":0.091903715133666977,"x":0.10722100785986237,"y":0.92282157694919653},{"x":0.10722100772055435,"y":0.93750000023345026,"w":0.096280088424682608,"h":0.010174418089300863,"text":"Furthermore"},{"text":"4","y":0.93750000033034964,"w":0.013129101991653444,"h":0.010174418089300752,"x":0.080962801082947899},{"text":"68","h":0.011627907179203256,"x":0.063457329977184618,"y":0.9563953486831257,"w":0.026258206367492681},{"text":"3 Read the first paragraph of the 'for and against' essay in","x":0.53610505457286406,"y":0.030523256072575777,"w":0.44857765197753907,"h":0.013081394686243808},{"x":0.56236325391414743,"y":0.045058139890405191,"w":0.39824943542480462,"text":"Exercise 4 and decide which topic is being discussed.","h":0.013081394686243808},{"text":"1 'It would be better if everyone in the world","w":0.34354484558105469,"h":0.013081394686243808,"x":0.56236324457818154,"y":0.062500000167779235},{"x":0.58643326287137953,"text":"spoke the same language'","w":0.20568927764892575,"y":0.077034883888709493,"h":0.013081394686243808},{"y":0.077034883583837033,"h":0.01308139547767484,"x":0.96498905961961523,"w":0.019693653583526594,"text":"U"},{"w":0.35886211395263679,"x":0.56236324856708075,"y":0.091569767555133907,"text":"2 'Everyone in the world should learn to speak","h":0.013081394686243808},{"h":0.01308139547767484,"text":"at least one foreign language!","w":0.22975929260253902,"x":0.58862144587597343,"y":0.1061046511831587},{"x":0.56236325314294722,"w":0.36542667388916006,"y":0.1206395347466277,"h":0.01308139547767484,"text":"3 'All the world's school pupils should study the"},{"w":0.15754922866821286,"h":0.013081394686243919,"text":"Mandarin language.'","x":0.58862144956086071,"y":0.13517441876637415},{"h":0.01308139547767484,"text":"4 Choose the correct linkers to complete the essay.","w":0.4113785552978515,"x":0.53829322030876925,"y":0.16133720920156958},{"text":"Sometimes, more than one answer is correct.","w":0.35229759216308598,"h":0.011679774003404919,"y":0.17587209328867193,"x":0.56236324245237368},{"text":"Experts say there are about 6,500 different languages spoken","y":0.20331950240306207,"w":0.43326038360595709,"h":0.014703752984644436,"x":0.54485777751868436},{"y":0.21947674454156796,"text":"in the world today. Huge amounts of money and time are","w":0.43326038360595709,"h":0.013081394686243919,"x":0.54485776596507418},{"y":0.23401162776988349,"x":0.54704596272327644,"w":0.43107219696044929,"h":0.01308139547767484,"text":"spent on learning and translation, so it is not surprising that"},{"x":0.54704596380095694,"text":"some people believe life would be simpler if we all spoke the","y":0.2485465119046979,"h":0.01327921443955038,"w":0.43107219696044918},{"x":0.54704595516674859,"y":0.26307053941610892,"w":0.43107219696044918,"text":"same language. 'For example \/ However, many other people","h":0.01454573904330303},{"x":0.54266959091694034,"w":0.43763675689697268,"h":0.014706166057665837,"y":0.27906976775182835,"text":"feel that language is an essential part of identity and that"},{"y":0.29502074709137294,"w":0.42013130187988279,"h":0.014572275723659156,"text":"having just one language would damage individual cultures.","x":0.54485776612789227},{"h":0.013278008694470711,"y":0.31244813269143934,"w":0.43326038360595709,"text":"2On the one hand \/ On the other hand, there are some good","x":0.54485776596507418},{"text":"arguments for the idea of a single global language. 3Secondly \/","w":0.43544857025146488,"y":0.32697095462176173,"h":0.016182572614107937,"x":0.54485777539578462},{"w":0.43326038360595709,"x":0.54485776885347659,"text":"Firstly, for politicians and business people, there would be","y":0.34302325624020047,"h":0.014653092696953696},{"text":"no barriers to communication and doing business would be","x":0.54704596092896562,"w":0.43107219696044929,"y":0.35892116196092516,"h":0.013278007903039679},{"x":0.54692539201840651,"h":0.016219890167109674,"text":"easier and cheaper. 4For instance \/ To sum up, governments","y":0.37109065184892021,"w":0.43131813049316403},{"h":0.01327800790303979,"w":0.43107219696044929,"x":0.54704595302415182,"text":"and international companies would not have to spend large","y":0.38796680527255523},{"y":0.40248962661241661,"h":0.013278008298755251,"w":0.43326038360595698,"text":"sums of money on translation or multi-lingual staff. SSecondly \/","x":0.54704596240927517},{"h":0.014590369418448934,"text":"Thirdly, a single world language would probably be good for","x":0.54704596200482269,"w":0.43107219696044918,"y":0.41860465145822368},{"y":0.4331395347466277,"x":0.54704596272327644,"w":0.43107219696044929,"h":0.01308139547767484,"text":"tourism. ®For example \/ For instance, tourists would feel safer"},{"h":0.011793158361031342,"y":0.44896265541425029,"text":"overseas and be more comfortable visiting certain countries if","w":0.42888401031494139,"x":0.54923414525828418},{"y":0.46348547728885547,"x":0.54485777766373045,"h":0.014712196761641816,"w":0.2997811698913575,"text":"they knew they could communicate easily."},{"h":0.013278007903039679,"text":"'On the one hand \/ On the other hand, there are several","x":0.5470459612936629,"y":0.48091286345421103,"w":0.43107219696044929},{"y":0.49709302356578178,"x":0.5448577761215323,"text":"important arguments against a single global language. ®First","w":0.43544857025146477,"h":0.014534882984715503},{"x":0.54485777335019436,"h":0.016182572614107937,"text":"of all I However, a nation's language is a significant part of its","y":0.51161825687229356,"w":0.43326038360595698},{"text":"culture and character. For example, when Poland was occupied","h":0.011802807487392819,"x":0.5470459512280178,"y":0.52761627946115253,"w":0.43107219696044918},{"text":"by other countries in the past, the Polish language helped","w":0.43107219696044918,"x":0.5470459512280178,"y":0.54215116314621925,"h":0.013081394686243808},{"x":0.54465290682209555,"h":0.018258831609828774,"text":"people preserve their identity and traditions. For instance \/","y":0.55495471131421237,"w":0.43583683013916019},{"text":"Furthermore, many people get pleasure, satisfaction and even","x":0.5492341479278684,"y":0.57261410786635913,"w":0.42888401031494139,"h":0.01327800829875514},{"text":"income from studying, using and teaching different languages.","w":0.43326038360595709,"x":0.544857775024155,"y":0.58713692935204287,"h":0.014607256181012551},{"w":0.43107219696044929,"h":0.014644648919956316,"text":"For them, a single global language would not be an advantage.","y":0.60319767472857255,"x":0.54704596272327644},{"y":0.62063953519079273,"w":0.43107219696044918,"h":0.013081394686243808,"x":0.5470459512280178,"text":"1°\/n conclusion \/ Finally, although there are some reasonabie"},{"text":"arguments for the idea of a single world language, it is hard","h":0.0146181122396003,"w":0.42888401031494139,"x":0.54923414270905013,"y":0.6351744187910725},{"x":0.54485777628079757,"h":0.015988371283186864,"y":0.64970930267858928,"w":0.43326038360595709,"text":"to imagine it could ever happen. 1Personally, I think \/ In my"},{"h":0.016182572614107937,"x":0.54485777832831228,"w":0.43326038360595709,"text":"opinion, if there ever was a single language, the world would","y":0.66556016586727595},{"w":0.28446388244628906,"h":0.013081394686243808,"text":"be a far less interesting and varied place.","y":0.68168604700644209,"x":0.54923414242018143},{"x":0.538293208934011,"y":0.71366279119248854,"w":0.38949672698974613,"text":"5 Complete the table with the words in the box.","h":0.013081394686243919},{"y":0.73982558165397094,"w":0.16192560195922856,"h":0.013286451284321488,"text":"Finally For instance","x":0.58643326298829224},{"h":0.012033195020746845,"w":0.17943107604980468,"text":"give a personal opinion","x":0.75929977701886142,"y":0.74107883813604247},{"h":0.013278008694470711,"text":"give examples introduce a conclusion","w":0.2975929832458496,"x":0.58424508182711177,"y":0.7543568464114514},{"text":"list arguments Personally, I think show contrast","x":0.58424508004012832,"y":0.76887966807834762,"w":0.38293216705322275,"h":0.013278007903039679},{"x":0.57330416104674553,"w":0.13785557746887211,"y":0.79651162824991228,"text":"Linkers used to ...","h":0.011787126865624442},{"h":0.011772652384651083,"x":0.57330415851369576,"y":0.81395348855029992,"text":"list arguments","w":0.10722100257873535},{"h":0.011772652384651083,"y":0.81395348857936978,"text":"First of all \/ Firstly \/ Secondly \/","w":0.22975929260253902,"x":0.75492341945365382},{"h":0.013290554062459381,"x":0.75270705220212175,"text":"For example \/","w":0.10946554183959967,"y":0.84437216485694688},{"w":0.010940918922424325,"text":"4","y":0.87500000034293557,"x":0.57330415751544717,"h":0.011627906387772224},{"y":0.90552325613219053,"w":0.010940918922424325,"h":0.010174418089300752,"x":0.57330415751544717,"text":"5"},{"w":0.22100656509399419,"h":0.010373443983402453,"x":0.75492341145373232,"y":0.87634854771398552,"text":"However \/ On the one hand \/"},{"w":0.14004376411437991,"text":"On the other hand","y":0.89087136910229636,"x":0.75492341474806168,"h":0.010373443983402453},{"y":0.90649198341735349,"text":"In my opinion \/","w":0.12060746192932137,"x":0.75041837092587793,"h":0.015504404914824299},{"y":0.9360465117160085,"h":0.010174418089300752,"x":0.57330415749721231,"text":"7","w":0.010940918922424214},{"w":0.20131290435791016,"x":0.75273523518428331,"h":0.011668917944817059,"y":0.93895348881192775,"text":"In conclusion \/ In summary"}]
[{"w":0.15038226127624513,"h":0.019091516410579823,"text":"WRITING","x":0.1938720493544038,"y":0.014436800005829253},{"x":0.063180828648976506,"h":0.03633720848979205,"y":0.039244186371019674,"w":0.076252722740173334,"text":"2.7"},{"x":0.19172113363450435,"y":0.05813953501705893,"w":0.061002178192138684,"h":0.013081394961037107,"text":"A story"},{"h":0.011731986697766317,"w":0.42047927856445316,"text":"1 Match the opening sentences 1-3 with techniques","x":0.052287599089233049,"y":0.12489591990160342},{"y":0.14244186055804575,"text":"a-c.","w":0.032679736614227295,"h":0.0087209299740247381,"x":0.078431373931448431},{"x":0.078431394948274585,"y":0.15695253956080024,"w":0.39651412963867183,"h":0.013105599707509019,"text":"1 My dream of going on safari finally came true last"},{"w":0.32244007110595707,"text":"year, but it almost turned into a nightmare!","h":0.011820333784168469,"x":0.10239651815072531,"y":0.17277268923961975},{"h":0.010174418567717725,"y":0.18604651177355391,"x":0.078431372756680828,"w":0.010893245935440055,"text":"2"},{"y":0.20058139519773022,"w":0.010893245935440068,"text":"3","h":0.010174418567717836,"x":0.078431372566049026},{"y":0.18604651198532451,"w":0.18518518447875976,"text":"How high is a mountain?","h":0.013081394961037107,"x":0.10457516296214521},{"text":"What's the worst thing your best friend has ever","x":0.10021786093231867,"y":0.20058139556696208,"h":0.013081394961037107,"w":0.36165576934814453},{"h":0.013775387969640396,"text":"said to you?","w":0.093895463943481444,"x":0.10228974133613949,"y":0.21476928298141518},{"x":0.078431372811147065,"y":0.23837209307984808,"w":0.010893245935440068,"h":0.0087209299740247381,"text":"a"},{"text":"b","y":0.24999999984889298,"w":0.010893245935440068,"h":0.010174418567717836,"x":0.078431372566049026},{"text":"Asking a rhetorical question","h":0.011660583013301085,"x":0.10457517203401054,"y":0.23688592825176624,"w":0.20697166442871093},{"text":"Referring to personal experience","x":0.10457516089967342,"y":0.24999999997587685,"w":0.24400871276855471,"h":0.013114071606994182},{"x":0.078431374376909418,"y":0.26598837232504891,"w":0.25925926208496097,"text":"c Speaking directly to the reader","h":0.011696890133008897},{"text":"2 Complete the advice for writing a story with the","w":0.40522872924804687,"h":0.013081394961037107,"x":0.052287601225649641,"y":0.28633720944171981},{"x":0.078431376664265071,"text":"words from the box. There are two extra words.","w":0.3790849685668945,"y":0.30087209332795584,"h":0.011784026664460656},{"y":0.32847626982125244,"h":0.011656952539550236,"x":0.098039219181778423,"w":0.26579519271850582,"text":"adjectives character conclusion"},{"w":0.054466228485107404,"x":0.098039217747279223,"y":0.34302325631245201,"text":"ending","h":0.011627906367344121},{"h":0.013322231473771762,"text":"opening problem","w":0.15686273574829104,"x":0.16775599857465615,"y":0.34138218157199618},{"x":0.32897603389852637,"w":0.047930283546447738,"y":0.34447674436376285,"h":0.0087209299740247381,"text":"scene"},{"w":0.06971677303314211,"h":0.011627906367344121,"text":"speech","x":0.098039218131213968,"y":0.35755813969423489},{"h":0.010174418567717836,"text":"tenses title","w":0.10239650726318358,"x":0.16775599477073208,"y":0.35755813972292405},{"text":"3","w":0.013071894645690918,"h":0.010174418567717725,"y":0.54651162779826323,"x":0.0522875819799868},{"text":"Give your story a catchy title","y":0.38081395351875469,"w":0.21350761413574218,"h":0.013081394961037107,"x":0.1045751663526083},{"y":0.39534883705819535,"text":"Use direct","w":0.093681917190551758,"h":0.010174418567717836,"x":0.10457516315490568},{"y":0.39675270598355028,"x":0.23093681749448436,"w":0.2352941131591797,"h":0.011677526415238004,"text":"_to make the story come alive."},{"x":0.078431372783913961,"text":"3","y":0.4113372095769412,"h":0.0087209299740247381,"w":0.010893245935440055},{"x":0.078431372783913961,"y":0.42587209329787135,"w":0.010893245935440055,"text":"4","h":0.0087209299740247381},{"x":0.10457516656483513,"w":0.21568626403808594,"h":0.013097127808023745,"y":0.40988372134215589,"text":"Give your story a memorable"},{"x":0.10438165133064416,"text":"Set the","w":0.08535434722900391,"h":0.012950832897380082,"y":0.42375714166874301},{"text":"by saying where and when the story","h":0.013322231473771873,"w":0.27450979232788086,"y":0.4242298084780326,"x":0.2178649307786884},{"text":"is set and who is involved.","x":0.10239651499803322,"y":0.43880099925046068,"w":0.19825708389282226,"h":0.011780395793676512},{"x":0.078431372566049026,"y":0.45348837194191627,"h":0.010174418567717836,"w":0.010893245935440068,"text":"5"},{"x":0.078431372783913961,"y":0.46947674446066201,"w":0.010893245935440055,"h":0.0087209299740247381,"text":"6"},{"text":"7","y":0.48255813938377679,"w":0.010893245935440068,"h":0.010174418567717725,"x":0.078431372566049026},{"w":0.07413779735565186,"h":0.010381641435583511,"x":0.10236465375483579,"text":"Include a","y":0.45338476064987732},{"y":0.4549418607334792,"w":0.25925926208496097,"h":0.011752560573453974,"text":"_ or introduce an exciting situation.","x":0.22875817176253035},{"x":0.10239652536084755,"y":0.46794338053470308,"h":0.011707781951294516,"w":0.19825706481933597,"text":"Use a range of narrative_"},{"text":"_to tell your story.","y":0.46794338060291318,"x":0.33769063394417359,"w":0.13725489616394043,"h":0.013322231076738467},{"text":"Write a strong","x":0.10435251605716399,"h":0.010555030305022362,"y":0.48309414551934671,"w":0.10714599609374999},{"y":0.48401162840547529,"x":0.26579520874665036,"w":0.18300653457641602,"text":".sentence to engage the","h":0.011825174415836082},{"x":0.10238345152564785,"y":0.49851029287699555,"text":"reader.","w":0.054492354393005371,"h":0.0087933679305941537},{"w":0.010893245935440068,"x":0.078431372566049026,"text":"8","y":0.51162790696066207,"h":0.0087209299740247381},{"w":0.24618736267089841,"x":0.098039220371159252,"y":0.51162790718454509,"text":"Include a variety of adverbs and","h":0.011685997917689872},{"x":0.40305010948187459,"text":"to make the","y":0.5116279068256373,"h":0.010174418567717725,"w":0.095860567092895532},{"y":0.52747710256586311,"text":"language interesting.","h":0.010407993338884203,"w":0.16339868545532227,"x":0.10239652056209912},{"y":0.54651162788285346,"text":"Read the story An African Thriller and match the","x":0.078431370612875431,"w":0.38126361846923829,"h":0.013081394961037107},{"x":0.078431391159715674,"h":0.011679946731071866,"text":"underlined sentences and phrases with the advice in","y":0.56244795986829776,"w":0.41176467895507818},{"x":0.080573255333157637,"text":"Exercise 2.","h":0.010456772866991537,"y":0.57689370656082761,"w":0.087219505310058579},{"text":"1 (a)","h":0.013081394961037107,"w":0.047930283546447752,"x":0.076252723629826227,"y":0.60319767453983031},{"y":0.60174418625596138,"h":0.015988371354356379,"w":0.039215686321258547,"text":"20","x":0.12854030507466482},{"w":0.013071894645690918,"x":0.18518518546582555,"h":0.010174418567717836,"text":"3","y":0.60465116268198404},{"h":0.0087209299740247381,"x":0.35294117648761769,"y":0.60610465135019698,"w":0.010893245935440055,"text":"6"},{"text":"70","h":0.014534882760663281,"w":0.039215686321258547,"x":0.40305010851693063,"y":0.60319767495687771},{"x":0.45751633945374981,"h":0.013081394961037107,"w":0.039215686321258547,"y":0.60319767468517915,"text":"80"},{"w":0.40958606719970703,"x":0.53159040461365403,"y":0.02906976777664505,"text":"4 Complete the story in Exercise 3 with the correct","h":0.014643804119786719},{"w":0.42265792846679684,"h":0.013322231473771873,"text":"form of the verbs in brackets. Where possible, use the","y":0.044962531243340931,"x":0.55773422187771249},{"w":0.2834363746643066,"h":0.012031445594552492,"x":0.55764749738554287,"y":0.059224089270324409,"text":"Past Perfect or the Past Continuous."},{"x":0.53355886714057088,"text":"5 Read the story A Mistake on the Mountain. Choose","y":0.082781827363563321,"w":0.42301498413085947,"h":0.016869650593804519},{"text":"the correct linkers.","y":0.10029069764928067,"x":0.55773420751075431,"h":0.010174418567717836,"w":0.14814814567565926},{"y":0.1322674423711776,"x":0.54684097487211414,"h":0.024709301328381228,"text":"A Mistake on the Mountain","w":0.41612197875976564},{"h":0.010407993338884203,"x":0.54901962542442162,"y":0.16985845111635012,"text":"How high is a mountain? I've reached many peaks, but on this","w":0.41176467895507818},{"h":0.010407993338884203,"y":0.18442964208416834,"text":"trip everything possible went wrong","w":0.2483660125732422,"x":0.54684095575041614},{"h":0.011747719941786472,"x":0.549019606293221,"text":"My best friend Joe and I arranged to meet early one morning","w":0.40740741729736329,"y":0.20191507079977178},{"w":0.39651412963867183,"text":"in summer. We both know mountains are dangerous, but it","y":0.21648626148562433,"x":0.5468409782452972,"h":0.01171141282207866},{"y":0.23105745227781282,"w":0.14596949577331542,"h":0.011675105702370847,"x":0.54901961014711131,"text":"was also really ahot \/"},{"w":0.21350761413574215,"h":0.010407993338884314,"x":0.74291939198804757,"y":0.23105745196735461,"text":"so 'after that \/ before we left we"},{"w":0.40958602905273434,"text":"had agreed to pack a map, some water and just a few snacks","y":0.24562864276986707,"x":0.54684096717297936,"h":0.011656952539550347},{"y":0.2630813956050877,"text":"2After a couple of hours \/ By the end of the journey, the path","w":0.39215686798095695,"x":0.54684096252368253,"h":0.011689628391440499},{"y":0.27761627928725818,"h":0.011725935511148422,"x":0.54901960666158434,"text":"started to get very difficult. We had intended to reach a small","w":0.40958606719970703},{"w":0.39869277954101567,"x":0.54684098070879483,"h":0.011762242630856123,"y":0.29215116304694821,"text":"lake by lunch time \/ the following afternoon but we couldn't"},{"w":0.41612197875976564,"h":0.011798549353530419,"text":"find it. We kept looking at the map but we didn't want to waste","y":0.30668604674365363,"x":0.54901962584342867},{"w":0.41394332885742191,"h":0.011834856076204714,"text":"time arguing, so we just kept walking. \"Later \/ At first, we saw","y":0.32122093058570789,"x":0.54684096483781075},{"x":0.54901960860115651,"y":0.33555370510832083,"w":0.40305011749267583,"text":"it. But strangely, it looked different to what we had expected","h":0.011830015444537212},{"w":0.37908496856689444,"h":0.013081394961037107,"y":0.35174418602238844,"x":0.54684095173688707,"text":"5By the end of the afternoon \/ On the first morning we had"},{"y":0.36761032489285261,"h":0.011750139860586817,"x":0.54901960883612733,"w":0.39433551788330079,"text":"finished all our food and water and were feeling extremely"},{"w":0.050108933448791526,"h":0.0088068567445931389,"y":0.38218151527730293,"text":"btired \/","x":0.54901960684858908},{"y":0.38218151532192235,"text":"_. We weren't walking anymore either, we were","w":0.31808279037475595,"h":0.011713833534945817,"x":0.64488017609076276},{"y":0.39675270598355028,"h":0.011677526415238004,"w":0.20479301452636722,"x":0.54901961365184915,"text":"climbing. I was quite 'scared \/"},{"y":0.41423813481601002,"x":0.54901960265841576,"text":"Suddenly Joe shouted excitedly. 'I can see the top'. Finally \/","h":0.011656952539550347,"w":0.38779956817626959},{"y":0.42877906997524273,"text":"Later, we had arrived. We felt really good \/_","x":0.54901961525389764,"h":0.011687208075606748,"w":0.29629629135131841},{"x":0.88017429348037479,"w":0.05882352828979498,"text":"_. While","h":0.010407993338884314,"y":0.43005828462538997},{"h":0.010407993338884314,"x":0.5490196010425844,"w":0.38779956817626948,"text":"we were looking at the view, we clearly saw the mountain","y":0.44462947559320809},{"text":"we had planned to climb. We were on the wrong mountain!","h":0.011759821917988855,"w":0.39651416778564452,"x":0.54901959960391,"y":0.45784883758667672},{"y":0.4723837211985954,"w":0.26361654281616209,"text":"Luckily, we found an easier path down.","x":0.54901961859736559,"h":0.011796129037696668},{"h":0.013110440339176632,"x":0.54684096527917869,"y":0.48834304762099312,"w":0.41176467895507818,"text":"\" After that \/ Eventually we got back home. Everyone was very"},{"w":0.40522876739501945,"h":0.011825174415836082,"text":"impressed with our amazing achievement, so we decided not","x":0.54901960728288235,"y":0.50416319731434756},{"y":0.51873438810411343,"x":0.54901960990075993,"text":"to mention our big mistake!","h":0.011788867296128269,"w":0.18954248428344722},{"w":0.44444442749023438,"text":"6 Replace the adjectives in bold in the story in Exercise 5","x":0.5337690661023774,"y":0.55079100762242583,"h":0.01170899210921128},{"text":"with stronger adjectives from the box. There are two","x":0.55991286234707982,"w":0.41176467895507818,"y":0.56536219810236765,"h":0.011672685386536985},{"h":0.010182890070169592,"w":0.098039216995239209,"x":0.55991285411131275,"text":"extra words.","y":0.57993338885395096},{"text":"angry","w":0.043572983741760218,"x":0.57952069723587374,"h":0.0087209299740247381,"y":0.60901162809438292},{"text":"boiling","h":0.01162790636734401,"x":0.5795206990744397,"w":0.054466228485107404,"y":0.62063953515208392},{"h":0.010174418567717836,"x":0.64488017490277938,"y":0.60610465130238145,"w":0.13725489616394049,"text":"awesome awful"},{"y":0.62018970522905692,"h":0.011074078073112448,"text":"exhausted","w":0.080855827331542951,"x":0.65347186745953934},{"h":0.010826754828079044,"text":"terrified","y":0.62031336685466953,"w":0.063411169052124072,"x":0.75805476326603938},{"text":"aAn African Thriller","w":0.3594771194458008,"h":0.023313905079100805,"x":0.47494553363221953,"y":0.65986677757454926},{"h":0.013322231870805279,"text":"\"My dream of an African safari finally came true last year, but it almost turned into","x":0.34858389133597306,"w":0.56862743377685554,"y":0.69317235601366323},{"text":"a nightmare! It was our third night in Africa and my sister Jenny and I were getting","w":0.5795206832885742,"h":0.010174418567717836,"x":0.35294119065418772,"y":0.70930232558169337},{"h":0.011799759511447294,"x":0.35511982295600319,"y":0.72383720966516518,"text":"ready for bed in our log cabin. It had been (be) an amazing day and we were completely","w":0.60348583221435548},{"x":0.35729850131591684,"y":0.73837209318260699,"w":0.50762523651123059,"h":0.01162790636734401,"text":"exhausted but we couldn't stop talking about the incredible animals we'"},{"x":0.35729847482954952,"h":0.011828804889586819,"y":0.75270607833284475,"text":"that morning. Ten minutes later we had just put out the light when lenny screamed.","w":0.58387798309326167},{"w":0.18954248428344733,"h":0.011718674166613541,"y":0.77470930248493253,"text":"Earlier that day, our guide?","x":0.35947712602276438},{"x":0.61220044594914047,"y":0.77601998329270483,"w":0.33551197052001946,"h":0.010407993338884203,"text":"(tell) us stories about dangerous African animals."},{"x":0.29398237916439274,"y":0.78877504087513084,"text":"One man 3","w":0.076523261070251425,"h":0.011112708235461954},{"text":". (work) outside when a rhinoceros 4","x":0.43137255371013067,"y":0.78924418615741321,"w":0.24400871276855468,"h":0.011754981286321242},{"text":"_ (begin) to run after him.","x":0.73202614253262799,"y":0.79059117382536404,"w":0.17647058486938472,"h":0.011734407410633474},{"x":0.076252743950737806,"h":0.017512053871631239,"w":0.85403045654296872,"text":"*And two girls spent the night in a tree after a crocodile had tried to eat them. The guide warned us to check under our beds","y":0.80516236469250979},{"h":0.014571190674437906,"y":0.81973355546405025,"x":0.07843138688688242,"w":0.44226577758789065,"text":"before going to sleep. Of course we thought he_ (joke)."},{"text":"(look) where Jenny?","w":0.13725489616394043,"y":0.84138218161012168,"h":0.011815492358434043,"x":0.16122004796922801},{"x":0.35947711888269523,"h":0.011681156888988742,"text":"- point) and then I saw it. A huge snake was lying under the table right next to the door.","y":0.84302325626400243,"w":0.59477123260498055},{"h":0.011717464008696554,"text":"I was 'absolutely terrified. 'Quick! Get in the cupboard' I shouted. As we were running for safety, I grabbed my phone. After we","y":0.85755813978144435,"x":0.078431401187959368,"w":0.86928100585937496},{"y":0.8720930234739388,"text":"(shut) the cupboard door, 1°","w":0.24618736267089847,"h":0.013081394961037107,"x":0.15250545130797838},{"h":0.010407993338884314,"text":"_(ring) our guide.","x":0.39869281032067688,"w":0.12636165618896483,"y":0.87343880085403136},{"text":"He quickly arrived to help. While he'","y":0.89383846780762011,"x":0.0784313681893542,"w":0.26143791198730471,"h":0.011684787759772886},{"y":0.89383846803023481,"x":0.39869282117340943,"h":0.011684787362739479,"text":"_ (shine) his torch under the table, Jenny and I \"","w":0.3246187210083008},{"h":0.010174418567717836,"y":0.89534883717326319,"text":".(realise) our mistake.","x":0.78649237842616981,"w":0.14379084587097168},{"w":0.39869277954101556,"h":0.013101968836724875,"x":0.078431394652149933,"y":0.90840965870677814,"text":"\"It wasn't a snake after all, just some rolled up clothes. I 12"},{"w":0.27450979232788086,"text":"(never\/be) so embarrassed in all my life.","y":0.90988372123493266,"x":0.54030502126525337,"h":0.011627906367344121},{"x":0.061002179373916922,"text":"26","w":0.026143789291381829,"h":0.013081394961037107,"y":0.95494186082253396}]
[{"w":0.27489177703857426,"x":0.1168831185586349,"text":"EXAM SPEAKING","y":0.0071308721087782745,"h":0.020553691275167707},{"text":"STUDENT A","x":0.76406927067002106,"h":0.018963633767710486,"y":0.0087209299552165609,"w":0.17748916625976563},{"w":0.41991340637207025,"y":0.074127907282584227,"h":0.014534883051110614,"text":"Student A, look below. Student B, go to page 134.","x":0.025974036943834912},{"x":0.025974041042628359,"h":0.013081395386049466,"text":"1 In pairs, ask and answer the questions.","w":0.32034629821777344,"y":0.10610465112601597},{"h":0.011774231123444112,"text":"Talk about different topics.","y":0.12790697677209528,"w":0.2164502143859863,"x":0.047619052258666167},{"text":"1 What's your favourite TV series of all time? Why?","x":0.047619050371770263,"y":0.14093959714623128,"w":0.38528137207031254,"h":0.013130170386909668},{"x":0.047619052983024802,"w":0.36147186279296872,"y":0.15687919456381672,"h":0.011744966442953086,"text":"2 Tell me about the type of house and the area"},{"text":"where you live","x":0.073456486563775056,"y":0.17092197893007555,"w":0.10633378028869629,"h":0.012807205219396822},{"text":"3 What kind of technological device couldn't you","w":0.37484573364257812,"x":0.047428001665673847,"h":0.017189619525166955,"y":0.18243673798447291},{"y":0.19912790706279293,"w":0.14069263458251952,"h":0.011627906920925857,"text":"live without? Why?","x":0.071428573076705623},{"text":"4 Tell me about a summer job you would like","w":0.35088161468505863,"x":0.51718978120960879,"h":0.015122216819916767,"y":0.14092659770885474},{"h":0.01317894498773875,"w":0.26406925201416009,"x":0.54329005261846108,"text":"to do using your skills and abilities.","y":0.15687919454758248},{"w":0.32251083374023437,"x":0.51948051709092169,"y":0.1715116278476766,"h":0.011793741443813288,"text":"5 When was the last time you felt unwell?"},{"text":"What happened?","y":0.18604651156860685,"h":0.011627906920925857,"x":0.5454545497886677,"w":0.13203462600708005},{"x":0.025974065140628964,"text":"2 Look at the photo of the young people wearing fashionable clothes. Take turns to talk about what you can see in your","w":0.88744583129882815,"y":0.22818791958533935,"h":0.013091150146202768},{"text":"photos. Talk about the people, the clothes and the other things in the photo.","h":0.013139924747031739,"y":0.24273255849673514,"x":0.047619071649380944,"w":0.56493503570556636},{"h":0.010174418455802359,"x":0.023809524134297107,"w":0.015151515007019042,"text":"3","y":0.50581395349012204},{"y":0.50713087261751733,"h":0.013422818391915059,"x":0.036796569217002147,"text":"You and your friend want to buy a birthday present for a fashionable female friend. Here are some of the presents you","w":0.87878784179687497},{"y":0.52034883702717882,"w":0.634199104309082,"h":0.013208210068261117,"text":"could choose. Talk together about the different presents and say which would be best.","x":0.047619055448273002},{"x":0.025974027589224881,"h":0.01342281839191517,"w":0.23160173416137694,"text":"4 Talk about buying presents.","y":0.85738255061509927},{"w":0.33766231536865238,"x":0.049783563744245175,"text":"• Do you enjoy buying presents for people?","y":0.87499999989660715,"h":0.013081395386049466},{"h":0.013130170386909557,"text":"Why? Why not?","w":0.12121212005615235,"y":0.8909395972043711,"x":0.071428572439456314},{"text":"• Where do you usually go to buy presents?","y":0.90552325576725401,"w":0.33549781799316408,"h":0.010174418455802359,"x":0.051948066292018036},{"y":0.91411360122307173,"w":0.39460853576660154,"h":0.02023017486469858,"x":0.05147392483088481,"text":"• What sort of presents do you like receiving? Why?"},{"w":0.38744586944580073,"text":"• Do you think it's easy or hard to buy fashionable","x":0.52597403707363644,"y":0.87499999985057997,"h":0.013081395386049466},{"h":0.013149680307247502,"w":0.20129869461059569,"text":"presents for friends? Why?","x":0.55194805730509178,"y":0.88953488362964972},{"h":0.013208209668229998,"w":0.35281383514404296,"text":"• Who is the hardest person you know to buy","x":0.52597403128079234,"y":0.90394295318467832},{"text":"a present for? Why?","x":0.55161373333967434,"w":0.15238228797912601,"h":0.016253544980247558,"y":0.91697107182989535},{"text":"15","y":0.95930232539927185,"w":0.02597402572631835,"h":0.013081395386049355,"x":0.90909090926887559}]
[{"text":"4.4","x":0.065645514676928376,"h":0.026162790955349569,"y":0.045058139569563616,"w":0.065645513534545882},{"w":0.16211454391479496,"y":0.014198505707175513,"h":0.021021593655788151,"text":"READING","x":0.19246570541483632},{"h":0.017705844546749394,"text":"Feed your mind • collocations","y":0.054357323307540284,"w":0.24563587188720704,"x":0.19225451275049793},{"x":0.53391684966062836,"h":0.010174418089300752,"text":"1","w":0.013129101991653513,"y":0.030523255998954224},{"w":0.36105030059814447,"x":0.54923415068561043,"text":"Read the two texts quickly and decide which","y":0.030523256363273465,"h":0.013081394686243808},{"text":"statement 1-3 is false.","x":0.55798687552351123,"y":0.045058139926268836,"w":0.17943105697631834,"h":0.011788333006419682},{"x":0.56017505045434479,"w":0.3282275772094726,"y":0.062500000167779235,"h":0.013081394686243808,"text":"1 Both texts offer advice to young people."},{"text":"Both texts were written by students.","x":0.58205690253914466,"y":0.07703488407645176,"w":0.27133478164672853,"h":0.013081394686243808},{"text":"3","w":0.010940918922424325,"x":0.56017505489874408,"h":0.0087209297908291683,"y":0.093023255962143558},{"y":0.091569767797381907,"w":0.37199123382568355,"h":0.013081394686243919,"text":"Both texts concern the topics of students and food.","x":0.58424507710612261},{"text":"The Uni Years","w":0.16192560195922853,"x":0.13566739730630842,"h":0.017557656220875351,"y":0.13941908747499265},{"h":0.014584337923042034,"w":0.23851203918457037,"x":0.096280087428137873,"text":"year 1, day 86 by Scott Hastings","y":0.1758720933186888},{"w":0.28884025573730465,"x":0.061269150103630675,"y":0.20622406625254319,"h":0.011799189460722781,"text":"Although we still argue about who does"},{"text":"the washing up, my housemates and l are","y":0.22365145236592898,"h":0.011813663545980457,"x":0.059080968237044153,"w":0.30634572982788083},{"x":0.061269157609823918,"text":"doing a bit better with cooking than we","w":0.28446388244628906,"y":0.24107883797858132,"h":0.012033195020746845},{"text":"were. 1","h":0.010174418089300863,"y":0.25872093032065968,"x":0.061269148318958334,"w":0.067833695411682132},{"h":0.011818488504876767,"x":0.13347921441754573,"w":0.22757110595703123,"text":"_ Tonight we're doing spaghetti","y":0.25872093059971846},{"y":0.2775008548913882,"h":0.01185875572109607,"x":0.061232838754665196,"text":"bolognese.","w":0.083223600387573232},{"y":0.30082987558403806,"w":0.2932166290283203,"h":0.01327800790303979,"text":"Yes, we're doing better now, but the first","x":0.061269150124789465},{"x":0.059080970896048871,"h":0.011767827821470345,"w":0.30415754318237304,"text":"few months of cooking and eating on our","y":0.31976744205805185},{"w":0.29102844238281245,"x":0.061269147873145219,"text":"own were pretty terrible. Gavin survived","y":0.33720930276541616,"h":0.011753352944781748},{"h":0.011738878463808389,"text":"on his mum's frozen meals which she","w":0.27352296829223632,"y":0.35465116289138521,"x":0.06126914922368492},{"text":"delivered every month in sets of 25. Liam","y":0.37209302350185025,"w":0.30196935653686524,"h":0.011724403982835252,"x":0.061269156086052982},{"y":0.39087136910182285,"w":0.30196935653686519,"h":0.0088379329665568829,"x":0.063457338635287214,"text":"didn't even know how to make toast when"},{"w":0.27571115493774412,"text":"he first arrived, but then he learned to","x":0.061269145561762599,"y":0.40829875521361969,"h":0.010373443983402453},{"h":0.011773858525446323,"w":0.30196935653686524,"text":"open cans and heat up the contents, and","x":0.061269149448562314,"y":0.42572614098626937},{"h":0.011788333006419571,"w":0.27789934158325191,"text":"so lived off baked beans and soup. At","x":0.061269145364464525,"y":0.44315352697041233},{"text":"first, Sarah managed to persuade Gavin","x":0.061269146864395656,"w":0.2932166290283203,"h":0.011649618504947723,"y":0.46220930276541616},{"text":"to share quite a few of his mum's frozen","y":0.4796511629938669,"w":0.2910284423828125,"h":0.010174418089300863,"x":0.061269152249512689},{"w":0.27571115493774417,"text":"delights, but then she got a boyfriend.","x":0.063457337410777651,"y":0.49709302355029994,"h":0.011627906387772224},{"x":0.063457330363733147,"y":0.5145348838090319,"text":"2","w":0.010940918922424311,"h":0.010174418089300752},{"x":0.06345733548538568,"w":0.23194747924804687,"h":0.010174418089300752,"y":0.53924418624968107,"text":"However, there have been a few"},{"x":0.063457337269570965,"y":0.55668604685456347,"w":0.29102844238281245,"h":0.011778683484342634,"text":"disastrous* attempts* to feed ourselves."},{"x":0.063457330957382471,"y":0.57551867227760911,"w":0.22319475173950193,"h":0.011690629666276986,"text":"3_ According to Liam, it was"},{"h":0.013081394686243808,"w":0.30415754318237304,"text":"'absolutely delicious' and 'sure to appear","x":0.059080960757464281,"y":0.59156976774893244},{"w":0.27133478164672853,"h":0.010373443983402564,"text":"in Jamie Oliver's next cookbook: One","x":0.061269149658036287,"y":0.61037344412672012},{"x":0.063457335286486116,"h":0.010174418089300752,"y":0.62936046520438071,"w":0.10503281593322755,"text":"Minute Meals'."},{"y":0.15394190910502337,"text":"10 Top Tips For Student Cooks","w":0.45295402526855466,"h":0.02338367161414423,"x":0.43544859364581012},{"w":0.47921222686767573,"text":"Chef Sam Stern, who has been writing about cooking since he was","h":0.011670124085612299,"x":0.43763678295565855,"y":0.1875000002460363},{"h":0.013081394686243808,"y":0.20203488427025018,"x":0.43326041388527531,"w":0.48140041351318358,"text":"just fourteen, shares his cooking tips for students who are leaving"},{"y":0.21656976768789682,"w":0.35448577880859372,"text":"their families soon and heading off to university.","h":0.011646000082562002,"x":0.43544857963290212},{"y":0.23982558156776368,"w":0.013129101991653402,"text":"1","h":0.0087209297908292793,"x":0.43544857832583633},{"text":"Try and learn the basics before you leave","x":0.45514223704608042,"y":0.23982558188363323,"h":0.011627906387772224,"w":0.27571115493774417},{"h":0.011629112924282925,"text":"home: you will know what recipes work","w":0.26039386749267573,"x":0.46170678942105808,"y":0.25145228205739389},{"x":0.45951860108174258,"y":0.2630705392374697,"w":0.28446388244628906,"h":0.011638762842075323,"text":"for you and what equipment to take. There"},{"text":"probably won't be much storage space*","y":0.2761627910793697,"w":0.26258205413818358,"h":0.011804014023903409,"x":0.46170678212128025},{"text":"in your student kitchen, soonly take the","h":0.011660474563535361,"x":0.46170677891522954,"y":0.28921161821368413,"w":0.26477024078369144},{"text":"essentials.","x":0.45942348265052241,"y":0.30062971760122315,"w":0.074588484764099128,"h":0.013566146154126657},{"x":0.45951860822236368,"y":0.31976744204546592,"w":0.24288839340209967,"text":"Get someone to cook with you if you","h":0.010174418089300752},{"text":"haven t cooked betore. It you can't tind","w":0.25382930755615235,"h":0.0087896841690252581,"x":0.46389497537947305,"y":0.3327800831609824},{"x":0.46170678802331738,"text":"anyone, then follow the recipe very","w":0.23413566589355467,"y":0.34302325602412609,"h":0.013081394686243919},{"y":0.35584999109088977,"h":0.013590715337096326,"x":0.45940905536435439,"w":0.068052787780761737,"text":"carefully."},{"w":0.013129101991653402,"x":0.4376367617685788,"y":0.37354651171600861,"text":"3","h":0.010174418089300752},{"h":0.013278008694470711,"text":"Don't get stressed out if things go wrong,","w":0.28446388244628901,"x":0.44857769145373355,"y":0.37344398308675708},{"x":0.46170678809194771,"w":0.28008750915527342,"y":0.38662790746502851,"h":0.011712341387736913,"text":"you will learn from it. I still make mistakes"},{"w":0.25382930755615235,"h":0.011702691865659864,"text":"all the time. The skill of a good cook is","x":0.46170679359610317,"y":0.39825581417529987},{"h":0.011761796721778905,"text":"learning how to correct these mistakes.","w":0.25820568084716794,"x":0.46170678577991725,"y":0.41120331940815369},{"text":"4 Give yourself enough time and always read the recipe through before","w":0.47702404022216799,"h":0.011776270807036693,"y":0.42863070556998895,"x":0.43763678235062259},{"text":"you start. Cooking in a relaxed environment is much easier. I find that","y":0.44186046530175349,"w":0.45733039855957036,"h":0.011666505663226689,"x":0.4617067976841096},{"y":0.45348837219371074,"text":"listening to music always helps.","w":0.2100656318664551,"h":0.011656856141149752,"x":0.46170678676553267},{"y":0.47219917024364266,"x":0.45951860560664687,"w":0.48140041351318358,"h":0.011812457405185328,"text":"Look out for good places to shop - butchers' and greengrocers' can often"},{"x":0.46170679544196019,"text":"offer better value and taste than supermarkets. They can also give you","y":0.48381742721780752,"h":0.011822107322977837,"w":0.4638949584960938},{"x":0.46170678794233777,"y":0.49543568468458721,"w":0.47264770507812504,"text":"some great advice for what to do with the cheaper cuts of meat or more","h":0.012033195020746845},{"x":0.46389496868646063,"w":0.13129102706909179,"h":0.011635143628259015,"y":0.50871369314120862,"text":"unusual vegetables."},{"h":0.013081394686243919,"text":"6","x":0.43326039395510507,"w":0.017505470514297461,"y":0.52616279119248854},{"w":0.49452953338623046,"text":"Remember vegetarian food is cheap and can be just as tasty. Many of the","x":0.44857769231490779,"h":0.01327800829875514,"y":0.52614107883912142},{"x":0.46170678796770032,"w":0.48358860015869137,"y":0.539244186413672,"h":0.01179315796531577,"text":"world's finest cuisines use only a little meat and yet are some of the most"},{"y":0.55087209312394336,"text":"creative and healthiest.","x":0.46389497151235282,"w":0.15536104202270506,"h":0.011783508443238833},{"text":"Put your money together with your housemates to create your kitchen","x":0.461706796292428,"h":0.011685804707380787,"y":0.56970954376266825,"w":0.4595185852050781},{"y":0.58132780070049594,"x":0.46170679791533076,"w":0.45951858520507816,"h":0.011695454625173185,"text":"store cupboard - herbs, spices, etc. These can be expensive, but not if"},{"h":0.011747321845090197,"text":"you share. They make a world of difference to the flavour of yourmeals,","x":0.46170678794233777,"y":0.59447674448053245,"w":0.47264770507812504},{"text":"so are well worth the investment.","x":0.4617067896844978,"h":0.011737672323013149,"w":0.22319473266601558,"y":0.60610465126347823},{"x":0.46170678580081004,"text":"Great eating starts with wise shopping. If you make a plan before you","y":0.62354651198342848,"w":0.45514221191406246,"h":0.013081394686243808},{"w":0.48358860015869143,"y":0.63651452316843771,"h":0.013278007903039679,"text":"head to the supermarket, you'll avoid making impulse buys. For the same","x":0.46170679587251429},{"text":"reason, avoid shopping when you are hungry. Shop at the end of the day","x":0.45951860849941939,"y":0.64970930271138394,"w":0.47702404022216793,"h":0.013081394686243808},{"y":0.66133720959681164,"w":0.45295402526855472,"h":0.011691836202787576,"x":0.46170680046747309,"text":"as you will find the reduced section full, which means great bargains."},{"w":0.47702404022216799,"h":0.010373443983402453,"x":0.46389498803990054,"y":0.67427385889379055,"text":"Supermarket own-brands can be better and cheaper than named brands."},{"text":"Remember to look for the products with the longest sell-by dates* too.","y":0.6858921163670999,"w":0.46170677185058601,"x":0.46389497870818613,"h":0.011782301906728132},{"h":0.013278008298755251,"y":0.69751037328117627,"x":0.46170677604108817,"text":"You can often find them by checking at the back of the shelves.","w":0.41575492858886715},{"h":0.011646000082562113,"w":0.4660831451416016,"x":0.46389497592482271,"y":0.7165697677363464,"text":"Plan food that will last for more than onemeal if you can. For example,"},{"text":"a whole chicken is more expensive than pieces, but can make three or","x":0.46170679820708871,"y":0.729460580858594,"h":0.010373443983402453,"w":0.45951858520507816},{"h":0.012033195020746845,"w":0.48140041351318358,"text":"four other meals. A curry or a stew can last for days and is often cheap to","x":0.46170678941408666,"y":0.74107883806336805},{"h":0.013081394686243808,"x":0.46389496999602753,"text":"make. The freezer is your friend!","w":0.21444200515747069,"y":0.75290697685745955},{"text":"10 Cooking with your friends and housemates is not only a great social event","w":0.50765861511230459,"x":0.4376367806714187,"h":0.011645999686846542,"y":0.77178423248959771},{"text":"but also lets you split the cost. I'm a student, and every Tuesday night,","y":0.78340248960668901,"w":0.46170677185058595,"h":0.011655649604639051,"x":0.46389497755391929},{"text":"we have a dinner party for 10-15 people with each person paying a few","w":0.46827133178710945,"h":0.011787127261339903,"x":0.46389497336246277,"y":0.79651162811425336},{"x":0.46389497727017825,"text":"quid.*As a result, we have wonderful huge roast dinners and lots and","y":0.80813953543304096,"w":0.45733039855957036,"h":0.013081394686243808},{"x":0.45951859987956239,"text":"lots of laughs.","y":0.82116182587125319,"w":0.096280088424682664,"h":0.013278008298755251},{"x":0.059012594510647373,"w":0.078911352157592776,"y":0.86461812496499346,"text":"GLOSSAR","h":0.012042819612748445},{"h":0.011740084604603629,"w":0.30853391647338868,"x":0.072210063262211646,"text":"disastrous (adj) - very bad or unsuccessful","y":0.88506224073075546},{"text":"attempt (n) -the act of trying something","y":0.8982558140667618,"h":0.013081394686243808,"x":0.072210073512013195,"w":0.29759298324584965},{"y":0.91410788365272622,"x":0.072210069646482106,"text":"storage space (n) - space in a house or flat where things","w":0.41356674194335941,"h":0.011764209003369275},{"x":0.072210069932432577,"h":0.011776271202752153,"y":0.92863070544074644,"text":"can be kept until they are needed","w":0.24507658004760741},{"y":0.95639534904448587,"w":0.026258203983306874,"text":"50","x":0.061269147723882658,"h":0.011627906387772335},{"w":0.43107219696044918,"h":0.011740084604603629,"x":0.53391686095631785,"text":"sell-by date (n) - the date stamped on a food product after","y":0.88506224060963146},{"y":0.89958506207619937,"w":0.19474836349487312,"h":0.010373443983402453,"text":"which it should not be sold","x":0.53610503294074729},{"h":0.013081394686243808,"x":0.53610503682372501,"y":0.91279069795120937,"text":"quid (n) - informal pound (f) (plural also quid, not quids)","w":0.4135667419433593}]
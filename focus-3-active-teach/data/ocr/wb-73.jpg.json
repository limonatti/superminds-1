:0.04803493499755862},{"h":0.010174418051111855,"w":0.41484714508056642,"x":0.50873363684836304,"y":0.17005813976804873,"text":"5 You'd like to cook a balanced three-course meal for"},{"text":"your friends. What are you going to cook and how?","x":0.53275109985590552,"y":0.18459302330018623,"h":0.013081395090518977,"w":0.38864627838134758},{"h":0.010174418051111855,"w":0.013100436925888062,"text":"2","x":0.0065502181091083769,"y":0.2412790699170313},{"h":0.013095905697484533,"x":0.028384296606675789,"text":"Look at the photo of a natural landscape. Take turns to talk about what you can see in your photos.","w":0.73799125671386712,"y":0.24126455926541046},{"text":"Talk about the people, the place and the other things in the photo.","w":0.49781658172607413,"x":0.030567697892421287,"h":0.013081395090518866,"y":0.25581395359936265},{"text":"3 You and your friend are discussing ways you can help to stop climate change in your school. Here are some ideas.","y":0.51744186055067076,"w":0.86244537353515627,"h":0.013081395090518866,"x":0.0065502476210680524},{"text":"Talk together about the different ideas and say which would be most useful and why.","w":0.63318775177001962,"h":0.013081395090518866,"x":0.030567685614262742,"y":0.53197674433943043},{"x":0.0083987543141092053,"text":"4 Talk about climate change.","y":0.84268869762318521,"w":0.22774238586425782,"h":0.015251892775346776},{"x":0.030567676788881074,"text":"• Are you worried about climate change?","y":0.86189683854584465,"w":0.32314411163330081,"h":0.013103161397670537},{"x":0.054585156106980504,"w":0.12227073669433594,"y":0.87770382691982707,"text":"Why?\/Why not?","h":0.013311148086522451},{"h":0.013081395090518866,"w":0.31004365921020505,"x":0.03056768617000671,"text":"• What do you do at home to help stop","y":0.89098837227668826},{"text":"climate change?","y":0.90552325585226956,"h":0.013081395090518866,"x":0.058951969425757762,"w":0.12227073669433594},{"y":0.92005813971854877,"x":0.030567686495878484,"text":"• Is it easy to recycle things where you live?","w":0.34061134338378907,"h":0.013081395090518866},{"x":0.054585156543661723,"h":0.013081395090518977,"y":0.93459302331229843,"text":"Why?\/Why not?","w":0.12227073669433594},{"y":0.85755813944601966,"w":0.36026199340820309,"text":"• What sources of renewable energy are used","x":0.51310044314306003,"h":0.013081395090518866},{"w":0.12445414543151856,"h":0.011647254575707144,"x":0.53930131052659891,"text":"in your country?","y":0.87354409318035797},{"y":0.88643926820392005,"w":0.3733624267578125,"h":0.013311147689819336,"text":"• What are the dangers to animals from climate","x":0.51310044903011831},{"h":0.012047409019533717,"x":0.54140203410004772,"y":0.9024065281916146,"text":"change?","w":0.0656675481796265},{"h":0.011627906570815472,"y":0.96220930246625336,"text":"71","w":0.024017467498779199,"x":0.90174672493744756}]
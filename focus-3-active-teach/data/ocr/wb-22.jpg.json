0.15032680459159095,"y":0.82122093047911882,"w":0.35076251983642581,"text":"Why adid you decide \/ had you decided \/ were","h":0.011834856473238231},{"y":0.83555370527789452,"w":0.15904138565063478,"h":0.011830015444537212,"text":"you deciding to run?","x":0.14814814983989691},{"h":0.011793708324829399,"w":0.36383441925048826,"text":"A: Oh, well, last year my grandson and | were","x":0.10457516874076887,"y":0.85012489593442386},{"h":0.013081394961037107,"text":"watching the race on TV when he basked \/ had","w":0.35076251983642576,"x":0.1481481545698044,"y":0.86337209299913253},{"text":"asked \/ was asking: 'Grandad, have you ever","x":0.1503268090028804,"y":0.87926727720897646,"w":0.33551197052001958,"h":0.011721094482447292},{"x":0.15032679795274931,"w":0.28540304183959964,"y":0.89244186057442587,"text":"done that?' I told him that | hadn't run","h":0.010174418567717836},{"h":0.014499341915489627,"text":"a marathon and he said: 'Maybe you should","x":0.15022402746949554,"w":0.32921485900878905,"y":0.90691823398424631},{"w":0.35511981964111328,"text":"try'. So, I °did \/ have done \/ have been doing it","x":0.14814814526295847,"h":0.011672685386536985,"y":0.92296511663221947},{"x":0.14814814445394553,"w":0.19172113418579101,"y":0.93588676083291633,"h":0.013322231870805279,"text":"for my grandson, Timmy."},{"y":0.3226477935727281,"text":"At 8 a.m. the race hadn't started (start).","x":0.57952069653566995,"w":0.2962962913513183,"h":0.01310802002334277},{"text":"It","x":0.57952069766279624,"h":0.010174418567717836,"y":0.33866279067253646,"w":0.017429193258285514},{"y":0.33846794311531148,"x":0.70588235430766988,"w":0.12418300628662104,"h":0.013322231870805279,"text":"(begin) at 9 a.m."},{"h":0.013322231473771762,"text":"2 At 9:30 a.m. the competitors","x":0.55773420811501628,"y":0.35303913416307164,"w":0.23965141296386716},{"text":"3 А:","x":0.55773420523113337,"h":0.0088322716489819264,"w":0.047930283546447794,"y":0.36918604656822018},{"x":0.64905489542807859,"text"
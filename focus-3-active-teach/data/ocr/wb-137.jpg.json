[{"h":0.020348837135435671,"x":0.019607843766566262,"y":0.0072674419700728965,"text":"2.9","w":0.041394333839416507},{"h":0.020414189633282898,"y":0.0058139534526310266,"text":"EXAM SPEAKING","w":0.27450979232788086,"x":0.10675381980555848},{"w":0.17647058486938483,"text":"STUDENT B","y":0.0070774353769156306,"x":0.76034858430044605,"h":0.019150707743547102},{"w":0.32461872100830086,"h":0.011656952539550347,"x":0.013071908522719404,"y":0.074104912692889324,"text":"1 In pairs, ask and answer the questions."},{"h":0.011684787759772886,"x":0.034858390304205303,"text":"Talk about sport.","w":0.13507624626159664,"y":0.09447674429694819},{"y":0.10901162812510168,"w":0.37908496856689455,"h":0.013081394961037107,"x":0.034858380858165179,"text":"1 How do you feel if you are defeated in a sport?"},{"w":0.046183781623840327,"text":"Why?","y":0.12320494339068955,"x":0.058607455887285019,"h":0.0137645314873307},{"y":0.13808139576076051,"text":"2 Have you ever seen someone break a world record?","w":0.41394332885742191,"x":0.03703704566569737,"h":0.013081394961037107},{"y":0.1526162791124589,"h":0.010174418567717836,"x":0.061002179924866645,"text":"Give details.","w":0.095860567092895504},{"w":0.013071894645690918,"x":0.037037037281366605,"h":0.010174418567717725,"y":0.16715116263959073,"text":"3"},{"w":0.35947711944580074,"h":0.013322231870805279,"text":"When was the last time you took on a sporting","y":0.16694421290292838,"x":0.050108928839191297},{"w":0.1786492347717285,"h":0.013322231473771873,"text":"challenge? Give details.","y":0.18151540393736476,"x":0.061002179055675364},{"x":0.51198258094273641,"y":0.10901162807665199,"w":0.34640522003173824,"text":"4 Why do you think so many people look up","h":0.013081394961037107},{"w":0.31808279037475595,"h":0.011731986697766317,"y":0.12489592003241734,"x":0.53812635762307959,"text":"to sportsmen and sportswomen? Do you?"},{"y":0.13808139526555974,"h":0.010174418567717725,"x":0.51416122006060239,"w":0.010893245935440055,"text":"5"},{"w":0.32897602081298827,"h":0.013081394961037107,"y":0.13808139556696208,"text":"How important is it to earn a lot of money","x":0.52723311700817566},{"y":0.15261627916192333,"text":"in professional sports?","w":0.17211328506469725,"h":0.013081394961037107,"x":0.53812636572473194},{"y":0.20930232555727213,"h":0.013081394961037107,"w":0.81263610839843747,"x":0.013071910542974763,"text":"2 Discuss this question together. 'Is winning more important than taking part in a sport?' What do you think?"},{"y":0.24337531136100488,"x":0.062973133165757783,"text":"For winning:","h":0.01043174387910395,"w":0.098516569137573229},{"y":0.26727726897024784,"text":"Winning a sport...","x":0.063180831295965773,"h":0.011792498166912635,"w":0.15032679557800294},{"x":0.063180831508603569,"w":0.39433551788330079,"text":"• is the whole point of playing a competitive game.","h":0.014654696335105744,"y":0.28343023303827297},{"h":0.013322231473771873,"x":0.063180832763299402,"w":0.50980392456054691,"text":"• (or the idea of winning) makes sportspeople work hard and push","y":0.29933388853860177},{"text":"themselves to achieve great things.","h":0.011676315860287834,"w":0.26579519271850588,"x":0.087145979947936561,"y":0.31390507918384936},{"y":0.3284762696759036,"w":0.53159038543701176,"text":"• is important to sportspeople because they earn more prize money.","x":0.061002184042569213,"h":0.011656952539550458},{"h":0.013322231473771762,"x":0.087145982489997775,"y":0.34138218142664734,"w":0.51416118621826179,"text":"makes sportspeople more motivated to succeed again in the future."},{"w":0.88235290527343757,"h":0.013081394961037107,"text":"Look at the two photos showing people who work in sports. What can you see in the photos? Which job would you","x":0.02614379409530777,"y":0.38953488389060542},{"y":0.40258118248088681,"x":0.037037036675605463,"text":"prefer to do? Why?","h":0.013322231473771873,"w":0.14814814567565918},{"w":0.52287578582763672,"text":"4 Read the instructions on your card and role-play the conversation.","x":0.013071904526268946,"y":0.66694421350925304,"h":0.013322231076738356},{"text":"Student B:","x":0.065292293131850657,"w":0.082923040390014649,"y":0.70178726782429091,"h":0.010669650285071275},{"h":0.013322231870805279,"w":0.5664487838745117,"x":0.065359495499199907,"text":"You and your friend (Student A) are discussing a suggestion that sports","y":0.72522897577154777},{"text":"should be removed from the curriculum.","w":0.32026142120361328,"x":0.065359490814315177,"h":0.011656952539550347,"y":0.73980016639862689},{"text":"• When asked, give your opinion: say that it's a good idea because it would","h":0.013081394961037107,"x":0.063180829031094274,"w":0.57952068328857431,"y":0.7572674420979697},{"y":0.77310574534148813,"w":0.43572982788085934,"h":0.011777975477842761,"text":"give students more time to spend on their exam subjects.","x":0.089324634498204811},{"h":0.013081394961037107,"y":0.78633720942355112,"w":0.5664487838745117,"text":"• Agree with Student A's opinion. But say that students can organise their","x":0.063180842485402025},{"text":"own sports in their free time.","w":0.21568626403808594,"y":0.80087209318260699,"h":0.011784026664460767,"x":0.089324624870935232},{"w":0.56427013397216796,"x":0.063180842796050948,"text":"• Disagree strongly with Student A's opinion by saying that students have","y":0.81540697686541164,"h":0.013081394961037107},{"text":"lots of free time.","x":0.087145971397166025,"w":0.12636165618896483,"y":0.82994186050780772,"h":0.010191361969654755},{"x":0.063180837420128991,"h":0.011808231013899162,"text":"• Agree and end the conversation.","y":0.84429641984419157,"w":0.27233114242553713},{"h":0.014534882760663392,"w":0.039215686321258492,"x":0.89760348532520939,"text":"135","y":0.96075581450629621}]
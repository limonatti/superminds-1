7777780514142271,"y":0.26308139569015221,"w":0.34444442749023441,"h":0.011627906487912565},{"text":"three-minute lecture is wildlife expert and animal","y":0.27469387771453779,"x":0.057777781758165114,"w":0.37111110687255855,"h":0.013096820286342181},{"text":"rights 2","h":0.013204794124681118,"x":0.060000001531860345,"w":0.055555553436279298,"y":0.28924418572005028},{"y":0.28924418610159097,"text":"(CAMPAIGN) Dr Roger","x":0.21111111870559798,"w":0.17777776718139646,"h":0.013204793346171528},{"w":0.26888887405395512,"x":0.060000011898948241,"y":0.30367346941172502,"h":0.011836734693877582,"text":"Matthews. Thank you, Dr Matthews."},{"text":"DM: Thank you. When you think of intelligent","x":0.026666670916666534,"y":0.31673469351513495,"h":0.013207167022082134,"w":0.34000000000000002},{"y":0.3313953491688344,"text":"animals, no doubt chimpanzees come to mind","h":0.011627906487912565,"x":0.05999999439183494,"w":0.34888889312744142},{"h":0.013081395674724883,"text":"Chimpanzees share ninety-eight percent of the","x":0.060000003163384434,"y":0.34447674418662011,"w":0.35333332061767575},{"text":"same genes as humans and they resemble humans","h":0.011627906487912565,"x":0.060000012321549431,"y":0.3590116280641833,"w":0.38444442749023439},{"y":0.37209302344209028,"w":0.36222221374511726,"h":0.011627906487912454,"text":"in many ways. [...] They experience adolescence","x":0.062222230082996897},{"h":0.013766642200703672,"y":0.3848317946084665,"w":0.1090776252746582,"x":0.05990563361934928,"text":"and develop 3."},{"text":"(POWER) mother and","w":0.1644444465637207,"x":0.26666666766258401,"h":0.010335785223513305,"y":0.38517441881266601},{"h":0.011836734693877693,"w":0.34888889312744142,"x":0.062222223591834797,"y":0.39959183669465914,"text":"child bonds. They are also similar to humans in"},{"y":0.41265306145908842,"w":0.38666664123535155,"h":0.013219031509087986,"x":0.060000015456398187,"text":"that they attack and kill rival gangs of chimpanzees"},{"text":"when they want to extend their territory.","y":0.42732558163976475,"x":0.060000008290025303,"w":0.30666666030883794,"h":0.011627906487912565},{"x":0.062222225876347396,"w":0.35333332061767575,"h":0.014693877551020473,"text":"The notion of chimpanzees being aggressive is","y":0.44326530633282279},{"x":0.060698750962946434,"h":0.015240042550223154,"text":"pretty 4","w":0.060934734344482412,"y":0.45712928822991394},{"x":0.21777777952369512,"w":0.22444444656372067,"h":0.011627906487912565,"text":"(SHOCK), but it's even harder","y":0.45784883738104365},{"text":"to imagine dolphins being anything other than","w":0.35333332061767575,"x":0.060000010774495321,"y":0.4722448980404006,"h":0.011836734693877582},{"w":0.10691745758056641,"y":0.48356204211048803,"h":0.013980565752301999,"x":0.062096828250931643,"text":"affectionate, 5."},{"h":0.011836734693877471,"y":0.48530612260809858,"w":0.16666666030883792,"text":"(PLAY) and intelligent.","x":0.26666667151224771},{"y":0.4983673466812274,"x":0.064444449467803228,"h":0.013260560327646664,"text":"Dolphins are undoubtedly 6","w":0.20666666030883787},{"h":0.011836734693877471,"y":0.51306122448099856,"x":0.062222229688973944,"w":0.37555553436279299,"text":"(EXTREME) intelligent. They have large brains and"},{"y":0.52612244872535885,"w":0.36444442749023442,"x":0.06222222751414222,"h":0.013121737266073352,"text":"a number of things in common with humans and"},{"y":0.540697674473684,"text":"chimpanzees. [...] Also like humans, they are totally","w":0.3866666412353516,"h":0.013179876366440135,"x":0.06222222997491695},{"y":0.55377906956089329,"h":0.013159705960020696,"w":0.25333332061767577,"text":"(DEPEND) on their parents during","x":0.17333334222449545},{"y":0.56816326533302486,"w":0.24666666030883785,"text":"CHILD). But they're also good at","h":0.011836734693877582,"x":0.17555556079002546},{"w":0.29999998092651375,"h":0.011627906487912565,"text":"defending themselves and can be quite","y":0.58284883750216776,"x":0.062222226758965569},{"y":0.59412369805799259,"h":0.017943762954400588,"w":0.15017827987670895,"x":0.061788429289431776,"text":"competitive, even?"},{"x":0.30444444492483186,"y":0.59593023244970145,"text":".(AGGRESSION),","w":0.13111110687255861,"h":0.013081395674724994},{"text":"particularly when they want to keep other males","w":0.36222221374511721,"y":0.60897959185407491,"x":0.064444453905218996,"h":0.013113431346659654},{"x":0.064444449082239147,"y":0.6235465118723228,"w":0.1511111068725586,"text":"away from a female.","h":0.011627906487912454},{"x":0.06444444285260964,"y":0.64081632646750009,"h":0.010346464040328018,"w":0.3711111068725586,"text":"But I'd like to move nearer to home and consider"},{"w":0.35111110687255859,"text":"farm animals. Which do you think are the least","x":0.062222219952609702,"h":0.011836734693877582,"y":0.65387755096622102},{"text":"intelligent: cows maybe, or sheep? It's true that","y":0.66715116253691076,"x":0.062222226722222128,"h":0.01325700098154492,"w":0.36000000000000004},{"text":"sheep have a reputation for being stupid because","y":0.68163265295227671,"h":0.013134788980289303,"x":0.064444459735270063,"w":0.37555553436279299},{"w":0.21999999999999997,"text":"(MIND) follow the crowd and","x":0.2133333332660407,"y":0.69469387762532719,"h":0.010247982959358137},{"y":0.70930232540028282,"h":0.013146654245804856,"text":"frankly, they don't look very bright. However,","x":0.064444448694444351,"w":0.34000000000000008},{"h":0.011627906487912565,"x":0.064444447644444403,"w":0.32000000000000001,"y":0.72238372111650873,"text":"scientific research shows that they've been"},{"w":0.20222221374511717,"y":0.73673469396782043,"text":"seriously undervalued. [...]","h":0.013265306122448917,"x":0.06444445205336724},{"y":0.78326530625025781,"w":0.1466666603088379,"text":"REMEMBER THIS","h":0.011836734693877582,"x":0.028888893115422292},{"x":0.028888893088888777,"y":0.80653061218675837,"h":0.011836734693877582,"w":0.42000000000000004,"text":"The word mind is widely used in collocations with verbs"},{"text":"and adjectives, as well as in a large number of useful phrases.","x":0.02888890267154931,"y":0.82122093044063671,"h":0.011627906487912565,"w":0.42444442749023442},{"y":0.84285714302276449,"text":"When you think of intelligent animals, no doubt","h":0.011836734693877471,"w":0.35999999999999999,"x":0.03111111711111093},{"text":"chimpanzees come to mind. (verb + mind)","y":0.8554316914379223,"x":0.030948035309249774,"w":0.32032024383544921,"h":0.014060157464475087},{"y":0.87061224491631894,"x":0.03111111373560661,"text":"Despite his physical disabilities, Stephen Hawking","w":0.37333332061767577,"h":0.013108685551857402},{"x":0.031111123736364127,"y":0.88517441865973057,"h":0.013192928080656086,"w":0.40444442749023446,"text":"had one of the most brilliant minds of his generation."},{"text":"(adjective + mind)","x":0.031111113865193635,"y":0.90116279086935203,"w":0.13555555343627929,"h":0.01026578046837634},{"x":0.031111132575674317,"y":0.91424418619402825,"text":"There is no doubt in my mind that you are the right","w":0.39777774810791017,"h":0.011627906487912565},{"x":0.031111118171885829,"h":0.011629093325867923,"text":"person for the job. (phrase with mind)","y":0.92877906992464832,"w":0.28222221374511719},{"x":0.49111110191776092,"w":0.42888889312744144,"y":0.069767441479497982,"h":0.013089701594138692,"text":"2 Read REMEMBER THIS. Complete the collocations"},{"h":0.011836734693877582,"text":"using the words in the box.","y":0.08571428573226314,"x":0.51555556257188573,"w":0.2222222137451173},{"x":0.53777777935028415,"y":0.11191860488333871,"h":0.0087209296713069984,"w":0.046666665077209402,"text":"back"},{"y":0.11185634683170687,"x":0.59108732717370494,"w":0.053380899429321227,"h":0.0088454460611148145,"text":"closed"},{"text":"lose on out of","w":0.14000000000000001,"x":0.53555555708333324,"y":0.12489795931901393,"h":0.010276458895936313},{"h":0.013208353470782752,"w":0.13555555343627923,"text":"enquiring fresh","y":0.11046511589810271,"
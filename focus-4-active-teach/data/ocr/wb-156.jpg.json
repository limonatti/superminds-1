[{"w":0.32000000000000001,"x":0.040000003199999946,"text":"VOCABULARY BANK","h":0.020548171997070375,"y":0.011428571576725499},{"w":0.24666666030883788,"text":"TRAVELLING AND TOURISM","x":0.035555554697433038,"y":0.066860465166896477,"h":0.011627906487912565},{"h":0.011836734693877582,"y":0.088571428553323672,"text":"1 Complete the text with the words in the box. There","x":0.035555562888888621,"w":0.44000000000000006},{"h":0.010335785223513305,"y":0.10448979589114626,"text":"are two extra words.","w":0.16888889312744138,"x":0.06222222221405703},{"text":"beauty camp campsite coast company","x":0.082222218563720903,"h":0.013088515145438073,"y":0.12936046473531193,"w":0.35111110687255853},{"x":0.082222230738552393,"y":0.14389534904528789,"w":0.34222221374511719,"h":0.011627906487912565,"text":"cruises destinations directions facilities"},{"x":0.07997847945557808,"w":0.068931927680969243,"y":0.15981086053910465,"text":"tourist","h":0.0088666511068538068},{"text":"path","y":0.15988372136844686,"w":0.039999997615814215,"x":0.14888888978468551,"h":0.011627906487912454},{"x":0.048888888952919859,"w":0.033333332538604737,"text":"•••","y":0.1860465119666721,"h":0.0087209296713069984},{"w":0.39111110687255862,"text":"Oh my goodness! What a pack of lies. I went on","h":0.013125297390684798,"y":0.20489795880423578,"x":0.057777780711868836},{"y":0.21755004187754257,"x":0.057619420696332212,"h":0.01558496124890385,"w":0.3759330749511719,"text":"one of these Caribbean cruises with my family"},{"x":0.055555554600757805,"h":0.013215472941495943,"w":0.33111110687255862,"text":"last year, and it was an absolute disaster.","y":0.23387755069528515},{"text":"They mentioned making new friends. Well,","y":0.24854651145042816,"x":0.057777793960101922,"w":0.34666664123535157,"h":0.013086141469527357},{"y":0.26308139544790421,"h":0.011627906487912565,"text":"unfortunately, everyone on the cruise was","w":0.33999999999999997,"x":0.057777774027777902},{"text":"incredibly rude, including the staff. I suppose if","x":0.055555557645960006,"y":0.27755102055376701,"w":0.38222221374511722,"h":0.013146654245804745},{"text":"you enjoy your own !","y":0.29061224511464412,"x":0.055555559591498459,"w":0.17111110687255859,"h":0.013166824652224185},{"text":"_, this might","h":0.013154959386708853,"x":0.33333333109981056,"w":0.10222222328186037,"y":0.29215116279732745},{"y":0.30523255784941083,"text":"be the holiday for you. The?","x":0.057777783790025412,"w":0.22666666030883792,"h":0.013134788980289303},{"w":0.37333332061767577,"x":0.053333335024495554,"y":0.31959183644527078,"h":0.014710489389847758,"text":"board were terrible, the pool was always dirty"},{"text":"and the rooms were small and cramped","x":0.055555562826768823,"y":0.33575581428868351,"h":0.010366634836002198,"w":0.32666664123535155},{"y":0.34883720949829178,"text":"The films they offered on board were ancient.","h":0.011627906487912565,"x":0.057777774475504522,"w":0.36666667938232417},{"h":0.011836734693877582,"text":"When we got to our 'family' room, there were","x":0.057777787246717623,"y":0.36326530621883835,"w":0.37333332061767577},{"text":"only three beds for four of us so my son had to","h":0.011627906487912565,"x":0.057777786794107937,"y":0.37790697695226472,"w":0.38222221374511717},{"y":0.39204199436538845,"w":0.096481733322143548,"h":0.012085474364611604,"text":"sleep on a 3","x":0.057415239857734723},{"h":0.010204081632652962,"y":0.39387755083642695,"w":0.16666666030883787,"x":0.26888889484558093,"text":"bed they brought in."},{"text":"It felt like being in a tent on a 4","w":0.25111110687255861,"x":0.055555561563720594,"h":0.013252254408232966,"y":0.4055232554329864},{"h":0.013139534775091555,"w":0.3977777862548828,"x":0.05555555517811403,"y":0.42000000010805572,"text":"We probably should have had a camping holiday;"},{"y":0.43591836723830946,"w":0.28444442749023441,"h":0.011836734693877582,"x":0.055555559291920034,"text":"it would have been much cheaper!"},{"text":"And then we got to one of the 'ports', one of","y":0.45346938766350298,"x":0.057777779429028724,"w":0.36222221374511721,"h":0.011836734693877471},{"x":0.055555559700568226,"w":0.15333333015441894,"h":0.013120550817372845,"text":"the 'picturesque' 5","y":0.46653061196669499},{"x":0.32000000128798417,"h":0.0089795918367348015,"text":"we had been","w":0.10888888359069826,"y":0.46938775504798103},{"x":0.055555548251094322,"w":0.32888889312744141,"h":0.02045799722476882,"text":"promised. Well, it was a tiny dock on the","y":0.48244897933352315},{"text":"of some island I'd never heard of","w":0.2666666603088379,"x":0.17999999910484044,"y":0.49551020424087922,"h":0.011836734693877582},{"w":0.097902364730834954,"y":0.50849396206801378,"h":0.012081842617112759,"x":0.05549326302186923,"text":"with a dirt 7"},{"h":0.011836734693877582,"y":0.51142857157710764,"w":0.16222221374511719,"text":"that led up to a few","x":0.26444444886818219},{"y":0.52431814871448412,"x":0.05541245625717018,"h":0.013807938244878026,"text":"little cafés and restaurants and nothing else.","w":0.36030838012695315},{"h":0.013141908451002493,"y":0.53918367332531347,"x":0.05777778908602791,"w":0.38666664123535155,"text":"So much for taking in the local culture! We tried"},{"y":0.55224489788619058,"w":0.095555553436279292,"x":0.055555557587415885,"h":0.013162078857421933,"text":"to look up 8"},{"y":0.55510204090098592,"text":"to a nearby village,","w":0.15555555343627925,"h":0.011836734693877582,"x":0.26222222068926793},{"y":0.56816326521636296,"h":0.013232084001813638,"w":0.37555553436279299,"text":"but there was no wi-fi on board, which did not","x":0.057777790707492331},{"y":0.58284883745371807,"w":0.29555555343627932,"text":"make my 10-year-old son very happy.","h":0.011627906487912565,"x":0.057777783763341688},{"w":0.35555553436279297,"h":0.011627906487912565,"text":"My advice? Just stay at home and clean the","y":0.60029069786069478,"x":0.057777791929714578},{"y":0.61469387766576966,"h":0.013213099265585115,"w":0.35111110687255859,"x":0.055555551822980151,"text":"house, it would be more relaxing than this!"},{"x":0.033333352160101769,"text":"2 Complete the text with the missing words.","y":0.67142857168815961,"w":0.36666664123535159,"h":0.013164451754822948},{"text":"ADVENTURE","x":0.08000000167796717,"y":0.71366279046218362,"h":0.015988372491330449,"w":0.13777777671813965},{"x":0.21111111388118101,"y":0.70639534927678993,"h":0.024709301384127857,"w":0.091111106872558606,"text":"OF"},{"text":"A LIFETIME!","h":0.013145467797104238,"x":0.29777777881768897,"y":0.71795918360130484,"w":0.15111110687255863},{"h":0.011632653061224407,"y":0.7500000001717414,"w":0.38,"text":"Are you tired of the hustle and bustle of everyday life?","x":0.053333338083333251},{"text":"Are you ready for the voyage of a lifetime? Why not","w":0.36444442749023437,"x":0.05333333725488295,"y":0.76448979583702292,"h":0.011836734693877471},{"y":0.7790697672062421,"text":"k on a cruise around the Caribbean, 2f_ __ d for","x":0.1200000142178456,"h":0.013175130571637883,"w":0.34444442749023435},{"y":0.7921511625841493,"text":"its clear seas and beautiful beaches? Along the way, you","x":0.053333339363720603,"h":0.013154960165218332,"w":0.39111110687255857},{"text":"can stop at various ports and have a 3g_","y":0.80653061220256828,"h":0.013236829796616001,"w":0.28444442749023441,"x":0.053333346551178946},{"x":0.37555555731576201,"y":0.80813953521891602,"h":0.010227811774428996,"w":0.088888883590698242,"text":"d tour of the"},{"h":0.014697436118612517,"x":0.053333338652230576,"text":"city or just go and visitthe4h____","y":0.8212209308784687,"w":0.25555555343627934},{"h":0.010174418079609837,"y":0.82267441879449743,"w":0.12666666030883789,"x":0.33555556084558097,"text":"c sites yourselves"},{"w":0.1466666603088379,"h":0.01322377808239994,"y":0.83575581381476938,"x":0.053333338956692095,"text":"to take in their 5e__"},{"text":"-_1 heritage. If that's not your","x":0.23333333574263521,"w":0.21777776718139646,"y":0.83575581357252116,"h":0.01322377808239994},{"w":0.23555555343627932,"h":0.013168011879434394,"text":"thing, you can visit the local t__","x":0.05333333831889725,"y":0.8502040813794397},{"x":0.33111110905351437,"text":"tspots or just sit","y":0.85174418636353821,"h":0.010296630080865343,"w":0.12222222328186039},{"w":0.3671162414550781,"x":0.053071616925652022,"y":0.8590129210338936,"h":0.019629842018594523,"text":"on a's____d by the pool, making new friends and"},{"h":0.013113432125169466,"w":0.16888887405395508,"text":"looking out at the 8p__","x":0.053333342232281672,"y":0.8779069763632189},{"h":0.011836734693877582,"y":0.87918367341137571,"text":"e scenery and","w":0.10444443702697753,"x":0.31333333848651124},{"text":"watching the world go by. Whatever holiday you're","y":0.89387755112521239,"x":0.053333338963720604,"w":0.35111110687255859,"h":0.011836734693877582},{"h":0.013119364368672226,"text":"looking for, you'll find it with Caribbean Cruises.","x":0.051111123353452435,"w":0.33777774810791011,"y":0.90693877554717861},{"x":0.033333333166666666,"w":0.040000000000000001,"text":"154","y":0.96220930232615498,"h":0.013081395674724994},{"h":0.019872710558832885,"w":0.15804621696472165,"text":"EXERCISES","y":0.01404620279443447,"x":0.83764355931229251},{"x":0.52444446888013574,"text":"3 Complete the dialogue with the correct prepositions.","y":0.069767441721745982,"h":0.013089700815628991,"w":0.44888885498046871},{"text":"- Hi, I think I'm going to be late. I'm stuck in traffic.","w":0.38666664123535155,"h":0.013228523877202303,"x":0.53333335249343505,"y":0.097383720791513473},{"w":0.28000000000000003,"y":0.12204081630868069,"h":0.013133602531588795,"text":"- Oh no! What's up? I've only just set","x":0.67111110644444461},{"x":0.74197213474020063,"h":0.016287138024154935,"text":"so I won't be on time, either.","w":0.21616847991943355,"y":0.13444263131835033},{"y":0.16122448976825121,"x":0.53333334226115336,"w":0.21777776718139652,"text":"- There's been an accident2","h":0.011836734693877582},{"x":0.80888888972316952,"h":0.010336971672213702,"y":0.16408163274065313,"text":"the motorway","w":0.10888888359069815},{"text":"- What happened? John and I are just 3","h":0.013234456899214764,"y":0.18734693839454308,"w":0.30222221374511726,"x":0.60000000897929306},{"y":0.20348837230110184,"w":0.35555553436279297,"x":0.6022222372630478,"h":0.011627906487912565,"text":"the roundabout in the city centre. He's meeting"},{"y":0.21656976726438171,"h":0.013226150979801066,"w":0.34888889312744142,"x":0.60222222359183486,"text":"a friend, so agreed to drop me off on the way."},{"x":0.60222222564705408,"y":0.22965116288976462,"text":"Should we turn 4","w":0.13111110687255856,"h":0.011627906487912565},{"text":"now?","w":0.044444441795349121,"y":0.23110465125573776,"x":0.78888889065788104,"h":0.010174418079609726},{"x":0.53333333568926777,"y":0.25428571422770241,"w":0.095555553436279306,"text":"- We were 5","h":0.011836734693877582},{"x":0.68888889486001692,"y":0.25581395330120338,"h":0.013165638203523677,"w":0.23111110687255854,"text":"the traffic lights waiting to get"},{"w":0.31555555343627928,"text":"onto the motorway and a moped pulled","x":0.53555556009667515,"h":0.013226150979801066,"y":0.27020408195930568},{"text":"in front of us and went through the lights. I think","y":0.2848837206825019,"x":0.53333333003106009,"h":0.013081395674724883,"w":0.36666667938232422},{"text":"you should keep on going, they might have sorted","y":0.29941860439737589,"h":0.013234456899214764,"x":0.53333334661599396,"w":0.38444442749023433},{"w":0.24444442749023443,"text":"it out by the time you get there.","x":0.53333334255117915,"y":0.31387755103927772,"h":0.013157333062619569},{"y":0.34000000001835984,"h":0.011836734693877471,"text":"- That's crazy. Mopeds aren't supposed","x":0.66666666403186037,"w":0.29555555343627937},{"h":0.011627906487912565,"x":0.66444444813560666,"w":0.21333332061767574,"y":0.35465116307145061,"text":"to go there. Did they crash?"},{"w":0.32222221374511728,"y":0.37918367365362393,"text":"- Yeah, but it wasn't bad. Everyone is fine,","h":0.011836734693877582,"x":0.53111112072003375},{"y":0.39387755113490241,"w":0.33111110687255862,"text":"but it stopped traffic until the police arrived.","h":0.011836734693877582,"x":0.53555556319335007},{"x":0.53555555855555559,"y":0.40843023276621815,"h":0.011627906487912565,"w":0.23999999999999999,"text":"At least you're running late too."},{"text":"- Yes, I'll ring the restaurant and tell","x":0.68666667111191149,"y":0.43306122430823724,"h":0.011836734693877693,"w":0.26888887405395501},{"y":0.44767441869759828,"text":"them we will be another half an hour.","h":0.010284764815349901,"w":0.27777776718139646,"x":0.68666667429819062},{"text":"- Thanks. Can you ask if they have","y":0.47383720948860186,"x":0.53555556343152388,"w":0.25777776718139644,"h":0.011627906487912565},{"y":0.4883720933161213,"x":0.59999999713371244,"text":"-street parking available there?","w":0.23555555343627921,"h":0.011627906877167304},{"x":0.62000000851633019,"y":0.51453488392900881,"h":0.011627906487912565,"w":0.34222221374511719,"text":"- I know they don't but there is some parking"},{"text":"down the road. It's 8","x":0.62222222370220237,"y":0.52761627893555219,"w":0.15333333015441897,"h":0.010342904694226274},{"x":0.8355555566233589,"y":0.52897959179465992,"text":"walking distance","w":0.12666666030883789,"h":0.011836734693877471},{"x":0.62222223124263509,"h":0.011836734693877582,"text":"of the restaurant so I usually park there.","y":0.54204081629937328,"w":0.29777776718139648},{"x":0.53333333575782893,"w":0.39333332061767567,"y":0.5770348836306608,"h":0.013169198328135012,"text":"- Perfect. OK, I'll see you when you get there. Don't"},{"h":0.01611561055086097,"text":"forget, this is a fancy restaurant. I hope you've dressed up","y":0.59006854209629767,"x":0.53313973624748801,"w":0.43591777801513665},{"x":0.6511111213948656,"y":0.61918367323325951,"h":0.01308376857212612,"w":0.25333332061767588,"text":"- Don't worry. I've got my heels?"},{"y":0.63510204077093679,"x":0.65111111812744127,"w":0.22222221374511719,"h":0.011836734693877582,"text":"the boot. LOL! See you soon."},{"text":"CULTURE","w":0.082382431030273429,"x":0.52214211879241068,"y":0.66548021487161446,"h":0.013516314759546399},{"h":0.011836734693877582,"w":0.45333332061767584,"text":"1 Match the words in the two columns to make common","y":0.68734693860160145,"x":0.52444445533560635},{"w":0.23777776718139643,"x":0.54888889715930167,"y":0.70203488396534597,"h":0.011627906487912565,"text":"collocations related to media."},{"text":"post","x":0.55333333373333327,"w":0.040000000000000036,"y":0.72529069783162514,"h":0.011627906487912565},{"x":0.5533333321812921,"y":0.73837209335488097,"w":0.062222223281860334,"h":0.011627906487912454,"text":"mislead"},{"y":0.75137640302635622,"w":0.048974637985229497,"text":"out of","x":0.55551268019329481,"h":0.01178207786715757},{"x":0.55555555602260109,"h":0.010174418079609837,"text":"crop","w":0.035555553436279363,"y":0.76889534912395474},{"y":0.7819767446242607,"text":"morning","w":0.064444441795349139,"h":0.011627906487912565,"x":0.55555555788010325},{"w":0.10666666030883798,"y":0.79505813987007878,"h":0.010174418079609726,"text":"double-check","x":0.55555555695669223},{"text":"print-based","x":0.55478598817452185,"w":0.090435686111450142,"h":0.015281675689074459,"y":0.80780874115532963},{"text":"news","y":0.82558139548411391,"w":0.04222221851348873,"x":0.55555555678029267,"h":0.0087209296713069984},{"text":"take a story","y":0.83860721941683847,"x":0.55331673046438323,"w":0.09114431381225585,"h":0.011739049249765876},{"text":"a video","x":0.70441357357437762,"y":0.72520290707910495,"w":0.057839517593383794,"h":0.0088965116228376662},{"h":0.0087209296713069984,"y":0.73982558174864888,"w":0.05555555343627927,"x":0.70444444480963808,"text":"anchor"},{"x":0.70444444455759681,"text":"facts","y":0.75290697687952657,"h":0.010174418079609726,"w":0.037777776718139644},{"w":0.
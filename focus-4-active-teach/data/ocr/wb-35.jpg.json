89579010009768,"text":"(PREDICTION) lots of people arrived around 11 a.m.","h":0.014729950900163713,"x":0.05986696744071221},{"w":0.090909090042114254,"h":0.011646937621595854,"text":"for a coffee.","y":0.70930232573566454,"x":0.059866963875838619},{"h":0.011627906668205679,"w":0.022172949314117452,"y":0.72819767442752503,"text":"\/5","x":0.43680709518773064},{"text":"Top 5 things that make humans special","x":0.50776053914811425,"y":0.40988372116259786,"w":0.41906871795654299,"h":0.024709301962595021},{"x":0.51884700706118247,"y":0.44476744178171523,"h":0.0087209301962595243,"text":"#1","w":0.017738358974456858},{"w":0.3835919952392578,"h":0.013269326495656042,"x":0.5565410342724626,"y":0.44312602253235256,"text":"Our brains. Humans are highly intelligent. Although"},{"w":0.43015522003173823,"y":0.45784883730543213,"x":0.50997782665818847,"text":"our brain is only about 2.5 percent of our body weight, we","h":0.011627906668205679},{"h":0.010174418042022237,"y":0.47238372113887261,"x":0.50997784969361959,"w":0.43237247467041018,"text":"are able to think and work out ideas far better than any other"},{"h":0.011865793780687417,"x":0.50997782665818847,"w":0.43015522003173823,"text":"mammal and have developed sophisticated information","y":0.48527004900539805},{"w":0.32594234466552729,"h":0.013264568269545474,"text":"exchange systems of languages. We had '","y":0.49836333846195147,"x":0.50997783502126426},{"y":0.513081395444967,"text":"communicating with music and art for hundreds of years","w":0.43015522003173823,"x":0.50997782665818847,"h":0.011627906668205679},{"h":0.011865793780687306,"text":"before language developed, but the way we communicate","w":0.43015518188476554,"x":0.50997783795636087,"y":0.52741407509907845},{"x":0.50776053500336416,"h":0.010229132569558153,"text":"with words is an incredible achievement that has put","y":0.54214402603221368,"w":0.4345898056030274},{"w":0.20399112701416022,"y":0.55523255840268082,"x":0.50997783150400633,"text":"humans on a different level.","h":0.010233890015247771},{"x":0.51870128358692369,"y":0.57391479858935046,"w":0.42155754089355468,"h":0.014665328929545307,"text":"#2 Self awareness. Unlike most animals, we are aware"},{"w":0.43015518188476565,"x":0.5099778453103887,"text":"of ourselves and our thoughts. The advantage of this is","y":0.58866279070659489,"h":0.011627906668205679},{"h":0.011865793780687417,"w":0.43237251281738276,"text":"improved social interaction, but the downside, of course, is","y":0.60310965643734271,"x":0.50776052310904707},{"y":0.61620294599187153,"x":0.50997782645445289,"h":0.011865793780687417,"w":0.19512195587158199,"text":"that people can become 2"},{"h":0.010336181340943384,"y":0.61773255849352393,"text":"and worryor get","w":0.12860309600830078,"x":0.81374723034026941},{"y":0.63081395375151794,"w":0.33702880859375006,"h":0.010348075735588491,"text":"embarrassed about what others think of them.","x":0.50997783938383445},{"y":0.64970930256705983,"h":0.011627906668205679,"text":"#3","x":0.51662971225212173,"w":0.026607537269592307},{"text":"Rules and laws. Although some animals follow basic","h":0.013138488154559536,"w":0.38580928802490244,"y":0.64970930213478217,"x":0.55654103625362406},{"y":0.66569767462724472,"w":0.43458976745605471,"h":0.010243405687048068,"text":"rules in order to live in groups, we have been able to develop","x":0.50776055588764135},{"x":0.50997782901544664,"h":0.011865793780687417,"w":0.11086474418640135,"y":0.67716857628300897,"text":"complex laws3"},{"text":"everyone has to follow. These","y":0.67877907006705995,"w":0.21286029815673824,"h":0.011627906668205679,"x":0.72727273168659767},{"h":0.011865793780687417,"text":"laws govern everything from defining criminal behaviour to","x":0.50776055588764135,"w":0.43458976745605471,"y":0.69312602273468571},{"x":0.50997783109147987,"w":0.39467849731445315,"text":"how we can trade, from education to the environment.","y":0.70621931257506732,"h":0.011865793780687417},{"x":0.51662971209514452,"h":0.010174418042022126,"y":0.72674418640050054,"w":0.028824832439422576,"text":"#4"},{"w":0.3835919952392578,"y":0.72667757758160101,"x":0.55875832994134667,"text":"Education and learning. Humans have the longest","h":0.011865793780687417},{"w":0.43237251281738287,"x":0.50997781909020001,"h":0.011865793780687417,"text":"childhood of any species, which gives our brains lots of","y":0.73977086749950194},{"h":0.011627906668205679,"text":"time to develop. It takes us far longer to learn things, such","x":0.50997782881858111,"y":0.75436046519787392,"w":0.43237251281738287},{"x":0.50997782881858111,"text":"as how to walk or feed ourselves, than other mammals.","y":0.7688216040096395,"w":0.43237251281738287,"h":0.010248163132737798},{"text":"However, we learn far more complex things than how to","h":0.011865793780687306,"y":0.78191489357157096,"x":0.50997782881858111,"w":0.43237251281738287},{"x":0.5099778416374483,"h":0.011865793780687417,"text":"simply survive and have formal education systems which","y":0.79500818319392919,"w":0.43237247467041007},{"y":0.80959302365825259,"h":0.010374243247723625,"w":0.14412416458129873,"x":0.50997782661548519,"text":"aim to cultivate a 4"},{"x":0.76274944523651722,"text":"of learning that can last","y":0.80959302355543206,"w":0.17960088729858403,"h":0.011627906668205679},{"text":"throughout our lives.","x":0.50997783039075417,"y":0.82405891998507463,"h":0.010243405296837649,"w":0.15299334526062014},{"x":0.51884700764014835,"y":0.84302325608450179,"h":0.011627906668205679,"w":0.026607537269592307,"text":"#5"},{"text":"Love. Last but not least, we are very romantic","h":0.011627906668205679,"x":0.56319291664605986,"y":0.84447674448566468,"w":0.37915740966796874},{"h":0.011627906668205679,"y":0.85755813949535453,"w":0.43237247467041018,"text":"and perhaps the only animal that falls madly in love","x":0.50997784466775131},{"text":"_ another member of the species!","w":0.24168514251708983,"x":0.62084257283880151,"y":0.87193126023000211,"h":0.010336181731153804},{"y":0.93604651149161355,"text":"Total","x":0.82039911500313489,"h":0.013081395294389231,"w":0.053215074539184615},{"y":0.91133720924780048,"text":"5","x":0.9356984483360461,"h":0.0087209301962595243,"w":0.015521063804626478},{"text":"120","y":0.93585762763221014,"h":0.013459163484713876,"w":0.033603792190551762,"x":0.90891872478617675},{"x":0.92017738454860576,"y":0.96366279078965145,"h":0.011627906668205679,"w":0.026607537269592307,"text":"33"}]
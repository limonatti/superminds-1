[{"w":0.29268291473388669,"x":0.19068736584074331,"text":"USE OF ENGLISH","h":0.020348836554855643,"y":0.02325581434531121},{"w":0.068785233497619641,"text":"Register","x":0.19066281551200956,"y":0.065351334083854296,"h":0.013192680233814702},{"h":0.0087209302870953076,"y":0.042151162676219767,"text":"3","x":0.53658536566481874,"w":0.011086474657058809},{"h":0.014534883030125401,"y":0.039244186149665961,"text":"* * * Read the note and the library rules. Then use","w":0.42128601074218752,"x":0.5609756131063639},{"text":"the information in the text to complete the student","x":0.56097561974711951,"h":0.011885245901639419,"y":0.056557376976505869,"w":0.41019954681396487},{"x":0.55864839126554089,"y":0.069293577981582755,"w":0.4259419631958008,"h":0.013892206598500767,"text":"leaflet. Use no more than two words in each gap. The"},{"x":0.56097562787019484,"w":0.34589797973632808,"y":0.085655737523127273,"text":"words you need do not appear in the note.","h":0.011885245901639307},{"text":"Alex,","y":0.11627907008377458,"w":0.050997781753540083,"x":0.55210643114096836,"h":0.01453488303012529},{"x":0.55654102018163287,"w":0.39024391174316408,"text":"Thank you for agreeing to write the new library","y":0.13226744176959071,"h":0.017441860574190726},{"w":0.40133037567138674,"text":"leaflet for first-year students. Here are the rules","h":0.017441860574190726,"y":0.14825581394740073,"x":0.55210642744516403},{"x":0.5565410274398771,"w":0.38580928802490233,"h":0.014754098360655776,"y":0.16557377065537304,"text":"we need to explain. Can you make them more"},{"y":0.18168604674790356,"x":0.55210642864056103,"h":0.015988371802157952,"w":0.1507760524749755,"text":"student-friendly?"},{"x":0.046439605368082476,"h":0.014778732862628874,"w":0.42596931457519538,"text":"1 * Mark the sentences as formal (F) or informal (I).","y":0.13353004823216019},{"text":"a Hi John,","y":0.15362032577803508,"x":0.097435265302992166,"w":0.093377809524536129,"h":0.012526790431288459},{"y":0.16698399742745018,"h":0.013416945348020404,"text":"b Dear Mr Johnson,","w":0.16491090774536132,"x":0.097177537189290744},{"text":"1 a Has the principal been informed about the","x":0.070953438602444907,"y":0.18155737687343532,"w":0.37694011688232421,"h":0.013210064856732484},{"text":"incident?","y":0.19762274381950595,"x":0.12193697166051586,"w":0.073199229240417482,"h":0.0088242796600842555},{"text":"b Has anyone called the principal and told her","h":0.013181471824645907,"x":0.09534367740321549,"w":0.3658536529541016,"y":0.2106557373473823},{"y":0.22663934426235788,"text":"what happened?","x":0.12195122153864685,"w":0.13082039833068848,"h":0.011885245901639307},{"w":0.037694013118743902,"x":0.070953437370783232,"y":0.23975409853338836,"h":0.010245901639344357,"text":"2 a"},{"text":"If you want to know more, drop me a line.","x":0.110864744452915,"y":0.23975409860302943,"h":0.013152878010859292,"w":0.33037693023681641},{"y":0.25436046548882452,"text":"Should you require more information, do not","h":0.013262485676124425,"x":0.11086474650701604,"w":0.35476718902587889},{"h":0.011782920555990284,"text":"hesitate to contact me.","x":0.1217447170557142,"y":0.2687984659730458,"w":0.17558010101318361},{"text":"3 a Applicants for the scholarship should have","h":0.013081395039792887,"x":0.070953450072872071,"y":0.28343023263998723,"w":0.37472282409667967},{"y":0.2994186047905496,"w":0.17960088729858398,"h":0.010174418277427821,"text":"a strong interest in jazz.","x":0.12195122231523121},{"h":0.015717208580892539,"y":0.30994848502930461,"w":0.38173084259033202,"x":0.09518750509264258,"text":"b You need to be into jazz to get the scholarship."},{"text":"4","w":0.013303768634796126,"x":0.070953437042542811,"h":0.010174418277427821,"y":0.32558139534287522},{"h":0.011627906267760224,"w":0.28381374359130856,"x":0.084257203296733182,"y":0.32703488412387183,"text":"a When was the university set up?"},{"y":0.34011627920006471,"w":0.36363636016845702,"h":0.013162409282121645,"x":0.095343688504093541,"text":"b Do you happen to know when the university"},{"text":"was established?","y":0.35450819684260304,"x":0.11973392798211428,"w":0.13303769111633301,"h":0.01031738421956041},{"x":0.070953437370783232,"w":0.037694013118743902,"h":0.010322150246041772,"text":"5 a","y":0.36918604662073373},{"x":0.11086474853424974,"h":0.013191002314207889,"text":"There's no way I'll finish the essay tonight -","w":0.33924610137939448,"y":0.36918604669037491},{"x":0.12195122373690374,"w":0.18403547286987304,"h":0.011627907049460484,"text":"there isn't enough time.","y":0.38517441853195589},{"text":"b lam afraid there is too little time for me to","w":0.34811527252197266,"x":0.097560985579368598,"y":0.39672131127556565,"h":0.013162409282121423},{"w":0.25720621109008784,"y":0.4142441859738164,"h":0.011627907049460484,"x":0.121951221395089,"text":"complete the assignment tonight."},{"h":0.01017441827742771,"y":0.42732558148628619,"w":0.037694013118743902,"text":"6 a","x":0.070953437527841612},{"y":0.42732558152564626,"x":0.10864745296743429,"h":0.013248189160081081,"text":"This study has been conducted annually","w":0.31707315444946288},{"h":0.013691730186587425,"y":0.44010180933935417,"x":0.11964860897948444,"w":0.10660079002380372,"text":"for five years."},{"y":0.45639534915524893,"w":0.37694011688232426,"x":0.095343692833782356,"h":0.013276782192167658,"text":"b Someone has carried out this study every year"},{"y":0.46947674432239994,"text":"for five years now.","w":0.13968957901000978,"h":0.013081395039792998,"x":0.11973392621007267},{"y":0.48401162794340813,"h":0.010250667274975478,"w":0.037694013118743902,"text":"7 a","x":0.068736141583643579},{"y":0.48401162808572362,"w":0.33924610137939448,"text":"Sometimes people think that teenagers are","h":0.013119519733991725,"x":0.11086474853424974},{"w":0.2929742622375488,"h":0.013463368963022582,"text":"childish and don't take them seriously.","y":0.49828692446446565,"x":0.11962436076440362},{"y":0.51308139552758414,"h":0.013148112766078301,"w":0.34811527252197272,"x":0.10864745771536274,"text":"Sometimes teenagers are thought to be too"},{"x":0.11973392735157219,"text":"immature to be taken seriously.","y":0.52906976736916511,"w":0.2394678497314453,"h":0.011627907049460484},{"text":"8 a","x":0.068736141583643579,"y":0.54215116282712916,"h":0.010307853729998429,"w":0.037694013118743902},{"x":0.11308203252365462,"y":0.54215116296944466,"h":0.013176705798164767,"w":0.35698448181152342,"text":"Students caught using a mobile phone during"},{"text":"the exam will be removed from the room.","h":0.011885245901639419,"x":0.11973392826477181,"y":0.55655737704918029,"w":0.31929046630859376},{"h":0.01017441827742771,"y":0.57122093056574352,"w":0.011086474657058726,"text":"b","x":0.095343680742424081},{"text":"If a teacher catches you using a mobile during","w":0.35254989624023431,"x":0.11973392693531498,"y":0.57122093036285548,"h":0.013205298830251233},{"y":0.58565573808668914,"text":"the exam, he\/she'll ask you to leave the room.","x":0.11973392438135243,"h":0.013181471042945758,"w":0.35033260345458983},{"y":0.60450819656863242,"text":"2 * * Complete the second sentence with the word","x":0.044345898691086807,"h":0.013224361372775717,"w":0.43237251281738281},{"text":"in the box so that it has a similar meaning to the first.","y":0.61849043471014009,"h":0.016130783518806813,"w":0.4150659942626953,"x":0.068518020481005873},{"x":0.068736147444886986,"y":0.63517441856829293,"h":0.011627907049460484,"w":0.2062084197998047,"text":"There are two extra words."},{"h":0.011627907049460484,"x":0.088691786860649421,"text":"accessible additional dressed evaluated","y":0.66133720935317675,"w":0.3481153106689453},{"h":0.013133816250035069,"y":0.67581967205837878,"w":0.30155210494995116,"x":0.088691792979569972,"text":"graduated judging return unlikely"},{"w":0.40798225402832028,"h":0.013214830101513475,"y":0.69754098367322803,"x":0.093126396415255719,"text":"You won't get any marks if you hand in your project late."},{"text":"Projects submitted after the deadline won't be evaluated.","x":0.095343689999504516,"w":0.4057649612426758,"y":0.71065573788683445,"h":0.013181471042945758},{"w":0.40133037567138674,"h":0.011885245901639419,"text":"1 Atter your lunch break, go back to the classroom.","x":0.068736147557876354,"y":0.72663934437136957},{"x":0.095343682035277239,"text":"Please","y":0.73982558153473577,"h":0.010174418277427821,"w":0.050997781753540028},{"w":0.23946784973144528,"x":0.2461197366642108,"y":0.74127906965840928,"h":0.011627907049460484,"text":"_directly to the classroom after"},{"h":0.010250667274975367,"w":0.13082039833068848,"text":"your lunch break.","x":0.093126385114034954,"y":0.75573770475618041},{"h":0.013124284978772827,"y":0.76885245909635624,"text":"2 Before going to school, make sure you are wearing","w":0.41241683959960934,"x":0.068736143703521324},{"text":"the right clothes.","y":0.78343023248544419,"x":0.093126387835764352,"w":0.13082039833068848,"h":0.011651734836765959},{"h":0.011642203565503717,"text":"Before leaving, check you are suitably","x":0.095343685968951319,"w":0.28603103637695315,"y":0.79795081967821879},{"x":0.068736153031319802,"w":0.41463413238525393,"text":"3 I don't think that the government will postpone the","y":0.81249999990550237,"h":0.011680327868852425},{"h":0.013252954404862294,"w":0.22616407394409183,"text":"educational reform by a year.","y":0.82540983611406527,"x":0.093126392517976123},{"x":0.093126386823607077,"text":"It is","y":0.84139344275629202,"h":0.0090163934426229497,"w":0.031042127609252929},{"text":"that the government will postpone","w":0.27050996780395509,"h":0.011885245901639419,"x":0.22838138311576073,"y":0.84139344272297767},{"w":0.25343011856079101,"y":0.85219397762882521,"h":0.016616765006643885,"text":"the educational reform by a year.","x":0.092795679212195947},{"x":0.068736139431070209,"h":0.013191002314208,"text":"4 If you need more information, please talk to the","w":0.3880266189575195,"y":0.86918604660558807},{"y":0.88517441874403813,"x":0.093126388380849329,"w":0.13082039833068848,"text":"school secretary.","h":0.01031738461041054},{"x":0.19946310858072949,"h":0.013293960446217001,"y":0.89663976975906923,"text":"information can be obtained from the","w":0.29512678146362303},{"text":"school secretary.","h":0.011885245901639307,"y":0.91270491811461363,"w":0.13082039833068848,"x":0.093126387835764352},{"y":0.92732558128087084,"w":0.011086474657058712,"x":0.068736141718033841,"h":0.0087209302870954186,"text":"5"},{"x":0.084257214625881788,"h":0.013248189160081192,"text":"My sister was awarded a degree in Physics last year.","w":0.40354766845703127,"y":0.92732558152564615},{"y":0.94173669782758229,"text":"My sister","w":0.071035079956054681,"h":0.010421953044953858,"x":0.095302860318185523},{"w":0.15742793083190915,"y":0.94180327856675838,"h":0.011885245901639307,"text":"_inPhysics last year.","x":0.26164080334236028},{"text":"12","x":0.048780488294250433,"w":0.026607537269592287,"h":0.013081395039792887,"y":0.95784883720030722},{"text":"University Library","y":0.22663934413516718,"w":0.1840354728698731,"x":0.66962305960164881,"h":0.017622950819672134},{"text":"Rules and regulations","y":0.24418604641713015,"x":0.67849224629244309,"w":0.17073169708251945,"h":0.011627907049460484},{"text":"Access to the library","x":0.55432372359621507,"y":0.2630813955125535,"w":0.15077605247497561,"h":0.014534883030125512},{"h":0.013081395039792998,"y":0.28343023254914423,"w":0.37694011688232421,"x":0.55432372880939229,"text":"• A valid library card is required to access the library."},{"x":0.55432371664744506,"text":"• Library cards are personal and non-transferable.","y":0.30081967199176063,"h":0.013133816250035069,"w":0.35476718902587889},{"w":0.40133037567138674,"x":0.55210642677628019,"y":0.31831395389191397,"text":"• In the case of loss or theft of a library card, the library","h":0.014534883030125401},{"text":"should be notified immediately and a new card","y":0.33278688510034327,"h":0.013143347521297422,"x":0.56762750216208802,"w":0.33259422302246089},{"w":0.10421285629272459,"x":0.56762749820249214,"text":"will be issued.","h":0.011656499690696931,"y":0.34590163953814446},{"w":0.31707317352294917,"text":"• Library cards need to be renewed annually.","x":0.55432372683054298,"y":0.36337209313417329,"h":0.013267250920905527},{"h":0.013491955741507189,"text":"Borrowing books","x":0.55649146946765127,"y":0.38351565025571044,"w":0.12426761627197269},{"w":0.36807094573974608,"y":0.40406976754187673,"text":"• Students are allowed to borrow up to 10 books at","x":0.55432373350484965,"h":0.013143347521297311},{"x":0.56541020088228389,"text":"a time.","y":0.41844262286596989,"h":0.010336446762085005,"w":0.050997781753540083},{"text":"• The maximum loan period for books is three weeks.","x":0.55432372838848432,"y":0.4344262298537247,"h":0.013248188378381043,"w":0.37915740966796885},{"text":"• Books returned after the due date will be charged at 25","w":0.40176490783691399,"y":0.44941091764605368,"h":0.017811503175829357,"x":0.55412976348694587},{"text":"pence per day.","w":0.10199556350708006,"y":0.46639344260185367,"h":0.011885245901639307,"x":0.56762749622133057},{"y":0.48651652196686701,"h":0.013885560582895806,"w":0.10886605262756344,"text":"Opening times","x":0.55421442470137638},{"x":0.55432372815599806,"y":0.50726744185146988,"w":0.19068735122680658,"h":0.013224361372775717,"text":"• Standard opening times:"},{"x":0.58312922250806831,"h":0.014680118248110885,"text":"Monday to Friday","y":0.52463668520593809,"w":0.12642448425292974},{"h":0.011627906267760224,"x":0.75166297734088205,"text":"8:00 a.m. to 8:00 p.m.","y":0.52616279100371688,"w":0.1574279308319092},{"w":0.32372505187988287,"text":"Saturday and Sunday 9:00 a.m. to 2:00 p.m.","y":0.54215116289071397,"h":0.013176705798164767,"x":0.58536585948134456},{"y":0.55942622921737339,"text":"• The library reserves the right to change opening times","h":0.013248189160081192,"w":0.39689579010009768,"x":0.55432372754418624},{"text":"on bank holidays.","h":0.013782490276899484,"w":0.1265502548217774,"y":0.57232387091911729,"x":0.56532797742736618},{"y":0.59011627935510358,"w":0.36585365295410166,"h":0.013162409282121423,"x":0.55432372959833709,"text":"• The latest news and current opening times for the"},{"h":0.011885245901639419,"text":"library can be consulted on our website.","x":0.56541019885697807,"y":0.60450819684854407,"w":0.28603103637695315},{"x":0.55210642993008097,"y":0.64680232578143848,"text":"Library","w":0.11086474418640135,"h":0.020348836554855532},{"w":0.36363636016845702,"h":0.011885245901639419,"x":0.55210643552552752,"text":"Important information for new students","y":0.66844262297448587},{"h":0.01313858149481606,"w":0.21951219558715818,"text":"You need a valid library card to!","y":0.69180327903380134,"x":0.54988913661144678},{"h":0.011627907049460484,"text":"the library.","y":0.69331395351015357,"x":0.84257206182935684,"w":0.070953435897827211},{"text":"Please remember that all cards are personal - you mustn't let","x":0.55185148797695616,"y":0.7042164559946984,"w":0.40405838012695316,"h":0.017411239029931247},{"h":0.013114754098360604,"text":"_use yours. If your card is lost or3","x":0.62527716871384564,"y":0.7209016391625449,"w":0.22838136672973641},{"h":0.013868563292456448,"w":0.061286034584045357,"x":0.55139007320409261,"text":"please 4","y":0.73353754313028641},{"text":"know as soon as possible and we'll give","x":0.67849224715455481,"y":0.72950819706083569,"h":0.019038313724955569,"w":0.26829267501831056},{"text":"you a new one. You will have to renew your card 5","w":0.33702880859374995,"h":0.013114754098360715,"y":0.74999999985451493,"x":0.54988913916210524},{"x":0.55210644632014294,"text":"so talk to a librarian at the beginning of the next academic","h":0.013272016165686407,"w":0.38580928802490233,"y":0.76434426267688449},{"text":"year about this.","w":0.10643014907836901,"x":0.54988914009496181,"h":0.011627906267760224,"y":0.7790697677963524},{"w":0.29268291473388663,"x":0.55210644078531079,"h":0.013248189160081192,"text":"As a student, you may borrow a maximum 6","y":0.80232558133184773},{"h":0.013138581494815949,"text":"10 books for three weeks. Please make sure you '","w":0.33037693023681647,"x":0.55210644024005429,"y":0.81680327859775492},{"text":"them","x":0.55210643082598665,"w":0.035476717948913605,"h":0.0087209302870953076,"y":0.83284883714569657},{"text":"on time. If you return them 8","x":0.66518847198452735,"h":0.013276782192167769,"w":0.19068735122680658,"y":0.83139534906440593},{"h":0.013114754489210734,"text":"you'll have to pay a fine (25 pence per day).","x":0.54988913782891768,"y":0.84590163907170168,"w":0.29268291473388675},{"h":0.013229126617556708,"x":0.55210643209459931,"w":0.35476718902587889,"y":0.87049180333329879,"text":"The Library is usually open from 8 a.m. to 8 p.m. on?"},{"y":0.88517441897719673,"text":"and from 9 a.m. to 2 p.m. at the weekend. Please remember","w":0.39689579010009768,"x":0.55210642701203549,"h":0.013186237069427009},{"x":0.55210643702377227,"y":0.89959016376485246,"text":"that the opening times 1°","w":0.16851440429687503,"h":0.013200533585470242},{"h":0.011885245901639307,"x":0.79157428211073433,"text":"be different on bank","w":0.13747227668762207,"y":0.89959016398904734},{"x":0.54988913949300977,"y":0.91270491838410939,"h":0.014754098360655776,"text":"holidays. Don't forget to \"_","w":0.18625276565551763},{"x":0.80266075566139916,"text":"our website for the","w":0.12638580322265625,"h":0.010298322458736187,"y":0.91557377047358246},{"h":0.01029537349450782,"text":"latest news.","x":0.54950402500060358,"y":0.92968907557264635,"w":0.08510929107666021}]
44444447720034079,"text":"cheaper to run than the average house,"},{"x":0.04444445634339271,"text":"since energy bills are far lower. 2","y":0.69912790664422664,"w":0.26888887405395506,"h":0.0131169914712711},{"text":"Although Amanda and Simon struggled","x":0.044444453720033861,"y":0.71510204062278293,"h":0.013095633837641452,"w":0.30222221374511721},{"x":0.042222224207028487,"y":0.73102040804175872,"h":0.011836734693877471,"w":0.30444444656372072,"text":"to get rid of many of their possessions"},{"text":"before moving to their tiny home,","h":0.011627906487912565,"x":0.042222235773401166,"y":0.74563953517658621,"w":0.30444442749023437},{"h":0.011836734693877582,"y":0.76000000003939716,"w":0.30222221374511721,"text":"they found it had unexpected bonuses.","x":0.044444453720033861},{"text":"'Living more minimally gave us","w":0.30480749130249024,"x":0.042007992818044071,"y":0.77451456730576063,"h":0.015526498288524482},{"y":0.79061224463046587,"text":"the financial freedom we sought and","x":0.042222228460774718,"h":0.013166825430733775,"w":0.30222221374511715},{"y":0.80523255785546688,"text":"enabled us to prioritise better and","x":0.042222233802273051,"h":0.013134788980289414,"w":0.31333332061767583},{"text":"set new personal goals. We grew as","y":0.2500000001717414,"h":0.011632653061224518,"w":0.30444442749023448,"x":0.36888890117154938},{"x":0.36666667343299691,"y":0.26308139591002466,"h":0.016102277794662667,"w":0.20222221374511723,"text":"individuals,' they explain."},{"h":0.013175130571637772,"x":0.39555556432596828,"text":"Others choose tiny living for","y":0.27906976722441079,"w":0.27777776718139646},{"h":0.015354944345902455,"y":0.29244645659560131,"w":0.30498643875122072,"x":0.36866345375314508,"text":"environmental or well-being reasons,"},{"w":0.30222221374511721,"h":0.013264119673748409,"y":0.30959302331089333,"x":0.36888889246077466,"text":"and shrinking your home can have a"},{"text":"huge impact on both. 'Our entire house","x":0.36444444379002561,"w":0.30666666030883794,"y":0.3240816329971814,"h":0.014693877551020362},{"w":0.30666666030883794,"h":0.014534884083027833,"text":"was built using recycled materials,","x":0.36666667340113646,"y":0.33866279033493951},{"x":0.37111112038670041,"text":"Aleesha reveals, 'and contains fewer","y":0.35306122484577351,"h":0.013217845060387368,"w":0.30222221374511721},{"w":0.30444442749023432,"x":0.36888889281043852,"y":0.36918604613066086,"h":0.01326293322504779,"text":"things to replace or repair. Our"},{"h":0.013192928859165787,"w":0.30222221374511721,"text":"energy consumption hasdroppedby","x":0.36666666586818225,"y":0.38517441846593203},{"h":0.013198861102668547,"y":0.39959183695271716,"text":"a staggering 98 percent. Because the","w":0.30444442749023443,"x":0.36666667495858646},{"text":"house is small, we've found ourselves","y":0.41424418590779255,"x":0.36666667006969772,"w":0.30444442749023443,"h":0.013102752529845052},{"h":0.013261746776347283,"text":"spending more time outdoors and are","x":0.36666667006969772,"w":0.30444442749023443,"y":0.42877906972562196},{"x":0.36666667466039571,"w":0.30666666030883794,"text":"much fitter - physically and mentally?","y":0.44326530633282279,"h":0.014693877551020473},{"h":0.011627906487912565,"w":0.22888887405395503,"text":"Typical modern homes,","y":0.46075581410100497,"x":0.42222223345450388},{"x":0.36666666701224776,"text":"contrast, can make it tougher.","y":0.47510204097047293,"h":0.011836734693877471,"w":0.22666666030883792},{"text":"be relatively easy to build. You can","w":0.29777776718139648,"h":0.013469387755102091,"x":0.6911111134463388,"y":0.39224489792220907},{"w":0.2999999809265137,"y":0.40843023339784845,"h":0.014534882526008541,"text":"buy kits online or design your own.","x":0.68888890090711341},{"x":0.69111112013152398,"h":0.013189368734554341,"text":"Thirteen-year-old Luke did just that -","w":0.29777776718139648,"y":0.42285714300179067},{"y":0.4387755100593701,"x":0.68888888513888902,"w":0.30000000000000004,"
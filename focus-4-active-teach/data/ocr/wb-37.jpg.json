[{"x":0.7915742848434324,"w":0.16851440429687503,"text":"UNITS 1-2","y":0.013081395173303756,"h":0.018895349018702601},{"w":0.013303768634796142,"text":"3","h":0.0087209301962595243,"y":0.068313953409622208,"x":0.015521064906548707},{"w":0.38580928802490239,"x":0.028824839579566799,"text":"In pairs, discuss the questions about education.","h":0.011627906668205679,"y":0.068313953642641367},{"w":0.59866958618164068,"text":"1 Some people think there are too many exams at school. What do you think?","x":0.039911336620930979,"y":0.085755813811138726,"h":0.013262189546700553},{"h":0.013274083941345771,"y":0.098837209166032114,"text":"2 Do you think it's a good idea for boys and girls to attend different schools? Why?\/Why not?","x":0.039911308099784722,"w":0.71396896362304685},{"h":0.0087209301962594132,"y":0.11482558126814935,"text":"3","w":0.011086474657058719,"x":0.039911308015151352},{"text":"Should higher education be free for everyone?","x":0.064301549773452649,"h":0.013114699365269322,"y":0.11333878876157644,"w":0.35254989624023442},{"x":0.039911311907298491,"y":0.12790697664059603,"w":0.43902439117431635,"h":0.013255052597745176,"text":"4 In what ways does technology help students at school?"},{"x":0.039911314881182915,"w":0.67627494812011724,"y":0.14238952498701662,"text":"5 Should students be given more choice about the subjects they study? Why?\/Why not?","h":0.013133730708869917},{"text":"4 Do the task in pairs.","y":0.16407528619790079,"w":0.18181818008422854,"x":0.017738362341477725,"h":0.013250295152055447},{"h":0.010397035829759482,"w":0.079888296127319333,"y":0.18884217939383041,"text":"Student A","x":0.039878467975877824},{"text":"Look at the photos. They show people explaining problems. Compare the photos and say what the disadvantages of","x":0.039866428579568944,"y":0.20181127219812167,"w":0.88259819030761721,"h":0.015312388368597163},{"x":0.039911313496774486,"y":0.21644844497197546,"h":0.01320271757347502,"text":"each method of communication are.","w":0.27272726058959962},{"w":0.53880264282226553,"h":0.013264568269545474,"x":0.039911310434765319,"y":0.23837209310498564,"text":"Student B, how do you prefer to communicate with your friends? Why?"},{"w":0.080073556900024406,"y":0.54171219628527101,"x":0.042003131526139582,"text":"Student B","h":0.011052351731520416},{"h":0.01328122010988031,"y":0.55668604646617748,"x":0.044345902972945196,"w":0.91130821228027348,"text":"Look at the photos. They show teenagers doing different activities. Compare the photos and decide what they say about"},{"h":0.01162790666820579,"x":0.042128604709367606,"w":0.1485587501525879,"text":"the people in them.","y":0.57267441875892033},{"w":0.48780487060546873,"h":0.013224127639920313,"text":"Student A, which photo best represents teenagers today? Why?","y":0.59288052371366962,"x":0.042128601578270947},{"y":0.96802325591536853,"text":"35","w":0.024390244483947665,"x":0.9290465627912855,"h":0.011627906668205679}]
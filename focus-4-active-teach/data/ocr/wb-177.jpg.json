[{"x":0.011111127160101972,"w":0.46666664123535156,"text":"GRAMMAR: Train and Try Again","y":0.013061224590447451,"h":0.02327598416075416},{"text":"UNIT 5","y":0.012671366722765143,"w":0.098143138885497971,"x":0.86648398548692429,"h":0.019715406456772167},{"x":0.028888894432996963,"w":0.20222221374511717,"y":0.077034884500140954,"text":"5.2 Reported speech","h":0.016026339628258501},{"x":0.028888887992971492,"y":0.09142857135997684,"w":0.19555555343627931,"h":0.014693877551020362,"text":"5.5 Reporting verbs"},{"text":"1 Complete the second sentence so that it means the","x":0.020000007508165041,"h":0.011630279774568542,"y":0.11918367339671332,"w":0.4311111068725586},{"h":0.011627906487912565,"y":0.13372093057387313,"text":"same as the first.","w":0.13555555343627929,"x":0.042222221022601189},{"h":0.01322377808239994,"y":0.15102040806649353,"text":"1 'My dad travels on business so often that our dog","x":0.044444443520706686,"w":0.3977777862548828},{"w":0.2577777671813965,"text":"hardly recognises him, ' says Greg.","x":0.068888895446338763,"y":0.16408163280912047,"h":0.014697436118612406},{"w":0.075555553436279302,"x":0.068888889004082618,"text":"Greg says","h":0.011836734693877582,"y":0.18163265309756171},{"w":0.39333332061767579,"text":"2 'I didn't break the glass. Gill did it!' said Michael.","h":0.011836734693877582,"y":0.19469387757805023,"x":0.04444445571893979},{"x":0.06888889059648573,"h":0.010289510999407003,"text":"Michael denied","w":0.11777777671813966,"y":0.20930232577124164},{"y":0.22367346922512987,"text":"and accused Gill","w":0.12666666030883789,"h":0.010338158510169171,"x":0.068888890484469986},{"w":0.01111111044883728,"y":0.23837209345535015,"h":0.010174418079609726,"text":"3","x":0.044444444886692462},{"text":"Why didn't you tell me that you had been fired?'","x":0.055555553423737934,"w":0.38222221374511722,"h":0.013265306122449028,"y":0.2367346940647197},{"text":"Sam asked Lucy.","y":0.25142857160770771,"w":0.12444444656372071,"x":0.068888889073695156,"h":0.011836734693877582},{"text":"Sam asked Lucy why","y":0.26598837214810267,"x":0.068888892467045437,"w":0.1555555534362793,"h":0.013195300978057212},{"text":"4 'Are you happy with the final score?' my mother","x":0.044444461026768634,"y":0.28040816301872296,"w":0.38666664123535155,"h":0.01319648820526742},{"h":0.010247982570103287,"y":0.29505813982162921,"w":0.12666666030883789,"x":0.068888894178914348,"text":"wanted to know."},{"x":0.068888889380723697,"text":"My mother wanted to know","y":0.30959302342755535,"h":0.01163146622326916,"w":0.20888889312744141},{"w":0.01555555582046509,"x":0.042222222200878567,"y":0.32412790733743901,"text":"5","h":0.011627906487912565},{"text":"'You shouldn't say anything to Jane!' Bob suggested","y":0.32267441851438172,"h":0.013243948488819379,"x":0.055555550822980207,"w":0.41111110687255858},{"w":0.11555555343627932,"x":0.071111111207786293,"text":"Bob suggested","h":0.011627906487912454,"y":0.33866279099053986},{"w":0.013333332538604734,"text":"6","x":0.044444444619586534,"y":0.3531976747961294,"h":0.0087209296713071094},{"h":0.013153772938008235,"text":"'You mustn't be late,' my dad warned me.","x":0.055555558822979946,"y":0.35174418610159097,"w":0.33111110687255857},{"w":0.11777777671813966,"y":0.36773255857774911,"text":"My dad warned","x":0.07111111041870799,"h":0.011627906487912565},{"x":0.04444445138232446,"text":"7 'We're leaving early tomorrow,' he insisted","y":0.38081395334965307,"h":0.013081395674724883,"w":0.34666664123535157},{"text":"He insisted","x":0.071087634514070144,"y":0.3952653330445135,"h":0.010341427082918075,"w":0.084491395950317391},{"text":"8 'We might be late for dinner tonight,' they said","w":0.38,"y":0.40843023232252129,"h":0.01320242044877018,"x":0.046666670466666602},{"text":"They informed me","w":0.13999999999999999,"y":0.42441860482290417,"h":0.011627906487912565,"x":0.071111112861111075},{"y":0.43749999989156185,"h":0.013112244897959258,"w":0.32444442749023433,"text":"9 'Did you go to the interview last week?'","x":0.044444448865994059},{"x":0.071111112861111075,"y":0.45346938756487343,"w":0.13999999999999999,"h":0.011836734693877471,"text":"Tracy asked Sonia."},{"x":0.071111113911489915,"h":0.013120550817372845,"text":"Tracy asked Sonia","y":0.46653061191824552,"w":0.13555555343627929},{"h":0.0087209296713069984,"x":0.035555555940051616,"text":"10","y":0.48255813988818363,"w":0.022222220897674561},{"w":0.35111110687255864,"text":"'Could I borrow your mobile, Bill?' asked Sue.","y":0.48110465094534094,"h":0.013181063593650344,"x":0.066666673174831742},{"y":0.49551020399085344,"text":"Sue asked Bill","h":0.010303749162323572,"w":0.10666666030883788,"x":0.071111115356692137},{"text":"Summative Practice","h":0.01324988151083184,"w":0.18666666030883788,"y":0.52470930211072719,"x":0.033333337845581054},{"y":0.5242694699490511,"w":0.091398677825927754,"h":0.013961060193120156,"x":0.37985621599069574,"text":"Units 1-5"},{"h":0.011627906487912565,"text":"2 Complete the text with one word in each gap.","x":0.022222235135606318,"y":0.55377906996340798,"w":0.39333332061767579},{"x":0.031111113857828804,"y":0.58571428573863804,"text":"Dog helps boy lost in mountains stay alive","w":0.43333332061767571,"h":0.018936876569475514},{"w":0.14966258049011233,"h":0.015562886607890181,"x":0.0329595634449424,"text":"A 14-year-old boy 1","y":0.607369035173287},{"h":0.013113432125169466,"w":0.1555555534362793,"text":"got lost in the Sierra","y":0.60897959151161163,"x":0.25111110987445301},{"h":0.011627906487912565,"text":"Madre Oriental mountain range spent nearly two days","y":0.62354651177542353,"x":0.033333350855640306,"w":0.41555553436279297},{"y":0.63468996818154244,"h":0.014021519252232162,"w":0.33363304138183592,"x":0.033205038100990618,"text":"surviving in the wilderness before rescuers ?"},{"x":0.03333334721784556,"text":"by the name of Max, a wandering dog he 3","y":0.66122449011517648,"w":0.32444442749023439,"h":0.013194114529356593},{"text":"only met a short time before, refused 4","x":0.035555567491540853,"y":0.67428571423063488,"h":0.013214285714285734,"w":0.28888887405395508},{"x":0.033333339172643618,"y":0.69020408160919289,"h":0.011836734693877582,"w":0.29333332061767575,"text":"him alone during his traumatic ordeal."},{"text":"Juan Heriberto Trevino, from Galeana, Mexico, had","h":0.011627906487912565,"x":0.03333334362449538,"y":0.70639534899441581,"w":0.39333332061767579},{"h":0.013145467797104127,"y":0.71795918360130473,"w":0.37777774810791015,"text":"become separated from his summer camp group 5","x":0.033333341871971033},{"text":"he went in search of firewood. Although he had assured","w":0.41777778625488277,"x":0.035555553372558571,"y":0.73255813992464835,"h":0.011627906487912565},{"y":0.74563953493880031,"text":"the camp leaders 6","x":0.035555555444444449,"h":0.013135975428990032,"w":0.14000000000000001},{"y":0.74563953517658621,"text":"he would be careful,","x":0.24222222012241176,"h":0.011627906487912565,"w":0.15777777671813967},{"text":"he accidentally slipped and fell down the mountainside.","y":0.75999999995461032,"h":0.011836734693877471,"w":0.42000000000000004,"x":0.035555560805555435},{"x":0.035555561592592433,"y":0.77469387733299722,"h":0.01309682028634207,"w":0.37999999999999995,"text":"After recovering from his fall, it took Juan only a'"},{"h":0.011627906487912565,"x":0.035555548065909125,"text":"time to realise that his new friend Max had followed him","y":0.78924418648472594,"w":0.42888889312744144},{"h":0.011836734693877582,"y":0.80367346926471828,"w":0.40222221374511713,"x":0.035555565090404181,"text":"down into the ravine. As night time fell, the boy took"},{"w":0.4044444274902344,"h":0.011836734693877582,"y":0.81673469396488796,"x":0.035555570773401081,"text":"cover under a tree and cuddled the dog to stay warm."},{"text":"Although he admitted®","x":0.035555562798190596,"w":0.17777776718139648,"y":0.82848837176656187,"h":0.01314428134840373},{"w":0.1644444465637207,"h":0.011836734693877582,"text":"_pretty frightened at","x":0.2711111116959174,"y":0.82979591847929124},{"x":0.035555566357828673,"text":"the time, the presence of the dog also convinced ?","y":0.84156976711539899,"h":0.013124110163474589,"w":0.37333332061767571},{"w":0.24444444656372072,"x":0.035555557551472938,"y":0.85591836724723436,"h":0.011836734693877582,"text":"that he would eventually be safe."},{"h":0.011836734693877582,"w":0.41555553436279297,"text":"When the pair was eventually located by a search party","x":0.035555571346381216,"y":0.87346938757379855},{"h":0.011836734693877582,"y":0.8865306122577753,"text":"forty-four hours later, the authorities claimed the role of","w":0.42666664123535158,"x":0.035555564004546486},{"text":"the dog had 1°","y":0.89959183686907784,"x":0.037777781001136608,"w":0.1066666603088379,"h":0.011836734693877582},{"h":0.011836734693877471,"text":"vital in helping the boy survive","x":0.21333333144852709,"w":0.23555555343627929,"y":0.89959183682547317},{"x":0.03555555302260123,"w":0.2155555534362793,"text":"the cold night temperatures.","y":0.91424418633937699,"h":0.011627906487912565},{"h":0.011836734693877582,"w":0.2488888740539551,"text":"3 Choose the correct option.","y":0.06816326540569928,"x":0.49777778934339267},{"x":0.51333334605488279,"text":"My first (and only ever!) job interview was about six months","y":0.098775510234553998,"h":0.011836734693877582,"w":0.42444442749023437},{"text":"ago. It was only for part-time work in a local music store but","w":0.42444442749023437,"h":0.011836734693877582,"x":0.51333334605488279,"y":0.11183673478771694},{"w":0.42000000000000004,"y":0.12489795911150892,"h":0.011836734693877582,"text":"I remember 'to spend \/ spend \/ spending hours getting ready","x":0.51333332983333335},{"x":0.51333334810454634,"h":0.011836734693877582,"text":"for it. Obviously I was a little nervous as I 2was hoping \/ had","w":0.42666664123535147,"y":0.13795918383590344},{"y":0.15261627938685762,"x":0.51333334269604503,"w":0.43777774810791015,"text":"been hoping \/ had hoped to get the job. I'm a bit of an amateur","h":0.011627906487912565},{"x":0.51333334449343537,"h":0.013081395674724883,"y":0.16569767412484682,"text":"photographer and I 3saved up \/ had saved up \/ was saving up","w":0.42666664123535158},{"text":"for a new camera at the time. There was a school photography","h":0.010174418079609837,"y":0.18023255847472996,"w":0.43333332061767571,"x":0.51333333535782888},{"y":0.19183673498279086,"w":0.42000000000000004,"x":0.51333333166666673,"h":0.013105125427246067,"text":"competition that term, 4what \/ that \/ which I was really keen"},{"h":0.011836734693877582,"w":0.27555555343627924,"y":0.20775510197209401,"text":"to take part in and show my talents off.","x":0.51333333180037899},{"text":"Anyway, my parents Sadvised \/ convinced \/ recommended","x":0.51555555797929342,"y":0.22674418566554455,"w":0.40222221374511724,"h":0.013255814532844301},{"x":0.51333335479789655,"y":0.24122448977143862,"h":0.011836734693877471,"text":"me not to dress up too smartly, but I believed that I knew","w":0.39777774810791011},{"w":0.4311111068725586,"h":0.011836734693877693,"x":0.5133333304896468,"y":0.2542857142260444,"text":"better. I sometimes think I °should have listened \/ didn't need"},{"w":0.40222221374511713,"y":0.26889534919057301,"x":0.51333333254410807,"text":"to listen \/ must have listened to them because I felt a little","h":0.010288324161451756},{"h":0.011627906487912565,"y":0.28197674452736154,"x":0.5133333324689402,"w":0.43333332061767571,"text":"over-dressed when I arrived. And when the manager came out"},{"h":0.013105126205755768,"x":0.51555555714814816,"w":0.42000000000000004,"text":"wearing jeans and a T-shirt, I nearly died. I explained to him","y":0.29505813915391665},{"w":0.43333332061767582,"h":0.010174418079609837,"text":"that I'didn't expect \/ hadn't been expecting \/ wasn't expecting","y":0.30959302347472994,"x":0.5155555662467175},{"y":0.32267441865526858,"text":"an informal meeting. Fortunately, he was really cool and he","w":0.41555553436279302,"x":0.51555557204082558,"h":0.011627906487912454},{"h":0.013223778082400051,"text":"Scriticised \/ congratulated \/ praised me for making an effort.","w":0.42222221374511715,"x":0.51555555957188592,"y":0.33575581400856769},{"x":0.51555555232516825,"h":0.011836734693877471,"text":"This time next week, I ºwill work \/ will have been working","y":0.35591836752747774,"w":0.40888889312744137},{"w":0.38888889312744146,"y":0.37061224478907495,"x":0.5155555582973903,"text":"\/ will be working there for half a year. Oh, and I bought","h":0.011836734693877693},{"x":0.5155555603000852,"y":0.38367346922557588,"w":0.39555553436279289,"h":0.013128856736786654,"text":"my camera and came first in the school competition - so"},{"w":0.42222221374511715,"x":0.5155555668311449,"text":"everything 1°was working out \/ had worked out \/ worked out","y":0.3967346938772961,"h":0.013149027143205871},{"h":0.011627906487912565,"w":0.15555555343627936,"text":"really well in the end.","y":0.41133720935294305,"x":0.51555555668926767},{"y":0.44476744206847996,"x":0.50666667844116209,"h":0.010334598774812687,"w":0.43333332061767571,"text":"4 Find the mistakes and correct the sentences. There"},{"h":0.011836734693877582,"y":0.45918367352357492,"text":"may be more than one mistake in a sentence.","w":0.36222221374511721,"x":0.53333334209966354},{"y":0.47673469383560407,"w":0.42444442749023437,"h":0.011836734693877471,"text":"1 He told him that he was ill and that was why he can't","x":0.53333334605488258},{"y":0.48979591843970283,"h":0.013111058449258639,"text":"come to work the following day.","x":0.55777778404002543,"w":0.24666666030883788},{"text":"2 The clerk asked what was her email address.","h":0.011836734693877582,"w":0.35999999999999999,"y":0.51877551017322709,"x":0.53333333681481476},{"y":0.54600138703377732,"w":0.39608123779296867,"h":0.017896791574906312,"text":"3 He used to travelling a lot when he was younger.","x":0.5
22474501284,"h":0.010272899549834458,"text":"She told me","y":0.44612244898124942,"w":0.093333330154418914},{"y":0.45918367341462707,"h":0.013200047551369165,"w":0.40222221374511724,"x":0.55555556482188562,"text":"6 'Don't forget to renew your passport next month'"},{"x":0.58222222497834608,"text":"She told me","y":0.47383720951034047,"w":0.093333330154418914,"h":0.010244423224001542},{"text":"7 'How long had you been campaigning for a change","x":0.55555555778005106,"y":0.48691860453182345,"h":0.013081395674724994,"w":0.41333332061767569},{"x":0.58000000264909535,"y":0.5014534888041875,"h":0.010174418079609726,"w":0.088888883590698242,"text":"in the law?'"},{"text":"The presenter asked","h":0.011836734693877471,"x":0.58222222239297139,"y":0.51591836733839624,"w":0.15555555343627925},{"h":0.013162078857421822,"y":0.55224489821322553,"w":0.2666666603088379,"text":"SHOW WHAT YOU'VE LEARNT","x":0.5444444490678032},{"text":"5 Complete the gaps in the conversation to report the","w":0.43577354431152338,"x":0.53544773003031343,"y":0.57797304860884469,"h":0.013895575075733357},{"y":0.59302325602929962,"text":"head teacher's speech.","x":0.55555556161633024,"h":0.011627906487912454,"w":0.18222221374511716},{"y":0.61918367354805459,"text":"Does everyone have a seat? OK, be quiet please! Good","x":0.58888887980883797,"h":0.010204081632653073,"w":0.32666667938232419},{"text":"morning everyone. Last month, you all voted for a new student","y":0.63224489796798122,"h":0.010204081632653073,"w":0.37555553436279299,"x":0.56444445879638128},{"x":0.56444445120260955,"y":0.64530612253931274,"h":0.010217132957614172,"w":0.37111110687255855,"text":"representative and | am pleased to announce that Philip Coen"},{"h":0.011627906487912565,"x":0.55777778362525321,"text":"has been chosen. Some of you might not know Phillip very well,","y":0.65697674423666386,"w":0.38444442749023444},{"h":0.010350023386429763,"y":0.67005813977923578,"w":0.27999999999999992,"x":0.61111111461111112,"text":"but I'm sure he will make a fine representative."},{"w":0.39111110687255857,"h":0.01321665861168686,"y":0.69331395325275369,"x":0.55555556158594288,"text":"Mel: I missed the meeting. Tell me what happened"},{"text":"Sam: The head teacher checked if everyone had a seat","x":0.55555557030749236,"w":0.41555553436279302,"y":0.70775510210941095,"h":0.011836734693877582},{"w":0.14000000000000001,"h":0.010288324550706496,"text":"then asked us all 1","x":0.59999999859999997,"y":0.72081632642223781},{"x":0.81555555512241173,"text":"_quiet.","y":0.72383720963752074,"h":0.010174418079609726,"w":0.057777776718139662},{"w":0.28666666030883781,"x":0.55555556351224755,"y":0.73546511646891599,"h":0.010249169408058645,"text":"Mel: OK, OK, but what was it about?"},{"h":0.010228998612384466,"w":0.15555555343627936,"text":"Sam: She said that 2","x":0.55555555650569299,"y":0.74854651149380003},{"h":0.010174418079609726,"y":0.75000000020801483,"text":"all the students","w":0.11777777671813972,"x":0.80000000200204124},{"text":"for a new representative...","y":0.76308139559325294,"x":0.69777778440113647,"w":0.20666666030883796,"h":0.011627906487912565},{"h":0.010367821284702816,"text":"Mel: I know that! Who won?","x":0.55555555775555543,"w":0.22000000000000008,"y":0.77616279088752071},{"x":0.55555556460782862,"w":0.23333332061767587,"text":"Sam: ... and that Philip Coen 4","y":0.78924418572005028,"h":0.013204794124681118},{"h":0.010280018631292909,"w":0.24666666030883788,"text":"Mel: Who? I didn't vote for him.","y":0.80367346946011087,"x":0.55555556181780319},{"x":0.55555555744225626,"text":"Sam: Well, she said that some of us 5","y":0.81673469369675711,"h":0.011836734693877582,"w":0.28222221374511725},{"text":"not know Phillip very well, but he would make","w":0.34444442749023441,"h":0.011627906487912565,"x":0.60000000417154953,"y":0.83139534915429936},{"w":0.16000000000000003,"y":0.84447674428511355,"h":0.011627906487912454,"text":"a fine representative.","x":0.59999999833333328},{"x":0.55555555840113657,"h":0.011627906487912454,"text":"Mel: Do you know him?","w":0.18666666030883783,"y":0.85901162829674149},{"y":0.87209302306864533,"x":0.55555555991776062,"w":0.38888889312744135,"text":"Sam: No, not really, but if the head teacher says he","h":0.013213099265585115},{"x":0.69333333763968918,"h":0.011836734693877582,"y":0.88653061227231011,"text":"_ make a fine representative, then","w":0.2488888740539551},{"text":"hopefully she's right.","h":0.014693877551020473,"y":0.89959183689827482,"w":0.16000000000000003,"x":0.59555555699999996},{"y":0.91279069800961377,"w":0.022222220897674561,"x":0.94444444488449619,"h":0.010174418079609726,"text":"16"},{"y":0.9404069770176714,"x":0.59555555657188597,"h":0.011627906487912565,"w":0.32222221374511717,"text":"GRAMMAR: Train and Try Again page 175"}]
[{"w":0.30888889312744139,"text":"VOCABULARY BANK","h":0.020348837716238855,"y":0.014534883386712605,"x":0.0088888884856620012},{"x":0.7976399900226141,"w":0.16027557373046875,"text":"EXERCISES","y":0.012572094170037684,"h":0.019913951328822566},{"text":"5 Complete the text with the correct form of the words","y":0.067764208738561371,"w":0.44698322296142579,"x":0.017593071561433221,"h":0.015617582360092475},{"x":0.03981747060632429,"w":0.084809503555297858,"y":0.085066655159937277,"text":"in the box.","h":0.01155273593201922},{"x":0.057777778863152364,"y":0.11191860474410986,"w":0.077777776718139652,"h":0.010174418079609726,"text":"astonish"},{"text":"aware clear dare feel final","x":0.13333333766666647,"h":0.011627906487912454,"y":0.11046511642658641,"w":0.26000000000000001},{"h":0.011627906487912565,"y":0.12645348873278794,"text":"firm hair imagine risk","w":0.20222221374511717,"x":0.057777782660774726},{"h":0.018238246684171733,"y":0.1565655423800244,"text":"Stephen was finally home. He came in and shut the","x":0.030814629213234069,"w":0.38491004943847656},{"w":0.046666665077209471,"text":"door'","x":0.031111112266950815,"y":0.17441860475022974,"h":0.011627906487912565},{"w":0.24222221374511715,"x":0.18222222434966373,"text":"behind him. Weird ... it was not","h":0.011836734693877582,"y":0.17428571427296458},{"y":0.18895348828182357,"h":0.013087327918227865,"w":0.38666664123535155,"x":0.028888895160102238,"text":"locked. His mum always complained about him not"},{"x":0.030860233170673369,"y":0.20105549894045849,"text":"locking the door - this time it had 2","w":0.26508920669555663,"h":0.016295575511698912},{"text":"been","w":0.042378396987915012,"y":0.20332487643810437,"x":0.39992191191262066,"h":0.0090479216283680941},{"x":0.031111121602273143,"y":0.21795918384878077,"w":0.4133333206176758,"text":"her that had forgotten. He went into the kitchen to get","h":0.011836734693877582},{"x":0.031111111844780659,"y":0.23255813935377123,"h":0.013156146613918951,"w":0.3977777862548828,"text":"something to eat. He could hear his mother upstairs,"},{"w":0.10013724327087403,"text":"but she was 3","x":0.033264712477044718,"h":0.012140629826759897,"y":0.24538317334642823},{"text":"he had returned. 'She must","y":0.24563953512201686,"x":0.23555556119335022,"h":0.01027883218259229,"w":0.2111111068725586},{"text":"be back from doing the shopping already, he thought.","y":0.26000000033787263,"h":0.013255813754334822,"x":0.03333334658005075,"w":0.41333332061767575},{"w":0.40888889312744142,"text":"He opened the fridge, but the shelves were practically","x":0.03333333802887168,"y":0.27469387747834606,"h":0.013096820286341959},{"y":0.28924418586539913,"h":0.013204793346171417,"text":"empty. Weird. If she was still out doing the shopping,","x":0.03333334259966346,"w":0.40222221374511719},{"h":0.01453488252600843,"x":0.031111108378535698,"w":0.29111110687255864,"y":0.30232558208970894,"text":"who was upstairs? 'It's only my vivid 4_"},{"w":0.3936801528930664,"y":0.31677807955397486,"text":"he thought. 'Maybe I've watched too many movies?'","h":0.015558236569774397,"x":0.033180007923907094},{"y":0.33265306130277428,"w":0.41555553436279297,"text":"She could have decided not to do the shopping today.","h":0.011836734693877582,"x":0.033333350855640306},{"x":0.033333329333333418,"y":0.34734693859828636,"h":0.011836734693877471,"w":0.39999999999999997,"text":"Maybe she was just cleaning the wardrobe? Or doing"},{"text":"that big clear-out she'd promised to do? But that was","x":0.033333341594108001,"y":0.36191860480836935,"h":0.011627906487912565,"w":0.40222221374511713},{"y":0.3734383896054454,"text":"a lot of 'maybes' and he had a gut 5","h":0.015553297704579805,"w":0.27157915115356446,"x":0.033125047301857613},{"text":"wasn't her. The question was: what should he do now?","y":0.38938775522832891,"x":0.033333340591498339,"w":0.41111110687255858,"h":0.013228523877202303},{"y":0.40406976749693979,"x":0.035555551399242338,"text":"He could leave by the front door again but that was","w":0.38888889312744146,"h":0.013081395674725105},{"x":0.033333333511111105,"y":0.41860465132356728,"h":0.010174418079609726,"w":0.039999999999999994,"text":"too6"},{"text":"_. Whoever it is might hear him.","x":0.16666667921784561,"y":0.41860465097562205,"w":0.24444442749023443,"h":0.013232084001813638},{"x":0.035555559193350295,"y":0.43306122435056693,"text":"'I'm not so7","w":0.091111106872558606,"h":0.01025272875416039},{"x":0.22666666952260101,"h":0.011836734693877471,"text":"\/ he thought. He eventually","y":0.43306122438091177,"w":0.2155555534362793},{"x":0.035555555494780719,"w":0.41777778625488282,"y":0.4476744187909274,"h":0.011627906487912565,"text":"came to a decision. He took his phone and, trying to keep"},{"h":0.013121737266073463,"text":"his voice steady, he called the police. Then he hid in the","y":0.46075581371787,"x":0.035555564016330227,"w":0.42222221374511726},{"x":0.03333334658005075,"y":0.47510204119627408,"h":0.01346938775510198,"w":0.41333332061767575,"text":"toilet. They arrived within minutes and caught the man"},{"y":0.48979591829435387,"x":0.035555557825168088,"w":0.40888889312744137,"h":0.013111058449258639,"text":"trying to steal everything they owned. As they put him"},{"text":"into the car, there was a look of 8","w":0.24666666030883788,"x":0.035555560978914366,"y":0.50436046524441591,"h":0.011627906487912454},{"h":0.01029047596211341,"w":0.046725878715515146,"text":"on his","y":0.50430243639510486,"x":0.38885928333138153},{"w":0.40222221374511719,"x":0.03555556649781156,"y":0.51877551027624635,"h":0.013201234000069673,"text":"face. He couldn't believe they had caught him. When"},{"text":"they drove off, Stephen thought that this had been one","x":0.03555556713123021,"w":0.41777774810791019,"y":0.53343023261321887,"h":0.013100379632443815},{"x":0.035555556228346108,"y":0.54796511663243352,"w":0.073333330154418938,"h":0.010174418079609726,"text":"of those?"},{"y":0.54651162758051552,"w":0.24444444656372069,"text":"moments he would never forget.","x":0.21111111182925071,"h":0.013081395674724883},{"y":0.069767442163020443,"h":0.011627906487912565,"w":0.062222223281860389,"x":0.49333333218129211,"text":"HOME"},{"x":0.49555555590803624,"text":"1","y":0.090116279162714474,"w":0.015555554628372215,"h":0.010174418079609837},{"text":"below.","x":0.52215300467488268,"y":0.10591322531840519,"h":0.0091037820310009288,"w":0.055693988800048833},{"x":0.52222223349781161,"y":0.090116279265733623,"h":0.011627906487912565,"w":0.42222221374511715,"text":"Find the words in the text that match the definitions"},{"text":"She walked into her new house; it was a bit run-down,","h":0.011836734693877582,"x":0.51555556649781153,"y":0.13510204080727406,"w":0.40222221374511713},{"h":0.011627906487912565,"y":0.14970930249732284,"w":0.40444442749023435,"text":"so there was a lot to do if she was going to turn it into","x":0.51333334686599386},{"text":"a home. First of all, it was freezing; the high ceilings and","w":0.4133333206176758,"x":0.51333333280227333,"y":0.16408163279522259,"h":0.011836734693877582},{"y":0.17877551020382665,"text":"old windows meant that it was quite draughty. Those","x":0.51555556683005088,"h":0.01163146622326916,"w":0.39333332061767579},{"y":0.19331395384906691,"text":"windows also made her worry about damp, the walls did","x":0.51555555162811417,"h":0.011627906487912565,"w":0.41777778625488282},{"text":"feel quite cold and a little wet. She'd definitely need new","y":0.20576642569062498,"h":0.013916236721739472,"w":0.42019569396972656,"x":0.51545531203081407},{"x":0.51555556596565766,"y":0.22238372131999717,"h":0.011627906487912565,"w":0.40666664123535157,"text":"windows and perhaps a wood burner to heat the place"},{"h":0.013577166187519918,"x":0.51547233538356385,"text":"up. That would give it the right atmosphere. For now,","y":0.23504756995066878,"w":0.39347003936767577},{"h":0.013265306122448917,"y":0.25000000005507939,"w":0.41777774810791013,"x":0.51555556631641553,"text":"she would just have to do some cleaning. She'd brought"},{"w":0.38222221374511711,"h":0.013245135716029588,"y":0.26308139496787009,"x":0.51555556297929317,"text":"a bucket full of cleaning solutions, but first she was"},{"text":"going to give the house a good clear-out, as the previous","x":0.51760093572982979,"w":0.42254302978515623,"y":0.2770071589101708,"h":0.015206343981684523},{"w":0.38222221374511722,"h":0.011627906487912565,"text":"owners had left a lot of their old clutter behind. She","x":0.51777778120151552,"y":0.29215116284131493},{"x":0.51555554628813138,"text":"tested the taps, at least there was running water; nothing","y":0.30813953517658632,"h":0.011627906487912565,"w":0.42888889312744138},{"w":0.41111110687255858,"x":0.51777777956372062,"y":0.32122093028317555,"h":0.011627906487912565,"text":"else seemed to work. The lock on the door was broken"},{"h":0.013223778082400051,"w":0.42666664123535158,"text":"and the old solar panels the previous people had installed","x":0.51777778790084283,"y":0.33575581400856769},{"h":0.013168011879434283,"y":0.35020408139760839,"text":"no longer seemed to create any electricity at all.","w":0.35999999999999999,"x":0.51777777327777785},{"text":"'Don't worry, she thought to herself. 'By the time I'm","y":0.36482558156709022,"x":0.52000001328266054,"w":0.38444442749023433,"h":0.011627906487912565},{"h":0.014693877551020362,"text":"finished with it, it will be absolutely spotless!","x":0.5177777894689396,"w":0.33333332061767573,"y":0.37632653093124802},{"x":0.55555555679739033,"w":0.38888889312744135,"text":"Adjective: the windows and doors are not of a high","y":0.41860465083632936,"h":0.013232084001813638},{"h":0.011627906487912565,"w":0.39333332061767579,"text":"quality and allow cold air to enter the house draughty","y":0.43459302342755535,"x":0.55555556519116212},{"x":0.52888890066229011,"text":"1 Adjective: completely tidy and clean","y":0.44767441822368392,"h":0.013141908451002493,"w":0.30444442749023437},{"text":"2 Adjective: in a poor state, that needs fixing","w":0.35333332061767575,"h":0.01324988151083184,"x":0.52888889455227328,"y":0.46204081649004813},{"w":0.013333332538604692,"y":0.47819767459021856,"h":0.0087209296713069984,"text":"3","x":0.5288888891751421},{"x":0.55555556808821605,"h":0.013090887264329609,"text":"Noun: you put a key in this to keep a door","w":0.32444442749023439,"y":0.47673469420312009},{"y":0.49273255836202101,"x":0.55555555577865634,"w":0.035555555820465101,"text":"shut","h":0.0087209296713068873},{"x":0.52888890212933559,"h":0.011836734693877471,"y":0.50571428561840626,"text":"4 Noun: a heater that is fuelled by wood","w":0.31999998092651372},{"text":"5","h":0.0087209296713069984,"y":0.5218023259710326,"w":0.01111111044883728,"x":0.53111111152558133},{"y":0.51877551029441482,"w":0.27555555343627924,"x":0.55777778228186037,"h":0.013201234000069784,"text":"Noun: liquids for cleaning the house"},{"y":0.53343023223167829,"x":0.5577777780236951,"h":0.013100379632443704,"w":0.26444444656372068,"text":"Noun: water that comes from a tap"},{"x":0.5288888891751421,"h":0.0087209296713069984,"w":0.013333332538604692,"text":"7","y":0.54941860482277671},{"text":"Noun: a collection of untidy things","y":0.54796511657193525,"x":0.55555555962525327,"w":0.26444442749023445,"h":0.011627906487912565},{"y":0.56104651162848052,"h":0.013239202694017127,"text":"8 Noun: these are usually on the roof of","w":0.31555555343627928,"x":0.53111111328186045},{"text":"a house and turn sunlight into electricity","x":0.55555556256780325,"y":0.57703488389267166,"w":0.30666666030883782,"h":0.011627906487912565},{"text":"6 Are the statements true (T) or false (F)? Correct the","y":0.58571428571403084,"x":0.022222224391834793,"w":0.42888889312744144,"h":0.010215946508913665},{"text":"false statements.","h":0.010321547060596736,"x":0.044444447270559732,"w":0.13777777671813965,"y":0.60029069796116408},{"y":0.61755102032452402,"text":"If you glance at something, you look at it","x":0.071111121617466855,"w":0.3088888740539551,"h":0.01326293322504779},{"w":0.11868721008300782,"x":0.070518463798315098,"y":0.63224145284753908,"h":0.013293759092992685,"text":"for a long time."},{"text":"1 If you caught a glimpse of something,","x":0.046666678246717483,"y":0.64680232539422666,"h":0.013197674653968039,"w":0.31333332061767577},{"y":0.66122448945173462,"text":"you only saw it for a moment.","h":0.013194115307866294,"x":0.07111111285702848,"w":0.2244444465637207},{"h":0.011627906487912454,"text":"2 When you hesitate, you do something","x":0.04666667615782874,"y":0.67587209320953212,"w":0.31333332061767571},{"text":"immediately.","h":0.010174418079609726,"x":0.071111112361111062,"y":0.69040697698853815,"w":0.10000000000000001},{"y":0.70348837187557356,"w":0.35333332061767575,"h":0.013246322164730095,"text":"3 You sob when you are happy and full of joy.","x":0.04888889966338425},{"h":0.013145467797104238,"y":0.71795918345595588,"w":0.3977777862548828,"x":0.048888888628114059,"text":"4 When you peep, everyone knows you are looking"},{"text":"When you swallow, you make a movement","w":0.32269317626953131,"x":0.07311092027481006,"h":0.016560366883569877,"y":0.72979672518723671},{"h":0.013235643347915382,"w":0.31777776718139655,"x":0.073333337113005506,"y":0.74693877563770295,"text":"as if something is going down your throat."},{"y":0.76000000034392889,"w":0.39111110687255862,"h":0.013255813754334711,"x":0.048888895897053926,"text":"6 When you whisper, you speak clearly and loudly."},{"text":"7 When you grip something, you hold it lightly.","y":0.77469387752679564,"x":0.0488888929177606,"w":0.36888889312744139,"h":0.01309682028634207},{"x":0.048888889108914695,"w":0.01111111044883728,"h":0.0087209296713069984,"text":"8","y":0.79069767455388129},{"x":0.062222220757071227,"h":0.011836734693877471,"text":"Yelling involves speaking quietly and calmly","w":0.34222221374511719,"y":0.79061224490701165},{"x":0.048888894719276196,"w":0.3711111068725586,"h":0.013186995837153215,"text":"9 A wink is when you close one eye and open it","y":0.80367346934032546},{"text":"again quickly.","w":0.1066666603088379,"x":0.073333338290025446,"y":0.81959183679806102,"h":0.011836734693877471},{"w":0.3888888931274414,"y":0.832653061242276,"h":0.01346938775510198,"x":0.048888891630723637,"text":"10 You giggle when you are sad and things are not"},{"h":0.015236178028340319,"y":0.84694258431000813,"w":0.083872089385986337,"text":"going well.","x":0.074721973859914748},{"y":0.86191860483743898,"x":0.051111125663047867,"h":0.011627906487912565,"text":"11 You flinch when you think someone or something","w":0.39555553436279295},{"h":0.012822868191466053,"y":0.87585600771344174,"x":0.075410000755741113,"w":0.10695777893066405,"text":"might hit you."},{"y":0.88938775530100334,"w":0.39111110687255857,"x":0.051111118119276142,"h":0.013228523877202303,"text":"12 You might gasp if you hear some shocking news."},{"y":0.65552325545134615,"text":"O","w":0.024444444179534897,"h":0.017441860899633288,"x":0.45333333337319554},{"y":0.96075581426019663,"h":0.011627906487912565,"w":0.037777776718139644,"text":"149","x":0.9288888891488668}]
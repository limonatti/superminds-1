4418822443076},{"x":0.070953447574719983,"h":0.013216990690964936,"text":"* Complete the dialogues with always and the","y":0.55073649758122967,"w":0.37472282409667967},{"x":0.068666513480881194,"w":0.29509834289550779,"y":0.56477138016860307,"h":0.012320276953389775,"text":"correct form of the verbs in the box."},{"h":0.013176550061339776,"text":"hang play put talk","y":0.59156976725106125,"x":0.08869179152504536,"w":0.19733924865722657},{"x":0.28603104454858952,"y":0.59447674415574625,"h":0.0087209301962594132,"w":0.053215074539184559,"text":"tease"},{"y":0.61337209328034548,"x":0.095343682426674792,"w":0.042128601074218758,"h":0.010174418042022237,"text":"Dad:"},{"text":"Why can't you two just get on with","w":0.26164079666137696,"x":0.17516629468483266,"y":0.61333878881608228,"h":0.013114699365269322},{"h":0.010399535908051316,"w":0.090967397689819346,"text":"each other?","y":0.62779441792593438,"x":0.17513714494763336},{"w":0.33301574707031245,"x":0.095129654430182495,"y":0.64077476313200943,"h":0.015224136814548261,"text":"Melanie: Because he's always teasing me."},{"text":"Why can't he just leave me alone?","x":0.17516629968814995,"w":0.25942350387573243,"y":0.65548281538373965,"h":0.013121835533803861},{"x":0.070873736465440443,"y":0.67708247259951759,"w":0.071112837791442882,"h":0.010660635469002755,"text":"1 Alice:"},{"y":0.67716857574152844,"w":0.29711750030517575,"text":"Well, it's good to be studious, but Luke","x":0.17516630040173603,"h":0.01323840075741034},{"y":0.69312602279236435,"x":0.31929046417608276,"h":0.0090016366612111209,"w":0.14190687179565431,"text":"about schoolwork."},{"x":0.17294900579450714,"h":0.011865793780687417,"w":0.28159645080566409,"text":"I don't think he has a social life at all.","y":0.70621931254599757},{"text":"Max:","y":0.72238372089024239,"x":0.097560975966577632,"w":0.039911308288574213,"h":0.0087209301962595243},{"y":0.72093023256719491,"h":0.013112320642424513,"text":"Yes, I can see how annoying he is.","w":0.2572062110900879,"x":0.17516629900041053},{"text":"2 Amber:","x":0.070926780793832259,"y":0.74263479388482478,"w":0.08652781486511231,"h":0.010369947030774429},{"text":"Erin:","y":0.75726744195659479,"x":0.095343681066355893,"w":0.039911308288574213,"h":0.01162790666820579},{"text":"Why did you split up with Richard then, Erin?","h":0.013178928784184696,"x":0.16851441553976743,"w":0.33259422302246089,"y":0.74263502489498678},{"y":0.75726744216008324,"text":"Oh, he and his friends","x":0.17738359366234491,"w":0.16629711151123044,"h":0.011627906668205679},{"w":0.30376939773559569,"x":0.17516630397773042,"y":0.77168576090226848,"h":0.011865793780687417,"text":"computer games or talking about them."},{"text":"I hardly ever saw him, and when I did, the","x":0.17294899788783183,"y":0.78633720949293207,"h":0.011627906668205679,"w":0.31929046630859381},{"y":0.80073649746341335,"text":"conversation was boring.","h":0.011865793780687306,"x":0.17516629880048332,"w":0.18847005844116207},{"h":0.010174418042022126,"text":"3","x":0.070953436812268858,"y":0.82122093064105284,"w":0.011086474657058726},{"text":"Paul:","h":0.010336090812121168,"x":0.082005454337953379,"y":0.82114009420419298,"w":0.055501284599304188},{"y":0.82119476262983071,"w":0.17960088729858401,"h":0.011654074570551232,"text":"I'll do it tomorrow, OK?","x":0.17516629822986537},{"h":0.013262188766279714,"y":0.83575581419873557,"w":0.18181818008422851,"x":0.097560977068011354,"text":"Gemma: Oh, Paul. You"},{"text":"things off","w":0.075432519912719709,"x":0.42791566914619117,"h":0.0131914354190108,"y":0.83570079408183762},{"h":0.010367106688978667,"w":0.32150775909423823,"x":0.17516630185531981,"y":0.85174418627332027,"text":"until tomorrow, or next week, or whatever."},{"y":0.86482558158609013,"w":0.32815963745117183,"h":0.013243158203100069,"x":0.1751663006203121,"text":"Why don't you just get it out of the way now?"},{"text":"4 Butcher: Why","y":0.88662790716735063,"x":0.068736141042305937,"w":0.14190687179565431,"h":0.01
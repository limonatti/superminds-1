[{"w":0.068888888359069825,"text":"7.8","x":0.057777777846106118,"y":0.049418604770669949,"h":0.034883720422881903},{"h":0.020933346031537958,"y":0.025870536451671478,"text":"WRITING","x":0.18657827760894452,"w":0.15573233604431147},{"h":0.010887657894807723,"y":0.069410822169809538,"text":"A narrative","w":0.09129148483276367,"x":0.18657648094564594},{"text":"1","x":0.04444444453201548,"h":0.0072674416249094431,"y":0.13808139534549102,"w":0.0066666662693023668},{"x":0.042222222841808731,"y":0.29069767443357386,"w":0.013333332538604734,"h":0.0087209301057205035,"text":"2"},{"x":0.042222222442248027,"w":0.01111111044883728,"y":0.32848837193250946,"text":"3","h":0.010174418586531453},{"text":"Decide where these features go in a narrative. Write","y":0.13643790885956575,"w":0.4133333206176758,"x":0.068888896080050971,"h":0.013271393339618465},{"x":0.068888900663384198,"w":0.43333332061767577,"text":"B for the beginning, M for the middle or E for the end.","y":0.15114379079531415,"h":0.011846405228758239},{"w":0.29999998092651364,"text":"Use a variety of verbs to report speech.","h":0.013176394443885964,"y":0.16860465147693016,"x":0.095555570092298578},{"w":0.013333332538604734,"x":0.066666666841808747,"text":"1","h":0.010174418586531453,"y":0.18313953496545521},{"x":0.084444450415572414,"w":0.23111110687255859,"h":0.010307417585958767,"y":0.18300653586912863,"text":"Write about a lesson learned."},{"text":"2","x":0.068888889108914692,"y":0.19767441844413736,"w":0.01111111044883728,"h":0.010174418586531453},{"h":0.014771207485323679,"text":"Use a dramatic opening sentence.","x":0.09527381613219553,"y":0.19756922527397269,"w":0.26052234649658201},{"h":0.0087209301057205035,"w":0.01111111044883728,"x":0.068888889358914684,"text":"3","y":0.21220930231632584},{"text":"Use narrative tenses to describe the áction.","x":0.095555557214056994,"y":0.2107558140253798,"h":0.013100395015641753,"w":0.32888889312744135},{"text":"4","w":0.01111111044883728,"h":0.0087209301057205035,"y":0.2267441860372561,"x":0.068888889358914684},{"x":0.093333337843539713,"text":"Write about a twist.","h":0.01021241830065367,"w":0.14888888359069824,"y":0.22671568644659768},{"text":"5","w":0.01111111044883728,"x":0.068888889358914684,"h":0.0087209301057205035,"y":0.24127906975818625},{"w":0.28888887405395502,"x":0.086666669269318958,"h":0.011627906288196765,"text":"Use shorter sentences to add drama.","y":0.24127907011171557},{"h":0.0087209301057205035,"text":"6","w":0.01111111044883728,"x":0.068888889358914684,"y":0.25581395347911651},{"text":"Give characters a voice with direct speech.","x":0.093193958504830754,"w":0.32696735382080078,"h":0.013694476457982274,"y":0.25413475345929226},{"text":"7 Say where and when the story takes place.","x":0.066666674637794576,"h":0.013185894567202872,"w":0.35111110687255864,"y":0.26879084935315378},{"h":0.013223894281325088,"text":"Read the story quickly. How would you describe","x":0.06666667293788002,"y":0.29069767468429442,"w":0.38666664123535155},{"h":0.010259917748519753,"x":0.066666667666666637,"w":0.080000000000000002,"y":0.30514705889576343,"text":"the tone?"},{"y":0.32994186080939003,"text":"Read the story and match the underlined sentences to","w":0.43555553436279298,"x":0.064444447781566716,"h":0.011627906288196765},{"x":0.066666682457492285,"y":0.34302325573231718,"text":"features 1-7 in Exercise 1. Write the numbers in the","w":0.41555553436279297,"h":0.011627907067342402},{"h":0.013678542928758031,"x":0.066405719626672952,"text":"boxes next to each sentence.","w":0.2383107757568359,"y":0.3570743886596256},{"x":0.064444449111110982,"y":0.40261627905110942,"h":0.016092871528824992,"text":"Jake looked at the screen in shock and rubbed his eyes. 2","w":0.40000000000000002},{"x":0.066666683448990793,"text":"\"lt was late and he was in his room, playing his favourite","w":0.40666664123535157,"h":0.011846405228758239,"y":0.42279411746208162},{"h":0.014534883249818886,"text":"football game. He really shouldn't have been doing that","x":0.066666669658501404,"y":0.43459302345503237,"w":0.40888889312744137},{"text":"- he needed to be up early the next day to attend a lecture.","y":0.45203488406520398,"h":0.011627906288196765,"w":0.40888889312744137,"x":0.066666671362204999},{"y":0.46351333824779406,"w":0.30937715530395504,"h":0.015285169377046492,"text":"'Never mind,' thought Jake, and kept playing.","x":0.066435746142551863},{"x":0.06666667918821606,"w":0.40444442749023435,"text":"He had just scored a goal when the game suddenly stopped.","y":0.48401162777446827,"h":0.011627907067342513},{"h":0.013119394483129931,"y":0.49709302353119378,"x":0.066666683448990793,"w":0.40666664123535157,"text":"•What was worse, the screen had gone black. 'Well,"},{"text":"that's annoying,' sighed Jake. He hoped the computer wasn't","y":0.51074056175338844,"h":0.014470120660619812,"x":0.066534366366127848,"w":0.40913906097412106},{"text":"broken. Not being very good with technology, he wasn't","w":0.40666664123535157,"x":0.066666678604546489,"h":0.013100395015641753,"y":0.52614379095897845},{"y":0.53827616959590741,"x":0.066472552838491197,"w":0.4070643997192383,"text":"sure what to do. As it was nearly 2 a.m., he decided to go to","h":0.016078804053512252},{"h":0.011846405228758128,"text":"bed. 'Tll deal with it in the morning,' he thought. He put on","y":0.55514705889591021,"w":0.40666664123535157,"x":0.066666684465657433},{"h":0.011627907067342513,"text":"his pyjamas and turned off the light. But, closing his eyes,","y":0.56976744181516581,"x":0.066666684465657433,"w":0.40666664123535157},{"h":0.010326417443019875,"text":"he heard something. Voices? Jake was terrified! He was","x":0.064444437214057182,"y":0.58415032678847267,"w":0.40888889312744142},{"text":"sure someone was in his room!","x":0.064444441911490097,"y":0.59883720946264374,"w":0.21555555343627933,"h":0.0087209301057205035},{"x":0.066505427939038242,"text":"Now the voices were louder! d'Wake him up!' someone","w":0.40700695037841794,"h":0.015426118389453736,"y":0.61314126203111574},{"y":0.63081395335586354,"h":0.011627907067342513,"w":0.051111111640930171,"x":0.06222222246842378,"text":"yelled."},{"y":0.62936046543041846,"h":0.013204894034691161,"w":0.33111110687255862,"x":0.14222221882298014,"text":"\"Throw water on him,' giggled another. 'What"},{"x":0.064444447436279195,"y":0.64379085001723158,"text":"the ...?' gasped Jake. He turned on the light and ... froze!","w":0.40888889312744142,"h":0.013185893788057235},{"text":"Standing in the room were the players from the game. 'What","w":0.40666664123535157,"y":0.6584302330660774,"x":0.066666683419361134,"h":0.013138394729763858},{"x":0.064444447999999918,"y":0.67279411768388542,"w":0.27999999999999997,"text":"... what's happening?' Jake whispered","h":0.013252393872130064},{"x":0.34831207559702176,"y":0.67118061187026867,"h":0.015129457112231237,"w":0.12560286521911623,"text":"\"There's nothing"},{"w":0.4044444274902344,"text":"wrong with your computer. Just restart it!' said one of them.","x":0.066666680199327144,"h":0.011627907067342513,"y":0.68749999995470079},{"text":"'We want to play!'","y":0.70203488356661947,"x":0.066666671428914345,"h":0.011627907067342624,"w":0.12666666030883789},{"text":"Was he dreaming? Was he going crazy? 'Um ... sure, just","y":0.71936274477247242,"h":0.01319539469051989,"x":0.066666685419361049,"w":0.40666664123535157},{"w":0.40888889312744142,"text":"a second,' replied Jake. He restarted the computer and","x":0.064444447436279195,"y":0.7340116277890032,"h":0.011627907067342513},{"y":0.74836601309897699,"h":0.011846405228758239,"text":"loaded the game. 'OK, it's ready,' he said, looking up from","x":0.064444447436279195,"w":0.40888889312744142},{"h":0.011637406801086603,"x":0.064444461226768585,"w":0.40666664123535157,"y":0.7630718955407243,"text":"the keyboard. But they were gone! ®And there, on the screen,"},{"w":0.41111110687255853,"y":0.77450980365296695,"text":"were the players! *I really need to stop gaming at night?","h":0.016339869281045694,"x":0.062222222763720685},{"y":0.79207516331700756,"w":0.25111110687255861,"text":"Jake said to himself and went to bed.","h":0.010250418014775664,"x":0.064444449702609499},{"x":0.097777777907929964,"y":0.8938953488370136,"h":0.018895348692251956,"w":0.071111111640930175,"text":"03:10"},{"text":"110","x":0.037777778303204029,"y":0.95930232566312945,"h":0.010174418586531453,"w":0.039999997615814215},{"y":0.042075163634199497,"text":"4 Choose the correct option.","h":0.013157394197252148,"w":0.23999999999999999,"x":0.53333333633333324},{"text":"Lionel got \/(was getting into bed when a weird noise","y":0.060866013416022269,"x":0.58444444944444429,"w":0.40000000000000002,"h":0.013261893216301446},{"y":0.074937217500569808,"x":0.58428189617437742,"text":"stopped him.","w":0.10254732131958,"h":0.012916262632881148},{"x":0.58000000920530426,"y":0.090116279462490789,"h":0.011627906288196765,"w":0.33777774810791017,"text":"Jackie took out her keys and unlocked \/ was"},{"text":"unlocking the front door.","x":0.58444444806780327,"y":0.10319767449049611,"w":0.18666666030883783,"h":0.013223894281324977},{"x":0.55777778998308203,"y":0.11918604704970004,"text":"2 It was strange. He never came across \/ had never","w":0.39777774810791022,"h":0.011627906288196876},{"x":0.5844444563433927,"h":0.013157394197252037,"text":"come across anything like it before.","y":0.13226744217460462,"w":0.26888887405395512},{"x":0.55777778247331611,"w":0.40888889312744137,"y":0.14665032694214719,"h":0.013233393625496248,"text":"3 He read the note again, but it didn't make \/ hadn't"},{"h":0.010174418586531453,"text":"made any sense.","y":0.16279069766530985,"x":0.58444444920669214,"w":0.12666666030883789},{"x":0.55777779029932717,"y":0.17587209326956588,"h":0.013261893995447083,"w":0.40444442749023435,"text":"4 They looked \/ were looking for someone, but they"},{"y":0.19035947725102065,"x":0.58222222455555539,"w":0.14000000000000001,"h":0.011846405228758239,"text":"wouldn't say who."},{"text":"5","w":0.01111111044883728,"x":0.55777777799780348,"y":0.20494186044132578,"h":0.0087209301057205035},{"h":0.013195393911374032,"w":0.41111110687255858,"text":"Max wasn't working \/ hadn't been working there long","y":0.20494186073080622,"x":0.57111110637853568},{"w":0.24222221374511721,"x":0.58222222515521915,"y":0.21802325562330549,"h":0.011627907067342513,"text":"when he found a little red book."},{"text":"6","x":0.55777777819224794,"w":0.01111111044883728,"y":0.23401162807940712,"h":0.0087209301057205035},{"x":0.57555557471565733,"y":0.23243464061347419,"w":0.38666664123535155,"h":0.011846405228758128,"text":"She said that she can't\/ couldn't remember where"},{"y":0.24709302332770533,"w":0.16888887405395514,"text":"she'd bought the ring.","x":0.5822222277137632,"h":0.013119395262275679},{"y":0.26162790691312954,"h":0.010174418586531564,"w":0.013333332538604803,"x":0.55555555617514196,"text":"7"},{"x":0.57111111091338462,"text":"He began yelling and said he will \/ would never go","y":0.26143790867182348,"w":0.39333332061767579,"h":0.013271393339618465},{"text":"back there again.","x":0.58222222547834601,"y":0.27614379079531415,"h":0.011846405228758128,"w":0.13333333015441895},{"x":0.53111110987744159,"y":0.29651162803337394,"h":0.01312889460644695,"w":0.44222221374511717,"text":"5 Complete the sentences with the correct form of the"},{"text":"verb in brackets.","h":0.01021241830065367,"x":0.55555555838167092,"y":0.3125000000332846,"w":0.13777777671813962},{"h":0.015091733994826884,"y":0.32809558174387488,"w":0.39369541168212896,"text":"She wondered where she had seen (see) the strange","x":0.58202939605668358},{"text":"blue liquid before.","w":0.1466666603088379,"x":0.57777778279002545,"y":0.34302325604950912,"h":0.014534883249818886},{"y":0.35901162791225605,"text":"The sun","x":0.58222222282222225,"h":0.0087209301057203925,"w":0.059999999999999942},{"y":0.359011627988711,"text":"(shine) and the birds","x":0.82888888848964681,"h":0.010269417871836772,"w":0.15111110687255858},{"text":"were singing, but Lucy felt no happiness that day.","y":0.37336601271560721,"h":0.013261893995447083,"w":0.37333332061767588,"x":0.58222223480227309},{"x":0.55555557339048933,"y":0.38643790813492607,"h":0.01327139411876388,"w":0.39777774810791011,"text":"2 First, they shook the box and then, curious about"},{"h":0.01037391689088607,"x":0.58222222598038742,"text":"its contents,they","y":0.40261627902432151,"w":0.13111110687255856},{"h":0.011627906288196876,"y":0.40261627922024268,"w":0.06666666507720953,"x":0.89555555531324726,"text":"(open) it."},{"w":0.10666666030883787,"h":0.010364417157141981,"y":0.41569767438405991,"x":0.55555555980113669,"text":"3 The adults"},{"text":"(not watch) as one","x":0.84888889181167937,"w":0.13333333015441895,"y":0.41707516332790862,"h":0.010250418014775775},{"w":0.33555553436279295,"h":0.011846405228758128,"text":"boy, and then another, walked into the cave.","x":0.58222223841119591,"y":0.43014705893224736},{"x":0.55551785198054626,"text":"4 They","y":0.44467766650867913,"h":0.011807458073485155,"w":0.06451985359191903},{"w":0.15777777671813964,"x":0.80444444694648554,"y":0.4447674418513563,"h":0.010297917462641859,"text":"(walk) for miles when"},{"h":0.011846405228758128,"w":0.25111110687255855,"text":"they saw a house in the distance.","x":0.58000000525816509,"y":0.45915032667960776},{"h":0.013242893748813156,"y":0.47222222202231867,"text":"5 After typing in his question, an answer","w":0.31777776718139639,"x":0.55555555563152414},{"text":"(appear) on the screen,","y":0.48837209353119371,"x":0.76222223040930159,"w":0.17777776718139648,"h":0.013261893216301446},{"h":0.010174418586531453,"text":"'Get out!'","x":0.58000000231889737,"w":0.075555553436279399,"y":0.50145348826002878},{"x":0.55555555577558136,"w":0.01111111044883728,"text":"6","y":0.51598837193250946,"h":0.010174418586531564},{"h":0.010335917566336783,"w":0.19333332061767583,"text":"(it\/hide) behind the door?","y":0.51744186040150175,"x":0.76444445273560646},{"x":0.58222222538888868,"text":"He couldn't be sure, but he was too scared to look.","y":0.53052325572020465,"h":0.011627907067342513,"w":0.38},{"text":"7 The creature was terrifying, but Jo stayed calm and","w":0.40888889312744137,"h":0.01320489403469105,"x":0.55555555684368674,"y":0.54493464047432838},{"w":0.028888888359069886,"y":0.55959302313769366,"h":0.010174418586531453,"text":"she","x":0.58000000012602071},{"x":0.79532419893102935,"h":0.011965412719576962,"text":"(not panic).","w":0.084907159805297949,"y":0.56015101457473981},{"y":0.573937908554633,"x":0.55555555788010325,"w":0.064444441795349139,"text":"8 They","h":0.011846405228758128},{"x":0.804444448059638,"h":0.011637406801086603,"y":0.57557189537401954,"text":"(not see) such a strange","w":0.17555555343627927},{"text":"object before and decided to examine it.","h":0.01021241830065367,"y":0.58864379083150453,"w":0.31111110687255861,"x":0.58000000600816504},{"y":0.60901162825125044,"w":0.2422222137451171,"x":0.5288888971644784,"h":0.011627906288196765,"text":"6 Choose the correct option."},{"x":0.58000000135782903,"h":0.014534883249818886,"text":"William (gasped\/ snapped when a ghostly face","w":0.35333332061767575,"y":0.62645348836540071},{"y":0.64244186041967022,"text":"appeared at the window.","w":0.1888888931274415,"h":0.010335917176764076,"x":0.58000000024183473},{"w":0.40444442749023435,"y":0.65552325632189135,"h":0.013185893788057235,"text":"1 She yelled \/ whispered because she didn't want to","x":0.5555555626252533},{"text":"2 They screamed \/ giggled in terror and ran out of","x":0.55555556846893961,"w":0.39333332061767579,"h":0.013119395262275679,"y":0.6845930234246046},{"text":"the house.","y":0.69893790839702485,"w":0.07999999999999996,"x":0.58000000099999993,"h":0.010364417157141981},{"text":"3 He was yelling \/ sighing my name, but | didn't hear","y":0.71364379095897845,"x":0.55555555610294594,"w":0.40888889312744137,"h":0.013100395015641753},{"text":"a thing.","x":0.5777777787777777,"y":0.72819767471442876,"w":0.060000000000000053,"h":0.011627906288196876},{"h":0.011846405228758239,"y":0.74264705888379778,"w":0.39999999999999991,"x":0.55555556222222213,"text":"4 She was giggling \/ sobbing, so it was obvious she"},{"x":0.57777777895166238,"text":"was very sad.","y":0.75726744179685057,"h":0.010297917852214789,"w":0.10222222328186037},{"w":0.40024932861328122,"x":0.55543237049118832,"y":0.77002700961379145,"text":"5 He snapped \/ sighed at the children because they","h":0.013455130695517625},{"text":"refused to keep quiet.","y":0.78472222225836363,"h":0.011846405228758239,"x":0.57777777776961259,"w":0.16888889312744138},{"w":0.38666664123535166,"x":0.55333335019713881,"text":"6 I screamed \/ sighed in relief when they returned","h":0.013081394769007937,"y":0.79941860515910068},{"w":0.16222221374511714,"text":"home and were safe.","x":0.58000000694225606,"y":0.81395348840537762,"h":0.010174418586531453},{"h":0.013138394729763858,"text":"7 We could hear them giggling \/ snapping as they","x":0.5533333305637208,"y":0.82843137244035059,"w":0.39111110687255868},{"w":0.24444442749023443,"y":0.84150326767192696,"text":"looked at the funny old photos.","x":0.57555555995858665,"h":0.013147894853080877}]
245536925944879},{"h":0.011865793780687417,"x":0.6319290567061373,"text":", we managed to get the tent up quickly","w":0.31042127609252923,"y":0.53191489359579569},{"x":0.51884701618630691,"y":0.54500818331505319,"h":0.011865793780687417,"text":"and began the long process of drying out. Or so","w":0.37028823852539061},{"x":0.49223946812162639,"text":"5","w":0.013303768634796154,"h":0.010174418042022126,"y":0.7122093024797157},{"h":0.011654074180340812,"text":"we woke up the next morning, we","x":0.62971175095276433,"y":0.57119476268089386,"w":0.26385808944702149},{"text":"discovered that the tent had 6","y":0.58428805235002201,"h":0.010229132569558042,"w":0.2283813667297363,"x":0.52106430543887938},{"y":0.59883720938392038,"w":0.41463413238525393,"h":0.011637422340005976,"text":"the night and all our things, including our clothes were","x":0.52106431371313788},{"x":0.51884700124005589,"w":0.39911308288574221,"text":"still wet through. There was nothing we could do, so","y":0.61191860487810645,"h":0.011649316734651083},{"h":0.016221085468797969,"y":0.62214371163675475,"x":0.51869964356858145,"w":0.42602119445800779,"text":"we pulled on wet jumpers, jeans and shoes and headed"},{"text":"for the theme park. Funnily'","y":0.63788870689262211,"h":0.013274083941345771,"x":0.51884700769829939,"w":0.22172948837280271},{"text":"that the fastest and most exciting way to get dry is to","w":0.4057649612426758,"x":0.51884700263808581,"h":0.01162790666820579,"y":0.65261627927248622},{"y":0.66569767451473438,"x":0.51884701561740765,"w":0.41019954681396487,"text":"ride a rollercoaster with 14 loops at 50 miles per hour.","h":0.011627906668205679},{"h":0.011627906668205679,"text":"a doubt, that weekend was one of the","y":0.67877907001861038,"w":0.29046562194824221,"x":0.63414634161272299},{"h":0.010362348853078518,"text":"wettest and funniest l've ever had.","y":0.69312602294046155,"x":0.51884701287479773,"w":0.26607538223266602},{"h":0.011865793780687417,"text":"Read the anecdote in Exercise 3 again and put the","x":0.5188470133878923,"y":0.7135842882428638,"w":0.40354766845703127},{"text":"following parts in order.","x":0.51662970704203603,"y":0.72529069753812514,"w":0.19512195587158199,"h":0.013252673874900256},{"x":0.51884701373150266,"text":"A What happened step by step","w":0.24833702087402343,"h":0.013178928784184585,"y":0.74263502462245767},{"y":0.75726744197839713,"h":0.011627906668205679,"w":0.32815963745117194,"x":0.54323725854714122,"text":"Where and when the anecdote took place,"},{"y":0.76882160400041066,"h":0.013155139994894371,"w":0.26164079666137696,"x":0.54545454762274825,"text":"and other background information"},{"x":0.51884701118000753,"y":0.78343023280338675,"text":"C What the anecdote is going to be about and","w":0.36585365295410155,"h":0.013214611968120127},{"text":"background information","w":0.18403547286987298,"y":0.7950081834328695,"x":0.54545454793313441,"h":0.013131351205604158},{"x":0.51884701617193218,"y":0.80959302321036342,"w":0.27050996780395509,"text":"D Why the day was so memorable","h":0.01323840075741034},{"x":0.5188470126464978,"y":0.82405891980352353,"h":0.011865793780687417,"w":0.2461197280883789,"text":"E Who was involved in the day"}]
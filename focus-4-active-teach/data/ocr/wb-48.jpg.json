[{"x":0.06222222272222222,"w":0.079999999999999988,"text":"3.8","y":0.052325581748361993,"h":0.033430231833944557},{"w":0.1558781147003174,"text":"WRITING","h":0.020058841316067499,"y":0.025581044377256168,"x":0.18872761042627431},{"w":0.20070734024047854,"x":0.18857518869063966,"text":"A 'for and against' essay","h":0.015574983869280024,"y":0.065956283730483234},{"w":0.45999999999999996,"text":"1 Read the model essay and tick the four topics that are","x":0.044444450194444339,"y":0.13510204112391822,"h":0.013153772938008235},{"h":0.010174418079609726,"y":0.15116279091659046,"text":"mentioned.","x":0.071111113633901615,"w":0.093333330154418956},{"h":0.013114618573869974,"y":0.16857142823151583,"text":"1 public transport","w":0.1466666603088379,"x":0.071111115312247702},{"text":"2 crime rates","x":0.071111114619276203,"h":0.010329852590755473,"y":0.18313953509173586,"w":0.11111110687255861},{"x":0.071111111525581361,"y":0.19767441899428839,"w":0.01111111044883728,"h":0.0087209296713069984,"text":"3"},{"x":0.095509171593497477,"w":0.093426103591918941,"y":0.19751400102901595,"text":"air pollution","h":0.011948741990692735},{"text":"employment and income","y":0.21220930276379568,"w":0.19333332061767577,"x":0.09333333839486585,"h":0.011627906487912565},{"y":0.22529069776736566,"x":0.071111111331136914,"h":0.010174418079609726,"w":0.01111111044883728,"text":"5"},{"x":0.071111111553359141,"h":0.0087209296713069984,"w":0.01111111044883728,"text":"6","y":0.23982558161783485},{"text":"cultural and social life","y":0.2252906981126328,"x":0.095555555162584085,"w":0.1644444465637207,"h":0.011627906487912565},{"y":0.23982558120818021,"h":0.013235643347915271,"text":"affordable housing","w":0.14444443702697757,"x":0.095555561671696335},{"text":"social isolation","x":0.095555558070938643,"y":0.2542857142700321,"w":0.11333333015441895,"h":0.010249169018803794},{"text":"8","y":0.26889534900882328,"x":0.068888889175142076,"w":0.013333332538604747,"h":0.0087209296713068873},{"text":"traffic problems","h":0.011627906487912565,"x":0.095555561831145039,"w":0.1222222137451172,"y":0.26889534903317547},{"y":0.32122093047697398,"text":"Since the industrial revolution began in the late 18th","x":0.060000012913384103,"w":0.39333332061767579,"h":0.011627906487912565},{"w":0.42444442749023442,"x":0.060000013782660455,"y":0.3357558141252297,"h":0.011627906487912565,"text":"century the number of city dwellers has grown and rural"},{"text":"populations have shrunk. Although this suggests that","x":0.060000009266330173,"y":0.34883720947406704,"h":0.011627906487912565,"w":0.40222221374511724},{"y":0.36191860483743898,"text":"life in the city may be superior in some ways, there are","h":0.011627906487912565,"x":0.057777792529714558,"w":0.41555553436279297},{"h":0.011627906487912565,"text":"definitely pros and cons to metropolitan living.","x":0.06000000369553838,"y":0.37500000024441582,"w":0.34888889312744142},{"text":"Perhaps the strongest argument for living in cities is","h":0.015451963775012012,"x":0.059817663446508365,"y":0.39955683211973014,"w":0.39149269104003909},{"y":0.41551020389522875,"w":0.4222222137451172,"h":0.011836734693877471,"text":"that there are greater employment opportunities than in","x":0.057777784386700615},{"h":0.010174418079609726,"y":0.42877907010263705,"w":0.11333333015441895,"x":0.057777778233901636,"text":"the country. 'E"},{"text":"_, salaries tend to be higher,","w":0.2155555534362793,"x":0.26000000102260101,"h":0.011629093325867923,"y":0.42877906981805924},{"h":0.011627906487912565,"w":0.41777774810791019,"x":0.057777792834933804,"y":0.44186046516689648,"text":"meaning that city dwellers often have more disposable"},{"y":0.45483335378522494,"w":0.097837924957275391,"h":0.011844920722805741,"x":0.057747704485329281,"text":"income. A 2f"},{"text":"benefit of city living is the","y":0.45390762635681936,"x":0.24853707510562081,"w":0.19632629394531251,"h":0.015220470817721599},{"x":0.05777779597491662,"w":0.38666664123535155,"h":0.011836734693877582,"text":"numerous ways in which this income can be spent","y":0.46938775513289532},{"x":0.057777798909007673,"h":0.011836734693877693,"text":"to enrich people's lives. For those who manage to","w":0.37777774810791015,"y":0.48244897944381027},{"x":0.05777778603855243,"w":0.40222221374511713,"h":0.011836734693877471,"text":"achieve a healthy work-life balance, cities can provide","y":0.4955102039872834},{"text":"a comparatively well-paid job which allows them to","w":0.38444442749023439,"x":0.057777784810438389,"y":0.50857142840478742,"h":0.011836734693877582},{"w":0.36888889312744144,"y":0.52163265295795047,"h":0.011836734693877471,"x":0.057777773584427553,"text":"enjoy a variety of cultural and social experiences."},{"h":0.013259373878946046,"y":0.54796511617668797,"w":0.14444444656372071,"text":"One of the most 3p","x":0.059999997736658185},{"y":0.5508720933402822,"x":0.30222222412540023,"h":0.010352396283831,"text":"arguments against","w":0.14444443702697751},{"h":0.01022543887702787,"y":0.56244897955594564,"x":0.05777778591010211,"w":0.36666664123535153,"text":"urban life is, ironically, the sense of isolation that"},{"y":0.57551020400016073,"w":0.35333332061767581,"x":0.055555567802273061,"h":0.011836734693877471,"text":"living together with so many others can cause."},{"y":0.58728947649947394,"text":"Rural communities frequently enjoy a strong sense","w":0.38479778289794925,"h":0.01497174788494493,"x":0.057594867575597952},{"y":0.60319767462661955,"h":0.01027171310113395,"w":0.37555553436279299,"text":"of togetherness, but urbanites often feel a lack of","x":0.057777793068603388},{"y":0.61627907020565609,"w":0.35777774810791019,"text":"connection with others. It is impossible to form","h":0.011627906487912565,"x":0.057777794723822599},{"w":0.36222221374511715,"h":0.011627906487912565,"text":"a relationship with all the people in a big city, so","y":0.62936046531224521,"x":0.057777788053367127},{"y":0.64389534897860601,"h":0.010174418079609726,"w":0.38666664123535155,"x":0.057777796937879558,"text":"a common solution is to ignore the vast majority of"},{"x":0.055555568588216031,"text":"them. This may also be related to another of the","y":0.65551020391856141,"w":0.36444442749023437,"h":0.011836734693877471},{"text":"of city life, namely high crime rates.","x":0.17555556646893972,"y":0.66857142890343624,"h":0.013114617795360384,"w":0.27333332061767585},{"x":0.46444444499560716,"y":0.68168604623973617,"h":0.014534884083027833,"w":0.022222220897674561,"text":"5"},{"text":"All things 5c","h":0.013154960165218332,"x":0.055555555589457233,"y":0.69469387727970222,"w":0.093333330154418942},{"h":0.011627906487912454,"y":0.69622093041883448,"w":0.2111111068725586,"text":", despite the fact that cities","x":0.24000000423038734},{"text":"can be lonely and dangerous places to live, I feel the","w":0.395555534362793,"x":0.055555569374158974,"y":0.70930232558196893,"h":0.013146654245804745},{"y":0.72238372110197391,"text":"benefits outweigh the drawbacks. 6p","x":0.055555559055555509,"h":0.011627906487912565,"w":0.28000000000000003},{"y":0.73102040823498382,"text":"I enjoy living in the city and wouldn't want to live in the","x":0.055555566080050911,"h":0.016072614241619432,"w":0.4133333206176758},{"text":"country while I am still young","y":0.75000000031709013,"h":0.011632652671969668,"w":0.22222221374511722,"x":0.055555557016330394},{"x":0.046666667683617477,"y":0.95784883740526849,"h":0.011627906487912565,"w":0.026666665077209467,"text":"46"},{"h":0.013191742410465168,"x":0.53333333888560641,"text":"2 Match the following definitions with the underlined","y":0.042040816055531005,"w":0.43333332061767582},{"h":0.014742858263910974,"y":0.055403856035189936,"w":0.15418280601501455,"x":0.55963432934534685,"text":"words in the essay."},{"w":0.01111111044883728,"h":0.010174418079609837,"y":0.074127907166590457,"x":0.56000000051632215,"text":"1"},{"text":"2","x":0.56000000044224807,"w":0.01111111044883728,"y":0.0886627911297687
[{"x":0.0022222225084754122,"w":0.013333332538604737,"y":0.046511628042317232,"text":"8","h":0.010174418079609726},{"x":0.028888904106734472,"y":0.046511628054493381,"w":0.4044444274902344,"h":0.011627906487912454,"text":"Read the task below. Then complete gaps 1-8 with"},{"text":"the missing words. The first letters are given.","x":0.026666671166666555,"h":0.011627906487912565,"y":0.061046511835985529,"w":0.36000000000000004},{"h":0.013222591633699432,"y":0.091428571374447931,"text":"Many people feel city centres should be pedestrian","w":0.40666664123535157,"x":0.026666674298991069},{"h":0.011627906487912565,"y":0.10610465150410575,"text":"zones to improve the quality of life for people","x":0.026666673271213349,"w":0.36666664123535153},{"w":0.41555553436279302,"text":"living there. Write a 'for and against' essay. Describe","x":0.026666671744529646,"y":0.12063953493880031,"h":0.013238016245316508},{"w":0.41777774810791013,"x":0.028888900168267249,"text":"the advantages and disadvantages of having car-free","h":0.013153773716517825,"y":0.13510204061793762},{"w":0.097777776718139656,"text":"city centres.","h":0.010316800876539522,"y":0.1510204081390405,"x":0.028888891048337539},{"x":0.020000008971127876,"w":0.41111110687255858,"text":"The idea of banning cars in cities is gaining popularity.","y":0.20489795934049737,"h":0.013125296612175208},{"x":0.020000006151937023,"w":0.39555553436279295,"h":0.013176317020338502,"y":0.21947674424112584,"text":"Already, cities such as Copenhagen, Milan, Oslo and"},{"h":0.011836734693877582,"w":0.37555553436279299,"y":0.2338775508361719,"text":"Madrid either have car-free centres or are working","x":0.020000016855640367},{"text":"towards this goal. Even 't","x":0.017777780913384441,"y":0.24854651192077237,"w":0.19333332061767577,"h":0.011627906487912565},{"x":0.29111111104520226,"y":0.24854651200543176,"h":0.0087209296713069984,"text":"there are several","w":0.13111110687255861},{"w":0.4222222137451172,"h":0.011627906487912565,"x":0.020000008460774658,"y":0.2630813955060437,"text":"potential drawbacks to pedestrian city centres, there are"},{"w":0.17999999999999999,"y":0.27755102035378498,"x":0.020000002249999954,"text":"also numerous benefits.","h":0.010239677039944328},{"h":0.013166825430733775,"y":0.29061224466316937,"x":0.022222229691162082,"w":0.17333332061767578,"text":"One of the strongest 2a"},{"h":0.013356320906658614,"x":0.27773932963921477,"w":0.10896578788757322,"text":"for pedestrian","y":0.29056021119249598},{"w":0.39601024627685555,"h":0.017873664388851185,"text":"city centres is that they are far healthier and safer for","y":0.30267660375641448,"x":0.0197677605397217},{"y":0.31864245952343873,"text":"everybody - the air is cleaner, noise pollution falls and","w":0.40695968627929685,"x":0.01986069044736908,"h":0.014752989788444637},{"h":0.011836734693877582,"text":"there are fewer accidents. 3S","w":0.2155555534362793,"x":0.020000004059638046,"y":0.33265306115742543},{"x":0.30888888987445301,"h":0.013469387755102091,"text":"_, banning cars","y":0.33265306111509574,"w":0.11555555343627927},{"w":0.41111110687255864,"y":0.34883720911515692,"x":0.022222231193350091,"text":"encourages people to walk or cycle around the centre,","h":0.01320360689747091},{"x":0.020000004008165071,"y":0.36191860427019562,"w":0.41111110687255853,"h":0.01318343649105147,"text":"so they get fitter. Yet another benefit is that shops and"},{"w":0.4222222137451172,"x":0.020000007127441322,"text":"restaurants there attract more business, since it is easier","y":0.37790697718240041,"h":0.011627906487912454},{"h":0.013093260940240325,"w":0.39555553436279289,"text":"and faster for people to get around and they are not","y":0.39098837185740498,"x":0.022222236774159007},{"y":0.40552325591302041,"x":0.022222221047390373,"h":0.011627906487912565,"w":0.20888889312744141,"text":"stuck in endless traffic jams."},{"h":0.011627906487912565,"y":0.42005813963395067,"text":"4D","w":0.02444444417953491,"x":0.017777777660232551},{"y":0.41999999985197367,"w":0.24222221374511718,"h":0.011836734693877471,"text":"clear advantages, there are also","x":0.12222223049781164},{"y":0.43459302331089333,"h":0.013162078857421933,"text":"considerable disadvantages. The first drawback is that","x":0.022222219658501494,"w":0.40888889312744142},{"text":"you need to create and maintain a reliable network of","h":0.014284124569017065,"w":0.40481964111328117,"y":0.44799199647386045,"x":0.022025224776789011},{"y":0.46366279086941586,"w":0.3866666412353516,"h":0.011627906487912454,"text":"public transport that is cheap and efficient, and this","x":0.022222238160101958},{"x":0.022222218607028596,"h":0.011627906487912454,"w":0.20444444656372068,"y":0.47819767473569497,"text":"requires serious funding. 'L"},{"text":"_, building 'park","y":0.47819767480836917,"w":0.12888888359069828,"h":0.011627906487912565,"x":0.29777777827872504},{"h":0.011836734693877582,"text":"and ride'* facilities outside a city centre is costly and","x":0.022222223663384427,"w":0.39333332061767579,"y":0.49265306133337394},{"x":0.024444460560101931,"w":0.40666664123535157,"text":"only moves the traffic problem to the outskirts - which","y":0.50571428605419855,"h":0.013181062815140754},{"x":0.02434904837953809,"h":0.014254569228814629,"y":0.52024133662823724,"w":0.39131275177001951,"text":"most residents have chosen precisely to avoid traffic"},{"w":0.13999999999999999,"y":0.53469387759583642,"x":0.024444445583333304,"text":"issues. Another om","h":0.010364261549346332},{"w":0.16222221374511717,"x":0.24000000404410812,"h":0.011836734693877582,"text":"is that older people,","y":0.53469387755956299},{"h":0.011836734693877582,"text":"the disabled and families with young children might","x":0.024444451452609463,"y":0.54938775521041505,"w":0.39111110687255851},{"x":0.02444445040113653,"text":"struggle without a car.","y":0.56530612257252633,"w":0.16666666030883789,"h":0.011836734693877471},{"text":"On7b","h":0.010174418079609726,"y":0.57848837225379979,"x":0.026666666203514263,"w":0.042222223281860344},{"x":0.14000000450408251,"h":0.011836734693877471,"text":"_, there are pros and cons to having","y":0.57836734674854684,"w":0.2755555534362793},{"text":"pedestrian city centres. 8P","x":0.024108697886014985,"y":0.59195860730851491,"w":0.19619524002075195,"h":0.014274461707290298},{"h":0.011627906487912565,"text":"_,I feel that having","x":0.29111111562131753,"y":0.5930232560220321,"w":0.14888888359069824},{"h":0.014328412425761328,"w":0.3868796157836914,"x":0.024345618966863505,"text":"some car-free zones which are bike and pedestrian-","y":0.60564197093500194},{"text":"friendly are the best solution, but it is not practical or","x":0.024444437777777991,"y":0.62204081625411112,"h":0.011836734693877471,"w":0.40000000000000002},{"text":"desirable to ban cars entirely.","w":0.22039911270141602,"h":0.013796897421077814,"y":0.63468377252482611,"x":0.024263396340015186},{"x":0.024444444246717864,"text":"*'Park and ride' schemes aim to reduce urban traffic.","h":0.011836734693877582,"w":0.39333332061767579,"y":0.65551020400334814},{"text":"Drivers leave their cars in car parks on the outskirts","w":0.38,"x":0.026666667583333348,"h":0.013207166243572654,"y":0.67005813953545723},{"w":0.39111110687255862,"x":0.026666672697053997,"h":0.013184622939752089,"text":"of a town or city and travel into the centre on public","y":0.68448979575516855},{"h":0.01026733242735578,"text":"transport.","w":0.073363518714904791,"x":0.026651575197885594,"y":0.70198842673535478},{"text":"SHOW WHAT YOU'VE LEARNT","x":0.49999999906372083,"w":0.27111110687255857,"h":0.013162078857421822,"y":0.052244898213225532},{"text":"9 Read the task below. Before you start, note down","x":0.49333335372382253,"h":0.013169198328134901,"w":0.41777774810791019,"y":0.077034883339963112},{"h":0.013222591633699321,"text":"some ideas and plan your essay. Include at least one","x":0.51333335268678548,"y":0.091428571101918932,"w":0.41777774810791024},{"h":0.011627906487912565,"x":0.51333333909149848,"w":0.29111110687255859,"y":0.10755813974296236,"text":"sentence that expresses concession."},{"y":0.13021637538081499,"text":"Despite the fact that the number of city dwellers","w":0.38910003662109371,"x":0.51544758139020785,"h":0.013889761165696846},{"x":0.51333334770749228,"y":0.14530612239409146,"text":"around the world is rising, many people prefer to","w":0.395555534362793,"h":0.013124110163474478},{"h":0.011836734693877582,"x":0.51333334694604504,"text":"live in the country. Write an essay to present","w":0.35777774810791019,"y":0.16122448971814363},{"x":0.51333334234966344,"y":0.1742857143941523,"h":0.013214285714285845,"text":"arguments for and against living in the country,","w":0.38222221374511722},{"x":0.51333333758333322,"text":"including examples and your own opinion.","w":0.34000000000000008,"h":0.011627906487912454,"y":0.18895348858017169},{"h":0.011836734693877693,"text":"SHOW THAT YOU'VE CHECKED","x":0.50444444094444452,"y":0.43591836731098388,"w":0.28000000000000003},{"text":"In my 'for and against' essay:","y":0.45918367356603196,"h":0.013200047551369165,"w":0.25777776718139639,"x":0.49555555655745004},{"y":0.48244897954070964,"w":0.37333332061767588,"h":0.011836734693877471,"text":"• I have started with a general statement or with","x":0.50000000013560675},{"x":0.5200000016811025,"w":0.1644444465637207,"text":"facts about the issue.","y":0.49551020409387259,"h":0.011836734693877471},{"h":0.013220218736298306,"y":0.51453488333996311,"x":0.50222222264596017,"w":0.36222221374511709,"text":"• in the first paragraph, I have mentioned both"},{"text":"the benefits and drawbacks of the issue.","y":0.52897959194166677,"h":0.011836734693877471,"x":0.52000000554928472,"w":0.30666666030883794},{"text":"• I have described the benefits of living in the","w":0.35111110687255864,"x":0.50444445071186861,"h":0.013259373100436456,"y":0.54796511633414913},{"y":0.56244897950156736,"x":0.52000000046894002,"w":0.35333332061767575,"text":"country in one paragraph and its drawbacks in","h":0.013132416082888176},{"h":0.013169198328135012,"text":"the next paragraph.","y":0.57703488333996311,"w":0.15111110687255869,"x":0.5222222263414984},{"h":0.010204081632653073,"text":"• I have included additional comments and","y":0.59591836738557113,"x":0.50444444800816512,"w":0.33111110687255862},{"h":0.014476913140744507,"text":"examples to support both aspects of the issue.","x":0.5220954255542688,"y":0.60993847985781147,"w":0.35577072143554689},{"text":"• I have written at least one sentence which","x":0.50444444944823341,"y":0.62936046545147417,"w":0.33555553436279306,"h":0.010231371120530741},{"x":0.52201156107197089,"text":"expresses concession, using although,","w":0.29371194839477544,"h":0.015929403499681083,"y":0.64318463986724617},{"y":0.65697674454125932,"h":0.01453488252600843,"w":0.26888887405395512,"x":0.52222223382487409,"text":"even though, despite or in spite of."},{"y":0.67714285717881195,"h":0.011836734693877582,"w":0.30666666030883794,"x":0.50666667367891416,"text":"• I have included phrases which express"},{"x":0.52222222318299705,"text":"comparison, e.g. in the same way,","y":0.6918367345130837,"w":0.26222221374511712,"h":0.011836734693877582},{"text":"similarly, equally and likewise.","x":0.52222223250080002,"y":0.70639534904528789,"h":0.011627906487912565,"w":0.22888887405395508},{"x":0.50666668304899076,"y":0.72529069783162514,"h":0.011627906487912565,"w":0.36666664123535153,"text":"• in the last paragraph, I have summarised both"},{"text":"aspects of the issue and presented my opinion.","h":0.013086141469527246,"x":0.52222222286818221,"y":0.73836734684748639,"w":0.36222221374511721},{"h":0.013255814532844412,"y":0.75999999980161115,"w":0.38444442749023444,"text":"• I have not used contractions (e.g. I'm, aren't, that's).","x":0.50888889925488268},{"text":"• I have checked my spelling and punctuation.","w":0.35555553436279297,"x":0.50888890541119591,"y":0.78488372117464833,"h":0.011627906487912565},{"y":0.80653061218675837,"text":"• my handwriting is neat enough for someone","x":0.5088888945192761,"h":0.011836734693877582,"w":0.35111110687255864},{"y":0.82122093032550514,"text":"else to read.","x":0.52444444608537455,"h":0.010207640978754817,"w":0.097777776718139697},{"text":"C","y":0.48691860432470158,"h":0.013081395674724883,"w":0.017777777910232606,"x":0.91333333315599474},{"x":0.91333333347222212,"y":0.60174418604714897,"h":0.014534884083027722,"w":0.019999999999999907,"text":"C"},{"h":0.013081395674724994,"x":0.92222222273917309,"text":"47","y":0.960755813627027,"w":0.026666665077209495}]
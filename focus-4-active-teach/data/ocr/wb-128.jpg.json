[{"w":0.097777776718139642,"x":0.046666667065766776,"text":"8.8","h":0.059593020069355851,"y":0.037790699092374092},{"w":0.15586833953857424,"text":"WRITING","h":0.021390995881995445,"y":0.025641711522944144,"x":0.18428805364071629},{"x":0.18444444536409968,"w":0.16666666030883789,"text":"A letter to an editor","y":0.068163265211900859,"h":0.011836734693877471},{"text":"1","y":0.13662790706969119,"w":0.01333333253860474,"x":0.040000000249216149,"h":0.010174418079609837},{"x":0.062222217489646854,"w":0.41111110687255858,"y":0.13662790683802517,"text":"Change the underlined words and phrases to make","h":0.013168011879434394},{"x":0.064444443405219334,"y":0.15261627938679401,"w":0.4222222137451172,"h":0.010240863488644947,"text":"the introduction to a letter to an editor more formal."},{"text":"There may be more than one way to do this.","x":0.066666681707492292,"h":0.013081395674724994,"y":0.16569767423749215,"w":0.35555553436279302},{"h":0.013529703568439189,"y":0.19745026446225711,"text":"'Hi there,","w":0.064655170440673843,"x":0.053227970872817047},{"h":0.017635262936961937,"y":0.21346938744655441,"text":"ZI'm 3getting in touch after reading the article in your &paper","x":0.053333337532660716,"w":0.4044444274902344},{"w":0.42666664123535153,"text":"last Thursday about the positive effects of tourism on a country's","x":0.055555572537879704,"y":0.23102040801268897,"h":0.011836734693877471},{"y":0.24273255777680003,"x":0.055555564771213178,"h":0.014534884083027722,"w":0.42666664123535147,"text":"economy. I Swant to tell you that tourism can do terrible damage"},{"x":0.055357722353067337,"h":0.015276338226941188,"w":0.31818346023559574,"text":"to the environment and areas of natural beauty.","y":0.25667604875262628},{"text":"1","y":0.29941860482277671,"x":0.06444444469224804,"w":0.01111111044883728,"h":0.0087209296713069984},{"y":0.31250000009294698,"h":0.010174418079609726,"text":"2","w":0.013333332538604734,"x":0.064444444693660605},{"text":"3","x":0.06444444469224804,"y":0.32703488385627066,"w":0.01111111044883728,"h":0.010174418079609837},{"text":"4","y":0.34156976761347435,"x":0.06444444469224804,"w":0.01111111044883728,"h":0.0087209296713071094},{"text":"Dear Editor \/ Dear Sir or Madam","h":0.011836734693877582,"x":0.093333334718139579,"w":0.24444444656372072,"y":0.29795918386165809},{"y":0.37439285863236504,"text":"2 Match the advice on achieving a formal style to your","x":0.039712529174967912,"w":0.44496650695800782,"h":0.017651286222496787},{"w":0.20000000000000001,"x":0.064444443277777805,"y":0.39098837219209026,"h":0.011627906487912454,"text":"corrections in Exercise 1."},{"text":"Begin with a formal greeting.","x":0.091111110703703702,"y":0.40843023217717245,"h":0.013202421227279881,"w":0.21999999999999997},{"y":0.42441860488945871,"text":"1 Avoid contractions.","h":0.010275272836490545,"x":0.064444449415572438,"w":0.17111110687255859},{"h":0.013112244897959147,"text":"(e.g. can't, he's, should've, etc.)","x":0.086666672275589537,"y":0.43749999961903296,"w":0.24222221374511715},{"text":"2 Avoid informal language.","h":0.015709343735052617,"x":0.064084470856455161,"y":0.45034798955812105,"w":0.22075077056884765},{"y":0.46653061204542579,"w":0.19111110687255856,"h":0.013120550817372845,"text":"(e.g.thanks=thank you)","x":0.088888893397054011},{"h":0.016414010184151784,"y":0.46490345995457261,"w":0.10681483268737796,"x":0.39103702886332442,"text":"•&0&0"},{"text":"3 Avoid overusing phrasal verbs and colloquial","w":0.36666664123535159,"x":0.064444461743435225,"h":0.013181063593650455,"y":0.48110465090900378},{"h":0.011836734693877582,"w":0.29111110687255853,"x":0.088888889415572589,"y":0.49551020424087922,"text":"expressions. (e.g. carry on = continue)"},{"y":0.51591836740067987,"w":0.43555553436279293,"h":0.013151400040607109,"x":0.03777778298527032,"text":"3 Choose the correct words and phrases to complete"},{"text":"the rest of the letter in Exercise 1.","y":0.53052325605836925,"x":0.062222230992635019,"w":0.27777776718139646,"h":0.011627906487912565},{"x":0.046666668403031221,"w":0.40444442749023435,"h":0.011627906487912454,"text":"Having recently spend\/ I have recently spent a week on","y":0.5610465118723228},{"x":0.05322652816403519,"h":0.015058649802694557,"text":"holiday in a resort town, I have personally seen the effects","w":0.42019660949707033,"y":0.57409415476159886},{"x":0.053333331238552724,"w":0.40222221374511719,"h":0.013172757674236646,"text":"of development for tourism. As 'the \/ a result, more and","y":0.58857142831719556},{"text":"more high-rise hotels have been built. In addition, roads,","w":0.40666664123535151,"x":0.053333351132324118,"y":0.60448979628052857,"h":0.013242762040118761},{"w":0.39999999999999997,"y":0.62063953518627624,"h":0.011627906487912565,"x":0.05333332933333338,"text":"an airport, shops and restaurants support the increased"},{"h":0.011836734693877582,"y":0.63510204073459964,"w":0.39333332061767579,"text":"demands for transport and services. The outcome 2of \/","x":0.053333342968939837},{"y":0.64970930207179445,"x":0.053333351132324118,"h":0.013147840694505253,"text":"with such development is that beautiful landscapes and","w":0.40666664123535151},{"h":0.013081395674724994,"y":0.66569767424112591,"x":0.048888896949663557,"w":0.38222221374511711,"text":"natural habitats have become irreparably damaged."},{"y":0.68313953493433821,"w":0.3711111068725586,"x":0.053333331267424525,"h":0.011627906487912565,"text":"There is 3no \/ without a doubt that tourist facilities"},{"y":0.6973621585337525,"text":"consume massive amounts of water and electricity. At","w":0.38922779083251957,"h":0.015159403742576072,"x":0.053163898944095074},{"y":0.71510204082015139,"h":0.011836734693877582,"w":0.40888889312744137,"text":"a time when global warming is making the planet hotter","x":0.053333327125168278},{"y":0.72965116297697397,"w":0.39999999999999997,"text":"and drier, water resources should not be wasted, as this","h":0.011627906487912565,"x":0.053333337333333224},{"w":0.39375160217285154,"h":0.016678793770926403,"text":"could 4result \/ lead to shortages. Furthermore, burning","y":0.74227209267030136,"x":0.053126631686291469},{"y":0.75872092998482743,"h":0.013115805022570592,"w":0.39111110687255868,"x":0.053333338711868766,"text":"fossil fuels to generate electricity contributes to global"},{"x":0.05333332680664981,"y":0.7746938773736689,"text":"warming. Unless hotels and businesses use renewable","w":0.3888888931274414,"h":0.011836734693877582},{"text":"energy, they add to this ever-growing problem.","w":0.33555553436279295,"y":0.78924418586539902,"x":0.053333348124158991,"h":0.013204793346171528},{"x":0.053333329575168238,"y":0.80653061206327559,"w":0.3888888931274414,"text":"Holidays are now 5so \/ such an affordable that record","h":0.01323682979661589},{"x":0.05333334179410798,"y":0.8240816325496596,"h":0.011836734693877471,"w":0.4222222137451172,"text":"numbers of people are travelling and the negative impacts"},{"w":0.40666664123535162,"text":"of tourism can only become worse. To my mind, 'in spite","x":0.051111117048991128,"h":0.013173944122937264,"y":0.83866279055895543},{"text":"of \/ even though tourism has led to economic growth,","y":0.85229810902852177,"x":0.053193736953776743,"h":0.014326997873734482,"w":0.38919731140136726},{"text":"it has also played a major role in the destruction of the","y":0.86918604694984225,"h":0.011630279774568431,"x":0.051111122946044994,"w":0.39777774810791017},{"w":0.38222221374511722,"text":"environment and will continue to do so in the future.","x":0.051111108979293468,"y":0.88367346951181169,"h":0.011836734693877471},{"y":0.90216966522441577,"h":0.015428111796476407,"text":"Yours faithfully,","x":0.048760660285448162,"w":0.11581201553344726},{"h":0.01032510640669837,"x":0.053333335826115304,"w":0.11777777671813966,"y":0.92151162814527277,"text":"Dean Robertson"},{"w":0.042222223281860351,"y":0.95930232573860186,"text":"126","h":0.011627906487912454,"x":0.033333333225736485},{"y":0.043604651455656174,"w":0.43333332061767582,"text":"4 Complete the sentences with the words in the box.","h":0.011627906487912454,"x":0.5288889024689396},{"x":0.57555555456372076,"y":0.07102040824856215,"h":0.011836734693877582,"w":0.31111110687255861,"text":"although as being despite having"},{"text":"in so suchwithout","x":0.57333333347521076,"y":0.084302325674342371,"h":0.010174418079609837,"w":0.18666666030883794},{"y":0.10610465137086933,"text":"As a consequence of global warming, sea levels are","h":0.011627906487912454,"w":0.38888889312744135,"x":0.58222222496405696},{"text":"rising and coastal areas are in danger.","y":0.12063953517658632,"x":0.5800000037363644,"w":0.28444442749023435,"h":0.011627906487912565},{"y":0.13517441878837755,"x":0.55555555627840647,"text":"1","w":0.015555554628372215,"h":0.0087209296713069984},{"x":0.57111111266039583,"y":0.13372092985159101,"h":0.013217845838897069,"w":0.1466666603088379,"text":"Climate change is"},{"text":"a terrible threat that","x":0.81777777745056857,"y":0.13510204091622202,"w":0.15333333015441886,"h":0.010246796121402668},{"x":0.58000000146894015,"y":0.14970930261844684,"text":"we need global cooperation to fight it.","w":0.2933333206176757,"h":0.011627906487912565},{"x":0.5555555559978036,"h":0.010174418079609837,"text":"2","y":0.16279069810651292,"w":0.01111111044883728},{"x":0.67777777391149019,"w":0.29555555343627926,"y":0.16279069763259879,"h":0.013127669509576223,"text":"gathered all of my old newspapers and"},{"h":0.013832009763133812,"text":"magazines, I put them into the recycling bin.","y":0.17681709703187376,"x":0.58211233356784986,"w":0.33579723358154301},{"x":0.56666665873257571,"y":0.19183673439807958,"h":0.013105126205755768,"w":0.34888889312744142,"text":"The people of the village are very generous,"},{"y":0.20639534889228861,"x":0.68000000749154088,"w":0.24888887405395499,"h":0.01319648820526742,"text":"the fact that they have very little."},{"text":"4","w":0.01111111044883728,"x":0.55555555577558136,"y":0.22093023275155577,"h":0.0087209296713069984},{"h":0.013195301756566913,"w":0.27111110687255857,"text":"an important part of the food chain,","y":0.22081632653137695,"x":0.68000000123038751},{"w":0.37555553436279299,"x":0.58000000433712218,"y":0.23546511652348556,"h":0.011627906487912565,"text":"bees must be protected so that they can continue"},{"text":"Our responses to the climate crisis are","x":0.58222222898446996,"w":0.28666666030883792,"y":0.26308139513138751,"h":0.013245135716029588},{"x":0.58000001454899075,"y":0.27906976783162518,"w":0.38666664123535155,"h":0.011627906487912565,"text":"inadequate that I wonder how long it will be before"},{"y":0.29215116284577702,"w":0.27333332061767579,"text":"humans can no longer live on Earth.","x":0.5800000068393103,"h":0.013154959386708742},{"text":"The use of solar panels results","x":0.58000000804709639,"y":0.30653061244481639,"w":0.22888887405395508,"h":0.01323682979661589},{"h":0.011627906487912565,"text":"energy costs for homes and businesses.","x":0.58000001453674299,"y":0.32122093047697398,"w":0.2999999809265137},{"h":0.013223778082400051,"w":0.26888887405395501,"x":0.67777778812117051,"text":"a doubt, a great deal is being done","y":0.33575581400856769},{"text":"by zoos to protect endangered species","x":0.58000000902041282,"y":0.35020408167778783,"h":0.011836734693877471,"w":0.29777776718139648},{"text":"the conditions were dangerous,","w":0.23999999999999999,"h":0.011627906487912454,"y":0.36482558163976464,"x":0.67777778077777784},{"x":0.5800000129133841,"text":"the climbers continued their ascent of the mountain.","h":0.011627906487912565,"w":0.39333332061767579,"y":0.37790697703705145},{"text":"5 Complete the second sentence so that it has a similar","w":0.45111110687255851,"x":0.52666667630446118,"h":0.013172757674236646,"y":0.39825581376631969},{"w":0.38,"x":0.55333333966666642,"h":0.011627906487912565,"text":"meaning to the first. Use the words in brackets.","y":0.41424418629092741},{"h":0.013211912816884608,"text":"Because holidays are so affordable, more people are","w":0.395555534362793,"x":0.58000001554082559,"y":0.43168604629417817},{"text":"travelling. (so)","x":0.57990982933398794,"w":0.10906923294067372,"h":0.012368832413031106,"y":0.44585046723784738},{"text":"Holidays are so affordable that more people","x":0.58000000517264372,"h":0.013200047551369165,"w":0.33333332061767573,"y":0.45918367332378396},{"h":0.011973957918128164,"text":"are travelling","x":0.57995336180724455,"y":0.47511767216306222,"w":0.10009327888488762},{"h":0.013260560327646664,"x":0.58000001303266047,"w":0.36444442749023442,"y":0.48837209280580618,"text":"People are forbidden to wash their cars because"},{"y":0.50436046528802048,"text":"there is a serious water shortage. (such)","w":0.29777776718139648,"x":0.58000000902041282,"h":0.011627906487912565},{"x":0.58000000374999983,"y":0.5318367348838513,"text":"people are forbidden to wash their cars.","w":0.30000000000000004,"h":0.011836734693877582},{"h":0.010174418079609837,"x":0.55333333377558136,"text":"2","w":0.01111111044883728,"y":0.54651162833907097},{"x":0.56888890838232398,"y":0.54651162767135841,"h":0.013081395674724994,"text":"The beach is a breeding ground for turtles, but a bar","w":0.40666664123535157},{"x":0.57777777304739042,"text":"has been built there. (even)","w":0.20888889312744141,"h":0.010174418079609726,"y":0.56104651194493349},{"h":0.01024560967270205,"text":"A bar has been built on the beach","x":0.57777778102777777,"y":0.57551020396375974,"w":0.26000000000000001},{"text":"3","y":0.60319767451155171,"h":0.010174418079609837,"w":0.01111111044883728,"x":0.55333333355335912},{"y":0.60302921088612571,"w":0.36470783233642579,"h":0.014755021698620863,"text":"You can't deny that climate change is caused by","x":0.57542465771951834},{"x":0.57777778403893132,"w":0.17777776718139648,"text":"global warming. (leads)","y":0.61755102064429146,"h":0.013262933225047902},{"h":0.011836734693877582,"y":0.63224489796441119,"x":0.57777778191576201,"w":0.1488888835906983,"text":"You can't deny that"},{"text":"4 Although there was a severe drought, the farmer's","y":0.66122448972426351,"h":0.013194115307866405,"x":0.55333334049781169,"w":0.40222221374511724},{"text":"animals survived. (spite)","w":0.18222221374511727,"x":0.57777778290521919,"h":0.010250355856759263,"y":0.67587209311620278},{"y":0.68895348842271042,"x":0.57777778169116223,"w":0.21333332061767574,"text":"The farmer's animals survived","h":0.011627906487912565},{"h":0.011836734693877471,"text":"5 The decision means that the trees will not be cut","y":0.7179591837421917,"w":0.39333332061767579,"x":0.55333333320968092},{"h":0.010308495346380675,"text":"down. (result)","y":0.73387755095723228,"x":0.57777777597018098,"w":0.10222222328186037},{"h":0.010208827427455325,"text":"the trees will not be cut down.","x":0.5777777857200338,"y":0.76162790726348961,"w":0.22222221374511719},{"text":"6 Areas of natural beauty will definitely be protected","x":0.55111111986380579,"y":0.77469387733299722,"w":0.40666664123535157,"h":0.01309682028634207},{"x":0.5755555547570711,"text":"from development by new laws. (doubt)","w":0.30222221374511715,"h":0.013204793346171417,"y":0.78924418590779266},{"y":0.81831395327092238,"h":0.013114617795360384,"w":0.29999999999999993,"x":0.57777778152777759,"text":"will protect areas of natural beauty from"},{"x":0.57775365129359557,"w":0.106714916229248,"h":0.011817609047403144,"y":0.83275398597714434,"text":"development."},{"x":0.55111113102011888,"h":0.013118177919971719,"text":"7 There was an earthquake and half the village was","w":0.39777774810791011,"y":0.84734693874006517},{"y":0.86191860470178028,"text":"destroyed. (consequence)","w":0.19555555343627928,"h":0.011627906487912454,"x":0.57777777565223087},{"w":0.20222221374511717,"y":0.87632653047964582,"h":0.011836734693877471,"text":"There was an earthquake..","x":0.57777778538670066}]
666666030883778},{"x":0.50666668088232414,"w":0.38666664123535155,"y":0.73102040830753079,"h":0.013165638203523566,"text":"• I have used correct punctuation for direct speech."},{"h":0.011836734693877582,"text":"• I have checked my spelling and punctuation.","y":0.75714285716988694,"x":0.50666666690033624,"w":0.35777778625488277},{"x":0.50666667499671758,"y":0.77755102017222633,"h":0.013146654245804745,"w":0.35333332061767575,"text":"• my handwriting is neat enough for someone"},{"y":0.793469387824844,"x":0.52222222248964667,"w":0.11111110687255865,"h":0.0089795918367346905,"text":"else to read it."},{"text":"L","w":0.020000000000000018,"x":0.91333333350000001,"y":0.58430232533366455,"h":0.013081395674724994},{"h":0.015988372491330449,"w":0.024444444179534841,"text":"O","y":0.63662790666338798,"x":0.91333333335467703},{"w":0.020000000000000018,"x":0.91333333324999999,"y":0.69331395312563737,"h":0.014534884083027722,"text":"C"},{"text":"111","x":0.91555555512680453,"w":0.035555555820465101,"y":0.96075581427057843,"h":0.011627906487912565}]
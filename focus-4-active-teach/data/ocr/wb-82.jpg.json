[{"w":0.039999999999999994,"text":"5.9","h":0.018895348075561036,"y":0.0072674421686148571,"x":0.055555555777777779},{"w":0.2066666603088379,"x":0.14222222669280327,"text":"SELF-CHECK","h":0.02034883662899889,"y":0.0072674420779423876},{"w":0.2755555534362793,"text":"VOCABULARY AND GRAMMAR","x":0.057777780805669823,"y":0.06827473430653086,"h":0.011856091578086758},{"h":0.016198062350880615,"y":0.093170985942087614,"text":"1 Complete the text with one word in each gap.","x":0.044198062561580473,"w":0.39822715759277344},{"h":0.0087209297610615355,"y":0.11773255830260876,"text":"•0•","w":0.035555555820465087,"x":0.055555555867545223},{"text":"Time management at work","x":0.14888889719116208,"h":0.011627906867937354,"y":0.13517441858638013,"w":0.23333332061767578},{"x":0.064444448473316138,"y":0.15249386760826344,"w":0.36888889312744133,"h":0.011856091578086647,"text":"How is it that some people manage to get a huge amount done"},{"x":0.064362337632228733,"w":0.39574913024902347,"y":0.16549794159290654,"text":"during the working day, while others struggle to work to deadlines","h":0.013317463735235791},{"text":"and get a job done? If you're serious about increasing your","y":0.18023255812126393,"w":0.34222221374511719,"x":0.064444452960774612,"h":0.011627906867937243},{"x":0.19111110737037046,"w":0.26000000000000001,"h":0.013145571932476896,"y":0.19331395362397119,"text":"and achieving your long and short-term work"},{"y":0.20768601780713969,"h":0.011856091578086647,"w":0.23555555343627929,"x":0.18666667067074919,"text":", you have to get organised. Here's how:"},{"x":0.064297101639982202,"text":"#1 Write down a daily plan. It should be in detail, including breaks.","y":0.22305825712311,"w":0.39141242980957036,"h":0.014219781559018596},{"text":"Note down everything you have to do 3","x":0.064444450178914328,"y":0.2369186048412677,"h":0.013081394641592414,"w":0.22666666030883792},{"x":0.40666666682266156,"y":0.241279069966853,"h":0.0087209297610615355,"w":0.017777777910232551,"text":"In,"},{"text":"day out, as well as unexpected tasks, like a last-minute report.","h":0.013976592268986732,"x":0.064288683756660137,"y":0.25139491535029412,"w":0.36029949188232424},{"h":0.011627906867937243,"y":0.26889534883347332,"w":0.39111110687255862,"text":"#2 Prioritise. Do your biggest and most important tasks first. Don't","x":0.064444450474831785},{"text":"take on tasks that aren't part of your job. You might have to speak","w":0.38222221374511722,"x":0.064444444860774788,"y":0.2833197054533203,"h":0.011856091578086647},{"y":0.29505813947300819,"text":"your 4","x":0.062222222400000006,"h":0.011627906867937243,"w":0.040000000000000001},{"y":0.29640228960035608,"text":"here and learn to say 'no'.","x":0.21777778192279043,"h":0.011856091578086647,"w":0.15333333015441894},{"text":"#3 Love what you do. When you care about what you are doing and","y":0.31395348836835701,"h":0.011627906867937243,"w":0.39333332061767579,"x":0.064444454735606491},{"x":0.064444444916666649,"y":0.32542927200895122,"h":0.013233518171583358,"w":0.060000000000000012,"text":"put your 5"},{"h":0.011856091578086536,"x":0.23555556200080027,"text":"into it, then you'll work faster and better.","y":0.32829108764419535,"w":0.22888887405395505},{"h":0.013250156786240974,"y":0.34447674406499074,"w":0.30444444656372072,"x":0.062222223699621076,"text":"Follow these simple tips to reach your full potential!"},{"w":0.064570379257202146,"h":0.009128184564173969,"y":0.35880800080338227,"x":0.064381476394510986,"text":"Good luck!"},{"text":"\/5","x":0.47555555544444444,"w":0.020000000000000018,"y":0.39680232566994666,"h":0.0101744183144995},{"w":0.45555553436279295,"h":0.011627906867937354,"text":"2 Complete the sentences with the correct forms of the","x":0.042222237374159019,"y":0.41569767444393824},{"x":0.068888900163384184,"text":"phrasal verbs in the box. There is one extra verb.","y":0.43008994294504066,"h":0.011856091578086647,"w":0.39333332061767584},{"w":0.34666664123535157,"x":0.088888907382324009,"y":0.45625511037212041,"h":0.011856091578086536,"text":"burn out carry out get down to keep at"},{"h":0.013220445113599322,"w":0.26000000000000001,"text":"map out put off work towards","x":0.0888888875925926,"y":0.46933769428568528},{"h":0.013127745318783135,"y":0.48977923101727461,"text":"I've already got my career mapped out, so | know what","w":0.4222222137451172,"x":0.068888898405219057},{"text":"lil be doing next year, in five years and in 10 years' time.","y":0.50436046568792481,"x":0.068888899728199032,"w":0.43333332061767582,"h":0.013219255944889041},{"h":0.01547122917892696,"text":"1 Our office is going to","x":0.066293122967057194,"w":0.18963068008422851,"y":0.51558156462789695},{"x":0.091111117048991122,"w":0.40666664123535162,"text":"related to the health and welfare of all company staff.","y":0.53188879804979305,"h":0.011856091578086647},{"h":0.011856091578086647,"w":0.20888889312744141,"text":"2 It's hardly surprising she","y":0.54497138177544535,"x":0.066666661936279362},{"x":0.091111102843686953,"text":"working 14-hour days and the weekends as well.","y":0.55959302335866712,"h":0.011627906867937243,"w":0.36888889312744139},{"text":"3 Tom's always talking about how much he dislikes his","w":0.41999999999999998,"h":0.013165775324025297,"x":0.066666660629629823,"y":0.57113654968572436},{"w":0.21333332061767579,"y":0.58708094850532422,"h":0.011856091578086647,"text":"current job. It's high time he","x":0.093333342357828711},{"x":0.26222223338042983,"h":0.013138440819129737,"text":"doing new tasks because they","w":0.22888887405395503,"y":0.61482558196699455},{"y":0.62790697717048294,"x":0.091111108645960184,"w":0.40222221374511719,"text":"seem tricky. Making a start is always the hardest part.","h":0.013139629208057113},{"x":0.066355901792496466,"h":0.019440020095688015,"y":0.63841192159950322,"text":"5 l always admire sports stars. You really have to","w":0.37610038757324221},{"text":"training if you want to succeed.","h":0.011856091578086758,"y":0.65535568284396883,"w":0.23777776718139648,"x":0.21333334259448683},{"y":0.69331395350643832,"w":0.45555553436279295,"x":0.040000016290825613,"h":0.011627906867937243,"text":"3 Complete the sentences with the correct forms of the"},{"h":0.010337237734728277,"w":0.14222221374511718,"y":0.70768601795837416,"text":"words in the box.","x":0.066666673275589478},{"text":"conscientiousness enthusiasm knowledge","x":0.086666660186279387,"y":0.73385118578157182,"w":0.34888889312744137,"h":0.011856091578086647},{"x":0.086666670916666563,"y":0.74854651160963614,"h":0.011627906867937243,"text":"overwork punctualitysingle-mindedness","w":0.33999999999999997},{"w":0.39360118865966792,"h":0.01390604688218644,"x":0.090978520872071478,"y":0.76693133365316057,"text":"All the staff were enthusiastic about the new project"},{"w":0.21333332061767579,"y":0.7819767444219653,"x":0.091111114802273296,"text":"and keen to start work on it.","h":0.010337237734728388},{"h":0.011856091578086647,"y":0.79640228955190651,"x":0.064444436964057203,"w":0.42888889312744138,"text":"1 The bus drivers have gone on strike due to their long"},{"h":0.011856091578086647,"x":0.08888888823447004,"w":0.30666666030883788,"text":"hours. They're complaining about being","y":0.80948487332600827},{"w":0.36666664123535153,"h":0.013188356273211355,"text":"2 We require all staff at the health centre to be","y":0.82256745735087944,"x":0.064444451048991103},{"y":0.83720930237998492,"text":"and hard-working.","w":0.14222221374511723,"x":0.2533333399422561,"h":0.011627906867937243},{"h":0.01315983376927965,"text":"3 Advertising is a creative industry where being","w":0.3711111068725586,"x":0.06444444285260964,"y":0.85029069768175425},{"x":0.25333333615930187,"h":0.0087209297610615355,"text":"about ideas doesn't work.","y":0.86627907007586447,"w":0.1977777671813965},{"w":0.068888888359069825,"y":0.87775960766223038,"x":0.064444444020465105,"text":"4 Being","h":0.011856091578086647},{"x":0.24666666675816523,"y":0.87936046531603129,"w":0.25111110687255861,"h":0.011627906867937354,"text":"is important in most jobs because"},{"w":0.40666664123535157,"x":0.09111112891010191,"text":"being late means lost working time and less productivity.","y":0.89244186076423282,"h":0.013118237427581336},{"h":0.013119426206400053,"w":0.4222222137451172,"text":"5 Marie Curie didn't just know a lot about physics, she","y":0.90552325570501013,"x":0.064444452905219121},{"y":0.9198691742976326,"x":0.088888891339457168,"h":0.011856091578086647,"w":0.11333333015441895,"text":"was extremely_"},{"h":0.01022076860179888,"y":0.92150449710827909,"text":"about chemistry too.","w":0.15111110687255863,"x":0.34000000352668364},{"y":0.9375000000178958,"w":0.020000000000000018,"h":0.010174418314499389,"text":"\/5","x":0.47111111108333331},{"y":0.95930232581731423,"h":0.010174418314499389,"text":"80","x":0.046666666493565892,"w":0.02444444417953491},{"text":"4 Complete the second sentence so that it reports the first.","h":0.013133687263420235,"w":0.45111110687255862,"y":0.062500000335453776,"x":0.53333334109149833},{"y":0.081357318179432925,"w":0.40000000000000002,"h":0.013119425816508601,"text":"'Prepare your CV for the next Friday,' Tim's tutor said.","x":0.58222222405555557},{"x":0.58444444358366965,"h":0.011627906867937243,"w":0.33777778625488286,"y":0.095930232554403472,"text":"Tim's tutor told him to prepare his CV for the"},{"text":"following Friday.","y":0.10901162828482391,"w":0.13111110687255856,"h":0.013228763836091062,"x":0.58222222652668365},{"h":0.013161021768315795,"text":"'How long were you looking for a job before you","x":0.57555557241119604,"w":0.37555553436279299,"y":0.12346688483058121},{"x":0.5822222331211705,"w":0.20888887405395506,"text":"found one?' Leo asked me.","y":0.13808139545169029,"h":0.011627906867937243},{"x":0.58444444895669223,"h":0.010296829781957229,"y":0.15249386772921691,"w":0.10666666030883787,"text":"Leo asked me"},{"w":0.013333332538604692,"y":0.16715116297799626,"x":0.55777777839736431,"text":"2","h":0.0087209297610616465},{"w":0.35777774810791008,"x":0.57333335413122999,"h":0.011627906867937354,"text":"I'm flying to Canada tomorrow,' Bob told her.","y":0.16715116284510112},{"h":0.01033961451258314,"text":"Bob told her that","x":0.58444444770056814,"y":0.18152085040411425,"w":0.13333333015441895},{"x":0.55761965848335071,"text":"3 'Don't ask me for a loan,' my mum told my brother.","y":0.19386572457488138,"w":0.40927703857421871,"h":0.016140827855806616},{"text":"My mum told my brother","h":0.011648110649377097,"y":0.21075581393521747,"x":0.58444444895260939,"w":0.19111110687255861},{"x":0.55777778826893976,"h":0.011856091578086647,"text":"4 I will have to buy at least two new suits,' Steve said","y":0.22526573994364174,"w":0.4133333206176758},{"text":"Steve said that he","x":0.58421058932818426,"y":0.23827057100731153,"w":0.13606223106384274,"h":0.011831397417619072},{"h":0.013241836894074988,"text":"5 'Are you going to commute to Leeds?' he asked me.","x":0.55777778477777762,"y":0.25290697712203336,"w":0.41999999999999993},{"h":0.010240972383238733,"w":0.14888888359069818,"x":0.58444444858242861,"text":"He wanted to know","y":0.26737530649784824},{"text":"5","x":0.96888888910891469,"y":0.28924418619505055,"h":0.0087209297610616465,"w":0.01111111044883728},{"text":"5 Complete the second sentence so that it means the","w":0.43333332061767571,"h":0.011856091578086758,"y":0.30948487326060126,"x":0.53333334402449539},{"x":0.55762767611279629,"text":"same as the first. Use the word in capitals.","h":0.015456815674377067,"w":0.33815387725830082,"y":0.32183077424453432},{"text":"'You must talk to the boss immediately!' Simon said.","w":0.38888889312744135,"x":0.58444444880664947,"h":0.013277490901245192,"y":0.34137367156005483},{"w":0.062222223281860334,"x":0.58222222231462539,"h":0.011627906867937354,"text":"URGED","y":0.35465116278696152},{"h":0.011639791536994015,"text":"Simon urged me to talk to the boss immediately.","w":0.36666664123535153,"x":0.5844444608267686,"y":0.36917416186790486},{"text":"'No, Chris. I must prepare the draft copy of the","x":0.57333333573636447,"w":0.36444442749023442,"h":0.013092091311613041,"y":0.3822567455682917},{"text":"contract myself,' the manager said. INSIST","x":0.58222223319713895,"h":0.013090902142902872,"w":0.3266666412353515,"y":0.39533932984359099},{"h":0.010712653617827694,"text":"The manager","x":0.58206523743392335,"y":0.41049084187757889,"w":0.10474496841430669},{"h":0.011856091578086647,"x":0.58222221760702864,"w":0.2844444465637207,"y":0.42436631250996704,"text":"the draft copy of the contract himself."},{"y":0.43744889610255355,"text":"2 'Why don't we wear our new jumpers for the charity","w":0.41333332061767569,"x":0.55777778930227317,"h":0.013132498874492748},{"x":0.58222222393299705,"y":0.4520348839568491,"text":"concert?' Nina said. THAT","w":0.20222221374511717,"h":0.010352687570567287},{"h":0.010174418314499389,"x":0.58444444466754519,"text":"Nina","w":0.035555555820465101,"y":0.46511627917123866},{"x":0.5822222314978116,"y":0.47955846266039359,"h":0.011856091578086647,"text":"our new jumpers for the charity concert.","w":0.30222221374511715},{"x":0.55555555606403084,"text":"3","w":0.013333332538604803,"h":0.010174418314499389,"y":0.49273255841179098},{"h":0.013172906437372567,"text":"We've been doing research for the new campaign","x":0.57111110671186904,"y":0.49264104667315234,"w":0.39111110687255857},{"text":"since January,' Rob said. EXPLAINED","y":0.50726744182765926,"h":0.011627906867937354,"w":0.28888887405395514,"x":0.58222223252857785},{"y":0.52034883729987236,"w":0.03333333253860471,"h":0.010174418314499389,"text":"Rob","x":0.58222222303625315},{"x":0.58186821037133885,"w":0.27615976333618164,"text":"for the new campaign since January.","y":0.5333128260459169,"h":0.015223457105610017},{"h":0.013213314780034846,"y":0.54783319671227293,"x":0.5577777915963813,"w":0.41555553436279291,"text":"4 'I'm sorry. I can't get the report ready in time for the"},{"text":"meeting,' Leo said to his boss. FOR","y":0.56091578122982044,"h":0.013212125611324677,"x":0.58222222609856966,"w":0.27333332061767579},{"text":"Leo","w":0.028888888359069886,"x":0.58222222277602054,"h":0.0101744183144995,"y":0.57558139545030829},{"y":0.58866279083327355,"x":0.5822222275718858,"w":0.30222221374511715,"text":"the report ready in time for the meeting","h":0.013136064821057669},{"h":0.0087209297610615355,"text":"5","y":0.60319767459621343,"w":0.01111111044883728,"x":0.55777777822002572},{"h":0.013253721563131871,"text":"Don't forget, they're decorating the office soon,","y":0.60302534782646289,"x":0.57333332700000028,"w":0.38},{"h":0.01034555684711147,"text":"Clare said to me. REMINDED","x":0.58222223345450386,"y":0.61610793135568087,"w":0.22888887405395508},{"text":"Clare","x":0.58444444544648577,"y":0.63081395368778315,"w":0.037777776718139644,"h":0.0087209297610616465},{"x":0.58000000627558945,"text":"the office soon.","w":0.12222221374511721,"h":0.010233841659782916,"y":0.64389534900650991},{"y":0.65406976743812439,"h":0.011627906867937243,"w":0.022222220897674561,"x":0.95777777866227387,"text":"15"},{"y":0.66708708173122711,"x":0.52877334835862899,"h":0.013196923356512458,"w":0.29138170242309569,"text":"6 Choose the correct answers A-C."},{"x":0.54000000058480635,"h":0.010328918622345196,"w":0.16444444656372059,"text":"Worst mistakes at work","y":0.69040697681658747},{"text":"Once, my boss told me B a client in an office block in London. When","y":0.70482420280386437,"x":0.53999999954301414,"w":0.4133333206176758,"h":0.011856091578086647},{"y":0.71656976763196545,"h":0.013193110608703651,"text":"I got there, the receptionist1","w":0.17777776718139648,"x":0.53777778507596841},{"text":"how to get to the office, but got","x":0.73111111827558939,"y":0.71947674443424836,"w":0.20222221374511729,"h":0.011627906867937243},{"text":"the directions wrong. I opened a fire door on to the roof and it closed","y":0.73098937041505252,"x":0.54000001475193671,"w":0.41555553436279291,"h":0.011856091578086647},{"text":"behind me, so I had to walk round the roof to find a way out. To my","h":0.011856091578086647,"x":0.54000001252154928,"w":0.40444442749023446,"y":0.74407195418188687},{"y":0.75715453789058185,"text":"horror, I walked past a window only to see my colleagues and the client","x":0.5377777927297146,"w":0.43555553436279293,"h":0.011856091578086647},{"w":0.24222221374511721,"x":0.53777778575707091,"y":0.76889534897280842,"h":0.013197864164413264,"text":"inside the room! The client suggested 2"},{"text":"to the door, but, in the end,","x":0.78888889813560636,"y":0.77180232575069596,"h":0.010290887837320351,"w":0.17333332061767581},{"y":0.78331970576569221,"text":"they opened the window for me to climb in! Of course, I apologised","h":0.011856091578086647,"x":0.54000001949343512,"w":0.40666664123535157},{"h":0.0087209297610616465,"text":"3","x":0.53777777799780369,"y":0.79360465125319013,"w":0.01111111044883728},{"text":"late and all the confusion. Luckily the client found it funny and","h":0.011856091578086647,"x":0.56888890417971449,"y":0.79640228947923208,"w":0.37555553436279299},{"y":0.80662305786016719,"w":0.082222223281860352,"h":0.011856091578086647,"text":"he assured 4","x":0.53777777832203266},{"h":0.010282568724937158,"y":0.80948487311157624,"w":0.32222221374511728,"x":0.62444444331262683,"text":"it wasn't a problem. We got the contract, and when"},{"text":"I returned, my boss congratulated 5","w":0.22000000000000008,"x":0.53777778114814789,"h":0.013143195154622034,"y":0.81970564148303471},{"h":0.015196334701625402,"w":0.21388240814208992,"x":0.75081366911055125,"y":0.82076296838823593,"text":"making the meeting a success!"},{"y":0.84431640057555757,"w":0.075669412612915044,"h":0.011948594087864306,"x":0.57994307222743713,"text":"A visiting"},{"text":"1 A explained","y":0.85755813949238802,"x":0.5533333391161408,"w":0.12444443702697749,"h":0.011627906867937243},{"x":0.56444444244444
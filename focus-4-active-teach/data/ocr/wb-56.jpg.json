d","w":0.2844444465637207,"y":0.78326530582040377},{"y":0.79795918369692931,"x":0.58444444845260946,"w":0.13111110687255856,"text":"your bag, was it?","h":0.011836734693877582},{"x":0.57111111384747559,"h":0.011627906487912565,"y":0.81250000024441571,"text":"A: They're going to splash out on a new car.","w":0.34444442749023441},{"text":"B: Will they?","h":0.013159346288564189,"y":0.82626916419470819,"w":0.095966033935546924,"x":0.58646142845405758},{"y":0.84156976783162496,"w":0.26222221374511712,"x":0.56000000568299702,"h":0.011627906487912565,"text":"6 That's Ella over there, isn't she?"},{"y":0.86337209315139263,"h":0.011627906487912565,"w":0.022222220897674561,"x":0.94888888946227379,"text":"16"},{"x":0.59777778301043838,"y":0.8909883719410443,"text":"GRAMMAR: Train and Try Again page 174","w":0.32444442749023439,"h":0.014725914001464835},{"text":"54","w":0.024444444179534917,"y":0.96075581414505018,"x":0.051111111132454763,"h":0.011627906487912454}]
[{"w":0.4488888931274414,"x":0.5266666600585016,"text":"FOCUS 3 GRAMMAR REVIEW","h":0.020408163265306034,"y":0.013061224776158897},{"w":0.40222221374511724,"text":"Read the article about advertising slogans. Rewrite","x":0.044444453710774601,"y":0.069767441606678249,"h":0.013089701594138581},{"h":0.011836734693877582,"y":0.085714285720150718,"text":"the journalist's notes with one word in each gap.","x":0.042222241382323986,"w":0.38666664123535155},{"h":0.017441859342613997,"y":0.11337209336648368,"text":"Do products live up","w":0.19555555343627928,"x":0.033333333726304808},{"text":"to their advertising claims?","x":0.031111114297054029,"h":0.017643568856375635,"y":0.13061224471028021,"w":0.27111110687255857},{"x":0.32825269403176577,"y":0.14482545923203405,"w":0.12988592147827149,"h":0.015529663708745201,"text":"By Monica Smith"},{"x":0.033333328686279383,"w":0.3888888931274414,"y":0.16569767441917826,"text":"I asked three people if they ever bought those products and","h":0.013081395674724883},{"text":"whether they believed their claims. Here are their reactions.","y":0.1802325583258112,"w":0.39111110687255851,"x":0.033333339363720606,"h":0.011627906487912565},{"x":0.033333339505976944,"w":0.35333332061767575,"text":"1 This cream will make you look ten years younger.","y":0.19755102020977433,"h":0.013204794124681118},{"w":0.41111110687255858,"text":"One woman said that she'd started using anti-ageing cream a few","h":0.011836734693877582,"y":0.21346938767885759,"x":0.035555561785942873},{"y":0.22674418624247783,"h":0.011627906487912565,"w":0.39111110687255857,"x":0.03333334197112791,"text":"months before, but she knew that it would require more than"},{"x":0.033333338304461349,"y":0.23982558168821422,"text":"a cream to keep her young.","w":0.17111110687255859,"h":0.011627906487912565},{"text":"2 This chocolate spread is a healthy breakfast for children.","w":0.40444442749023435,"y":0.25714285720622421,"x":0.033333348551178865,"h":0.011836734693877471},{"x":0.035555572337879725,"y":0.27306122445690129,"w":0.40666664123535157,"text":"A mother said that her children loved chocolate spread. She said","h":0.011836734693877471},{"x":0.033333342637794521,"y":0.28633720954674136,"h":0.011627906487912565,"w":0.43111110687255855,"text":"that she had hidden the jar away because it was full of sugar and fat."},{"w":0.41111110687255858,"text":"She asked me when they were going to invent healthy chocolate!","x":0.033333342304461194,"h":0.011627906487912454,"y":0.29941860479867943},{"text":"3 You can avoid colds and flu if you use our mouthwash every day.","y":0.31673469422097011,"x":0.035555566663384219,"h":0.013207166243572654,"w":0.43333332061767577},{"text":"One man I spoke to was a doctor. He told me that it was impossible","y":0.33428571443437827,"h":0.011836734693877471,"x":0.035555564004546486,"w":0.42666664123535158},{"w":0.39111110687255857,"text":"for a mouthwash to prevent illness. He told me not to believe","x":0.033333328934091286,"y":0.34593023246787014,"h":0.013253440856933585},{"y":0.3604081634462275,"h":0.011836734693877471,"text":"everything I read in adverts.","x":0.035555563075968383,"w":0.17777776718139648},{"h":0.011627906487912565,"x":0.044444443541119656,"w":0.23555555343627932,"y":0.39534883750216787,"text":"1 Questions: Do you ever buy"},{"w":0.07777777671813968,"y":0.39389534883784649,"text":"products?","h":0.014534884083027833,"x":0.36666666650204127},{"y":0.40621686298964521,"w":0.19402055740356447,"text":"you believe their claims?","h":0.015511743973712466,"x":0.14847934232989843},{"x":0.044444445694444411,"y":0.42441860482284044,"h":0.010275272836490545,"w":0.099999999999999978,"text":"2 Woman: 1"},{"text":"using anti-ageing cream","x":0.22888888475517682,"y":0.42441860494402817,"h":0.011627906487912565,"w":0.18444444656372072},{"y":0.43750000009906698,"text":"a few months","h":0.011627906487912565,"w":0.10222222328186036,"x":0.068888887414625413},{"text":", but | know that it","y":0.43750000018627622,"x":0.25555556070873342,"w":0.14444443702697757,"h":0.011627906487912565},{"y":0.4518367350200202,"x":0.068888888757071165,"text":"require more than a cream to keep","w":0.26222221374511717,"h":0.013469387755102091},{"x":0.044444444664470256,"y":0.4665697675348075,"h":0.010174418079609726,"w":0.01111111044883728,"text":"3"},{"text":"Mother:","x":0.057777778828630277,"y":0.4665697677347258,"w":0.079999995231628429,"h":0.011627906487912565},{"x":0.21555555623565881,"y":0.46656976777348569,"text":"children","w":0.064444441795349139,"h":0.011627906487912565},{"x":0.068177174920523595,"h":0.013421500069754511,"text":"spread.1","y":0.48130548888373692,"w":0.074480905532836914},{"x":0.2244444511633843,"w":0.19333332061767577,"y":0.48110465155255533,"h":0.011627906487912565,"text":"hidden it away because it"},{"h":0.013210726368183989,"text":"full of sugar and fat. When","y":0.49551020409999247,"x":0.066666668882996979,"w":0.20222221374511717},{"x":0.41777777927055981,"y":0.45494186069729226,"h":0.0087209296713069984,"w":0.057777776718139606,"text":"young."},{"y":0.46648870911252915,"x":0.36664118696894765,"w":0.075606513023376509,"h":0.010336534928302332,"text":"chocolate"},{"text":"they going to","w":0.10453359603881834,"x":0.35773320328556757,"y":0.49546682035063938,"h":0.011973335499666171},{"h":0.011627906487912565,"w":0.19555555343627928,"text":"invent healthy chocolate?","y":0.51017441875216774,"x":0.06888889320778617},{"w":0.10222222328186034,"x":0.044444445618329026,"y":0.52470930251542769,"h":0.010174418079609837,"text":"4 Doctor: It"},{"text":"_impossible for a mouthwash to","x":0.22186960261462127,"w":0.2428149604797363,"y":0.52078893144859817,"h":0.016047500298947637},{"x":0.070991904158954455,"y":0.53734559062963594,"w":0.11134952545166016,"h":0.013971608220314513,"text":"prevent illness."},{"y":0.53918367342744078,"w":0.17333332061767581,"text":"believe everything you","x":0.27111111920227315,"h":0.011836734693877471},{"h":0.010302562713623065,"w":0.11777777671813963,"y":0.55377907001179394,"text":"read in adverts.","x":0.068888890890930143},{"text":"2 Rewrite the direct speech as reported speech.","x":0.022222229230387285,"y":0.57412790718482276,"w":0.39111110687255857,"h":0.011627906487912565},{"x":0.070745029111315846,"y":0.58904804118612242,"h":0.018123842356156383,"text":"I'll meet you at half past two tomorrow.","w":0.2962292861938477},{"w":0.39999999999999997,"h":0.013242762040118761,"x":0.071111114888888841,"y":0.60448979609884257,"text":"I remember she said she would meet me at half past"},{"w":0.13111110687255861,"y":0.62063953512813674,"x":0.073333337637794718,"text":"two the next day.","h":0.011627906487912565},{"h":0.013217845838897069,"y":0.63372092994849016,"x":0.046666671028871641,"w":0.3888888931274414,"text":"1 The manager will be here tomorrow if you could"},{"h":0.010290697448107622,"x":0.071111115908354505,"w":0.12888888359069822,"text":"come back then.","y":0.64970930256387727},{"w":0.13333333015441895,"h":0.010336971672213813,"text":"The assistant said","y":0.66408163276003307,"x":0.071111111367234997},{"y":0.69183673464032769,"text":"2 The advertising executives are arriving tonight.","w":0.37777774810791015,"x":0.046666679871970873,"h":0.013105126205755768},{"h":0.013196488205267531,"text":"It was last Thursday morning that she said","w":0.31555555343627928,"x":0.07111110822630487,"y":0.70639534872877119},{"x":0.046666682234175985,"h":0.013215472162986241,"text":"3 I saw the new advert on TV for the first time today.","y":0.73387755103774832,"w":0.40666664123535162},{"w":0.077864513397216784,"y":0.74985712032423824,"x":0.073289966171231319,"text":"He told us","h":0.010460177830287409},{"x":0.046666684271212941,"y":0.77755102011772048,"w":0.38666664123535155,"h":0.013146654245804745,"text":"4 They are going to open the new branch of their"},{"w":0.17333332061767578,"x":0.073333341857828749,"text":"coffee shop next week.","y":0.79215116299877619,"h":0.011627906487912565},{"h":0.01323682979661589,"w":0.32888889312744141,"text":"Three weeks ago, the staff member told me","y":0.8065306121541187,"x":0.073333334502945893},{"y":0.83428571409778074,"x":0.04888889753484868,"h":0.014693877551020473,"w":0.40222221374511724,"text":"5 I'm sorry, but your doctor's appointment for today"},{"h":0.010261034284319237,"y":0.85020408165955552,"text":"has been cancelled","w":0.1466666603088379,"x":0.073333337978914337},{"y":0.86326530603115981,"w":0.34222221374511719,"h":0.013188182285853833,"text":"The receptionist called me and told me that_","x":0.073333340534848759},{"y":0.89387755111067779,"h":0.011836734693877471,"text":"6 I can't promise anything right now.","x":0.048888895651136542,"w":0.28666666030883797},{"text":"She said","h":0.010489768981933545,"w":0.062341742515563958,"y":0.90827255753981839,"x":0.075495795262751852},{"y":0.069767442153330528,"w":0.34222221374511713,"h":0.011627906487912565,"text":"3 Report the questions and imperatives.","x":0.4777777763126268},{"x":0.53777778541010202,"h":0.013198861102668547,"w":0.40666664123535157,"y":0.087209302180806136,"text":"Did you buy the product because you saw the advert?"},{"text":"They asked me if I had bought the product because","y":0.10163265304834712,"w":0.39333332061767579,"h":0.011836734693877582,"x":0.53777778806893994},{"h":0.010251542305459771,"text":"I had seen the advert.","x":0.53777777808850991,"w":0.16444444656372081,"y":0.11627906996940052},{"x":0.51111111336220516,"w":0.36888889312744144,"text":"1 Taste the drink and then describe the flavour.","y":0.12936046516689648,"h":0.011627906487912565},{"x":0.53777778224168782,"h":0.010217132957614172,"y":0.14530612256959374,"w":0.10888888359069826,"text":"She asked me"},{"w":0.43333332061767571,"y":0.17296511617063171,"x":0.51111111205227333,"text":"2 Would you like to try our service for free for a month?","h":0.013157333062619569},{"w":0.10222222328186037,"x":0.5377777755442551,"h":0.0087209296713071094,"text":"He asked me","y":0.18895348870116813},{"h":0.011627906487912565,"text":"3 Contact us and let us know what you think.","x":0.51333333396405689,"y":0.21656976783162507,"w":0.34888889312744142},{"x":0.53993387296998296,"text":"They told me","y":0.2308521720863993,"w":0.10235447883605953,"h":0.012132864971550084},{"text":"4 Have you ever thought of trying a different brand of","h":0.013115805022570592,"y":0.25872092996787011,"x":0.51333334179410794,"w":0.42222221374511726},{"x":0.5374984105587256,"h":0.013021966583874778,"text":"lipstick?","y":0.27401227243057069,"w":0.065003180503845237},{"y":0.28924418623635795,"h":0.010347650489028526,"w":0.11555555343627943,"x":0.54000000221519362,"text":"They asked me"},{"x":0.5133333355029458,"text":"5 Don't forget to take one pill before breakfast and the","y":0.31673469395519804,"w":0.42888889312744138,"h":0.011836734693877471},{"text":"other one before bed","x":0.54000000526224767,"y":0.33139534900888701,"h":0.010237304142543202,"w":0.16666666030883792},{"x":0.54000000651633018,"y":0.34593023272988099,"h":0.011627906487912565,"w":0.18222221374511716,"text":"The pharmacist told me"},{"text":"6 Who is going to pay for the damage to my computer?","h":0.013158519511320077,"x":0.51333333861708808,"y":0.37346938741034474,"w":0.43333332061767582},{"h":0.0089795918367345795,"y":0.38938775494789457,"w":0.080000000000000071,"text":"She asked","x":0.5400000009999999},{"text":"4 Complete the reported statements, questions and","w":0.42888889312744144,"x":0.48666665918627944,"y":0.42285714311080225,"h":0.013189368734554341},{"y":0.43845684927037287,"text":"imperatives.","x":0.51320594746021553,"h":0.012621185147032365,"w":0.10247699737548821},{"y":0.4563265307751887,"text":"'Our bus left two hours ago,' they told us.","x":0.53777779264785408,"h":0.011836734693877693,"w":0.31999998092651372},{"text":"They told us (that) their bus had left two hours earlier\/","y":0.4677277955796727,"h":0.01510819104253025,"w":0.40918262481689449,"x":0.54208850671055331},{"x":0.54000000289140371,"y":0.48401162815139243,"h":0.011627906487912565,"w":0.062222218513488747,"text":"before."},{"h":0.011836734693877582,"x":0.51555556318368301,"text":"1 'Are you from this part of town?' the stranger asked","y":0.49836734689243856,"w":0.41555553436279302},{"h":0.014338466099330316,"y":0.51194217445385637,"w":0.045360155105590771,"x":0.54041301436306222,"text":"Greg."},{"w":0.18888887405395505,"h":0.011627906487912565,"y":0.52761627950798173,"x":0.54222223271376313,"text":"The stranger asked Greg"},{"text":"2 'Do you like going to the cinema?' asked Pauline.","x":0.5155555648218858,"w":0.40222221374511713,"y":0.55510204081619907,"h":0.011836734693877582},{"w":0.13333333015441895,"h":0.010232557958486099,"text":"Pauline asked me","x":0.54222222514501273,"y":0.56976744205031149},{"x":0.51555556807710501,"text":"3 'Please don't play in the kitchen,' Barbara told the","y":0.59738372108743909,"h":0.011627906487912454,"w":0.40444442749023435},{"w":0.066666665077209419,"x":0.54222222290583977,"y":0.61191860478650328,"h":0.010174418079609726,"text":"children."},{"h":0.0087209296713069984,"w":0.19111110687255861,"text":"Barbara told the children","x":0.54222222115631336,"y":0.62645348870116824},{"h":0.011836734693877582,"y":0.65387755096622102,"text":"4 'You need to get the assignment back to me by 4 p.m.","w":0.4311111068725586,"x":0.51555555228594296},{"text":"tomorrow,' said Mr Roberts.","y":0.66715116284131504,"x":0.54000000013371219,"w":0.2155555534362793,"h":0.011627906487912565},{"h":0.010227811774428996,"text":"Mr Roberts said","x":0.54444444564444439,"w":0.12,"y":0.68163265300665499},{"x":0.5177777782200258,"w":0.01111111044883728,"text":"5","y":0.71075581417597444,"h":0.0087209296713069984},{"h":0.013146654245804856,"w":0.40444442749023435,"text":"'Pick me up some of my special toothpaste from the","y":0.70930232544267613,"x":0.53333333506969793},{"x":0.54444444397222225,"text":"chemist's,' asked Sylvia.","y":0.72367346936008792,"h":0.011836734693877582,"w":0.18000000000000005},{"text":"Sylvia asked me","w":0.1222222232818605,"h":0.011632653061224407,"x":0.5422222201646254,"y":0.73836734676703419},{"w":0.34888889312744142,"y":0.76598837195430414,"h":0.013195301756566913,"text":"I have never bought anything because of an","x":0.53333332539924239},{"x":0.54444444682297999,"h":0.011836734693877582,"text":"advertisement,' said Patrick.","w":0.21111110687255863,"y":0.7804081633323704},{"y":0.79490534956388759,"x":0.54440286655591019,"w":0.086749820709228542,"text":"Patrick said","h":0.01047999868587568},{"x":0.51777778197777768,"h":0.013243949267328969,"y":0.82267441833996302,"text":"7 'Is your sister going to visit us this weekend?', asked","w":0.41999999999999993},{"text":"Vanessa.","h":0.013903367957290302,"y":0.8367281478177665,"w":0.070996413230896005,"x":0.54321443743434172},{"y":0.85174418623635795,"w":0.11111110687255854,"x":0.5444444476748318,"h":0.010296630080865343,"text":"Vanessa asked"},{"y":0.87918367341583781,"x":0.51999999369553873,"h":0.013258187430245538,"w":0.38888889312744146,"text":"8 'Will you be so kind as to show me this photo?',"},{"x":0.54444444719852703,"h":0.010204081632653073,"w":0.13555555343627923,"text":"asked Mrs Brown.","y":0.89387755118328827},{"text":"Mrs Brown asked","y":0.90843023288122204,"x":0.54666666824168786,"w":0.12888888359069828,"h":0.01034527720237266},{"y":0.96220930229345147,"h":0.013081395674724883,"text":"167","w":0.037777776718139644,"x":0.92666666752981908}]
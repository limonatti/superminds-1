[{"w":0.16219163894653321,"text":"READING","x":0.1883055123858049,"y":0.024134168812424583,"h":0.021499104663705193},{"h":0.011865793780687417,"y":0.066693944477487777,"text":"Daniel Tammet • collocations","x":0.18847006826066309,"w":0.23946784973144525},{"h":0.010174418042022126,"y":0.040697674530345562,"text":"1","w":0.015521063804626478,"x":0.53215077611690331},{"text":"Read the text quickly and choose the best title for it.","x":0.55654102426674823,"h":0.013271704438080012,"y":0.040507365084114677,"w":0.42128601074218752},{"x":0.55875832172443751,"y":0.059593023512903631,"w":0.16851440429687503,"h":0.010374243247723625,"text":"1 The Real Rain Man"},{"x":0.55875831687611677,"w":0.19733924865722663,"y":0.07267441855920076,"text":"2 The Biggest Slice of Pi","h":0.013250295152055447},{"text":"3","y":0.088662790824835414,"w":0.011086474657058698,"x":0.55875831486104932,"h":0.0087209301962594132},{"x":0.58314855859476966,"w":0.24833702087402343,"text":"The Man with the Amazing Mind","y":0.088662790851943618,"h":0.01162790666820579},{"w":0.035476717948913564,"text":"•••","h":0.0087209301962595243,"y":0.1395348836664051,"x":0.057649668076540983},{"w":0.37915740966796874,"x":0.11973394006623714,"text":"aniel Tammet is a linguistic and mathematical genius.","h":0.011865793780687417,"y":0.19312602283158498},{"x":0.079822612259797476,"w":0.42572063446044928,"h":0.036337207850379749,"y":0.19622093087677239,"text":"Dis speakseren atds anies percen e 20e mental"},{"text":"arithmetic in seconds, and on March 14, 2004 publicly","x":0.11751663456810228,"y":0.22381342095469459,"w":0.38359199523925774,"h":0.013105183693469025},{"h":0.011865793780687417,"text":"recited pi from memory to 22,514 decimal places. It took him","x":0.070953445809280286,"y":0.23977086748496701,"w":0.43015518188476565},{"h":0.013233642531299772,"w":0.38802658081054686,"x":0.073170748951710968,"text":"five hours and nine minutes. However, since childhood,","y":0.25436046512896815},{"text":"despite his phenomenal mental abilities, Daniel has struggled","x":0.073170747432314512,"y":0.27034883740004378,"h":0.013202717573474909,"w":0.42350330352783205},{"text":"to learn the personal skills that most of us take for granted:","w":0.42128601074218758,"h":0.011627906668205679,"y":0.28633720939845531,"x":0.070953451169926143},{"x":0.073170752161451774,"text":"communication, empathy and the ability to see the big picture.","h":0.011627906668205679,"w":0.42793788909912112,"y":0.30232558154961808},{"text":"Daniel's skills and limitations are the","w":0.26164079666137696,"x":0.073170735106118587,"h":0.010371864134668285,"y":0.33265139135436605},{"w":0.26385808944702149,"x":0.070953435348551461,"h":0.011637422340005976,"text":"result of Asperger's syndrome, a form","y":0.34883720952926922},{"h":0.013922312060666853,"text":"of autism. He is a high-functioning","w":0.24421298980712888,"x":0.073022086605256858,"y":0.36326532745879381},{"text":"autistic savant who possesses similar","x":0.07095344304441227,"w":0.26385808944702149,"h":0.011865793780687417,"y":0.37929623580318339},{"text":"abilities to those of the character","x":0.07095344551321453,"h":0.011627906668205679,"w":0.23725053787231448,"y":0.39389534879768018},{"h":0.013193201901674723,"text":"played by Dustin Hoffman in the film","x":0.073170739098490423,"y":0.40988372082664259,"w":0.25498889923095702},{"h":0.015517283188340669,"x":0.072955182064849786,"w":0.23775836944580075,"y":0.42367127743999644,"text":"Rain Man. ' 'Im lucky,' he says,"},{"y":0.44186046541576229,"text":"'because most others who have rare","w":0.25277160644531249,"x":0.070953439737432553,"h":0.010267194086127862},{"x":0.070953440560285935,"y":0.45621931262020921,"text":"abilities are also seriously disabled.'","w":0.25942350387573243,"h":0.013257431320590096},{"h":0.010174418042022126,"x":0.070953437948879094,"text":"Life is easier for Daniel now that","w":0.22838136672973636,"y":0.48837209335907616},{"x":0.07095344410844269,"y":0.50436046536152634,"h":0.013233642531299772,"text":"he is in his thirties, but growing up","w":0.24833702087402348},{"x":0.070953436450628474,"text":"with autism was tough for him and","w":0.24390243530273437,"h":0.013155139994894482,"y":0.51882160394590482},{"h":0.013186065733140073,"text":"his family. As a baby, he used to cry","x":0.070953444345332309,"y":0.53477905047510099,"w":0.25055431365966802},{"text":"constantly and only repetitive motion","y":0.55073649773249977,"h":0.011865793780687306,"w":0.26829267501831056,"x":0.070953445232899245},{"y":0.56513025618585166,"w":0.12651706695556642,"h":0.013634836224994618,"text":"would stop him. 2","x":0.070887809566715421},{"x":0.20620842428521771,"w":0.11086474418640138,"text":"_As a result, he","y":0.56669394418417662,"h":0.011865793780687417},{"h":0.011865793780687417,"y":0.58265139127092547,"x":0.070953438461689375,"w":0.23725055694580077,"text":"never played with other children,"},{"text":"or even with toys. Numbers were my","y":0.59883720950504438,"h":0.011637422340005976,"x":0.070953432208475387,"w":0.25942350387573243},{"text":"toys, he says.","w":0.10205977439880372,"x":0.070921331794353823,"h":0.013297091919544646,"y":0.61181075614888136},{"y":0.64389534877359023,"x":0.070953447426522265,"w":0.3725055313110352,"text":"To him, numbers have colours, shapes, textures* and","h":0.013224127639920424},{"h":0.013193201901674723,"text":"personalities. He has described his visual image of 289 as","y":0.65988372117547978,"w":0.4057649612426758,"x":0.070953443731950894},{"h":0.011627906668205679,"text":"particularly ugly, and 333 as particularly attractive. Three","y":0.67587209311938556,"x":0.070953444693156842,"w":0.40798225402832033},{"h":0.013226506362765122,"text":"is green, five sounds like a clap of thunder, and thirty-seven","x":0.070953451169926143,"y":0.69026186565942949,"w":0.42128601074218758},{"text":"is lumpy*. This cross-connection between unrelated senses","x":0.07095344040789904,"y":0.70621931227583479,"w":0.41685142517089846,"h":0.013257432101010935},{"x":0.070953442935237088,"text":"is known as synaesthesia, and in Daniel's case it allows him","w":0.41463413238525393,"h":0.013081395294389231,"y":0.72238372117547978},{"y":0.73690671051043466,"h":0.013093289298823918,"w":0.38802658081054686,"x":0.070953445764349754,"text":"to 'experience' numbers rather than calculate them. As"},{"y":0.7528641568107064,"x":0.070953434788861819,"h":0.01312421503706962,"w":0.40576496124267569,"text":"he explains, 'When I multiply numbers together, I see two"},{"x":0.070953446940771658,"h":0.013155140775315322,"w":0.4124168395996094,"text":"shapes. The image starts to change and evolve, and a third","y":0.7688216036015304},{"text":"shape appears. That's the answer.'","y":0.78343023236734022,"x":0.070953442437324488,"w":0.24390243530273437,"h":0.013214611968120016},{"y":0.19312602288003466,"h":0.011865793780687417,"text":"It was this unique ability that helped him to remember pi","w":0.39689579010009768,"x":0.52106429676443755},{"text":"to so many decimal places, back in 2004. 3","x":0.52106431576057644,"y":0.20784883706695267,"w":0.29933479309082034,"h":0.013100426247779406},{"text":"'To me, it is as","y":0.20914653202106948,"x":0.83366187078285037,"w":0.10207758903503417,"h":0.011939494387412819},{"text":"beautiful as the Mona Lisa,' he explains.","h":0.013081395294389231,"x":0.52106430484883948,"w":0.28381374359130851,"y":0.22238372073943335},{"y":0.2557283140991411,"text":"Daniel has many gifts often associated with autism. He can","x":0.52106430943816806,"w":0.40798225402832033,"h":0.011865793780687417},{"w":0.41924526214599611,"x":0.52098945254472451,"y":0.27011079422036466,"h":0.013352284064659825,"text":"copy a picture so accurately that it could have been traced*,"},{"text":"and he planned his autobiography Born on a Blue Day without","x":0.52106431807386033,"y":0.28633720939845531,"h":0.011627906668205679,"w":0.42572059631347658},{"y":0.30232558164059609,"text":"taking a single note. Nevertheless, he is more aware of the","h":0.013140866877404456,"x":0.52106430778296586,"w":0.41019954681396487},{"h":0.011627906668205679,"text":"many things he can't do. He knows, for","x":0.68736142203663475,"y":0.31831395356996695,"w":0.25942350387573243},{"text":"instance, that he is difficult to live with","h":0.0132788413870355,"x":0.68514412931158775,"y":0.33265139107120567,"w":0.26164079666137696},{"y":0.34878411947401422,"w":0.25299800872802736,"h":0.01189421280706382,"text":"because he cannot understand what","x":0.68503998655552867},{"h":0.011627906668205679,"y":0.36482558162229251,"w":0.26164079666137696,"x":0.68514412168039796,"text":"others are feeling. He admits that most"},{"text":"of the time, he has to pretend to show","w":0.26385808944702149,"x":0.68514412323657803,"h":0.013145624323094185,"y":0.37929623589677486},{"h":0.013224127639920313,"w":0.08425720214843746,"x":0.6851441273071559,"y":0.39389534864641007,"text":"emotions. 4"},{"y":0.39680232588693465,"w":0.15299334526062003,"h":0.010317150387553209,"x":0.78048780375549942,"text":"_He reveals that when"},{"text":"his cat died, he cried and understood","y":0.41121112913294966,"x":0.68514412065082564,"w":0.25942350387573243,"h":0.010300498547218373},{"x":0.68514413033493271,"w":0.16851440429687503,"h":0.011865793780687417,"text":"grief* for the first time.","y":0.42716857608659697},{"x":0.68514412199310959,"h":0.013100426247779406,"text":"In 2004, Daniel met Kim Peek, the","w":0.2394678497314453,"y":0.45784883745454952},{"x":0.68514412756731591,"w":0.26164079666137696,"h":0.011651695457495892,"text":"savant on whom Rain Man was actually","y":0.47381342060916509},{"text":"based. Unlike Daniel, Peek, who passed","w":0.26164079666137696,"x":0.6851441282214179,"y":0.48977086733961817,"h":0.011865793780687306},{"w":0.2572062110900879,"y":0.50572831408460617,"h":0.011865793780687417,"x":0.68514412605140818,"text":"away in 2009, was unable to manage"},{"h":0.015283626737454203,"y":0.51853288397716624,"w":0.18450830459594736,"text":"daily life independently. 5","x":0.68492648306382586},{"y":0.5203488371697732,"x":0.88248337041562475,"h":0.011627906668205679,"text":"'We","w":0.031042127609252956},{"h":0.011627906668205679,"y":0.53633720952926922,"x":0.68514411962125332,"w":0.2572062110900879,"text":"swapped facts and figures like others"},{"y":0.55073649749038667,"w":0.25498889923095702,"x":0.68514413029028642,"h":0.013216990690964936,"text":"swap gossip,' says Tammet. With the"},{"y":0.56669394420840136,"text":"help of his father, Peek travelled","w":0.2283813667297363,"h":0.011865793780687417,"x":0.68514412531029822},{"y":0.58016087895346335,"h":0.018184533876209885,"w":0.22051528930664055,"text":"America spreading the message","x":0.68678545497244958},{"y":0.5988372095475728,"w":0.2283813667297363,"text":"that difference is not necessarily","h":0.013274083160924821,"x":0.68514413189751167},{"w":0.11751662254333495,"h":0.011627906668205679,"text":"a negative thing","y":0.61482558162229251,"x":0.68514412628376486},{"y":0.64525368226985602,"h":0.014729950900163713,"w":0.40354766845703127,"x":0.51884701170644365,"text":"Like Peek, Daniel is putting his gifts to good use. He gives"},{"x":0.52106429317573744,"text":"regular lectures, has written three successful books, and","y":0.66121112914519697,"w":0.39467849731445315,"h":0.011865793780687417},{"text":"been the subject of numerous studies and documentaries.","x":0.52106430828811401,"y":0.67587209317752506,"h":0.011627906668205679,"w":0.40354766845703127},{"x":0.52106430643600166,"y":0.6918604653068855,"h":0.011627906668205679,"w":0.42128601074218752,"text":"Much of his work involves helping scientists understand how"},{"text":"the brain works. 'I used to long* to be like other people,","h":0.013257431320589985,"x":0.5210643074854362,"y":0.70621931262020932,"w":0.3991130828857421},{"h":0.011651695457496003,"y":0.72381342060916498,"w":0.42350330352783194,"text":"he says. 'But they tell me that I have the same effect on them","x":0.5210643169943987},{"text":"as Professor Stephen Hawking. That in the contradiction*","w":0.3991130828857421,"x":0.5210643014248304,"y":0.73837209326850306,"h":0.013264568269545474},{"y":0.7528641568107064,"text":"between ability and disability, they see humanity.'","x":0.52106430365371859,"h":0.01312421503706962,"w":0.35254989624023447},{"y":0.8401162791368274,"text":"GLOSSAR","x":0.050997783418742844,"h":0.011627906668205679,"w":0.079822616577148453},{"text":"texture (n) = the way a surface or material feels when you touch it","y":0.8604651163751994,"h":0.011627906668205679,"w":0.46119731903076172,"x":0.057649682125417281},{"x":0.055432363776839466,"y":0.8735465114371076,"h":0.013114699365269433,"w":0.43680709838867188,"text":"lumpy (adj) = covered with or containing small solid pieces"},{"h":0.013274083160924821,"x":0.057649668168618738,"text":"e.g. a lumpy mattress","y":0.88788870729150238,"w":0.16407981872558591},{"h":0.013095668802089677,"y":0.90261627887896811,"w":0.41906871795654294,"x":0.057649674096377515,"text":"trace (v) = copy a drawing by putting a very thin piece of"},{"w":0.44567626953124995,"h":0.011656453293396152,"y":0.91857610460466033,"x":0.057649674569186439,"text":"paper over it and then drawing the lines you can see through"},{"text":"the paper","x":0.057649669832321775,"w":0.073170728683471686,"y":0.93313953507419234,"h":0.010174418042022126},{"w":0.013303768634796147,"h":0.010174418042022237,"text":"8","x":0.05764966767816735,"y":0.95930232573552976},{"x":0.55210643326762476,"text":"grief (n) = extreme sadness caused by the death of","y":0.86046511614277632,"h":0.013102804970624216,"w":0.37472282409667967},{"w":0.13747227668762219,"x":0.54988913964953712,"y":0.87643207845978188,"h":0.010229132569558153,"text":"someone you love"},{"h":0.013559741006154979,"w":0.41039333343505868,"text":"long (v) = want something very much, especially when it","x":0.54977816047249017,"y":0.88932725050278993},{"h":0.011642180175906014,"y":0.90406976752345547,"text":"seems unlikely to happen","w":0.18847005844116205,"x":0.54988914164970726},{"text":"contradiction (n) = a difference between two statements,","y":0.91857610484313967,"x":0.55210644623237126,"w":0.41906871795654299,"h":0.010229132569558042},{"h":0.013098047524934486,"text":"beliefs or ideas that means they cannot both be true","x":0.5521064403156829,"w":0.37915740966796874,"y":0.93166939447182395}]
2565,"w":0.18444444656372067,"y":0.75872093052542344},{"h":0.011836734693877582,"text":"do now is to monitor those forests which are rarely visited and","x":0.033333344921549435,"y":0.77306122430020452,"w":0.4044444274902344},{"h":0.011836734693877471,"x":0.033333346865993825,"w":0.4044444274902344,"y":0.78775510204961396,"text":"not very well-documented. People are requested to notify the"},{"y":0.8008163266815711,"text":"police or fire brigades about any visible smoke.","w":0.30444442749023443,"x":0.033333346884512276,"h":0.01313716187769054},{"x":0.066666666934091123,"y":0.83866279099053975,"text":"A expressions","w":0.1111111068725586,"h":0.011627906487912565},{"h":0.011851777057258484,"x":0.068852973509591214,"text":"C changes","w":0.084516277313232413,"y":0.85308573930287412},{"x":0.068888890134806285,"y":0.86612244897933699,"h":0.011836734693877582,"text":"A hurricanes B drought","w":0.18444444656372069},{"x":0.042222222442248027,"text":"2","w":0.01111111044883728,"h":0.0087209296713069984,"y":0.88081395368178828},{"h":0.0087209296713069984,"text":"A Not","x":0.059999999000000026,"y":0.8808139538174472,"w":0.059999999999999998},{"text":"B Hardly","y":0.8777103272310216,"h":0.015270178658621569,"w":0.072923474311828607,"x":0.16804806506641143},{"y":0.89387755084254661,"w":0.16666666030883789,"h":0.011836734693877582,"text":"A not only B if only","x":0.068888890678914405},{"x":0.042222222442248027,"w":0.01111111044883728,"text":"4","y":0.90843023289690461,"h":0.0087209296713069984},{"h":0.0087209296713069984,"y":0.90843023288721469,"x":0.055555555689267774,"w":0.055555553436279298,"text":"A lt's"},{"text":"B There's","y":0.90688070067065907,"h":0.011819993233194159,"x":0.17107557354450265,"w":0.073404407501220709},{"text":"5 A Despite B All","w":0.16888889312744138,"x":0.042222220147390403,"h":0.013182250042350963,"y":0.92151162787484686},{"y":0.83851701485940222,"x":0.27106557183948554,"w":0.075646634101867671,"text":"situations","h":0.010465969942053954},{"h"
489782709437},{"text":"of living in a remote place before you move there.","w":0.38222221374511722,"x":0.5511111089792935,"y":0.64530612263028331,"h":0.013124110163474589},{"w":0.3977777862548828,"y":0.6583673466307377,"h":0.014693877551020473,"x":0.52444444517811406,"text":"4 It's a pity we can't join you on your expedition to"},{"h":0.011836734693877582,"y":0.67428571443769325,"w":0.28666666030883792,"text":"Greenland. It sounds very interesting.","x":0.55333333937891438},{"y":0.6889534885292995,"x":0.55111111186490946,"h":0.011627906487912565,"text":"ONLY","w":0.048888888359069904},{"h":0.010174418079609726,"y":0.70348837225379979,"x":0.54888888873377251,"w":0.017777777910232606,"text":"If"},{"y":0.70238232812237655,"w":0.14538741111755371,"x":0.78850878599530461,"h":0.01664910919812268,"text":"on your expedition"},{"y":0.71795918354673527,"text":"to Greenland. It sounds very interesting.","w":0.30666666030883794,"h":0.011836734693877582,"x":0.55333334162335857},{"y":0.73102040830753079,"h":0.013165638203523566,"w":0.40222221374511724,"text":"5 We have never dumped any rubbish in the forest.","x":0.52666667471077455},{"y":0.7470930234456602,"w":0.031111111640930167,"text":"WE","h":0.010174418079609837,"x":0.55111111115731259},{"w":0.048888888359069904,"h":0.0087209296713069984,"text":"Never","y":0.76162790719923024,"x":0.5533333340871317},{"y":0.76162790741495845,"h":0.011627906487912565,"w":0.11555555343627932,"x":0.81777777802260121,"text":"_any rubbish in"},{"x":0.55320571109288075,"text":"the forest","y":0.77428983640086635,"w":0.075810799598693857,"h":0.011013350194814198},{"text":"Total","x":0.82444444550056828,"y":0.81976744174112581,"h":0.013081395674724883,"w":0.05333333015441899},{"x":0.93333333417338482,"y":0.79360465152348558,"h":0.011627906487912565,"w":0.022222220897674561,"text":"\/5"},{"text":"120","h":0.013081395674724994,"x":0.91333333328976751,"y":0.81976744182833516,"w":0.035555555820465101},{"h":0.013081395674724994,"y":0.960755813627027,"w":
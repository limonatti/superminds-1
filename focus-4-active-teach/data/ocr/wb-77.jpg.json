1836734693877582,"w":0.36666664123535153,"text":"actually plugged into the back of the computer?"},{"text":"MB: What? Of course it ... Oh dear. Ollie, I think I owe","x":0.52000001236599369,"y":0.86191860508937712,"h":0.011627906487912565,"w":0.42444442749023448},{"y":0.87632653042507613,"text":"you an apology.","h":0.010301376264922446,"w":0.12444443702697749,"x":0.56888889467169634},{"text":"Ollie: That's OK, Mr Brown. And are you able to switch it","y":0.88938775527671465,"x":0.52000001358005077,"w":0.43333332061767582,"h":0.011836734693877582},{"y":0.90251355559091784,"x":0.56885236953925433,"text":"on now?","w":0.066739706993102943,"h":0.010379865218182016},{"x":0.51777778445260936,"y":0.91424418640172456,"h":0.01473540559106945,"w":0.29111110687255859,"text":"MB: Er... yes. Yes, that's it, problem ?"},{"text":"Sorry, Ollie.","x":0.5688309228262266,"y":0.93003626182261745,"w":0.091227045059204093,"h":0.012020499560297715},{"x":0.52000000986818196,"y":0.94326530637515249,"text":"Ollie: No need to apologise. We are here to help.","w":0.38222221374511711,"h":0.013130042406977349},{"x":0.91777777757088952,"h":0.013081395674724994,"text":"75","y":0.96220930208996291,"w":0.026666667461395344}]
53047626722,"x":0.73111111142310081,"w":0.035555555820465101,"h":0.0074525393271932527},{"y":0.30637625231318588,"h":0.015235103685028784,"text":"you remember? What 'a","w":0.1894855880737305,"x":0.56186547972592704},{"text":"d","x":0.86000000022002576,"y":0.29505813972829997,"w":0.01111111044883728,"h":0.0087209296713069984},{"text":"we","y":0.31104651199931177,"x":0.84666666639171406,"w":0.024444444179534952,"h":0.0072674412630042706},{"text":"to do n","h":0.010174418079609726,"x":0.67111111211111107,"w":0.060000000000000053,"y":0.32267441884294712},{"y":0.33575581383414921,"text":"Zack: Don't panic! I can go to the website and pay it","x":0.51555555577188583,"w":0.40222221374511724,"h":0.013223778082399829},{"w":0.077777776718139569,"x":0.5644444462705599,"y":0.35174418628480741,"h":0.010296630080865454,"text":"right now."},{"text":"Rob: Think about it for a second, Zack ...","x":0.51777778303893141,"y":0.36326530607348961,"h":0.011836734693877471,"w":0.3177777671813965},{"y":0.38367346973155647,"text":"4 Complete the dialogues with the words and phrases","h":0.013128855958276953,"x":0.49111112514377153,"w":0.44444442749023438},{"h":0.013172757674236757,"text":"that appeared in the lesson.","x":0.51555556058632168,"y":0.39825581357252116,"w":0.22666666030883786},{"text":"Conversation 1","h":0.01023255795848621,"x":0.49111111214909542,"y":0.41999999997303383,"w":0.12888888359069828},{"y":0.43591836700218145,"w":0.19999999999999996,"h":0.013209539919483482,"text":"Kate: Hello, Mum? Help!","x":0.51555555711111112},{"h":0.011627906487912565,"y":0.45058139564170263,"w":0.21555555343627941,"x":0.51555555302260125,"text":"Mum: Kate? What's wrong?"},{"text":"Kate: Oh Mum, I need my jeans for tonight, but they","w":0.40888889312744137,"x":0.51777777974739025,"h":0.013081395674724994,"y":0.46366279049112591},{"h":0.015319082299057207,"w":0.34034397125244142,"x":0.57099067387655678,"y":0.47603827450172798,"text":"are still wet and I can't get the dryer working"},{"y":0.49127906986650882,"w":0.15777777671813964,"h":0.011627906487912565,"x":0.51777778093722648,"text":"Mum: Well, what's 1"},{"text":"Kate: How2","y":0.50571428570478727,"x":0.51777777830351424,"w":0.10222222328186037,"h":0.010274085998535187},{"x":0.78000000053594309,"w":0.13111110687255856,"h":0.010274085998535187,"text":"? I've never even","y":0.50571428570478727},{"x":0.57111111458945718,"h":0.010263407570975214,"text":"used it before.","w":0.11333333015441893,"y":0.52034883749604777},{"x":0.51777778101961247,"w":0.42888889312744138,"h":0.013100379632443704,"text":"Mum: Well, if you helped me more with the housework,","y":0.53343023237702714},{"text":"you might know how to use it. I suggest you","w":0.33777774810791017,"x":0.57111113157567428,"y":0.54796511604345144,"h":0.013259373878946046},{"w":0.27555555343627935,"y":0.5624489795196721,"h":0.011836734693877582,"x":0.57111110872630488,"text":"simply wear something else tonight."},{"h":0.013152586489307727,"y":0.5755102042986362,"w":0.43555553436279304,"text":"Kate: Mum! Those jeans are the only thing that matches","x":0.51777779563341819},{"y":0.59142857157583306,"x":0.57333333544130893,"h":0.010315614038584275,"text":"my new top.","w":0.093333330154418914},{"h":0.013128855958276953,"y":0.60319767427988558,"x":0.51555555435593459,"w":0.13555555343627923,"text":"Mum: Well you 3"},{"y":0.60319767451155171,"w":0.13555555343627923,"x":0.81333333576334188,"h":0.010271713101134061,"text":"about that earlier."},{"y":0.61755102040204335,"text":"All you can do now is put them on the radiator.","w":0.35777774810791008,"h":0.013262933225047902,"x":0.57333335413122999},{"y":0.63510204088594091,"h":0.010246796121402668,"w":0.12888888359069822,"text":"Conversation 2","x":0.49333333490835457},{"y":0.65102040818156137,"w":0.395555534362793,"text":"Ollie: Hello, Computer World helpline. This is Ollie.","h":0.01322377808239994,"x":0.5177777834297147},{"w":0.12444443702697749,"h":0.011627906487912565,"text":"How can I help?","y":0.66569
"h":0.01314309412119341,"y":0.38808139540391662},{"h":0.011627906487912565,"text":"Nearby you can see a","x":0.024444446329819042,"y":0.40116279082581108,"w":0.15777777671813967},{"text":"- the water is so clear","y":0.40244897964640625,"h":0.0089795918367346905,"w":0.1555555534362793,"x":0.26666666578186038},{"y":0.41424418620371817,"w":0.13999999999999999,"h":0.011627906487912454,"text":"that you can drink it!","x":0.024444445844444437},{"x":0.022222220452609704,"w":0.31111110687255861,"text":"Today we're going hiking again. There's a flat?","y":0.42877906969534085,"h":0.013261746776347394},{"h":0.011836734693877582,"y":0.44326530616388626,"x":0.024444459196381205,"w":0.41555553436279297,"text":"not far from here and Andy won't have any problems walking"},{"text":"there. So, l'd better get my boots on and join the others!","y":0.45632653066617723,"h":0.011836734693877471,"x":0.024444457727104948,"w":0.38444442749023439},{"text":"Bye for now,","w":0.086756038665771473,"x":0.024399758084909705,"h":0.011914508975282012,"y":0.47224041958979446},{"y":0.48982558156696276,"x":0.024444443923100804,"w":0.035555555820465087,"text":"Anna","h":0.0087209296713071094},{"h":0.013251067959532459,"text":"WORD STORE 8C | Animals","y":0.52163265307308193,"w":0.23111110687255859,"x":0.0088888929340910396},{"h":0.013191741631955467,"text":"6 Complete the biologist's notes with the words in the","y":0.54204081659784886,"x":0.011111115511111045,"w":0.44000000000000006},{"h":0.011836734693877582,"text":"box. There are two extra words.","x":0.035555560874452788,"y":0.5579591836372596,"w":0.25555555343627934},{"text":"breeding grounds extinction hatch in captivity","x":0.055555569855640419,"y":0.58284883682833522,"w":0.39555553436279295,"h":0.013081395674724883},{"x":0.055499221813144095,"text":"migration","w":0.075668220520019536,"h":0.011943204451580369,"y":0.59867956065654582},{"y":0.59877551026719378,"h":0.010236117304587844,"w":0.11777777671813963,"x":0.14666666915944862,"text":"natur
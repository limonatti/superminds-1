[{"w":0.4488888931274414,"text":"6 Choose the correct words to complete the sentences.","x":0.013333336825168053,"y":0.044897959047759395,"h":0.011836734693877582},{"h":0.011836734693877471,"y":0.062448979749043287,"text":"Some habitats have been destroyed,(whereas","x":0.062222234143771649,"w":0.34444442749023441},{"h":0.01031205469248242,"y":0.077034883939846255,"text":"nevertheless others have not.","w":0.21999999999999997,"x":0.06222222442222218},{"text":"It is wrong to keep animals in captivity. That said \/","x":0.055416174904652102,"h":0.015628814697265736,"y":0.088936884328221222,"w":0.38482402801513677},{"x":0.062222234454503748,"y":0.10610465135875691,"w":0.28888887405395508,"h":0.011627906487912565,"text":"Saying that, zoos do an important job."},{"x":0.037777793318603405,"w":0.395555534362793,"y":0.11918367343311431,"text":"2 Actually \/ While some species have disappeared,","h":0.01308376857212612},{"text":"many others have survived","y":0.13179927103138245,"w":0.20073883056640626,"x":0.061858524897789237,"h":0.015737145871532299},{"x":0.035555565197139136,"w":0.32666664123535161,"text":"3 It may seem too late to save the planet,","y":0.14816326556035542,"h":0.013173944122937264},{"w":0.26888887405395506,"text":"nevertheless \/ whereas we must try.","h":0.011627906487912565,"y":0.16279069791883438,"x":0.062222234121170457},{"w":0.4311111068725586,"x":0.035555553600757864,"text":"4 In spite of the hunters in the area, the tiger yet \/ actually","h":0.013107499103156783,"y":0.17587209264228876},{"x":0.062222222892971468,"h":0.011836734693877582,"text":"managed to escape.","w":0.1555555534362793,"y":0.19183673468431528},{"y":0.20489795938894706,"text":"5 Many people object to zoos. While \/ Having said this,","w":0.43111110687255866,"h":0.013125296612175097,"x":0.037777787082239021},{"w":0.22666666030883792,"y":0.22081632672064977,"h":0.010288324161451645,"text":"they remain major attractions.","x":0.062222228234469837},{"text":"6 Solar energy can solve many problems, yet \/ actually","x":0.037777786238552442,"w":0.42222221374511715,"h":0.013215472162986241,"y":0.23387755118309717},{"text":"not enough people are using it.","y":0.24854651139228867,"w":0.23777776718139648,"x":0.062222229898190588,"h":0.013086141469527246},{"text":"7 Some solutions are not perfect; even so \/ while,","y":0.2630813955641832,"x":0.037777790099327184,"w":0.38444442749023433,"h":0.011627906487912565},{"text":"they are better than doing nothing.","x":0.062222234121170457,"y":0.2775510203538486,"w":0.26888887405395506,"h":0.011836734693877582},{"h":0.013087328696737455,"y":0.29795918331213667,"w":0.455555534362793,"x":0.013333347670455247,"text":"7 Read the task and the letter. Then complete the letter"},{"x":0.037777788676726057,"text":"with the words in the box.","y":0.31387755087556912,"h":0.0089795918367348015,"w":0.20888887405395506},{"w":0.2577777671813965,"x":0.057777781298190688,"y":0.33866279069824801,"text":"actually nevertheless that said","h":0.013173944122937264},{"text":"whereas","y":0.35455557020950312,"h":0.0089121152916733504,"x":0.057748675927330934,"w":0.066724872589111334},{"w":0.086730756759643535,"x":0.13774573128731768,"text":"while yet","h":0.010409173770826619,"y":0.35453378528419777},{"w":0.27111110687255868,"text":"SHOW WHAT YOU'VE LEARNT","x":0.50888889326742426,"y":0.050872093194997192,"h":0.011627906487912565},{"h":0.011627906487912565,"text":"8 Read the task below. Before you start writing, note","x":0.49999999673038759,"y":0.077034884001683235,"w":0.43111110687255855},{"w":0.39111110687255857,"y":0.091428571301709782,"text":"down some ideas and plan your piece of writing.","x":0.5222222292303873,"h":0.011836734693877582},{"x":0.53777779002449533,"text":"The Daily Sentinel Environment Section","y":0.12204081620566143,"h":0.011836734693877582,"w":0.35333332061767575},{"text":"We would like our readers' views on climate change.","x":0.53777779590084251,"y":0.14081632618738438,"h":0.013253441635443175,"w":0.34666664123535151},{"text":"• How serious is it?","w":0.13111110687255867,"y":0.15836734684844234,"h":0.0073469387755101812,"x":0.52222222270260965},{"text":"• How can we stop it from causing more damage to the","w":0.36666664123535153,"y":0.17142857123821531,"h":0.010257474938217492,"x":0.52222224104899073},{"y":0.18604651183585807,"h":0.0087209296713071094,"w":0.091111106872558634,"text":"environment?","x":0.54000000325816511},{"x":0.52222222983114508,"y":0.19912790712426076,"w":0.20222221374511717,"h":0.011627906487912565,"text":"• Is there hope for the future?"},{"x":0.54000000777041279,"h":0.011627906487912565,"text":"Send your letters to the editor.","y":0.21947674435778786,"w":0.1977777671813965},{"h":0.011627906487912565,"x":0.044444448139982773,"text":"The Daily Sentinel Environment Section","y":0.39098837228898953,"w":0.34888889312744137},{"w":0.2666666603088379,"text":"We would like our readers' views on zoos.","y":0.40843023265720646,"h":0.011627906487912565,"x":0.044444448401136614},{"y":0.42441860478656701,"text":"• Do you think it is wrong to keep animals in zoos?","h":0.011627906487912565,"w":0.33333332061767573,"x":0.028888899413384229},{"text":"• Are there any good reasons to keep animals in captivity?","h":0.011836734693877471,"w":0.36222221374511721,"y":0.43877551030327622,"x":0.028888897655219098},{"y":0.45784883726438164,"w":0.19555555343627931,"h":0.013171571225536138,"x":0.044444443652230776,"text":"Send your letters to the editor."},{"h":0.011627906487912565,"text":"SHOW THAT YOU'VE CHECKED","x":0.51111111461111103,"y":0.27180232575313679,"w":0.28000000000000003},{"x":0.50666666984558117,"y":0.29505813915391665,"text":"In my letter:","w":0.10666666030883787,"h":0.013105126205755768},{"w":0.28888887405395502,"h":0.013114618573869974,"x":0.50888889697302264,"text":"• I have begun with a formal greeting","y":0.3183139531619108},{"h":0.011836734693877693,"w":0.13777777671813962,"text":"(e.g. Dear Editor).","y":0.33265306139967343,"x":0.52444444727055983},{"h":0.013153773716517825,"text":"• in the first paragraph I have explained my","y":0.35174418566554455,"x":0.51111110986001707,"w":0.33111110687255862},{"text":"C","x":0.9177777783511627,"y":0.35755813920848611,"w":0.022222220897674561,"h":0.014534884083027722},{"h":0.013238016245316508,"text":"reason for writing and expressed my view.","x":0.52444444864785456,"y":0.36612244910658087,"w":0.31999998092651361},{"h":0.025077016402264007,"w":0.42992553710937509,"x":0.51074792061589402,"text":"•inthe main paragraphs Ihave supportedmy point C","y":0.37928409545100439},{"text":"of view, given further opinions and examples.","x":0.52666668145749229,"y":0.40116279094202645,"h":0.01026578046837634,"w":0.33555553436279295},{"text":"• in the last paragraph, I have summarised my opinion. C","w":0.42920177459716802,"h":0.016191773706552892,"y":0.41994832824501072,"x":0.51099059172204675},{"x":0.51111111676633025,"text":"• I have used an appropriate formal ending","h":0.013130042406977349,"w":0.32222221374511728,"y":0.44326530642965833},{"text":"C","w":0.019999999999999907,"x":0.91999999988888892,"h":0.013081395674725105,"y":0.4491279066829863},{"w":0.15555555343627936,"x":0.52444444683741576,"h":0.011627906487912565,"text":"(e.g. Yours faithfully).","y":0.45784883725991965},{"h":0.011836734693877582,"text":"• I have used formal language.","w":0.23111110687255854,"x":0.51111111611927629,"y":0.47959183670753658},{"text":"• I have not used contractions (e.g. that's, there's,","x":0.51111111360294581,"w":0.36888889312744144,"h":0.011627906487912565,"y":0.50145348861650885},{"text":"we're).","x":0.52666666576286825,"h":0.0087209296713069984,"w":0.051111111640930185,"y":0.51744186081841625},{"h":0.011627906487912565,"text":"• I have checked my spelling","x":0.51111111277967225,"y":0.53779069796728396,"w":0.21777776718139652},{"h":0.011629093325867923,"x":0.51111111964974887,"w":0.37777774810791009,"y":0.5595918367107241,"text":"• my handwriting is neat enough for someone else"},{"y":0.5741279070696913,"text":"to read.","w":0.062222218513488858,"x":0.52666666911362592,"h":0.010361889041199945},{"x":0.031111116375400094,"y":0.5043604653606949,"text":"Dear Sir or Madam,","w":0.12444443702697755,"h":0.011627906487912565},{"h":0.011836734693877582,"x":0.028888889872558464,"text":"I am writing to you in response to your request for views about","w":0.41777778625488282,"y":0.52163265307907436},{"x":0.028888879428114293,"y":0.53632653080260095,"h":0.011836734693877582,"text":"zoos. While I understand that keeping animals in captivity can","w":0.41777778625488282},{"x":0.031111127493435264,"text":"be cruel, I would like to point out that for many species,","w":0.36666664123535159,"h":0.011627906487912565,"y":0.55087209323860187},{"h":0.011627906487912454,"text":"Zoos1","x":0.028888890657880976,"y":0.56250000005061751,"w":0.044444441795349121},{"text":"offer their only hope for survival.","y":0.56530612228017074,"h":0.011836734693877471,"w":0.22,"x":0.15777777411111124},{"y":0.58284883736650883,"w":0.40444442749023435,"h":0.011627906487912565,"text":"Having been a volunteer at a zoo, I have personally seen how","x":0.031111123632660487},{"x":0.028888893226011163,"w":0.37555553436279293,"text":"they work to protect endangered species. Animals in the","y":0.59738372122309802,"h":0.011627906487912454},{"h":0.013208353470782863,"y":0.61046511598531195,"x":0.031111118980050988,"w":0.17333332061767578,"text":"wild face many dangers,2."},{"text":"wildlife in captivity","y":0.61183673453412113,"h":0.011836734693877471,"x":0.28666666716761391,"w":0.12888888359069822},{"text":"is safe from threats that can lead to extinction. One of these","w":0.395555534362793,"x":0.031111125485270036,"h":0.010276458895936313,"y":0.62489795927662051},{"y":0.63953488377154766,"x":0.031111127929714398,"w":0.395555534362793,"text":"is the loss of natural habitats. With nowhere to live or breed,","h":0.011627906487912565},{"h":0.011836734693877582,"text":"species cannot survive. Another danger is disease, which can","y":0.65387755085720933,"w":0.40888889312744142,"x":0.031111114102945835},{"h":0.011836734693877582,"text":"spread quickly and greatly reduce a population. Hunters are","y":0.66857142855651108,"x":0.028888882222222492,"w":0.40000000000000002},{"h":0.011836734693877582,"text":"also a threat, 3","x":0.031111112640930152,"y":0.6816326529158756,"w":0.097777776718139656},{"text":"despite this, they continue to kill","x":0.21333333779410807,"y":0.68313953532193517,"w":0.22222221374511719,"h":0.011627906487912565},{"x":0.031111117067803187,"text":"for profit in many places.","w":0.16666666030883792,"h":0.011836734693877582,"y":0.69755102035066119},{"y":0.71510204068933736,"h":0.011836734693877582,"w":0.37555553436279299,"x":0.031111126401936744,"text":"Zoos often play a very important role in saving a species"},{"y":0.72965116322891199,"h":0.011627906487912454,"w":0.37555553436279299,"x":0.031111119818603612,"text":"from extinction. Experts in different fields can contribute"},{"x":0.031111130271212914,"y":0.74408163260461169,"text":"to our knowledge of animal habits and behaviour and help","w":0.38666664123535155,"h":0.011836734693877582},{"text":"zoos create breeding programmes. Whenever possible,","w":0.36888889312744139,"y":0.75872093047697398,"x":0.031111115139982815,"h":0.011627906487912565},{"x":0.033333353909007712,"y":0.7730612243486541,"w":0.39777774810791017,"text":"bred animals are released back into the wild, where they are","h":0.011836734693877582},{"x":0.031081902817579329,"y":0.78768504027627706,"h":0.0089322452155912169,"w":0.073391747474670407,"text":"monitored."},{"w":0.30666666030883788,"text":", not all programmes are successful, but they","x":0.12222223051224752,"h":0.01313716187769054,"y":0.80081632658467183},{"text":"are worth trying.","y":0.81673469397693665,"x":0.033333337845581033,"h":0.010300189426966977,"w":0.1066666603088379},{"text":"It may be considered wrong to keep animals in zoos, 5","y":0.82979591828804267,"h":0.014693877551020473,"x":0.033333353834933632,"w":0.35777774810791013},{"w":0.43777774810791015,"text":", it is undeniable that zoos provide a safe place for animals to live","x":0.47555557586271135,"y":0.83265306127854966,"h":0.011836734693877471},{"y":0.84734693862735611,"h":0.011836734693877582,"text":"and breed. Perhaps more importantly, they give endangered species a chance to survive. To my mind, zoos have become increasingly","x":0.033333341398654709,"w":0.88888885498046877},{"h":0.011627906487912454,"x":0.033333346826768633,"w":0.52666664123535156,"y":0.86191860470178028,"text":"necessary as natural habitats are destroyed and more species become extinct."},{"w":0.10718280792236329,"y":0.87975639057373345,"text":"Yours faithfully,","h":0.010911500113350958,"x":0.030880054670903458},{"y":0.89825581419777689,"w":0.084444446563720715,"text":"Emma Dixon","h":0.0087209296713069984,"x":0.033333333329250737},{"x":0.9222222232242635,"y":0.95930232536394566,"h":0.013081395674724994,"w":0.037777776718139644,"text":"127"}]
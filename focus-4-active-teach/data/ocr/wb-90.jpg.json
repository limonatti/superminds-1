[{"x":0.053333333185185197,"w":0.080000000000000002,"text":"6.4","y":0.047965116300234811,"h":0.047965115916972278},{"text":"READING","y":0.028656553047874067,"w":0.16244384765625,"x":0.18877807527153387,"h":0.019721777779715399},{"x":0.18888889258005107,"w":0.21333332061767582,"y":0.071020407801231533,"text":"Is the news good for you?","h":0.01346938775510198},{"x":0.18666667419116209,"y":0.087209302715345993,"w":0.21333332061767576,"h":0.011627906487912565,"text":"• verbs and verb patterns"},{"text":"• photography","x":0.18429991208998431,"h":0.017010521402164414,"y":0.099779622827065539,"w":0.12917795181274416},{"h":0.010174418079609726,"y":0.045058139627830784,"text":"1","w":0.013333332538604803,"x":0.53333333358254942},{"h":0.013241575591418253,"y":0.044897959479471394,"text":"Read the article and choose the best description.","x":0.55333334153863778,"w":0.39777774810791011},{"w":0.38222221374511711,"text":"1 The text aims to persuade people to watch and","x":0.56000000041633047,"y":0.062448979505137281,"h":0.011836734693877582},{"w":0.34444442749023441,"x":0.5844444471808089,"text":"read less news because it can have an impact","h":0.011627906487912565,"y":0.077034884013795657},{"x":0.58666666857891447,"w":0.12666666030883789,"h":0.011627906487912565,"y":0.090116279401392552,"text":"on how you feel."},{"y":0.10465116312946277,"h":0.0087209296713069984,"w":0.01111111044883728,"x":0.56000000022002583,"text":"2"},{"x":0.58666667129932737,"y":0.10319767429926541,"text":"The text aims to inform people about the potential","w":0.38444442749023433,"h":0.013128855958276842},{"text":"negative effects of watching and reading the news","w":0.38222221374511722,"y":0.11755102051704736,"x":0.58444444390521932,"h":0.011836734693877582},{"x":0.58444444884747559,"y":0.13061224466285071,"w":0.24444442749023432,"text":"and what you can do about this.","h":0.013469387755102091},{"x":0.56000000024780361,"y":0.14534883738091631,"h":0.0087209296713069984,"w":0.01111111044883728,"text":"3"},{"w":0.37777774810791009,"text":"The text aims to recommend the best way to read","x":0.58444445298308212,"h":0.011836734693877582,"y":0.14530612257571374},{"text":"or watch the news so that you do not feel anxious","y":0.15836734666701124,"x":0.58666667769116199,"h":0.013144281348403619,"w":0.37333332061767577},{"text":"or worried","y":0.17286738348297626,"h":0.010369883946010017,"x":0.58663770430062123,"w":0.080057926177978578},{"w":0.45777778625488275,"text":"Is the news good for you?","x":0.079999998622558549,"y":0.17142857141014789,"h":0.026245847429548053},{"y":0.21656976763782665,"h":0.011627906487912565,"text":"Keeping up with what is happening","x":0.097777784201515422,"w":0.26222221374511723},{"h":0.013115804244060891,"x":0.080000002799999942,"w":0.28000000000000003,"y":0.22816326564272016,"text":"in the world is generally seen as an"},{"w":0.27999999999999997,"y":0.24273255845662511,"text":"essential part of being a well-informed","h":0.011627906487912565,"x":0.079999996500000101},{"y":0.25581395380546235,"w":0.27999999999999997,"text":"and educated citizen. Watching, listening","h":0.011627906487912565,"x":0.079999996500000101},{"x":0.08000000349999993,"y":0.26889534900895073,"h":0.011627906487912565,"w":0.28000000000000003,"text":"to or reading the news can satisfy"},{"text":"our curiosity, make us think, help us","x":0.080000007766330233,"y":0.28326530623987578,"h":0.011836734693877582,"w":0.28222221374511713},{"y":0.29632653067025672,"text":"make choices and even avoid danger.","h":0.011836734693877582,"w":0.27999999999999997,"x":0.080000004074073913},{"text":"Or at least that was the common view","y":0.30959302346382889,"x":0.082222230992635023,"w":0.27777776718139646,"h":0.010174418079609726},{"y":0.32267441890720649,"x":0.079999997200000048,"text":"until recently. However, people are","w":0.27999999999999997,"h":0.011627906487912565},{"x":0.080000002799999942,"y":0.33575581413976474,"h":0.011627906487912565,"w":0.28000000000000003,"text":"increasingly wondering if staying up to"},{"text":"date with what is going on is good for us.","x":0.080000004666666485,"y":0.35020408170800499,"w":0.28000000000000003,"h":0.010261034284319237},{"x":0.095555560958586624,"y":0.36191860470178017,"text":"The frequency, speed and way we","w":0.26444442749023434,"h":0.011627906487912565},{"x":0.079868170855455278,"h":0.012793315186792498,"text":"access news has completely changed","y":0.37549791471135818,"w":0.28027866363525389},{"x":0.080000003666666542,"w":0.22000000000000003,"y":0.38938775527671476,"h":0.011836734693877582,"text":"over the past few decades."},{"h":0.011687398638044022,"text":"Whereas","y":0.38877839359478605,"x":0.29750718812099813,"w":0.062763400077819831},{"x":0.080000000672790533,"y":0.40406976779522408,"h":0.010174418079609837,"w":0.073333330154418952,"text":"previously"},{"y":0.40406976786783488,"x":0.17111111130759685,"w":0.037777776718139644,"h":0.0087209296713069984,"text":"most"},{"text":"newspapers","w":0.082222223281860324,"x":0.22444444288684764,"y":0.40552325613091633,"h":0.0087209296713068873},{"h":0.0072674420415138608,"w":0.035555555820465046,"text":"were","y":0.40552325577793491,"x":0.32444444386754528},{"w":0.27999999999999997,"x":0.079999996500000101,"y":0.41551020419969664,"h":0.011836734693877582,"text":"published daily and TV and radio news"},{"text":"broadcasts were limited, now","x":0.08000000747596836,"w":0.21777776718139646,"y":0.42877906998635784,"h":0.010174418079609837},{"x":0.30444444457815673,"y":0.4316860468830328,"w":0.05555555343627927,"h":0.0072674412630041596,"text":"we are"},{"y":0.44326530594171887,"w":0.27999999999999997,"text":"constantly bombarded with news from all","x":0.079999996500000101,"h":0.010223065979626744},{"y":0.45632653077512497,"x":0.08000000349999993,"h":0.010243236386046073,"w":0.28000000000000003,"text":"sides: we have 24-hour news channels,"},{"x":0.079999996500000101,"h":0.010263407570975214,"w":0.27999999999999997,"text":"apps to notify us about stories of interest","y":0.46938775504804486},{"text":"and social media that expose us to news","y":0.48244897941958542,"x":0.08000000349999993,"w":0.28000000000000003,"h":0.011836734693877693},{"y":0.49551020415437086,"h":0.010303749162323572,"text":"whether we want to see it or not. Online","w":0.27999999999999997,"x":0.079999996500000101},{"text":"newspapers are updated many times","x":0.08000000349999993,"y":0.51017441881266601,"w":0.28000000000000003,"h":0.010233744407186718},{"text":"a day, with \"breaking news' posts that","y":0.52163265300640005,"x":0.080000001388888867,"w":0.28000000000000003,"h":0.011836734693877582},{"text":"follow events in real time.","h":0.010364261549346332,"x":0.080000002409301843,"w":0.17777776718139648,"y":0.534693877553443},{"y":0.54796511648714841,"text":"The content of news reports is almost","x":0.095555557801472901,"w":0.26444444656372068,"h":0.011627906487912565},{"w":0.28000000000000003,"x":0.080000002799999942,"y":0.56244897977811292,"h":0.011836734693877582,"text":"always negative. Throughout history, our"},{"text":"survival has depended on noticing threats","x":0.080000004666666485,"y":0.57551020395171115,"h":0.011836734693877582,"w":0.28000000000000003},{"y":0.58857142850487421,"text":"and avoiding danger, so the human brain","h":0.011836734693877471,"x":0.080000004666666485,"w":0.28000000000000003},{"h":0.010285951264050519,"text":"is hard-wired to seek out information","x":0.079999997629629713,"y":0.601632652955018,"w":0.27999999999999997},{"text":"thatis","h":0.010174418079609726,"x":0.077777779657880963,"y":0.61482558148829602,"w":0.064444441795349139},{"y":0.61617170883296246,"w":0.077843174934387194,"h":0.010389140382105033,"text":"frightening","x":0.15996730219918459},{"h":0.0072674420415138608,"y":0.61773255799710025,"w":0.017777777910232551,"x":0.25555555539409008,"text":"or"},{"text":"alarming,","w":0.068888888359069811,"x":0.29111111252416877,"h":0.011627906487912565,"y":0.61627907001185767},{"h":0.011627906487912565,"w":0.28222221374511719,"x":0.077777777312626736,"y":0.62936046540914448,"text":"a concept known as 'negativity bias'*."},{"y":0.6424418606368576,"w":0.28000000000000003,"h":0.011627906487912565,"x":0.08000000349999993,"text":"We pay more attention to negative things"},{"text":"because that kept us alive in the past and","y":0.65551020424725415,"x":0.077777786720033854,"w":0.28222221374511725,"h":0.011836734693877582},{"x":0.077777786720033854,"w":0.28222221374511725,"h":0.010207640978754817,"text":"this is reflected in the news we consume.","y":0.6685714285503912},{"x":0.077777781415572511,"h":0.010227811774428996,"text":"In addition,","w":0.091111106872558578,"y":0.68163265305510456},{"x":0.16666667009856961,"w":0.19333332061767583,"h":0.011836734693877582,"text":"because people now use","y":0.68163265286742603},{"text":"smartphones","w":0.097777776718139642,"x":0.077777779937226399,"y":0.69622093037395472,"h":0.010174418079609837},{"w":0.13999999999999999,"y":0.69622093061008294,"h":0.0087209296713069984,"x":0.1755555532222223,"text":"to record events"},{"h":0.015325582076092137,"y":0.6934999997318283,"w":0.047767705917358405,"text":"live,","x":0.31656059132619391},{"y":0.2165697675348075,"x":0.37999999955555552,"h":0.010369008122658285,"text":"the news we see has become far more","w":0.28000000000000003},{"h":0.010258661386918,"y":0.23102040809377833,"x":0.38000000365223058,"w":0.1555555534362793,"text":"graphic and shocking."},{"y":0.24408163284073969,"w":0.26444442749023428,"x":0.39555556784747531,"h":0.01027883218259229,"text":"Recent studies have shown that our"},{"y":0.25714285713354978,"text":"news habits have disadvantages for our","w":0.28000000000000003,"h":0.011836734693877582,"x":0.38000000349999996},{"y":0.27020408156393083,"h":0.011836734693877471,"w":0.28000000000000003,"text":"physical and emotional health. In one","x":0.37999999614814828},{"y":0.28326530626410062,"w":0.28222221374511713,"text":"survey, over 50 percent of Americans","h":0.011836734693877471,"x":0.37777778672003381},{"w":0.28000000000000003,"h":0.010204081632652962,"text":"reported that the news caused them stress","y":0.29795918383615838,"x":0.3800000046666665},{"text":"and anxiety, often causing tiredness or","x":0.38000000349999996,"y":0.31102040801823505,"w":0.28000000000000003,"h":0.010204081632653184},{"h":0.011836734693877582,"text":"poor sleep. Research by psychology","x":0.3800000080759684,"y":0.32408163254965949,"w":0.27777776718139652},{"h":0.011836734693877582,"w":0.28000000000000003,"x":0.3800000046666665,"text":"expert Graham Davey has also proved","y":0.33714285706406277},{"text":"that watching terrible or sad news on","x":0.38000000385374622,"y":0.35020408151866866,"h":0.011836734693877471,"w":0.27777776718139646},{"text":"TV can worsen people's moods and","w":0.27777776718139657,"h":0.011836734693877471,"y":0.36326530619461361,"x":0.38000000761300545},{"x":0.38000000182596855,"text":"make them worry more about their own","h":0.010256288100262023,"w":0.27777776718139663,"y":0.37790697706121257},{"text":"lives. Clearly, being exposed to this ever-","w":0.27999999999999992,"x":0.37777777433333348,"h":0.011836734693877471,"y":0.38938775522826519},{"w":0.27999999999999997,"x":0.37777777427777776,"h":0.010215946508913665,"text":"increasing bad news can make us feel","y":0.40406976775888692},{"h":0.010204081632653184,"text":"less positive and affect our health.","w":0.23333332061767581,"x":0.37777778121893996,"y":0.4171428571519733},{"text":"However, there are ways to counteract*","x":0.39555556040521916,"w":0.26222221374511706,"h":0.011836734693877582,"y":0.43020408181421166},{"text":"this negativity. It is recommended that","x":0.37777778554410801,"h":0.011836734693877471,"w":0.28222221374511713,"y":0.44326530614935145},{"h":0.014988411883918529,"text":"you limit the number of times you","x":0.37761159705703939,"y":0.45574564875051693,"w":0.28035165786743155},{"h":0.011627906487912565,"x":0.37777778763152381,"w":0.27777776718139646,"y":0.47093023299635373,"text":"check the news to once or twice a day"},{"y":0.4840116281877298,"text":"and avoid looking at news apps before","w":0.27999999999999997,"x":0.37777777427777776,"h":0.011627906487912565},{"x":0.37777778034966369,"y":0.49551020424087922,"text":"bed in an effort to reduce the amount","w":0.28222221374511713,"h":0.011836734693877582},{"h":0.011627906487912565,"x":0.37777777348148162,"text":"of negativity you are exposed to. If you","w":0.27999999999999997,"y":0.51017441865526847},{"x":0.37777778338670059,"y":0.5232558140041057,"h":0.011627906487912565,"text":"notice your mood has","w":0.16222221374511719},{"x":0.37777777577777782,"text":"changed afterhearing","w":0.16000000000000003,"h":0.011836734693877582,"y":0.53632653080260095},{"h":0.011836734693877582,"text":"or reading the news,","x":0.37777778173133458,"y":0.54938775508929116,"w":0.15999999046325686},{"text":"try doing activities that","y":0.56395348856193928,"h":0.010332225877411449,"w":0.16222221374511719,"x":0.37777778472003393},{"y":0.57703488392894509,"w":0.16222221374511719,"h":0.010312054692482531,"text":"improve mood such as","x":0.37777778404410806},{"x":0.37777777960389314,"w":0.07777777671813968,"text":"exercising,","y":0.59156976767403635,"h":0.0087209296713069984},{"h":0.011627906487912565,"y":0.59011627935052047,"x":0.47777777702777785,"w":0.059999999999999998,"text":"listening"},{"text":"to music or watching","y":0.60319767446922201,"h":0.011627906487912565,"x":0.37777778439800114,"w":0.15999999046325686},{"text":"a funny video clip to","w":0.16222221374511719,"x":0.37777778472003393,"h":0.011627906487912565,"y":0.61627906996340798},{"y":0.63081395384167205,"x":0.37777777727777784,"w":0.03999999999999998,"text":"make","h":0.0087209296713069984},{"h":0.013299555875817104,"text":"yourself","y":0.62886960586524077,"w":0.064206395149230933,"x":0.43238711074643249},{"h":0.010174418079609837,"text":"feel","y":0.62936046545147417,"x":0.49777777830320402,"w":0.039999997615814187},{"h":0.0087209296713069984,"text":"better.","x":0.37777777965788095,"y":0.64389534908149759,"w":0.044444441795349121},{"text":"Several","x":0.39555555580175705,"y":0.65697674437946285,"w":0.051111111640930185,"h":0.0087209296713069984},{"x":0.47325772101130925,"text":"websites,","w":0.064595670700073216,"h":0.010589629971251235,"y":0.65676913848977514},{"y":0.67005813972473005,"h":0.010174418079609726,"w":0.068888888359069866,"x":0.37777777919083538,"text":"podcasts"},{"y":0.67005813976705975,"h":0.0087209296713069984,"w":0.039999997615814242,"x":0.45111111296987061,"text":"and"},{"x":0.49555555555351427,"text":"apps,","y":0.67151162811499165,"w":0.042222223281860316,"h":0.010174418079609726},{"text":"such as DailyGood, the","x":0.37777778284244562,"y":0.68313953532193517,"h":0.011627906487912565,"w":0.1599999904632568},{"x":0.38000000250204125,"y":0.69622093044057298,"h":0.010309681795081405,"w":0.15777777671813964,"text":"Good News Network"},{"text":"and Positive News magazine offer an","h":0.010238490591243932,"x":0.67777778228186036,"y":0.21795918351033428,"w":0.27555555343627935},{"h":0.011836734693877582,"y":0.23102040805144863,"w":0.27555555343627924,"text":"antidote* to the huge number of bad-","x":0.6777777834300085},{"text":"news stories in the mainstream news.","w":0.27333332061767579,"x":0.67777778755227314,"y":0.24408163265299743,"h":0.01027883218259229},{"y":0.25714285720622421,"text":"The Good NewsNetwork,for example.","x":0.67777778755227314,"h":0.011836734693877582,"w":0.27333332061767579},{"y":0.27020408172304999,"text":"has over 20,000 positive news stories in","x":0.67777778228186036,"h":0.011836734693877471,"w":0.27555555343627935},{"text":"addition to podcasts, showing that there","y":0.28488372113824745,"h":0.01021831979556953,"w":0.27555555343627935,"x":0.67777778228186036},{"x":0.67777778228186036,"y":0.29795918381805353,"h":0.011836734693877471,"w":0.27555555343627935,"text":"is no lack of good news, but the media"},{"h":0.011836734693877471,"x":0.67777778228186036,"text":"simply do not report it. Positive News","y":0.31102040798196162,"w":0.27555555343627935},{"h":0.011836734693877471,"y":0.32408163257146194,"w":0.27555555343627935,"x":0.67777778228186036,"text":"was established to develop journalism"},{"w":0.27333332061767579,"h":0.013147840694505364,"y":0.33714285736088034,"x":0.67777778365412511,"text":"that focuses on progress and solutions."},{"text":"Switching to these news sources could","x":0.67777777431889741,"w":0.27555555343627935,"y":0.35020408152032656,"h":0.011836734693877582},{"w":0.27555555343627935,"h":0.011627906487912565,"text":"not only make us feel more positive","x":0.67777778228186036,"y":0.36482558156709022},{"x":0.67777778083741591,"text":"about the world and ourselves, it could","y":0.37790697713395072,"h":0.011627906487912565,"w":0.27555555343627935},{"w":0.17555555343627927,"x":0.67555555558741587,"y":0.39098837248278784,"h":0.011627906487912565,"text":"simply make us healthier."},{"h":0.011627906487912565,"w":0.26000000000000001,"text":"While it is true that staying aware and","x":0.69333333008333342,"y":0.40406976772261349},{"h":0.011836734693877471,"y":0.41714285715203703,"text":"informed is not a bad thing, it is evident","w":0.27777776718139646,"x":0.67555555738152406},{"text":"that our news habits can have long-term","y":0.43168604675604372,"x":0.67555555622411678,"w":0.27777776718139646,"h":0.011627906487912565},{"h":0.010334598774812687,"text":"effects on our health. We should not","x":0.67777778228186036,"w":0.27555555343627935,"y":0.44476744206847996},{"x":0.67777778749671758,"w":0.27333332061767579,"text":"forget that we have a choice,not only","y":0.45784883759906703,"h":0.011627906487912565},{"h":0.010313241141183038,"w":0.27555555343627924,"text":"about how much news we consume, but","y":0.47224489805850545,"x":0.6777777834300085},{"x":0.67777777608186041,"text":"equally importantly about the kind of","y":0.48401162823860189,"h":0.01162790
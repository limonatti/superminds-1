27,"h":0.0087209296713069984,"text":"5"},{"text":"avoiding wasting food and minimising car travel.","x":0.54444444847331608,"y":0.26598837233743911,"w":0.36888889312744144,"h":0.011627906487912454},{"h":0.013175130571637883,"text":"don't \/ a strong \/ about \/ have \/ opinion \/ |","x":0.54444444967710515,"y":0.27906976732252131,"w":0.32444442749023428},{"h":0.011799778062470123,"w":0.10448912620544437,"x":0.54442210460849749,"text":"To be honest,","y":0.29351871559257714},{"text":"that. This city has bigger","x":0.76444444468627926,"y":0.30813953505546232,"h":0.011627906487912565,"w":0.18888889312744139},{"text":"problems to worry about than a few more shops.","w":0.36888889312744144,"h":0.01325700020303533,"y":0.31959183695118765,"x":0.54444444432516814},{"x":0.51777779436010196,"text":"A What would you say to those people who insist","h":0.011627906487912565,"w":0.38666664123535155,"y":0.34156976762813673},{"text":"that graffiti is art?","w":0.13333333015441895,"x":0.54444444547834603,"h":0.01310393897854556,"y":0.35465116279127129},{"w":0.38666664123535155,"x":0.5177777953267686,"h":0.01308376857212612,"text":"B What are the drawbacks of handing out leaflets","y":0.36773255792208515},{"h":0.011627906487912565,"text":"to highlight ethical issues?","w":0.20222221374511717,"x":0.54444445070521919,"y":0.38226744201767171},{"text":"1","x":0.92888888891023258,"w":0.024444444179534952,"h":0.01598837249133056,"y":0.35174418573315536},{"text":"O","x":0.9288888883804135,"h":0.017441860899633288,"w":0.026666667461395344,"y":0.37790697641791593},{"h":0.011836734693877693,"text":"C Don't you think it's terrible that they are building","x":0.51777777921893997,"y":0.39673469400441252,"w":0.39333332061767579},{"h":0.011836734693877582,"x":0.5444444427485271,"w":0.27555555343627935,"y":0.40979591821919281,"text":"another shopping centre in the city?"},{"y":0.42285714283827325,"text":"D How important is it to educate young people on","w":0.39111110687255857,"x":0.52000000730446116,"h":0.013189368734554341},{"x":0.54444445126931884,"y":0.43750000005507939,"text":"the dangers of drugs?","w":0.16888887405395503,"h":0.013112244897959147},{"h":0.011836734693877582,"x":0.52000000806077462,"text":"E What can the general public do to reduce their","w":0.38222221374511722,"y":0.45183673487824139},{"x":0.54222222479819071,"y":0.46511627935052058,"h":0.011627906487912565,"text":"impact on the environment?","w":0.21777776718139641},{"x":0.49333335138232398,"text":"5 Complete the dialogue with the words in the box.","w":0.42666664123535153,"h":0.011836734693877471,"y":0.48530612262990092},{"h":0.011836734693877582,"text":"advantage argue","x":0.54000000513057667,"y":0.51142857128640995,"w":0.1488888835906983},{"text":"argued","y":0.51162790707581118,"h":0.011627906487912565,"w":0.062222218513488747,"x":0.6977777806691815},{"y":0.50924932610132878,"w":0.12044182777404777,"h":0.014931579901247605,"text":"explain firmly","x":0.77311242003086367},{"x":0.54000000599999975,"w":0.35999999999999999,"text":"obviously regrettably significant suppose","y":0.52470930208996314,"h":0.01324988151083184},{"h":0.011627906487912565,"y":0.54796511647503598,"x":0.52000001718897371,"w":0.39555553436279289,"text":"P: On today's 'My View' we are joined by Tom, who"},{"text":"believes that the UK voting age should be reduced","y":0.56104651162848052,"h":0.013239202694017127,"x":0.54444444263072367,"w":0.38888889312744146},{"text":"from eighteen to sixteen. Tom, what would you say to","w":0.40888889312744148,"x":0.54444443558442768,"h":0.013219032287597576,"y":0.57412790659577717},{"y":0.5885714284625444,"x":0.54444446122676871,"w":0.40666664123535146,"text":"those who might argue that the average sixteen-year-","h":0.013172757674236757},{"h":0.011627906487912454,"text":"old is not wise enough to vote in a general election?","y":0.6031976745758113,"w":0.3977777862548828,"x":0.5466666664058919},{"h":0.010251542305459771,"text":"T: I think l'd 1","y":0.61627907009052452,"x":0.52000000174168792,"w":0.10888888359069826},{"h":0.010355956019187373,"text":"that in my view that is an","x":0.76222222199183476,"y":0.61755102038980358,"w":0.18888889312744139},{"text":"unfair generalisation. It could be ?","x":0.54444444203703712,"y":0.62936046517135846,"w":0.26000000000000001,"h":0.013088514366928483},{"x":0.54444444641405709,"text":"that many of the people who are currently old enough","w":0.40888889312744137,"h":0.013247508613430714,"y":0.64389534860159092},{"y":0.65697674380507942,"h":0.013227338207011274,"w":0.37111110687255866,"x":0.54444445089705396,"text":"to vote don't know enough to make an informed"},{"y":0.67005813963395067,"x":0.5466666680725063,"h":0.011627906487912565,"w":0.06666666507720953,"text":"choice. 3"},{"x":0.73999999664053007,"h":0.011836734693877582,"w":0.19333333969116206,"text":"_, a significant number of","y":0.67142857131700961},{"text":"voters make their decision based on what someone","y":0.68604651181775322,"x":0.54666667530446134,"w":0.39111110687255857,"h":0.010280018631292909},{"y":0.69912790718475903,"h":0.010259847835618618,"text":"looks like or some other irrelevant detail.","w":0.31111110687255861,"x":0.54444445045260947},{"text":"P: And do you think a sixteen-year-old could make","x":0.51999999458442769,"y":0.71346938793079562,"w":0.38888889312744146,"h":0.011836734693877582},{"text":"a more informed decision?","y":0.72674418643015637,"x":0.54444444417891447,"w":0.20666666030883785,"h":0.010174418079609726},{"text":"T: 14","h":0.01037849971226279,"x":0.52000000121343648,"w":0.044444441795349121,"y":0.73982558174265645},{"y":0.73982558145042809,"text":"believe they could. All UK","x":0.69777778289078329,"w":0.1977777671813965,"h":0.013235643347915382},{"w":0.38222221374511711,"x":0.54444445346077464,"y":0.75428571438516367,"h":0.011836734693877471,"text":"teenagers attend citizenship classes now and they"},{"text":"often know more about politics than older voters","x":0.5466666731726435,"y":0.76734693839607249,"h":0.013176317798848092,"w":0.37333332061767588},{"y":0.78040816329004081,"text":", young people are also affected","h":0.01319648820526742,"x":0.68444444237853563,"w":0.25111110687255855},{"h":0.011627906487912565,"text":"by the decisions of policy makers. Remember that in","x":0.54666666740033631,"y":0.79505813970662509,"w":0.3977777862548828},{"text":"the UK at the age of sixteen you can legally marry,","h":0.011631466223269049,"x":0.54666667568299687,"y":0.80959302350022977,"w":0.38222221374511722},{"y":0.822674418849067,"w":0.29999998092651359,"h":0.011627906487912565,"text":"work full time and join the armed forces.","x":0.54666668120340978},{"h":0.011836734693877582,"y":0.83714285716096204,"w":0.40666664123535157,"x":0.52000000593787998,"text":"P: And what other reasons are there in your opinion?"},{"text":"T: Well, I think one very •","w":0.19999999999999996,"x":0.52000000303703686,"h":0.013203607675980611,"y":0.84883720892135839},{"h":0.0087209296713069984,"w":0.075555553436279288,"x":0.84666666646704558,"y":0.85174418642403649,"text":"reason is"},{"y":0.86482558145042832,"w":0.40222221374511713,"h":0.013133602531588795,"x":0.5466666680533675,"text":"that a sixteen-year-old who works full time has to pay"},{"text":"taxes and therefore should have a say in how that","y":0.87918367353250004,"x":0.54666666715033629,"w":0.37777778625488279,"h":0.011836734693877471},{"x":0.54653149549718394,"w":0.24034154891967774,"h":0.012495588185835849,"text":"money is spent. Another clear 7","y":0.89234749403017066},{"x":0.91777777775555558,"h":0.011627906487912565,"text":"of","w":0.020000000000000018,"y":0.89244186059325314},{"x":0.54666668446565747,"w":0.40666664123535157,"h":0.013119364368672337,"text":"lowering the age limit would be recognition that young","y":0.90693877527464939},{"text":"people's opinions are important. I8","w":0.26888887405395501,"x":0.54666667826931858,"y":0.92000000005354998,"h":0.013139534775091666},{"w":0.39333332061767579,"y":0.93459302300202707,"h":0.013162078857421933,"x":0.54666667794116197,"text":"you could say that, at the moment, they simply feel"},{"h":0.011836734693877582,"y":0.94897959174302293,"w":0.26222221374511723,"text":"completely excluded from politics.","x":0.54666667527558943},{"y":0.96511627937232281,"x":0.91777777830583973,"h":0.011627906487912565,"text":"91","w":0.026666665077209495}]
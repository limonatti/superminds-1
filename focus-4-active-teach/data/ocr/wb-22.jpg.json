86708,"w":0.10643014907836912,"h":0.011627906668205679},{"h":0.01504348186736415,"text":"4 Eva doesn't enjoy being with other people","x":0.07077220891251372,"w":0.35068645477294919,"y":0.44909065060186726},{"x":0.097560982917673941,"w":0.26829267501831056,"text":"and she's not always kind to others.","y":0.46511627922403664,"h":0.011627906668205679},{"h":0.010174418042022015,"w":0.039911308288574213,"text":"She's","y":0.47965116319919243,"x":0.097560975789194024},{"x":0.093126386695327204,"text":"(FRIENDLINESS)","y":0.494186046811246,"h":0.011627906668205679,"w":0.12860310554504395},{"text":"5","w":0.011086474657058712,"h":0.0087209301962594132,"x":0.070953436618255566,"y":0.50872093016349818},{"w":0.33259422302246094,"y":0.50859247173948741,"h":0.013209853742009559,"text":"Lisa is more interested in being happy than","x":0.093126397357948962},{"x":0.097560977449639014,"h":0.011865793780687417,"text":"successful. She's","w":0.12416851043701174,"y":0.52168576109868059},{"y":0.53615635403945527,"x":0.095287699250752589,"w":0.097672939300537109,"text":"(AMBITION)","h":0.01344310554466932},{"x":0.070953436618255566,"h":0.010174418042022126,"y":0.55087209313499663,"text":"6","w":0.011086474657058712},{"text":"Mark is often rude to people. He's","h":0.013216990690964936,"y":0.55073649767812893,"w":0.26385808944702149,"x":0.093126383251360065},{"y":0.57994186056124608,"w":0.11308203697204591,"x":0.093126388409764171,"h":0.011627906668205679,"text":"(POLITENESS)"},{"x":0.044345904588598835,"h":0.013157518717739292,"text":"WORD STORE 2A | Personality adjectives","w":0.34589797973632819,"y":0.62063953493516966},{"y":0.64238952535617488,"text":"2 Complete the sentences with the correct words.","w":0.40798225402832033,"h":0.010229132569558153,"x":0.046563203510599394},{"w":0.2084257125854492,"y":0.65548281494838712,"h":0.011865793780687417,"text":"The first letters are given.","x":0.070953444298553908},{"text":"Tom's always careful to do things properly.","x":0.097560982781418351,"w":0.32372505187988282,"h":0.013195580624519532,"y":0.67430441932403173},{"text":"He very thorough.","y":0.68895348842946302,"w":0.13747227668762207,"x":0.097560981464023339,"h":0.011627906668205679},{"text":"1 If someone tells me something, I believe","y":0.70335515550088712,"x":0.070953448054927218,"w":0.33481151580810548,"h":0.011865793780687417},{"text":"them - why should I doubt them? I'm pretty","x":0.095343691901933883,"y":0.71802325600469497,"w":0.33481151580810548,"h":0.013155139994894371},{"h":0.011919686525035833,"y":0.7324122495640224,"w":0.09985685348510745,"x":0.20616913323660266,"text":"_, I suppose."},{"x":0.070953446525200373,"text":"2 My sister wants to write comedy shows for TV.","y":0.74549918150628192,"h":0.013221748917075504,"w":0.37472282409667973},{"w":0.27494455337524415,"x":0.09534368813129887,"y":0.76017441841385192,"text":"I think she'd be perfect as she's very","h":0.013148003826359833},{"text":"_. She always makes","y":0.77616279092448304,"h":0.010252920968637946,"x":0.21507760974626897,"w":0.15521063804626464},{"w":0.12239933967590332,"x":0.097417613321584759,"text":"everyone laugh!","h":0.011678335124263972,"y":0.79048856992330252},{"w":0.12195121765136718,"text":"3 He's really m","x":0.07095343895702147,"y":0.80360065472431552,"h":0.011865793780687417},{"h":0.011865793780687417,"text":". He can go from","x":0.30376940335682867,"y":0.80360065474611786,"w":0.13082039833068848},{"w":0.25498889923095702,"y":0.81831395373361937,"text":"annoyed to cheerful in an instant.","x":0.095343685159096622,"h":0.013109941139158754},{"x":0.070382929635134914,"text":"4 My parents are a","y":0.83212280194213462,"h":0.015801190939745635,"w":0.15393534660339353},{"text":"people.","x":0.33259423499237317,"y":0.83430232598383391,"h":0.010174418042022237,"w":0.062084255218505857},{"text":"They love giving hugs and I've always known","w":0.33037693023681641,"y":0.84738134191330694,"h":0.011630285781260907,"x":0.097560983861636072},{"text":"they care about me.","w":0.15077605247497558,"y":0.86191860476909488,"h":0.011649316734651083,"x":0.095343682964285997},{"y":0.8764320784114672,"h":0.011649316734651194,"w":0.16186252593994141,"text":"5 I think I'm quite p.","x":0.070953440392926476},{"x":0.33702882599399347,"y":0.87643207865371531,"w":0.12638580322265625,"h":0.011649316734651083,"text":".. I can tell when"},{"x":0.097560968990008559,"h":0.013093289689034338,"text":"people are feeling sad or nervous, even if they","y":0.88952536824854123,"w":0.35254989624023436},{"h":0.011807063987719468,"x":0.095318894527012185,"text":"try to hide it.","y":0.90543367722304879,"w":0.097610549926757814},{"w":0.43680709838867193,"text":"My best friend and I are complete opposites! For one","y":0.41715116274524722,"h":0.013081395294389231,"x":0.51441242260906361},{"y":0.43166939435191132,"text":"thing, he loves studying and is always reading and doing","h":0.013098047524934597,"w":0.4345898056030274,"x":0.5144124099257591},{"text":"research online because something fascinates him. I","h":0.011865793780687306,"w":0.43680709838867193,"y":0.44762684108344064,"x":0.51441242260906361},{"y":0.4607201312778304,"w":0.43458980560302729,"h":0.013117078088114242,"x":0.51441240883928463,"text":"suppose he's quite intellectual - and I'm not! I don't mind"},{"h":0.011865793780687306,"text":"a bit of homework, but I'd rather be out having fun with","x":0.51441242078903426,"y":0.47667757759613583,"w":0.43680709838867193},{"x":0.51441241861755482,"y":0.48977086724164265,"text":"friends and meeting new people. When I go out, I'm quite","w":0.4345898056030274,"h":0.013136109431714726},{"w":0.019955652952194147,"h":0.007267441570075972,"x":0.5144124177589362,"text":"1","y":0.50436046518879918},{"h":0.013167034389539589,"w":0.26607538223266602,"text":"-, I don't think it's necessary to plan","y":0.50572831454156975,"x":0.68292682773067381},{"h":0.013202717573474909,"text":"everything before you do it, I love the fact that I never quite","y":0.52034883730920067,"x":0.51441242610198035,"w":0.43458976745605471},{"h":0.013186065733140073,"w":0.43680709838867193,"y":0.53477905046419993,"text":"know what I'm going to do or where I'll go. My friend likes","x":0.51441242078903426},{"text":"to plan every detail, but the thing is, he's not that confident","x":0.51441242078903426,"y":0.54941860462388104,"w":0.43680709838867193,"h":0.013183687010295264},{"x":0.51213489463067008,"y":0.56227997780885519,"h":0.012067951664401777,"text":"- he's a bit 2","w":0.097681427001953147},{"w":0.17516630172729486,"h":0.010288603762362847,"x":0.77383591568291565,"y":0.56540697711634358,"text":"and worries allthe time"},{"w":0.4345898056030274,"y":0.5784883721929216,"x":0.5144124099257591,"text":"about making mistakes, even silly little ones, which is","h":0.013164655666694669},{"h":0.014534883140151833,"y":0.59156976749000156,"x":0.51441243046266005,"w":0.43458976745605471,"text":"crazy because he's got a brain the size of China! Unlike"},{"h":0.013145625103515024,"x":0.51441241011422922,"w":0.43458980560302729,"text":"me, he's not that keen on new experiences, I'll even have","y":0.60755813939859027},{"w":0.43458980560302729,"h":0.011627906668205679,"text":"a go at tricky or adventurous things - I guess you could","y":0.62354651185485066,"x":0.51441241065007548},{"y":0.63502454980907819,"text":"say I'm pretty 3","w":0.12638580322265625,"x":0.51441242125452546,"h":0.014729950900163713},{"h":0.010367106688978667,"text":". He thinks before","w":0.14634145736694337,"x":0.80487805424335745,"y":0.63788870695897038},{"x":0.51441241681747263,"h":0.013095668802089677,"text":"he says anything in case he upsets somebody and is very","y":0.65261627903642938,"w":0.43237251281738276},{"w":0.26214830398559574,"y":0.66547235891912537,"x":0.68709155078461692,"text":"and good with words. Im not very","h":0.017241690240788254},{"x":0.68957871911203128,"y":0.68166939423563222,"w":0.26164079666137696,"h":0.013098047524934486,"text":", I seem to say the first thing that"},{"w":0.43458976745605471,"x":0.51441244058830649,"text":"comes into my mind and I'm terrible at keeping secrets.","y":0.69622093028400689,"h":0.013271704438079901},{"h":0.013117078088114242,"w":0.43458976745605471,"text":"Despite our differences, we get on incredibly well. I know","y":0.71072013111431298,"x":0.51441244058830649},{"y":0.72529069762896814,"x":0.51441241861755482,"h":0.013252673874900367,"w":0.4345898056030274,"text":"he'll always be there for me if I've got a problem, and I'll"},{"h":0.013136109431714726,"y":0.73977086734580944,"text":"do the same for him. That's why we're such good friends!","w":0.43015522003173823,"x":0.51441240857245307},{"y":0.78633720953457531,"w":0.34589797973632813,"h":0.014534883140151833,"text":"WORD STORE 2B | Compound adjectives","x":0.49223948365733478},{"y":0.80668604647209863,"h":0.011644558898751045,"text":"4 Match the words in the box with words 1-7 to make","x":0.49223946116118755,"w":0.44124168395996088},{"text":"compound adjectives.","h":0.01162790666820579,"w":0.17960088729858403,"y":0.82267441875892033,"x":0.51662971455469897},{"y":0.84883720941406648,"w":0.042128601074218786,"h":0.010174418042022126,"text":"back","x":0.53880266114064379},{"x":0.57871396875343994,"h":0.010174418042022237,"w":0.31042127609252923,"y":0.84883720965631448,"text":"centred conscious critical headed"},{"text":"hearted minded natured tempered willed","y":0.86333878903397077,"w":0.37694011688232421,"h":0.01166121073908577,"x":0.53880267197273302},{"h":0.0087209301962595243,"text":"1","x":0.51662971235665944,"w":0.013303768634796209,"y":0.89970930224683154},{"x":0.51662971192075391,"w":0.017738358974456747,"text":"2","y":0.91424418617367242,"h":0.0087209301962594132},{"x":0.51662971192075391,"h":0.0087209301962595243,"y":0.9287790698946029,"w":0.017738358974456747,"text":"3"},{"w":0.015521063804626478,"y":0.94186046498907949,"x":0.51662971181535122,"text":"4","h":0.0087209301962595243},{"w":0.099778270721435636,"x":0.5432372514
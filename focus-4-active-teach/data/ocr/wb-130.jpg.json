93555555572065463},{"y":0.13795918398737217,"w":0.40000000000000002,"h":0.01320360689747091,"x":0.58222222888888864,"text":"polluting our city. Actually, it should be closed down."},{"h":0.013429721131616668,"text":"2 Ifonly you","x":0.55550795210460968,"y":0.15098862777625222,"w":0.11120632171630851},{"x":0.77555555553594302,"y":0.15387755103876799,"text":"(not\/throw out) the old","w":0.17111110687255859,"h":0.0089795918367345795},{"w":0.31555555343627928,"h":0.011627906487912565,"x":0.58222222722630479,"text":"books. They could have all been recycled.","y":0.16715116303511346},{"h":0.010174418079609837,"w":0.01111111044883728,"text":"3","y":0.18023255852923581,"x":0.55555555597002582},{"h":0.011627906487912565,"text":"I'd rather Maria","y":0.18023255843240027,"x":0.57777777577777778,"w":0.12000000000000011},{"text":"(plant) more roses in the","x":0.7644444410792508,"y":0.18163265313389887,"w":0.18444444656372072,"h":0.011836734693877582},{"h":0.013154959386708853,"text":"front garden this spring. They'll look really nice.","x":0.58000000894604509,"y":0.19469387776751412,"w":0.35777774810791019},{"h":0.010174418079609726,"w":0.013333332538604803,"x":0.55555555617514196,"text":"4","y":0.20930232577124164},{"text":"David wishes he","x":0.56888888768926782,"y":0.20930232591659048,"h":0.010289510999407114,"w":0.13555555343627934},{"text":"(not\/sell) his tent","w":0.13333333015441895,"h":0.010317987325240141,"y":0.21061224509150267,"x":0.8133333327005684},{"x":0.57964786132045421,"text":"because he can't go camping now.","h":0.016334189590142767,"w":0.26506296157836917,"y":0.22264793409376904},{"text":"5 Don't you wish you","w":0.17193700790405275,"x":0.5550548265457651,"h":0.015184572180923173,"y":0.23692011534066959},{"w":0.095555553436279306,"x":0.84000000201519365,"h":0.010174418079609837,"text":"(install) solar","y":0.23982558158519507},{"h":0.016024856567382839,"text":"panels when you built your new house?","w":0.30033712387084965,"x":0.57982413113943576,"y":0.25107181062165362},{"text":"\/5","x":0.95777777752777782,"w":0.020000000000000018,"h":0.0087209296713069984,"y":0.27325581430678836},{"text":"5 Find and correct the mistakes in the sentences.","x":0.52888889555555518,"h":0.011627906487912565,"w":0.40000000000000002,"y":0.29941860494402817},{"h":0.01400470655791608,"text":"We had to decide what to do at the weekend.","x":0.57985141699787723,"y":0.315982570233867,"w":0.34922248840332026},{"h":0.013094447388940944,"x":0.5800000021437719,"w":0.38444442749023444,"y":0.33139534845624219,"text":"And it was the dog show what we chose in the end"},{"y":0.34593023275410573,"text":"that \/ which","w":0.093333330154418914,"x":0.5777777801450128,"h":0.011627906487912565},{"x":0.55333333931262663,"y":0.36040816290397326,"text":"1 Under any circumstances are you allowed to leave","w":0.40222221374511713,"h":0.013138349104900859},{"h":0.011627906487912565,"x":0.5777777857344697,"text":"your children unattended at the zoo.","w":0.28666666030883781,"y":0.37500000029286529},{"x":0.55333333160075793,"y":0.38808139496787009,"h":0.013143094899703001,"text":"2 Not before have we experienced worse weather","w":0.39111110687255868},{"x":0.58000000786077466,"text":"conditions on our skiing holiday than last winter.","w":0.36222221374511721,"h":0.011627906487912565,"y":0.40406976762813673},{"h":0.013211912816884608,"text":"3 It's not serious. All happened was that Kim forgot to","x":0.55333334808527013,"y":0.43168604630507934,"w":0.41555553436279302},{"text":"ask someone to water her plants while she was away.","y":0.44612244915987576,"h":0.013179876366440135,"w":0.40000000000000002,"x":0.57777777688888887},{"y":0.45908118972072531,"w":0.17658060073852544,"h":0.01603560467155607,"text":"That's why she is upset.","x":0.57941361956956483},{"x":0.55333334960454639,"w":0.42666664123535158,"text":"4 There was James who rescued the cat. He's an animal","y":0.47510204082512408,"h":0.011836734693877471},{"h":0.013111058449258639,"y":0.48979591848209614,"x":0.57777779132895679,"w":0.30444442749023437,"text":"lover and does all he can to help them."},{"text":"5 If only have you left all the lights on, but you've also","y":0.50263264211480507,"h":0.015923063317123787,"x":0.55314282834069617,"w":0.41589763641357425},{"text":"forgotten to turn the TV off","w":0.20888889312744141,"x":0.57777777382516826,"h":0.01317038477683552,"y":0.51744186046568985},{"y":0.54505813935162506,"x":0.95555555544444448,"w":0.020000000000000018,"text":"\/5","h":0.010174418858119427},{"h":0.01328082337671399,"text":"6 Complete each sentence with one or two words.","y":0.57105950004928652,"w":0.41132560729980461,"x":0.52656729928651647},{"h":0.016729826635243916,"text":"What an awful day it is today! If only it wasn't so cold","y":0.58773738693808941,"x":0.57753866378711427,"w":0.39599304199218743},{"h":0.010594079932388034,"text":"and wet.","x":0.57770392475996057,"y":0.60444133215805518,"w":0.066814374923706121},{"text":"1 Island holidays are nice, but l","x":0.55111111438042992,"y":0.61918367346938774,"w":0.2488888740539551,"h":0.011630279774568542},{"x":0.89999999911676143,"text":"we went","w":0.068888888359069811,"h":0.0073469387755101812,"y":0.62204081638110009},{"y":0.63224489757158631,"h":0.013103939757055261,"w":0.36888889312744133,"x":0.57777777934739039,"text":"hiking in the countryside like we did last summer."},{"y":0.64816326539677427,"h":0.011836734693877582,"w":0.22000000000000008,"x":0.73555555280555562,"text":"volunteer to help at the local"},{"x":0.57777779593787959,"y":0.66122448948201551,"text":"animal shelter, but I'm too busy these days.","w":0.3266666412353515,"h":0.013194115307866405},{"text":"3","w":0.01111111044883728,"y":0.67587209321667208,"x":0.55111111133113699,"h":0.0087209296713069984},{"x":0.67777777889705404,"y":0.67587209307833518,"w":0.29111110687255859,"text":"I find annoying is that the local council","h":0.013107499103156894},{"x":0.57777778767672605,"y":0.68895348921180199,"h":0.014719980200942673,"w":0.22888887405395508,"text":"provides so few recycling bins"},{"w":0.01111111044883728,"text":"4","x":0.55111111133113699,"h":0.010174418079609726,"y":0.70348837218597027},{"text":"is the planet getting warmer, but the air","y":0.70489795929204779,"x":0.68000001453674319,"h":0.013125296612175208,"w":0.29999998092651359},{"text":"and the oceans are becoming more polluted.","y":0.71947674404732742,"h":0.013176317020338391,"x":0.57555555829192007,"w":0.3444444274902343},{"w":0.01111111044883728,"text":"5","x":0.55111111133113699,"y":0.73255813969566019,"h":0.010174418079609837},{"y":0.73387755115402742,"h":0.013215472162986241,"text":"have I read a more gripping tale!","x":0.6800000003696125,"w":0.24888889312744145},{"h":0.013235643347915382,"x":0.57555557285454628,"w":0.36666664123535153,"y":0.74693877543784837,"text":"You really must read it when you get the chance."},{"w":0.053333330154418879,"y":0.80087209269679449,"text":"Total","h":0.013081395674724994,"x":0.84666666864501283},{"y":0.77470930266434646,"w":0.019999999999999907,"text":"\/5","h":0.0087209296713069984,"x":0.95333333313333346},{"x":0.93333333275643415,"y":0.80232558171243906,"h":0.011627906487912565,"w":0.035555555820465101,"text":"\/30"}]
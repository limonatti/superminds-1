[{"x":0.031111117691162083,"w":0.25333332061767577,"text":"WRITING BANK","y":0.010174419299266213,"h":0.020437825261330089},{"text":"Closing formulas: emails and letters","y":0.065306122304650382,"w":0.39777778625488286,"x":0.026666660483669738,"h":0.017551020408163254},{"x":0.026666669420749186,"w":0.13555555343627929,"y":0.097383721101974019,"text":"Informal phrases","h":0.011627906487912454},{"x":0.026666669053367401,"y":0.12063953450275378,"w":0.18222221374511718,"h":0.013238016245316508,"text":"Bye for now \/ See you!"},{"text":"Love, \/ Take care! \/ All the best,","x":0.026666676191162041,"h":0.011627906487912565,"y":0.1468023258258111,"w":0.25333332061767577},{"h":0.011627906487912565,"y":0.16715116308356315,"text":"Neutral phrases","w":0.12888888359069825,"x":0.02666666716761391},{"h":0.012064073523696539,"y":0.19454935858153366,"text":"Best wishes,","x":0.026608102776868332,"w":0.10011713027954101},{"w":0.073780322074890131,"text":"Regards,","x":0.026443171155779873,"y":0.2174687985101853,"h":0.014190309485610619},{"w":0.12444444656372071,"x":0.026666666851472964,"text":"Formal phrases","h":0.011627906487912454,"y":0.2427325583258112},{"w":0.26000000000000001,"text":"(Dear Mr\/Mrs\/Miss\/Ms Brennon)","h":0.010269340203732824,"y":0.26734693867618831,"x":0.02444444184444448},{"x":0.050871640368048893,"h":0.011914826996472394,"text":"Yours sincerely,","w":0.12722408294677734,"y":0.28190553983859545},{"y":0.30653061233567724,"text":"(Dear Sir or Madam \/ Editor)","w":0.2288888931274414,"h":0.010329852590755584,"x":0.024444440036279342},{"w":0.12888888359069825,"y":0.3212209300514457,"h":0.013081395674724883,"text":"Yours faithfully,","x":0.048888893149095301},{"text":"Complaining","x":0.024405802216719792,"w":0.14229950904846192,"h":0.017711826246611939,"y":0.34579524962119257},{"text":"Describing problems","y":0.37632653078411371,"w":0.16666666030883789,"x":0.026666671928914348,"h":0.011836734693877693},{"text":"I wish to express my strong dissatisfaction with ...","y":0.40116279051656201,"x":0.024444449444444308,"w":0.39999999999999997,"h":0.013122923714773971},{"text":"I am writing to complain about ...","x":0.024444451082239062,"y":0.42571428585912474,"w":0.27111110687255857,"h":0.011836734693877471},{"h":0.01367853281449305,"y":0.44884292075395993,"w":0.30246976852416996,"x":0.024320470757656167,"text":"I'm afraid I have to make a complaint."},{"x":0.024444452305219109,"text":"I am writing to express my concerns about ...","y":0.47510204086872865,"h":0.011836734693877582,"w":0.36222221374511715},{"w":0.26444442749023439,"x":0.024444457328956712,"y":0.49999999985516097,"text":"I would like to complain about ...","h":0.011627906877167304},{"text":"Suggesting solutions","y":0.52470930261844673,"h":0.011627906487912565,"x":0.024444449047096643,"w":0.16888887405395506},{"w":0.37555553436279299,"x":0.02666668352230701,"text":"One possible way to solve this problem is to ...","h":0.013259373878946046,"y":0.54796511614035071},{"w":0.31999998092651366,"text":"An alternative solution to this issue is ...","x":0.026666681536743012,"y":0.57265306126388693,"h":0.011836734693877471},{"h":0.017551020408163254,"text":"Declining suggestions","x":0.024444448206692167,"y":0.59877551007811225,"w":0.24666666030883788},{"w":0.22222221374511719,"y":0.62936046532435763,"text":"It doesn't sound very good.","x":0.024444451460774664,"h":0.011627906487912565},{"x":0.022222225298190706,"text":"I don't think I fancy it.","y":0.65261627896132934,"h":0.013098006735042689,"w":0.17777776718139648},{"text":"I'm sorry, but I can't join you.","x":0.024444449430008355,"y":0.67714285720915668,"h":0.013264119673748409,"w":0.23555555343627932},{"text":"I'm not really into ...","w":0.16222221374511717,"y":0.70203488396534597,"h":0.011627906487912565,"x":0.024444450710774692},{"text":"l've got some doubts about it.","w":0.24222221374511721,"y":0.72674418623278791,"h":0.011627906487912565,"x":0.024444451105219152},{"y":0.7514285713201333,"h":0.010204081632653073,"w":0.23777776718139648,"text":"I don't see how it could work.","x":0.022222224548190717},{"x":0.024444456010059349,"y":0.77616279094209017,"w":0.2488888740539551,"h":0.011627906487912565,"text":"Actually, I would prefer not to."},{"x":0.024444444694444442,"h":0.014534884083027722,"text":"180","y":0.95784883695557921,"w":0.039999999999999994},{"h":0.023110465224908339,"x":0.5146883814918789,"text":"Describing a person","y":0.064529398296462981,"w":0.2237930488586426},{"w":0.36666664123535153,"text":"The first thing you notice about (him\/her) is ...","y":0.097383720791513473,"h":0.013228523877202303,"x":0.51555557438232402},{"y":0.12204081625411112,"text":"(He\/She) is special for a number of reasons.","h":0.011836734693877582,"w":0.34666664123535151,"x":0.51333335038232408},{"text":"He\/She is the kind of person who ...","h":0.011627906487912565,"w":0.28888887405395514,"y":0.1468023258258111,"x":0.51555556658413348},{"y":0.17142857164576619,"w":0.42444442749023437,"h":0.013164451754823059,"x":0.51555556933821611,"text":"The most unusual\/interesting person I've ever met is ..."},{"h":0.013166825430733775,"text":"Height of medium height, tall, fairly short, long-legged","x":0.51555556218594289,"y":0.19622092996787011,"w":0.45111110687255862},{"x":0.5133333350282514,"y":0.22093023272988099,"text":"Build","w":0.044444441795349121,"h":0.011627906487912454},{"w":0.39777774810791022,"h":0.013195301756566913,"x":0.57111112731641522,"text":"muscular, well-built, overweight, skinny, slim, thin","y":0.22081632653137695},{"h":0.013135975428989921,"w":0.40444442749023435,"text":"Age in his teens, middle-aged, in her late forties,","y":0.24563953470624222,"x":0.51555556807710501},{"h":0.011627906487912565,"text":"elderly","y":0.26017441904286542,"x":0.54222222405963816,"w":0.055555553436279381},{"y":0.28326530631248648,"h":0.010339344569614939,"w":0.11777777671813972,"x":0.51555555755759674,"text":"Facial features"},{"x":0.64888888422222235,"text":"round, oval, freckles, dimples, scar,","y":0.28326530597786492,"w":0.28000000000000003,"h":0.013246322164730095},{"text":"mole, wrinkled, almond-shaped eyes, pale, tanned,","x":0.54222223744006781,"y":0.29795918389684783,"h":0.013087327918227865,"w":0.40444442749023435},{"x":0.53999999646704566,"y":0.31249999990973054,"h":0.013214285714285734,"w":0.27555555343627924,"text":"a crooked nose, moustache, beard"},{"text":"Hair balding, short, shoulder-length, long, wavy, curly,","h":0.013147840694505364,"x":0.51555555569478073,"y":0.33714285712832226,"w":0.43777778625488284},{"h":0.010174418079609726,"y":0.35174418647860595,"w":0.044444441795349121,"text":"thick","x":0.5377777797689921},{"text":"She dresses casually\/smartly\/well\/in black\/fashionably.","w":0.43333332061767571,"x":0.5133333324689402,"y":0.37632653043119613,"h":0.011836734693877582},{"y":0.40116279090575302,"text":"He always wears scruffy\/stylish clothes.","x":0.51555556156372062,"h":0.011627906487912565,"w":0.31111110687255861},{"y":0.42571428584841464,"text":"Describing an object","x":0.51333333735782882,"h":0.016326530612244872,"w":0.23333332061767564},{"text":"It is\/was...","y":0.45696508329363095,"h":0.010532442598926717,"w":0.084862632751464773,"x":0.51534544080160627},{"x":0.51555555993409097,"y":0.48110465135875691,"h":0.011627906487912565,"w":0.27111110687255868,"text":"Size huge\/tiny\/35 cm x 25 cm big"},{"h":0.011836734693877582,"x":0.51333333899999989,"text":"Shape round\/rectangular\/square\/narrow","y":0.50571428576541289,"w":0.33999999999999997},{"h":0.011627906487912454,"y":0.53052325600022976,"w":0.37555553436279299,"x":0.51555556990749241,"text":"Colour white\/red and brown\/light\/dark green"},{"w":0.31555555343627928,"h":0.013159705960020696,"y":0.5537790693864747,"x":0.51555555624482341,"text":"Material made of leather\/plastic\/linen"},{"text":"Age new\/young\/old\/six years old\/modern\/ancient","x":0.5155555670800509,"w":0.41333332061767569,"y":0.5799418606368576,"h":0.011627906487912565},{"w":0.44666
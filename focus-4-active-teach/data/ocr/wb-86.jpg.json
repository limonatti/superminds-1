56933585},{"w":0.01111111044883728,"y":0.8604651164506838,"h":0.0087209296713069984,"x":0.56222222247002573,"text":"5"},{"h":0.01197845303282441,"y":0.86028984328298252,"w":0.10231463432312005,"text":"l've got a gut","x":0.5866204593381662},{"y":0.86040816344622728,"x":0.81777777776961269,"h":0.011836734693877582,"text":"that this story isn't true.","w":0.16888889312744149},{"h":0.0087209296713069984,"y":0.87500000020795099,"x":0.58888889013684742,"w":0.1422222232818604,"text":"Matt had a distinct"},{"y":0.87500000023829583,"w":0.13555555343627934,"x":0.85555555887445278,"h":0.010306122059724698,"text":"that the interview"},{"y":0.88808139540391662,"text":"was going to be a disaster, and he was right!","w":0.33555553436279306,"h":0.01314309412119341,"x":0.58666668218897366},{"y":0.90261627926318377,"h":0.0087209296713069984,"w":0.01111111044883728,"text":"6","x":0.56222222244224795},{"y":0.90244897973744054,"w":0.35777774810791019,"text":"Journalists are always looking for a newsworthy","h":0.013248695062131333,"x":0.58666668739048911},{"w":0.17999999999999994,"h":0.011836734693877582,"text":"that they can report on.","y":0.91714285707936249,"x":0.71777778002777781},{"x":0.58444444071186896,"w":0.35111110687255853,"text":"When I glanced at the headlines, there was an","y":0.93020408166886281,"h":0.011836734693877582},{"y":0.9444368297481891,"h":0.012289131320252666,"w":0.095739631652832058,"x":0.58657462702630958,"text":"eye-catching"},{"x":0.79555555478594298,"y":0.9447674419155444,"text":"_ about the prime minister.","w":0.19111110687255861,"h":0.013191741631955467},{"text":"84","w":0.031111111640930174,"y":0.9578488371243512,"x":0.053333333258899988,"h":0.01598837249133056}]
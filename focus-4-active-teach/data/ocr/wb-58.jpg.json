[{"text":"READING","y":0.028495173866182832,"w":0.16474489212036131,"x":0.18873866629221425,"h":0.020044535593269686},{"x":0.19111111311111104,"w":0.28000000000000003,"y":0.072674418842655575,"text":"Banknotes • making and spending","h":0.01310989513895866},{"x":0.18888888588888897,"y":0.087009804012411651,"w":0.23999999999999999,"h":0.013480392156862697,"text":"money • being rich and poor"},{"text":"1","x":0.53333333358113688,"h":0.0087209301057205035,"y":0.046511627861383964,"w":0.01111111044883728},{"h":0.01312889460644695,"y":0.046511628221116208,"text":"Read texts A-C quickly and choose the best title for","w":0.4133333206176758,"x":0.55999999946894019},{"h":0.0087209301057205035,"y":0.062500000063418826,"text":"each text.","x":0.56000000084055124,"w":0.082222223281860463},{"w":0.1488888835906983,"text":"1 Money to burn?","x":0.56000000078798418,"y":0.078431372512878128,"h":0.011846405228758239},{"w":0.1977777671813965,"x":0.56000000482596846,"text":"2 Can I pay with plastic?","h":0.013185893788057235,"y":0.093023256267385612},{"w":0.31999998092651372,"text":"3 Have you got change for £100 million?","h":0.013176394443885964,"y":0.10610465123468216,"x":0.56000001064785432},{"x":0.40444444557658898,"w":0.062222218513488747,"text":"Text A","y":0.18014705871437098,"h":0.013166894320568945},{"h":0.013271393339618354,"w":0.54000000000000004,"y":0.19893790872027317,"text":"In Britain today, there are around three billion banknotes in circulation","x":0.40444443544444481},{"text":"worth over 58 billion pounds. In 2013 alone, the Bank of England","x":0.40666669046456322,"y":0.21364379058969696,"w":0.53777774810791024,"h":0.014705882352941124},{"x":0.40444445119444422,"y":0.2267156859484537,"h":0.014705882352941124,"text":"issued 760 million new banknotes and destroyed 845 million old ones.","w":0.54000000000000004},{"w":0.53777774810791024,"h":0.013166894320568945,"x":0.40666668822382251,"y":0.24264705882338267,"text":"As well as the £5, £10, f20 and £50 notes commonly found in the"},{"w":0.53777774810791024,"y":0.25726744212615493,"x":0.40666669046456322,"text":"nation's wallets and purses, there are just over 4,000 f1m and £100m","h":0.013157394197252037},{"h":0.017327816657770612,"y":0.26827849403553627,"x":0.40655144855808517,"w":0.53805259704589847,"text":"notes - known as Giants and Titans - not in circulation, with a value"},{"h":0.014705882352941235,"x":0.40666668822382251,"w":0.53777774810791024,"text":"of around £8bn. These are used internally by banks and are not legal","y":0.28472222207697129},{"w":0.39999999999999997,"h":0.015988371730629836,"text":"tender*. Nevertheless, they are carefully locked away.","y":0.29941860481782456,"x":0.40444444844444433},{"y":0.34722222210952791,"text":"Text B","w":0.059999999999999998,"x":0.40444444388888889,"h":0.013242893748813267},{"h":0.013214394158008069,"text":"The average paper banknote in Britain","w":0.31555555343627917,"x":0.40666667088186026,"y":0.36627906998468207},{"x":0.40444445292041281,"h":0.011627907067342513,"text":"lasts around 6 months before it becomes","y":0.37936046504191012,"w":0.31777776718139644},{"w":0.31555555343627928,"y":0.39379085001723158,"x":0.4066666716707491,"text":"damaged or worn and must be removed","h":0.013185893788057235},{"x":0.40666666935593443,"y":0.4084302330660774,"w":0.31555555343627928,"h":0.013138394729763858,"text":"from circulation. In the UK, old notes used"},{"w":0.31777776718139655,"x":0.40666667726115341,"text":"to be burnt, but in a move to be greener, the","y":0.42279411736305361,"h":0.014705882352941124},{"h":0.013081394769007826,"w":0.31333332061767583,"text":"majority are now shredded, compacted","y":0.43750000019907165,"x":0.40666667694116199},{"y":0.45203488408351933,"x":0.40444444444633892,"h":0.013242893748813156,"w":0.31777776718139644,"text":"and then used with other organic materials"},{"h":0.013147894853080766,"y":0.46650326762347749,"text":"to manufacture agricultural compost.","w":0.3177777671813965,"x":0.40444445503893123},{"y":0.48110465139819958,"w":0.635555534362793,"h":0.013176394443885964,"text":"Between 1988 and 1992 at the site where this shredding takes place, £600,000 worth","x":0.086666685207492128},{"y":0.494186046819858,"h":0.014534883249818775,"text":"of notes that were intended for destruction were stolen by three couples who worked","x":0.084444447096381478,"w":0.635555534362793},{"text":"there. The couples managed to sidestep security controls and remove the notes from","h":0.013223894281324977,"w":0.63777774810791033,"y":0.50857843098593081,"x":0.084444469909007502},{"y":0.52325581426762791,"w":0.36444442749023437,"h":0.013100395015641753,"text":"the site by concealing them in their underwear.","x":0.08444445899562332},{"x":0.35555555668770006,"h":0.01310989513895866,"w":0.062222218513488747,"y":0.57267441873104841,"text":"Text C"},{"text":"Paper money will soon be a thing of","y":0.5915032681908029,"w":0.31333332061767577,"h":0.014705882352941235,"x":0.41777778783005087},{"h":0.014534883249818886,"text":"the past in Britain as the Bank of England introduced plastic","x":0.47111112535782851,"w":0.47333332061767575,"y":0.60610465134989666},{"x":0.49555557482676849,"w":0.44666664123535149,"text":"banknotes from 2016. Australia was the first country to","y":0.62050653597252448,"h":0.014705882352941124},{"x":0.51111112469116193,"h":0.013109895138958771,"y":0.63517441887034098,"w":0.43333332061767582,"text":"go plastic in 1988, and more than 20 other countries"},{"w":0.40222221374511724,"y":0.64950980401270531,"x":0.54000000404410808,"text":"including New Zealand, Mexico and Canada have","h":0.016339869281045694},{"w":0.36666667938232411,"x":0.57555555225328225,"h":0.014705882352941124,"text":"since switched. Plastic notes are highly durable*,","y":0.6642156858878917},{"h":0.013214394158008069,"text":"lasting for around two years, or four times longer","x":0.57777778989932715,"y":0.67877906998468207,"w":0.36444442749023431},{"x":0.58444445044444426,"text":"than the average paper note. Crucially*, plastic","y":0.6932189540307343,"w":0.35999999999999999,"h":0.013176394443885964},{"text":"money is waterproof so it can survive washing","h":0.013147894073935129,"y":0.70784883757189143,"x":0.59333332772516822,"w":0.34888889312744142},{"x":0.5933333355751681,"h":0.013242893748813267,"text":"machines, rainstorms and dips in the ocean.","y":0.72222222222217336,"w":0.34888889312744142},{"y":0.73691860515910068,"x":0.59333332747331657,"h":0.013081394769007937,"w":0.34888889312744131,"text":"Although polymer notes are more expensive to"},{"x":0.59111111615631318,"h":0.015988371730629947,"w":0.35111110687255853,"text":"produce, their durability makes them cheaper","y":0.75000000012063472},{"text":"and more ecologically sound* over time.","y":0.76453488399267622,"x":0.59333334561599382,"w":0.30444442749023437,"h":0.013242893748813267},{"y":0.81104651146739315,"h":0.010174418586531453,"text":"2","w":0.01111111044883728,"x":0.044444444664470256},{"text":"Match statements 1-4 with texts A-C. One text has","x":0.057777779180808973,"y":0.8125000000332846,"w":0.42444442749023442,"h":0.010212418300653558},{"text":"two matching statements.","y":0.82703488363929378,"x":0.068888889380723697,"w":0.20888889312744141,"h":0.011627907067342624},{"text":"1 Different countries make their banknotes out of","h":0.011627907067342513,"x":0.071111120048990908,"w":0.3866666412353516,"y":0.84302325562330549},{"y":0.85743464041967565,"text":"different substances.","x":0.095555554615193758,"w":0.1555555534362793,"h":0.011846405228758128},{"w":0.31333332061767577,"x":0.068888892394865883,"y":0.87209302340628903,"h":0.011627906288196765,"text":"2 Not all banknotes are available to the"},{"text":"general public.","x":0.095555558070938643,"y":0.88643790847802495,"h":0.013271393339618354,"w":0.11333333015441895},{"y":0.90116279053716064,"text":"3","h":0.010174418586531564,"x":0.068888889108914692,"w":0.01111111044883728},{"h":0.013100395015641753,"text":"Despite high production costs, new British","x":0.095555554423737879,"y":0.90114379076518014,"w":0.32222221374511717},{"text":"banknotes will be more cost-efficient in the","h":0.010364417157141981,"x":0.095555571537879733,"y":0.91569767438405991,"w":0.32666664123535155},{"y":0.92979651162801558,"w":0.075337419509887704,"h":0.015723325068654592,"text":"long run.","x":0.092141748921030026},{"h":0.011627907067342513,"y":0.9447674419120653,"w":0.015555555820465083,"x":0.066666666626804483,"text":"4"},{"text":"The way banknotes are disposed of has changed.","w":0.38444442749023439,"x":0.084444446514142305,"h":0.013157394197252148,"y":0.94476744212615504},{"h":0.011627907067342513,"w":0.026666665077209467,"x":0.048888889461395274,"y":0.96366279072504968,"text":"56"},{"y":0.81500143284992532,"w":0.082482175827026327,"h":0.012438994607115061,"x":0.53987002402174056,"text":"GLOSSAR)"},{"text":"legal tender (collocation) - coins or banknotes that","y":0.83575581383551478,"x":0.54666667568299687,"w":0.38222221374511722,"h":0.011627907067342513},{"x":0.54666667120341006,"w":0.2999999809265137,"h":0.011637406411513784,"text":"people can officially use to pay for things","y":0.85029069811559166},{"x":0.54888889263341856,"h":0.013261893995447083,"text":"durable (adj) - staying in good condition for a long time,","w":0.41555553436279291,"y":0.86337209309514718},{"x":0.54666666857502122,"w":0.12888888359069828,"h":0.011846405228758128,"text":"even if used a lot","y":0.87785947705722223},{"text":"crucial (adj) - extremely important because other things","w":0.40888889312744148,"x":0.54666665773257572,"y":0.89379084982131041,"h":0.011846405228758128},{"w":0.095555553436279306,"y":0.90843023266894363,"h":0.010278917605580862,"x":0.54888888957074922,"text":"depend on it"},{"h":0.01312889460644695,"y":0.92151162836040867,"w":0.37555553436279299,"text":"ecologically sound (collocation) - environmentally","x":0.54666668190193679},{"y":0.93604651161167762,"x":0.5466666671707493,"h":0.011627907067342624,"text":"friendly","w":0.05555555343627927}]
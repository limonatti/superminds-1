[{"w":0.14888888359069824,"text":"USE OF ENGLISH","h":0.011627906487912565,"y":0.07412790729383445,"x":0.01555555696391016},{"w":0.36666664123535159,"x":0.0022222369101019624,"text":"7 Complete the sentences using the prompts","h":0.013178689917739517,"y":0.10029069767499221},{"w":0.40444442749023435,"text":"in brackets. Do not change the order of the words.","x":0.026666680199327147,"y":0.11469387765964967,"h":0.011836734693877582},{"h":0.013088514366928372,"y":0.12936046517135846,"text":"Change the forms or add new words where necessary.","x":0.028888881177020237,"w":0.42888889312744138},{"h":0.013247508613430714,"y":0.14389534865004061,"text":"Use up to six words in each gap.","w":0.2577777671813965,"x":0.028888898483375679},{"text":"I don't think we'll have any problem finding a new","x":0.053333344209680472,"h":0.013194115307866294,"y":0.16122448972426362,"w":0.37333332061767577},{"x":0.055555553963720784,"y":0.17587209332581111,"w":0.37111110687255855,"h":0.011627906487912565,"text":"house, as there are plenty of houses (there\/plenty\/"},{"x":0.055555564325968303,"w":0.27777776718139646,"y":0.19020408180464932,"text":"house) on the market at the moment.","h":0.011836734693877582},{"text":"The architects say they","y":0.20489795935375732,"w":0.17111110687255859,"x":0.05333333716372067,"h":0.011836734693877582},{"x":0.1888888996674668,"w":0.26888887405395512,"h":0.011627906487912565,"y":0.21947674443046239,"text":"(finish\/housing development) soon,"},{"y":0.23255813915391665,"h":0.013156146613918951,"w":0.27555555343627924,"x":0.051111113652230672,"text":"most likely by the end of the month."},{"x":0.028888889331136914,"text":"2","y":0.248546511850393,"w":0.011111110448837277,"h":0.0087209296713069984},{"text":"I can't believe it -","x":0.051111114367234922,"y":0.24854651187219534,"h":0.0087209296713069984,"w":0.13333333015441892},{"x":0.053333349915657496,"y":0.2630813955060437,"h":0.011627906487912565,"w":0.38666664123535155,"text":"(spite\/remind) them three times to buy bread at the"},{"text":"supermarket, they still forgot!","h":0.013224964531100447,"x":0.051111123328956794,"y":0.27616279041360658,"w":0.22444442749023436},{"h":0.010174418079609726,"y":0.29069767451155171,"w":0.011111110448837284,"text":"3","x":0.028888889108914694},{"text":"The builders","w":0.10444443702697753,"x":0.044444449893918582,"y":0.29061224490089166,"h":0.010259847835618618},{"y":0.30523255790391657,"text":"(build\/garage) while we are away on holiday next week.","x":0.053333341594108033,"h":0.013134788980289414,"w":0.40222221374511719},{"y":0.31976744186103867,"text":"(teach\/children)","x":0.33555555649795865,"h":0.013081395674724994,"w":0.12222222328186033},{"text":"for over thirty years when she retires next month.","y":0.33265306116960158,"h":0.013469387755102091,"w":0.37111110687255855,"x":0.051111108647054128},{"x":0.042222222890783423,"y":0.34883720954674136,"h":0.011627906487912565,"w":0.27777776718139646,"text":"l've had a clear-out and given away"},{"h":0.011627906487912565,"x":0.32222222336519368,"text":"(deal\/stuff) so the","y":0.36191860475022974,"w":0.13555555343627929},{"h":0.013208353470782863,"y":0.3763265305766087,"w":0.22222221374511722,"x":0.053333337849663633,"text":"house is looking much better."},{"w":0.022222220897674561,"h":0.011627906487912565,"y":0.39534883733743909,"x":0.43111111172894051,"text":"\/5"},{"text":"8 Complete each pair of sentences with the same word.","x":0.0044444540822389557,"w":0.45111110687255862,"y":0.41999999990042314,"h":0.011836734693877471},{"w":0.40222221374511724,"h":0.013112244897959147,"text":"Are there any underground car parks near here where","x":0.05555556368299687,"y":0.43749999961903296},{"x":0.053333335290025513,"text":"I can leave the car?","y":0.45346938767987754,"h":0.010204081632653073,"w":0.1466666603088379},{"w":0.39111110687255857,"x":0.055555562563720573,"y":0.46653061208176283,"h":0.013120550817372845,"text":"The hundred largest public parks in the UK cover an"},{"h":0.013181062815140754,"w":0.37555553436279299,"text":"area equivalent to almost 56,000 football pitches!","x":0.053333348411195941,"y":0.48110465121787005},{"h":0.013210726368183989,"y":0.49551020419083547,"text":"1 My","w":0.051111111640930171,"x":0.028888889207312668},{"text":"town is Manchester, which is where","y":0.49551020399697343,"x":0.15555556317891422,"w":0.2666666603088379,"h":0.011836734693877471},{"h":0.011627906487912565,"text":"I was born and where I still live.","x":0.053333337337415826,"w":0.23555555343627929,"y":0.510174418849067},{"x":0.053333345898948219,"w":0.30888887405395504,"text":"We live in Madrid, but we have a second","y":0.52470930247309799,"h":0.011627906487912565},{"h":0.011836734693877582,"w":0.33333332061767579,"text":"on the coast where we spend every summer.","y":0.53918367358732433,"x":0.055555557746717742},{"x":0.031111113613152348,"text":"2 Ella is always very","y":0.55377906997552051,"h":0.011627906487912565,"w":0.15777777671813964},{"text":"_. She's never let me","w":0.15777777671813964,"h":0.011627906487912565,"x":0.25555555740018948,"y":0.55377906993918335},{"w":0.12888888359069822,"y":0.56816326533302486,"h":0.011836734693877582,"text":"down in the past.","x":0.055555559815761948},{"x":0.053333334456692257,"h":0.011627906487912565,"text":"I bought a car because there isn't a","w":0.2666666603088379,"y":0.58284883759906692},{"y":0.58257712355276936,"x":0.39769386875643897,"w":0.064612264633178706,"text":"network","h":0.0092643574305942833},{"x":0.055555558559638084,"h":0.010204081632653073,"y":0.59591836753697625,"text":"of buses where I live.","w":0.1555555534362793},{"text":"3","h":0.0087209296713069984,"y":0.61191860504079998,"w":0.01111111044883728,"x":0.03111111152558136},{"y":0.61046511614035071,"w":0.21111110687255855,"x":0.053333331934091198,"h":0.013208353470782752,"text":"The old cottage didn't have"},{"text":"water, so we","x":0.34222222325408252,"y":0.613372093412893,"w":0.095555553436279306,"h":0.0087209296713069984},{"h":0.010276459285191164,"text":"couldn't have a shower.","x":0.055555563816709057,"y":0.6248979590327145,"w":0.17777776718139646},{"h":0.011627906487912565,"w":0.29111110687255853,"x":0.16222221948964677,"text":"as a way to get rid of stress. Maybe I'Il","y":0.63953488406224523},{"text":"do a marathon one of these days.","x":0.055555557365193665,"y":0.65261627874330608,"h":0.013098006735042689,"w":0.25555555343627928},{"text":"In the school holidays, our parents let us run","w":0.34666664123535157,"h":0.013257000981545031,"y":0.6671511626519786,"x":0.042222229160102175},{"x":0.055555567454503782,"text":"as long as we were home for meals.","h":0.013134788980289414,"w":0.26888887405395501,"y":0.68163265306734433},{"text":"You can't get out of the vehicle during the safari, as","w":0.38888889312744135,"x":0.05555555732516812,"h":0.013166825430733886,"y":0.69622092999693985},{"w":0.093333330154418956,"x":0.055555558078346043,"h":0.0087209296713069984,"text":"there will be","y":0.71220930254806747},{"h":0.011836734693877582,"text":"animals around.","w":0.12222221374511721,"x":0.22666667294225618,"y":0.71061224495227382},{"text":"5","x":0.031111111331136917,"w":0.011111110448837284,"h":0.0087209296713069984,"y":0.72674418623992787},{"text":"There are four people in our.","x":0.052869362527834626,"h":0.019753730929627622,"w":0.22308727264404293,"y":0.72170085508910042},{"h":0.011627906487912565,"text":"-, my parents,","x":0.3333333357263048,"y":0.72674418609712899,"w":0.11555555343627927},{"h":0.011627906487912454,"x":0.055555558874452869,"w":0.13555555343627929,"y":0.73982558163976475,"text":"my sister and me."},{"y":0.7542857139414666,"text":"When we move, we'll need to buy some","w":0.30444442749023437,"x":0.055555569106734488,"h":0.013156146613919062},{"x":0.055555560082239136,"y":0.76734693873853577,"text":"appliances, such as a new fridge.","w":0.25111110687255855,"h":0.013176317020338391},{"h":0.010174418079609726,"x":0.43333333381042194,"text":"15","w":0.022222220897674561,"y":0.78779069799750134},{"x":0.48666666728625319,"y":0.066860465306125327,"h":0.010174418079609726,"text":"9","w":0.013333332538604692},{"x":0.49999999266666689,"text":"Complete the second sentence so that it has a similar","w":0.44,"h":0.013139534775091777,"y":0.06686046497755993},{"h":0.013252254408232966,"text":"meaning to the first. Use the words in capitals.","x":0.51111111544823329,"y":0.081224490013431794,"w":0.37555553436279299},{"text":"Although the bigger flat was expensive, we bought it","y":0.098775509841729225,"h":0.013143094899703001,"w":0.40666664123535157,"x":0.53777779727121289},{"y":0.11337209307833518,"w":0.2999999809265137,"h":0.013158519511320188,"text":"because it was in the right location. OF","x":0.53777778838859491},{"x":0.53777778574890567,"w":0.35111110687255853,"text":"We bought the bigger flat in spite of the cost,","y":0.12775510182967775,"h":0.013233270450514145},{"h":0.011627906487912565,"y":0.14244186074586929,"x":0.53777777650816527,"w":0.27111110687255868,"text":"because it was in the right location."},{"text":"1","y":0.15697674432138697,"h":0.010174418079609726,"x":0.51111111091666672,"w":0.020000000000000018},{"text":"The burglar won't be here any more when the police","w":0.40222221374511724,"x":0.5355555530904047,"h":0.011627906487912454,"y":0.15697674443046239},{"y":0.17142857140173273,"x":0.5377777782581652,"w":0.13111110687255856,"text":"arrive. ESCAPED","h":0.010257474938217492},{"h":0.013184622939752089,"text":"By the time the police arrive, the burglar","y":0.18448979560981971,"w":0.30888887405395504,"x":0.54000000701005946},{"h":0.01346938775510198,"text":"2 This house might be worth buying, but other houses","y":0.21346938764621792,"x":0.51333334605488279,"w":0.42444442749023437},{"h":0.013115805022570481,"text":"had no potential. OTHERS","x":0.53777777588480635,"y":0.22816326507133267,"w":0.20444444656372063},{"text":"This house might be worth buying, but","x":0.54000000902041279,"y":0.24273255831127627,"w":0.29777776718139648,"h":0.011627906487912565},{"x":0.79777778158945722,"text":"had no potential.","w":0.13333333015441895,"h":0.011836734693877471,"y":0.25714285720622421},{"y":0.27180232601348964,"h":0.010174418079609837,"w":0.01111111044883728,"x":0.51333333377558132,"text":"3"},{"h":0.011627906487912565,"w":0.39333332061767579,"y":0.27180232586214836,"text":"We are moving to our new house on Monday next","x":0.52888889033005115},{"text":"week. LIVING","x":0.53999999763480633,"y":0.28633720965568932,"w":0.10444444656372065,"h":0.010174418079609726},{"x":0.53777777845009467,"y":0.30087209345535015,"h":0.010174418079609726,"text":"We","w":0.028888888359069775},{"w":0.082252893447876008,"h":0.010280377913494565,"x":0.82887355197925727,"y":0.30081911320093169,"text":"in our new"},{"w":0.13111110687255856,"y":0.31540697698847442,"x":0.54000000375816515,"text":"house next week.","h":0.0087209296713069984},{"h":0.013144281348403619,"y":0.32848837184529256,"x":0.5133333364999999,"w":0.38,"text":"4 Ruth gave me some ideas on how to go about"},{"h":0.014700997021733442,"x":0.53555554684478102,"w":0.35777778625488277,"text":"finding good places to stay in Wales. COUPLE","y":0.34285714273053625},{"w":0.10676084518432627,"h":0.013411901824328276,"text":"Ruth gave me","y":0.35739288568458127,"x":0.53995290903906545},{"y":0.3604651165051258,"text":"on","w":0.022222220897674561,"x":0.90888888992153316,"h":0.0072674412630042706},{"h":0.013213099265585115,"text":"how to go about finding good places to stay in","w":0.35777778625488288,"x":0.53999999933922505,"y":0.37209302302019565},{"x":0.53996973096427725,"h":0.010304477458097483,"text":"Wales.","y":0.38656287757207664,"w":0.051171650886535747},{"w":0.4288888931274415,"y":0.39959183657117636,"x":0.51333333624183464,"text":"5 I think both dark red and deep blue would work well.","h":0.013198861102668658},{"x":0.53770832037100402,"y":0.41551397647271682,"w":0.062361135482788099,"h":0.010541814687300755,"text":"EITHER"},{"w":0.32000000000000006,"x":0.53777778177777757,"text":"I like both dark red and deep blue. I think","y":0.42877906951365496,"h":0.013261746776347283},{"h":0.011836734693877471,"w":0.12888888359069817,"text":"would work well.","y":0.44326530627047545,"x":0.80000000479724354},{"y":0.4622093027153461,"x":0.92000000088449607,"h":0.011627906487912454,"w":0.022222220897674561,"text":"15"},{"h":0.013081395674724994,"y":0.48691860446399415,"text":"10 Complete the text with one word in each gap.","w":0.40888889312744142,"x":0.48888889358442728},{"y":0.51207881405863975,"w":0.14330178260803217,"h":0.035435395532724789,"text":"Books,","x":0.76390466509159027},{"y":0.54069767402029745,"h":0.03197674498266101,"text":"books,","x":0.76222222287758823,"w":0.1422222232818604},{"text":"books","h":0.024506421770368325,"w":0.1227681541442871,"y":0.56768864966304322,"x":0.76417147746676084},{"y":0.598775510234554,"w":0.39555553436279289,"h":0.011836734693877582,"text":"Sitting down with a good book is second nature to me","x":0.51555557010749242},{"x":0.49555556070749246,"h":0.011836734693877582,"w":0.43555553436279298,"y":0.61183673455834586,"text":"- I'd far rather be immersed in a great story than watch TV."},{"text":"It's true that reading is not everyone's '","y":0.6248979592827405,"w":0.28888887405395508,"h":0.011836734693877471,"x":0.49555556636191128},{"h":0.011627906487912565,"text":"but it is mine! That's why I love the picturesque town of","x":0.49555555854739025,"w":0.40888889312744142,"y":0.6395348838563345},{"x":0.49555555451633038,"w":0.42222221374511726,"text":"Hay-on-Wye - it's somewhere all book lovers should visit!","y":0.65261627938685773,"h":0.011627906487912565},{"x":0.60888889790930167,"h":0.011627906487912565,"y":0.66715116296243904,"w":0.29777776718139648,"text":"the border of England and Wales, and it's"},{"w":0.42444442749023442,"y":0.68023255814010852,"x":0.49555556328266065,"text":"famous for having nearly 40 second-hand and antiquarian","h":0.01323682979661589},{"w":0.43333332061767582,"x":0.49777777871894002,"h":0.01321665861168686,"text":"bookshops. Apart from bookshops specialising in particular","y":0.69331395337993407},{"h":0.011836734693877582,"text":"fields and those offering more general stock, there are","x":0.49777778872003381,"y":0.70775510211910075,"w":0.40222221374511719},{"x":0.59777778198118769,"text":"of other places full of books, including pubs","y":0.72081632638602822,"w":0.31999998092651361,"h":0.013195301756566913},{"text":"a fire station and a cinema.","h":0.010249169018803794,"y":0.73546511656581548,"x":0.49555556316447835,"w":0.20222221374511717},{"x":0.51555557308602773,"h":0.013106311875946686,"text":"What's more, every May and June, thousands of book","y":0.75142857178990419,"w":0.38666664123535155},{"y":0.76598837219209026,"x":0.50000000399999989,"h":0.011627906487912565,"w":0.44000000000000006,"text":"lovers gather in Hay-on-Wye to take part in the Hay Festival,"},{"x":0.50000000624082586,"h":0.011836734693877582,"w":0.43555553436279304,"text":"during which all the streets and parks become a giant reading","y":0.78040816319671147},{"text":"site. 4","y":0.79215116318046241,"x":0.49777777779472865,"w":0.046666665077209513,"h":0.011627906487912565},{"y":0.79505813987007878,"h":0.010247982570103176,"text":"reason to go is the opportunity to meet","w":0.29111110687255859,"x":0.61999999920816518},{"text":"authors and listen to readings and lectures.","x":0.50000000500408248,"y":0.80813953509179959,"w":0.31555555343627928,"h":0.011627906487912454},{"text":"It's also amazing that with advancements in technology","y":0.82558139578705159,"x":0.51555555701633038,"w":0.40222221374511724,"h":0.011627906487912565},{"text":"and many more people now reading e-books, the town still","h":0.011627906487912565,"x":0.5000000093044612,"w":0.4311111068725586,"y":0.8386627908451908},{"y":0.85174418623278791,"text":"attracts those who prefer paper versions. Soon, I'll","x":0.50000001212154943,"w":0.36444442749023431,"h":0.011627906487912565},{"w":0.013333332538604692,"x":0.49777777810106805,"y":0.8648255815306255,"h":0.0087209296713069984,"text":"5"},{"text":"been visiting Hay-on-Wye every May for over","x":0.5844444612434353,"y":0.86612244897933699,"h":0.011836734693877582,"w":0.3266666412353515},{"y":0.87918367354703486,"text":"twenty years, and I hope I'll be visiting for many years","h":0.011836734693877582,"x":0.5000000060303873,"w":0.39111110687255857},{"h":0.0088406901456871134,"text":"to come.","x":0.49776006512045007,"y":0.89528895714512724,"w":0.068924312591552794},{"text":"Total","h":0.013081395674724994,"x":0.81555555527212742,"y":0.93604651157397467,"w":0.051111111640930185},{"y":0.90988372109100912,"w":0.022222220897674561,"h":0.010174418079609726,"text":"\/5","x":0.92222222288449618},{"h":0.011627906487912565,"y":0.93604651194499733,"w":0.037777776718139644,"x":0.90222222227981919,"text":"\/20"},{"text":"49","w":0.026666665077209495,"x":0.91555555657250631,"h":0.011627906487912565,"y":0.96366279086941586}]
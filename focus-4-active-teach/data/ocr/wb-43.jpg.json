[{"x":0.00666666710891469,"w":0.01111111044883728,"y":0.047965116711164102,"text":"2","h":0.010174418079609726},{"x":0.028888881072558662,"y":0.047965116581625167,"w":0.35777778625488282,"h":0.011627906487912454,"text":"Read the text again. Complete gaps 1-4 with"},{"text":"sentences A-E. There is one extra sentence.","x":0.028888891130723664,"h":0.01022543887702787,"y":0.06244897944693395,"w":0.34888889312744137},{"h":0.011627906487912454,"y":0.079941860636857709,"text":"A The benefits don't stop there, either. Because they","w":0.40444442749023435,"x":0.031111124643771575},{"h":0.011836734693877582,"y":0.094285714453885672,"text":"live in such a reduced space, people buy","x":0.053333343839689074,"w":0.30888887405395504},{"w":0.34444442749023441,"text":"less since there is only room for the essentials","x":0.053333346115993836,"y":0.10755813928109681,"h":0.013258187430245538},{"w":0.31333332061767577,"x":0.053333341163384347,"text":"(things that are important and necessary).","h":0.013133602531588684,"y":0.12204081607248884},{"w":0.35111110687255859,"text":"B This is appealing to people who don't want","h":0.013168011879434394,"y":0.1366279067411259,"x":0.031111116741498392},{"x":0.053148102201383655,"w":0.33814983367919926,"text":"to settle down anywhere and it's also a great","y":0.149264163038479,"h":0.015347657495615508},{"x":0.055555547539225356,"w":0.33777778625488281,"h":0.013081395674724883,"y":0.16569767441917826,"text":"option for those who thrive on variety or who"},{"text":"have to change location for work.","x":0.053333343913384186,"y":0.18023255838395069,"w":0.25333332061767577,"h":0.011627906487912565},{"h":0.01321665939019645,"text":"C The many advantages offered by tiny homes","x":0.031111107511447501,"y":0.1933139531619108,"w":0.35777778625488277},{"h":0.013175130571637883,"w":0.36222221374511721,"x":0.055555562720033896,"text":"explain why people are increasingly looking into","y":0.20775510193142233},{"text":"them as a potential solution to the housing crisis.","x":0.055555556971128156,"y":0.22238372054926536,"h":0.013126483839385417,"w":0.37111110687255855},{"text":"D Tiny houses, due to their size, require fewer","w":0.35333332061767586,"h":0.013265306122449028,"y":0.23673469387697743,"x":0.03111112071893981},{"x":0.053333330267424588,"text":"resources to build and maintain and they","h":0.011836734693877582,"w":0.31111110687255861,"y":0.25142857134442187},{"text":"can be built in far smaller spaces.","w":0.25111110687255855,"x":0.055555561860016846,"h":0.011627906487912454,"y":0.26598837233743911},{"w":0.36666664123535159,"x":0.031111128410101899,"h":0.013196488205267309,"text":"E Bearing this in mind, it is easy to see why tiny","y":0.28040816306596139},{"h":0.011627906487912565,"text":"living could more readily contribute","w":0.26888887405395506,"x":0.055555566334133492,"y":0.29505813970662509},{"text":"to a sustainable, healthy lifestyle.","x":0.055555561860016846,"w":0.25111110687255855,"h":0.011631466223269049,"y":0.30959302350022977},{"text":"Read the text again and decide if the sentences are","x":0.02888889786001677,"h":0.013227337428501684,"w":0.41111110687255864,"y":0.32979591847572132},{"h":0.011627906487912565,"text":"true (T) or false (F).","x":0.031111115119276212,"y":0.34447674443046239,"w":0.15111110687255858},{"h":0.011627906487912565,"x":0.031111126151936723,"w":0.35555553436279302,"y":0.36191860482290417,"text":"1 People tend to live in tiny houses for similar"},{"y":0.37936046534233503,"text":"reasons.","w":0.062222218513488768,"x":0.055555558446959273,"h":0.0072674412630042706},{"x":0.031111113352945877,"y":0.39098837230103811,"text":"2 Lidia didn't want to rent somewhere to live","w":0.34888889312744142,"h":0.010236117304587955},{"h":0.010174418079609837,"x":0.057777787357828653,"text":"because it cost too much.","w":0.1933333206176758,"y":0.40552325610069895},{"x":0.031111116814814679,"y":0.41860465078182352,"h":0.013232084001813638,"text":"3 For Simon and Amanda, the main benefit of","w":0.36000000000000004},{"x":0.055555551222222374,"text":"tiny living was having fewer things.","w":0.26000000000000001,"h":0.011627906487912565,"y":0.43459302354867935},{"h":0.011836734693877582,"text":"4 Aleesha used to spend as much time outside","x":0.031111113514142232,"y":0.44897959183992209,"w":0.36444442749023437},{"text":"as she does now when she lives in a tiny home.","y":0.46366279090575302,"h":0.011627906487912565,"w":0.35555553436279297,"x":0.057777792818603402},{"y":0.47673469353967834,"w":0.32222221374511717,"h":0.01309088804283931,"text":"Since all tiny homes can be easily moved,","x":0.048888887757071196},{"x":0.057597114057705456,"w":0.29382158279418946,"text":"owners can live anywhere they choose.","y":0.48910884361315987,"h":0.016219625667649784},{"h":0.013181063593650344,"y":0.50571428533382834,"x":0.033333339578914337,"w":0.30666666030883788,"text":"6 A teenager has designed a tiny home"},{"text":"which he paid for with his own money.","y":0.52034883720987579,"h":0.013120550817372845,"x":0.057777783584133609,"w":0.28888887405395502},{"text":"4 Complete the definitions with the words in bold","w":0.40260883331298825,"x":0.0087104128020529352,"h":0.015735444049445935,"y":0.5386437769344391},{"y":0.55628318984136838,"x":0.031009357699707508,"w":0.091314620971679666,"text":"in the text.","h":0.010980131966727091},{"h":0.011627906487912565,"text":"to a very small degree or amount","y":0.57412790714848561,"w":0.25333332061767577,"x":0.057777787302273148},{"h":0.014344024658203169,"text":"minimally","y":0.57349659244090812,"x":0.35086557751306624,"w":0.076046624183654765},{"h":0.010174418079609837,"text":"1","x":0.033333333553359143,"y":0.58866279079062145,"w":0.01111111044883728},{"text":"2","x":0.033333333581136909,"y":0.60319767459021856,"w":0.01111111044883728,"h":0.0087209296713069984},{"x":0.057777776142971506,"text":"extremely great or surprising","w":0.21555555343627933,"h":0.01029188389680824,"y":0.5901162793867939},{"y":0.59958591818823948,"h":0.016912798200334866,"w":0.27608709335327142,"x":0.055308756863813958,"text":"money that you borrow from a bank"},{"y":0.61369129478731377,"h":0.017639557196169497,"w":0.17654476165771485,"x":0.057303258102819471,"text":"in order to buy a house"},{"x":0.033333334056184272,"text":"3","y":0.6322674420441915,"w":0.015555554628372194,"h":0.0087209296713069984},{"text":"with a very limited amount of money","x":0.053333332868182308,"y":0.63061224470518051,"h":0.011836734693877471,"w":0.28222221374511719},{"x":0.033333334572506361,"y":0.64680232576512176,"h":0.0087209296713069984,"w":0.026666665077209474,"text":"4"},{"text":"becoming smaller","h":0.011836734693877582,"x":0.057777776011300616,"y":0.64530612262416331,"w":0.13777777671813962},{"h":0.013177503469039009,"y":0.65988372079151336,"w":0.37111110687255855,"text":"5 put several things\/problems in order and deal","x":0.033333329267424577},{"text":"with the most important ones first","w":0.25777776718139644,"x":0.057777783298190638,"y":0.67428571466668141,"h":0.013214285714285734},{"y":0.68895348858010796,"text":"6 much or a lot","x":0.035555560317803235,"h":0.010230185061084973,"w":0.12666666030883789},{"y":0.70930232539422666,"text":"5 Complete the sentences with the words in Exercise 4.","x":0.011111135546802408,"h":0.013146654245804745,"w":0.44888885498046877},{"text":"The number of young people who live at home has","y":0.72674418566554444,"h":0.013255814532844412,"w":0.3866666412353516,"x":0.060000009826768806},{"x":0.060000017798990724,"y":0.74122448986833789,"h":0.011836734693877582,"w":0.40666664123535157,"text":"increased considerably. There are far more nowadays."},{"h":0.010299002978266469,"x":0.035555561005029684,"text":"1 I'Il have to","y":0.75714285715165475,"w":0.10444443702697753},{"h":0.011627906487912565,"y":0.75581395382968719,"w":0.20444444656372074,"x":0.25111110664406566,"text":"today's tasks, otherwise I'll"},{"w":0.18888887405395505,"h":0.011836734693877582,"y":0.77020408175938715,"x":0.060000010565614964,"text":"never get them all done."},{"text":"2 Their house cost a","x":0.035555561416330282,"w":0.16222221374511717,"y":0.78488372114914862,"h":0.010218319795569641},{"w":0.15111110687255863,"h":0.013246321386220505,"text":"five million pounds!","x":0.31333333300816518,"y":0.78326530646567682},{"x":0.062222222468139597,"text":"Unbelievable!","y":0.79941860482284044,"h":0.010174418079609837,"w":0.10444444656372071},{"w":0.2666666603088379,"x":0.035555563178914229,"y":0.81387755118016458,"h":0.011836734693877582,"text":"3 I don't earn much, so things are"},{"h":0.011627906487912454,"w":0.17777776718139648,"text":"but l manage to get by.","x":0.062222229742635041,"y":0.82848837230110195},{"h":0.013124110163474478,"y":0.84156976706089326,"text":"4 Most people find that living","w":0.23333332061767578,"x":0.035555562246717652},{"text":"with fewer","y":0.84149571464643091,"x":0.38442304925934018,"w":0.082265014648437496,"h":0.010322524090202512},{"h":0.01346938775510198,"text":"possessions is good for their mental health.","x":0.062222240382324046,"w":0.32666664123535155,"y":0.855918367630497},{"x":0.035555558727105134,"w":0.42444442749023437,"text":"5 We'd always wanted a house with a pool, so we took","y":0.8706122449344238,"h":0.011836734693877582},{"h":0.016040478141940429,"w":0.11243714332580566,"text":"out a really big","y":0.88246763937935258,"x":0.061737403519437031},{"x":0.28643311523331383,"text":"- we'll be paying it off","y":0.88358739111829965,"h":0.015743216689752093,"w":0.17386823654174804},{"text":"forever!","w":0.060112576484680179,"h":0.010460422282316251,"x":0.059943710756876011,"y":0.89956630055464992},{"w":0.29777776718139648,"y":0.9142441862182531,"h":0.011627906487912565,"text":"6 Most businesses are expanding, not","x":0.037777786798190577},{"x":0.062136934230751423,"h":0.013312479135941468,"text":"I hope we can increase our market share as well.","w":0.3645876693725586,"y":0.92726101447316789},{"y":0.046511627871276828,"x":0.48444445973787964,"w":0.38666664123535155,"text":"VOCABULARY PRACTICE | Describing houses","h":0.014712862287248885},{"x":0.48888889754966358,"h":0.011836734693877582,"y":0.06816326531848993,"text":"6 Look at the vocabulary in lesson 3.4 in the Student's","w":0.44222221374511717},{"text":"Book. Complete the text with the words in the box.","h":0.011627906487912454,"y":0.082848837453718183,"w":0.41555553436279291,"x":0.51333335085564036},{"y":0.097383721149148617,"w":0.1977777671813965,"x":0.5133333406093018,"h":0.010371381020059411,"text":"There is one extra word."},{"y":0.12354651148287676,"x":0.53555555781167941,"h":0.0072674420415138608,"w":0.053333330154418879,"text":"canvas"},{"x":0.60214484898449117,"h":0.010629522362533894,"w":0.069043636322021484,"text":"central","y":0.12041198283203014},{"text":"cramped","y":0.12056454932154492,"x":0.67552596632875805,"w":0.06894806861877445,"h":0.011777877807617188},{"y":0.13662790722103257,"h":0.0087209296713069984,"text":"en suite","w":0.062222218513488747,"x":0.53555555818770006},{"text":"fireplace fitted","x":0.61111111104520233,"y":0.13510204085572375,"w":0.13111110687255856,"h":0.011836734693877471},{"text":"minimalist running snug","y":0.14970930266689642,"x":0.53333333613560674,"w":0.21333332061767574,"h":0.011627906487912565},{"text":"damp","h":0.014909364349988019,"x":0.7605076530053495,"w":0.049804682731628414,"y":0.1197128562515164},{"y":0.12063953493880031,"text":"draughty","x":0.80666666990835467,"w":0.088888883590698242,"h":0.013081395674724994},{"w":0.10444443702697759,"x":0.74888889085688159,"y":0.13517441893984627,"h":0.010174418079609726,"text":"inaccessible"},{"text":"The house where I was born","x":0.50444445017483175,"y":0.31673469407587618,"h":0.019183673469387763,"w":0.4311111068725586},{"y":0.34447674408366469,"text":"My grandmother grew up in a house that was practically","h":0.013081395674724883,"x":0.50666666974671781,"w":0.39333332061767579},{"h":0.011627906487912565,"text":"falling down! I've seen photos and heard all about it. It was","x":0.5066666676503363,"y":0.35901162807871811,"w":0.41777778625488271},{"text":"freezing in winter as there was no central heating and it was","h":0.013213099265585004,"x":0.50444445396077453,"y":0.37209302300202718,"w":0.42222221374511726},{"y":0.38517441827818988,"w":0.27777776718139657,"h":0.013192928859165787,"text":"because there were gaps around all the","x":0.62000000788152387},{"h":0.011836734693877693,"y":0.39959183669465914,"w":0.41555553436279302,"x":0.50666668141860338,"text":"windows where the wind came blowing in. The roof was in"},{"text":"poor condition, so the rain came through, making the house","w":0.42000000000000004,"x":0.50666667191666648,"h":0.011627906487912565,"y":0.41424418621825299},{"h":0.014534882526008541,"w":0.046666665077209513,"x":0.5044444457206545,"y":0.42587209337846854,"text":"very2"},{"y":0.42732558135352905,"w":0.27777776718139657,"h":0.013082582123425501,"x":0.65333333400189442,"text":".Her family spent most evenings sitting"},{"text":"round the big open 3","y":0.44040697641772475,"x":0.50666667145669209,"w":0.1466666603088379,"h":0.013081395674724883},{"x":0.7577777782242634,"w":0.15777777671813964,"h":0.011627906487912565,"text":", trying to keep warm.","y":0.44186046521534617},{"x":0.72000000312279044,"h":0.011627906487912565,"text":"kitchen, just some old","w":0.15333333015441897,"y":0.45494186062232278},{"x":0.50666668221784561,"w":0.42444442749023437,"h":0.013201234000069673,"text":"cupboards and a sink and a fridge that made a terrible noise.","y":0.46802325562678493},{"text":"It wasn't in such bad condition that it didn't have 5","w":0.35555553436279297,"x":0.50666668148527005,"y":0.48110465126185775,"h":0.011627906487912565},{"w":0.41555553436279302,"y":0.49551020395464362,"h":0.013210726368183989,"x":0.50666668418897354,"text":"water, but the water never got particularly hot as the boiler"},{"h":0.011627906487912565,"y":0.51017441877639258,"w":0.4133333206176758,"text":"didn't work too well. Of course, there was no such thing as","x":0.50666667819116196},{"y":0.52325581379682951,"x":0.64444444824427394,"h":0.010213574000767278,"text":"bathroom! The bedrooms were small and","w":0.28666666030883792},{"h":0.014693877551020362,"y":0.53632653084072357,"x":0.61777778916637272,"w":0.31999998092651372,"text":". When she was young, she didn't miss these"},{"y":0.55087209326767161,"w":0.42000000000000004,"x":0.50666667191666648,"h":0.011627906487912565,"text":"luxuries because she loved being out in the hills and woods."},{"y":0.56530612230439559,"text":"Sometimes when I'm listening to the rain as I lie in my cosy","w":0.41333332061767569,"h":0.011836734693877471,"x":0.50666666785782899},{"y":0.57843888508846719,"h":0.011726880754743374,"w":0.082255010604858403,"text":"bed in my 8","x":0.50887249529789702},{"y":0.57836734692411296,"w":0.20888887405395506,"text":"modern semi-detached house","h":0.010295443632164836,"x":0.69555555949154113},{"w":0.38,"h":0.011627906487912565,"text":"surrounded by all my bits and pieces, I think about my","y":0.59302325613104379,"x":0.50666666191666676},{"x":0.50666666169444452,"h":0.020425959995814758,"text":"grandmother's house. I'm glad to live in town and not in an","w":0.42000000000000004,"y":0.60610465194219254},{"y":0.61918367337860847,"text":"house in the middle of nowhere, sleeping on","w":0.31111110687255861,"h":0.01308376857212612,"x":0.62222222745260947},{"w":0.064444441795349139,"y":0.63372093057387324,"h":0.011627906487912565,"text":"an old 10","x":0.50666666691714024},{"text":"camp bed!","x":0.67333333344852686,"w":0.075555553436279288,"h":0.010246796121402668,"y":0.63510204091622202},{"text":"WORD STORE 3E | Idiomatic expressions","y":0.67428571439408858,"w":0.34444442749023435,"x":0.49333334611599383,"h":0.011836734693877582},{"text":"7 Complete the sentences. The first letters are given.","y":0.6946938776143875,"x":0.49333335546456325,"w":0.43777774810791015,"h":0.011836734693877582},{"text":"When we were young, there were no rules. The","x":0.54222223026633032,"y":0.71220930242464842,"w":0.36222221374511721,"h":0.011627906487912565},{"h":0.010174418079609837,"y":0.72674418623635795,"w":0.17555555343627927,"x":0.54666666948186027,"text":"children could run wild"},{"x":0.52000000876633024,"text":"1 In tricky situations, you need to keep your w","y":0.73982558156709022,"h":0.011627906487912565,"w":0.36222221374511721},{"w":0.30666666030883794,"x":0.54444444443817375,"y":0.75290697679926544,"text":"about you and think of solutions quickly.","h":0.013215472162986241},{"text":"2 We had a h","y":0.7673469389200942,"h":0.010269339814478085,"x":0.52000000221519371,"w":0.11555555343627932},{"w":0.22666666030883786,"x":0.6955555549566923,"text":"_moment when the bedroom","h":0.011836734693877582,"y":0.76734693873075788},{"w":0.35129188537597655,"text":"ceiling collapsed, but everyone got out safely.","x":0.5465684637411925,"y":0.78036200557426927,"h":0.013479337108378453},{"h":0.011627906487912565,"text":"3 l've always enjoyed my own c","x":0.52000000531889723,"y":0.79505813973084993,"w":0.25555555343627934},{"w":0.10666666030883787,"y":0.79505813992464847,"text":"_. Spending","x":0.82222222362335884,"h":0.011627906487912565},{"x":0.54444445071565784,"text":"time by myself allows me to recharge my batteries.","y":0.80813953479345146,"h":0.013084955020826738,"w":0.38666664123535155},{"text":"4 Living in the country isn't everyone's cup of t","x":0.5200000040288717,"y":0.82122092999693974,"h":0.013081395674724883,"w":0.36888889312744133},{"text":"but it's perfect for me, as l've always loved nature.","w":0.38,"y":0.83575581419790423,"h":0.011627906487912565,"x":0.54666667299999971},{"text":"5 It's always been s_","w":0.1644444465637207,"y":0.85020408161722583,"h":0.011836734693877582,"x":0.5200000016811025},{"y":0.85174418643015648,"h":0.010296630080865343,"w":0.19333332061767572,"text":"-nature to me to set my","x":0.73333333646894006},{"x":0.5466666671563134,"y":0.86191860427019562,"w":0.35111110687255853,"h":0.013183436491051581,"text":"burglar alarm before going out. I can't believe"},{"x":0.54444445105336725,"h":0.011627906487912565,"text":"I forgot yesterday.","y":0.87790697694015218,"w":0.14222221374511723},{"h":0.011627906487912565,"x":0.52222222176144739,"text":"6 People notice if you tell them to do things you","y":0.89098837227929961,"w":0.37777778625488279},{"w":0.32222221374511717,"text":"never do. You need to practise what you p","y":0.90552325613104367,"h":0.011627906487912454,"x":0.54666666687744137},{"y":0.91860465133453206,"text":"7 When the house caught fire, Sandra kept a c","h":0.011627906487912565,"w":0.36666664123535153,"x":0.52000001729899081},{"text":"head and called the emergency services. She didn't","h":0.011627906487912565,"w":0.395555534362793,"y":0.93168604670759403,"x":0.54666668385564032},{"y":0.94583133473447989,"w":0.090048055648803693,"h":0.013204268630670035,"x":0.54601377469298207,"text":"panic at all."},{"h":0.011627906487912454,"text":"41","x":0.91999999995785164,"y":0.96366279100438268,"w":0.024444444179534841}]
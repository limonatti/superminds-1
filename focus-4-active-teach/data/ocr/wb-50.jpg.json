0.56000000633333313,"w":0.38,"text":"1 Very few \/ several \/ most of our neighbours are","h":0.01322389350217934},{"h":0.011627906288196876,"text":"originally from this town. Most have moved here in","y":0.71075581424931245,"w":0.38222221374511722,"x":0.5866666772755893},{"h":0.013090894892324845,"text":"the past five years.","y":0.72383720937421692,"x":0.58444444860892286,"w":0.14222221374511723},{"h":0.011627906677769695,"text":"2 In our street, people are proud of their small front","x":0.56000001094225593,"y":0.73837209331907994,"w":0.40222221374511724},{"text":"gardens - you can tell as all \/ either \/ every one of","x":0.58666666252006816,"y":0.75285947725503033,"w":0.3777777862548829,"h":0.011846405228758128},{"x":0.58414564707916494,"text":"them is well kept.","w":0.13614281654357918,"h":0.012187690516702432,"y":0.76585705547020178},{"y":0.78052325626738561,"h":0.013185893788057124,"w":0.40444442749023435,"x":0.56000001308821612,"text":"3 Out of the five students, only two managed to get"},{"y":0.79493464036910344,"h":0.010297917852214677,"w":0.40000000000000002,"x":0.58444443944444457,"text":"a place in halls of residence. I don't know if another \/"},{"x":0.58433863431327848,"text":"others \/ the others have found somewhere to live yet.","y":0.80680797632006906,"w":0.40250720977783205,"h":0.014620359427009455},{"text":"4 I spent the whole \/ all the \/ a couple of day sorting","x":0.56000001514377151,"y":0.82267441911258909,"h":0.013109894359813024,"w":0.40444442749023435},{"x":0.58444444515631344,"y":0.83700980378015333,"h":0.011846405228758239,"w":0.35111110687255864,"text":"my bedroom out, but it was worth it as it looks"},{"text":"amazing now!","h":0.01021241830065367,"x":0.58444444890835456,"y":0.85171568634364214,"w":0.10888888359069826},{"h":0.013119395262275679,"y":0.86478758141001899,"w":0.42666664123535158,"text":"5 l've looked at so many cookery magazines for recipes","x":0.5600000190860277},{"text":"that I'm not sure if I can be bothered to read","w":0.33555553436279295,"x":0.58444445224452946,"y":0.87936046518590072,"h":0.010345417300080983},{"y":0.89379084980905132,"text":"another \/ other \/ no one.","x":0.58444444468627921,"h":0.010278917605580862,"w":0.18888889312744139},{"y":0.90988372076865431,"text":"15","x":0.96000000061782942,"h":0.011627907067342513,"w":0.022222220897674561},{"text":"Total","y":0.93459302347305417,"h":0.013081394769007826,"w":0.053333334922790465,"x":0.85333333291955715},{"x":0.93999999973421178,"y":0.93459302341491468,"h":0.013081394769007937,"w":0.035555555820465101,"text":"\/30"}]
[{"text":"6","y":0.043604651255737759,"w":0.013333332538604737,"x":0.0066666669158828191,"h":0.010174418079609726},{"x":0.019999999135606822,"w":0.43333332061767582,"y":0.044897959084096661,"text":"Read the task and the letter. Then complete the gaps","h":0.011836734693877582},{"x":0.028888906187879648,"y":0.057959183637259604,"w":0.36666664123535159,"h":0.011836734693877582,"text":"with the correct form of the words in the box."},{"text":"approach complain discriminate draw","x":0.048671734784831812,"h":0.015921872197365294,"y":0.081741080489098228,"w":0.32927150726318355},{"h":0.011627906487912565,"y":0.1002906978703848,"text":"humiliate investigate","w":0.17999999999999999,"x":0.048888891888888786},{"h":0.016027721482880231,"y":0.099766693244802584,"text":"reason respond","x":0.22634758749382897,"w":0.14971340179443357},{"w":0.066857066154479949,"text":"threaten","x":0.3754603549936576,"y":0.10001861994113626,"h":0.010718573745416071},{"w":0.41333332061767575,"x":0.015555567080050885,"text":"You recently went to a sports centre with a friend to","h":0.011627906487912565,"y":0.13953488392900881},{"w":0.42666664123535158,"text":"play tennis. While you were getting changed, you saw","h":0.013469387755102091,"y":0.15387755083910448,"x":0.017777797604546172},{"x":0.015555563501600709,"w":0.41777774810791019,"text":"four adults making a mess in the changing room, but","y":0.1671511624097306,"h":0.01325700098154492},{"text":"shortly after you started playing, a member of staff","x":0.015555569217845573,"y":0.18163265282509633,"w":0.4044444274902344,"h":0.013134788980289414},{"h":0.013166824652224185,"text":"came up to you and your friend and claimed that you","x":0.015555550305555705,"y":0.19622093016045727,"w":0.41999999999999993},{"h":0.013224964531100558,"w":0.42444442749023442,"x":0.015555569338216025,"text":"had done it. You and your friend were asked to leave.","y":0.21061224491600028},{"text":"Write a letter of complaint. In your letter explain what","x":0.015555558637794746,"y":0.22529069772949795,"h":0.013081395674724994,"w":0.4311111068725586},{"text":"happened and say what you expect from the sports","w":0.40888889312744137,"h":0.011627906487912565,"y":0.23982558160342737,"x":0.015555558547390299},{"x":0.015395709571663429,"text":"centre.","h":0.0096316341477997724,"w":0.055875248908996575,"y":0.25535860148300737},{"text":"Dear Sir or Madam,","w":0.13777777671813965,"x":0.020000002252041238,"h":0.010174418079609726,"y":0.30959302350016604},{"w":0.39777774810791017,"x":0.017777789834933912,"h":0.011627906487912565,"text":"I am writing to draw your attention to an incident that","y":0.32558139539945463},{"h":0.014534884083027833,"text":"took place at the Harwood Sports Centre last Sunday.","w":0.3888888931274414,"x":0.015555553519612637,"y":0.33866279033493951},{"text":"My friend and I were treated extremely badly by staff and","x":0.01999999946894011,"w":0.41333332061767575,"h":0.011836734693877582,"y":0.35306122454729794},{"text":"it was such a 1","x":0.019983950539375465,"h":0.011748510477494256,"w":0.10225432395935059,"y":0.36476527925820901},{"h":0.010226625325728378,"text":"experience that we decided","x":0.22888888975707111,"y":0.36773255847472996,"w":0.20222221374511717},{"h":0.011836734693877471,"x":0.020000010250800174,"w":0.2488888740539551,"y":0.37918367345982551,"text":"to contact you and make a formal 2"},{"y":0.39673469400441252,"text":"Last Sunday, we had booked a tennis court at the sports","w":0.40444442749023446,"x":0.020000003421549586,"h":0.011836734693877693},{"x":0.019999998008165213,"y":0.41133720960488085,"text":"centre and had just started playing when one of the staff","w":0.41111110687255864,"h":0.011627906487912565},{"h":0.011627906487912565,"x":0.13555555912744141,"text":"us. Her name was Karen (according to the","w":0.30222221374511715,"y":0.42441860470178017},{"x":0.020000001214057015,"y":0.43750000000057354,"h":0.013112244897959258,"text":"badge she wore) and she accused us of making a mess in","w":0.40888889312744142},{"x":0.020000007327062405,"text":"the changing rooms. When we tried 4","w":0.2666666603088379,"h":0.013092074491539818,"y":0.45058139496787009},{"h":0.010174418079609726,"text":"with","x":0.39555555621217908,"y":0.45203488381387724,"w":0.03333333253860471},{"text":"her and explain that we weren't responsible, she asked us","y":0.46511627912038478,"h":0.011627906487912454,"w":0.41555553436279297,"x":0.020000003744529662},{"y":0.47819767454674134,"w":0.27555555343627924,"h":0.011627906487912565,"text":"to leave. To make matters worse, she 5","x":0.020000003592971414},{"x":0.40444444460043927,"w":0.017777777910232551,"text":"to","y":0.48110465101776057,"h":0.0072674420415137497},{"h":0.011836734693877471,"y":0.49265306126069963,"x":0.020000008290025306,"w":0.30666666030883788,"text":"ban us from using the sports centre again."},{"text":"The truth is, the changing rooms were already in a terrible","y":0.51017441877639258,"h":0.011627906487912565,"x":0.02000000299183469,"w":0.40888889312744142},{"text":"state when we arrived. We noticed a group of four adults","w":0.40888889312744142,"x":0.02000000299183469,"h":0.011627906487912565,"y":0.5232558141252297},{"y":0.53779069783162514,"x":0.020000010491162071,"w":0.4133333206176758,"text":"there who were dropping rubbish and generally making a","h":0.011627906487912565},{"h":0.011627906487912565,"text":"mess. When we mentioned this, Karen simply laughed and","y":0.55087209318046237,"w":0.41777778625488282,"x":0.022222222161447435},{"h":0.010275272836490545,"text":"refused to believe us or even to check the CCTV. In the end,","y":0.56530612227405075,"x":0.020000015551178835,"w":0.42444442749023437},{"h":0.011836734693877471,"text":"we left the sports centre without being able to play and","x":0.020000009266330176,"y":0.57836734706512738,"w":0.40222221374511724},{"text":"feeling very annoyed.","x":0.020000003506123819,"y":0.59142857126537263,"w":0.15333333015441894,"h":0.011836734693877582},{"x":0.020000004540025474,"text":"We ask that you","w":0.12666666030883789,"h":0.011627906487912565,"y":0.60755813963395067},{"y":0.60897959179172734,"h":0.010206454530054199,"w":0.19111110687255856,"x":0.25555555576372074,"text":"the matter and refund the"},{"h":0.011836734693877582,"w":0.4222222137451172,"y":0.62204081649801712,"text":"money that we spent booking a tennis court and travelling","x":0.0222222310163302},{"text":"to and from the sports centre. It is extremely unfair","x":0.02000000183931043,"y":0.63510204100273049,"w":0.37333332061767577,"h":0.011836734693877471},{"x":0.13111111017891453,"y":0.64970930271534599,"h":0.011627906487912565,"text":"_against young people in this way.","w":0.24666666030883788},{"w":0.17111110687255859,"h":0.011627906487912565,"x":0.017777777045202291,"y":0.66569767471147012,"text":"I look forward to your 8"},{"w":0.11397496223449709,"y":0.68297883216085831,"x":0.019703861651298657,"text":"Yours faithfully,","h":0.011950028867137696},{"h":0.0087209296713069984,"y":0.70203488394341618,"x":0.02222222596020643,"w":0.10888888359069823,"text":"Simon Redman"},{"h":0.013894245381257941,"x":0.0065734975643440309,"w":0.44684669494628898,"text":"7 Rewrite the sentences using so or such and make any","y":0.73687759315451562},{"w":0.20000000000000001,"h":0.011627906487912565,"text":"other necessary changes.","y":0.75290697718240041,"x":0.031111113629629549},{"y":0.77020408175938715,"text":"We were treated very badly. We decided to contact you.","w":0.40666664123535157,"x":0.055555561493435518,"h":0.011836734693877582},{"h":0.011627906487912565,"text":"We were treated so badly that we decided","w":0.31111110687255861,"x":0.057777780860016961,"y":0.78488372136844686},{"x":0.057546954040463519,"h":0.010894591273093668,"text":"to contact you.","y":0.7999661036366823,"w":0.10923694610595704},{"w":0.4311111068725586,"y":0.81250000005507939,"x":0.031111119230387167,"text":"1 The experience was humiliating. We want to complain.","h":0.013214285714285734},{"x":0.031111106111111189,"y":0.84156976772261349,"w":0.39999999999999997,"h":0.011627906487912565,"text":"2 We received terrible service. We won't be coming"},{"w":0.17555555343627932,"x":0.057777778459638149,"text":"back to your restaurant.","y":0.85591836739985072,"h":0.011836734693877582},{"h":0.013128855958276842,"w":0.38000000000000006,"text":"3 The waiters took a long time to bring the food.","y":0.88367346956803927,"x":0.031111116037036871},{"y":0.89959183679512855,"x":0.055555551088510118,"h":0.010291883896808129,"w":0.20444444656372068,"text":"It was cold when it arrived."},{"h":0.011627906487912454,"y":0.92732558163976475,"text":"4 It was unfair. We were annoyed.","w":0.2666666603088379,"x":0.031111117623358737},{"y":0.052244897995138539,"w":0.27111110687255857,"h":0.011836734693877471,"text":"SHOW WHAT YOU'VE LEARNT","x":0.50222222660075777},{"y":0.077034883339963112,"h":0.013169198328134901,"text":"8 Read the task below. Before you start writing, note","x":0.49555555760075776,"w":0.4311111068725586},{"text":"down some ideas and plan your work.","h":0.011627906487912565,"w":0.30444442749023437,"y":0.093023256022032097,"x":0.51555556783821599},{"y":0.1162790693864747,"w":0.37777774810791021,"h":0.013108685551857513,"text":"Last Saturday, you went to Tino's Restaurant to","x":0.51555556542752667},{"x":0.51555556622601084,"h":0.011836734693877582,"w":0.395555534362793,"y":0.13061224480373756,"text":"celebrate your birthday, but the food and service"},{"text":"were terrible - you had a long wait for your food","y":0.1453061226302832,"w":0.39111110687255868,"h":0.013124110163474589,"x":0.51555555376372064},{"h":0.010320360611896118,"text":"and when it came some dishes were cold and one","x":0.515555556289225,"w":0.39777778625488291,"y":0.15988372113824745},{"x":0.5155555648218858,"w":0.40222221374511713,"text":"order was incorrect. You complained to the waiter","y":0.17428571439408858,"h":0.011836734693877582},{"x":0.51555557059638124,"h":0.011627906487912454,"y":0.18895348858017169,"w":0.35555553436279297,"text":"but he was rude and refused to do anything."},{"w":0.35999999999999999,"y":0.20348837245371809,"x":0.51555555373333339,"text":"The manager was not there. Write a letter of","h":0.011627906487912565},{"w":0.40666664123535157,"x":0.51555557233787974,"h":0.011836734693877582,"text":"complaint to the restaurant manager. In your letter","y":0.21795918384878077},{"h":0.013165638203523566,"text":"explain what happened and say what you expect to","x":0.5155555670800509,"y":0.23102040841654237,"w":0.41333332061767569},{"x":0.51555556613560638,"text":"happen as a result of the letter.","y":0.24563953517658632,"w":0.25333332061767577,"h":0.011627906487912565},{"text":"SHOW THAT YOU'VE CHECKED","h":0.01346938775510198,"y":0.51142857168178479,"x":0.50444445172676211,"w":0.27777776718139646},{"x":0.495555556285943,"h":0.011836734693877582,"text":"In my letter:","y":0.5363265307662638,"w":0.1111111068725586},{"y":0.56244897964691609,"x":0.5066666682900256,"h":0.013132416082888287,"w":0.30666666030883794,"text":"• in the first paragraph I have explained"},{"x":0.52222222479819069,"h":0.011627906487912565,"w":0.21777776718139641,"text":"the reason for my complaint","y":0.57703488400168323},{"text":"• in the main part l have described the situation,","y":0.595918367153905,"x":0.50666666680227335,"w":0.37333332061767577,"h":0.013093260940240325},{"y":0.61046511647503598,"h":0.011627906487912565,"text":"including all the information given in the","w":0.3111111068725585,"x":0.52222222952668351},{"text":"task, and my reaction. I have used a range of","x":0.5222222263937718,"y":0.62489795911150892,"w":0.34444442749023441,"h":0.011836734693877471},{"text":"narrative tenses.","y":0.63953488405612524,"x":0.52222222329002566,"w":0.12666666030883789,"h":0.010261034284319237},{"text":"• in the last paragraph, 1 have stated my","h":0.013144281348403619,"x":0.50666667241746699,"w":0.30888887405395504,"y":0.65836734693954024},{"y":0.67296511666883441,"text":"expectations as a result of the letter and that","x":0.52444444512744159,"w":0.34222221374511719,"h":0.011627906487912565},{"w":0.17777776718139648,"x":0.52222222974263499,"y":0.6873469386306712,"h":0.011836734693877582,"text":"I am expecting a reply."},{"text":"• I have used formal language.","x":0.50888889815004235,"y":0.70930232582581121,"h":0.011627906487912565,"w":0.23777776718139643},{"y":0.73102040849527306,"text":"• I have not used contractions (e.g. I'm, it's,","h":0.013165638203523566,"x":0.508888900802273,"w":0.33333332061767573},{"h":0.010325897372498782,"text":"that's).","x":0.52440761918659851,"y":0.74556379547973384,"w":0.04896254062652583},{"text":"• I have used an appropriate formal ending","h":0.011836734693877582,"x":0.50888888769705398,"y":0.76448979585882515,"w":0.33111110687255862},{"y":0.77906976764993896,"w":0.16222221374511714,"h":0.011627906487912565,"text":"(e.g. Yours faithfully).","x":0.52222222848855249},{"h":0.011836734693877582,"y":0.80081632667545133,"w":0.22888887405395508,"x":0.5088889001211705,"text":"• I have checked my spelling."},{"text":"• my handwriting is neat enough for someone","w":0.35333332061767575,"x":0.50888890113560636,"h":0.013081395674724883,"y":0.82122093004538954},{"h":0.010429099725217328,"w":0.091177186965942347,"x":0.52441140560640109,"y":0.83708196184051986,"text":"else to read"},{"y":0.67151162761321892,"w":0.020000000000000018,"h":0.013081395674724994,"x":0.91111111099999997,"text":"C"},{"text":"63","y":0.96220930249732262,"x":0.91555555668361743,"w":0.026666665077209495,"h":0.011627906487912565}]
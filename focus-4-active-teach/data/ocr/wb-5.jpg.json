":0.11546840667724609},{"h":0.0088845842375768758,"y":0.28052325582451765,"w":0.23093681335449218,"text":"1. Ifyou don't do any exercise, I'm not surprised you","x":0.030501095120139484},{"text":"feel unwell so often.","w":0.08496731758117676,"x":0.0435729871516774,"y":0.28924418626021919,"h":0.0072674413240383373},{"y":0.2964970810401395,"text":"2 I'm sorry I was rude to you. I've had a difficult day.","x":0.030501095120139484,"h":0.0087572977481233938,"w":0.23093681335449218},{"y":0.31395348830998282,"text":"3 Are you going to do it again?","x":0.030501093627886392,"h":0.008815485800774181,"w":0.14161219596862792},{"text":"4 I don't know why you didn't call me first to check.","y":0.3226744187363394,"h":0.008851853085121042,"w":0.22875816345214844,"x":0.028322439515755971},{"x":0.030501088502126877,"y":0.33861551275786583,"h":0.010425354462051839,"w":0.17647058486938477,"text":"5 l am convinced she is telling the truth."},{"h":0.010425354462051617,"x":0.026143787809065327,"text":"The SPEAKINGBANKliststhe key","y":0.38073394501788305,"w":0.19172113418579104},{"h":0.010179267514239143,"y":0.39098837233447703,"w":0.19389978408813474,"x":0.026143792296891153,"text":"phrases from the Speaking lessons."},{"w":0.08496731758117676,"h":0.0088579143654613501,"y":0.41701417862300538,"x":0.023965141536209052,"text":"SPEAKING BANK"},{"text":"Beginning your answer","x":0.02178649411713738,"w":0.10239650726318361,"y":0.43313953501540925,"h":0.0088954942240329071},{"w":0.06753812313079835,"h":0.0087572977481233938,"text":"1 firmly believe\/","x":0.019607843908457056,"y":0.44328607159564082},{"x":0.019607844240124093,"text":"I'm not convinced","y":0.4520348838680196,"h":0.0072674413240383373,"w":0.078431367874145508},{"w":0.082788667678833,"x":0.019607846189632107,"y":0.46075581398827725,"h":0.0088021510635644118,"text":"they do because..."},{"h":0.0088506409085920001,"w":0.12200435638427734,"text":"One obvious\/clear advantage","x":0.021786494865232341,"y":0.47238372091657199},{"
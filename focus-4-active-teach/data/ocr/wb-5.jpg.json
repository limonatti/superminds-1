388,"h":0.010611730580333711,"w":0.19198829650878907,"x":0.37020816168735332,"text":"GRAMMAR: Train and Try Again page 174"},{"h":0.0088009384893397158,"w":0.20915031433105463,"y":0.38073394511201464,"text":"The REMEMBER THIS boxes focus on","x":0.34204793913076886},{"text":"usetul language nuances.","x":0.34204793367652309,"y":0.39241034189744939,"w":0.14596949577331542,"h":0.0087572977481233938},{"x":0.33769063062604859,"y":0.41701417843450916,"h":0.0075062552126772264,"text":"REMEMBER THIS","w":0.091503267288208012},{"w":0.19172113418579106,"h":0.0075062552126772264,"x":0.33986928359700996,"y":0.43160967481349488,"text":"The noun chance can be used to describe:"},{"w":0.23747276306152348,"y":0.44186046514137822,"x":0.34204793456945609,"text":"The possibility that something will happen, especially","h":0.0087209300660808786},{"h":0.0089270128022639339,"y":0.45037531264744313,"x":0.33986928442463032,"w":0.11546840667724612,"text":"something you want, e.g."},{"h":0.0075062552126772264,"x":0.34204793485793566,"w":0.23965141296386722,"text":"There's an element of chance when you buy a suitcase.","y":0.45913261034326669},{"w":0.23311546325683596,"h":0.010174418012732001,"text":"There's a good chance the contents will be valuable.","y":0.46656976756824631,"x":0.34204793485669449},{"y":0.47819767455029294,"text":"An opportunity to do something, e.g.","w":0.16775598526000973,"x":0.3398692812625152,"h":0.0088748860299536769},{"h":0.0072674413240383373,"text":"I haven't had the chance to look in the suitcase yet.","w":0.22875816345214844,"x":0.33986928047436166,"y":0.48691860499205064},{"x":0.34204793943597123,"h":0.0072795642824149409,"text":"He missed the chance to make a lot of money.","y":0.49563953509742853,"w":0.20697166442871096},{"w":0.18518518447875976,"y":0.53488372096502157,"x":0.34204793372285669,"text":"The REMEMBER BETTER boxes","h":0.0089027676809023681},{"x":0.34422658815601487,"y":0.54503753119546372,"w":0.2069716644287109,"h":0.010195026604506774,"text":"provide tips on learning, remembering"},{"w":0.13943354606628416,"x":0.3420479305253184,"text":"and enriching vocabulary.","y":0.55504587139184036,"h":0.010425354462051728},{"h":0.0075062552126772264,"w":0.10457515716552734,"text":"REMEMBER BETTER","y":0.58131776496254739,"x":0.34204793514272652},{"y":0.5944767443177349,"x":0.34204792749935659,"h":0.0087209300660807676,"w":0.24183006286621095,"text":"On a separate piece of paper, make a list in English of"},{"h":0.0089161028158077915,"y":0.60300250189746518,"text":"products or services that you have paid for that fit the","w":0.23965141296386722,"x":0.34204792815858936},{"y":0.61175979992436624,"w":0.24836601257324226,"h":0.0075062552126772264,"text":"categories below. Look at the list later or tomorrow and","x":0.3420479263931176},{"y":0.62051709769361818,"h":0.0075062552126772264,"text":"see if you can remember what the categories were.","x":0.34204793733710642,"w":0.22875816345214844},{"text":"A product\/service that you got for a bargain price.","h":0.0088857964141056955,"w":0.22657951354980471,"y":0.63081395347471148,"x":0.3420479376332311},{"y":0.63953488391646918,"w":0.18300653457641608,"h":0.0072674413240383373,"text":"Aproduct\/service that youpaidout for.","x":0.34204793401898143},{"x":0.34204793158863867,"h":0.0087572977481233938,"w":0.19607843399047853,"y":0.64678899078207541,"text":"A product\/service you shopped around for."},{"text":"A product\/service which you found through online shopping.","y":0.6555232558608548,"w":0.25054466247558599,"h":0.0087803302952605966,"x":0.34204793333192368},{"h":0.0088166979773031118,"text":"A product\/service that you got in a chain store.","x":0.34204793236568021,"w":0.21350761413574215,"y":0.66424418598440138},{"x":0.34204792755001745,"w":0.18518518447875976,"text":"A product that was an impulse purchase.","y":0.67296511641075807,"h":0.0088530652616498617},{"x":0.22657952181863003,"h":0.0029942587676696775,"y":0.77898248538457449,"w":0.054466228485107432,"text":"SKIL
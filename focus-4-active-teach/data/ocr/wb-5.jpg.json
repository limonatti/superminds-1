1},{"h":0.0072674413240383373,"w":0.074074072837829602,"x":0.021786494227417769,"text":"strongly about ...","y":0.63662790717228313},{"text":"I don't have a strong","x":0.019607841955024588,"y":0.64678899097587383,"h":0.0087572977481233938,"w":0.091503267288208012},{"text":"opinion about...","w":0.071895422935485828,"h":0.0087803302952604856,"y":0.65552325584874249,"x":0.021786494523542439},{"x":0.019607845301258094,"text":"I suppose you could","h":0.0088288205379839502,"w":0.08932461738586428,"y":0.66715116277703701},{"text":"say that ...","w":0.045751633644103999,"x":0.021786493308666922,"h":0.0088651878223308112,"y":0.67587209305804485},{"w":0.18736383438110352,"x":0.026143788528402538,"h":0.010174418012732001,"text":"Skills Reviews with speaking, reading","y":0.70930232593186082},{"h":0.0088482165555341385,"text":"and writing tasks in the exam format","w":0.18736383438110349,"x":0.02614379274408872,"y":0.71934945772169234},{"text":"help students to prepare for their exams.","x":0.023965142143811242,"w":0.20043573379516602,"h":0.01017441801273189,"y":0.7296511630321515},{"text":"1D SKILLS REVIEW","x":0.030433357052718577,"h":0.0092165468134811634,"w":0.069852242469787607,"y":0.75265916816625145},{"h":0.0089100411377716071,"text":"The SHOW WHAT YOU'VE LEARNT","x":0.33986928989329612,"y":0.13662790698730842,"w":0.20915031433105469},{"h":0.010187753147637535,"x":0.33986929076475575,"w":0.20915031433105474,"y":0.14678899066977502,"text":"tasks in the Vocabulary and Grammar"},{"y":0.15679733124446738,"text":"lessons help students to check their","w":0.20479301452636722,"x":0.33986928453057108,"h":0.010425354462051728},{"x":0.3420479308148352,"y":0.1671511630321515,"text":"progress and be aware of their own","w":0.20043573379516599,"h":0.01017441801273189},{"h":0.0087209300660808786,"x":0.34204792952307245,"text":"learning.","w":0.047930283546447738,"y":0.17877906988701775},{"x":0.33986928737620759,"y":0.20348837230673078,"h":0.0072674413240383373,"text":"SHOW WHAT YOU
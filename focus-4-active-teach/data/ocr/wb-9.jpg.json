17,"text":"names, but never their faces","w":0.2172948837280273,"h":0.011630285781261018,"x":0.55210643478048016},{"y":0.65548281499683669,"h":0.011865793780687417,"w":0.36585365295410166,"text":"I can remember all the details of my holiday in","x":0.5388026574475614},{"y":0.67005813968915295,"w":0.1507760524749755,"text":"Prague. I have such","h":0.01162790666820579,"x":0.55210642801232757},{"w":0.11529932975769042,"h":0.010233890015247882,"text":"memories of it.","y":0.68453355143672256,"x":0.55210643351361599},{"y":0.69912790723383378,"h":0.010364727966133858,"w":0.099778270721435525,"x":0.52771618781001384,"text":"2 Joe has a"},{"x":0.7915742790456598,"y":0.69912790698566463,"text":"memory. He can","w":0.12860310554504395,"h":0.011627906668205679},{"text":"read a page of any book and then remember","w":0.34811527252197261,"y":0.71220930213478217,"x":0.54988914648106846,"h":0.013240779480255149},{"x":0.55210643369501955,"y":0.72954173470651806,"w":0.12416851043701171,"text":"everything on it.","h":0.010283846316673229},{"x":0.52771618622291827,"y":0.74263502436534856,"h":0.011865793780687417,"w":0.068736143112182568,"text":"3 In my"},{"w":0.1485587501525879,"text":"memory, I'm in the","x":0.76053215671417163,"h":0.010271951922028011,"y":0.74263502448633767},{"text":"garden. I must have been about two years old.","y":0.75726744211163355,"x":0.54988912888766905,"h":0.011627906668205679,"w":0.35920177459716796},{"text":"4 After his accident, he","y":0.77168576095663943,"h":0.010290982875418186,"x":0.52549889962680352,"w":0.19068735122680669},{"w":0.028824832439422687,"text":"his","x":0.87804878063912095,"y":0.77180232564799434,"h":0.0087209301962594132},{"y":0.78254534623447802,"h":0.016600002438659112,"text":"memory completely. He didn't even remember his","x":0.55193271991186321,"w":0.38394676208496092},{"h":0.0074125526384518636,"x":0.55210643180125174,"w":0.086474494934081991,"y":0.80232558161321776,"text":"own name."},{"w":0.21507759094238277,"y":0.813829787085
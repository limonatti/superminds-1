87328245909046309,"w":0.053215074539184615,"y":0.25436046518287792},{"text":"RN: [...] love is a powerful neurological condition.","w":0.37250553131103514,"x":0.022172955039234842,"h":0.01315989822100494,"y":0.27325581376268915},{"w":0.3658536529541016,"x":0.055432379869955743,"h":0.013228885085610154,"text":"When you fall for someone, it's similar to hunger","y":0.28764320785591591},{"h":0.013216990690964825,"text":"or thirst, but'","w":0.10421285629272461,"x":0.05543237595563319,"y":0.30073649743588093},{"text":"permanent.","x":0.27932627227231593,"w":0.088797569274902344,"h":0.010576220854214502,"y":0.30503165693537981},{"text":"That's not a very romantic image.","x":0.055169878606076812,"h":0.014590185324611205,"w":0.25110403060913089,"y":0.31569298248531996},{"h":0.0131218363142247,"text":"RN: Well, no, but it's fascinating. In fact, romantic","x":0.022172961173750529,"y":0.33139534879175891,"w":0.3725055313110352},{"h":0.011627906668205679,"x":0.055432375823622732,"w":0.12416851043701171,"y":0.34447674419496699,"text":"love has all the 2"},{"y":0.34447674457333488,"text":"of addiction.[...]","w":0.13082039833068848,"x":0.29711751593073854,"h":0.014534883140151944},{"x":0.055432385712784187,"y":0.36046511652431701,"text":"You focus on the person, you obsessively think","w":0.35033256530761719,"h":0.013102804970624216},{"h":0.011661210739085659,"x":0.055432369931267121,"text":"about them and you will take enormous risks to","w":0.35698448181152348,"y":0.37500000029961811},{"x":0.055432376614941388,"y":0.38952536820339922,"h":0.011637422340005976,"text":"win this person that you're obsessed with. Also,","w":0.35920177459716796},{"x":0.18181818781279493,"text":"an addict, you need to see them","w":0.24611972808837887,"h":0.011642180175906125,"y":0.40406976752345525},{"h":0.012352907911260091,"text":"more and 4","x":0.055321741273663495,"y":0.41678866197089826,"w":0.086695766448974615},{"text":".[...)","y":0.42005813945613379,"h":0.0087209301962596353,"w":0.03769401311874393,"x":0.25942350404668862},{"y":0.43166939425380091,"w":0.38359199523925774,"h":0.013098047524934486,"text":"First, there's an area deep in the centre of the brain","x":0.057649683450215754},{"x":0.055432379844129825,"w":0.37694011688232421,"text":"- it's a primitive part of the brain which developed","y":0.44622093004175889,"h":0.013271705218500851},{"h":0.013117078088114131,"y":0.46072013124149325,"x":0.055432376901048956,"w":0.37915740966796874,"text":"65 million years ago. I...] The more passionate the"},{"text":"love, the more activity there was in that area.","y":0.47529069768347387,"h":0.013252673874900367,"x":0.057649679738601627,"w":0.33702880859375001},{"text":"We also found activity in a second area of the brain","w":0.38802658081054692,"x":0.055432392336781044,"h":0.011865793780687417,"y":0.48977086736384301},{"y":0.50436046519787392,"x":0.055432382039965339,"w":0.37028823852539061,"text":"that becomes active when people eat chocolate!","h":0.011627906668205679},{"h":0.013245537706365718,"text":"Chocolate can be addictive, 5","y":0.51744186027431704,"w":0.22172948837280274,"x":0.057649671630302136},{"h":0.010174418042022126,"text":"like","y":0.5188953491730296,"x":0.39689578741110909,"w":0.028824832439422576},{"h":0.010350454848643831,"text":"romantic love!","x":0.055432372220907598,"y":0.53343023271227374,"w":0.10864745140075682},{"text":"P:","x":0.01995565424714691,"y":0.54796511638488943,"w":0.019955654144287106,"h":0.011627906668205679},{"x":0.048780481437558122,"text":"And what happens when someone is rejected?","w":0.35920177459716796,"h":0.011865793780687417,"y":0.54787234043768285},{"y":0.56250000006706002,"h":0.011627906668205679,"w":0.3725055313110352,"x":0.057649677093928063,"text":"Does the activity in those areas of the brain stop?"},{"h":0.013207475799585588,"w":0.34589797973632808,"y":0.5755813952125437,"text":"RN: Unfortunately for the broken-hearted, no.","x":0.022172958413432475},{"text":"The obsession can get","x":0.0576496713
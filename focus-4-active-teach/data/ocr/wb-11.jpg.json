[{"w":0.015521063804626464,"text":"2","h":0.010174418042022126,"y":0.04505813964662464,"x":0.0066518847643534376},{"x":0.026607540237649906,"w":0.43237251281738287,"text":"Read the text. Complete gaps 1-5 with sentences A-F.","y":0.045008183487375342,"h":0.013131351205604158},{"text":"There is one extra sentence.","y":0.060965630241592295,"w":0.22172948837280276,"x":0.031042132199407869,"h":0.010255299691482755},{"x":0.031042144768036552,"w":0.38580928802490233,"y":0.078488372189152944,"text":"A Despite these limitations, he is slowly extending","h":0.011627906668205679},{"x":0.055432377577015399,"y":0.092880523622691613,"w":0.15521063804626467,"h":0.011865793780687417,"text":"his emotional range."},{"text":"B At school, he struggled to read body language","x":0.031042142477545484,"h":0.013212233245275318,"y":0.10597381318462284,"w":0.37915740966796874},{"h":0.013157519498160131,"y":0.1206395347474275,"text":"or make eye contact, finding it impossible","w":0.3148558616638184,"x":0.055432379700241584},{"h":0.013231263808454963,"y":0.13502455009964087,"text":"to interpret how other people were feeling","x":0.055432378328351177,"w":0.32372505187988282},{"w":0.37472282409667962,"text":"C Born on a Blue Day was named 'Best Book for","x":0.031042134995266969,"y":0.14970930257082871,"h":0.013138488154559536},{"x":0.055432382682481282,"w":0.35033256530761719,"h":0.013250295152055447,"y":0.16407528643409264,"text":"Young Adults' in 2008 by the American Library"},{"text":"Association.","x":0.057575468724505967,"y":0.17994107784092761,"w":0.091057491302490218,"h":0.010757379172866788},{"h":0.015988371766335496,"text":"O","x":0.4368070949605391,"y":0.17441860468127024,"w":0.024390244483947721},{"h":0.0087209301962595243,"w":0.01330376863479614,"x":0.033259424019630751,"text":"D","y":0.19331395344838187},{"text":"Remarkably, though, he was able to read","x":0.048780489641113894,"y":0.19312602288003466,"h":0.011865793780687417,"w":0.31485586166381829},{"text":"two pages of a book
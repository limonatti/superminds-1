[{"h": 0.015174417977728975, "w": 0.09838997734917537, "x": 0.3452593948546738, "y": 0.006322674677871387, "text": "AKING"}, {"y": 0.061962209537866776, "h": 0.008851743820341951, "x": 0.09660107358349485, "w": 0.008944543202718092, "text": "1"}, {"text": "In pairs, ask and answer the questions.", "w": 0.2844364759657118, "x": 0.11806798267904046, "h": 0.012663609129427173, "y": 0.06320848359045991}, {"h": 0.007768935769903948, "y": 0.08210390416288971, "text": "PART", "x": 0.11803478325426006, "w": 0.041211293538411464}, {"y": 0.09736462072965411, "x": 0.1180679807023039, "w": 0.18962432861328127, "h": 0.012649913892849175, "text": "Talk about your free time."}, {"w": 0.3081513468424479, "y": 0.1111652544768694, "text": "1 What do you like doing at the weekend?", "x": 0.11780244784553225, "h": 0.01569060162086344}, {"y": 0.126453488505195, "x": 0.11627906980072908, "w": 0.012522361543443467, "text": "2", "h": 0.010116278651819317}, {"w": 0.35651757134331596, "x": 0.14106264216718992, "text": "Do you prefer staying at home or going out? Why?", "y": 0.12487876612188634, "h": 0.01822024113865113}, {"w": 0.008944543202718105, "h": 0.008851743820341951, "x": 0.11806797877133028, "text": "3", "y": 0.1403633723285645}, {"text": "What do you like doing with your friends", "x": 0.13774596673188733, "y": 0.14036337242755995, "h": 0.015174417977728975, "w": 0.2880143229166667}, {"text": "in your free time?", "y": 0.15427325585936905, "w": 0.12343470255533856, "h": 0.011403639501613013, "x": 0.1395348845899515}, {"w": 0.010733451843261702, "y": 0.1681831398283828, "h": 0.008851743820341951, "text": "4", "x": 0.1162790702322153}, {"w": 0.23971376207139752, "h": 0.012955776173285189, "text": "Do you play a musical instrument?", "y": 0.16803249128685402, "x": 0.14132379579793278}, {"x": 0.11418226019855593, "w": 0.3493737453884549, "text": "5 Do you enjoy going for a run? Why?/Why not?", "y": 0.18120629228749735, "h": 0.018876978240718836}, {"h": 0.017306441847598084, "text": "2 Look at the photos that show types of food.", "x": 0.08922737353362613, "y": 0.2060146230920914, "w": 0.34926228841145834}, {"h": 0.009011819113032435, "x": 0.11445868564271665, "text": "PART 1", "w": 0.04478566911485461, "y": 0.22627170677657674}, {"y": 0.24220594140070578, "w": 0.4207931857638889, "x": 0.11428127043116698, "h": 0.016106670531124846, "text": "Which of these types of food do you eat? Discuss in pairs."}, {"h": 0.010264580938359816, "y": 0.08591422109426429, "x": 0.561687549082289, "text": "PART 2", "w": 0.050149052937825456}, {"y": 0.10242732580384585, "h": 0.011426464771105413, "x": 0.5635062635523843, "text": "Talk about food.", "w": 0.1234347025553385}, {"y": 0.11558544593033375, "h": 0.017619987807979673, "x": 0.5614916839522265, "w": 0.3689491441514757, "text": "1 Do you like eating healthy food? Why?/Why not?"}, {"text": "2 Do you prefer hamburgers or pizza? Why?", "x": 0.5617173518719, "w": 0.3202146742078994, "h": 0.015320501499658032, "y": 0.13151162841011804}, {"text": "What do you usually eat for dessert?", "x": 0.5760286242395247, "w": 0.2665473937988282, "h": 0.012955776173285189, "y": 0.1452617330884665}, {"w": 0.010733451843261799, "h": 0.008851743820341854, "x": 0.5617173528798002, "y": 0.15933139564233637, "text": "4"}, {"h": 0.019717590499010354, "x": 0.5828480775061156, "y": 0.15696539848142027, "text": "Do you often get a takeaway? Why?/Why not?", "w": 0.32801028781467023}, {"text": "What's your favourite local food? Why?", "y": 0.1731362815710331, "h": 0.015311371841155259, "w": 0.2790697564019097, "x": 0.5813953508688128}, {"y": 0.6183438629957927, "x": 0.10017889094686917, "text": "PART 2", "w": 0.048300535413954, "h": 0.011394508719874583}, {"h": 0.012695564431834262, "w": 0.28264756944444447, "text": "In pairs, ask and answer the questions.", "x": 0.10196781211737213, "y": 0.6360108306979365}, {"h": 0.008851743820341951, "text": "4", "x": 0.5474060825756858, "y": 0.6360610465838333, "w": 0.010733451843261688}, {"text": "What's your favourite type of street food? Why?", "y": 0.6360108299592051, "h": 0.015311371841155259, "x": 0.559928437711773, "w": 0.34883721245659716}, {"w": 0.2289803229437934, "h": 0.013914448724326735, "x": 0.10017889161397085, "text": "1 How do you make pancakes?", "y": 0.6499709303193592}, {"x": 0.5474060825756858, "y": 0.6499709303150787, "text": "5", "w": 0.010733451843261688, "h": 0.010116278651819317}, {"text": "Is it healthy to eat a lot of fast food? Why?/Why not?", "w": 0.37567084418402774, "x": 0.5635062547863405, "y": 0.6512354653981268, "h": 0.015174417977728975}, {"y": 0.6630383211367727, "h": 0.015915303393821897, "w": 0.3027296617296007, "text": "2 How often do you eat vegetarian food?", "x": 0.09994486297599148}, {"h": 0.008851743820341854, "y": 0.6651453490727506, "x": 0.5474060825280387, "w": 0.008944543202718092, "text": "6"}, {"y": 0.665063176898077, "h": 0.015311371841155259, "text": "Do you like eating spicy food? Why?/Why not?", "x": 0.5688729932535855, "w": 0.32915920681423605}, {"x": 0.09826061602663666, "text": "3 Do you prefer eating vegetables or meat? Why?", "h": 0.017045330768888152, "y": 0.6772610405642774, "w": 0.3615984429253472}, {"y": 0.6768718268838768, "x": 0.5435887217844609, "w": 0.3976040988498263, "h": 0.018870506157513556, "text": "7 Which of these types of food do you like best? Why?"}, {"text": "3 Read the instructions on your card. In pairs, take turns to role-play the conversation.", "h": 0.021188149193994397, "x": 0.07487536988223503, "w": 0.6391534423828125, "y": 0.7001638428857976}, {"w": 0.07521956549750433, "y": 0.7345523716901219, "x": 0.12339200669633563, "h": 0.011665605362571907, "text": "Student A"}, {"y": 0.7379258910378053, "text": "Student B", "w": 0.0754594251844618, "x": 0.5436656355329943, "h": 0.012505775814882708}, {"x": 0.12330508295030389, "text": "You are the waiter in a restaurant.", "w": 0.2489341057671441, "y": 0.7586737716302893, "h": 0.012751592918423536}, {"y": 0.7738131771408917, "w": 0.21109122382269963, "h": 0.012727520483065188, "x": 0.12343471355078482, "text": "Ask Student B the questions."}, {"y": 0.7903023462252141, "w": 0.2880142890082466, "text": "• Say hello and ask Student B if he/she", "x": 0.11806798678389109, "h": 0.014133574007220128}, {"h": 0.011490376124743525, "text": "is ready to order.", "x": 0.143112699239971, "y": 0.8055087211864039, "w": 0.12164579603407116}, {"x": 0.12164579667462622, "text": "• Ask what he/she would like to eat.", "w": 0.2629695807562934, "h": 0.011444725211346714, "y": 0.8193546931740153}, {"x": 0.11969470613326062, "h": 0.012897430826180273, "y": 0.8324979352154828, "w": 0.2758192274305556, "text": "• Ask what he/she would like to drink."}, {"y": 0.846498125132306, "x": 0.11964102047029601, "h": 0.015986136873706664, "text": "• Ask if he/she wants a large or a small drink.", "w": 0.32776445176866326}, {"text": "Cau that tho broo dinh le co", "x": 0.1359570729458849, "y": 0.8609702167403226, "w": 0.20930231730143226, "h": 0.007851985559566801}, {"y": 0.7621058378100275, "text": "You're in a restaurant and Student A is the", "x": 0.545478197834156, "h": 0.012313154023476896, "w": 0.3061797078450521}, {"text": "waiter. You want to order the grilled salmon", "y": 0.7764244187394153, "x": 0.5456171677130347, "w": 0.318425767686632, "h": 0.012700130009909388}, {"h": 0.012677304366005072, "y": 0.7903023465777193, "text": "and potatoes and some orange juice. Answer", "x": 0.5438282612130866, "w": 0.32737030029296865}, {"y": 0.8042441861393473, "h": 0.01138081348329678, "text": "Student A's questions.", "x": 0.5438282631626202, "w": 0.16279069688585068}, {"w": 0.24508049858940972, "x": 0.5438282683618245, "h": 0.012718390075738675, "text": "• Say that you are ready to order.", "y": 0.8219476746798221}, {"x": 0.5420393601387901, "text": "• Answer the question about the food.", "y": 0.8358438631641748, "h": 0.012659043551352046, "w": 0.28443647596571175}, {"x": 0.5420393592466579, "h": 0.011563417885708053, "y": 0.8495848376805043, "w": 0.2844364929199219, "text": "• Answer the question about the drink."}, {"y": 0.8737702951205302, "w": 0.2660013495551215, "h": 0.01574588907382546, "text": "• Ask if he/she wants anything else.", "x": 0.11905351699593363}, {"text": "End the conversation.", "x": 0.1417254703064242, "w": 0.15693718804253473, "y": 0.8888899246598106, "h": 0.01249885409368634}, {"text": "• Say that you would like the large size.", "x": 0.541152265693721, "h": 0.013081394896215404, "w": 0.2860082329644097, "y": 0.8779069769523282}, {"x": 0.9032921806923572, "y": 0.9389534883540559, "text": "33", "w": 0.022633745405409078, "h": 0.01162790690711002}]
[{"y":0.063382368737135764,"text":"READING","x":0.084210621708732586,"w":0.094953240288628477,"h":0.014223634728831369},{"w":0.0123456785413954,"x":0.078189300544117116,"h":0.010174418169437871,"y":0.09156976753228685,"text":"8"},{"w":0.37037034776475691,"x":0.10699589978017293,"h":0.011773940345368827,"text":"Read the article, then complete the sentences with","y":0.091444270166461505},{"h":0.011773940345368827,"text":"up to three words from the article.","y":0.10596546302998189,"w":0.25514402601453995,"x":0.10493827931097406},{"text":"WHERE ONE DOOR SHUTS,","y":0.13226059651774091,"w":0.37037034776475697,"h":0.023262659459136525,"x":0.086419768051777882},{"x":0.084362141394126761,"y":0.15541601324162724,"text":"ANOTHER OPENS","h":0.02786499215070648,"w":0.36831275092230908},{"y":0.063953488513617152,"h":0.013081394896215293,"x":0.53086419934725038,"text":"SPEAKING","w":0.10493826972113718},{"w":0.012345678541395344,"y":0.090116279117800513,"x":0.52469135819157942,"h":0.01017441816943776,"text":"9"},{"x":0.55144032435699597,"w":0.38888888888888895,"h":0.011773940345368938,"text":"Look at the pictures. Which sport is your favourite and","y":0.091444269886654661},{"w":0.37448557535807292,"text":"why? Which one would you recommend to a friend?","h":0.013088240541131779,"x":0.55144034457404989,"y":0.10465116292616561},{"h":0.010286225254531933,"y":0.41279069795258727,"w":0.38271603054470488,"text":"Adam started playing football at the age of six. He loved","x":0.094650211991022137},{"x":0.092592597068262797,"w":0.38477366129557294,"h":0.01162790690711013,"y":0.42732558134295662,"text":"it and he was good. When he was eight, he joined the local"},{"w":0.38477366129557289,"h":0.010174418169437871,"text":"football club. He dreamed of a career as a professional","x":0.092592590014079157,"y":0.4433139537665407},{"text":"footballer. At the age of sixteen, he started playing for the","h":0.011627906907110019,"y":0.4578488371859798,"x":0.092592597068262797,"w":0.38477366129557294},{"w":0.38477366129557289,"h":0.013095086186048155,"x":0.092592595449607157,"y":0.47238372093852021,"text":"national junior team. But then, just before his eighteenth"},{"y":0.48822605956167442,"w":0.38477366129557294,"text":"birthday, something terrible happened. His legs became","x":0.092592597068262797,"h":0.011773940345368938},{"h":0.011773940345368938,"text":"very painful after practice and doctors discovered a","x":0.092592588410855617,"y":0.50431711159357295,"w":0.38477366129557294},{"text":"serious medical problem. Adam could not play for six","w":0.38477366129557294,"x":0.092592597068262797,"h":0.011773940345368938,"y":0.51883830464242331},{"x":0.09259259803019694,"w":0.38477366129557294,"y":0.53488372092871239,"h":0.011819575607683097,"text":"months. And he could never become a professional player."},{"h":0.011799039795784227,"y":0.5565149135850963,"x":0.094650211775414675,"w":0.38065843370225694,"text":"At first, he was deeply unhappy. He felt his life was over."},{"text":"But then he had an idea. He was already an experienced","x":0.092592591265793847,"h":0.011812730337050104,"y":0.5710361066436368,"w":0.38477366129557294},{"text":"player. He decided to coach younger boys. He went to","h":0.011773940345368938,"y":0.58712715866584508,"x":0.09259259803019694,"w":0.38477366129557294},{"x":0.092592601489157225,"h":0.011794476157267808,"w":0.36008229573567713,"text":"university to get a degree and took a coaching course.","y":0.6031976744170845},{"x":0.094650212642599679,"y":0.62500000022861546,"w":0.38271603054470482,"text":"Adam's club employed him as an instructor for fourteen-","h":0.01162790690711013},{"h":0.011627906907110019,"text":"year-old boys. The boys liked him and they worked","x":0.090534983379549391,"y":0.63953488386475899,"w":0.38683125813802083},{"text":"well with him. The team started winning their matches.","y":0.65541601259599136,"w":0.38477366129557294,"x":0.092592596204065361,"h":0.011773940345368827},{"x":0.094650219007482911,"text":"After two years they won the national Junior Cup. The","w":0.38271603054470482,"h":0.011773940345368938,"y":0.66993720552371772},{"y":0.68602825755561614,"text":"next morning, on the front page of the newspaper, there","x":0.092592588410855617,"w":0.38477366129557294,"h":0.011773940345368938},{"x":0.09259259803019694,"y":0.70054945066260599,"text":"was a photo of him with his team, and the headline said,","w":0.38477366129557294,"h":0.011773940345368938},{"x":0.09259259803019694,"w":0.38477366129557294,"y":0.71656976743163603,"text":"'BRILLIANT YOUNG INSTRUCTOR LEADS JUNIOR","h":0.0087209301803325978},{"x":0.092592607830852228,"y":0.73110465114915824,"w":0.38683125813802083,"text":"TEAM TO VICTORY'. Adam smiled. His life was not","h":0.011627906907110019},{"y":0.74709302325429383,"w":0.22016460842556423,"h":0.011627906907110019,"text":"over. And his legs felt better too.","x":0.092592595658617008},{"text":"Adam ...","y":0.78178963899153786,"h":0.010361523605777911,"w":0.061728392706976984,"x":0.10082304747367198},{"y":0.79941860473442949,"w":0.17078189425998264,"h":0.011805885066417221,"x":0.21399176607302661,"text":"football when he was six."},{"h":0.01162790690711013,"text":"2 joined the local football","y":0.81540697668210371,"w":0.18106994628906253,"x":0.1008230545646593},{"h":0.011627906907110019,"text":"at the age of","y":0.81540697692435204,"x":0.37860082654501831,"w":0.090534973144531239},{"x":0.11728395138164668,"y":0.8313953488235768,"w":0.041152263217502177,"h":0.011627906907110019,"text":"eight."},{"text":"3 joined the","y":0.84576138146468272,"w":0.08641975402832032,"h":0.010343269425995505,"x":0.10082304587678632},{"text":"4 became ill when he was almost","y":0.8602825746443471,"w":0.22633744981553816,"h":0.010356959967261381,"x":0.10082304746877406},{"text":"5","x":0.10082304518423196,"h":0.0087209301803324868,"y":0.87645348831099645,"w":0.010288065804375551},{"x":0.28600823490849242,"y":0.84576138133639889,"h":0.011796758163667653,"text":"team eight years later.","w":0.15432098388671872},{"text":"for half a year.","w":0.10304073757595489,"y":0.87467821545448077,"h":0.013724964866458578,"x":0.26123683361527694},{"w":0.070120035807291703,"text":"years old.","x":0.42584533276400532,"y":0.86021818832093266,"h":0.012121762735315955},{"x":0.10062126001130123,"y":0.89089347709575395,"text":"6 went on a coaching","w":0.15063917371961805,"h":0.011984835614214928},{"x":0.10067950885180715,"text":"7 his team won the national","y":0.90543915472420167,"w":0.18750929090711804,"h":0.011999090200690676},{"x":0.38883065742951844,"w":0.10093950907389326,"h":0.013537020660831511,"y":0.90529544293792164,"text":"two years later."},{"h":0.013697552344114183,"y":0.5623018421336986,"x":0.52444106605220919,"w":0.17124657524956599,"text":"10 Do the task in pairs."},{"y":0.58956577758695694,"w":0.074361292521158862,"h":0.011275421319239864,"text":"Student A","x":0.54923910608309501},{"text":"Ask Student B to recommend a new sport for you and","x":0.54938271545755113,"w":0.37242797851562504,"y":0.61337209313074736,"h":0.011627906907110019},{"y":0.62637362601633484,"w":0.33744856092664932,"x":0.54938271871362998,"text":"give reasons. Ask about equipment and training.","h":0.013343799058084804},{"h":0.01220557828151636,"text":"Student B","x":0.54723879072936665,"w":0.076304312811957375,"y":0.66686232706082182},{"h":0.011773940345368938,"y":0.69034536891088349,"text":"Recommend a sport to Student A and say why this","x":0.54938272521930442,"w":0.35185184054904517},{"x":0.54938273315844932,"w":0.31069956461588544,"text":"one. Give advice on equipment and training.","y":0.70486656214868737,"h":0.011773940345368938},{"w":0.090674260457356715,"x":0.52873694459891163,"h":0.013571206217096621,"text":"WRITING","y":0.75556904796537327},{"h":0.013343799058084804,"text":"11 Read the email from your English friend, Cathy. Then","x":0.52469136826078078,"y":0.78335949791546067,"w":0.4115226236979167},{"x":0.54938273128737436,"w":0.31481479220920139,"y":0.79788069064927081,"text":"write a reply, answering Cathy's questions.","h":0.011773940345368938},{"text":"To:","y":0.83866279066564764,"w":0.024691357082790799,"h":0.0087209301803324868,"x":0.53497942458617664},{"text":"From: Cathy","x":0.53497942411752708,"h":0.010340987793879042,"w":0.086419754028320361,"y":0.85465116294774246},{"x":0.53292182017264644,"y":0.87354651176337506,"text":"I hear you spent a day at the Olympics last month!","w":0.35596706814236112,"h":0.013081394896215404},{"x":0.53497943711447882,"y":0.89089481953867267,"text":"Wow! What did you see? What was it like? Did anything","w":0.38271603054470493,"h":0.011773940345368827},{"text":"interesting happen? Tell me all about it!","y":0.90697674411185181,"w":0.28189300537109374,"h":0.011783067622401777,"x":0.53292181359531721},{"text":"83","y":0.94912790713946493,"x":0.90740740727414737,"w":0.022633745405408967,"h":0.013081394896215293}]
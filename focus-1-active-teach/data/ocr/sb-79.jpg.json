[{"y":0.15406976748989354,"x":0.076131687159540634,"w":0.010288065804375537,"h":0.01017441816943776,"text":"1"},{"x":0.20370370462962961,"w":0.16666666666666669,"text":"SPEAKING","y":0.031976744357091524,"h":0.018895348349770358},{"y":0.072605965385873494,"text":"Asking for and giving advice","w":0.21604938083224826,"x":0.1975308638277031,"h":0.014603336340217044},{"x":0.19547325446646729,"text":"I can ask for and give basic","w":0.20576131184895835,"h":0.013081394896215404,"y":0.094476744575874849},{"text":"advice using simple language.","w":0.22633744981553819,"x":0.19753086583297161,"y":0.10901162808968301,"h":0.013081394896215404},{"h":0.010281661616015403,"w":0.14197530110677081,"y":0.15541601260920734,"text":"Susie wants to join","x":0.098765433500112618},{"x":0.10288066109604067,"h":0.010359241973661448,"y":0.16860465132589153,"w":0.16255143907335073,"text":"a Zumba® class. She's"},{"x":0.10082304887725463,"h":0.011627906907110019,"w":0.1790123324924045,"text":"talking to the instructor.","y":0.18313953496698765},{"x":0.10288066333848411,"text":"Who says sentences 1-6:","w":0.18312756008572051,"y":0.19767441883326664,"h":0.01162790690711013},{"x":0.1028806592314627,"h":0.010204081632653073,"w":0.17078189425998266,"y":0.21075353210413306,"text":"Susie or the instructor?"},{"w":0.068230832417805976,"text":"Can I join","x":0.11711915089948696,"y":0.25531335594377202,"h":0.012629101003170828},{"x":0.11724280027238269,"text":"your class?","h":0.011907293059200796,"y":0.27020914405556962,"w":0.078271603054470493},{"text":"I'm not very fit.","y":0.32994186044179385,"x":0.16255144202711064,"w":0.10699588351779515,"h":0.011627906907110019},{"y":0.3938953490305912,"x":0.098765435908330326,"w":0.096707814534505207,"h":0.010343269425995505,"text":"It's a class for"},{"w":0.068010953267415367,"text":"everyone.","x":0.10076818670832334,"y":0.40969777881932135,"h":0.010546302495983428},{"text":"And you're sure it's not","w":0.16255143907335068,"y":0.39244186064528219,"x":0.29423868275241932,"h":0.01179675778938416},{"h":0.013343799058084804,"y":0.40541601252101234,"text":"too difficult for me?","x":0.29012346168408804,"w":0.14403291490342879},{"w":0.0123456785413954,"text":"2","x":0.07613168760173028,"h":0.010174418169437871,"y":0.54360465130772295},{"h":0.013081394896215404,"text":"Wear comfortable","x":0.10082304560009366,"y":0.47674418633338456,"w":0.12962962680392792},{"text":"clothes.","x":0.10279882910697635,"y":0.49109695109689033,"w":0.057776828342013864,"h":0.013445632611189362},{"text":"Just try it.","y":0.49256223051260073,"w":0.068016526963975699,"h":0.011968562516911585,"x":0.34973659292378467},{"x":0.10075322664553656,"text":"1) 3.19","h":0.011990723841980078,"w":0.059810418023003478,"y":0.54342324261728003},{"x":0.16460905141280055,"w":0.29835391574435766,"h":0.013122467268579907,"y":0.54356357918025444,"text":"Read and listen to check your answers in"},{"w":0.37448557535807292,"text":"Exercise 1. What advice does the instructor give to","y":0.55808477233074127,"h":0.011773940345368938,"x":0.10288067535251344},{"text":"Susie?","x":0.10288066016533243,"w":0.047325100368923595,"y":0.57267441874958347,"h":0.01017441816943776},{"w":0.39300411648220485,"x":0.10288066272083161,"y":0.59011627899557284,"text":"Susie: Hello, excuse me ... Are you the Zumba instructor?","h":0.011627906907110019},{"text":"Yes, I am. My name is Lara. Hi.","w":0.22427983601888021,"y":0.60465116282551479,"x":0.14197531206600558,"h":0.011627906907110019},{"h":0.011627906907110019,"w":0.36419752332899308,"x":0.10288065846581908,"text":"Susie: Hi, Lara, erm ... My name's Susie. I wanted to","y":0.61918604674024336},{"h":0.013088240541131779,"x":0.1522633865894257,"text":"ask ... Can I join your class? The problem is, I'm","y":0.63226059636918508,"w":0.3312757025824653},{"x":0.15011896919753787,"w":0.082478112114800356,"text":"not very fit.","h":0.012257427772509932,"y":0.64648756503383953},{"h":0.011773940345368938,"text":"That's OK. You get fit here, that's the idea.","x":0.14197532631038864,"y":0.66130298260969445,"w":0.30658433702256949},{"y":0.67425431741569275,"text":"Susie: Should I see a doctor before I begin?","h":0.013343799058084804,"w":0.3127571953667535,"x":0.10288066383925695},{"y":0.68877550990129588,"h":0.013343799058084804,"x":0.10288066273148136,"w":0.38888888888888884,"text":"Lara: Only if you have a health problem. It's a class for"},{"y":0.70639534882698485,"text":"everyone.","h":0.0087209301803325978,"x":0.15226337528159054,"w":0.069958847893608955},{"text":"Susie: And what should I wear?","y":0.71802325595888572,"h":0.010174418169437871,"w":0.23045267740885417,"x":0.10288065948487328},{"h":0.011627906907110019,"x":0.10288066790927201,"w":0.35596706814236112,"text":"Lara: Just wear comfortable clothes - leggings or","y":0.73255813949702631},{"x":0.15226337743718635,"w":0.29012346055772564,"y":0.74709302329063099,"text":"tracksuit bottoms, a stretchy top you like,","h":0.01162790690711013},{"y":0.7601744184456698,"h":0.011803603434300647,"text":"trainers. You should have a towel too.","w":0.26748970879448786,"x":0.15226337927902478},{"text":"Susie: Right. Anything else I should remember?","y":0.77470930227318913,"h":0.011789912893034771,"x":0.10288066995326157,"w":0.33539093017578125},{"w":0.37860080295138887,"h":0.011776221977485402,"x":0.10288067321566347,"text":"Lara: Well, it's important to get enough to drink, so","y":0.78924418600865431},{"text":"make sure you always bring a bottle of water.","w":0.3271604749891493,"y":0.80376766096578378,"x":0.15226337981509624,"h":0.011773940345368938},{"x":0.10288065585770052,"text":"Susie: Right. And you're sure it's not too difficult for me?","y":0.81671899522912617,"w":0.38477366129557294,"h":0.013343799058084693},{"y":0.83284883718696556,"x":0.10288065948025005,"w":0.039094649420844174,"h":0.0087209301803324868,"text":"Lara:"},{"text":"Susie, relax. You really shouldn't worry so","h":0.011783067622401777,"x":0.14403292925963457,"y":0.83124018825363388,"w":0.30658433702256943},{"text":"much. Just try it. And enjoy the music. If you","x":0.15226337984496921,"y":0.84576138143329826,"w":0.31893001980251734,"h":0.011796758163667653},{"text":"think it's too much for you, you can always stop","y":0.86028257487107451,"w":0.32921810574001736,"x":0.15226337917731636,"h":0.013343799058084804},{"text":"and rest a bit.","x":0.15223371401766864,"y":0.87341945233434426,"h":0.011882024806934455,"w":0.098824751112196213},{"y":0.88808139573866562,"w":0.37860080295138887,"x":0.10288066745434675,"text":"Susie: Right. Thank you. And when is the next lesson?","h":0.013081394896215404},{"w":0.14650999281141491,"h":0.012027887197641141,"text":"Lara: On Thursday.","y":0.90251693160515034,"x":0.10064633278739059},{"h":0.013081394896215404,"x":0.10288067442658755,"w":0.31893001980251739,"y":0.91715116299278387,"text":"Susie: Thank you. See you on Thursday then."},{"y":0.35164835163365016,"w":0.3930041164822049,"x":0.52469136132679872,"h":0.013343799058084804,"text":"3 Look at the phrases in orange in the dialogue and"},{"text":"complete the SPEAKING FOCUS.","x":0.55144033639674561,"y":0.36616954469449503,"w":0.24691357082790799,"h":0.011773940345368938},{"w":0.1563785976833767,"x":0.52263374447106892,"text":"SPEAKING FOCUS","h":0.013101931082397655,"y":0.39678178967602973},{"h":0.013343799058084693,"w":0.12962962680392787,"text":"Asking for advice","x":0.52263374788918837,"y":0.4199372057188453},{"y":0.43313953524084581,"h":0.013092803805364706,"w":0.26543209499782983,"text":"' Should I see a doctor before I begin?","x":0.52469136215129086},{"x":0.52469135950996393,"h":0.011773940345368938,"text":"What 2","w":0.051440327962239518,"y":0.45054945056570683},{"x":0.66460905234261136,"text":"I wear\/do\/eat?","y":0.45203488401121139,"h":0.010288506886648285,"w":0.10699588351779521},{"x":0.52466286830631248,"y":0.47372901257114641,"w":0.098822411431206625,"h":0.013297789138003391,"text":"Giving advice"},{"text":"You 3","w":0.0390946494208441
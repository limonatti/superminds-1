[{"x": 0.0963575091074439, "h": 0.015866190294066006, "text": "2 Look at the underlined words in the text. Decide what", "y": 0.0394867718779138, "w": 0.406538323296441}, {"text": "part of speech they are: A (adjective), N (noun) or V (verb).", "x": 0.11786342334206147, "h": 0.017666076408826975, "w": 0.39935109456380213, "y": 0.05464669032236722}, {"w": 0.053667263454861114, "text": "1 dull", "x": 0.1162790690775784, "h": 0.011545157445466848, "y": 0.0720784886598778}, {"w": 0.012522361543443467, "x": 0.23613595708606006, "y": 0.0746075584749624, "text": "A", "h": 0.010116278651819414}, {"text": "N", "w": 0.012522361543443494, "h": 0.010116278651819317, "x": 0.2844364937363284, "y": 0.07460755844967171}, {"w": 0.01431127018398709, "h": 0.010116278651819414, "text": "V", "x": 0.33094812179530525, "y": 0.07460755828528215}, {"w": 0.01073345184326173, "x": 0.11806797904259096, "text": "2", "y": 0.087252907070248, "h": 0.0075872089888644875}, {"text": "outfit", "y": 0.08725290724894497, "w": 0.04293380737304689, "h": 0.010116278651819317, "x": 0.13774597591991664}, {"w": 0.012522361543443467, "h": 0.01138081348329678, "text": "A", "x": 0.2361359568997154, "y": 0.08725290711699989}, {"y": 0.0885174421326659, "text": "N", "x": 0.2826475847648938, "w": 0.01431127018398709, "h": 0.010116278651819317}, {"text": "V", "x": 0.33094812146441416, "y": 0.08851744196827634, "w": 0.012522361543443439, "h": 0.010116278651819414}, {"x": 0.1180679787564227, "text": "3", "y": 0.10116279077853287, "w": 0.008944543202718105, "h": 0.0075872089888644875}, {"x": 0.13950002653470597, "text": "revision", "h": 0.009072354769448522, "w": 0.05552588568793404, "y": 0.10105248525927747}, {"text": "A", "x": 0.2343470480922641, "y": 0.10116279101180362, "w": 0.01431127018398709, "h": 0.01138081348329678}, {"text": "N", "h": 0.010116278651819317, "x": 0.28264758506304516, "y": 0.10242732572714267, "w": 0.01431127018398709}, {"w": 0.008944543202718105, "x": 0.1180679787564227, "h": 0.0075872089888644875, "text": "4", "y": 0.11507267449946312}, {"x": 0.13917236904120803, "y": 0.11580484758933486, "text": "charge", "h": 0.010194047736777278, "w": 0.05077084011501737}, {"x": 0.23434704818170948, "y": 0.1150726745114403, "w": 0.01431127018398709, "h": 0.01138081348329678, "text": "A"}, {"y": 0.11633720945710528, "w": 0.012522361543443494, "h": 0.010116278651819317, "x": 0.2826475849706754, "text": "N"}, {"h": 0.008851743820341951, "text": "5", "x": 0.116279069963879, "y": 0.1289825583856139, "w": 0.01073345184326173}, {"x": 0.13589436207818134, "y": 0.12884394124105092, "text": "regular", "w": 0.05558158026801216, "h": 0.01292258231648472}, {"x": 0.23434704845004578, "w": 0.01431127018398709, "y": 0.13024709316900318, "h": 0.010116278651819317, "text": "A"}, {"w": 0.01431127018398709, "x": 0.28085867610657533, "h": 0.01138081348329678, "y": 0.13024709314454344, "text": "N"}, {"h": 0.012882903646476073, "y": 0.14277366461439248, "text": "6 depends", "w": 0.08593707614474827, "x": 0.11624434224875255}, {"text": "A", "y": 0.14415697685199727, "w": 0.012522361543443467, "h": 0.010116278651819317, "x": 0.2343470481191548}, {"h": 0.010116278651819317, "y": 0.14542151193804384, "w": 0.01431127018398709, "x": 0.28085867628546624, "text": "N"}, {"y": 0.14542151192118338, "w": 0.01431127018398709, "text": "V", "h": 0.010116278651819317, "x": 0.3273703041745538}, {"w": 0.41909457736545136, "y": 0.16275733868445266, "x": 0.09277185446994912, "text": "3 Choose the correct meaning for the words in Exercise 2.", "h": 0.01650315770173331}, {"x": 0.11270125471803825, "w": 0.15563505384657117, "h": 0.013909883895075253, "y": 0.18082848811114693, "text": "1 It's really dull work."}, {"text": "A It's very interesting work.", "y": 0.19589505624715137, "x": 0.13757100890758037, "w": 0.19533296373155382, "h": 0.013258395298293374}, {"y": 0.20967277974557288, "w": 0.16694057888454863, "h": 0.013726473009543284, "text": "B It's very boring work.", "x": 0.1374285223568236}, {"x": 0.114271415879854, "w": 0.37966583251953123, "text": "2 Sometimes, companies give me an outfit to put on.", "h": 0.01616647608443724, "y": 0.22326252826101778}, {"h": 0.016597752106318878, "w": 0.34214304606119794, "x": 0.1374667594479422, "text": "A Sometimes, companies give me some special", "y": 0.23764104009593884}, {"w": 0.10912343343098957, "text": "clothes to wear.", "h": 0.00902978339350174, "x": 0.16100179063692022, "y": 0.25401173301431634}, {"text": "B Sometimes, companies give me something", "x": 0.13557684977271556, "h": 0.01814469006948097, "y": 0.2648019119320653, "w": 0.32454508463541665}, {"x": 0.15563506770472965, "h": 0.015311371841155259, "y": 0.2807084836848546, "w": 0.20751341078016491, "text": "to hold up and show people."}, {"y": 0.2944494586356616, "x": 0.10912343934906309, "text": "3 I help them with homework or revision.", "h": 0.014133574007220224, "w": 0.29874776204427084}, {"y": 0.30976083037072194, "w": 0.32737030029296876, "h": 0.014133574007220224, "x": 0.13595707355655653, "text": "A I help them with homework or project work."}, {"x": 0.13397723707440087, "w": 0.37427585177951384, "text": "BIhelp them with homework or studying for exams.", "h": 0.015275113797790315, "y": 0.32335029045760755}, {"w": 0.18783542209201387, "x": 0.11091234575184628, "y": 0.33763081425181085, "text": "4 I don't charge so much.", "h": 0.011389943890623293}, {"h": 0.015209541553194369, "text": "A I don't take so much money.", "y": 0.3505105734502566, "w": 0.22256044175889758, "x": 0.13381674681144942}, {"y": 0.36422011045892355, "w": 0.16885604858398437, "h": 0.013973027704424814, "x": 0.13207341910081974, "text": "B I don't work so hard."}, {"h": 0.014409848016952354, "w": 0.20447898017035587, "text": "5 I don't have a regular job.", "y": 0.37926551225912924, "x": 0.10884760174016093}, {"w": 0.2772808498806424, "h": 0.013909883895075253, "x": 0.1323792576774485, "text": "A My job is different to other people's.", "y": 0.39453488365493333}, {"h": 0.018378883931611058, "x": 0.13198183519664825, "text": "B I don't work at the same time, on the same", "y": 0.40613881245457506, "w": 0.32269124348958333}, {"text": "day every week.", "w": 0.10916846381293405, "y": 0.42225694170524264, "x": 0.15561254629791144, "h": 0.01284076733709674}, {"text": "6 It depends on what my plans are.", "y": 0.4345562646455822, "x": 0.10696162208150516, "w": 0.25835021972656247, "h": 0.01728926383200976}, {"w": 0.36192169189453127, "h": 0.016999909369954175, "text": "A After I make my plans, I decide when I can work.", "y": 0.4501514430644714, "x": 0.13030253255663093}, {"w": 0.37630052354600696, "h": 0.019270536013028243, "y": 0.4625021441275749, "text": "B After I get work, I make my plans for my free time.", "x": 0.12851140904494432}, {"w": 0.42265926784939234, "x": 0.08025522199441158, "h": 0.01715097556475702, "y": 0.4849581564716357, "text": "4 Complete the dialogues with the words from Exercise 2."}, {"text": "Change the form of the words if necessary.", "y": 0.49942559993686997, "w": 0.3188338555230035, "h": 0.015403869539391706, "x": 0.10531743804327562}, {"y": 0.5170532492061152, "h": 0.010257796970085166, "w": 0.11091233995225694, "text": "Conversation 1", "x": 0.10375670882530269}, {"x": 0.10372029276666435, "h": 0.011536037896084029, "text": "Peter:", "y": 0.5310270390042118, "w": 0.048373366461859815}, {"text": "How much do you charge for your lessons?", "x": 0.15026835074242817, "w": 0.3166368272569444, "y": 0.5323646206131954, "h": 0.013914449473150282}, {"h": 0.00902978339350174, "w": 0.09481216430664063, "y": 0.5461055955428614, "text": "Matt: That", "x": 0.10375670949247573}, {"y": 0.5475436045514449, "text": "on how rich the family is.", "x": 0.2701252274194186, "h": 0.013909883895075253, "w": 0.17889087253146702}, {"x": 0.10017888929982986, "w": 0.11449016147189671, "y": 0.56259476548094, "h": 0.012955776173285189, "text": "Conversation 2"}, {"w": 0.04472271813286674, "y": 0.5778924420323341, "x": 0.100178891828021, "h": 0.01138081348329678, "text": "Cath:"}, {"y": 0.5776118615937242, "h": 0.015953914990063604, "w": 0.28120652940538193, "text": "Who are you working for today, Tess?", "x": 0.14650364130489757}, {"y": 0.5918023257263116, "x": 0.10196780125109331, "w": 0.035778172810872394, "h": 0.008851743820341854, "text": "Tess:"}, {"h": 0.012713825246487289, "y": 0.5930668607263339, "x": 0.16279069959089598, "w": 0.3363148328993056, "text": "An Italian restaurant. I'm lucky. John's over there"}, {"text": "in the funny", "y": 0.6069584836275649, "h": 0.011399074297949709, "w": 0.09481216430664063, "x": 0.16100179062545122}, {"h": 0.012750346126969504, "text": "but they've only got one.", "y": 0.6081362815187896, "x": 0.3166368592072849, "w": 0.18425759209526904}, {"h": 0.010296456116631493, "x": 0.10013485946474276, "text": "Cath:", "w": 0.041232965257432724, "y": 0.6207965393347681}, {"h": 0.00903891342641643, "w": 0.07513416714138454, "x": 0.16100179004290344, "y": 0.6206994584310656, "text": "What is it?"}, {"y": 0.6347965117896838, "h": 0.008851743820341951, "x": 0.1001788917566932, "w": 0.03756708357069227, "text": "Tess:"}, {"text": "I'm not sure. I think it's some kind of pasta.", "w": 0.3007948133680556, "x": 0.16085875923101853, "h": 0.015441945726690737, "y": 0.6347503632199918}, {"h": 0.009029783393501837, "y": 0.6525000001301634, "text": "Conversation 3", "x": 0.10017889242284746, "w": 0.10912343343098958}, {"y": 0.6642988770380743, "x": 0.09987156931738785, "w": 0.3207795206705729, "h": 0.017309875953068425, "text": "Emma: Do you really like babysitting, Sylvie?"}, {"w": 0.2706126742892795, "y": 0.67951740908558, "text": "Sylvie: Yes, I love it. Why, don't you?", "x": 0.09634765923668447, "h": 0.01637747812787546}, {"y": 0.6942296512453113, "x": 0.09838998226160284, "w": 0.051878352695041235, "text": "Emma:", "h": 0.010116278651819317}, {"w": 0.1003773752848307, "x": 0.1609025476463088, "text": "No, it's really 1", "y": 0.6938246592643147, "h": 0.013455332935071665}, {"w": 0.13595706515842015, "h": 0.01266817395867856, "x": 0.3309481198954471, "text": "• Nothing happens.", "y": 0.6967587212757524}, {"text": "I hate watching TV. And sometimes I work on", "x": 0.15921288818314538, "y": 0.709404069902206, "h": 0.012645348314774242, "w": 0.3148479207356771}, {"text": "Friday evenings, sometimes on Saturdays.", "y": 0.7230376453877668, "w": 0.2955628119574653, "h": 0.014988776346406309, "x": 0.15902406729475033}, {"w": 0.11627906799316404, "y": 0.7372238373234362, "h": 0.01028518781765269, "text": "I'd like to work 2", "x": 0.157423973718087}, {"w": 0.11270124647352425, "h": 0.010212146056688258, "text": "hours - and not", "y": 0.7396570398230005, "x": 0.3434704840083184}, {"x": 0.1552750959996473, "w": 0.108178473578559, "text": "in the evening.", "y": 0.7511402959778598, "h": 0.01305736309354488}, {"h": 0.014558465558269005, "text": "Sylvie:", "x": 0.09285254469865001, "y": 0.7647193135594887, "w": 0.05221977657741969}, {"h": 0.014244024004746817, "x": 0.15727863091655214, "text": "Take your school books. You can do your", "w": 0.28825988769531247, "y": 0.7661722896186262}, {"y": 0.7800947654282511, "w": 0.1431126912434896, "x": 0.22540250816477883, "h": 0.012955776173285189, "text": "_ and get paid for it!"}, {"h": 0.010271492581074886, "y": 0.8118313956120055, "x": 0.08407871010776713, "text": "REMEMBER BETTER", "w": 0.16100179036458334}, {"y": 0.8409156979356361, "h": 0.012645348314774147, "x": 0.0840787203458966, "text": "It is important to learn the pronunciation of new words", "w": 0.37209299723307293}, {"y": 0.8560901165352411, "h": 0.011554287852793362, "x": 0.08407871474458921, "w": 0.3202146742078993, "text": "along with their meaning. You can use Internet"}, {"text": "REMEMBER THIS", "x": 0.5581395373824282, "w": 0.1377459716796875, "h": 0.011490376124743525, "y": 0.05300090265460471}, {"text": "To strengthen the meaning of a message, we can use", "x": 0.5599284592415927, "w": 0.3703040907118055, "h": 0.013909883895075349, "y": 0.07966569757470071}, {"w": 0.3923580254448784, "h": 0.019468809551280372, "x": 0.5578662587571724, "y": 0.09195657603610234, "text": "so-called intensifiers, e.g. very (I'm tired - I'm very tired),"}, {"h": 0.015174417977728975, "x": 0.5581395396271303, "y": 0.10748546542974018, "text": "at all, just, even, in fact, whole, etc.", "w": 0.246869405110677}, {"text": "5 Read REMEMBER THIS. Find these phrases in the text", "y": 0.13895924864256406, "h": 0.019644726209261797, "w": 0.42273915608723966, "x": 0.5399503494649276}, {"y": 0.15394136424556507, "x": 0.5650632662040561, "text": "and complete the missing words.", "w": 0.24555918375651042, "h": 0.015239396405134028}, {"h": 0.013669047217937188, "w": 0.1632016160753038, "text": "... £40 for a whole day", "x": 0.5866043465593389, "y": 0.17237448293386745}, {"h": 0.008851743820341854, "text": "1", "x": 0.5652951703709128, "y": 0.18588662804240905, "w": 0.008944543202718092}, {"text": "2", "y": 0.20106104684200932, "h": 0.008851743820341854, "x": 0.5652951703485515, "w": 0.008944543202718092}, {"w": 0.008944543202718092, "h": 0.008851743820341854, "x": 0.5635062614263691, "text": "3", "y": 0.21497093030476364}, {"x": 0.5635062614040076, "y": 0.2288808140478233, "text": "4", "w": 0.008944543202718092, "h": 0.008851743820341854}, {"text": "I can", "w": 0.05903398725721576, "x": 0.5760286229187982, "y": 0.22888081399385785, "h": 0.01021214643110008}, {"x": 0.6583184259327765, "text": ", there aren't any.", "y": 0.18841569805704347, "w": 0.1252236090766059, "h": 0.011417334363778996}, {"y": 0.2010108303555834, "w": 0.1395348782009549, "h": 0.010207581227436872, "x": 0.5849731668029217, "text": "... it isn't hard work"}, {"h": 0.011472115684502416, "x": 0.7101967819190816, "y": 0.21623546539879496, "text": "food for me to eat.", "w": 0.1341681501600478}, {"y": 0.22949997284677387, "x": 0.6830892324123357, "w": 0.1759182739257813, "h": 0.013374985650127982, "text": "sit and watch television."}, {"x": 0.5382728252566282, "h": 0.016340709386749898, "text": "6 Complete the text with one word in each gap to make", "y": 0.24900777284145198, "w": 0.42256598578559024}, {"x": 0.5611650368893872, "w": 0.16567013210720494, "h": 0.01631680094378088, "text": "the meaning stronger.", "y": 0.26193197835927573}, {"w": 0.15742396036783846, "x": 0.5599284505137552, "text": "Meg: What's wrong?", "y": 0.28188628130959836, "h": 0.014133574007220224}, {"y": 0.2959011627668519, "x": 0.5581395272199513, "w": 0.37209303114149306, "h": 0.013909883895075349, "text": "Tanya: Oh, it's the World Cup. Jake talks about it the"}, {"h": 0.014133574007220224, "y": 0.3109386280830269, "w": 0.21466905381944446, "text": "whole time. We don't go out '", "x": 0.6118067995661275}, {"h": 0.01800949594174046, "text": "Meg: Well, it's only for a month. Why don't you watch", "y": 0.32341414942530916, "w": 0.3850781928168403, "x": 0.5596745963796163}, {"x": 0.6115636956907994, "text": "a few matches? You might enjoy it.", "h": 0.01551584863490577, "w": 0.24203689575195309, "y": 0.33734552616329}, {"text": "Tanya: I watch quite a few matches but Jake doesn't", "y": 0.3513763537677564, "h": 0.014133574007220224, "x": 0.5581395396280465, "w": 0.3685151841905382}, {"x": 0.6636851567297645, "y": 0.36786552344739853, "w": 0.1520572408040365, "h": 0.01149494132840683, "text": "know I'm there. He 3"}, {"text": "sits there", "x": 0.8604079796496936, "h": 0.009276529787249521, "y": 0.37029632818576885, "w": 0.06451498667399092}, {"x": 0.610017889907044, "text": "looking at the television.", "w": 0.173524152967665, "y": 0.3818895351346234, "h": 0.01149494132840683}, {"h": 0.014152267641969576, "x": 0.5562725031551408, "text": "Meg:", "y": 0.3944136916783443, "w": 0.04309005737304683}, {"x": 0.5991365586909685, "w": 0.3348807101779514, "text": "Simon's completely different. He doesn't really", "y": 0.39438837749198247, "h": 0.015673771059470137}, {"x": 0.6063105515880428, "h": 0.01623128977062903, "y": 0.4079163316816422, "w": 0.12011592441134977, "text": "like any sports. *"}, {"y": 0.4122292416939098, "x": 0.8246869392603748, "h": 0.011389944265035017, "w": 0.08050089518229164, "text": ", he always"}, {"x": 0.6081291265746553, "y": 0.4233520707231138, "text": "complains about me when we're out because", "w": 0.3168498060438367, "h": 0.013292743841233303}, {"y": 0.4387936048388385, "x": 0.6064400778844067, "h": 0.011517766972311145, "w": 0.15563505384657117, "text": "I usually spend the s"}, {"text": "_time looking at my", "w": 0.1502683342827691, "x": 0.781753133991591, "y": 0.440058140006857, "h": 0.012645348314774242}, {"text": "mobile phone.", "x": 0.6081637619257246, "h": 0.013190938264454277, "y": 0.4511661588311503, "w": 0.10388714260525167}, {"y": 0.4649333814385072, "x": 0.5525704454062207, "text": "Tanya: Oh well, that's different. Mobiles are important!", "h": 0.017386097219446485, "w": 0.38499440511067706}, {"y": 0.4881555820869797, "w": 0.24553005642361114, "text": "VOCABULARY PRACTICE | Work", "x": 0.5275145298366738, "h": 0.01543633104661736}, {"text": "7 Look at the vocabulary in lesson 3.4 in the Students'", "y": 0.5095938627526577, "w": 0.4078711954752604, "h": 0.013923579131653152, "x": 0.5313059090244449}, {"y": 0.5247819770306942, "h": 0.012686434773331489, "text": "Book. Complete the sentences with one word in each", "w": 0.3899820963541667, "x": 0.5545617207316824}, {"text": "gap. The first letters are given.", "x": 0.5525973084719239, "y": 0.5376280377615301, "h": 0.015617637737563297, "w": 0.22944820827907986}, {"y": 0.5562910524894894, "text": "They make chairs and other furniture in that factory.", "h": 0.016693946747142935, "w": 0.3706391737196181, "x": 0.5687051648844812}, {"text": "1 Sandra is a nurse. Her job is d.", "x": 0.552362201037538, "w": 0.24406533135308162, "y": 0.5670825393363098, "h": 0.018777136079671186}, {"x": 0.8443447854069315, "y": 0.5740368585757699, "w": 0.06980774349636498, "h": 0.011504771511477265, "text": "and she"}, {"w": 0.1198568810356988, "text": "wor
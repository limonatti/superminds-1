[{"x":0.2056580347056792,"text":"WRITING","w":0.14218187120225698,"h":0.019685824587356349,"y":0.031581506379505297},{"y":0.074127906963111667,"text":"A personal profile on a blog","w":0.20987653944227433,"x":0.20164609416775167,"h":0.011821857614083053},{"y":0.094476744133654256,"w":0.24074072943793404,"h":0.01162790690711013,"text":"I can write a short basic personal","x":0.19958848542506588},{"h":0.011627906907110019,"y":0.1090116279054566,"w":0.053497941758897605,"text":"profile.","x":0.20164609151767054},{"w":0.010288065804375537,"text":"1","h":0.0087209301803325978,"y":0.15843023264239187,"x":0.063786008147194956},{"y":0.15843023248394494,"w":0.38477366129557294,"h":0.011627906907110019,"text":"What information do you need to describe yourself?","x":0.09053498486147267},{"w":0.15432098388671878,"text":"Choose three topics.","x":0.090534983879685768,"y":0.17296511631388678,"h":0.01162790690711013},{"x":0.09053497640071087,"h":0.013343799058084804,"text":"1 Information about your family","w":0.22427983601888021,"y":0.18877550984679015},{"text":"2 A physical description","y":0.20486656207601306,"w":0.17078189425998266,"x":0.090534980930708192,"h":0.011773940345368827},{"y":0.21802325620378193,"text":"3 Information about your favourite band","w":0.28395060221354163,"x":0.09053498726771475,"h":0.013138439441962357},{"y":0.23255813968852024,"text":"4 Description of your personality","h":0.013124748900696481,"x":0.090534980179136887,"w":0.23251029120551217},{"w":0.17901234944661459,"h":0.011627906907110019,"text":"5 A list of your ambitions","x":0.090534979777721458,"y":0.24709302321795656},{"text":"2","w":0.012345678541395413,"h":0.010174418169437871,"y":0.27034883729972869,"x":0.063786008363047153},{"x":0.090534994662127916,"y":0.2703488373629388,"w":0.38683125813802088,"h":0.013081394896215404,"text":"Read Emily's profile. Match three topics in Exercise 1"},{"text":"with paragraphs A-C.","h":0.011627906907110019,"x":0.090534979131200982,"w":0.16049382527669273,"y":0.28633720953094111},{"w":0.20781892564561633,"h":0.046511627628440189,"text":"BLOG","x":0.074074076818733944,"y":0.32848837216344207},{"text":"Hi! I'm Emily.","x":0.10288066160106016,"y":0.38808139553154353,"h":0.013081394896215293,"w":0.096707814534505221},{"x":0.08436214641813207,"h":0.011783067622401999,"y":0.40697674417241392,"text":"[Al I'm sixteen years old. I'm","w":0.2016460842556424},{"y":0.42296511642400203,"w":0.18930040147569444,"h":0.010315888343463642,"text":"not very tall - I'm 1.65 m -","x":0.10493827978341465},{"x":0.10493827532533996,"h":0.011627906907110019,"w":0.15226337009006075,"y":0.43749999997667754,"text":"and I'm slim. I've got"},{"y":0.45329670334005789,"text":"long wavy brown hair and","x":0.10288066564607845,"w":0.18724278767903646,"h":0.011819575607683097},{"w":0.086419754028320306,"y":0.47093023294531988,"h":0.010231462340901332,"text":"green eyes.","x":0.10493826996800723},{"y":0.48979591829278446,"x":0.086419757523281904,"text":"] I'm a positive person and I'm very sociable -","w":0.34156378851996527,"h":0.011773940345368938},{"w":0.33127570258246525,"y":0.50581395358132863,"x":0.10288066391452876,"text":"l've got lots of friends. I like going out with my","h":0.01162790690711013},{"y":0.52034883721759007,"x":0.10288067011624974,"w":0.31481479220920144,"h":0.013081394896215404,"text":"friends and having fun. I really enjoy sports,"},{"h":0.011627906907110019,"y":0.53633720928869311,"x":0.10288067610462731,"text":"too, but I'm not very fit. My friends say I'm","w":0.30658433702256943},{"x":0.10493827904574168,"text":"kind and I've got a good sense of humour.","y":0.55219780211354985,"w":0.30452674018012149,"h":0.011773940345368827},{"text":"I like laughing a lot.","y":0.56671899511405832,"w":0.13991769578721786,"h":0.013343799058084693,"x":0.10288066002820172},{"w":0.32098765055338541,"x":0.084362147151290617,"h":0.01162790690711013,"text":"l I've got a brother and a sister. My brother","y":0.59011627900768526},{"h":0.011627906907110019,"w":0.3168724229600694,"x":0.10288066358855234,"y":0.60465116275284025,"text":"is fourteen, but he's taller than me. He's got"},{"w":0.29218105740017364,"h":0.011780785616001821,"x":0.10493828153653864,"y":0.62048665613697174,"text":"short dark hair and blue eyes. He's really"},{"w":0.33539093017578125,"h":0.011794476157267808,"text":"funny! My sister is ten. She's quite tall, but she","x":0.10288066995326157,"y":0.63500784933117094},{"y":0.64952904232562314,"h":0.013343799058084804,"x":0.10288065600190754,"w":0.31069959852430556,"text":"isn't taller than me. She's very clever. She's"},{"y":0.66562009413100942,"text":"got long straight blond hair and green eyes.","h":0.013343799058084804,"x":0.10493827793518,"w":0.31481479220920139},{"text":"So, now you know all about me!","y":0.68877551001866844,"h":0.011805885440700603,"w":0.23251027425130211,"x":0.10493827627455478},{"h":0.013343799058084693,"x":0.063786019886844694,"w":0.36625512017144102,"text":"3 Read the profile again and complete the table","y":0.72802197827398518},{"x":0.088477366987766884,"w":0.36419752332899308,"y":0.74254317118727409,"text":"about Emily. Use the photo on the right and your","h":0.01491365777080067},{"y":0.75726744214128194,"h":0.013140721074078821,"text":"imagination to complete it about Tiago.","w":0.29423868815104171,"x":0.088477360065425739},{"text":"Emily","y":0.77906976760458135,"h":0.013081394896215404,"x":0.20370370403939703,"w":0.041152263217502177},{"w":0.045267490810818101,"h":0.013081394896215293,"x":0.40123456780446748,"text":"Tiago","y":0.77906976762456681},{"text":"Age","w":0.032921810150146488,"y":0.79941860474665982,"x":0.084362139904350625,"h":0.013081394896215404},{"x":0.084246146046439249,"text":"Height","y":0.81664468226961129,"w":0.053729930453830302,"h":0.014966449707606078},{"y":0.83575581391563103,"x":0.084362140510590475,"w":0.041152263217502164,"h":0.01162790690711013,"text":"Build"},{"text":"1.65 m","h":0.01031588796918026,"x":0.2057613177628882,"y":0.8167
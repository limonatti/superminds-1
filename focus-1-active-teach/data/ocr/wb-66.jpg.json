[{"h": 0.012955776173285189, "w": 0.40608228895399306, "x": 0.08407871748633068, "y": 0.0365117330990043, "text": "4 Complete the dialogue between Simon and his mum"}, {"y": 0.05182310482458068, "h": 0.012668173958678463, "x": 0.10554562504314263, "w": 0.1985688612196181, "text": "with one verb in each gap."}, {"text": "M: Simon, this is a letter from your teacher.", "w": 0.2987477620442708, "x": 0.10375671230523485, "h": 0.012672739536753588, "y": 0.25793772526772646}, {"h": 0.01138081348329678, "y": 0.27187500025090244, "text": "S: Oh.", "x": 0.10196780007042273, "w": 0.0536672634548611}, {"y": 0.2857848837729566, "x": 0.10196779387469178, "w": 0.37209303114149306, "h": 0.013909883895075253, "text": "M: She says you sometimes miss lessons. Is this true?"}, {"w": 0.1949910481770833, "y": 0.2995532490104003, "text": "S: Well, once or twice, yes.", "x": 0.10196780571915058, "h": 0.012955776173285286}, {"y": 0.31323066067052835, "x": 0.10186070076490056, "w": 0.09502636379665799, "text": "M: And you!", "h": 0.014657864415688745}, {"w": 0.20246276855468753, "x": 0.2717851724354144, "text": "never on time. Why not? You", "y": 0.31455933728578106, "h": 0.014508176056486554}, {"w": 0.26296958075629345, "h": 0.012955776173285189, "x": 0.12522362033294443, "text": "leave here at 8.15. Where do you go?", "y": 0.3286055954428177}, {"text": "S: I meet my friends. Sometimes we walk slowly", "x": 0.10196780956619181, "y": 0.3426889537134601, "h": 0.012645348314774147, "w": 0.3363148328993055}, {"text": "because we are talking. But, 12", "y": 0.3564801442952932, "w": 0.2164579603407118, "h": 0.012955776173285189, "x": 0.12522361645307872}, {"w": 0.12011450025770398, "y": 0.36866686513961605, "h": 0.015064524356208609, "text": "school. I always?", "x": 0.12509480887963295}, {"w": 0.04848927815755205, "h": 0.010575605609356711, "text": "well at", "y": 0.3576337089151941, "x": 0.4149324620856955}, {"x": 0.3184257600553056, "w": 0.13416815863715276, "text": "good marks for my", "y": 0.3705087207040612, "h": 0.013909883895075253}, {"h": 0.010531208601238929, "text": "homework.", "x": 0.1251687552692534, "y": 0.38421113983069477, "w": 0.07524388631184895}, {"h": 0.011458420447924517, "x": 0.10196780284055453, "text": "M: I know, I know. Your teacher is happy with your work", "w": 0.37745975070529514, "y": 0.39959302342768294}, {"y": 0.4134070400438486, "w": 0.30590338812934026, "x": 0.12522362248273586, "h": 0.012741215719643184, "text": "but you can't be late for school. People who"}, {"h": 0.011426464771105508, "y": 0.428677325927138, "x": 0.2003577786071232, "text": "school and get a job can't be late in the", "w": 0.2844364929199219}, {"y": 0.44385174435286945, "h": 0.010116278651819317, "x": 0.1252236157690119, "text": "morning.", "w": 0.06261180453830295}, {"y": 0.45385955210951934, "h": 0.015350867798182049, "x": 0.10003135652870418, "w": 0.397471923828125, "text": "S: I understand that. Don't worry. I can change. Anyway,"}, {"text": "I don't want a job yet. I want to stay at school for two", "x": 0.1216457979756369, "w": 0.3488372124565972, "h": 0.011453855244261213, "y": 0.4703339351803813}, {"text": "more years, have good grades and then go to university.", "x": 0.12343472082293867, "w": 0.37209299723307293, "h": 0.012713825246487289, "y": 0.4843168609370896}, {"w": 0.3953488159179688, "h": 0.011399074297949709, "x": 0.1001789064640924, "y": 0.49820848359068265, "text": "M: Good. You can tell Mrs Taylor that when we meet her."}, {"h": 0.011500112704852006, "x": 0.09658262157832172, "y": 0.5120769784061223, "text": "S: We???", "w": 0.07338216145833336}, {"text": "M: Yes, she wants to talk to us both tomorrow at 4 p.m.", "y": 0.5260465118891244, "h": 0.012645348314774147, "w": 0.3846153767903646, "x": 0.10017889959676747}, {"y": 0.5398240071038555, "x": 0.12343470662540199, "text": "Don't be late!", "w": 0.09660107082790798, "h": 0.010248666937170475}, {"h": 0.012745780548894475, "w": 0.20393559773763018, "text": "WORD STORE 5C | Exams", "x": 0.07334526266964639, "y": 0.5639825585588192}, {"h": 0.012955776173285189, "text": "5 Complete the dialogue with the verbs from the box", "x": 0.07513418121558453, "y": 0.5853655234152422, "w": 0.40071553548177086}, {"text": "in the correct form.", "y": 0.5993895351061713, "h": 0.011494941328406732, "x": 0.09660107244373649, "w": 0.144901614718967}, {"w": 0.20807320488823786, "h": 0.016118300511948857, "x": 0.11412473828364758, "text": "fail get into pass prepare", "y": 0.6245082593406205}, {"x": 0.3202146719329562, "y": 0.6258032490424593, "text": "retake revise take", "w": 0.1574239603678385, "h": 0.010257797344496987}, {"text": "In the library...", "w": 0.1073345184326172, "x": 0.09660107888744805, "y": 0.6499709304887296, "h": 0.01155885305645657}, {"x": 0.09660107062205056, "text": "Jade: Hi, Ned. What are you doing?", "y": 0.6676744188924361, "w": 0.2558139546712239, "h": 0.011522332175974353}, {"y": 0.6815523463263768, "w": 0.3810375637478298, "h": 0.014133574007220224, "x": 0.09481217002232825, "text": "Ned: Oh hello, Jade. Well, I'm revising for my History"}, {"h": 0.007723195372075413, "x": 0.14308978676765127, "y": 0.6979552627813462, "text": "exam.", "w": 0.044768549601236995}, {"y": 0.7081395349291365, "x": 0.0966010793443152, "w": 0.14132378472222223, "h": 0.011494941702818553, "text": "Jade: I see. When 1"}, {"x": 0.3112701249904886, "h": 0.0075872089888644875, "text": "you", "y": 0.7131976746701754, "w": 0.02683363172743053}, {"x": 0.41857318991023884, "w": 0.07519709269205732, "h": 0.01035219705492144, "text": "the exam?", "y": 0.7092861106094462}, {"w": 0.35241502549913195, "x": 0.09660106825818617, "text": "Ned: It's on Wednesday, and I need to study hard", "y": 0.7231678700169049, "h": 0.012955776173285189}, {"y": 0.7372238373558807, "x": 0.14311270277789517, "w": 0.17531305948893228, "h": 0.011462985651587822, "text": "because I don't want to 2"}, {"h": 0.012955776173285189, "y": 0.752220216712767, "w": 0.34525936550564235, "text": "Jade: Don't worry too much, Ned. You're a good", "x": 0.09481218245290317}, {"h": 0.011431029600356895, "text": "student. I'm sure you can 3", "y": 0.7663081399122397, "w": 0.1878354220920139, "x": 0.14132379250944918}, {"x": 0.09660107422508285, "text": "Ned: 1 hope so! I don't want to 4", "h": 0.011504071735733246, "w": 0.23255813598632813, "y": 0.7800947653807334}, {"text": "enough! What about you? s", "y": 0.7941279070798949, "h": 0.012663609129427173, "x": 0.1413237972400705, "w": 0.19320214165581595}, {"x": 0.39355992903060777, "y": 0.7397529073543229, "w": 0.012522360483805284, "h": 0.010116278651819414, "text": "it."}, {"text": "your exam.", "x": 0.3988730802718956, "h": 0.010570695197969503, "y": 0.7686100012139748, "w": 0.08418585883246527}, {"x": 0.3989266530349722, "text": "it - once is", "w": 0.0805008951822917, "y": 0.7814825583856139, "h": 0.008851743820341854}, {"h": 0.010276057784738096, "x": 0.39892665454739085, "text": "_ you", "y": 0.7977617328725669, "w": 0.03756708357069227}, {"x": 0.2182468699036968, "w": 0.13953487820095484, "text": "for your exams yet?", "y": 0.8079693138164231, "h": 0.012713825246487289}, {"x": 0.09481216600427922, "h": 0.01145385561867313, "y": 0.8232122095216147, "w": 0.3202146742078993, "text": "Jade: Yes, I have. I started a few months ago."}, {"y": 0.8370216609660509, "x": 0.09302326293751688, "h": 0.012745780548894378, "w": 0.2379248555501302, "text": "Ned: Why did you start so early?"}, {"x": 0.09302326007342364, "y": 0.8510319768739039, "text": "Jade: Well, I want to •", "w": 0.16457960340711802, "h": 0.011508636939396454}, {"y": 0.8510319770374626, "x": 0.3255813930299429, "h": 0.010116278651819317, "w": 0.16279069688585074, "text": "the School of Fine Arts"}, {"text": "REMEMBER THIS", "w": 0.1359570651584201, "x": 0.5438282643029776, "y": 0.04552325611227603, "h": 0.011403639127201095}, {"text": "There are some differences between British, Australian", "x": 0.5472265821198478, "h": 0.015342711610484163, "y": 0.07008938426316368, "w": 0.3777962578667534}, {"y": 0.08597924158597886, "x": 0.5438282782175705, "text": "and American English when we talk about types of schools.", "h": 0.013919014302401765, "w": 0.3935599093967015}, {"y": 0.10748546553556353, "w": 0.3917710028754341, "text": "In Great Britain there are primary schools and secondary", "x": 0.5456171867778463, "h": 0.012649913892849175}, {"text": "schools, like in Australia.", "y": 0.12131317708820274, "w": 0.17352415296766488, "h": 0.012727520483065188, "x": 0.5438282627156309}, {"y": 0.13530523261016583, "h": 0.013909883895075253, "text": "In the USA, there are elementary schools, junior high", "w": 0.3613595581054687, "x": 0.5420393656699848}, {"text": "schools or middle schools and high schools.", "x": 0.543828275125501, "y": 0.14918772570303473, "h": 0.013937274368231051, "w": 0.30769229465060766}, {"y": 0.17071220947419466, "text": "In Great Britain, there are state schools and private", "h": 0.01145385561867313, "w": 0.35420393202039935, "x": 0.5438282700899791}, {"text": "schools, also like in Australia.", "x": 0.543828262132974, "w": 0.20393559773763026, "y": 0.18334386249965318, "h": 0.012659044300175787}, {"x": 0.5420393658576007, "y": 0.19853197667292022, "w": 0.386404283311632, "h": 0.013909883895075253, "text": "In the USA, there are public schools and private schools."}, {"w": 0.16100179036458329, "text": "REMEMBER BETTER", "x": 0.5420393564149484, "y": 0.24026162809691057, "h": 0.011394509094286501}, {"x": 0.5420393608660699, "h": 0.012713825246487289, "text": "Grouping words in diagrams is a good way for visual", "y": 0.2668168607516246, "w": 0.3649373711480035}, {"text": "learners to remember vocabulary. It strengthens the", "x": 0.5365151774382036, "h": 0.016501752908479383, "w": 0.365274658203125, "y": 0.27880664644298275}, {"w": 0.3864042833116319, "text": "process of learning. It is a useful way to record any new", "x": 0.5402504561259371, "h": 0.014133574007220224, "y": 0.2944494585503055}, {"w": 0.2683363003200955, "x": 0.5402504511369111, "y": 0.30854651195235133, "text": "vocabulary for easy reference later on.", "h": 0.01264534831477405}, {"text": "Complete the diagram with as many words as you", "w": 0.3631484646267361, "h": 0.012695565180658001, "x": 0.5420393670247355, "y": 0.33004360486179896}, {"w": 0.09485766092936199, "h": 0.012816734589394278, "text": "can think of.", "x": 0.5384387914265143, "y": 0.34386779565612885}, {"w": 0.1288014305962456, "x": 0.5366726295140418, "text": "People at a school", "y": 0.4020216604069074, "h": 0.012745781297718117}, {"text": "Subjects", "y": 0.43744344663704465, "w": 0.06268066830105257, "h": 0.012816595308186714, "x": 0.6064056409096805}, {"w": 0.12164579603407122, "h": 0.008851743820341951, "text": "Places in a school", "x": 0.6833631500151648, "y": 0.38821220943775786}, {"y": 0.4195900752123224, "text": "SCHOOL", "x": 0.688660701419009, "w": 0.10210614522298178, "h": 0.015645431077867672}, {"text": "Types of school", "x": 0.8155926804316097, "y": 0.4014991920433708, "w": 0.11121177673339844, "h": 0.015155684655323737}, {"x": 0.8032200362330991, "text": "Objects", "y": 0.43879360482303187, "w": 0.05724508073594836, "h": 0.01138081348329678}, {"x": 0.5366726299133557, "text": "SHOW WHAT YOU'VE LEARNT", "h": 0.012955776173285189, "w": 0.246869405110677, "y": 0.5233348375612046}, {"text": "6 Choose the correct answers A-C.", "x": 0.5294116874704188, "y": 0.5523050675161405, "w": 0.26140996297200525, "h": 0.012985910336463426}, {"text": "1 Don't worry about your exams. Just your best.", "h": 0.013909883895075349, "x": 0.5474060933216944, "y": 0.5715697672662704, "w": 0.3631484646267361}, {"w": 0.03935599009195956, "x": 0.5688729891818078, "h": 0.011494941328406732, "text": "A do", "y": 0.5853655235000876}, {"x": 0.6887298757857484, "y": 0.5853655234105164, "text": "B get", "h": 0.011494941328406732, "w": 0.04293380737304686}, {"x": 0.8050089455264711, "y": 0.5853655236160032, "w": 0.03935599009195967, "h": 0.0114949413
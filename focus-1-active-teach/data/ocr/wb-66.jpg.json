 "w": 0.03577817281087248, "h": 0.01022127646401477}, {"y": 0.8396511629570753, "text": "9 I was very disappointed when I", "x": 0.542039361353427, "h": 0.012681869195256459, "w": 0.24686940511067712}, {"text": "A failed", "y": 0.8533886823644019, "x": 0.5652295281991387, "w": 0.05916527218288847, "h": 0.011725541960031118}, {"h": 0.01045182917092252, "y": 0.8546578060901427, "text": "B retook", "x": 0.6833125867487633, "w": 0.0662907494439019}, {"y": 0.8257412793680899, "h": 0.01138081348329678, "text": "Cat", "x": 0.8014311279058339, "w": 0.03577817281087248}, {"w": 0.12969013637966587, "x": 0.7974022646024604, "h": 0.016599779920887906, "text": "two of my exams.", "y": 0.8377685509246479}, {"x": 0.8013982844308912, "text": "C passed", "y": 0.8547345328493983, "h": 0.012827445763543114, "w": 0.06983312818739151}, {"w": 0.33333333333333337, "x": 0.1399176913065844, "text": "really hard - all the best art students want to go", "y": 0.8793604652237706, "h": 0.01162790690711002}, {"text": "there!", "w": 0.04320987701416015, "h": 0.008720930180332487, "x": 0.13991769514003927, "y": 0.8938953488415197}, {"x": 0.09465020935063617, "y": 0.9069767443309787, "h": 0.01021320853540253, "w": 0.123456785413954, "text": "Ned: Good luck!"}, {"text": "Jade: You too!", "x": 0.09259259426972814, "y": 0.9215070642218987, "w": 0.10905349731445314, "h": 0.008725493818848906}, {"text": "A girl's", "y": 0.8822605963957145, "w": 0.05144032796223952, "h": 0.011773940345368938, "x": 0.5658436221042712}, {"w": 0.05976051754421663, "x": 0.6851403177465087, "h": 0.01185983466203766, "text": "B single", "y": 0.8821514781616644}, {"h": 0.010383237662083267, "w": 0.06179670121934677, "x": 0.8024349821058903, "y": 0.8821630324023332, "text": "C mixed"}, {"w": 0.03086419635348847, "h": 0.01162790690711013, "x": 0.8888888891432147, "y": 0.9026162789592357, "text": "/10"}, {"w": 0.0246913570827908, "h": 0.013081394896215293, "text": "61", "x": 0.9053497950182754, "y": 0.9404069769159912}]
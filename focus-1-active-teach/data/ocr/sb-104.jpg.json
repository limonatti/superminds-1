[{"w":0.096707814534505221,"y":0.034883721232945142,"h":0.061046510513760865,"x":0.055555557607575946,"text":"8.7"},{"w":0.14209499782986112,"y":0.033203218576158489,"x":0.2057014734612122,"h":0.019349376672478269,"text":"WRITING"},{"x":0.20164610208668224,"text":"Expressing an opinion, presenting arguments","y":0.075581395310979849,"h":0.011627906907110019,"w":0.3312757025824653},{"y":0.095761381652542887,"text":"I can use simple connectors to give an opinion","x":0.19958848947008417,"h":0.011796757789384271,"w":0.33127570258246525},{"text":"and present arguments in a short text.","x":0.1995884805502306,"w":0.27983539157443577,"y":0.110282574479726,"h":0.01181044870493364},{"h":0.0088995547272159303,"x":0.092561288203402911,"y":0.15979440861246441,"w":0.049445326063368059,"text":"4) 3.56"},{"y":0.17587209301303142,"h":0.0087209301803324868,"x":0.090534981186151678,"text":"necessary.","w":0.078189298841688362},{"h":0.011778503609601976,"x":0.15226338280566798,"text":"Translate the words in the box. Use a dictionary if","w":0.36419752332899302,"y":0.15973312415354612},{"x":0.096707814927621941,"h":0.013081394896215404,"w":0.33744856092664927,"text":"buy recycled things plant trees save water","y":0.19767441887456672},{"x":0.096707825618288723,"text":"sort rubbish for recycling throw away less","y":0.2122093024330729,"w":0.31893001980251739,"h":0.011627906907110019},{"x":0.09670782487943673,"y":0.22527472556382977,"text":"turn off the light turn off the water tap","w":0.30041151258680554,"h":0.013097367069597632},{"y":0.25726744195089157,"x":0.063786008363047153,"h":0.010174418169437871,"w":0.012345678541395413,"text":"2"},{"h":0.013140721074078821,"text":"Which things in Exercise 1 do you do? Compare your ideas","y":0.2572674419959331,"x":0.088477373540179594,"w":0.43209876166449657},{"h":0.01162790690711013,"w":0.22222222222222221,"text":"with other people in the class.","x":0.090534982201646061,"y":0.27180232557987516},{"w":0.32304524739583329,"h":0.013081394896215182,"x":0.065843635484181998,"y":0.29505813970668893,"text":"3 Read the blog and answer the questions."},{"x":0.090534991320850827,"text":"1 What does the writer think we should do to protect the","w":0.39917694091796874,"y":0.31240188400226043,"h":0.013343799058084693},{"text":"environment?","h":0.01017441816943776,"w":0.096707814534505221,"x":0.10699588830887904,"y":0.32703488376896339},{"h":0.011773940345368938,"x":0.088477371569573193,"text":"2 What three arguments does he give for his opinion?","y":0.34144426992299193,"w":0.37860080295138887},{"h":0.011773940345368938,"text":"3 Do you agree with him? Why?\/Why not?","y":0.35596546307843147,"x":0.090534973797917237,"w":0.2983539157443576},{"x":0.082304529985556804,"y":0.40988372128574491,"w":0.12345678541395398,"h":0.014534882885320677,"text":"GREENER"},{"y":0.59661945382832537,"text":"Environment blog","h":0.028678807209200463,"w":0.28510369194878477,"x":0.073552431313527913},{"x":0.072016457935230524,"text":"Go veg to save the planet","y":0.63657770798855562,"w":0.28395061916775172,"h":0.016091051805337542},{"y":0.65843023268490308,"text":"by SamHarvey 11\/04\/19","x":0.072016462123942984,"w":0.17283950805664061,"h":0.010329578884729629},{"w":0.4279835340711805,"text":"1 In my opinion, the best thing we can do for our planet is to","h":0.013136157809845894,"y":0.67877906997558424,"x":0.069958844898566241},{"w":0.15020575629340277,"y":0.69622093043199607,"x":0.082304531138278014,"text":"become vegetarians.","h":0.010215490167518992},{"y":0.71507064349596339,"w":0.4218106757269966,"text":"2 First of all, there is a lot of waste when we produce meat.","h":0.013127030532812944,"x":0.069958854446172627},{"x":0.082304541724255637,"y":0.73255813948249149,"w":0.4300411309136285,"h":0.01162790690711013,"text":"For example, you need about sixteen kilograms of cereal and"},{"w":0.43209876166449657,"x":0.082304532953759862,"text":"nearly 20,000 litres of water to produce one kilogram of meat.","y":0.74843014145258191,"h":0.010290788518764971},{"y":0.76295133442038687,"x":0.080246920288789103,"h":0.011773940345368938,"text":"We should stop producing meat and grow cereals for humans","w":0.43621398925781252},{"x":0.080246925034842695,"text":"instead. It will be much easier to feed all the people in the world.","y":0.77904238615904731,"h":0.010204081632652962,"w":0.45473249647352426},{"text":"3 In addition, you need a lot of land to keep large farm animals,","x":0.06995887097954949,"h":0.013081394896215293,"w":0.45267486572265619,"y":0.79941860490169858},{"h":0.01162790690711013,"y":0.81540697668210371,"x":0.082304541794463448,"w":0.45061726888020837,"text":"such as cows. In South America, farmers are destroying tropical"},{"y":0.83124018845834369,"text":"forests to create space for cows which will become hamburgers","x":0.080246918559308947,"w":0.44855967203776043,"h":0.011783067248118395},{"w":0.12962962680392795,"x":0.080246916613468083,"h":0.010226899076668405,"y":0.84733124022244022,"text":"in other countries."},{"w":0.44238681369357641,"x":0.069958863900811005,"h":0.014644407964014783,"text":"4 Finally, remember the animals themselves! Animals on large","y":0.86616954505810284},{"h":0.011627906907110019,"text":"'factory farms' have a terrible life, and then a terrible death.","y":0.8837209302673753,"w":0.41769544813368059,"x":0.08024692091772774},{"text":"5 You don't even have to stop eating meat completely. Just eat","y":0.90406976750465406,"w":0.44032921685112852,"h":0.013120185636463444,"x":0.069958842911884422},{"x":0.080246907636812706,"y":0.92150706449707587,"text":"less. You'll help save the Earth and feed everyone on it!","h":0.011773940345368938,"w":0.39300411648220485},{"y":0.95348837218597982,"h":0.01162790690711013,"x":0.061728394672688293,"text":"104","w":0.034979423946804471},{"w":0.012345678541395344,"y":0.04796511642400203,"x":0.58024691402148343,"h":0.01017441816943776,"text":"4"},{"x":0.59465020436358673,"w":0.31687242296006946,"h":0.013343799058084804,"text":"Read the blog again. Put sentences a-e in","y":0.047880690659078629},{"w":0.30864196777343755,"text":"the correct order to show the structure of","h":0.010272534338982564,"x":0.6049382784589602,"y":0.062401883975387484},{"h":0.011773940345368938,"y":0.07692307701586687,"w":0.11111111111111116,"text":"the blog entry.","x":0.60493827271604939},{"x":0.60493828090210777,"w":0.18106994628906248,"h":0.011627906907110019,"y":0.094476744269313184,"text":"a Add another argument."},{"w":0.29012346055772564,"h":0.011627906907110019,"text":"b Repeat your opinion and\/or encourage","x":0.60493827455652793,"y":0.10901162789334418},{"text":"the reader to do something.","h":0.011627906907110019,"y":0.12354651180807286,"x":0.62139918371652358,"w":0.19341562906901044},{"w":0.18312756008572051,"h":0.011773940345368938,"x":0.60493827985940307,"y":0.1365777080743934,"text":"c Add the final argument."},{"y":0.15109890125405778,"w":0.14814814249674479,"text":"d State your opinion.","x":0.60493827628249175,"h":0.011773940345368938},{"h":0.013343799058084693,"text":"e Give the first explanation\/argument.","x":0.60493826983115118,"y":0.16405023565669263,"w":0.26748970879448786},{"text":"5 Complete the WRITING FOCUS with the","w":0.32098765055338552,"x":0.57818929694552967,"h":0.011805885066417221,"y":0.18877551029605255},{"x":0.60493828294672691,"w":0.22839504665798616,"y":0.20329670342726724,"h":0.011819575607683097,"text":"words in purple from the blog."},{"h":0.011773940345368938,"y":0.23390894819602492,"x":0.5802469127525155,"w":0.13786008199055988,"text":"WRITING FOCUS"},{"text":"An opinion and arguments","x":0.58024691814959484,"h":0.013081394896215293,"y":0.25581395364200865,"w":0.20576131184895829},{"text":"• Stating your opinion","h":0.011789912893034771,"y":0.27470930228772406,"x":0.57818930278310265,"w":0.16460905287000871},{"x":0.59053498070811838,"h":0.011776222351768895,"w":0.12962962680392787,"text":"I think\/l believe ...","y":0.28924418593597989},{"x":0.58847736955107266,"y":0.30376766124702748,"w":0.12551439921061203,"text":"In my 'opinion...","h":0.01454629179447009},{"h":0.011773940345368827,"text":"• First argument","x":0.57818930273522895,"y":0.32260596532992059,"w":0.12551439921061203},{"text":"Firstly, ...","y":0.33712715871815413,"w":0.067901234096950924,"x":0.59053498033835583,"h":0.01461702688148292},{"x":0.75308642051744923,"text":"First 2","w":0.041152263217502094,"h":0.010256562165600114,"y":0.33712715842590169},{"y":0.35465116294179377,"text":"•Next argument(s)","x":0.58024691442689247,"w":0.13374485439724393,"h":0.011627906907110019},{"x":0.59259259291364252,"y":0.37048665637426714,"text":"Secondly, ...","w":0.088477367824978281,"h":0.010327296878329562},{"x":0.7510288072788065,"w":0.05555555555555558,"y":0.37063953491853807,"text":"Also,...","h":0.011627906907109908},{"x":0.59053497970945257,"y":0.3837209303229846,"w":0.02674897087944883,"text":"In 3","h":0.01031360671134729},{"y":0.40261627922086363,"w":0.12551439921061192,"h":0.011627906907110019,"text":"• Final argument","x":0.57818930276094915},{"y":0.29069767466043617,"h":0.010322733614096524,"x":0.75102880548845874,"w":0.1316872406005859,"text":"It seems (to me) ..."},{"y":0.305232558338973,"text":"In my view...","h":0.010309043072830759,"x":0.75102881027922452,"w":0.094650200737847134},{"text":"Lastly, ...","y":0.4186046511976077,"h":0.011627906907110019,"w":0.063786006503634973,"x":0.75925926091999318},{"h":0.01017441816943776,"x":0.58024691367703041,"w":0.010288065804375468,"text":"6","y":0.4505813956936241},{"x":0.6049382803321115,"w":0.30041151258680565,"y":0.45054945064333385,"text":"Replace the phrases in purple in the blog","h":0.013113339991547068},{"y":0.46507064361333561,"h":0.011773940345368938,"text":"with different phrases from the WRITING","w":0.29835391574435766,"x":0.60493826756506397},{"text":"FOCUS.","y":0.47937679129996824,"h":0.012176649911063153,"x":0.60483346912465397,"w":0.059880388047960031},{"w":0.34583506266276043,"h":0.011874601642602678,"x":0.57811058625148815,"text":"7 Put the sentences in the correct order, as in","y":0.50286132880288359},{"text":"an opinion text.","w":0.11522633022732209,"y":0.51726844578534426,"x":0.60493827507838294,"h":0.011801321427900691},{"x":0.60467941670848013,"text":"a Lastly, why choose nuclear when there","y":0.53219575338120306,"w":0.28442827012803817,"h":0.017128144927451516},{"y":0.54941860459877057,"x":0.62139917800339184,"w":0.23045267740885422,"h":0.011805885066417221,"text":"are other options? Why not build"},{"text":"a wind farm?","h":0.014385950247197132,"x":0.62108528156576037,"y":0.56112097779058023,"w":0.091162770589192643},{"text":"b Please join the protest against","x":0.60471253187839091,"y":0.57575462707445224,"w":0.22882998996310755,"h":0.014878012508949268},{"text":"the power plant today!","y":0.59301412860080749,"w":0.16049382527669265,"x":0.62139917629169483,"h":0.011773940345368938},{"text":"c Firstly, it's not safe. A mistake can","x":0.60493827849018611,"y":0.60596546297184228,"h":0.011773940345368938,"w":0.24897118462456591},{"y":0.6204866563197613,"w":0.22427983601888024,"x":0.62139918037876285,"text":"cause a terrible disaster, like the","h":0.010327296878329673},{"w":0.15271163940429677,"h":0.014463596853019678,"text":"one in Japan in 2011.","y":0.63349281391299961,"x":0.62114317305145839},{"h":0.014617026881483031,"x":0.60288065959452564,"w":0.26748970879448786,"y":0.64825581455297909,"text":"d I believe the plan to build a nuclear"},{"y":0.66279069765109611,"w":0.23045267740885422,"x":0.62139917800339184,"h":0.01162790690711013,"text":"power station next to our town is"},{"text":"a very bad idea.","x":0.62139917805537481,"y":0.67732558139382881,"w":0.11316872490776908,"h":0.011627906907110019},{"w":0.27366255018446173,"x":0.60493827679391443,"text":"e Secondly, we should not use nuclear","h":0.011773940345368938,"y":0.69034536892057341},{"h":0.011773940345368938,"w":0.24897118462456602,"text":"energy if we don't know what to do","x":0.62139918549978823,"y":0.70486656210023779},{"y":0.71938775495406826,"h":0.011773940345368938,"w":0.26543209499782983,"text":"with the dangerous radioactive waste.","x":0.62139918326240173},{"x":0.58436214249260554,"h":0.010217772173918949,"text":"SHOW WHAT YOU'VE LEARNT","w":0.24485595703124996,"y":0.75431711140207902},{"x":0.58024691367703041,"text":"8","y":0.77906976778664738,"h":0.01017441816943776,"w":0.010288065804375468},{"x":0.59259258747247145,"y":0.77904238642212231,"w":0.29835391574435766,"h":0.013108775978747045,"text":"Write a blog entry on a topic connected"},{"text":"with the environment. Use the ideas in","w":0.27777777777777768,"x":0.60493827507716047,"y":0.79356357932781041,"h":0.010215490167518992},{"w":0.31481479220920139,"x":0.60493828601474076,"h":0.011773940345368938,"text":"Exercise 1 and the WRITING FOCUS to help","y":0.80808477249547006},{"x":0.60493827408932521,"text":"you. Include the following information:","w":0.27983539157443582,"h":0.013343799058084804,"y":0.82103610695625451},{"text":"• Express your opinion.","x":0.60493827410304268,"y":0.84011627905613495,"w":0.16872428046332466,"h":0.011627906907110019},{"w":0.29012346055772564,"h":0.013081394896215404,"x":0.60493827455652793,"y":0.85319767457224116,"text":"• Give at least two arguments to support"},{"text":"your opinion.","x":0.6193415671926239,"y":0.86918604671106603,"h":0.010327297252613055,"w":0.096707814534505276},{"y":0.88226059662464928,"text":"• Encourage the readers to take action.","x":0.60493828443199948,"h":0.011773940345368938,"w":0.27983537462022567}]
[{"y":0.063953488525729574,"text":"READING","x":0.08230452993677892,"w":0.094650200737847218,"h":0.013081394896215293},{"w":0.010288065804375537,"x":0.078189300534026215,"h":0.01017441816943776,"y":0.091569767829040805,"text":"8"},{"w":0.39506171332465279,"x":0.10082304621833221,"h":0.011773940345368938,"text":"Read the text and complete gaps 1-3 with sentences","y":0.091444269898767083},{"h":0.010313606337063685,"text":"A-E. There are two extra sentences.","y":0.10596546323699629,"w":0.26543209499782983,"x":0.10288066474388327},{"text":"YOUNG AUSTRALIA","y":0.14244186062707698,"w":0.27983539157443582,"h":0.018895348349770469,"x":0.082304528183975503},{"x":0.38888888862902476,"y":0.1438953486063379,"text":"*","h":0.021802325825114877,"w":0.028806584676106806},{"y":0.13953488346745935,"h":0.015988372371559811,"x":0.45679012307918848,"text":"*","w":0.022633745405409078},{"w":0.010288065804375524,"y":0.15988372086913605,"x":0.45061728386735961,"h":0.0087209301803324868,"text":"*"},{"x":0.082304529789376177,"w":0.38271603054470482,"h":0.011627906907110019,"text":"Life for young people in Australia can be quite different","y":0.17877906985070857},{"w":0.22222222222222221,"text":"now to just a few decades ago.","h":0.011773940345368938,"x":0.08230453045267476,"y":0.19466248045510448},{"h":0.011773940345368938,"y":0.2091836735984316,"w":0.37448557535807292,"text":"Today, young people have better qualifi cations. More","x":0.08230454210491403},{"x":0.082304531182417817,"w":0.37448557535807292,"h":0.011773940345368938,"y":0.22527472525846903,"text":"people are going to university than ever before. Why?"},{"w":0.3930041164822049,"h":0.01162790690711013,"text":"One reason is that there are more courses than before. 1","x":0.084362143945111476,"y":0.24127906994760773},{"text":"Finally, you can get a much better job if you have","h":0.014161097947244961,"y":0.25659885924665959,"x":0.12749967093123701,"w":0.34585689968532984},{"w":0.33539093017578125,"h":0.011627906907110019,"x":0.082304535083577102,"y":0.271802325422414,"text":"a degree. Job training is also more popular now."},{"y":0.28633720955286135,"w":0.39094648573133678,"text":"Nowadays, over 70 percent of young people have a job.","x":0.082304541427884195,"h":0.013113339991547068},{"h":0.011773940345368938,"text":"A lot of young people don't wait until after they fi nish","x":0.082304532742774342,"y":0.30219780220802661,"w":0.37448557535807292},{"text":"studying to get a job. Many work part-time while they are","w":0.39917694091796879,"x":0.082304528666530152,"h":0.011773940345368938,"y":0.31828885414544827},{"x":0.082273120442120026,"w":0.067964049445258232,"y":0.33419667939934783,"h":0.010385710927343528,"text":"studying."},{"h":0.011627906907110019,"y":0.35029069775768529,"x":0.12962963686322485,"w":0.32098765055338541,"text":"_ Now 69 percent of young women have jobs,"},{"text":"compared to 54 percent then.","x":0.082304531256229066,"h":0.01017441816943776,"y":0.36482558159478695,"w":0.2098765394422743},{"text":"More young people live in the biggest cities in Australia","h":0.011627906907109908,"y":0.37936046520923572,"x":0.082304523529168352,"w":0.38477366129557294},{"x":0.082304525964104397,"h":0.010311324704947222,"w":0.36419752332899302,"text":"than in the countryside - just 16 percent live outside","y":0.39521193094590545},{"x":0.084362154924205832,"y":0.40973312420441821,"w":0.37037034776475691,"text":"cities. They live at home for longer - most don't leave","h":0.011778503609601865},{"h":0.011792194525151234,"text":"home until they are in their twenties. After getting their","x":0.082304529092855377,"y":0.42425431711638828,"w":0.38683125813802088},{"text":"first house, they move more often than before. Often,","y":0.4403453689690231,"w":0.37654320610894099,"x":0.082304533339562336,"h":0.011773940345368938},{"x":0.08230452966447252,"text":"they move to a different city to get a better job. It seems","w":0.39917694091796874,"h":0.011815011969166567,"y":0.45639534893016598},{"y":0.47093023256642719,"text":"that young people are happier about the idea of changing","x":0.082304529642623553,"w":0.39711934407552085,"h":0.013081394896215293},{"x":0.08230453492744759,"y":0.48691860468597992,"text":"cities for a job than before.","w":0.18930040147569444,"h":0.011627906907109908},{"x":0.08230454030919096,"w":0.39917694091796874,"y":0.50145348840691006,"text":"Young people are also delaying the age they get married.","h":0.011627906907110019},{"x":0.080246914742393122,"y":0.51889534876642285,"w":0.02263374328613281,"text":"3","h":0.0087209301803325978},{"y":0.51598837260772734,"w":0.36419752332899302,"h":0.014623872526399406,"text":"One reason for this is that more young people live","x":0.11522633514620331},{"x":0.082304532176294326,"text":"together before they get married.","w":0.23456788804796011,"y":0.53178963913227761,"h":0.013343799058084693},{"y":0.56291558253563478,"w":0.35009036593967013,"h":0.014294800990417578,"text":"A More women are going to university nowadays,","x":0.10273930071160427},{"y":0.57848837212784032,"h":0.011778503983885358,"x":0.11934157261073722,"w":0.24691357082790796,"text":"which means they have better jobs."},{"w":0.38683125813802083,"y":0.59144427025257751,"h":0.013343799058084804,"text":"B Another reason is that you don't have to pay for your","x":0.10288067062234751},{"x":0.1172839466841753,"y":0.60753532179985159,"text":"university studies until you are working.","h":0.011773940345368938,"w":0.27366255018446178},{"x":0.10288066349866572,"text":"C On average, men are six years older and women are","w":0.38065843370225694,"h":0.013343799058084693,"y":0.62048665595418218},{"y":0.63500784935297327,"w":0.12551439921061197,"text":"seven years older.","h":0.011794476157267697,"x":0.11934156739572277},{"y":0.64952904232297515,"x":0.1028806650268051,"text":"D The number of women who work is also different to","h":0.010354678335144918,"w":0.37654320610894099},{"text":"forty years ago.","y":0.66204631143795789,"w":0.11349443223741321,"x":0.11712109482700972,"h":0.014570166589326639},{"x":0.10288065891994083,"y":0.67732558164588463,"h":0.013081394896215293,"w":0.34773661295572922,"text":"E The number of young people that vote is much"},{"text":"higher than before.","h":0.01162790690711013,"x":0.11934156595448933,"y":0.69186046515109612,"w":0.13580246819390193},{"x":0.082197159738193748,"y":0.72636268898737877,"w":0.090749715169270828,"h":0.013844389743295937,"text":"WRITING"},{"text":"9 Read the information and write a blog post.","y":0.75431711146275904,"w":0.34773661295572916,"h":0.011773940345368938,"x":0.078189310168225876},{"h":0.01181501234345006,"x":0.082304531182417817,"w":0.37448557535807292,"y":0.78178963878452357,"text":"You have a new personal blog. Write the first post with"},{"w":0.15084062364366319,"h":0.016169052483335555,"x":0.081964255491797644,"y":0.79448384068259348,"text":"your personal profile."},{"y":0.81240188411127212,"h":0.013343799058084804,"text":"• Describe your appearance and personality.","w":0.3127571953667535,"x":0.084362139147899057},{"x":0.084362147344057933,"y":0.82692307704493673,"h":0.011773940345368938,"text":"• Write about your likes and dislikes.","w":0.25720163981119792},{"text":"• Introduce your family and friends.","x":0.08436214709633405,"y":0.84144427016646139,"w":0.24691357082790799,"h":0.011773940345368938},{"w":0.11316872490776908,"x":0.52263374595660939,"text":"SPEAKING","y":0.063953488507560996,"h":0.013081394896215293},{"text":"10 Complete the questions, then ask and answer with","w":0.39917694091796874,"h":0.011773940345368938,"x":0.52469136992167387,"y":0.091444270151926577},{"x":0.55144033184513042,"y":0.10753532187968573,"h":0.010204081632653073,"w":0.072016457451714366,"text":"a partner."},{"text":"1 What k of clothes do you like and why?","x":0.55144032678380062,"y":0.12354651159004959,"w":0.31069959852430551,"h":0.01162790690711013},{"w":0.3127571953667535,"text":"2 What does your best friend look ?","h":0.013131593797045871,"x":0.55144033601003883,"y":0.13657770813870707},{"h":0.011627906907110019,"y":0.15261627901737518,"x":0.55144033313822172,"text":"3 What do you have to d_at home every day?","w":0.32921810574001731},{"text":"4 How o_ do you change your hairstyle?","h":0.013343799058084693,"y":0.16562009444352999,"x":0.55144033449931396,"w":0.33333333333333337},{"x":0.52469136837196706,"y":0.19034536878853803,"w":0.28395060221354163,"h":0.011773940345368938,"text":"11 Choose the correct answer, A or B."},{"h":0.013108775978747045,"text":"1 X: Hi. How can I help?","x":0.55144033017949845,"w":0.17283950805664061,"y":0.20784883759913075},{"w":0.018518517812093016,"h":0.010174418169437871,"text":"Y:","x":0.56584362193757498,"y":0.22238372110423454},{"h":0.010334142523246048,"x":0.58641975554314751,"w":0.13374485439724393,"text":"A l'd like a haircut.","y":0.23691860481426363},{"x":0.5884773670675395,"h":0.013081394896215293,"y":0.25000000017180513,"text":"B No, you can't.","w":0.11522633870442711},{"text":"2 X: Would you like your hair the same, but shorter?","h":0.011773940345368827,"y":0.26452119327262102,"x":0.55144033748629606,"w":0.36625512017144102},{"h":0.01162790690711013,"x":0.56584362185527037,"y":0.27906976759295654,"w":0.018518517812093016,"text":"Y:"},{"y":0.29199372065859153,"h":0.011785348880234747,"x":0.58641975552658676,"w":0.16460905287000871,"text":"A Yes. I'm sure I would."},{"y":0.30808477254381195,"text":"B I'm not sure.","h":0.010229180708784869,"x":0.58847736822052643,"w":0.1069958835177951},{"text":"3 X: What about having a fringe?","y":0.32103610690780493,"h":0.013343799058084915,"w":0.23868311564127609,"x":0.54938272599280491},{"h":0.010174418169437871,"x":0.56790123573004747,"w":0.022633743286132768,"text":"Y:","y":0.33575581419531986},{"x":0.58847737064445083,"w":0.15020575629340271,"y":0.35029069763656129,"text":"A That sounds good.","h":0.011627906907110019},{"y":0.36337209307128882,"h":0.010254280533483651,"text":"B It looks cool! Thanks.","w":0.16255143907335068,"x":0.58847736527128092},{"text":"4 X: How about this hairstyle?","y":0.37790697689528219,"h":0.01181044870493364,"x":0.551440332454608,"w":0.21193415323893228},{"w":0.022633743286132768,"h":0.013081394896215404,"x":0.56790123563574024,"text":"Y: _","y":0.39244186070959586},{"text":"A No, I'd like to change my hairstyle.","w":0.26543209499782983,"y":0.40697674422086361,"x":0.58641975939408897,"h":0.011783067248118284},{"x":0.58641975805429636,"text":"B No, I don't like it.","y":0.41993720555532787,"w":0.14197530110677081,"h":0.013343799058084693},{"y":0.43445839880997117,"x":0.55144033395359782,"w":0.15226337009006075,"h":0.011773940345368938,"text":"5 X: I'd like a haircut."},{"text":"Y:","h":0.011627906907110019,"x":0.56584362188466486,"y":0.44912790694926896,"w":0.018518517812093016},{"text":"A OK. You can put it in a ponytail.","x":0.58847737620389096,"y":0.46220930250113823,"w":0.23662550184461806,"h":0.014635281435548819},{"text":"B OK. Would you like it the same, but shorter?","y":0.47674418605479929,"w":0.32921810574001731,"x":0.58847736434535491,"h":0.013081394896215293},{"text":"6 X: Take a look. What do you think?","x":0.55144033499630263,"y":0.49127906972958446,"h":0.011627906907110019,"w":0.26131686740451399},{"y":0.50581395346089686,"w":0.018518517812093016,"x":0.56584362188466486,"text":"Y:","h":0.011627906907110019},{"w":0.17901234944661459,"h":0.011627906907110019,"text":"A Yes, you can do it now.","y":0.52034883720778213,"x":0.5884773666089973},{"h":0.012431213208232927,"x":0.58838180217223179,"w":0.094841334025065116,"y":0.53448206777312179,"text":"B It's perfect!"},{"y":0.56540697677900309,"w":0.17695471869574653,"x":0.52469136788120752,"h":0.011627906907110019,"text":"12 Do the task in pairs."},{"text":"Student A","x":0.55130533336924681,"y":0.60848075896060161,"w":0.076401680840386232,"h":0.011236156361817962},{"w":0.32921810574001731,"x":0.55144033313822172,"text":"You are a hairdresser. Start the conversation.","h":0.011773940345368938,"y":0.63226059659557932},{"h":0.013343799058084693,"w":0.37860080295138898,"text":"• Greet Student B and ask how you can help him\/her.","x":0.54938272753665118,"y":0.64952904260420852},{"y":0.6640502353743557,"h":0.011821857614083053,"w":0.36008229573567707,"text":"• Suggest a hairstyle and show Student B a photo.","x":0.54938272644629027},{"x":0.54938271963955598,"h":0.011627906907110019,"text":"• Ask for Student B's opinion (how about? what","w":0.33744856092664932,"y":0.67877906972958446},{"x":0.56584362224426688,"text":"about?).","y":0.69331395377865312,"h":0.010174418169437871,"w":0.057613165113661102},{"x":0.5493827179820121,"y":0.70639534911802604,"w":0.34773661295572922,"h":0.013081394896215293,"text":"• Then ask for Student B's opinion about the new"},{"text":"hairstyle.","w":0.063786006503634973,"x":0.56790123622863509,"y":0.72238372112967064,"h":0.01017441816943776},{"w":0.074074071248372397,"x":0.55144033052807728,"h":0.0090266875981162009,"text":"Student B","y":0.7629513344722445},{"x":0.55144033211383581,"text":"You're a customer at the hairdresser's.","w":0.28189300537109374,"h":0.010366087244294331,"y":0.78633720950176367},{"text":"• You want a new haircut or hairstyle.","x":0.54938272167118096,"y":0.8021978025194435,"w":0.26543209499782983,"h":0.013343799058084804},{"w":0.38683125813802088,"h":0.011773940345368938,"x":0.55144034284456966,"y":0.81828885403643659,"text":"• Describe what you want and ask to see some photos."},{"text":"• Agree to Student A's suggestion.","x":0.54938271910747016,"y":0.83124018813020528,"h":0.013343799058084804,"w":0.24897118462456591},{"x":0.54938271595896038,"text":"• Say you are happy with the new cut\/style.","w":0.30864196777343755,"h":0.011796758163667764,"y":0.84576138137273615},{"y":0.95494186060664055,"text":"59","w":0.024691357082790799,"x":0.90946502125284323,"h":0.013081394896215293}]
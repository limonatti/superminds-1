3343799058084693},{"x":0.10699588943651425,"y":0.64952904245885956,"text":"the summer. The work is hard but healthy.","w":0.32304524739583329,"h":0.013343799058084804},{"x":0.10699588677983535,"w":0.33333333333333331,"y":0.66860465134295666,"text":"You can pick strawberries in July and apples","h":0.011627906907110019},{"x":0.10699588838071464,"y":0.68445839861617264,"w":0.15432098388671875,"text":"in August - yummy!","h":0.011773940345368938},{"y":0.73390894848148669,"w":0.31481479220920139,"h":0.013343799058084804,"text":"Perhaps you don't like children, you can't","x":0.10699589419032395},{"y":0.7514534884941193,"x":0.10699588010215734,"w":0.34156378851996527,"h":0.01162790690711013,"text":"speak foreign languages, and you want to stay"},{"x":0.10699589684392138,"w":0.32304524739583329,"text":"in your home town anyway? Well, can you","y":0.76726844578534426,"h":0.011801321427900691},{"y":0.78488372086815039,"text":"ride a bike really well? Get a job as a bicycle","w":0.33539093017578125,"x":0.10905351169537394,"h":0.011819575981966479},{"x":0.10699587643202392,"text":"courier! The work is quite demanding - you're","w":0.34979424370659723,"h":0.01162790690711013,"y":0.80087209315497221},{"text":"on your bike all day. But in the evening, you","w":0.33539093017578125,"x":0.10699589852664966,"y":0.81671899509588963,"h":0.013343799058084804},{"h":0.01162790690711013,"w":0.2160493808322482,"y":0.83430232568888674,"text":"can go out with your friends.","x":0.10905349618367019},{"x":0.52263374346707814,"h":0.013081394896215404,"y":0.062500000280816703,"w":0.11111111111111116,"text":"SPEAKING"},{"x":0.52469135794143362,"h":0.010174418169437871,"w":0.010288065804375579,"text":"9","y":0.090116279185629922},{"x":0.55144033545412163,"text":"Describe the photos. Use the words in the box and","w":0.37242797851562492,"y":0.090116279017375178,"h":0.011627906907110019},{"x":0.54938271635568048,"h":0.01162790690711013,"w":0.098765428331163196,"y":0.10465116263171625,"text":"the pro
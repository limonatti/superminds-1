":0.0123456785413954,"h":0.0087209301803324868,"x":0.063786008671689126},{"w":0.15020575629340277,"x":0.086419753094725327,"h":0.010338706161762579,"text":"Is there any cheese?","y":0.92425431694911908},{"h":0.010338706161762579,"w":0.15637859768337675,"x":0.29835390947106877,"y":0.92425431694911908,"text":"Are there any onions?"},{"w":0.026748970879448788,"h":0.013081394896215293,"x":0.063786008654925813,"y":0.95494186061875275,"text":"26"},{"w":0.074074071248372397,"h":0.017441860360665085,"text":"VIDEO","x":0.7469135813511224,"y":0.010174418802225582},{"x":0.88065843545442168,"text":"6869","y":0.0087209303678402739,"w":0.08436214023166233,"h":0.017441860360664974},{"y":0.046511627869119443,"h":0.011627906907110019,"w":0.38683125813802077,"x":0.54115227700094837,"text":"5 Complete the dialogue with some and any. What"},{"y":0.061046511724389574,"text":"do Sue and Tom decide to have?","w":0.24485595703124996,"h":0.010174418169437871,"x":0.56584363050357933},{"text":"Sue: I'm hungry.","w":0.11934155782063793,"x":0.56584362587363157,"y":0.08712715870218235,"h":0.011773940345368938},{"x":0.56584362671883026,"text":"Tom: Me too. Let's make some sandwiches. Is","y":0.10029069783751954,"w":0.32510287814670136,"h":0.01017441816943776},{"h":0.014179657168066462,"x":0.56568374380595232,"text":"there' any","w":0.086739510430230093,"y":0.11136947329901292},{"h":0.010404804624979724,"text":"bread?","w":0.059748662312825607,"x":0.66045488629770244,"y":0.11180341147394479},{"w":0.16460905287000871,"y":0.12637362647430161,"x":0.56584362445662795,"text":"Sue: Yes, there's? —","h":0.014614745249366456},{"x":0.73045267654395507,"y":0.12790697677900309,"h":0.01181044870493364,"w":0.065843620300292893,"text":"_ bread."},{"h":0.011796758163667653,"x":0.5658436245358649,"y":0.14244186030613493,"text":"Tom: But there isn't 3","w":0.16049382527669265},{"x":0.75102880619946388,"text":"_cheese or ham in the","h":0.01162790690711013,"y":0.14389534898103795,"w":0.15637859768337681},{"w":0.049382714165581598,"text":"fridge.","y":0.15697674419433416,"h":0.013081394896215404,"x":0.60493827186096771},{"x":0.56584363361103063,"w":0.3312757025824653,"text":"Sue: That's OK. I don't like cheese or ham. Are","h":0.01031588796918026,"y":0.17296511662385661},{"h":0.010204081632653073,"w":0.053497941758897549,"text":"there 4","y":0.18602825736412221,"x":0.60493827102727271},{"w":0.053497941758897549,"h":0.013081394896215293,"y":0.18604651163619468,"x":0.68930041245388451,"text":"_eggs?"},{"y":0.19897959179583702,"text":"Tom: Yes, there are 5","w":0.15226337009006075,"x":0.56584362524303544,"h":0.011776221977485513},{"y":0.20348837207068649,"h":0.0087209301803324868,"x":0.76131687475227583,"w":0.045267486572265647,"text":"eggs."},{"y":0.2135007849755014,"h":0.011789912518751389,"text":"Sue: And tuna? Are there 6","x":0.56584362766696006,"w":0.19547324286566836},{"h":0.011784822263373296,"w":0.092631827460395,"x":0.80450712999359308,"y":0.21358433319709247,"text":"tins of tuna?"},{"x":0.60699589297578294,"text":"Tuna and egg sandwiches are my favourite.","y":0.22802197772527288,"h":0.013343799058084804,"w":0.30452674018012149},{"text":"Tom: No, there aren't?","w":0.16872428046332466,"h":0.013081394896215293,"y":0.24127906977572955,"x":0.56584362355434581},{"text":"tins of tuna.","y":0.24232910676532937,"h":0.012434809698227522,"x":0.77561981728811691,"w":0.090735677083333299},{"w":0.35596706814236112,"x":0.5658436299823173,"text":"Sue: But I can see a packetof cornfl akes. Have we","y":0.25726744183714267,"h":0.011627906907110019},{"x":0.60699588604460031,"text":"got","h":0.013081394896215404,"w":0.051440327962239629,"y":0.27034883734477022},{"x":0.66255144073498895,"w":0.061728392706976942,"text":"milk?","h":0.010174418169437871,"y":0.27180232588984499},{"x":0.56584362201826943,"w":0.20164608425564234,"h":0.013081394896215293,"y":0.28488372121104932,"text":"Tom: No, we haven't got 9"},{"y":0.28633720925576389,"x":0.8024691363953641,"text":"milk!","w":0.041152263217502205,"h":0.0087209301803325978},{"y":0.29941860441269075,"x":0.56584363352737321,"h":0.017441860360664974,"text":"Sue: Oh well, let's get a takeaway. We can get","w":0.32716047498914924},{"x":0.64609053550596729,"h":0.011773940345368938,"y":0.31240188401062119,"text":"- pizzas!","w":0.072016457451714366},{"text":"Tom: Good idea!","y":0.32848837203094106,"x":0.56584362553186818,"w":0.12551439921061203,"h":0.011778503983885358},{"w":0.37242797851562504,"y":0.35319767438074734,"x":0.54115227054157,"h":0.011794476157267808,"text":"6 Read the GRAMMAR FOCUS and complete the"},{"h":0.011780785616001932,"x":0.56584361385071058,"y":0.36773255824702633,"text":"questions with how much and how many.","w":0.30246914333767361},{"y":0.3982558140755148,"h":0.011627906907110019,"x":0.54320987420745726,"w":0.17078189425998258,"text":"GRAMMAR FOCUS 3"},{"y":0.41993720584602556,"text":"much, many and a lot of","h":0.013343799058084693,"x":0.54115226650495107,"w":0.18930040147569449},{"text":"Uncountable nouns","y":0.43877551008033389,"h":0.010352396703028566,"w":0.14403291490342873,"x":0.53909465125884815},{"h":0.01024971689496712,"x":0.54115226615822465,"w":0.19341562906901044,"text":"How much cheese is there?","y":0.45486656201775566},{"x":0.54115227001742128,"w":0.25514402601453989,"y":0.46938775511868924,"text":"There isn't much cheese.\/Not much.","h":0.010263407436233107},{"y":0.48255813954063109,"h":0.011627906907109908,"text":"There's a lot of cheese.\/A lot.","w":0.20781892564561633,"x":0.54115226765044289},{"text":"Plural countable nouns","y":0.50000000004803302,"h":0.010204081632653073,"x":0.54115226382030179,"w":0.16666666666666663},{"w":0.20164608425564245,"h":0.011627906907110019,"x":0.54115226853061493,"text":"How many onions are there?","y":0.51598837204063097},{"text":"There aren't many onions.\/Not many.","w":0.26337448120117191,"y":0.53052325584877058,"x":0.54115226996182819,"h":0.011627906907110019},{"x":0.54115226589009857,"text":"There are a lot of onions.\/A lot.","y":0.54505813970888572,"w":0.22016460842556429,"h":0.010279379983899051},{"y":0.57412790706970074,"x":0.56584361527596938,"w":0.29835391574435766,"h":0.011821857614083053,"text":"1 How much_ water do you drink a day?"},{"text":"2","h":0.0087209301803324868,"x":0.56584362134163935,"y":0.58866279061477556,"w":0.010288065804375579},{"text":"3","x":0.56584362131591925,"y":0.60319767435750815,"w":0.010288065804375579,"h":0.0087209301803325978},{"text":"pizzas do you eat a month?","y":0.58866279108750275,"w":0.19341562906901033,"x":0.67489712157660597,"h":0.013081394896215293},{"text":"bread do you eat a day?","x":0.67489711558759202,"y":0.60164835151737106,"h":0.013343799058084693,"w":0.17283950805664061},{"y":0.61620572004147534,"w":0.19378317938910583,"x":0.67266083762453621,"text":"_ cola do you drink a week?","h":0.013798358863339577},{"w":0.010288065804375579,"h":0.0087209301803325978,"text":"5","y":0.6308139534054733,"x":0.56584362134163935},{"h":0.0087209301803325978,"x":0.56584362131591925,"w":0.010288065804375579,"y":0.6453488370900663,"text":"6"},{"y":0.63069073780632989,"w":0.17901233249240456,"x":0.67695474208713091,"h":0.011773940345368827,"text":"milk do you drink a day?"},{"text":"hamburgers do you eat a year?","x":0.67489712332494067,"y":0.64521193098599428,"w":0.22016460842556418,"h":0.011773940345368827},{"w":0.014403292338053375,"x":0.53703703685566473,"text":"7","h":0.011627906907110019,"y":0.6686046510813286},{"h":0.011773940345368827,"w":0.32510287814670136,"text":"SPEAKING Ask and answer the questions in","x":0.55349794652335704,"y":0.66993720577565563},{"y":0.68427827163552024,"h":0.010803921817797546,"w":0.078348541259765536,"text":"Exercise 6.","x":0.56782161544724119},{"x":0.56790123159085926,"h":0.010288506886648396,"text":"A: How much water do you drink a day?","w":0.28189300537109374,"y":0.70203488399909897},{"x":0.56790123827160488,"text":"B: I drink a lot of water. or A lot.","y":0.71507064362655171,"h":0.010220053806035523,"w":0.22222
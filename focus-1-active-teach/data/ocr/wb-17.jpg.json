[{"x": 0.2271914131277188, "h": 0.01896802322098491, "text": "GRAMMAR", "y": 0.036671511582094786, "w": 0.17352415296766494}, {"text": "1.5", "x": 0.11806797836712608, "h": 0.0278197677901506, "w": 0.0536672634548611, "y": 0.061962208929467896}, {"w": 0.11627906799316404, "text": "Present Simple;", "x": 0.22719141315607153, "h": 0.011504071735733246, "y": 0.07840116307848247}, {"w": 0.20214669121636283, "x": 0.22540250504029793, "y": 0.0922608304813688, "text": "Yes/No and Wh- questions", "h": 0.014133574007220224}, {"text": "SHOW WHAT YOU KNOW", "w": 0.20930231730143228, "h": 0.011408204330864402, "x": 0.10733453157417526, "y": 0.14918772560337118}, {"w": 0.39892662896050346, "h": 0.012663609129427173, "text": "1 Complete the questions with the words from the box.", "x": 0.10017890875320076, "y": 0.17195848366422448}, {"w": 0.34704830593532987, "x": 0.11985688030603822, "text": "Are How Is What When Where Who", "y": 0.195907039675026, "h": 0.012741215719642991}, {"text": "What is your name?", "y": 0.21867779788912264, "w": 0.13774597167968752, "h": 0.01146755085525103, "x": 0.1413237939231258}, {"w": 0.11091233995225694, "h": 0.01270013000990929, "text": "My name's Joe.", "x": 0.1377459754174315, "y": 0.23267441870780192}, {"y": 0.24658430236090467, "text": "1", "x": 0.11627906999076976, "w": 0.008944543202718092, "h": 0.008851743820341951}, {"text": "you American?", "x": 0.19677996618619592, "y": 0.2477301444959566, "w": 0.10733451843261721, "h": 0.010234971700592574}, {"x": 0.1395136412033022, "text": "Yes, I am.", "y": 0.2604305126652786, "w": 0.06802101982964409, "h": 0.011508160313113915}, {"x": 0.11627907002350928, "text": "2", "h": 0.010116278651819414, "w": 0.01073345184326173, "y": 0.27440406980781124}, {"text": "are you from in the USA?", "x": 0.20035778706184745, "y": 0.27440407023941527, "w": 0.17352413601345487, "h": 0.012645348314774147}, {"text": "I'm from Seattle, in Washington State.", "h": 0.012722955653813801, "x": 0.13595707680775182, "y": 0.2895784886333106, "w": 0.2683363003200955}, {"w": 0.008944543202718092, "x": 0.11627907014729927, "h": 0.008851743820341854, "text": "3", "y": 0.3034883723865224}, {"x": 0.20026587287324707, "y": 0.3030928422984988, "text": "that your car?", "h": 0.012171873831146453, "w": 0.09499598185221361}, {"x": 0.139534886883203, "y": 0.317220216463244, "w": 0.16457960340711805, "h": 0.011558853056456667, "text": "No, it isn't. I can't drive."}, {"y": 0.33130813962921857, "w": 0.010733452902899857, "h": 0.008851743820341951, "x": 0.11449016077574149, "text": "4"}, {"h": 0.012237591347539397, "text": "is that girl?", "x": 0.19666035158544676, "y": 0.33087975068683867, "w": 0.07895121256510418}, {"x": 0.13774597565159985, "y": 0.34509476525954885, "text": "That's my sister, Clara.", "w": 0.15384614732530383, "h": 0.011504071735733246}, {"x": 0.11449016146656232, "w": 0.010733451843261715, "y": 0.36039244215396415, "h": 0.008851743820341951, "text": "5"}, {"w": 0.08601464165581596, "x": 0.19849536146100755, "h": 0.01075901574606494, "y": 0.36007107357749824, "text": "old are you?"}, {"h": 0.012713825246487384, "y": 0.3729693140271788, "text": "I'm 17.", "w": 0.05187835269504121, "x": 0.13595706759255094}, {"text": "6", "y": 0.3882122096327069, "w": 0.008944543202718092, "h": 0.008851743820341951, "x": 0.11449016140400768}, {"h": 0.011453855244261213, "y": 0.388212209558497, "w": 0.11806797451443143, "x": 0.19499105549770382, "text": "is your birthday?"}, {"y": 0.402021660670895, "w": 0.2003577677408854, "text": "In May. On the seventeenth.", "h": 0.011481246091828929, "x": 0.13595707653504316}, {"w": 0.01073345184326173, "y": 0.43247093035218365, "x": 0.0912343476025194, "text": "2", "h": 0.008851743820341951}, {"x": 0.10196779500442972, "w": 0.3255813937717014, "h": 0.0127366508903917, "y": 0.43247093049377566, "text": "* Complete the dialogue with do or does."}, {"text": "Cheryl: Hi, I'm Cheryl. Do you work here?", "y": 0.4501744187394153, "x": 0.11449015675136814, "w": 0.2951699490017361, "h": 0.012700130009909388}, {"y": 0.466613372143485, "w": 0.11806797451443142, "h": 0.0127503461269696, "text": "Harry: Yes, 11_", "x": 0.11627907308863993}, {"x": 0.25402504594287406, "w": 0.18246868557400175, "text": "_. Are you here for a job?", "h": 0.012663609129427173, "y": 0.46787790740656643}, {"x": 0.11621205937527078, "y": 0.48428984895391647, "text": "Cheryl: Yes, but Mr Parkin isn't here. What time 2", "w": 0.3418260362413194, "h": 0.01281429042885023}, {"text": "he usually arrive?", "h": 0.011485811295492138, "x": 0.17352415360111303, "w": 0.11985688103569878, "y": 0.49938628163492815}, {"h": 0.012969624169897099, "y": 0.5158492431768396, "x": 0.11439176001776641, "text": "Harry: At about 10 o'clock. 3", "w": 0.2095176527235243}, {"x": 0.3502352949691872, "y": 0.5170330855749188, "text": "- you want a cup of", "w": 0.13147984822591147, "h": 0.015332157689311485}, {"w": 0.05187835269504121, "x": 0.17173524268945017, "text": "coffee?", "h": 0.010116278651819414, "y": 0.531104651308538}, {"y": 0.5475436047016246, "text": "Cheryl: Yes, please. Thanks. What 4", "x": 0.11449016140639963, "w": 0.2504472181532118, "h": 0.012695565180658001}, {"x": 0.39850872008937394, "text": "_ you do here?", "y": 0.5488712835573306, "w": 0.10268564860026047, "h": 0.011823078867330463}, {"w": 0.3935599093967014, "h": 0.012659044300175787, "text": "Harry: 1 clean the kitchen and the tables in the restaurant.", "x": 0.11270126457075226, "y": 0.5652470932483438}, {"x": 0.11270125503834139, "y": 0.5816860466733448, "text": "Cheryl: 5 you like your job?", "w": 0.23613594902886287, "h": 0.015174417977728975}, {"y": 0.6006540700033687, "text": "Harry: It's OK. I like the money", "x": 0.11449016787834368, "h": 0.012645348314774147, "w": 0.22361358642578125}, {"y": 0.6170930230580947, "h": 0.013909883895075253, "x": 0.11091234411278976, "w": 0.08050089518229166, "text": "Cheryl: •"}, {"h": 0.011394509094286501, "text": "lots of people come here to eat?", "w": 0.23971376207139755, "x": 0.21824687167747964, "y": 0.6183438628268677}, {"x": 0.11077478883797728, "h": 0.013179613054874542, "w": 0.048575647142198364, "text": "Harry:", "y": 0.6357939143328786}, {"x": 0.15921288456073335, "w": 0.3381037394205729, "y": 0.6335319771208738, "h": 0.015174417977729072, "text": "Yes, they' From about 12 o'clock until 3."}, {"text": "Then we can relax.", "x": 0.17173524506676516, "h": 0.010116278651819414, "y": 0.6499709304836833, "w": 0.13059033711751303}, {"y": 0.6662409747320119, "text": "Cheryl: What time", "x": 0.11270125879962196, "w": 0.16815741644965282, "h": 0.012955776173285189}, {"text": "the restaurant close?", "w": 0.16636850992838537, "h": 0.010116278651819317, "x": 0.27906976730772154, "y": 0.6676744188557764}, {"text": "Harry:", "x": 0.10936266221619867, "y": 0.6844563553199442, "w": 0.04917969173855252, "h": 0.014855687162075666}, {"text": "At 5, but we work until 6. Here's Mr Parkin now.", "x": 0.16994633137408818, "y": 0.6853779072750666, "h": 0.011485811295492138, "w": 0.32737030029296876}, {"text": "you want me to tell him you're here?", "x": 0.22003577441269903, "y": 0.699219314106435, "h": 0.011449290415009824, "w": 0.2576028611924913}, {"x": 0.10912343562300256, "w": 0.37388193766276046, "y": 0.7168862818813871, "h": 0.014133574007220224, "text": "Cheryl: Just let me finish my coffee! Right. I'm ready."}, {"x": 0.22536698236987135, "w": 0.07699412027994795, "y": 0.7307801015912662, "h": 0.011622936639544763, "text": "1 look OK?"}, {"h": 0.014370302637561547, "y": 0.05169753232247984, "w": 0.3437621053059896, "x": 0.5436810947626292, "text": "3 * * Use the words in brackets to complete"}, {"text": "the questions and short answers.", "y": 0.06828488397710168, "w": 0.24508049858940972, "h": 0.01141276953452761, "x": 0.5652951751835299}, {"y": 0.08715703979779309, "w": 0.11627906799316412, "h": 0.011476681262577447, "text": "Conversation 1", "x": 0.5670840795111217}, {"y": 0.10622093049211356, "text": "Neil:", "h": 0.010116278651819317, "w": 0.03756708357069227, "x": 0.5635062610590189}, {"x": 0.6118067997392844, "y": 0.10622093062022916, "text": "Does Jenny like (Jenny/like) music?", "w": 0.24508049858940972, "h": 0.0127366508903917}, {"w": 0.035778172810872366, "x": 0.5635062626873316, "y": 0.12013081410826808, "text": "Will:", "h": 0.010116278651819317}, {"h": 0.012645348314774147, "text": "- (yes/do). We listen to my", "x": 0.7549194990211867, "w": 0.1753130594889324, "y": 0.12013081408825244}, {"x": 0.6118067987631572, "y": 0.1338763539346989, "h": 0.011545157445466945, "w": 0.11449016147189661, "text": "CDs all the time."}, {"w": 0.03756708357069227, "y": 0.14795058158528268, "x": 0.563506261703026, "text": "Neil:", "h": 0.01138081348329678}, {"y": 0.14668604675266075, "h": 0.0075872089888644875, "text": "2", "x": 0.6082289805511802, "w": 0.012522360483805395}, {"h": 0.011444725211346617, "y": 0.1479505817094781, "w": 0.1466905212402344, "x": 0.7584973135748739, "text": "_(what/she/do) at the"}, {"x": 0.6099522590982216, "y": 0.16164013343201997, "text": "weekend?", "w": 0.0752654266357422, "h": 0.01182147750785641}, {"h": 0.012677304366004975, "y": 0.17577034913004028, "w": 0.3363148328993055, "text": "I play football and she watches. She loves football.", "x": 0.6064400748741398}, {"w": 0.1395348782009549, "text": "(she/go) shopping?", "y": 0.190803248926098, "h": 0.012955776173285286, "x": 0.7602862293252828}, {"w": 0.1466905212402344, "h": 0.012645348314774147, "x": 0.760286225963067, "y": 0.20485465158207514, "text": "(no/not). That's lucky"}, {"x": 0.6118068009618052, "w": 0.17710196601019967, "h": 0.011467550855250933, "y": 0.21867779773105583, "text": "because I hate shopping."}, {"w": 0.12164579603407122, "h": 0.010303448257893895, "x": 0.5617173512137336, "y": 0.23899709330810195, "text": "Conversation 2"}, {"w": 0.05724508073594836, "h": 0.013909883895075253, "y": 0.25543604628229516, "x": 0.5617173530130634, "text": "Sally: 1"}, {"x": 0.7602862273425853, "text": "(you and Will/like) the same", "y": 0.25670058178301985, "w": 0.19499104817708335, "h": 0.012645348314774242}, {"w": 0.10375670539008253, "text": "kind of music?", "x": 0.6082289816520071, "h": 0.011403639127201192, "y": 0.26932310468148934}, {"h": 0.013909883895075253, "text": "Jenny:?", "w": 0.05724508073594836, "x": 0.5617173526552817, "y": 0.28325581372731706}, {"w": 0.05903398725721576, "x": 0.5599284451236282, "text": "Sally: 3", "y": 0.3109386280198002, "h": 0.014133574007220224}, {"w": 0.17710196601019967, "text": "(no/we/not). He plays his", "x": 0.7584973160557231, "h": 0.012677304366005072, "y": 0.2845203491616536}, {"y": 0.2983754510293818, "w": 0.22361358642578122, "x": 0.6082289877575924, "text": "CDs all the time. They're awful!", "h": 0.012700130009909388}, {"text": "(what/you/do) at the", "y": 0.31234011612877055, "x": 0.7584973157353286, "w": 0.144901614718967, "h": 0.013909883895075253}, {"x": 0.608228980870621, "w": 0.07334526062011726, "h": 0.010116278651819317, "text": "weekend?", "y": 0.3262500003775787}, {"w": 0.37388193766276046, "x": 0.5599284445675463, "y": 0.33999097445537907, "h": 0.014133574007220224, "text": "Jenny: I watch Will play football, but it's really boring."}, {"x": 0.5597176748863236, "text": "Sally: 4", "y": 0.3535598575656587, "w": 0.059455528259277246, "h": 0.013665168311191361}, {"x": 0.5599284438299983, "w": 0.05724508073594836, "h": 0.012645348314774242, "text": "Jenny:", "y": 0.3679796513186303}, {"y": 0.3553023465861495, "w": 0.1466905212402344, "text": "(you/like) shopping?", "h": 0.012677304366004975, "x": 0.7567084051759472}, {"w": 0.17531305948893228, "text": "(yes/do). I love it but Will", "x": 0.7567084054523139, "h": 0.01275491095622089, "y": 0.3692441863393426}, {"y": 0.3831540700286594, "h": 0.012645348314774242, "x": 0.6082289870371178, "w": 0.2737030368381077, "text": "hates shopping, so I never go with him."}, {"y": 0.40591569779570624, "h": 0.01138081348329678, "x": 0.5348837207488508, "w": 0.012522361543443439, "text": "4"}, {"x": 0.6010733457536127, "text": "* Look at the underlined words in the answers", "y": 0.40712545140446166, "h": 0.009029783393501934, "w": 0.3452593994140625}, {"h": 0.011554287852793362, "y": 0.42109011653524114, "text": "and complete the questions.", "x": 0.5599284524297353, "w": 0.21109122382269963}, {"text": "Where do you go in the evening?", "y": 0.4387936049485099, "h": 0.012695564431834358, "x": 0.5831842588254255, "w": 0.23434704250759542}, {"h": 0.012681869195256362, "y": 0.4526669677275378, "x": 0.5796064419467291, "text": "I go to the cinema.", "w": 0.1359570651584202}, {"y": 0.46661337242340456, "w": 0.008944543202718092, "x": 0.5599284440515927, "h": 0.008851743820341854, "text": "1"}, {"h": 0.012955776173285286, "text": "is your favourite sport?", "x": 0.6726296944420375, "y": 0.46523014426367976, "w": 0.16100179036458329}, {"h": 0.008851743820341951, "y": 0.49443313962921853, "x": 0.5599284438727017, "text": "2", "w": 0.008944543202718203}, {"y": 0.4805232559007545, "h": 0.013909883895075253, "x": 0.5813953499686321, "w": 0.21466905381944434, "text": "Volleyball is my favourite sport"}, {"text": "friends do you have at school?", "x": 0.6726296996088753, "y": 0.49428249106019395, "w": 0.21288013034396702, "h": 0.011531462208889044}, {"y": 0.5083430235170315, "h": 0.012645348314774147, "w": 0.21109122382269974, "text": "I have many friends at school.", "x": 0.5796064474446428}, {"h": 0.010116278651819317, "y": 0.5222529070592647, "x": 0.5581395351696035, "w": 0.010733451843261799, "text": "3"}, {"y": 0.5221570397572206, "h": 0.012741215719643087, "text": "do you wake up in the morning?", "x": 0.6744186126677995, "w": 0.22540249294704862}, {"x": 0.5813953496278152, "text": "I wake up at seven o'clock.", "h": 0.012690999602582971, "y": 0.5361627907481362, "w": 0.18783542209201398}, {"y": 0.5513372094101369, "x": 0.5563506259366863, "w": 0.012522361543443439, "h": 0.010116278651819317, "text": "4"}, {"text": "do you do at the weekend?", "h": 0.011508636939396454, "x": 0.6744186032693881, "w": 0.18962432861328127, "y": 0.5512093862235818}, {"w": 0.20393559773763026, "y": 0.5652470932633977, "x": 0.5796064425444228, "h": 0.012659043551352046, "text": "I spend time with my friends."}, {"y": 0.579156977121542, "text": "5", "w": 0.012522361543443439, "x": 0.5563506260932156, "h": 0.01138081348329678}, {"x": 0.6654740669088847, "text": "of music do you listen to?", "w": 0.18246868557400175, "y": 0.5790839347823409, "h": 0.014133574007220224}, {"y": 0.5909937340240256, "w": 0.21193910386827264, "h": 0.0176035735925613, "x": 0.579192065007564, "text": "I listen to rock and pop music."}, {"y": 0.606976744226416, "w": 0.010733451843261799, "text": "6", "x": 0.5563506264337656, "h": 0.010116278651819317}, {"h": 0.011485811295492138, "text": "video games?", "x": 0.6708407878608924, "y": 0.6081362815558946, "w": 0.09838997734917543}, {"x": 0.5813953591615576, "text": "No, I don't play video games - I don't like them!", "w": 0.33631483289930564, "h": 0.012681869195256362, "y": 0.6221511629676129}, {"x": 0.5563506260709115, "h": 0.008851743820341951, "y": 0.6360610466312535, "w": 0.010733452902899843, "text": "7"}, {"y": 0.6360108300081244, "x": 0.6618962442989064, "h": 0.012695565180658001, "text": "_ plays the guitar?", "w": 0.1252236090766059}, {"text": "Jason plays the guitar.", "x": 0.5778175354988477, "y": 0.6512354654040639, "w": 0.15742396036783857, "h": 0.011472115684502416}, {"y": 0.681552346572673, "text": "SHOW WHAT YOU'VE LEARNT", "x": 0.5438282645645184, "h": 0.01141276953452761, "w": 0.24686940511067712}, {"text": "5 Complete the dialogue with the correct form of", "y": 0.706875000086801, "x": 0.5366726367161491, "w": 0.3631484646267361, "h": 0.013937274368231051}, {"h": 0.010234971700592671, "y": 0.7207848838982908, "text": "the words from the box. There are two extra sets", "x": 0.5563506323350597, "w": 0.35420393202039935}, {"y": 0.7343800549011488, "h": 0.012010238738696907, "text": "of words.", "x":
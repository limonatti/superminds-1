[{"y":0.023155417197336381,"x":0.061728400766134922,"w":0.47119340684678812,"h":0.059693418829182776,"text":"WORK OR"},{"x":0.059539268125307195,"w":0.39738237169053819,"text":"HOBBY?","y":0.086799293411084832,"h":0.064773505673490828},{"y":0.1306907374649755,"text":"(1) 2.9","w":0.047325100368923623,"x":0.47736625699146412,"h":0.014658099253847645},{"x":0.057613174131743425,"text":"Can you really earn your living by eating ice cream,","w":0.48765431722005209,"h":0.017441860360665085,"y":0.15697674402024886},{"text":"building with Lego or walking a dog? Yes, you can!","w":0.47325103759765624,"x":0.057613161370925037,"y":0.17582417586127308,"h":0.017660910518053408},{"h":0.018995746151431514,"w":0.16460905287000868,"y":0.20784883753478056,"text":"PET SITTER","x":0.078189299696682923},{"x":0.078189298197056653,"h":0.017441860360665085,"y":0.23110465104059774,"w":0.36213992648654514,"text":"Monica looks after other people's dogs."},{"x":0.078189311675347331,"h":0.013081394896215404,"w":0.40123453776041668,"text":"When people spend many hours at work, or when they","y":0.25145348838038073},{"x":0.080246911698616002,"text":"are going away, they phone our company. We look","w":0.37654320610894099,"y":0.26726844549474404,"h":0.013343799058084693},{"x":0.07818929393004137,"h":0.013343799058084804,"w":0.3888888888888889,"y":0.28178963867440832,"text":"after the dog for them. I go to the customer's house."},{"w":0.39300411648220485,"text":"First I talk to the dog, and when it knows me and isn't","x":0.078189293233520585,"y":0.29651162815751253,"h":0.013143002706195284},{"x":0.067901227333582559,"text":"5 afraid, I take it for a walk. I play with it and give it food","h":0.013129312164929408,"y":0.31104651192689237,"w":0.40946502685546871},{"text":"I don't earn a lot, but I like the job because I like","y":0.32994186044179385,"x":0.078189300810948686,"w":0.35390947129991313,"h":0.011627906907110019},{"y":0.34447674432151443,"x":0.080246919594344684,"w":0.38065843370225694,"h":0.013081394896215293,"text":"dogs. I have three myself. I understand them, I know"},{"w":0.36213989257812496,"text":"how to take care of them and communicate with","x":0.078189311049757876,"y":0.35901162813559229,"h":0.011627906907110019},{"text":"them. Meeting a new dog is interesting to me, almost","w":0.39506171332465279,"y":0.37354651176337494,"x":0.078189312884998627,"h":0.013081394896215293},{"h":0.01162790690711013,"y":0.3895348837557473,"text":"10 like meeting a person. And I also meet people - my","x":0.061728388841869319,"w":0.39711934407552085},{"w":0.19341562906901044,"text":"favourite kind: dog lovers!","x":0.078189307224753993,"h":0.011627906907110019,"y":0.40406976736766598},{"h":0.018895348349770469,"text":"ICE CREAM TASTER","x":0.076131685915999586,"y":0.44622093054895196,"w":0.27366255018446184},{"text":"Paul tastes ice cream for a living.","x":0.078189299668611684,"y":0.47093023237526666,"w":0.30246914333767361,"h":0.016118432887869183},{"text":"I like my job, but it's not the same as eating ice cream","y":0.48979591799492705,"w":0.3971193440755208,"h":0.013111058359430605,"x":0.078189296557918661},{"x":0.080246916664322321,"text":"on the beach! I'm responsible for the quality of our","h":0.01312474890069637,"w":0.37654320610894093,"y":0.5043171111200857},{"x":0.080246906676593274,"w":0.39300411648220485,"h":0.011627906907110019,"y":0.52034883743791782,"text":"product. I need to know the small difference between"},{"w":0.40782402886284719,"text":"15 'good' and 'amazing' ice cream. When I come to the","y":0.53049999949686089,"h":0.019605546768643678,"x":0.061492237945916677},{"text":"factory, thirty samples are waiting for me in a fridge.","x":0.078189313461491938,"w":0.39094648573133683,"y":0.54941860485930516,"h":0.013081394896215293},{"w":0.37448557535807292,"x":0.078189315767465489,"y":0.56540697690728692,"text":"I take them out and wait: I can taste the ice cream","h":0.010338706161762579},{"text":"better when it's not too cold. I always use a gold spoon.","w":0.41563785129123265,"y":0.57994186045148377,"x":0.080246924903080288,"h":0.011627906907110019},{"h":0.011627906907110019,"w":0.4012345716688368,"x":0.080246915708791403,"text":"Other metals change the taste. My personal favourites","y":0.594476744162724},{"h":0.013081394896215293,"x":0.059670778667333856,"text":"20 are mango in the summer, chocolate in winter and","y":0.60901162829680511,"w":0.3930041164822049},{"x":0.078189307332055286,"w":0.36831275092230908,"text":"vanilla at any time! I enjoy the work, I earn a good","h":0.013081394896215293,"y":0.62354651201773537},{"h":0.013081394896215293,"text":"salary, but on some days I think: I never want to eat","x":0.078189301290160967,"y":0.63808139579317147,"w":0.38065843370225694},{"y":0.65261627920523524,"text":"another spoonful of ice cream in my life!","h":0.013081394896215404,"w":0.29835391574435766,"x":0.080246914170002154},{"y":0.44466248023781318,"text":"LEGO® MODEL BUILDER","x":0.54115227513035191,"w":0.32716047498914935,"h":0.019000310164231538},{"w":0.39506171332465279,"x":0.54115227486030726,"h":0.016118432887869183,"y":0.47093023237526666,"text":"Tom gets paid for building with Lego bricks."},{"w":0.39506171332465279,"x":0.54115226432532815,"h":0.013111058359430494,"text":"Some people don't believe me when I tell them what","y":0.4897959182311189},{"h":0.013124748900696481,"text":"25 | do. They ask, 'They pay you to play with Lego?' Well,","y":0.50431711117459144,"w":0.40946502685546871,"x":0.52469135285312984},{"text":"almost. But I can't build what I like. When we are","y":0.52034883737240323,"w":0.35802469889322919,"h":0.010263407436233107,"x":0.54320987725091618},{"x":0.54115226362880742,"y":0.5348837212292179,"text":"working on a model - it can be a castle, a helicopter,","h":0.013081394896215293,"w":0.39917694091796874},{"y":0.54941860463753023,"h":0.011805885066417221,"x":0.5432098869401174,"text":"a dinosaur - the Master Builder makes the plans","w":0.36008229573567707},{"w":0.34773661295572911,"y":0.56395348838038073,"x":0.54320988758935063,"h":0.013081394896215293,"text":"and the team puts the model together. It's fun,"},{"x":0.52263374836348775,"w":0.4300411309136285,"h":0.011627906907110019,"text":"30 l earn enough, but it's also quite demanding. The most","y":0.57994186054838293},{"w":0.384773661295573,"text":"difficult part is moving the models - they can break","h":0.013081394896215293,"x":0.54320987647669916,"y":0.59447674457587485},{"h":0.011627906907110019,"y":0.6090116278448946,"w":0.38065843370225694,"text":"and then we have extra work. My favourite project?","x":0.54320988414338434},{"x":0.54320988757816524,"w":0.37448557535807292,"h":0.013081394896215293,"y":0.62354651201773537,"text":"A three-metre model of Big Ben in London: 61,200"},{"w":0.40534979926215275,"h":0.01162790690711013,"text":"bricks! My ambition is to become a Master Builder and","x":0.54320987740938997,"y":0.63808139531097985},{"text":"35 work on my own ideas.","h":0.013081394896215293,"y":0.65261627907805519,"x":0.52469136483142564,"w":0.18930040147569449},{"w":0.024691357082790799,"h":0.013081394896215293,"x":0.90740740792979802,"y":0.95494186052790986,"text":"41"}]
[{"text": "REMEMBER BETTER", "x": 0.12522361274068544, "h": 0.011531462208889044, "w": 0.15921288384331594, "y": 0.05928249098906385}, {"x": 0.1234347076911043, "h": 0.012645348314774147, "text": "When you learn related parts of speech, you can talk", "y": 0.08472383747051992, "w": 0.3631484646267361}, {"w": 0.3154712931315104, "text": "about the same subject using different words.", "x": 0.1249295678227174, "h": 0.018210224124068412, "y": 0.09539023601496698}, {"w": 0.3649373711480035, "x": 0.12522361603601634, "y": 0.1188662789616193, "text": "Our school basketball team is usually very successful.", "h": 0.013909883895075349}, {"text": "We don't always succeed in competitions but we have", "w": 0.3724806043836806, "h": 0.016081659070851604, "x": 0.12499968736539359, "y": 0.13201248689930234}, {"w": 0.19677995469835072, "h": 0.010266927377411679, "text": "more successes than failures.", "x": 0.125223616389644, "y": 0.14795058165490424}, {"w": 0.3580076768663194, "x": 0.12332872873152925, "text": "A Complete the table with the underlined words", "y": 0.17285525660368015, "h": 0.013388509406079442}, {"text": "in the text. Two of the words are not in the text.", "y": 0.1868667048128596, "w": 0.35279605441623263, "h": 0.014278071520560973, "x": 0.14472482311066515}, {"w": 0.31305901421440974, "h": 0.012955776173285286, "text": "Use a dictionary, if necessary, to find them.", "x": 0.1466905338886209, "y": 0.2021886278352913}, {"y": 0.2388713230548846, "text": "Adjective", "x": 0.1627454510850439, "w": 0.0698579364352756, "h": 0.012896888677824327}, {"text": "Noun", "x": 0.3023255821156183, "y": 0.24026162815305577, "w": 0.039355990091959614, "h": 0.008851743820341854}, {"x": 0.4114093194259062, "text": "Verb", "y": 0.24019906650395853, "w": 0.035857569376627596, "h": 0.01150593668114831}, {"x": 0.1627906987819513, "text": "successtu", "h": 0.010116278651819317, "w": 0.06797853257921008, "y": 0.2668168605792502}, {"text": "2 =", "x": 0.1341681571114935, "y": 0.2908430232
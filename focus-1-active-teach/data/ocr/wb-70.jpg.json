29199219, "h": 0.01141276953452761, "y": 0.5032848839402193, "text": "B Alex is very ambitious and he wants to"}, {"text": "in everything he does.", "y": 0.5183638156917908, "x": 0.2555892277896204, "w": 0.15783153957790802, "h": 0.01352561827601076}, {"y": 0.5412209304044273, "w": 0.09481216430664063, "h": 0.011558853056456667, "text": "2 EDUCATE", "x": 0.13595706700333698}, {"x": 0.13595706603060384, "w": 0.012522361543443467, "text": "A", "h": 0.010116278651819317, "y": 0.5589244186871718}, {"x": 0.2576028631657212, "text": "should be free for all students", "y": 0.5589244186500668, "w": 0.20572450425889754, "h": 0.011522332175974353}, {"y": 0.5738028549565065, "w": 0.08959253946940104, "h": 0.011972777710064239, "x": 0.15735042042380257, "text": "at university."}, {"h": 0.01426321485843044, "x": 0.13753951191452507, "y": 0.5873681373844912, "text": "B They don't go to school. Their parents", "w": 0.28479536268446176}, {"y": 0.6030324910182655, "x": 0.2558139551496711, "w": 0.10196779886881513, "h": 0.010266927377411581, "text": "them at home."}, {"x": 0.13563023586586204, "h": 0.013534619885661486, "text": "C There are many", "y": 0.615170057016105, "w": 0.13126260545518664}, {"x": 0.36493738753523086, "w": 0.1377459716796875, "h": 0.010207581227436775, "text": "videos on YouTube.", "y": 0.6183438627796704}, {"w": 0.20475994533962674, "x": 0.15699726280071932, "text": "You can learn about anything!", "y": 0.6279600652080596, "h": 0.01680479137475745}, {"y": 0.6448676742680034, "x": 0.134061042426086, "w": 0.3329499308268229, "h": 0.015422712190056562, "text": "D My mum likes my new boyfriend. He's polite,"}, {"h": 0.00902978339350174, "y": 0.6599593863824145, "w": 0.10912343343098957, "text": "smart and well-", "x": 0.1556350650674509}, {"h": 0.011499506532070037, "text": "3 IMAGINE", "y": 0.6827301442533648, "w": 0.09302324930826822, "x": 0.13237925079309312}, {"x": 0.1337880612590375, "text": "A You've got a great", "h": 0.014036252386733528, "w": 0.1509138488769531, "y": 0.699950032057316}, {"text": "write children's books.", "y": 0.7157084836225187, "h": 0.010207581227436872, "x": 0.1538461608226893, "w": 0.15563505384657114}, {"x": 0.13416815938021182, "y": 0.7294494583038463, "w": 0.10912343343098957, "h": 0.011567983463783082, "text": "B This is a very"}, {"text": "Well done, Katy!", "x": 0.1520572448048491, "h": 0.012645348314774147, "y": 0.7435465119144152, "w": 0.11627906799316406}, {"x": 0.3828264799257009, "text": ". You should", "w": 0.08586761474609378, "y": 0.703081395452656, "h": 0.008851743820341951}, {"h": 0.014505381446452715, "x": 0.3432794891833494, "text": "piece of writing.", "y": 0.7287066113887435, "w": 0.11487214830186632}, {"x": 0.13232521012625525, "w": 0.07345333523220485, "text": "4 AGREE", "y": 0.7673434102945811, "h": 0.009310272531819302}, {"x": 0.13237925013623542, "h": 0.009029783393501837, "y": 0.7851985559456954, "w": 0.028622538248697926, "text": "A 1"}, {"y": 0.785030815149506, "x": 0.26101252953208953, "h": 0.013276763943558636, "w": 0.19892725626627605, "text": "with you about school sports."}, {"x": 0.1520572397607685, "y": 0.7991860466044636, "text": "I can't see why all students should do some kind of", "w": 0.3452593994140625, "h": 0.011531462583300867}, {"y": 0.8156250001567306, "x": 0.15384615583471947, "h": 0.0075872089888644875, "w": 0.0590339872572157, "text": "exercise."}, {"text": "B I don't think young pupils should get homework.", "w": 0.3542039320203993, "x": 0.13237925635115977, "y": 0.8282703490984269, "h": 0.012677304366005072}, {"text": "Do you", "x": 0.15377393393749983, "h": 0.011690528461649082, "y": 0.8420253754453082, "w": 0.048444976806640616}, {"y": 0.8560901167510432, "x": 0.13059034327006555, "text": "C My parents and I often have a", "h": 0.012732085312316574, "w": 0.22540249294704864}, {"y": 0.8586191861711835, "w": 0.04472271813286677, "text": "about", "x": 0.45617173552211765, "h": 0.010116278651819317}, {"text": "3 Look at the sentences from the text and choose the", "y": 0.055639535106171444, "w": 0.3899820963541666, "h": 0.011494941328406732, "x": 0.5545617285313245}, {"y": 0.0706678701636028, "h": 0.011526897005225837, "text": "correct meaning (A or B) of the underlined expressions", "w": 0.3881931898328993, "x": 0.5778175413447311}, {"text": "1 Los Altos, California, is a city in an area known as", "x": 0.5706619013040051, "y": 0.08978197700540365, "h": 0.012686434773331489, "w": 0.3667262776692708}, {"y": 0.10306049368258927, "text": "'Silicon Valley'", "h": 0.013908081476438829, "w": 0.10226632859971796, "x": 0.5973462642713682}, {"text": "A Some people call the area 'Silicon Valley'.", "x": 0.6010733580604546, "w": 0.30948120117187505, "y": 0.1176017444894152, "h": 0.012741215719643087}, {"x": 0.5992844550548414, "y": 0.13151162821034545, "w": 0.3184257337782118, "h": 0.012645348314774147, "text": "B The area is officially named 'Silicon Valley'."}, {"w": 0.017889086405436294, "text": "2", "x": 0.5706618968092079, "y": 0.14542151166827638, "h": 0.010116278651819317}, {"h": 0.011531462208888949, "w": 0.3685151841905382, "x": 0.593917714821845, "y": 0.14668604680995054, "text": "... it is home to many technology companies such as"}, {"y": 0.15933139512266586, "h": 0.013909883895075253, "x": 0.5974955312077911, "w": 0.30769229465060766, "text": "Google, Apple, Yahoo and Hewlett-Packard."}, {"text": "A ... there are a number of technology companies", "w": 0.35420393202039924, "x": 0.5992844428747137, "h": 0.012955776173285189, "y": 0.174314079615724}, {"h": 0.016454198110835268, "y": 0.18550706944046638, "text": "in the area. Four of these are Google, Apple,", "x": 0.6187725987508882, "w": 0.3153661431206597}, {"y": 0.20218862811530852, "x": 0.6207513508749851, "w": 0.19856886121961803, "h": 0.010253232140833683, "text": "Yahoo and Hewlett-Packard."}, {"w": 0.3398926459418402, "y": 0.21623546558825246, "text": "B ... there are four technology companies in the", "x": 0.5974955404757106, "h": 0.012649913144025533}, {"y": 0.23006317714089178, "x": 0.6207513605089555, "w": 0.3452593655056424, "text": "area: Google, Apple, Yahoo and Hewlett-Packard.", "h": 0.01272752048306509}, {"w": 0.35062611897786455, "x": 0.5688729905289568, "text": "3 The Waldorf School of the Peninsula is a bit of", "y": 0.24405523289689138, "h": 0.015174417977728975}, {"w": 0.07339285956488717, "h": 0.011534908295538543, "x": 0.5938939110272329, "text": "a surprise.", "y": 0.2591526037590666}, {"text": "A The school is different to how people expect", "x": 0.597495538551042, "y": 0.2718750002190664, "h": 0.012759476534296018, "w": 0.33273701985677084}, {"text": "it to be.", "y": 0.28495154876819734, "w": 0.06133470747205949, "h": 0.011782949031044784, "x": 0.6151287116776317}, {"w": 0.33136260986328125, "y": 0.2981184697958531, "h": 0.015978561024373228, "text": "B The school is similar to the local companies.", "x": 0.5937088049396877}, {"w": 0.20572450425889754, "h": 0.01146755085525103, "text": "4 It's difficult to say for sure.", "y": 0.313604651418962, "x": 0.5706619015676293}, {"x": 0.5954036391497375, "w": 0.2367087809244791, "text": "A The writer doesn't want to say.", "y": 0.32571056900199896, "h": 0.01469244060103221}, {"h": 0.01270013000990929, "text": "B The writer doesn't really know.", "x": 0.5957066259327957, "y": 0.3414244188342554, "w": 0.23613594902886292}, {"h": 0.014394769703007817, "x": 0.5472984889845222, "text": "4 Complete the sentences with one of the phrases from", "w": 0.41166032579210077, "y": 0.36034919675532096}, {"y": 0.37377875022864576, "w": 0.16720747205946185, "x": 0.5702386088322493, "h": 0.015131958176513033, "text": "Exercise 3 in each gap."}, {"h": 0.013970907035717475, "y": 0.39241127510879337, "x": 0.5920169292507348, "text": "I'm known as Spiderman at school because I'm very", "w": 0.3562567138671875}, {"y": 0.40712545108545467, "h": 0.011435595178432022, "x": 0.5939177107293754, "text": "good at climbing in the gym.", "w": 0.20035778469509546}, {"y": 0.4210901163986953, "h": 0.008851743820341854, "x": 0.5688729880318576, "w": 0.010733451843261688, "text": "1"}, {"text": "I want to go to the party but I can't", "x": 0.5813953563758893, "w": 0.2540250311957465, "h": 0.012732085312316574, "y": 0.42109011675104313}, {"text": "that", "x": 0.9320214672935372, "w": 0.032200357649061484, "h": 0.010116278651819317, "y": 0.42361918620490424}, {"w": 0.2737030368381076, "h": 0.012645348314774147, "x": 0.5921288081462412, "y": 0.4350000003033688, "text": "I'm going. I have to ask my parents first."}, {"h": 0.011549722649130153, "x": 0.5670840788083559, "y": 0.44874097475857916, "text": "2 The end of this film is", "w": 0.173524152967665}, {"text": "but I can't tell", "y": 0.4514389537239134, "h": 0.008851743820341951, "w": 0.09481216430664052, "x": 0.8425760279689218}, {"y": 0.4628197674923222, "x": 0.5903398939221117, "text": "you what happens. Go and see it!", "w": 0.23434704250759553, "h": 0.012645348314774147}, {"h": 0.012759476534296018, "w": 0.304114481608073, "text": "3 We do a lot of different sports at school,", "x": 0.5688729968226777, "y": 0.4766155232887887}, {"h": 0.01515687004323469, "text": "football, cricket, volleyball and running.", "x": 0.5901010007688023, "y": 0.4905711942141683, "w": 0.2723464796278212}, {"text": "VOCABULARY PRACTICE | Phrasal verbs", "y": 0.5170532493793205, "h": 0.014133574007220224, "x": 0.5420393673519976, "w": 0.31127010769314234}, {"w": 0.4042933824327257, "h": 0.012690999602582876, "x": 0.5438282707991408, "text": "5 Look at the vocabulary in lesson 5.4 in the Students'", "y": 0.5386462093120716}, {"x": 0.5670840990769143, "y": 0.5526017444894152, "text": "Book. Complete the phrasal verbs in the sentences.", "w": 0.3738819037543403, "h": 0.012741215719643087}, {"text": "You can find out lots of interesting things online for", "w": 0.35062611897786455, "x": 0.5885509869511392, "y": 0.5703052327687756, "h": 0.012704694839160775}, {"h": 0.010230406496929367, "w": 0.1377459716796875, "x": 0.5885509872594407, "text": "your school project.", "y": 0.5853655235266548}, {"w": 0.36174350314670134, "text": "My friends know how to put a tent because they", "h": 0.017184823144644177, "x": 0.5883581481360154, "y": 0.6003226612009437}, {"text": "go camping a lot.", "x": 0.5885509859424158, "h": 0.011545157445466945, "y": 0.6158284885861133, "w": 0.12164579603407111}, {"x": 0.5648400480196377, "h": 0.01810843951435294, "y": 0.6259497774157413, "w": 0.21383409288194444, "text": "2 Jack's family has to move"}, {"y": 0.6287687837192726, "x": 0.7813556308889362, "text": "_ a lot because of his", "h": 0.013744548115919688, "w": 0.14731743706597222}, {"y": 0.6434702166600781, "w": 0.06797853257921005, "h": 0.012955776173285189, "x": 0.5867620756603055, "text": "dad's job."}, {"x": 0.5742397223244691, "w": 0.31484792073567713, "text": "Turn off the television so that you can focus", "h": 0.013909883895075253, "y": 0.6562936043902168}, {"w": 0.04293380737304686, "x": 0.908765654989684, "y": 0.6613517442898653, "text": "_ your", "h": 0.008851743820341854}, {"h": 0.010731509954060086, "text": "homework.", "y": 0.6711604077897548, "w": 0.07708041720920134, "x": 0.5866834059530892}, {"y": 0.6941155231791957, "w": 0.24508049858940972, "h": 0.012759476534296018, "x": 0.5384615420648659, "text": "WORD STORE 5E | Collocations"}, {"h": 0.013836276023396557, "w": 0.2205217488606771, "text": "6 Choose the correct option.", "y": 0.7143427378926708, "x": 0.5382398064215114}, {"w": 0.2844364929199218, "h": 0.01652569055557251, "x": 0.5635062639604326, "text": "DO YOU HAVE ANY PLANS", "y": 0.7624277977775851}, {"h": 0.019237364620938613, "x": 0.5617173549291075, "text": "FOR THE SUMMER", "y": 0.7863763540548985, "w": 0.24508049858940972}, {"text": "HOLIDAYS?", "w": 0.15940660264756945, "y": 0.8063856582814485, "x": 0.681477379346726, "h": 0.021007753072662984}, {"text": "Why don't you 'do / make a course?", "y": 0.835843862801577, "x": 0.5617173544296553, "w": 0.2504472181532118, "h": 0.011394509094286501}, {"w": 0.33273701985677084, "h": 0.012732086061140313, "text": "It's a great way to increase / improve your skills.", "y": 0.8560901164138337, "x": 0.5581395393023838}, {"w": 0.17901234944661457, "x": 0.15226337360488199, "y": 0.8704866560642973, "text": "going out with my friends.", "h": 0.011780785616001821}, {"w": 0.31687242296006946, "h": 0.013343799058084804, "x": 0.5596707852963712, "y": 0.8704866565574003, "text": "And it isn't boring! You can have / take part in"}, {"y": 0.8865777077716809, "w": 0.30864196777343755, "text": "interesting activities and make / get friends.", "x": 0.5596707884040906, "h": 0.013131594545612857}, {"h": 0.011773940345368938, "text": "Sometimes, you can win / take prizes too!", "x": 0.5596707910941519, "y": 0.9010989012322556, "w": 0.2921810574001735}, {"text": "65", "w": 0.0246913570827908, "x": 0.9176954735162178, "h": 0.013081394896215293, "y": 0.9462209303280551}]
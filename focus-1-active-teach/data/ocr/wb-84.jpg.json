[{"h": 0.031613371535759154, "w": 0.0661896218193902, "x": 0.1198568886105521, "text": "6.6", "y": 0.0657558140884233}, {"w": 0.16284503512912327, "text": "SPEAKING", "h": 0.01920216241898519, "x": 0.23431988073615465, "y": 0.04287711640337209}, {"text": "Advice", "x": 0.23251391356383155, "h": 0.011590755192381329, "y": 0.08335433178254067, "w": 0.053755713568793384}, {"x": 0.10543183750407031, "h": 0.01417731729225132, "y": 0.14665362451386071, "w": 0.35441819932725693, "text": "1 Translate the phrases into your own language."}, {"y": 0.17313628142944115, "x": 0.11270125485783063, "text": "SPEAKING BANK", "h": 0.01148581129549204, "w": 0.1377459716796875}, {"y": 0.19347383694835626, "w": 0.1252236090766059, "h": 0.013909883895075253, "x": 0.11270125422735001, "text": "Asking for advice"}, {"x": 0.11270125189971111, "w": 0.15205724080403646, "text": "Should I (see a doctor", "h": 0.011558853056456667, "y": 0.2149709302779737}, {"w": 0.11288381788465711, "x": 0.11082105968707108, "y": 0.22850162958461187, "text": "before I begin)?", "h": 0.014668252098000777}, {"h": 0.011403639127201192, "text": "What should I wear/do/", "y": 0.26302325608698535, "w": 0.16815741644965276, "x": 0.10912343678411819}, {"y": 0.27693313964269506, "w": 0.03398926628960504, "h": 0.010116278651819317, "x": 0.1091234349589542, "text": "eat?"}, {"h": 0.013174492598440765, "w": 0.09852348327636719, "text": "Giving advice", "y": 0.29690112583908773, "x": 0.10905668313768653}, {"w": 0.1270125240749783, "h": 0.011513201768647938, "x": 0.10912343475525296, "text": "You should (have a", "y": 0.3186627908876083}, {"h": 0.011380813483296684, "x": 0.1073345258397678, "text": "towel).", "y": 0.3325726745114403, "w": 0.050089446173773866}, {"text": "It's important to get", "w": 0.14220772637261284, "y": 0.3508492783268618, "x": 0.1086433455892, "h": 0.01569889858741617}, {"text": "enough to drink.", "y": 0.3654505818673223, "x": 0.10912343617748914, "w": 0.11806797451443142, "h": 0.01264534831477405}, {"w": 0.1502683342827691, "h": 0.011531462208889044, "text": "Make sure you always", "y": 0.3855324909969672, "x": 0.11091234636487658}, {"w": 0.159212883843316, "h": 0.012722955653813801, "y": 0.3983284886016973, "text": "bring a bottle of water.", "x": 0.10912343484488936}, {"w": 0.07334526062011719, "x": 0.10554561729280364, "h": 0.012649913892849272, "y": 0.4337354653016245, "text": "Just try it!"}, {"text": "You (really) shouldn't", "y": 0.4666133722783687, "w": 0.14669052124023435, "h": 0.012750346126969504, "x": 0.10554561741208318}, {"y": 0.481719313943322, "h": 0.010207581227436872, "w": 0.10733452690972221, "text": "worry so much.", "x": 0.1073345267955861}, {"x": 0.09660107089350725, "h": 0.012686434773331584, "text": "2 Look at the photo. Match the questions to the correct", "y": 0.524781977037017, "w": 0.4096601019965278}, {"text": "answers. There are two extra answers.", "x": 0.1196697207463907, "w": 0.2758597649468316, "y": 0.5390187646357913, "h": 0.013541540514260854}, {"h": 0.008851743820341854, "w": 0.008944543202718092, "y": 0.7372238373289278, "text": "1", "x": 0.1162790702292909}, {"y": 0.7372238376812756, "text": "Who are the people?", "x": 0.13774597444249462, "h": 0.012645348314774147, "w": 0.14669052124023438}, {"x": 0.11627907027693801, "w": 0.010733451843261715, "y": 0.7511337210340514, "h": 0.008851743820341951, "text": "2"}, {"w": 0.15921288384331597, "y": 0.7510424186055177, "x": 0.127012518521097, "h": 0.011472116058914237, "text": "What are they doing?"}, {"y": 0.7650436049020654, "h": 0.011517766972311145, "w": 0.18067977905273436, "text": "3 How is the girl feeling?", "x": 0.11449016188239852}, {"y": 0.7851985561085858, "x": 0.11270125024112233, "w": 0.3828264702690972, "h": 0.011458420447924517, "text": "a They are walking in the forest. I don't think it's a one-"}, {"h": 0.013909883895075349, "y": 0.7991860464697174, "x": 0.13595707241851504, "w": 0.3381037394205729, "text": "day walk because their backpacks are big and full."}, {"text": "b She is in pain, so she is thinking about that. Maybe", "y": 0.8117942736991379, "h": 0.014653413407639029, "w": 0.3597764078776042, "x": 0.11437065250390592}, {"h": 0.011572548293034468, "text": "she is worried that she can't get home.", "y": 0.8268140793999221, "x": 0.13595707331778795, "w": 0.26118067423502606}, {"h": 0.014454674849871698, "x": 0.11262798667999782, "text": "c Perhaps it isn't so serious and she can get up and walk", "w": 0.37760386149088543, "y": 0.8395277450299181}, {"y": 0.8535108304349371, "h": 0.010207581227436775, "w": 0.11270124647352431, "text": "in a few minutes.", "x": 0.1341681593810077}, {"h": 0.012955776173285189, "y": 0.05928249069609719, "x": 0.5438282750812635, "w": 0.3846153767903645, "text": "3 Complete the dialogue between the people in the"}, {"y": 0.07334302330627566, "h": 0.012645348314774242, "text": "photo with one letter in each space. The first letters", "x": 0.5670840858795878, "w": 0.3720929972330729}, {"x": 0.5670487486391995, "text": "are given.", "h": 0.011604650364886133, "y": 0.08714098858136692, "w": 0.07162701076931421}, {"y": 0.10748546548287459, "x": 0.5652951726595402, "w": 0.16636850992838537, "h": 0.012649913892849175, "text": "Ellen: Are you OK, Liz?"}, {"text": "Liz:", "h": 0.010116278651819317, "x": 0.5670840789841132, "w": 0.030411449008517777, "y": 0.12139534921478802}, {"w": 0.1252236090766059, "y": 0.12131317695143418, "x": 0.6118067985475646, "h": 0.011462985651587725, "text": "I think so. Owww!"}, {"y": 0.13500915553178158, "text": "Max:", "w": 0.03791879865858294, "x": 0.5633304037297447, "h": 0.011972968285694831}, {"x": 0.6010733471758692, "text": "You shou!dn't try to stand up on your own.", "w": 0.3363148328993055, "y": 0.13530523281935714, "h": 0.012704694839160775}, {"y": 0.14918772558989482, "w": 0.03577817281087248, "h": 0.010207581227436775, "x": 0.6135957082278374, "text": "It's li"}, {"y": 0.15036552328374259, "w": 0.28801428900824655, "text": "-_-____tto be careful. In fact,", "x": 0.6511627970283753, "h": 0.011494941702818553}, {"h": 0.01138081348329678, "text": "don't stand up at all at the moment.", "x": 0.615384615933381, "y": 0.16312500037735597, "w": 0.24508049858940972}, {"x": 0.5635062621182662, "text": "Ellen: 2S", "w": 0.06797853257921005, "h": 0.011499506532070037, "y": 0.17577034900907837}, {"x": 0.649373881256061, "h": 0.012645348314774147, "y": 0.1770348841086013, "w": 0.20572450425889754, "text": "— __d I phone your mum?"}, {"y": 0.1909447675966402, "x": 0.5635062612510304, "h": 0.010116278651819317, "text": "Liz:", "w": 0.026833631727430474}, {"text": "No, don't. She always worries a lot about me.", "x": 0.6135957196369812, "y": 0.19080324901040038, "w": 0.31305901421440974, "h": 0.012955776173285189}, {"y": 0.20359011675104313, "text": "I'm fine. I just need a rest.", "x": 0.6135957070068263, "h": 0.012732085312316574, "w": 0.17710196601019956}, {"text": "Max:", "y": 0.2175000001876757, "x": 0.5617173544530114, "w": 0.04293380737304686, "h": 0.01138081348329678}, {"h": 0.013909883895075253, "y": 0.2174999999287342, "text": "You should 3r _ _ _ _ y go to the hospital", "x": 0.6028622463445196, "w": 0.3184257676866319}, {"y": 0.2326744188237176, "h": 0.012700130009909388, "text": "and get an X-ray. I don't think it's broken but you", "x": 0.6118068070405576, "w": 0.33452592637803813}, {"w": 0.31305901421440974, "x": 0.6135957187425267, "h": 0.01264534831477405, "text": "should know exactly what's wrong. You should", "y": 0.24531976763081895}, {"x": 0.6118067916589414, "text": "*a__o put a bandage on it to protect it.", "y": 0.25793772548701, "h": 0.013937274368231051, "w": 0.2951699490017361}, {"x": 0.6118068036154651, "h": 0.01023040649692927, "y": 0.2744040699764159, "w": 0.31484792073567713, "text": "I've got one here in my backpack somewhere."}, {"w": 0.028622538248697982, "x": 0.5635062626585967, "y": 0.28704941872427675, "text": "Liz:", "h": 0.008851743820341951}, {"h": 0.010116278651819317, "w": 0.03935599009195967, "text": "Max:", "x": 0.5599284454191366, "y": 0.30095930248397407}, {"x": 0.6118068038275001, "y": 0.28578488406600466, "h": 0.015338762314310962, "w": 0.31305901421440974, "text": "OK. SW__t should I do? Take off my boot?"}, {"y": 0.30095930253621755, "h": 0.012727520483065188, "w": 0.30232557508680546, "text": "Yes, then we can put the bandage on it ... It", "x": 0.6118068040308369}, {"x": 0.6118068062720216, "text": "doesn't look very bad. Tell me if I'm hurting you.", "y": 0.3148646209404099, "h": 0.01264991389284937, "w": 0.33094811333550345}, {"y": 0.32877906989760514, "x": 0.56171735243986, "h": 0.008851743820341951, "text": "Liz:", "w": 0.02504472308688699}, {"text": "Max:", "y": 0.34268895365014884, "w": 0.03756708357069227, "h": 0.008851743820341951, "x": 0.5617173532951547}, {"y": 0.3282377539560342, "h": 0.011198910728688732, "text": "No, it's fine.", "w": 0.08254258897569444, "x": 0.6116804039462027}, {"text": "Let's have a rest and see how you feel in ten", "h": 0.011435594804020104, "w": 0.2987477620442708, "x": 0.6118068002614067, "y": 0.34268895386572806}, {"h": 0.01044617592642882, "w": 0.060931133694118955, "x": 0.6117526794278967, "y": 0.3564338886091347, "text": "minutes."}, {"y": 0.3692441864240903, "h": 0.010116278651819317, "x": 0.5617173528835914, "w": 0.041144900851779465, "text": "Ellen:"}, {"text": "And 'm_e s__e that you don't fall over", "w": 0.3381037394205729, "x": 0.6028622584053964, "h": 0.014133574007220224, "y": 0.3678655233731885}, {"h": 0.011324333456018845, "y": 0.3841839238415904, "text": "again!", "x": 0.6078630799419146, "w": 0.047526825798882455}, {"y": 0.3970639536130438, "x": 0.559928446050989, "w": 0.046511624654134165, "h": 0.010116278651819317, "text": "Liz:"}, {"w": 0.09345627678765189, "y": 0.3962137183682734, "text": "I'll try not to!", "x": 0.6062235599059421, "h": 0.01434581909799397}, {"y": 0.41982558156217176, "x": 0.536672630896693, "w": 0.023255812327067082, "text": "4", "h": 0.010116278651819317}, {"w": 0.3667262776692709, "x": 0.5599284487100874, "text": "Complete the dialogue with the words and phrases", "y": 0.4210901165299722, "h": 0.011554287852793362}, {"w": 0.3758881632486979, "h": 0.013322934915012375, "x": 0.5580309320323072, "text": "from the box. There are two extra words or phrases.", "y": 0.4333916141239658}, {"text": "also important not to important to I should", "x": 0.5760286292081186, "y": 0.46155523223923567, "h": 0.013909883895075349, "w": 0.33452592637803813}, {"text": "make sure", "y": 0.47666695710396445, "w": 0.07159165276421442, "h": 0.010241666933259336, "x": 0.5760109711138651}, {"w": 0.21288013034396702, "y": 0.47661552336255325, "h": 0.012955776173285189, "text": "must should should really", "x": 0.66905188735485}, {"w": 0.18783542209201387, "h": 0.01149494132840683, "text": "you should you shouldn't", "y": 0.49063953519785003, "x": 0.5706618930461218}, {"x": 0.5563506219233915, "w": 0.3792486572265624, "text": "Terry: Iza, I want to start jogging because I need to get", "y": 0.5170532490104004, "h": 0.012955776173285189}, {"h": 0.012645348314774147, "text": "fitter and lose some weight. You go jogging a lot.", "x": 0.602862258183621, "y": 0.531104651449299, "w": 0.3363148328993055}, {"h": 0.012732085312316574, "x": 0.604651162856714, "text": "Have you got any advice you can give me?", "w": 0.2915921359592014, "y": 0.5449277980525561}, {"y": 0.560188953798509, "w": 0.030411449008517777, "x": 0.5527728087873331, "h": 0.010116278651819317, "text": "Iza:"}, {"h": 0.015343327143562445, "y": 0.5574909746788778, "x": 0.6010733475220723, "text": "Yes. First of all, you must get some good running", "w": 0.33452592637803824}, {"y": 0.572834302408102, "h": 0.010116278651819317, "x": 0.6028622541491302, "text": "shoes.", "w": 0.04472271813286677}, {"y": 0.5853655237788935, "h": 0.014133574007220224, "x": 0.5545617209608725, "w": 0.16994632297092016, "text": "Terry: OK, and how far?"}, {"text": "run?", "x": 0.8568872991122611, "w": 0.032200357649061484, "h": 0.010116278651819317, "y": 0.5867441860868811}, {"text": "Iza:", "x": 0.5545617180478032, "w": 0.03398926628960508, "h": 0.008851743820341951, "y": 0.6006540698870674}, {"w": 0.18845277574327257, "h": 0.01481898132214047, "x": 0.6025545470100696, "y": 0.5982733268365754, "text": "Not very far when you start."}, {"h": 0.012645348314774147, "x": 0.5992844366674192, "y": 0.6120348838556944, "text": "It's 2", "w": 0.03220035764906137}, {"text": "do too much. It can be", "y": 0.6144178702175682, "h": 0.010262362173748277, "w": 0.15742396036783857, "x": 0.7620751370492352}, {"y": 0.6284738374654736, "x": 0.6010733595383716, "text": "very dangerous. Some people have heart attacks.", "w": 0.3381037394205729, "h": 0.011462985651587822}, {"h": 0.01391444872432664, "w": 0.21824686686197914, "text": "Terry: Oh, wow! Anything else?", "x": 0.5527728080418787, "y": 0.6411146211618011}, {"h": 0.010116278651819317, "text": "Iza:", "x": 0.5509838994447572, "y": 0.6562936048917503, "w": 0.030411449008517777}, {"text": "run on hard roads. It's bad for", "y": 0.6548555958177726, "h": 0.01155428747838154, "x": 0.7406082280244467, "w": 0.20393559773763015}, {"w": 0.33452592637803824, "h": 0.012645348314774147, "x": 0.6010733544466398, "text": "the legs. Try to find a path in the forest or a good", "y": 0.668938953686363}, {"x": 0.598893156847169, "y": 0.6813041594281484, "text": "running track. 4", "w": 0.10676851908365881, "h": 0.015014891572807611}, {"text": "you take a lot", "w": 0.10241970486111107, "x": 0.8297250636457686, "y": 0.6840813460038838, "h": 0.010418514753506919}, {"x": 0.6010733487064089, "text": "of water to drink and you should", "y": 0.6967587213075886, "w": 0.22003577338324654, "h": 0.011490376124743525}, {"y": 0.7117824908122357, "w": 0.1484794277615018, "h": 0.011531462583300867, "x": 0.7388193209358859, "text": "take a mobile phone."}, {"h": 0.013550050146743294, "x": 0.5508576500542651, "y": 0.7241261378424716, "text": "Terry: Why?", "w": 0.08790902879503038}, {"y": 0.7397529071754031, "x": 0.5527728081300235, "w": 0.026833631727430585, "h": 0.008851743820341951, "text": "Iza:"}, {"x": 0.6010733545443251, "h": 0.012654478722100659, "text": "Because something could happen to you.", "y": 0.7384792421049812, "w": 0.28264756944444447}, {"x": 0.5974955321582166, "w": 0.2719141303168402, "h": 0.011558853056456667, "text": "When you're a long way from home, it's", "y": 0.7522202164284693}, {"w": 0.008944543202718203, "x": 0.5974955281526659, "text": "6", "y": 0.7650436047446666, "h": 0.0075872089888644875}, {"y": 0.7675315884802064, "x": 0.7388193244677191, "w": 0.17889087253146696, "h": 0.010207581227436872, "text": "have some way to contact"}, {"h": 0.011504071735733246, "y": 0.7800947653438512, "w": 0.17889087253146696, "text": "people who can help you.", "x": 0.5974955267634855}, {"h": 0.010116278651819414, "text": "You 7", "y": 0.7928633721755438, "w": 0.03756708357069227, "x": 0.5974955286082139}, {"x": 0.7602862285099667, "text": "_ go with someone else.", "h": 0.010221276464014675, "w": 0.16279069688585068, "y": 0.7953924420694393}, {"text": "It's safer and more fun.", "y": 0.8063742157670274, "h": 0.011862814073528221, "x": 0.5973328339489536, "w": 0.15775522867838543}, {"x": 0.5509839013467682, "y": 0.8219476745651829, "w": 0.17531305948893228, "h": 0.011540592616215461, "text": "Terry: Can I go with you?"}, {"text": "Maybe when you're fitter. I go a long way and", "x": 0.5973742121484193, "h": 0.01343518957764661, "y": 0.834540425766225, "w": 0.31145996093750006}, {"x": 0.5974955260720581, "text": "quite fast. You should go with someone who is", "w": 0.3166368611653646, "y": 0.8484070397825115, "h": 0.012741215719642991}, {"w": 0.36008229573567707, "x": 0.13580247130225756, "h": 0.013343799058084693, "y": 0.8806907378766998, "text": "twenty years old. The other two are probably her friends."}, {"w": 0.36831275092230903, "x": 0.11111110811223392, "h": 0.011773940345368938, "text": "e l enjoy walking with friends. My favourite walks are in", "y": 0.8952119307570595}, {"h": 0.009026687598116201, "text": "the mountains.", "y": 0.909733123843233, "w": 0.0987654283311632, "x": 0.13374485908544717}, {"w": 0.07452140808105467, "text": "get fit too.", "x": 0.5964841509747152, "y": 0.8756951678254138, "h": 0.013144548496982988}, {"x": 0.9053497949153947, "text": "79", "h": 0.013081394896215293, "y": 0.9418604654734041, "w": 0.0246913570827908}]
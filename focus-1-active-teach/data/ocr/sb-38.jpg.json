58359430605},{"x":0.44855967379738126,"w":0.15432098388671878,"y":0.52034883765363649,"text":"To form the -ing form:","h":0.013081394896215293},{"x":0.44650205717096975,"y":0.53488372101349924,"w":0.40329216851128474,"text":"• add -ing to the verb: stand → standing, work → working","h":0.011819575607683097},{"y":0.54941860464964265,"w":0.33950615776909721,"h":0.011805885066417221,"text":"• if the verb ends in -e, drop -e: make → making","x":0.44855968256092449},{"x":0.4464407750891668,"text":"• if the verb ends with a short vowel + a consonant, double the last","w":0.47337151421440971,"h":0.013572766230656508,"y":0.56240878829518326},{"y":0.5769230772122057,"text":"letter: fit → fitting, chop → chopping","w":0.26131686740451388,"x":0.45884774349253032,"h":0.013343799058084804},{"y":0.61185243316480886,"w":0.46090535481770833,"h":0.011773940345368938,"text":"Complete the sentences about the picture. Use the positive or","x":0.4670781925499935},{"h":0.013147565970428321,"y":0.62500000038982839,"w":0.27983539157443577,"text":"negative form of the verbs in the box.","x":0.46913579932595101},{"w":0.41152262369791665,"text":"cook chop discuss have make talk wash work","h":0.013343799058084804,"y":0.64952904254970256,"x":0.47530864401523926},{"y":0.67425431725832896,"w":0.18312756008572045,"h":0.014699170877645273,"text":"1 Sally isn't cooking. She","x":0.46707819554870361},{"w":0.1646090528700086,"text":"to Sarah on the phone.","x":0.74279835586952236,"y":0.67425431703886884,"h":0.011792194525151345},{"x":0.46906352495928405,"h":0.010590897624496387,"text":"2 Maria","w":0.057757725185818121,"y":0.68874524881288002},{"text":"the dishes. She","y":0.68877551003794046,"w":0.11522633870442711,"x":0.62551440410457659,"h":0.010352396703028455},{"y":0.68729150822994212,"text":"coffee.","w":0.049576335483127121,"x":0.83529413630182414,"h":0.012044890896304672},{"y":0.70153064066103743,"text":"3 Gomez","h":0.012636392793999751,"x":0.46897475818051954,"w":0.07028093549940323},{"w":0
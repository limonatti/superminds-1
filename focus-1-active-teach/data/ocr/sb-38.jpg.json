[{"y":0.050872093289890175,"x":0.067901235325447618,"w":0.080246912638346379,"h":0.042151162163990397,"text":"3.2"},{"x":0.20370370106923549,"w":0.17489712185329861,"text":"GRAMMAR","y":0.031976744824748216,"h":0.020348836338875631},{"y":0.074127907170126073,"text":"Present Continuous","w":0.15020575629340277,"x":0.19547325604397064,"h":0.010251998527083694},{"x":0.19341563904032999,"text":"I can use the Present Continuous to talk about","w":0.34362138536241316,"h":0.010343269425995505,"y":0.095761381543413293},{"text":"events happening at the time of speaking.","w":0.31275719536675345,"x":0.19547325938109489,"y":0.10901162815751253,"h":0.013081394896215293},{"h":0.010174418169437871,"w":0.043209877014160153,"y":0.15552325610423456,"text":"Maria","x":0.24279835324189111},{"x":0.40329218118748295,"h":0.015988372371559811,"y":0.15552325547483059,"w":0.063786006503634973,"text":"Pana"},{"x":0.36831276020531251,"h":0.011627906907110019,"w":0.096707814534505221,"text":"• M00","y":0.17296511624121247},{"x":0.46090535164166985,"text":"Adam","w":0.047325100368923623,"y":0.20784883737240323,"h":0.01017441816943776},{"x":0.74485596741575644,"h":0.015988372371559811,"w":0.076131685045030317,"y":0.011627906910150365,"text":"VIDEO"},{"w":0.055555555555555469,"text":"613","x":0.90946502092335402,"y":0.01162790677388581,"h":0.015988372371559811},{"x":0.60493826811764573,"text":"\"Hi Sarah, how are you? What are you doing?","h":0.013143002706195284,"y":0.046511628115119108,"w":0.32921810574001731},{"text":"Oh. No, sorry, I can't help you, I'm very busy.","y":0.061046511810613269,"x":0.60493827552505297,"w":0.32921810574001731,"h":0.013129312164929519},{"y":0.076923077260655282,"x":0.60493827771984032,"w":0.32921810574001731,"h":0.013343799058084804,"text":"I'm chopping the vegetables for salads ..."},{"w":0.32921810574001731,"text":"Are Maria and Anna working? Yes, they are -","x":0.60493827771984032,"y":0.093014128849121858,"h":0.011773940345368938},{"text":"Maria is making coffee and there are a lot of","w":0.33127570258246519,"y":0.10753532210641326,"x":0.60493827918716248,"h":0.013104212714514119},{"h":0.013081394896215293,"y":0.12354651207224121,"text":"customers! Anna is busy too, she's washing the","x":0.60493827675962075,"w":0.32921810574001742},{"w":0.32921810574001742,"text":"dishes. And Gomez is talking to a man at the","x":0.60493827634809827,"h":0.011627906907110019,"y":0.13953488368307287},{"h":0.013120185636463555,"text":"back door. I think they're having an argument","x":0.60493828453695653,"y":0.15406976757732838,"w":0.3312757025824653},{"text":"... No, Adam isn't looking at his phone as","x":0.60493826674590367,"y":0.16993720572720605,"w":0.32921810574001742,"h":0.011773940345368938},{"text":"usual, he's taking money from the customers!","y":0.18445839902568983,"w":0.32921810574001731,"h":0.013343799058084804,"x":0.60493826894069092},{"x":0.60493827634809827,"text":"We're really all very, VERY busy! Oh, wait, Gina","h":0.011773940345368938,"w":0.32921810574001742,"y":0.20054945058993168},{"x":0.60493827257580746,"w":0.32921810574001731,"h":0.014696888496961824,"y":0.21350078526158989,"text":"isn't doing anything. She's just standing there."},{"w":0.20576131184895829,"text":"GINA! What are you doing?!\"","y":0.22959183683684048,"h":0.014594209063184205,"x":0.60493827754602814},{"text":"Anna","x":0.63355086880065981,"w":0.039482625325520826,"y":0.26553277662253427,"h":0.0096321210756407094},{"w":0.051440327962239629,"x":0.83333333317251534,"y":0.28197674423407948,"text":"Gomez","h":0.010174418169437871},{"text":"Gina","w":0.032921810150146391,"y":0.37063953472473954,"x":0.72633744835428216,"h":0.01162790690711013},{"h":0.013081394896215404,"w":0.037037035624186143,"x":0.54732510405004686,"text":"Sally","y":0.37645348854389815},{"h":0.0087209301803325978,"x":0.061728395004190834,"text":"1","y":0.49127906968454305,"w":0.010288065804375551},{"x":0.088477368426287561,"w":0.27366255018446178,"text":"SPEAKING Look at the people in the","h":0.011627906907110019,"y":0.4912790699960573},{"h":0.01312474890069637,"text":"picture. Where do they work? What do","x":0.090534980054146258,"y":0.5043171111200857,"w":0.2860082329644098},{"y":0.51883530234380515,"text":"they do?","h":0.011748000254249269,"w":0.065885916815863713,"x":0.088456218547332113},{"y":0.53633720924993333,"text":"Sally is a cook. She prepares food.","x":0.090534979885746145,"w":0.23456790500217012,"h":0.01162790690711013},{"w":0.0123456785413954,"x":0.061728395194322883,"h":0.010174418169437871,"y":0.56104651171833342,"text":"2"},{"w":0.3127571953667535,"x":0.088477365485347639,"h":0.013081394896215404,"text":"1) 2.5 Read and listen to Sally's telephone","y":0.55959302353663065},{"h":0.011821857614083053,"text":"conversation with Sarah. Look at the","y":0.57412790681776293,"w":0.26748970879448786,"x":0.088477368922371957},{"text":"picture. Does she tell her the truth?","y":0.58866279070596217,"w":0.26131686740451388,"h":0.013081394896215293,"x":0.090534977854670476},{"x":0.061728395194322883,"y":0.61337209311368235,"text":"3","h":0.01017441816943776,"w":0.0123456785413954},{"y":0.61337209300962325,"h":0.011627906907110019,"x":0.090534996532935022,"text":"Complete the GRAMMAR FOCUS with the","w":0.31069956461588549},{"w":0.19753085666232639,"y":0.62790697677900309,"x":0.088477372491881978,"h":0.01181044870493364,"text":"verbs in blue in Exercise 2."},{"x":0.065843624532797226,"w":0.15637859768337675,"h":0.01162790690711013,"text":"GRAMMAR FOCUS","y":0.65843023250574728},{"w":0.043209877014160153,"text":"€13","h":0.013081394896215293,"x":0.23456790130773472,"y":0.65697674433968301},{"h":0.013343799058084804,"y":0.68014128725616796,"w":0.32921810574001736,"text":"Present Continuous: am\/are\/is + -ing form","x":0.063786011893365704},{"x":0.061728401493577868,"w":0.3127571953667535,"h":0.011627906907110019,"y":0.69767441844566991,"text":"You use the Present Continuous to talk about"},{"w":0.21870071411132813,"h":0.016887953741771211,"tex
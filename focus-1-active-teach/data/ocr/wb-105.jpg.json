[{"h": 0.01951382733424213, "w": 0.15040444268120662, "x": 0.22175663525999034, "text": "READING", "y": 0.035134074636285526}, {"w": 0.2311519538031684, "text": "Long distance walks • adverbs", "h": 0.015501676397633512, "x": 0.22160865204463165, "y": 0.07477516152335306}, {"text": "and adjectives • the natural world", "x": 0.22182469769968172, "h": 0.011421899941854026, "y": 0.0910465116733226, "w": 0.25402503119574654}, {"x": 0.21824687138321364, "h": 0.0127366508903917, "y": 0.10622093036732218, "w": 0.1180679745144314, "text": "• word families"}, {"y": 0.14542151165818404, "x": 0.10017889079091105, "text": "G09", "h": 0.0075872089888644875, "w": 0.030411449008517805}, {"y": 0.05058139562103802, "w": 0.3864042833116319, "h": 0.01027149258107479, "x": 0.5545617175570643, "text": "Read the three sentences from the texts and match"}, {"x": 0.5635062634620431, "w": 0.18783542209201387, "text": "the places to the photos.", "h": 0.012750346126969504, "y": 0.06438628151878964}, {"w": 0.3202146742078993, "x": 0.5635062626053526, "y": 0.08205324894717364, "text": "A The Bear Trail: It's a beautiful walk through", "h": 0.012955776173285189}, {"h": 0.010289753021315995, "text": "forests and over rivers and lakes.", "y": 0.09610465137176474, "w": 0.23076922946506073, "x": 0.5867620786708686}, {"y": 0.10992779746179915, "w": 0.32200358072916657, "h": 0.012732086061140218, "x": 0.5635062556998176, "text": "B Camino di Santiago: But in Spain, the walk"}, {"h": 0.01270013000990929, "w": 0.1520572408040365, "text": "often followed roads.", "y": 0.12392441894174086, "x": 0.584973166986175}, {"w": 0.32558139377170137, "h": 0.012677304366004975, "x": 0.5635062616561887, "text": "C GR20 Corsica: It goes ... from two hundred", "y": 0.13780234669363498}, {"h": 0.01275491095622089, "x": 0.5867620912239427, "text": "metres to over 2,200 metres above sea-level.", "y": 0.15174418630772923, "w": 0.3166368272569444}, {"text": "A", "w": 0.01431127018398709, "y": 0.16818313967513945, "x": 0.08944543816382042, "h": 0.011380813483296684}, {"text": "Hiking in Finland", "y": 0.16312500038588934, "x": 0.12701252321887985, "w": 0.2826475863986545, "h": 0.02276162696659346}, {"w": 0.323792487250434, "h": 0.010298883054230686, "text": "I've just come back from Finland. My friends from", "y": 0.19708483760380113, "x": 0.1073345296529582}, {"w": 0.35599283854166663, "h": 0.012645348314774242, "y": 0.21117732580046175, "text": "university invited me to join them on an eight-day hike.", "x": 0.1055456230517665}, {"w": 0.35778174506293403, "x": 0.10554562418886686, "h": 0.011508636564984633, "y": 0.2249593864030445, "text": "The walk is called the Bear Trail and it is in the Oulanka"}, {"text": "National Park in north-eastern Finland. It's a beautiful", "y": 0.23899709329545657, "w": 0.34347049289279513, "h": 0.010303448257893895, "x": 0.10733451813320888}, {"y": 0.25283393490713224, "h": 0.01145385561867313, "w": 0.34347049289279513, "text": "walk through forests and across rivers and lakes. We", "x": 0.10733451756075814}, {"x": 0.10733453697106837, "h": 0.010271492581074886, "text": "stayed at campsites and carried clothes, food and tents", "y": 0.26808139548193916, "w": 0.3631484646267361}, {"text": "on our backs. I'm not the fittest person in the world", "x": 0.10554562805839728, "w": 0.3363148328993055, "y": 0.28188628142944117, "h": 0.01148581129549204}, {"h": 0.012681869195256459, "w": 0.3488372124565972, "y": 0.29590116314675535, "text": "but I was able to finish. I loved the incredibly clear air,", "x": 0.10375670247027036}, {"y": 0.30976083029235674, "text": "the beautiful views and the sounds of nature. In my", "x": 0.10554561829165045, "h": 0.010207581227436775, "w": 0.33273701985677084}, {"x": 0.10554561984296192, "w": 0.35957065158420143, "y": 0.3249854655039502, "h": 0.012649913892849175, "text": "opinion, it is perfect for anyone who wants to start long"}, {"w": 0.36135955810546877, "y": 0.3388131768020202, "x": 0.10733453583098651, "h": 0.010207581227436872, "text": "distance walking as it is almost completely flat and well-"}, {"y": 0.3528052327470979, "h": 0.012704694839160872, "w": 0.34168155246310766, "text": "signposted. Just try not to fill your backpack up with", "x": 0.10554563050240985}, {"y": 0.3666877259406781, "x": 0.1037567129597589, "w": 0.1949910481770833, "h": 0.012672738787929946, "text": "things which you won't need."}, {"h": 0.01138081348329678, "y": 0.3667151164003574, "x": 0.5295169944876701, "w": 0.012522361543443439, "text": "B"}, {"text": "Camino di Santiago", "y": 0.3615839352320221, "h": 0.021592960288808586, "w": 0.2915921359592014, "x": 0.5867620736274356}, {"h": 0.01264534831477405, "text": "It was the walk of a lifetime. Eight hundred kilometres", "y": 0.3995930236073555, "x": 0.5652951653796393, "w": 0.37030412462022566}, {"h": 0.014133574007220224, "x": 0.563506254599986, "text": "from the south of France, over the Pyrenees", "w": 0.3202146742078993, "y": 0.41340703953222274}, {"y": 0.428677325918485, "h": 0.012645348314774147, "w": 0.3631484646267361, "text": "mountains and across northern Spain to Santiago", "x": 0.5635062649496017}, {"h": 0.014133574007220224, "y": 0.44245938636887816, "x": 0.5652951746647659, "w": 0.35599283854166675, "text": "de Compostela. It all started so well. The path up"}, {"y": 0.45776162809593524, "h": 0.012645348314774242, "text": "to the Pyrenees was magical and it was good to", "x": 0.5635062632302089, "w": 0.35062611897786466}, {"x": 0.5652951815100768, "text": "meet other people doing the same walk. Everyone", "h": 0.014133574007220224, "y": 0.471511732708563, "w": 0.3649373711480035}, {"y": 0.48682310477399915, "x": 0.5635062720655528, "w": 0.33631483289930564, "h": 0.01266817395867856, "text": "was enthusiastic about the walk ahead. But in"}, {"text": "Spain, the route often followed roads. It was noisy", "h": 0.014133574007220224, "x": 0.5652951803729764, "w": 0.3631484646267361, "y": 0.5005640797317372}, {"w": 0.3685151841905382, "y": 0.5146656976758635, "x": 0.5635062682625127, "h": 0.013909883895075253, "text": "and monotonous, with unchanging views for hours"}, {"y": 0.5298401164770606, "text": "and hours. More and more people joined the", "w": 0.32558139377170137, "x": 0.5635062646824259, "h": 0.012732086061140218}, {"x": 0.563506272744424, "text": "walk. They were generally friendly but it wasn't the", "w": 0.3649373711480034, "y": 0.543749999839163, "h": 0.013909883895075349}, {"y": 0.5589244185808054, "w": 0.34704830593532987, "h": 0.013909883895075253, "x": 0.5635062550108683, "text": "experience I expected. I'd like to go back to the"}, {"y": 0.5728023468570683, "w": 0.3452593994140626, "text": "Pyrenees and hike there again but I'll stop there", "x": 0.5652951704405536, "h": 0.014133574007220224}, {"h": 0.01302732927274187, "text": "next time.", "x": 0.5634427808892566, "y": 0.5878177305544035, "w": 0.07526112874348956}, {"x": 0.07692308387213144, "text": "c THE GR20, Corsica", "w": 0.36135955810546877, "h": 0.027874548736462102, "y": 0.6524999999997285}, {"x": 0.10733454142569965, "h": 0.013909883895075253, "y": 0.685377906815907, "w": 0.5044722493489583, "text": "Corsica is a magnificent island with some wonderfully picturesque walks"}, {"y": 0.6992193140541317, "x": 0.10554563122067002, "h": 0.015311371841155259, "text": "along the coast and inland. But for walkers, it is famous for the GR20,", "w": 0.5008944363064236}, {"text": "Europe's most difficult long distance walk. It goes from north to south and", "x": 0.10733453976051742, "y": 0.7131976746417418, "w": 0.5295169745551215, "h": 0.015174417977728975}, {"y": 0.7261836160216772, "text": "up and down from two hundred metres to over 2,200 metres above sea level.", "x": 0.10544470030795582, "h": 0.016187419185569527, "w": 0.5404447089301215}, {"text": "The frighteningly steep and rocky paths are beautiful but very demanding.", "y": 0.7422819766191774, "x": 0.10733453671309551, "w": 0.522361348470052, "h": 0.013909883895075253}, {"h": 0.014133574007220224, "y": 0.7573240069289935, "text": "Our guides will help you to complete the whole 180 km in fifteen days.", "x": 0.10733454352766734, "w": 0.5044722493489583}, {"y": 0.7676909735891354, "h": 0.019054696568513232, "text": "The price includes transport, accommodation in tents and food. You should", "x": 0.10541221161966544, "w": 0.5387544420030382}, {"w": 0.5439705064561631, "x": 0.10547469926079461, "h": 0.016743428268157213, "text": "be in good health with experience of mountain walking and a good head for", "y": 0.7838910034167804}, {"x": 0.10554562067527033, "text": "heights. No climbing experience is necessary.", "y": 0.8004505812555875, "h": 0.013909883895075253, "w": 0.32558139377170137}, {"x": 0.09481216697904968, "h": 0.010116278651819317, "y": 0.8522965117610091, "w": 0.07692307366265191, "text": "GLOSSARY"}, {"x": 0.10493826936286345, "y": 0.8704866565574003, "w": 0.2139917670355903, "text": "flat (adj) - not going up or down", "h": 0.013343799058084804}, {"h": 0.013343799058084804, "text": "well-signposted (adj) - there are", "x": 0.10493827890008794, "y": 0.8850078489884977, "w": 0.2283950466579861}, {"text": "plenty of signposts and the information", "y": 0.8995290424770284, "w": 0.2633744812011719, "x": 0.10288065734180098, "h": 0.013343799058084804}, {"x": 0.10288065788670672, "text": "they give you is clear and easy", "w": 0.2119341532389323, "h": 0.011821857614083053, "y": 0.9140502354324951}, {"y": 0.9287297861540621, "text": "to follow", "x": 0.10080785778719269, "w": 0.06587399800618489, "h": 0.010272985724863903}, {"x": 0.08641975312598496, "y": 0.9593023256785048, "text": "100", "w": 0.03292181015014649, "h": 0.01162790690711013}, {"x": 0.39094650437189227, "w": 0.24485595703125007, "y": 0.8704866562448799, "text": "steep (adj) - a road, hill, etc. that is", "h": 0.013343799058084693}, {"x": 0.3909465082943511, "y": 0.8850078493166361, "w": 0.19753085666232645, "text": "steep slopes at a high angle", "h": 0.011794476157267808}, {"y": 0.8995290424963005, "w": 0.23045267740885417, "h": 0.011808166698533684, "text": "have a good head for heights -", "x": 0.3909465036824041}, {"y": 0.9127906979915725, "x": 0.39094650503944434, "w": 0.23868311564127603, "h": 0.013081394896215293, "text": "not afraid of being high above the"}, {"x": 0.3897812912661656, "w": 0.05378924899631077, "text": "ground", "y": 0.9282303267678867, "h": 0.01286257679458691}, {"x": 0.6769547323997384, "text": "meets the sea", "w": 0.10082304212782112, "h": 0.010340987793879042, "y": 0.885007849270491}, {"text": "inland (adj) - away from the coast", "w": 0.23662550184461806, "x": 0.6769547393040284, "y": 0.8967817894035008, "h": 0.013101931082397655}]
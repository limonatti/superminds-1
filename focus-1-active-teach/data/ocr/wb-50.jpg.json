[{"x": 0.21466905282193277, "text": "KAM SPEAKING", "y": 0.00505813960498716, "w": 0.23434704250759547, "h": 0.01896802322098501}, {"y": 0.06828488409850896, "w": 0.008944543202718105, "h": 0.010116278651819317, "x": 0.09838998251313111, "text": "1"}, {"h": 0.012704694839160775, "x": 0.10554562421454736, "y": 0.06949007238363324, "text": "In pairs, ask and answer the questions.", "w": 0.3005366685655382}, {"y": 0.0880606629327841, "x": 0.11789086239953071, "w": 0.05044367896185982, "h": 0.011029836821642191, "text": "PART 1"}, {"x": 0.11806798090479939, "h": 0.012955776173285189, "text": "Talk about food.", "y": 0.10482400732470368, "w": 0.12343470255533853}, {"x": 0.11787919658540988, "w": 0.3956874593098958, "h": 0.017009196281433107, "text": "1 What food do you like eating when friends visit you?", "y": 0.11879570608786146}, {"w": 0.3243543836805556, "x": 0.11778553954720192, "text": "2 What food do you cook most often? Why?", "y": 0.13194716320635805, "h": 0.018228430274591534}, {"y": 0.14795058147620727, "x": 0.11985688752207567, "w": 0.008944543202718105, "h": 0.0075872089888644875, "text": "3"}, {"h": 0.012645348314774147, "y": 0.14795058181463328, "w": 0.2307692294650608, "text": "How often do you eat fast food?", "x": 0.14311270174779162}, {"h": 0.010116278651819414, "text": "4", "y": 0.16186046537583448, "w": 0.012522361543443467, "x": 0.11627906955028183}, {"x": 0.14311270437116833, "text": "Do you prefer going to a restaurant", "h": 0.012754910956220987, "w": 0.2522361246744792, "y": 0.16175090276134055}, {"text": "or eating at home? Why?", "y": 0.1770348839098887, "h": 0.012645348314774147, "x": 0.14132379578128923, "w": 0.17889087253146702}, {"x": 0.11627906623167035, "y": 0.18962545102472117, "w": 0.3237924872504341, "h": 0.015311371841155259, "text": "5 What's the local speciality where you live?"}, {"text": "2 Look at the photos of people at work.", "x": 0.09481217507665346, "h": 0.014133574007220224, "y": 0.21239620915346183, "w": 0.30590338812934026}, {"x": 0.11797895846651461, "text": "PART 1", "w": 0.04490075853135851, "y": 0.23244440566459348, "h": 0.009311770179211446}, {"h": 0.018008350241485487, "x": 0.11593181498922604, "text": "Take turns to describe the photos.", "y": 0.24612245621510287, "w": 0.2547949557834201}, {"x": 0.5688089314019782, "w": 0.05021755642361103, "text": "PART 2", "y": 0.0909042033967899, "h": 0.011665430137827061}, {"x": 0.5688729890133758, "h": 0.013909883895075253, "y": 0.10748546504501319, "w": 0.12164579603407122, "text": "Talk about jobs."}, {"y": 0.12131317679269915, "x": 0.5688729915672732, "h": 0.015311371841155259, "w": 0.2271913994683159, "text": "1 What's your ideal job? Why?"}, {"x": 0.5796064407437173, "y": 0.1365697675656413, "text": "Would you like to work with old people?", "w": 0.30232557508680546, "h": 0.015366152787466761}, {"y": 0.15018597422276206, "x": 0.5920587790133479, "h": 0.014497237239934086, "w": 0.1146302032470703, "text": "Why?/Why not?"}, {"text": "3", "w": 0.010733451843261799, "x": 0.5688729877635211, "y": 0.1643895349765566, "h": 0.011380813483296684}, {"text": "• Do you prefer working in a team or on your own? Why?", "x": 0.5760286249445625, "h": 0.013909883895075253, "y": 0.16565406966456264, "w": 0.3899820963541667}, {"y": 0.1781966779055478, "x": 0.5668551551792184, "text": "4 What's good about working from home?", "h": 0.017547270287675592, "w": 0.3152640448676215}, {"y": 0.19212076917985568, "w": 0.3689583333333333, "text": "5 Would you like to work abroad? Why?/Why not?", "x": 0.5668469023095412, "h": 0.018183018610365594}, {"text": "PART 2", "y": 0.5270605424129104, "w": 0.048506011962890644, "h": 0.010617287008340604, "x": 0.10723178795020757}, {"y": 0.5435423293262793, "h": 0.014406512007386215, "text": "In pairs, ask and answer the questions about the photos.", "w": 0.4098790147569444, "x": 0.10901357535611648}, {"text": "Student A's photo", "x": 0.10733452542615668, "y": 0.5639825578785888, "h": 0.013923579131653152, "w": 0.13595706515842013}, {"y": 0.5676985556622943, "text": "Student B's photo", "h": 0.012722955653813704, "w": 0.1377459716796875, "x": 0.5581395378989754}, {"text": "1 What job does this photo show?", "x": 0.10733453356133958, "w": 0.2540250311957465, "y": 0.5790839350352478, "h": 0.014133574007220128}, {"x": 0.5563506240728063, "y": 0.5816860464624914, "w": 0.2576028611924913, "h": 0.013909883895075253, "text": "1 What's happening in this photo?"}, {"w": 0.2921223958333333, "text": "2 What is the woman on the left doing?", "x": 0.10711460737948578, "y": 0.589880734898125, "h": 0.017342106822595686}, {"h": 0.011490376499155346, "w": 0.20393559773763015, "x": 0.5581395331079292, "y": 0.596750902351323, "text": "2 Where are these people?"}, {"y": 0.6081362815440803, "h": 0.012750346126969504, "x": 0.1073345338003189, "w": 0.31484792073567713, "text": "3 What is the woman on the right wearing?"}, {"text": "3", "w": 0.012522361543443439, "x": 0.5563506261155771, "h": 0.010116278651819317, "y": 0.6107703491473461}, {"h": 0.012677304366004975, "y": 0.6107703492564938, "text": "What is the woman doing?", "x": 0.5688729905766231, "w": 0.20393559773763026}, {"y": 0.6221511630772059, "x": 0.10733452496588926, "w": 0.30053666856553823, "h": 0.012681869195256362, "text": "4 What is the woman on the right doing?"}, {"w": 0.010733451843261715, "y": 0.6360610465519974, "text": "5", "x": 0.1073345261952445, "h": 0.010116278651819317}, {"y": 0.6234156977775692, "x": 0.556350626039454, "w": 0.275491943359375, "text": "4 Do you think it's a nice conversation?", "h": 0.012645348314774242}, {"w": 0.3490020073784722, "x": 0.1305018259737544, "text": "Do you think the woman on the left likes her job?", "y": 0.6360137274996498, "h": 0.014123017090752683}, {"w": 0.10912343343098951, "h": 0.012732086061140218, "x": 0.5813953502535827, "text": "Why?/Why not?", "y": 0.6385901164680282}, {"text": "Why?/Why not?", "x": 0.1270125242174907, "y": 0.6512354652931943, "h": 0.012649913892849175, "w": 0.11627906799316406}, {"text": "5 Why do you think the man on the left is filming?", "y": 0.6536777979382048, "w": 0.3649373711480034, "h": 0.014133574007220224, "x": 0.5563506381111503}, {"w": 0.6443760172526041, "y": 0.6714240882299609, "h": 0.01782076241737669, "text": "3 Read the instructions on your card. In pairs, take turns to role-play the conversation.", "x": 0.08210512871238286}, {"w": 0.07526028951009114, "h": 0.010594726073612762, "text": "Student A", "y": 0.7015776370185615, "x": 0.13052727846566595}, {"x": 0.5562783344102, "w": 0.07527875264485673, "text": "Student B", "y": 0.7040707170824387, "h": 0.010666705253752498}, {"h": 0.015149829602844025, "text": "You are a careers consultant. You are", "x": 0.13037004442359798, "y": 0.7241955400447188, "w": 0.27949837578667536}, {"h": 0.014133574007220128, "x": 0.12880143235455793, "text": "helping Student B to choose his/her future", "w": 0.3220035807291667, "y": 0.7396570394531894}, {"y": 0.7549273255470116, "w": 0.2576028611924913, "x": 0.12522361197978296, "h": 0.013909883895075253, "text": "job. Ask Student B the questions."}, {"h": 0.011389943890623196, "y": 0.7726308141675087, "x": 0.12880144129815052, "text": "• Ask Student B if he/she wants to do", "w": 0.27906975640190973}, {"y": 0.7863763540153944, "h": 0.014133574007220224, "x": 0.14847943680866604, "text": "a full-time job or a part-time job.", "w": 0.23971376207139755}, {"y": 0.7995295990820231, "h": 0.016887823941475158, "x": 0.12496450785791871, "w": 0.3261027018229167, "text": "• Ask if he/she is happy to work long hours."}, {"text": "• Ask if a good salary is important to him/her.", "x": 0.12701252715499853, "w": 0.3363148328993055, "h": 0.014133574007220224, "y": 0.8142509022138863}, {"text": "• Ask if he/she wants to do a demanding job", "x": 0.12701252774545033, "w": 0.32915920681423605, "h": 0.012645348314774147, "y": 0.8295348839279535}, {"w": 0.10554561191134984, "h": 0.011549723023541975, "x": 0.15205724862840378, "y": 0.8447093024184171, "text": "or an easy job."}, {"h": 0.011467550855250933, "x": 0.12343470906500595, "y": 0.8573546512840783, "text": "• Ask if he/she wants to work with customers", "w": 0.33452592637803824}, {"text": "Student A is your careers consultant. He/She", "y": 0.7282716603521108, "h": 0.012745781297718214, "w": 0.3398926459418402, "x": 0.5545617237195987}, {"y": 0.7422819766950497, "x": 0.5527728061195161, "text": "is helping you choose a future job. Answer", "w": 0.32558139377170137, "h": 0.013909883895075253}, {"h": 0.014133574007220128, "w": 0.17173522949218745, "text": "Student A's questions.", "x": 0.5545617237601674, "y": 0.7561462092641087}, {"h": 0.014346373227529172, "text": "• Say that you want to have a full-time job.", "x": 0.5544223721673527, "y": 0.7736770514891844, "w": 0.3168992784288195}, {"text": "• Say that you're happy to work long hours", "y": 0.7874445263549384, "h": 0.017105924833552454, "x": 0.5525503657648446, "w": 0.318846198187934}, {"w": 0.1288014305962456, "h": 0.012759476534296018, "x": 0.5760286244156517, "text": "if you like the job.", "y": 0.8028655232044862}, {"x": 0.5527728204646989, "y": 0.8168895351466006, "text": "• Say that a good salary is very important", "w": 0.31127010769314234, "h": 0.015174417977729072}, {"text": "to you.", "w": 0.05187835269504126, "x": 0.57781753270883, "y": 0.8333284885075253, "h": 0.008851743820341951}, {"h": 0.012645348314774147, "w": 0.3237924872504341, "x": 0.5527728123005431, "text": "• Say that you want to do a demanding job.", "y": 0.8459738374705199}, {"w": 0.3237924872504341, "text": "• Sav ves, vou want to work with customers", "h": 0.009029783393501837, "x": 0.5509839048840254, "y": 0.8597924189329548}, {"x": 0.1255144093852478, "text": "• Say you can think of some job ideas for", "y": 0.8720565152860776, "w": 0.3045267401801216, "h": 0.013117903255779995}, {"text": "him/her. End the conversation.", "y": 0.8850564206329686, "w": 0.22071712917751737, "h": 0.01385170773396871, "x": 0.14994277685259869}, {"y": 0.9491279070842356, "h": 0.01162790690711002, "x": 0.9176954735162177, "text": "45", "w": 0.0246913570827908}]
[{"y":0.062164836024590886,"text":"READING","x":0.080156377161574893,"h":0.013751723141273486,"w":0.094831280178493932},{"x":0.074074074155228209,"y":0.091569767540647717,"w":0.0123456785413954,"h":0.0087209301803324868,"text":"8"},{"w":0.39711934407552085,"h":0.013343799058084804,"x":0.084362132043172583,"text":"Read the texts and choose the correct answer, A, B,","y":0.0914442696433031},{"y":0.10594458976759791,"w":0.035163574218749993,"h":0.010494541335891894,"text":"or C.","x":0.10073097067476677},{"h":0.011773940345368938,"w":0.25514402601453995,"text":"Adelie penguins are smaller than most","x":0.069958849904252718,"y":0.13226059639571464},{"text":"other penguins. They are forty-five to","y":0.14678178973163913,"w":0.25514402601453995,"x":0.069958854379561231,"h":0.011773940345368938},{"x":0.069958854379561231,"y":0.16130298291130352,"text":"seventy-five centimetres tall. They have","h":0.011773940345368938,"w":0.25514402601453995},{"y":0.17582417571668429,"x":0.069958854379561231,"w":0.25514402601453995,"h":0.011773940345368938,"text":"black heads with white rings around the"},{"text":"eyes. On land they look funny, but they","w":0.25514402601454,"y":0.1903453686299732,"x":0.069958853522222392,"h":0.013143003454762381},{"x":0.069958855442661283,"y":0.20639534898214162,"h":0.010245153256450701,"text":"are amazing swimmers and they can dive","w":0.25514402601453995},{"h":0.010231462715184936,"text":"down to 180 metres. At present there are","x":0.069958855442661283,"y":0.22093023270307177,"w":0.25514402601453995},{"w":0.25514402601453995,"h":0.011787630886634815,"y":0.2354651162048752,"text":"a lot of them in the Antarctic, but global","x":0.069958854379561231},{"y":0.24999999997667754,"x":0.069958856875321399,"h":0.011773940345368938,"text":"warming is a danger to these lovely birds. Penguins eat small sea","w":0.4115226236979167},{"y":0.26452119315634182,"x":0.069958856875321399,"w":0.4115226236979167,"h":0.011773940345368938,"text":"creatures which live under the Antarctic ice. As the ice melts, there"},{"text":"will be less and less food for them.","x":0.067901238498665681,"h":0.011773940345368938,"w":0.21399176703559025,"y":0.27904238601986231},{"h":0.013136157809845894,"w":0.13168724060058595,"text":"1 Adelie penguins","x":0.10082304768324611,"y":0.30808477212372687},{"text":"A are not very big.","w":0.13374485439724393,"h":0.013343799058084915,"x":0.11522633934801724,"y":0.32260596533972841},{"h":0.011773940345368938,"text":"B look funny when they swim.","y":0.33712715870218235,"w":0.2098765394422743,"x":0.1172839551245418},{"x":0.11728395598928185,"h":0.011773940345368938,"y":0.35164835150756324,"text":"C will probably die out soon.","w":0.20370369805230035},{"w":0.21193415323893233,"text":"Opened in 1966, Longleat is the","y":0.38657770822955007,"x":0.25102881027353796,"h":0.013131593797045982},{"h":0.013145284338311969,"text":"oldest drive-through safari park","y":0.40109890140921434,"x":0.25102881086031942,"w":0.20781892564561627},{"h":0.013343799058084804,"text":"outside Africa. On thirty-six square","w":0.23251027425130211,"x":0.25102881640658475,"y":0.41562009413100942},{"text":"kilometres of countryside in sunny","y":0.43014128720276568,"h":0.011773940345368938,"x":0.25102880849739972,"w":0.22839506361219619},{"y":0.4433139536710784,"text":"Wiltshire in England, you can see","w":0.22222222222222221,"x":0.25102880880658435,"h":0.013122467268580018},{"text":"animals running free, like in their","w":0.22016460842556423,"h":0.013108775978747045,"x":0.25102880672686129,"y":0.4578488376536366},{"h":0.01162790690711013,"text":"natural environment. There are lions,","x":0.25102881405639138,"y":0.4723837209359798,"w":0.24485595703125002},{"x":0.25102880909997505,"y":0.48691860462784042,"h":0.011627906907109908,"text":"elephants, giraffes, and monkeys;","w":0.22016460842556423},{"h":0.013081394896215293,"w":0.21810699462890626,"x":0.25102880741805716,"y":0.50000000006279355,"text":"there are tigers, wild dogs, bears,"},{"h":0.013095086186048155,"text":"wolves, and more. There is a Penguin","y":0.51452119287543163,"x":0.25102881493430629,"w":0.24485595703125002},{"h":0.013108775978747045,"text":"Island and a special pavilion with exotic butterflies.","x":0.069958853632772197,"y":0.52904238653113389,"w":0.32098765055338541},{"x":0.072016467141364407,"text":"You can drive your own car through the park or travel on","h":0.013143002706195284,"y":0.54651162806061326,"w":0.37242797851562504},{"h":0.010174418169437871,"y":0.56104651179100784,"text":"a Safari Bus. You can also book a VIP tour in a 4x4 car with a","x":0.069958858480621333,"w":0.40740739610460064},{"y":0.57405563958261818,"h":0.013225929703405637,"x":0.06994089502800159,"w":0.10497417873806424,"text":"personal guide."},{"y":0.60029069768270626,"text":"2 At Longleat Safari Park","h":0.013131594545612857,"x":0.10288065824344667,"w":0.17489712185329864},{"text":"A all animals live in special buildings.","y":0.61482558164588463,"h":0.013117903255779995,"w":0.25925925360785584,"x":0.11934157093269745},{"h":0.011773940345368938,"x":0.11934156600823043,"w":0.22222222222222221,"text":"B you mustn't use your own car.","y":0.6306907378160197},{"x":0.11934157205139058,"w":0.251028798421224,"y":0.64389534903929546,"text":"C you can have a guide just for you.","h":0.013090522173248242},{"y":0.68168604659588028,"h":0.0087209301803324868,"text":"There are only about 3,200","w":0.17695473564995659,"x":0.072016457565968223},{"text":"tigers still living in the wild in the","y":0.69331395347473945,"h":0.01162790690711013,"x":0.069958852559022275,"w":0.21399176703559025},{"w":0.21399176703559031,"h":0.01181501234345006,"x":0.069958848443796073,"text":"whole world. But there are many","y":0.70639534867822795},{"text":"more - perhaps ten thousand -","w":0.20576131184895835,"y":0.71938775513455333,"x":0.07201646616056874,"h":0.011773940345368827},{"x":0.069958847584113068,"text":"living as pets in private homes","y":0.73255813937590231,"w":0.20164608425564234,"h":0.01162790690711013},{"y":0.74563953502865321,"x":0.069958852599364185,"w":0.20370369805230032,"h":0.010247435262850657,"text":"in the USA. Some people think"},{"text":"it's cool to have a tiger, lion or","h":0.011773940345368938,"x":0.069958853018468908,"y":0.75863422282649495,"w":0.19547324286566839},{"text":"leopard as a pet. I think it's","x":0.069958847642947838,"y":0.77180232572632768,"w":0.17901234944661459,"h":0.01017441816943776},{"text":"cruel and selfish and should","y":0.78488372131741291,"w":0.18518517388237843,"x":0.072016463744681944,"h":0.010249716520683738},{"text":"be illegal! First, a big wild cat needs a lot of space to run","x":0.072016466916299773,"y":0.79788069087940638,"h":0.011773940345368938,"w":0.37448557535807292},{"y":0.81104651156582486,"w":0.39917694091796874,"x":0.069958861296845282,"text":"free. Secondly, the owners often don't know how to look after","h":0.011627906907110019},{"w":0.39506171332465279,"h":0.011773940345368938,"text":"such cats. Their pets don't have the right kind of food, or the","y":0.8226059653650567,"x":0.069958861650430609},{"h":0.013145285086878733,"x":0.072016456697892708,"w":0.38477366129557294,"y":0.83575581396177601,"text":"medical care they need, and many die. Finally, they can be"},{"y":0.85029069796469958,"w":0.26954732259114589,"x":0.072016459465744004,"h":0.01017441816943776,"text":"dangerous to people - it's in their nature!"},{"text":"3 The purpose of this text is to","x":0.10288065968675653,"y":0.87936046512456678,"w":0.21604938083224828,"h":0.013104212714514119},{"w":0.29012346055772564,"x":0.11934156480344164,"text":"A explain how to look after a big wild cat.","h":0.013090522173248242,"y":0.89389534899084577},{"h":0.013081394896215404,"w":0.35390943739149305,"text":"B express an opinion on keeping wild cats as pets.","x":0.1193415834990406,"y":0.90843023276022572},{"y":0.92296511631388678,"h":0.01162790690711013,"w":0.33744856092664932,"text":"C warn people that big wild cats are dangerous.","x":0.11934156878221694},{"x":0.52263374614197522,"h":0.013081394896215293,"text":"SPEAKING","w":0.11111111111111116,"y":0.062500000389828392},{"x":0.52469135794143362,"text":"9","y":0.090116279008670919,"h":0.0087209301803325978,"w":0.010288065804375579},{"x":0.55144033468675646,"y":0.090116279104584529,"w":0.27160493638780381,"h":0.011627906907110019,"text":"Match functions 1-5 with phrases a-j."},{"text":"1 asking for someone's opinion","w":0.22016460842556418,"x":0.54938271488872692,"y":0.10596546337773594,"h":0.013343799058084804},{"w":0.17078189425998258,"x":0.54938271755622259,"h":0.011773940345368938,"text":"2 expressing an opinion","y":0.12205651485839186},{"x":0.54918059386117701,"text":"3 agreeing","w":0.080653042263454822,"h":0.010574692646787232,"y":0.13713251165245188},{"text":"4 disagreeing","x":0.54935782367953023,"y":0.14960284943421343,"w":0.098815214369032178,"h":0.011840812452546756},{"w":0.12962962680392798,"h":0.011821857614083053,"x":0.54938271530173977,"y":0.16405023542280528,"text":"5 agreeing in part"},{"text":"a Absolutely.","x":0.54929532232289147,"y":0.18421861635670655,"h":0.012376720901561167,"w":0.09688260396321613},{"y":0.19897959173152335,"text":"b I don't think so.","x":0.54938271937085059,"w":0.12757201300726995,"h":0.010322733614096746},{"w":0.10493826972113718,"x":0.54938271609107747,"h":0.010336424155362511,"y":0.21350078480217616,"text":"c I'm not sure."},{"w":0.20370369805230037,"x":0.54938271863502952,"h":0.011803603434300647,"text":"d I see what you mean, but ...","y":0.22802197812002956},{"h":0.011817293975566634,"text":"e In my opinion...","y":0.24254317115434498,"w":0.13374485439724393,"x":0.54938271460521892},{"text":"10 Do the task in pairs.","y":0.26452119343020009,"w":0.17489712185329864,"h":0.013095085437481169,"x":0.52469135968377589},{"x":0.76927171897446112,"y":0.18424432448891059,"text":"f It seems to me ...","h":0.012092257594014222,"w":0.14249196370442707},{"y":0.19897959190484871,"h":0.011776221977485402,"x":0.76954732822124972,"text":"g That's right.","w":0.098765428331163196},{"w":0.15432098388671878,"y":0.21220930271540983,"x":0.76954732726960362,"h":0.013081394896215293,"text":"h What do you think?"},{"x":0.76748971736914862,"w":0.18930040147569438,"h":0.013081394896215293,"text":"i You have a point, but ...","y":0.22674418649084582},{"w":0.16666666666666674,"text":"j What's your opinion?","h":0.011627906907110019,"x":0.76748971360082296,"y":0.24127906971504964},{"h":0.0088258916205101734,"y":0.29651162787495,"w":0.074074071248372397,"text":"Student A","x":0.55144033137169868},{"x":0.54938272148698719,"w":0.38477366129557289,"h":0.011627906907110019,"y":0.31976744185894501,"text":"Your class is organising a marathon during Earth Day."},{"w":0.38271603054470482,"h":0.013145285086878844,"text":"• Start the conversation and ask for Student B's opinion.","x":0.54938272656578191,"y":0.33575581396177601},{"text":"• Say you understand, but you don't agree with","h":0.013131593797045982,"y":0.35029069782805511,"x":0.54938272756643036,"w":0.33539093017578125},{"w":0.072016457451714366,"h":0.01017441816943776,"x":0.56584362192572046,"y":0.36482558168562995,"text":"Student B."},{"y":0.37936046515109623,"w":0.24279834323459204,"text":"• Agree partially and explain why.","x":0.54938272543345823,"h":0.011627906907109908},{"h":0.010359241973661337,"text":"Student B","x":0.55144033186552588,"y":0.41860465130772284,"w":0.074074071248372397},{"text":"Your class is organising a marathon during","w":0.30864196777343755,"x":0.54938271595896038,"h":0.011627906907109908,"y":0.44186046518743338},{"x":0.55141286072580831,"w":0.078244238959418455,"y":0.45628893534898829,"h":0.010387245489626551,"text":"Earth Day."},{"h":0.015626195461446835,"y":0.46991465895604878,"x":0.54924862194969848,"w":0.32544226752387151,"text":"• You're not sure about the idea. Explain why."},{"text":"• Present another argument.","x":0.54938271616589385,"h":0.01162790690711013,"y":0.48691860449218138,"w":0.20370369805230026},{"text":"• Agree\/disagree. Explain why.","h":0.011627906907110019,"y":0.50145348837057291,"x":0.54938271911540726,"w":0.22016460842556418},{"x":0.52431334633992821,"h":0.015029176625202423,"w":0.18177459716796873,"text":"11 Describe the picture.","y":0.53828757755929191},{"x":0.82716049409465009,"y":0.63372093011036512,"w":0.05555555555555558,"text":"ALINTE","h":0.017441860360665085},{"h":0.011627906907110019,"text":"WRITING","x":0.52880658250879786,"y":0.78052325589722016,"w":0.090534981621636201},{"text":"12 Read the information about a new shopping centre","y":0.80808477232105147,"w":0.39917694091796874,"x":0.52469136892373158,"h":0.011773940345368938},{"x":0.54938270793714916,"text":"and write a blog post with your opinion.","w":0.29835391574435766,"h":0.011773940345368938,"y":0.82260596528147101},{"y":0.85164835195341748,"text":"Have you heard?","x":0.65637860435591744,"w":0.13991768731011289,"h":0.013343799058084804},{"x":0.57407408227619428,"y":0.86773255827500295,"text":"They're going to destroy Green Park","w":0.30452674018012149,"h":0.013081394896215404},{"x":0.58625271563509163,"w":0.28030224270290793,"y":0.87948269730705808,"text":"and build a new shopping centre!","h":0.018415493718121789},{"x":0.60699589033283496,"y":0.89952904272302792,"w":0.23662550184461806,"text":"What do you think and why?","h":0.014715143051027724},{"y":0.915620093937211,"w":0.3127571953667535,"h":0.013343799058084804,"text":"Comment here or link your blog post.","x":0.57201646925763827},{"w":0.034979423946804533,"y":0.95203488381803969,"h":0.011627906907110019,"x":0.90123456761213572,"text":"107"}]
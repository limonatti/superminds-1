[{"x":0.078189300353985081,"text":"5","y":0.049418604741589212,"w":0.010288065804375537,"h":0.010174418169437871},{"y":0.015988372246659832,"h":0.013081394896215293,"w":0.072016457451714422,"x":0.2613168746692045,"text":"VIDEO"},{"y":0.049418604627840312,"text":"Read Jack's text message and answer the","w":0.30246914333767361,"h":0.011805885066417221,"x":0.10493827086202732},{"text":"questions.","w":0.076229782104492189,"x":0.10488922414712817,"y":0.063791090775225046,"h":0.01195270188000741},{"x":0.10288066277317619,"text":"1 Who is the message for? Jack's mum.","y":0.081240188494680843,"w":0.27160493638780381,"h":0.011783067248118395},{"h":0.013081394896215293,"x":0.10493827643148784,"text":"2 Why does Jack invite Tom?","w":0.20576131184895835,"y":0.094476744248840006},{"h":0.011773940345368938,"text":"He wants to study together with Tom for the test.","w":0.30452674018012155,"x":0.12139918515685268,"y":0.10753532171506475},{"w":0.3127571953667535,"y":0.12205651482205471,"x":0.10493827865407171,"text":"3 What does Jack want his mum to prepare?","h":0.011773940345368938},{"x":0.1193415672100385,"y":0.13372093021892562,"h":0.011627906907110019,"w":0.22427983601888021,"text":"Spaghetti Bolognese and brownies."},{"h":0.017441860360665085,"x":0.43827160499429169,"y":0.013081395546411634,"text":"67","w":0.043209877014160181},{"x":0.088477380567477754,"text":"Mum, we have a big test next week. Can Tom come","h":0.013343799058084804,"y":0.46350078523966964,"w":0.3312757025824653},{"w":0.33950615776909726,"text":"tomorrow so we can study together? Can he stay for","y":0.48110465112493328,"h":0.01162790690711013,"x":0.086419764865451262},{"x":0.088477372370046006,"w":0.32921810574001736,"text":"dinner too? Your spaghetti Bolognese and brownies","h":0.013111058359430494,"y":0.49709302340945061},{"h":0.011773940345368827,"w":0.34362138536241321,"text":"are the best!! © What do I have to get from the shop?","y":0.51452119291287246,"x":0.08847737029890318},{"w":0.32716047498914
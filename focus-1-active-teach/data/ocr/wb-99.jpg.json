[{"h": 0.01896802322098491, "w": 0.18962432861328127, "x": 0.18604651179864945, "text": "SELF-CHECK", "y": 0.018968023137742616}, {"w": 0.24865831163194446, "text": "VOCABULARY AND GRAMMAR", "h": 0.01156798308937126, "x": 0.11270125811962702, "y": 0.07694945847277126}, {"text": "1 One word in each sentence is wrong. Cross out the", "x": 0.10375671616653499, "h": 0.011426464771105508, "y": 0.10364620937446728, "w": 0.3846153767903646}, {"x": 0.12522361487669012, "h": 0.011563417885707956, "y": 0.11760174444221795, "w": 0.2915921359592013, "text": "wrong words and write the correct ones."}, {"y": 0.13387635359905412, "x": 0.14669052435822696, "text": "We're going out for dinner on Saturday.", "h": 0.012955776173285286, "w": 0.2737030368381076}, {"y": 0.14795058181463328, "w": 0.22719139946831599, "h": 0.012645348314774147, "x": 0.14847943669249666, "text": "Have you done a reservation yet?"}, {"x": 0.4543828273559776, "w": 0.03756708357069227, "text": "made", "h": 0.0075872089888644875, "y": 0.15047965123521892}, {"w": 0.2829655626085069, "x": 0.12507333300417486, "y": 0.15946405441479042, "text": "1 We didn't drive from Poland to Austria", "h": 0.013850563579518064}, {"h": 0.010116278651819317, "text": "- we went with train.", "y": 0.17577034904618338, "w": 0.14311269124348958, "x": 0.14669052557682405}, {"y": 0.18962545111917575, "w": 0.29159213595920136, "h": 0.011435595178431925, "x": 0.12343469639129988, "text": "2 We visited all the main signs in the area"}, {"h": 0.012955776173285189, "w": 0.17531305948893228, "text": "and took photos of them.", "y": 0.20218862779314017, "x": 0.14669052074748373}, {"w": 0.3043124389648437, "h": 0.013323864954042874, "x": 0.12332611102809242, "text": "3 We booked three arrangements from our", "y": 0.21618904539443062}, {"h": 0.014133574007220224, "x": 0.1431126930288462, "text": "hotel. They were all interesting, especially", "y": 0.23006317661345915, "w": 0.2880143229166666}, {"text": "the coach trip to a waterfall.", "w": 0.193202141655816, "y": 0.24405523280904204, "x": 0.14490161495026727, "h": 0.01152689700522574}, {"text": "4 We must get to the airport quickly.", "y": 0.2579377257314869, "x": 0.11985688856639715, "w": 0.2629695807562934, "h": 0.013937274368231051}, {"w": 0.18604649861653644, "h": 0.011380813483296684, "text": "Our fly leaves in two hours!", "y": 0.2718750001560624, "x": 0.14669052761480866}, {"w": 0.2969588555230035, "h": 0.01141276953452761, "y": 0.28578488388226153, "text": "5 Have you ever stayed in a young hostel?", "x": 0.12343470709240402}, {"w": 0.01967799504597978, "x": 0.48658318474445195, "h": 0.01138081348329678, "y": 0.3098110466044635, "text": "/5"}, {"text": "2 Look at the definitions and write the words.", "y": 0.3337093860971283, "w": 0.3363148328993056, "h": 0.011508636939396551, "x": 0.09838999383657254}, {"y": 0.347747093242545, "h": 0.011481246091828929, "w": 0.22003577338324654, "text": "Write one letter in each space.", "x": 0.12164580121088114}, {"x": 0.14311269691592796, "h": 0.012709260417235902, "text": "This is a place where you sleep and eat the first", "y": 0.3641860466147787, "w": 0.32379248725043397}, {"text": "meal of the day", "x": 0.14132379313657278, "w": 0.11091233995225697, "y": 0.3780731049257435, "h": 0.01266817395867856}, {"h": 0.014133574007220224, "w": 0.19499104817708335, "y": 0.39181407908829147, "text": "bed and breakfast", "x": 0.14132379450120197}, {"y": 0.40591569779404424, "text": "1", "x": 0.12164579652624977, "h": 0.008851743820341951, "w": 0.008944543202718092}, {"x": 0.13416815501565119, "w": 0.2737030368381076, "y": 0.4059156979356362, "h": 0.012645348314774147, "text": "This is the word for a journey by plane."}, {"w": 0.008944543202718105, "y": 0.43373546535182034, "x": 0.11985688753698322, "h": 0.008851743820341854, "text": "2"}, {"y": 0.43373546539857233, "h": 0.012649913892849175, "w": 0.3023255750868056, "text": "This is a private home where people can pay", "x": 0.14311270188712796}, {"y": 0.4475631768882075, "x": 0.14132379491575078, "w": 0.1627906968858507, "h": 0.011462985651587725, "text": "to stay and have meals."}, {"h": 0.012672739536753588, "y": 0.4754377252761567, "x": 0.12880143470441288, "w": 0.31127010769314234, "text": "This is a kind of ship that carries people and"}, {"text": "sometimes cars across a river or a narrow area", "y": 0.48937500004036943, "h": 0.010116278651819317, "w": 0.31127010769314234, "x": 0.14132379737584996}, {"h": 0.01090062729288092, "text": "of water.", "y": 0.5016281745923725, "x": 0.1411940763191578, "w": 0.05929342057969833}, {"h": 0.008851743820341854, "x": 0.11806797881897738, "text": "4", "w": 0.010733451843261715, "y": 0.5298401163512753}, {"x": 0.1305903345799114, "text": "This is a cheap place to stay and is sometimes", "y": 0.5298401163295315, "w": 0.32379248725043397, "h": 0.012732086061140313}, {"y": 0.5437499997738285, "w": 0.15921288384331594, "h": 0.013909883895075349, "x": 0.13953488092270694, "text": "only for young people."}, {"h": 0.013909883895075253, "x": 0.11627907182569623, "y": 0.5715697673168519, "text": "5 When you go on this kind of holiday, you carry your", "w": 0.37567084418402774}, {"y": 0.5853655237425542, "x": 0.13953488776710377, "w": 0.1967799546983507, "h": 0.012759475785472374, "text": "things in a bag on your back."}, {"x": 0.13774597479625678, "h": 0.010116278651819414, "text": "A", "y": 0.5993895349662414, "w": 0.012522361543443467}, {"x": 0.3738819326195035, "w": 0.05724508073594836, "h": 0.012645348314774147, "text": "holiday", "y": 0.6006540699654327}, {"w": 0.023255814446343337, "x": 0.4812164576963274, "text": "15", "y": 0.6158284881459216, "h": 0.013909883895075253}, {"y": 0.640832513606063, "x": 0.09294190923627184, "w": 0.39730166965060765, "h": 0.013071661133198164, "text": "3 Complete the sentences with one word in each gap."}, {"h": 0.014939335261871755, "y": 0.6533236821491853, "w": 0.2455841742621528, "text": "The first and last letters are given.", "x": 0.11604257316737542}, {"h": 0.012745780548894475, "text": "You don't need to get a brochure to see photos", "y": 0.6727325585588192, "w": 0.32737030029296876, "x": 0.13774597992954415}, {"x": 0.1395348951312166, "text": "of the hotel. They've got a website.", "h": 0.011399074297949709, "w": 0.24150266859266492, "y": 0.6866424421166365}, {"text": "1 The train to the airport leaves from p", "y": 0.7003971119030423, "h": 0.011536027412552254, "x": 0.11449015973389799, "w": 0.27370303683810765}, {"x": 0.45796064367099704, "y": 0.7018168607373171, "w": 0.03220035764906137, "h": 0.010116278651819317, "text": "m 8."}, {"text": "We should get there early because I don't want to", "x": 0.13774598812031413, "h": 0.01145385561867313, "y": 0.7144622094994855, "w": 0.33989264594184027}, {"x": 0.13774597716309397, "text": "miss it.", "w": 0.04651162465413411, "y": 0.7294494584260195, "h": 0.007851985559566801}, {"h": 0.012632275350687701, "x": 0.11435775239601986, "text": "2 The other p", "y": 0.7416562460667517, "w": 0.10223261515299481}, {"x": 0.2842287775729219, "w": 0.22053597344292536, "text": "s on the plane were quite noisy.", "y": 0.7409075904991018, "h": 0.015226847617634742}, {"x": 0.1359570693085565, "h": 0.010207581227436872, "y": 0.756146209436863, "w": 0.2522361246744792, "text": "I think a lot of them knew each other."}, {"y": 0.7698245990203817, "x": 0.11438191878374823, "h": 0.013147497504196434, "w": 0.35259528266059026, "text": "3 We haven't got much money, so we're staying in"}, {"x": 0.13595706753683068, "y": 0.7851985559406492, "text": "a tent on a c", "w": 0.08765652974446614, "h": 0.007851985559566801}, {"y": 0.7840116282002532, "x": 0.2915921274886695, "h": 0.010216711260351466, "w": 0.10196779886881513, "text": "e near the sea."}, {"text": "4 In London, we travelled around by u", "w": 0.2683363003200955, "x": 0.11449017161991644, "y": 0.797761732682664, "h": 0.011540592616215461}, {"text": "d,", "x": 0.45080500917896893, "h": 0.012645348314774147, "y": 0.797921511920738, "w": 0.016100178824530742}, {"y": 0.811831395536513, "x": 0.1359570708708788, "text": "or the Tube as people there call it.", "h": 0.011449290415009921, "w": 0.2325581359863281}, {"y": 0.8256362814136345, "w": 0.15742396036783857, "text": "5 You've got a lot of !", "x": 0.11449016847439913, "h": 0.01148581129549204}, {"text": "e for a three-day trip!", "y": 0.8256362814239494, "w": 0.14847942776150175, "h": 0.0127503461269696, "x": 0.3363148496925943}, {"y": 0.839651163046869, "h": 0.011504071735733246, "text": "I'm only taking a small bag.", "w": 0.18962432861328124, "x": 0.1341681608573426}, {"text": "/5", "x": 0.477638641273969, "y": 0.8586191863819391, "h": 0.010116278651819414, "w": 0.019677995045979835}, {"y": 0.07066787020236992, "text": "4 Complete the dialogue between Jen and her mum", "h": 0.012955776173285189, "w": 0.3846153767903645, "x": 0.5366726374545494}, {"text": "with the words in brackets and the correct form of", "x": 0.5599284474182957, "w": 0.3631484646267361, "y": 0.08597924197054291, "h": 0.010207581227436872}, {"x": 0.5599284558213471, "y": 0.099720216463244, "w": 0.3649373711480034, "h": 0.011558853056456667, "text": "the verbs from the box. There are two extra verbs."}, {"w": 0.275491943359375, "text": "arrive book give go have leave", "x": 0.5778175353566869, "y": 0.12518895396034552, "h": 0.012645348314774147}, {"x": 0.5742397166334231, "y": 0.1378023466891318, "text": "look at make", "w": 0.10733451843261721, "h": 0.010207581227436775}, {"text": "J: Hi, Mum. We/just) We've just arrived at the airport.", "h": 0.013909883895075253, "x": 0.5581395358018933, "w": 0.37388193766276046, "y": 0.16565406964243334}, {"h": 0.014133574007220224, "y": 0.17824007256814217, "x": 0.5563506237333707, "text": "M: (you/the departure board/yet) _", "w": 0.24329159206814244}, {"x": 0.5563506248940415, "y": 0.2061146211753496, "text": "J: Yes, we have. Our plane 2(not/Spain/yet)", "w": 0.2987477620442708, "h": 0.01391444872432664}, {"w": 0.16457960340711808, "x": 0.7835420425182655, "text": ". It's about 5 hours late!", "h": 0.010116278651819317, "y": 0.2212936048095554}, {"y": 0.23393895357517305, "text": "M: Oh no! What are you doing now?", "x": 0.5563506338389679, "w": 0.2522361246744792, "h": 0.013909883895075349}, {"x": 0.5581395390751208, "text": "J: Well, we're waiting with all the other passengers", "y": 0.2477301443711653, "w": 0.35241502549913195, "h": 0.012955776173285189}, {"w": 0.3416815524631076, "h": 0.012754910956220987, "text": "Someone from the airline is here. Wait a minute...", "x": 0.5813953571539561, "y": 0.26049418614966235}, {"x": 0.5778175330925266, "y": 0.27566860491238043, "text": "(She/just)", "w": 0.07155634562174484, "h": 0.01264534831477405}, {"y": 0.27440406987059257, "text": "us £10 for food", "x": 0.8372093023322588, "h": 0.012645348314774147, "w": 0.10733452690972223}, {"y": 0.28957848855976875, "h": 0.011545157819878766, "x": 0.5796064563754332, "w": 0.343470458984375, "text": "We can check in our bags and go through security"}, {"h": 0.012645348314774147, "text": "and spend the money after that. That's good", "w": 0.30411448160807286, "x": 0.5796064446461722, "y": 0.30222383725976404}, {"x": 0.5778175380991852, "h": 0.012645348314774147, "w": 0.1431126912434897, "text": "*(l/not/breakfast/yet)", "y": 0.3161337211282234}, {"x": 0.579318762625804, "w": 0.2742061530219184, "y": 0.32748979191247585, "h": 0.016461590498363106, "text": "I'm worried about our transport in Spain"}, {"text": "(We/already)", "x": 0.5760286228686937, "h": 0.012645348314774147, "y": 0.3439534885068571, "w": 0.09660107082790792}, {"y": 0.3578633723070435, "text": "seats on the 14.38 train from Madrid to Ronda. I don't", "x": 0.5778175493668161, "w": 0.3703040907118056, "h": 0.011572548293034566}, {"text": "think we can use them on any other train.", "w": 0.282929195827908, "h": 0.013188679812186853, "x": 0.577689915409283, "y": 0.37076539758821325}, {"text": "M: Don't worry about that now. Ask the woman from the", "x": 0.5563506266275265, "y": 0.3855324908122356, "w": 0.3828264702690972, "h": 0.011531462583300867}, {"text": "airline and phone me later when you know more.", "x": 0.5778175321300032, "y": 0.39959302355413645, "h": 0.011458420447924517, "w": 0.33452592637803813}, {"text": "J: OK, bye Mum.", "x": 0.5527728132386305, "y": 0.41340703980780225, "h": 0.012741215719642991, "w": 0.1270125155978732}, {"x": 0.9212880152453464, "w": 0.01967799504597978, "y": 0.431206395536513, "h": 0.011380813483296684, "text": "/5"}, {"x": 0.5295169947827828, "w": 0.014311270183987146, "y": 0.4615552327038867, "h": 0.010116278651819414, "text": "5"}, {"h": 0.01152689700522574, "y": 0.461555232814311, "w": 0.40071553548177086, "x": 0.54382827209215, "text": "Complete the dialogue with the phrases from the box."}, {"text": "There are five extra phrases.", "y": 0.47543772562866193, "w": 0.20393559773763015, "h": 0.011408204330864305, "x": 0.5545617201651741}, {"y": 0.5005640794167825, "w": 0.32915920681423605, "h": 0.011572548293034468, "text": "Did you enjoy did you go Have you enjoyed", "x": 0.570661895984653}, {"y": 0.5146656979474504, "text": "Have you ever travelled have you gone I did", "h": 0.011417334363778996, "w": 0.33094811333550345, "x": 0.5706618970889568}, {"x": 0.5706618978623779, "y": 0.52843862802596, "text": "I have", "w": 0.05187835269504126, "h": 0.009029783393501837}, {"w": 0.2933810424804687, "x": 0.6243291602445599, "y": 0.5284386283675473, "text": "We have been We have slept We slept", "h": 0.014133574007220224}, {"h": 0.008851743820341951, "text": "We went", "x": 0.5706618971809923, "w": 0.06440071529812286, "y": 0.5424854652517113}, {"x": 0.5527728100822253, "y": 0.5690406980519972, "h": 0.010116278651819317, "w": 0.03935599009195956, "text": "Ross:"}, {"w": 0.05165309482150604, "y": 0.5834349394761953, "x": 0.55011481101865, "text": "Henry:", "h": 0.011522417541875654}, {"y": 0.596860465283102, "h": 0.010116278651819317, "text": "Ross:", "x": 0.5527728106188979, "w": 0.03935599009195967}, {"h": 0.014532207306541731, "w": 0.05248703002929689, "x": 0.5497690285860478, "y": 0.6099462697761006, "text": "Henry:"}, {"y": 0.5688763536243447, "h": 0.012955776173285189, "x": 0.6189624290517066, "w": 0.22719141642252605, "text": "Have you ever travelled by ferry?"}, {"text": "Yes,", "w": 0.02862254036797418, "x": 0.618962433095679, "h": 0.011380813483296684, "y": 0.5829505815988313}, {"h": 0.015194634719876173, "y": 0.5949535548690007, "text": "Really? Where?", "x": 0.6188057212790355, "w": 0.1094368574354384}, {"y": 0.5829505816464741, "x": 0.8032200373972617, "w": 0.05187835269504126, "h": 0.010266927377411581, "text": ". Once."}, {"w": 0.008944543202718092, "y": 0.5968604651516023, "text": "?", "x": 0.8711985690963153, "h": 0.008851743820341854}, {"y": 0.6107703490271431, "x": 0.7692307706471426, "w": 0.10912343343098951, "text": "from Holland to", "h": 0.011499506532070037}, {"w": 0.05903398725721565, "x": 0.6189624345109271, "text": "England", "y": 0.6246802327434849, "h": 0.012645348314774147}, {"w": 0.03756708357069227, "h": 0.008851743820341951, "x": 0.5527728092164427, "text": "Ross:", "y": 0.638590116423986}, {"text": "Henry:", "x": 0.5501281472108378, "y": 0.6531506737400958, "h": 0.011779338952005954, "w": 0.05141971588134764}, {"text": "it or was it boring?", "y": 0.6385901166667409, "w": 0.130590337117513, "h": 0.012732085312316574, "x": 0.767441862979705}, {"w": 0.1610017903645834, "y": 0.6512354652194298, "h": 0.012649913892849272, "text": "It wasn't boring at all. S", "x": 0.6171735252112681}, {"w": 0.28443647596571187, "h": 0.011549722649130153, "text": "on the boat and, in the morning, we were", "y": 0.6662409747269659, "x": 0.6189624465430832}, {"x": 0.6153846151589539, "w": 0.08228980170355904, "text": "in England.", "y": 0.6790552322971934, "h": 0.013909883895075253}, {"h": 0.010116278651819317, "text": "/5", "x": 0.9159212885384292, "y": 0.6980232560861543, "w": 0.01967799504597978}, {"h": 0.011440160007683409, "x": 0.5277280896269009, "text": "6 Choose the correct option.", "w": 0.21645796034071185, "y": 0.7219900722942847}, {"y": 0.7396570396222395, "w": 0.2379248555501302, "x": 0.5706619037395442, "h": 0.011476681262577447, "text": "Oh no! The train has just/ yet left!"}, {"h": 0.011558853056456667, "y": 0.7522202164969649, "x": 0.570661906827479, "text": "I've been to / at Rome, but not Venice.", "w": 0.2665473937988282}, {"y": 0.7675726745247538, "h": 0.0075872089888644875, "x": 0.5491949910082996, "text": "2", "w": 0.010733452902899843}, {"y": 0.7814825582014253, "h": 0.0075872089888644875, "x": 0.5491949913011454, "w": 0.008944543202718203, "text": "3"}, {"text": "Has Tim ever / never travelled to a foreign country?", "x": 0.5706619010921155, "w": 0.35241502549913195, "h": 0.012645348314774242, "y": 0.7663081396380343}, {"text": "We haven't booked our accommodation already / yet.", "x": 0.5705411757932981, "w": 0.36878814697265627, "h": 0.015359178243561325, "y": 0.7778753253613859}, {"w": 0.3649373711480035, "h": 0.012663609129427076, "x": 0.570661898802862, "y": 0.7941279070272059, "text": "They've already / yet visited the most important sights."}, {"h": 0.014133574007220224, "x": 0.5688729919847046, "y": 0.8079693142538389, "text": "Sally bought / has bought a guidebook last week.", "w": 0.3381037394205729}, {"text": "/5", "y": 0.8358575582608225, "h": 0.01138081348329678, "w": 0.017889086405436183, "x": 0.9141323798742049}, {"y": 0.9345930233487705, "h": 0.01162790690711013, "x": 0.09259259281662928, "w": 0.0246913570827908, "text": "94"}]
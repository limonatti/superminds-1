[{"x": 0.10733452579085391, "text": "4.", "y": 0.05184593042122786, "w": 0.032200357649061415, "h": 0.017703487640683805}, {"y": 0.02023255845465804, "w": 0.17531305948893228, "h": 0.017703487640683902, "x": 0.21645796216966623, "text": "GRAMMAR"}, {"h": 0.012645348314774242, "x": 0.2146690538514506, "y": 0.06196220972160996, "text": "Comparative and", "w": 0.13237924363878037}, {"y": 0.07577166064937403, "x": 0.21288014713777506, "w": 0.1663685099283854, "h": 0.014133574007220224, "text": "superlative adjectives"}, {"x": 0.07871198570860027, "h": 0.011380813483296684, "text": "2", "y": 0.2567005817727049, "w": 0.012522361543443467}, {"x": 0.075134168154933, "w": 0.012522361543443467, "h": 0.01138081348329678, "text": "3", "y": 0.5652470933721597}, {"w": 0.21109122382269968, "x": 0.09481217134957527, "text": "SHOW WHAT YOU KNOW", "y": 0.13387635388411753, "h": 0.011545157445466848}, {"y": 0.16175090271497425, "x": 0.08586762280910111, "w": 0.24329159206814238, "h": 0.012754910956220987, "text": "1 Write the opposite adjectives."}, {"h": 0.013332290718271397, "y": 0.1779559474495537, "w": 0.10749237908257378, "text": "serious * funny", "x": 0.12335577885193225}, {"h": 0.010116278651819317, "text": "1", "y": 0.19347383758688097, "w": 0.008944543202718105, "x": 0.10554561757574292}, {"x": 0.11627907198431732, "text": "fat", "h": 0.010116278651819317, "w": 0.042933807373046876, "y": 0.19347383741827634}, {"text": "2 far =", "y": 0.20730175972400225, "h": 0.010280201026248574, "x": 0.10551270062461252, "w": 0.050155279371473516}, {"x": 0.10373387391102382, "y": 0.2212157623369982, "w": 0.08591328938802084, "h": 0.012801033254134545, "text": "3 difficult *"}, {"text": "4 intelligent + _", "x": 0.28428264212616555, "h": 0.014070842050903533, "y": 0.1927610907105368, "w": 0.11122005038791233}, {"x": 0.28264758635180726, "text": "5 good-looking *", "w": 0.14847942776150175, "y": 0.20847021691519016, "h": 0.014133574007220224}, {"h": 0.012645348314774147, "x": 0.28443649771595064, "text": "6 interesting +_", "y": 0.2225581398382525, "w": 0.1180679745144314}, {"x": 0.10184296075874348, "w": 0.31510291205512153, "text": "* Complete the dialogue with the correct", "y": 0.2553505932810614, "h": 0.016170519732396138}, {"x": 0.10375671145918927, "h": 0.01275491095622089, "y": 0.2705009027360499, "w": 0.35062611897786455, "text": "comparative form of the adjectives in brackets."}, {"y": 0.28816786979807896, "x": 0.1037567149972833, "h": 0.014133574007220224, "w": 0.35778174506293403, "text": "Emily: Two boys want to go to the end of school"}, {"x": 0.16994633473799353, "y": 0.30347924189467085, "text": "dance with me.", "w": 0.10912343343098957, "h": 0.010207581227436775}, {"y": 0.3172202165762211, "x": 0.10554562090031791, "h": 0.010294318224979204, "w": 0.10554561191134984, "text": "Kirsten: Who?"}, {"text": "Emily:", "w": 0.05008944617377388, "x": 0.10375670866624366, "y": 0.3313081397328746, "h": 0.01264534831477405}, {"text": "Wayne and Theo.", "x": 0.16994633786616964, "h": 0.01143102997476862, "y": 0.331308139748904, "w": 0.11985688103569875}, {"y": 0.34509476532865274, "x": 0.10196779236810294, "text": "Kirsten: Well, go with Wayne. He's better-looking", "h": 0.014133574007220224, "w": 0.34525939941406253}, {"y": 0.35912790711150827, "w": 0.23076922946506073, "text": "(good-looking) than Theo. He's '", "x": 0.16815742846961618, "h": 0.012663609129427076}, {"text": "(thin) too.", "y": 0.37414711187459027, "w": 0.07155634562174479, "h": 0.011536027412552254, "x": 0.16636851842347464}, {"y": 0.388212209668921, "h": 0.012645348314774242, "text": "Emily:", "w": 0.04651162889268662, "x": 0.10196779944751477}, {"text": "Well, Theo isn't fat! Anyway, Wayne is", "x": 0.16636851667590621, "y": 0.3882122091520263, "h": 0.013909883895075253, "w": 0.2683363172743055}, {"y": 0.40319945830384624, "text": "(boring) than Theo. Theo is", "h": 0.011567983463783179, "w": 0.1914132351345486, "x": 0.27370304139963086}, {"text": "(funny) than Wayne and he's", "x": 0.270125219638141, "w": 0.20035778469509546, "y": 0.417296511920738, "h": 0.01264534831477405}, {"x": 0.2700772108856761, "y": 0.4310936032897491, "w": 0.059130015903049005, "h": 0.012870932950870113, "text": "(clever)."}, {"w": 0.05931357489691838, "text": "Kirsten:", "x": 0.10182800627544789, "y": 0.44474297372300603, "h": 0.012127424405369984}, {"x": 0.1641653506019006, "h": 0.015690974535064163, "text": "... so, go with Theo.", "y": 0.44394602726765287, "w": 0.1473331027560764}, {"text": "Emily:", "x": 0.10017889152379224, "h": 0.012645348314774147, "w": 0.048300535413954, "y": 0.45902616292546183}, {"w": 0.2683363003200955, "text": "Well.... Wayne has a lot of friends. He's", "x": 0.16815742950602272, "h": 0.012722955653813704, "y": 0.45894855592363143}, {"w": 0.2039355977376302, "x": 0.2719141365515783, "y": 0.4742005815621718, "text": "(sociable) than Theo. Theo is", "h": 0.010266927377411581}, {"text": "(shy). Maybe it's better to go", "w": 0.20393559773763026, "h": 0.01275491095622089, "x": 0.2701252264263548, "y": 0.48800090268546853}, {"w": 0.3023255750868056, "h": 0.013909883895075253, "text": "to the dance with Wayne, but it's a difficult", "x": 0.16457961211372296, "y": 0.5020203486763722}, {"w": 0.06268245697021485, "x": 0.16812209992871377, "text": "decision.", "y": 0.5170844970002608, "h": 0.010336819960322154}, {"text": "Kirsten: Yes, but it's less difficult than deciding what to", "y": 0.5287674561753851, "w": 0.38657867431640625, "h": 0.014072296266521385, "x": 0.1018912273042416}, {"w": 0.1663685099283854, "h": 0.012732085312316574, "text": "wear. That's impossible!", "x": 0.16636851650271253, "y": 0.5449277979366403}, {"y": 0.5652470931100568, "text": "Complete the sentences with the correct forms", "x": 0.1377459712355758, "w": 0.3506261189778646, "h": 0.013909883895075253}, {"text": "of the adjectives in capitals.", "x": 0.09838998834391709, "y": 0.5802617331053268, "w": 0.20930231730143228, "h": 0.012955776173285286}, {"x": 0.1234347143183163, "text": "My mum is older than my dad but the oldest person", "y": 0.598125000086801, "w": 0.36672627766927085, "h": 0.013937274368231051}, {"x": 0.12164578929508536, "text": "in our family is my dad's grandmother. She's 98. OLD", "h": 0.013909883895075253, "w": 0.37209303114149306, "y": 0.6120348834947589}, {"text": "1", "x": 0.10017889109989318, "y": 0.6272093023609047, "w": 0.008944543202718105, "h": 0.008851743820341854}, {"text": "Harry isn't shy at all - he's the", "h": 0.01272752048306509, "x": 0.12343471123162367, "y": 0.6272093025235722, "w": 0.19677995469835072}, {"w": 0.02862254036797418, "x": 0.44722719164069985, "h": 0.012645348314774147, "text": "boy", "y": 0.6272093025362175}, {"x": 0.1234347107284242, "y": 0.6411146209506596, "text": "in our class. In fact, he's", "h": 0.010207581227436775, "w": 0.1574239603678385}, {"x": 0.39725409629532576, "y": 0.6376158012818378, "w": 0.07044385698106553, "h": 0.017869331122305415, "text": "_ than our"}, {"y": 0.6548555957068055, "w": 0.15921288384331594, "h": 0.011554287852793362, "x": 0.11985688412187216, "text": "teachers! CONFIDENT"}, {"h": 0.01025779697008507, "text": "2 I'm not", "x": 0.09838998297189411, "y": 0.6689389537732182, "w": 0.07692307366265191}, {"x": 0.3023255844853704, "y": 0.6701669674945548, "text": "than my mum. She's the", "w": 0.16815741644965276, "h": 0.011417334738190817}, {"x": 0.2486583146291965, "w": 0.2003577846950955, "y": 0.6841133724703792, "h": 0.011572548293034566, "text": "person in the house. SHORT"}, {"w": 0.10196779886881512, "x": 0.09660107271228298, "h": 0.011403639127201192, "y": 0.6980232561122759, "text": "3 Who is the"}, {"h": 0.013909883895075253, "y": 0.6980232558153984, "text": "person in my family? My", "w": 0.17173524644639754, "x": 0.3255813911596277}, {"text": "baby sister. My brother Tom is", "y": 0.711782491286854, "w": 0.21288013034396708, "h": 0.012955776173285189, "x": 0.12164579983248887}, {"h": 0.010116278651819317, "y": 0.7131976745854275, "w": 0.033989266289605025, "x": 0.45974955318495303, "text": "than"}, {"y": 0.7270938628268676, "w": 0.3363148328993055, "text": "me - he's ten and I'm twelve years old. YOUNG", "h": 0.011394509094286501, "x": 0.12164579798087813}, {"w": 0.11091233995225694, "y": 0.7408348376248768, "x": 0.09838998479429487, "text": "4 l'd like to be", "h": 0.01029888305423059}, {"x": 0.3398926718327279, "w": 0.1592128668891059, "h": 0.011563417885708053, "y": 0.7408348375034692, "text": "than I am but I'll never"}, {"text": "be the", "y": 0.7561462093222238, "x": 0.12164579603666204, "w": 0.046511628892686646, "h": 0.00902978339350174}, {"y": 0.7549273256318572, "w": 0.17889087253146702, "h": 0.012645348314774147, "text": "person in my class. Seven", "x": 0.29874776462872094}, {"x": 0.11985688533789243, "w": 0.2844364929199219, "text": "people play sports for school teams. FIT", "h": 0.012741215719643087, "y": 0.7701017445315663}, {"y": 0.7840116280266023, "h": 0.008851743820341951, "w": 0.010733451843261715, "text": "5", "x": 0.0983899826651312}, {"h": 0.013430476481303362, "y": 0.7836190639659069, "x": 0.1196980236630728, "w": 0.06114062415228949, "text": "Ela's got"}, {"y": 0.7840116280617565, "h": 0.010216711260351466, "text": "hair than me. She's", "x": 0.3094812176433543, "w": 0.12880143059624566}, {"x": 0.11985688759278411, "text": "got the", "h": 0.012709260417235902, "y": 0.7991860466969734, "w": 0.05366726345486113}, {"y": 0.7977617329622357, "x": 0.2969588626594217, "w": 0.19856886121961803, "h": 0.01154059224180364, "text": "hair in our class. Some of the"}, {"text": "boys call her 'Rapunzel' but she doesn't mind. LONG", "h": 0.012668173958678463, "x": 0.11985689321465151, "w": 0.3649373711480035, "y": 0.8130731048860009}, {"w": 0.014311270183987146, "y": 0.035406976847336735, "x": 0.5330948120457524, "h": 0.012645348314774147, "text": "4"}, {"y": 0.03667151190010776, "text": "*", "w": 0.014311270183987146, "x": 0.5581395346754483, "h": 0.010116278651819317}, {"x": 0.5760286172457425, "text": "* Complete the email with the correct form of the", "w": 0.37745975070529514, "y": 0.036511733162231046, "h": 0.012955776173285189}, {"y": 0.050581395610054744, "w": 0.16815741644965276, "h": 0.012645348314774242, "x": 0.556350631980898, "text": "adjectives in brackets."}, {"y": 0.08767807120984597, "w": 0.07441554599338107, "text": "Hi Eleanor,", "x": 0.5433504776117493, "h": 0.012377977069964899}, {"h": 0.0127366508903917, "text": "How are you? Life here at university is great. The best (good)", "x": 0.5420393547781628, "y": 0.10622093042151656, "w": 0.39892666286892364}, {"x": 0.5402504441323464, "text": "thing about it is that we've got a lot of free time! I like the", "w": 0.3810375637478298, "h": 0.012645348314774147, "y": 0.12013081424631936}, {"x": 0.5402504446016679, "h": 0.011458420447924517, "y": 0.13269855612439244, "w": 0.20393559773763026, "text": "lessons too. The lecturers are 1"}, {"y": 0.146686046646392, "x": 0.5420393673159905, "h": 0.012709260417235902, "text": "than our teachers at school and they are?", "w": 0.28085866292317707}, {"text": "(interesting)", "x": 0.8389982121666566, "y": 0.1340406978091827, "w": 0.08407870822482644, "h": 0.012645348314774147}, {"y": 0.1605731043624824, "text": "(friendly) too. The 3", "x": 0.5402504508460839, "h": 0.013932709538979664, "w": 0.1323792436387803}, {"text": "(nice) lecturer is our", "y": 0.16312500037735597, "x": 0.7656529546382229, "w": 0.1341681501600478, "h": 0.01138081348329678}, {"h": 0.013909883895075253, "y": 0.1757703485762632, "text": "psychology teacher. She's great.", "x": 0.5420393614074235, "w": 0.20930231730143223}, {"y": 0.19220930242873208, "h": 0.012727520483065188, "text": "The *", "x": 0.5402504477271762, "w": 0.03756708357069227}, {"w": 0.2540250311957465, "x": 0.6726297041695686, "h": 0.013909883895075253, "text": "(bad) thing about university is that we", "y": 0.19347383694835626}, {"x": 0.5402504527191081, "text": "have lectures at 8 a.m. every day. The other problem is my", "y": 0.2072924188424927, "h": 0.014133574007220224, "w": 0.38103756374782993}, {"x": 0.5401664093493039, "h": 0.01314107858747358, "y": 0.22104573964607252, "w": 0.07351333618164058, "text": "room. It's s"}, {"w": 0.23076922946506084, "x": 0.708407874158346, "y": 0.2225581397708106, "text": "(small) than my bedroom at home.", "h": 0.012645348314774147}, {"h": 0.011380813483296684, "w": 0.03220035764906137, "text": "It's", "x": 0.5402504476960417, "y": 0.23646802338026296}, {"x": 0.6672629749755101, "y": 0.23634476558842543, "h": 0.012955776173285189, "w": 0.261180674235026, "text": "(tidy) too because my mother isn't here"}, {"y": 0.250377907079895, "h": 0.012663609129427076, "w": 0.3881931898328994, "text": "to tell me to put things away! It's a bit unfair because some", "x": 0.540250449336681}, {"x": 0.5420393594727582, "text": "of the rooms here are 7", "y": 0.2630232559352412, "h": 0.011403639501613013, "w": 0.1520572408040365}, {"y": 0.26421931428861367, "x": 0.7889087643124514, "h": 0.014133574007220224, "text": "(big) than the one I've", "w": 0.1484794277615017}, {"text": "got. Oh well. How is everything with you? Hope your marks", "y": 0.27946220950031636, "w": 0.3864042833116319, "h": 0.012645348314774147, "x": 0.54025045548193}, {"y": 0.29210755827429896, "h": 0.012645348314774147, "text": "are", "w": 0.03577817281087248, "x": 0.5384615398557444}, {"text": ". (good) than last year!", "h": 0.012745781297718117, "w": 0.1466905212402344, "x": 0.6654740577609204, "y": 0.2932716603963696}, {"h": 0.011934191573828232, "w": 0.09315570407443574, "x": 0.5419731327926522, "y": 0.31079889237979025, "text": "See you soon,"}, {"y": 0.32217182821015394, "h": 0.014479018359408067, "x": 0.5401185600022257, "w": 0.059297765096028576, "text": "Beverley"}, {"text": "5", "w": 0.010733451843261688, "x": 0.5313059036848092, "h": 0.010116278651819317, "y": 0.3578633721755438}, {"h": 0.008851743820341951, "y": 0.4046511628260209, "text": "1", "x": 0.5545617175757429, "w": 0.008944543202718092}, {"y": 0.35648014442174664, "x": 0.5957066173064053, "w": 0.3166368611653646, "h": 0.012955776173285189, "text": "* Use the prompts to make full sentences."}, {"w": 0.37567084418402774, "y": 0.3755668606369853, "text": "The boy in that photo isn't Desmond. Desmond has got", "x": 0.5796064446342829, "h": 0.011536027412552349}, {"y": 0.38945848408056477, "x": 0.5778175238117327, "w": 0.37388193766276046, "text": "darker hair than him (Desmond / got / dark / hair / him)", "h": 0.013928143960904539}, {"w": 0.3667262776692708, "x": 0.5778175455347742, "text": "I want Craig to win the school prize for best student.", "y": 0.4031994581560946, "h": 0.012955776173285189}, {"w": 0.2576028611924913, "h": 0.014133574007220224, "x": 0.5742397165236113, "text": "(He / clever / boy / in the school). _", "y": 0.43107400758613845}, {"text": "(He / friendly / the other people) who are trying to win too.", "x": 0.5742397302925765, "y": 0.4615552327877438, "h": 0.012704694839160775, "w": 0.3703040907118056}, {"text": "2", "y": 0.47546511637190547, "w": 0.012522361543443439, "h": 0.01138081348329678, "x": 0.5509838996620886}, {"w": 0.37388193766276034, "y": 0.47420058135569637, "h": 0.013909883895075253, "text": "We've got a book to read for English. The book I'm", "x": 0.565295162452162}, {"w": 0.06802154541015626, "h": 0.012761258734692821, "text": "reading.", "y": 0.48931704489212396, "x": 0.5760071170081551}, {"x": 0.5742397168259156, "w": 0.35062611897786455, "text": "(funny / and / interesting / book we are studying).", "y": 0.5044900723161915, "h": 0.012704694839160775}, {"h": 0.014133574007220224, "text": "Why do they always choose b", "x": 0.5742397152982999, "y": 0.5170532494583541, "w": 0.20930231730143234}, {"h": 0.01391444872432664, "x": 0.6887298782216847, "text": "(boring / books in the world) to read?", "w": 0.2647584872775608, "y": 0.5323646212692864}, {"y": 0.5475436047549818, "w": 0.010733451843261688, "x": 0.5527728090962583, "h": 0.008851743820341854, "text": "3"}, {"h": 0.014133574007220224, "y": 0.5461055957010912, "x": 0.574239717633155, "text": "Tim: Look at that dog. *", "w": 0.17173522949218756}, {"y": 0.5601889532274261, "h": 0.013909883895075253, "x": 0.7298747833747659, "text": "(That / ugly / dog in the world!)", "w": 0.22361358642578122}, {"y": 0.575363372396392, "h": 0.012750346126969504, "x": 0.5742397122405272, "w": 0.1413237931993273, "text": "Phil: That's my dog!"}, {"text": "Tim: What? Oh, sorry. Sometimes'_", "x": 0.5740785890853772, "w": 0.25802764892578123, "h": 0.016579823769386857, "y": 0.5878188944346836}, {"text": "(I / stupid / person I know!", "x": 0.7620751347359457, "w": 0.19141323513454866, "h": 0.01651199531899461, "y": 0.600654069527126}, {"w": 0.3631484646267361, "h": 0.011394509094286404, "x": 0.5760286269144198, "y": 0.6183438627952544, "text": "Phil: Don't worry. I agree, he is a bit strange-looking"}, {"h": 0.012955776173285286, "x": 0.5688729906399115, "y": 0.6320848377192714, "text": "but he's really friendly.", "w": 0.16457960340711808}, {"text": "SHOW WHAT YOU'VE LEARNT", "y": 0.6638808141253575, "h": 0.011389943890623196, "w": 0.24865831163194452, "x": 0.5402504531106824}, {"y": 0.6917005817727049, "x": 0.5330948146153516, "text": "6 Find the word that is wrong in each sentence and", "w": 0.3810375637478298, "h": 0.011444725211346617}, {"h": 0.011490376124743525, "w": 0.2576028611924913, "text": "correct it. One sentence is correct.", "x": 0.5509839035719116, "y": 0.7055009026941214}, {"h": 0.011526897005225837, "text": "You look different. Your hair is shortest than", "x": 0.5688729976996916, "y": 0.72316787014885, "w": 0.30948120117187494}, {"text": "before. shorter", "y": 0.7372238373440664, "h": 0.012645348314774147, "x": 0.5688729885569663, "w": 0.11091233995225702}, {"w": 0.008944543202718092, "h": 0.008851743820341854, "x": 0.5509839002456892, "text": "1", "y": 0.7523982559493858}, {"x": 0.570661896853517, "y": 0.7522202165233095, "text": "This is, without doubt, the worse day", "w": 0.2629695807562934, "h": 0.01155885305645657}, {"text": "of my life.", "w": 0.0772635904947917, "x": 0.5687027314615708, "y": 0.7657694217869937, "h": 0.013722784304016326}, {"h": 0.008851743820341854, "w": 0.010733451843261799, "x": 0.5491949915202295, "text": "2", "y": 0.7814825584330339}, {"w": 0.008944543202718092, "text": "3", "h": 0.008851743820341854, "x": 0.5509839002084203, "y": 0.7953924419906285}, {"text": "Who is the kinder person in your class?", "x": 0.5706619050239005, "h": 0.012955776173285189, "y": 0.7800947654282511, "w": 0.2772808498806424}, {"x": 0.5706619037147789, "h": 0.011399074297949806, "y": 0.7953924421334969, "w": 0.3416815524631076, "text": "Don't worry about what Chloe says. You're much"}, {"y": 0.8091471118611139, "x": 0.5706619035457361, "text": "more cleverer than she is.", "h": 0.010271492581074886, "w": 0.18246868557400175}, {"y": 0.8232122095129619, "w": 0.35599283854166663, "h": 0.012645348314774147, "x": 0.54919499752702, "text": "4 This year at school is less difficult than last year."}, {"x": 0.5688729889753305, "w": 0.22898032294379334, "text": "Maybe I'm less shy than before!", "h": 0.014133574007220128, "y": 0.8370216605281895}, {"w": 0.34883721245659727, "x": 0.5474060842010394, "y": 0.8522965118385433, "text": "5 After my holiday, I want to be slimer than 1 am", "h": 0.012645348314774147}, {"h": 0.013081394896215404, "text": "50", "y": 0.9447674422502935, "x": 0.0781893008310326, "w": 0.0246913570827908}, {"w": 0.30864196777343744, "h": 0.011773940345368827, "text": "6 This lake looks narower on the map than", "x": 0.5493827236750096, "y": 0.8806907378305547}, {"y": 0.8952119309156243, "text": "that one.", "x": 0.5720164638324418, "w": 0.07201645745171437, "h": 0.010311324704947222}, {"w": 0.020576131608751047, "x": 0.9115226339898632, "h": 0.013081394896215293, "y": 0.8953488375991306, "text": "16"}, {"w": 0.30041151258680554, "x": 0.5864197618650333, "h": 0.011773940345368938, "text"
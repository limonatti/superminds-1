46062804}, {"h": 0.012955776173285189, "text": "How 5", "x": 0.10017889145246445, "y": 0.5119494588100781, "w": 0.04114490085177952}, {"text": "? How's •", "y": 0.5119494588100781, "h": 0.012955776173285189, "x": 0.23613595750311012, "w": 0.06082289801703561}, {"w": 0.07155634562174479, "h": 0.008851743820341854, "x": 0.39355993166139946, "text": "? What are", "y": 0.513401162935614}, {"x": 0.09776931006231096, "y": 0.5273596819135696, "text": "YOu 7", "w": 0.04052853478325738, "h": 0.014833968279594175}, {"text": "? How are Beth and Fiona and the", "w": 0.2218246799045139, "x": 0.23255814527135657, "y": 0.5284386280647271, "h": 0.01025323214083378}, {"x": 0.09838998908692853, "text": "other girls? Do you still go to the disco every Friday? What", "y": 0.542485464855333, "w": 0.38461537679036456, "h": 0.013909883895075349}, {"y": 0.5570771548309887, "w": 0.06808343675401476, "h": 0.01534649916073906, "x": 0.09933710576755658, "text": "are your 8"}, {"h": 0.010116278651819317, "x": 0.2611806853425655, "y": 0.5589244189400787, "text": "for the summer? Can you come to", "w": 0.22361358642578127}, {"y": 0.5739801445853051, "x": 0.10017889145477003, "w": 0.11806797451443142, "h": 0.011499506532070037, "text": "Spain to visit me?"}, {"x": 0.09660107405572206, "h": 0.01138081348329678, "text": "1°", "y": 0.59053779079051, "w": 0.01967799504597982}, {"x": 0.09838998253652613, "w": 0.023255812327067055, "h": 0.009029783393501837, "text": "/ 10", "y": 0.6069584836174725}, {"w": 0.13595706515842013, "x": 0.2110912346390368, "text": "to hear all your news.", "y": 0.5916471117449754, "h": 0.011536027412552254}, {"y": 0.6052072508100091, "x": 0.2160045269892205, "w": 0.11167952643500434, "h": 0.013370327966738283, "text": "you all - but not"}, {"h": 0.012681869195256459, "y": 0.6221511629570751, "w": 0.1127012464735243, "text": "English weather!", "x": 0.0983899864009838}, {"h": 0.011558852682044748, "text": "Write \"", "y": 0.6434702167396544, "w": 0.0536672634548611, "x": 0.098
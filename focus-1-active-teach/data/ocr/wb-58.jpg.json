[{"y": 0.06575581402018782, "h": 0.008851743831354012, "w": 0.010544815063476556, "text": "3", "x": 0.09490333930481708}, {"h": 0.010395220588235306, "y": 0.06556985277051212, "x": 0.10720562481524282, "w": 0.37961334228515625, "text": "Look at the words in bold in the text and match them"}, {"y": 0.0795634191993808, "h": 0.011594669117647042, "text": "with the definitions.", "x": 0.11599297249839051, "w": 0.14235500759548608}, {"x": 0.14059754524143267, "text": "put on clothes to see how they look or fit", "h": 0.011594669117647042, "y": 0.09595588217443937, "w": 0.26889278835720487}, {"y": 0.09863372131383813, "x": 0.4288224962674696, "w": 0.04042179107666016, "h": 0.010116278555463274, "text": "try on"}, {"text": "1", "h": 0.008851743831354012, "x": 0.11775043944704296, "w": 0.008787345886230466, "y": 0.11001453491353808}, {"w": 0.27065026177300344, "y": 0.10994944838534931, "x": 0.13708259746733556, "h": 0.012794118028353271, "text": "return something to a shop because you"}, {"y": 0.12392441849708788, "text": "don't want to keep it", "w": 0.13884006924099393, "x": 0.14059754146034656, "h": 0.01138081404216152}, {"x": 0.11775043970024765, "text": "2", "w": 0.01054481506347657, "y": 0.1378343024238942, "h": 0.008851743831354012}, {"y": 0.13656976741410304, "w": 0.2776801384819878, "h": 0.012645348766270784, "x": 0.13005272860610614, "text": "become too big for clothes because you"}, {"y": 0.150330882513864, "w": 0.1950790744357639, "text": "are taller or fatter than before", "x": 0.14059754733396335, "h": 0.010395220588235306}, {"h": 0.008851743831354012, "text": "3", "x": 0.11775043944704296, "y": 0.16438953491353808, "w": 0.008787345886230466}, {"x": 0.11775043974418437, "text": "4", "w": 0.01054481506347657, "h": 0.00885174383135411, "y": 0.1782994187187706}, {"x": 0.14059753787220844, "h": 0.011594669117647042, "y": 0.16432444837720056, "w": 0.2636203850640191, "text": "put clothes into a wardrobe or on hooks"}, {"y": 0.1770348838407018, "x": 0.1370826038801532, "h": 0.012645348766270784, "text": "compare the price and quality of similar items", "w": 0.2934973483615451}, {"text": "in different shops before buying something", "x": 0.13708260012882786, "y": 0.19220930239718018, "w": 0.2776801384819878, "h": 0.012645348766270784}, {"y": 0.20611918616063113, "text": "5", "x": 0.11775043974418437, "h": 0.00885174383135411, "w": 0.01054481506347657}, {"text": "become too old or damaged to use", "y": 0.2061191861444352, "x": 0.13005273026412661, "w": 0.2460456848144531, "h": 0.01138081404216152}, {"h": 0.015803871242439108, "y": 0.2160411800724605, "text": "return something to its correct place", "x": 0.13868913138055866, "w": 0.24116029527452254}, {"y": 0.2389970929314991, "h": 0.011380814042161617, "text": "4 Complete the dialogues with the correct form of the", "x": 0.0949033429221339, "w": 0.3866432359483507}, {"w": 0.15465728759765623, "x": 0.11775044425038096, "h": 0.010172067267053313, "text": "verbs from Exercise 3.", "y": 0.252906977001338}, {"x": 0.11775043792964415, "text": "Conversation 1", "y": 0.27427389693583676, "h": 0.010395220588235306, "w": 0.10369068569607204}, {"x": 0.11599297658682341, "h": 0.01407724809997219, "y": 0.28578488407840086, "w": 0.3532513088650174, "text": "Janice: You should try on those jeans before you buy"}, {"w": 0.10193321228027344, "x": 0.1722319869002851, "y": 0.2996947675978497, "text": "them. You can't", "h": 0.01016276902135684}, {"h": 0.017454807442777245, "w": 0.13279088338216144, "text": "clothes to this shop.", "x": 0.35463754982809786, "y": 0.29771934846590026}, {"x": 0.11775044059017849, "y": 0.3134558826995388, "h": 0.014058651608579248, "w": 0.37434095594618055, "text": "Kelly: Really? What if there's something wrong with them?"}, {"y": 0.32744944866576237, "h": 0.011594669117647042, "w": 0.31107204861111115, "text": "Janice: You have to check them carefully here.", "x": 0.11775044836579752}, {"x": 0.119507908535971, "text": "Conversation 2", "y": 0.34264246340608423, "h": 0.010162769021356745, "w": 0.10369068569607205}, {"y": 0.3553343026836149, "x": 0.11599296247498059, "h": 0.011380813279572632, "text": "Imelda: Don't buy the first thing you find. We should", "w": 0.3444639756944444}, {"text": "and see if we can get them cheaper", "y": 0.36924418592314173, "w": 0.23901580810546874, "h": 0.011380814042161425, "x": 0.25307557872406694}, {"y": 0.38302389712745094, "h": 0.010395220588235306, "text": "somewhere else.", "w": 0.11247802734375004, "x": 0.17223198786591062}, {"text": "Adrian: I haven't got the strength. I just want to go home.", "h": 0.01281271337586293, "w": 0.3725834825303819, "x": 0.11775043178694748, "y": 0.3957994186822716}, {"x": 0.11950790976619945, "h": 0.010116278555463274, "text": "Conversation 3", "y": 0.4109738374032276, "w": 0.10369068569607205}, {"text": "Sam:", "x": 0.11775043967695993, "h": 0.00885174383135411, "w": 0.04042179107666015, "y": 0.4236191861132109}, {"w": 0.2601054382324219, "text": "These jeans aren't very good quality.", "x": 0.15817223261196728, "h": 0.011380813660867125, "y": 0.42361918640454505}, {"w": 0.34270650227864585, "x": 0.1195079145021532, "y": 0.4373988969734914, "text": "Paul: It doesn't matter. You're growing so quickly,", "h": 0.011594669117647139}, {"text": "you'll", "w": 0.049384884304470494, "h": 0.015655119138605504, "x": 0.16875219709918743, "y": 0.4492891553010411}, {"w": 0.12302284240722655, "h": 0.014012161905274666, "text": "them before they?", "x": 0.288224956871958, "y": 0.4501744191486407}, {"w": 0.10544815063476562, "x": 0.11775044222216025, "text": "Conversation 4", "y": 0.4653488370511576, "h": 0.01138081404216152}, {"text": "Simon: Can I borrow these CDs and DVDs?", "y": 0.47799418636689045, "w": 0.2899824015299479, "h": 0.010181365131455292, "x": 0.11775044763133545}, {"w": 0.03339191436767576, "h": 0.008851743831354012, "text": "Lisa:", "x": 0.11775043950626173, "y": 0.49190406979725904}, {"y": 0.49126100034937087, "text": "Yes, if you promise to.", "x": 0.16673754434266438, "w": 0.15517266167534724, "h": 0.01374158242169545}, {"text": "_everything", "x": 0.39008382794026086, "y": 0.4916476827049934, "w": 0.08274974399142793, "h": 0.013158122651717202}, {"x": 0.17047451598893212, "text": "in the right place.", "y": 0.5057674632171764, "w": 0.12126537746853303, "h": 0.011594669117647042}, {"x": 0.11950790950697274, "text": "Conversation 5", "h": 0.008944724381846557, "w": 0.10369068569607207, "y": 0.5221599265403711}, {"text": "Nick: Hi, Mum. I'm home.", "x": 0.11950790886359666, "y": 0.5323691861937891, "w": 0.18629174126519096, "h": 0.011380813660867028}, {"text": "Mum:", "h": 0.008851743831354012, "x": 0.11950791011909254, "y": 0.5475436047652822, "w": 0.042179260253906226}, {"w": 0.23403547498914934, "x": 0.25292407181205323, "h": 0.01266130784416905, "text": "your coat. Don't leave it on the floor.", "y": 0.5459760840596889}, {"x": 0.10720562331294858, "y": 0.5765349264451419, "text": "REMEMBER THIS", "h": 0.011594669117647042, "w": 0.12829525417751736}, {"x": 0.11072056258565201, "y": 0.6017233458917837, "w": 0.3532513088650174, "h": 0.012840607350363456, "text": "Most of the phrasal verbs in exercises 3 and 4 require an"}, {"y": 0.6157169120689727, "w": 0.3444639756944444, "h": 0.014021459388382345, "x": 0.10896309369935069, "text": "object. An object in phrasal verbs can appear after the"}, {"h": 0.012794117265764479, "text": "whole phrasal verb, e.g. try on a shirt or between the", "x": 0.10896309565690002, "y": 0.6297104779834534, "w": 0.33743408203125}, {"x": 0.11072057348804429, "y": 0.643648255722197, "text": "verb and the preposition, e.g. try a shirt on. Sometimes", "w": 0.35149383544921875, "h": 0.01138081404216152}, {"x": 0.1107205691738778, "w": 0.1898066711425781, "y": 0.6575581398929172, "h": 0.011380813279572632, "text": "phrasal verbs are inseparable."}, {"w": 0.34270650227864585, "x": 0.10896308761287413, "h": 0.012645348766270784, "y": 0.6739970930587251, "text": "When you check a phrasal verb in a dictionary, look at"}, {"h": 0.012645348766270784, "y": 0.6879069768850331, "text": "the position of sth/sb. If sth/sb is between the verb and", "w": 0.3479788886176215, "x": 0.10896310170759231}, {"text": "preposition, it means this phrasal verb is separable,", "y": 0.7016773898067638, "w": 0.3233743286132813, "h": 0.011594669117647042, "x": 0.1107205739476064}, {"h": 0.01280341589275525, "y": 0.7144622093377948, "w": 0.3532513088650174, "x": 0.11072057054112917, "text": "e.g. take sth off. If sth/sb is after the whole phrasal verb,"}, {"y": 0.7283720930587251, "w": 0.3637961154513889, "text": "it means this phrasal verb is not separable, e.g. look after", "h": 0.012645348766270784, "x": 0.10896309614073807}, {"w": 0.3710349527994792, "y": 0.7419857738535042, "x": 0.10885830219128396, "text": "sb/sth. Some phrasal verbs do not need an object, e.g. get up.", "h": 0.014561560644822944}, {"x": 0.09666080851558424, "w": 0.008787345886230466, "h": 0.008851743831354012, "y": 0.7776889535772008, "text": "5"}, {"text": "Read REMEMBER THIS. Look at these sentences.", "y": 0.7776424633217819, "x": 0.10896309822194515, "w": 0.3479788886176215, "h": 0.010162769021356745}, {"y": 0.7915988376094869, "w": 0.3690685356987847, "h": 0.01138081327957273, "text": "Are the verbs separable (S), inseparable (I) or is there", "x": 0.11775043601704017}, {"x": 0.11775044087830351, "w": 0.316344468858507, "text": "no object (NO)? Use a dictionary if necessary.", "h": 0.01138081404216152, "y": 0.8055087208700892}, {"x": 0.14059754858801746, "text": "Try these trousers on. They look great.", "y": 0.821947674776638, "w": 0.25307556152343746, "h": 0.011380813279572632}, {"y": 0.8358575584554171, "w": 0.2548330349392361, "h": 0.01138081327957273, "x": 0.11775044635580649, "text": "1 Take these shoes back to the shop."}, {"h": 0.008851743831354012, "x": 0.117750439480564, "y": 0.8497674419271645, "text": "2", "w": 0.010544815063476556}, {"y": 0.8484099266322596, "x": 0.13005272101435303, "w": 0.30228471544053825, "h": 0.012794117647058874, "text": "Tommy grows out of his clothes very quickly."}, {"x": 0.1405975536682924, "h": 0.005197610294117653, "text": "Hana your cost un whon you rama hamo", "y": 0.8636029412695775, "w": 0.27240771823459203}, {"x": 0.5184534283174711, "w": 0.20035149468315971, "h": 0.011594669117647139, "text": "WORD STORE 4E | Clothes", "y": 0.0655698527554778}, {"w": 0.3690685356987847, "x": 0.5202109028008711, "text": "6 Look at the photos and choose the correct option.", "y": 0.08596047803625005, "h": 0.011594669117647139}, {"y": 0.10495639601928018, "x": 0.5377855936751655, "w": 0.27592266506618923, "h": 0.01390988272779135, "text": "STYLISH or NOT? What do you think?"}, {"h": 0.012812714138451722, "y": 0.12392441848205354, "w": 0.2776801384819879, "text": "She's very trendy. She's wearing a 'hat/ scarf/", "x": 0.5571177531228021}, {"h": 0.010116278555463274, "text": "top on her head, sunglasses and she's got", "y": 0.13909883752968114, "w": 0.26010543823242194, "x": 0.5571177521491669}, {"x": 0.5571177563660585, "text": "a big hat / scarf/ sweater round her neck.", "h": 0.012645348766270784, "w": 0.25483303493923615, "y": 0.15174418605036755}, {"text": "It's difficult to see what kind of top/ jacket/", "y": 0.16552389669307832, "h": 0.012794118028353271, "x": 0.5553602819637525, "w": 0.26889278835720487}, {"x": 0.5571177572152265, "y": 0.17829941896212181, "w": 0.27416519165039066, "h": 0.014012161905274666, "text": "suit she's wearing under her leather jumper /"}, {"text": "coat / jacket - is it a thin 5skirt / jacket/", "x": 0.5571177491868472, "h": 0.014095844591365233, "y": 0.19220930268305197, "w": 0.2372583516438802}, {"x": 0.5571177582078877, "text": "jumper? I don't think it's a T-shirt / suit /", "w": 0.2460456848144531, "y": 0.20738372109254447, "h": 0.010116278936757863}, {"h": 0.011594669117647042, "x": 0.5571177568897858, "text": "tracksuit. She's wearing very close-fitting", "y": 0.21989889690725384, "w": 0.2460456848144531}, {"x": 0.5552565300304417, "w": 0.27787328084309904, "text": "\"trousers / tracksuits / dresses - I think they are", "y": 0.2313631214818311, "h": 0.012869934229289847}, {"x": 0.5571177538651785, "h": 0.01281271337586293, "y": 0.24388786790814457, "w": 0.2636203850640191, "text": "black jeans. On her feet... are they jeans/"}, {"y": 0.2566819852369801, "x": 0.5588752238919066, "h": 0.010134875046856218, "w": 0.2302284579806858, "text": "shoes / socks or trousers / tracksuits /"}, {"x": 0.5588752304752479, "y": 0.2693459307591962, "text": "trainers? It's difficult to say for sure. They", "w": 0.24428821139865453, "h": 0.011380813279572632}, {"y": 0.2818704045794712, "x": 0.5553602807509443, "h": 0.011594669117647042, "w": 0.25483303493923615, "text": "aren't boots. They're too small. She looks"}, {"text": "cool - and she knows it! 8/10", "w": 0.1898066711425782, "x": 0.5571177559577091, "y": 0.29463662779941346, "h": 0.011380814042161425}, {"text": "He looks good. He's wearing a dark 1° skirt /", "x": 0.5588752224772279, "h": 0.010125576801159745, "y": 0.32372093053186146, "w": 0.26010543823242194}, {"y": 0.336245404420632, "x": 0.5588752287286151, "text": "suit / sweater. It isn't too tight or too loose.", "h": 0.010395220588235306, "w": 0.2530755615234376}, {"y": 0.3490116280049004, "w": 0.24428821139865453, "text": "The jacket and trousers fit him well. He's", "x": 0.5571177549992669, "h": 0.01138081404216152}, {"text": "wearing a white \"shirt / coat / skirt and a dark", "y": 0.36023437489590326, "w": 0.27592266506618923, "h": 0.012803415892755346, "x": 0.5571177518078544}, {"y": 0.3730284927257091, "h": 0.011390111525269104, "text": "12 scarf / top / tie. His shoes are black. We", "w": 0.25307556152343746, "x": 0.5571177594843268}, {"text": "can't see his 13 boots / trainers / socks - I'm", "x": 0.5588752208369031, "y": 0.38568313974145446, "h": 0.010134875046856218, "w": 0.2583479817708334}, {"y": 0.39821691187342473, "text": "sure they are dark. He is stylish and smart. 9/10", "h": 0.012794117647058874, "w": 0.2794376118977865, "x": 0.5571177476714935}, {"text": "VOCABULARY PRACTICE | Adjectives", "x": 0.5166959617768938, "w": 0.27943759494357634, "y": 0.42860294114408476, "h": 0.011594669117647139}, {"x": 0.51669595575821, "y": 0.4489098838617774, "w": 0.31634446885850687, "h": 0.012645348766270784, "text": "7 Look at the vocabulary in lesson 4.4 in the"}, {"w": 0.3395110744900174, "text": "Students' Book. Complete the dialogue with one", "x": 0.5411502766525577, "y": 0.45965933109636126, "h": 0.015479912827996658}, {"h": 0.012794117265764382, "w": 0.3093145751953126, "x": 0.5413005342535446, "y": 0.47538143418028156, "text": "word in each gap. The first letters are given."}, {"y": 0.49177389693815377, "h": 0.014040055879775193, "x": 0.5395430537654102, "w": 0.35852372911241326, "text": "Amy: I prefer to wear comfortable clothes, you know,"}, {"text": "like 'b", "w": 0.043936729431152344, "x": 0.5852372597352148, "h": 0.011594669117647042, "y": 0.5069669116197454}, {"h": 0.011594669117647042, "y": 0.5069669117461989, "text": "sweaters and jeans. They're not", "x": 0.697715293476473, "w": 0.2091388278537326}, {"y": 0.5197238370227055, "x": 0.5834797892631544, "w": 0.01757469177246096, "h": 0.01138081404216152, "text": "2t"}, {"w": 0.14059753417968746, "y": 0.5197238375319982, "text": "- in fact, they look 3o", "x": 0.6643233783407363, "h": 0.01403075839666761}, {"y": 0.5314902641705358, "x": 0.6499946521995086, "w": 0.2342087131076389, "text": "_, but I love them. I don't understand", "h": 0.016194609561387303}, {"w": 0.15817223442925343, "x": 0.5869947249646351, "text": "how people can wear t", "y": 0.5473483455507064, "h": 0.012840608112952248}, {"w": 0.09841827392578117, "h": 0.011594669117647042, "x": 0.8049209165813391, "text": "clothes. I think", "y": 0.5473483455887502}, {"text": "they're very su", "x": 0.5849616724461429, "y": 0.5591178009580757, "h": 0.01605218770749422, "w": 0.09721198187934033}, {"text": "Ben:", "y": 0.5753633722229495, "w": 0.03339191436767586, "h": 0.008851743831354012, "x": 0.5430579975393607}, {"w": 0.14235500759548603, "y": 0.5753354778043109, "h": 0.012794118028353271, "text": "Yes, you're right. C", "x": 0.5729349724544538}, {"w": 0.10436991373697913, "h": 0.012895201847833762, "text": "clothes are my", "y": 0.5742653892964024, "x": 0.7800330788725577}, {"x": 0.5852372612660722, "w": 0.3075571017795139, "text": "favourite too. I love wearing jeans, and T-shirts", "y": 0.5880087207549459, "h": 0.012645348766270784}, {"h": 0.01138081404216152, "text": "- they're the best. But sometimes, you need to", "x": 0.5852372603812542, "y": 0.6031831395379672, "w": 0.30931457519531247}, {"h": 0.010558134729371345, "x": 0.5869087672666081, "text": "wear's", "w": 0.04938106113009988, "y": 0.6156075604927657}, {"y": 0.6169163602131562, "w": 0.20035149468315971, "x": 0.6977152920696679, "h": 0.010395220588235209, "text": "_ clothes. When someone gets"}, {"h": 0.011594669117647042, "y": 0.6297104777719251, "x": 0.5869947212870698, "text": "married, for example, I wear a suit and tie - I can't", "w": 0.3304042222764757}, {"y": 0.6435708997884633, "h": 0.010270991053651389, "x": 0.5869642285218584, "text": "wear s", "w": 0.04927013821072046}, {"y": 0.6436482561343322, "h": 0.01011627855546337, "x": 0.7047451660533355, "w": 0.1845342678493923, "text": "clothes like a tracksuit then!"}, {"text": "Amy: You? Wearing a suit and tie? I don't believe it!", "x": 0.5413005413385237, "w": 0.3479788886176215, "h": 0.012840607350363456, "y": 0.6560983458917836}, {"text": "Ben:", "x": 0.5430579976784936, "w": 0.033391914367675746, "h": 0.008851743831354012, "y": 0.6714680233699335}, {"w": 0.3128295220269097, "h": 0.011594669117647042, "x": 0.5764499086409096, "y": 0.6712913603772643, "text": "OK, here's a photo from my cousin's wedding."}, {"h": 0.011594669117647042, "x": 0.5869947311175376, "y": 0.6840854778066998, "text": "See? I'm wearing a's", "w": 0.14059753417968757}, {"text": "suit.", "y": 0.6866424419580056, "h": 0.007587209107244653, "w": 0.028119506835937558, "x": 0.7978910379118497}, {"y": 0.6980232557545826, "x": 0.5395430636350511, "text": "Amy: Yes, it's very fashionable. You look great!", "w": 0.3128295220269097, "h": 0.012645348766270879}, {"h": 0.01407724809997219, "w": 0.2829525417751737, "text": "VOCABULARY PRACTICE | Personality", "x": 0.5166959638927294, "y": 0.7207848843565985}, {"h": 0.011594669117647042, "text": "8 Look at the vocabulary in lesson 4.4 in the Students'", "x": 0.5202108940852179, "y": 0.7408593751236274, "w": 0.384885762532552}, {"text": "Book. Choose the correct option.", "y": 0.7548529410840193, "h": 0.011594669117647042, "x": 0.5430580052978821, "w": 0.2302284579806858}, {"w": 0.355008782280816, "h": 0.011594669117647139, "x": 0.541300523856663, "text": "1 I can't sing, I can't dance and I can't play a musical", "y": 0.7724448528292424}, {"x": 0.5641476287068852, "y": 0.7852389707765085, "text": "instrument. I'm not very generous / talented.", "w": 0.2970122951931423, "h": 0.012794117265764382}, {"text": "2 Pablo is the most creative / energetic person I know", "w": 0.3655535888671875, "x": 0.5413005391340687, "y": 0.7991860466589056, "h": 0.011380813279572632}, {"h": 0.011380813279572535, "w": 0.13708259582519533, "x": 0.5641476281565294, "text": "- he has great ideas!", "y": 0.8130959303798359}, {"w": 0.3637961154513889, "text": "3 Many relaxed / generous people give money to this", "h": 0.011594669117647042, "x": 0.5413005399368713, "y": 0.8268198531262345}, {"text": "charity.", "x": 0.5641476287505407, "h": 0.012645348766270784, "y": 0.8409156978679545, "w": 0.04920913696289064}, {"x": 0.5413005273540262, "h": 0.008851743831354012, "y": 0.8548255814620483, "w": 0.010544815063476598, "text": "4"}, {"y": 0.8535610463363413, "x": 0.5518453584844802, "text": "I like being with Alice because she's always creative /", "h": 0.012840608112952248, "w": 0.36028116861979165}, {"x": 0.1393350444704087, "w": 0.3072348022460938, "text": "Can you put my clothes back in my wardrobe?", "y": 0.874851553639436, "h": 0.013579623971721078}, {"y": 0.8895348840932308, "text": "I always shop around before I buy anything.", "w": 0.29090908474392363, "x": 0.13535354328460372, "h": 0.01174409288487177}, {"x": 0.11717172160544907, "text": "6 Cheap clothes wear out quickly, so they aren't", "w": 0.327272711859809, "h": 0.011766168425123125, "y": 0.9024780176883923}, {"text": "really a bargain.", "w": 0.10707070244683159, "x": 0.1393939399213654, "y": 0.9171511632114477, "h": 0.011705751137005449}, {"y": 0.8808139535279574, "text": "5 My grandparents are always relaxed / talented and", "x": 0.5414141384511786, "w": 0.3555555555555555, "h": 0.011672057693810745}, {"w": 0.1151515112982856, "x": 0.5636363674821703, "h": 0.011780110289819845, "y": 0.8938953492095097, "text": "they never worry."}, {"w": 0.33939392089843745, "x": 0.54141414810297, "h": 0.013189448441247031, "text": "6 Young children are cheerful / energetic - they're", "y": 0.9068745000752855}, {"h": 0.011810936611428735, "text": "always active.", "y": 0.9214201129021031, "w": 0.09297320895724825, "x": 0.5636144071712016}, {"text": "53", "y": 0.9374999998244741, "w": 0.02424242443508573, "h": 0.01308139584523782, "x": 0.8848484845097297}]
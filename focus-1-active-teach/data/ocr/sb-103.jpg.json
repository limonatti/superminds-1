[{"y":0.61337209331353693,"text":"What is it?","x":0.067901236133134008,"h":0.010254280159200158,"w":0.094650200737847218},{"x":0.065843627059421567,"y":0.62936046532442136,"w":0.20164608425564237,"h":0.013104212714514119,"text":"It's a global 'green' event."},{"w":0.16460905287000868,"h":0.01162790690711013,"x":0.065843621558822812,"text":"Who organises it?","y":0.65261627924993326},{"y":0.66993720557315306,"w":0.1995884704589844,"h":0.0090266875981160899,"text":"The World Wildlife Fund.","x":0.063786015010562608},{"h":0.010258843797716688,"w":0.14197530110677081,"text":"What happens?","x":0.06584362339208788,"y":0.69186046538839152},{"text":"Thousands of people around the world","y":0.70784883715691005,"w":0.29218105740017358,"x":0.067901243769048936,"h":0.011627906907110019},{"x":0.065843626600879224,"y":0.72527472542684168,"text":"turn off all the lights and electrical","h":0.011773940345368938,"w":0.26543209499782988},{"y":0.74127906996687998,"x":0.065843624347250287,"w":0.1604938252766927,"h":0.010290788893048353,"text":"devices for one hour."},{"text":"Why do they do it?","w":0.16872428046332466,"y":0.76295133454151087,"x":0.065843618273138865,"h":0.011773940345368938},{"x":0.06584363133077728,"y":0.78052325577609616,"h":0.011627906907110019,"text":"To remind us all about climate change","w":0.29218105740017364},{"h":0.010258843797716577,"text":"and the need to save energy.","x":0.06584362504169472,"y":0.7978806908138919,"w":0.21604938083224828},{"w":0.10082304212782117,"h":0.010204081632653073,"y":0.8182888541828891,"text":"When is it?","x":0.065843623977241666},{"y":0.83575581398830556,"x":0.067901244790996754,"h":0.011627906907110019,"text":"On the last Saturday of March.","w":0.23662550184461806},{"y":0.85753532186151715,"x":0.067901239986195489,"w":0.25925925360785596,"h":0.010204081632653073,"text":"Where and when did it start?"},{"text":"In Sydney, Australia, in 2007.","x":0.065843630614765489,"h":0.013081394896215293,"w":0.2283950466579861,"y":0.87354651163619468},{"h":0.011773940345368938,"w":0.25925925360785596,"text":"How many people take part?","x":0.067901239986195489,"y":0.89678178971710421},{"text":"In 2017 about 187 countries and","w":0.24691357082790799,"h":0.0090266875981162009,"x":0.065843623639544005,"y":0.91405023542379105},{"h":0.011773940345368827,"text":"territories on all the continents took part","y":0.93014128718823097,"w":0.30658437093098956,"x":0.06584362006948459},{"x":0.065843622803678781,"h":0.010215490167518992,"y":0.94622093040656019,"text":"in Earth Hour.","w":0.10905349731445313},{"w":0.072368070814344598,"text":"VIDEO","y":0.011180536010824915,"x":0.76937152060023006,"h":0.015429625518655121},{"h":0.010174418169437871,"text":"3","y":0.047965116369496186,"x":0.45267489725193599,"w":0.0123456785413954},{"h":0.01314300345476227,"text":"4) 3.55 Listen to Leo and Alice talking about Earth Hour. Who","w":0.45679012722439238,"x":0.48148147496805083,"y":0.046511627969770264},{"text":"thinks it is a good idea and who thinks it isn't?","y":0.061046512017735366,"h":0.013129312164929408,"x":0.47942386530791864,"w":0.34156378851996522},{"y":0.09156976753228685,"text":"4","w":0.0123456785413954,"x":0.45267489725193599,"h":0.010174418169437871},{"text":"4) 3.55 Complete the dialogue with the words and phrases","w":0.4382715861002604,"h":0.014671789795113521,"x":0.48148148503628985,"y":0.090116279245324171},{"h":0.013343799058084804,"text":"from the SPEAKING FOCUS. Listen again and check.","x":0.47942388061242114,"y":0.10596546306521548,"w":0.38271603054470482},{"x":0.47942387848025964,"y":0.1235465117997121,"h":0.013081394896215404,"text":"Alice: Hi, Leo. I'm going to take part in Earth Hour and I'm","w":0.41152262369791665},{"h":0.013081394896215293,"w":0.2139917670355902,"x":0.52469136284708817,"y":0.13808139555092336,"text":"looking for people to join me."},{"h":0.010174418169437871,"text":"Leo:","y":0.15261627923286825,"x":0.47942386871075415,"w":0.034979423946804422},{"h":0.011773940345368938,"text":"Earth Hour? I'm not'","x":0.52469136249648352,"y":0.15109890114504609,"w":0.14814814249674479},{"x":0.70164609102078657,"text":"sure","h":0.0072674414426603384,"y":0.15552325599863104,"w":0.030864196353488471},{"h":0.01162790690711013,"y":0.15261627900768526,"text":".... To be","x":0.76131687563474881,"w":0.069958843655056446},{"y":0.1671511629537985,"h":0.010242871624334349,"x":0.52469136483792267,"w":0.19341562906901044,"text":"I don't think it makes much"},{"y":0.18168604645923569,"text":"Alice: Why not? It's a great way to show you care about climate","h":0.011799039795784227,"x":0.47942387334398301,"w":0.44032921685112852},{"text":"change.","y":0.19622093042594002,"h":0.01017441816943776,"w":0.061728392706976942,"x":0.52469136023087359},{"h":0.01017441816943776,"x":0.479423869298856,"w":0.034979421827528168,"text":"Leo:","y":0.20930232596857568},{"x":0.63374485972754702,"w":0.27572016398111987,"y":0.2091836735984316,"text":"but one hour doesn't change anything.","h":0.011773940345368938},{"y":0.22370486639170006,"h":0.011773940345368938,"text":"People waste energy all the time. You can't save much in","w":0.39917694091796874,"x":0.52469137158491108},{"text":"sixty minutes.","y":0.23979591828408031,"h":0.0087505932692641952,"x":0.52469136183425624,"w":0.096707814534505276},{"w":0.09075920952690969,"h":0.012533236897347422,"x":0.47931175476805693,"text":"Alice: Yes, I","y":0.25100082311265193},{"text":". It's true we won't save much","w":0.20987653944227436,"y":0.25145348833423564,"x":0.69135802919861589,"h":0.01162790690711013},{"x":0.47942386453739877,"text":"energyduring Earth Hour. But the point is to make people think","y":0.26598837239200868,"w":0.44032921685112841,"h":0.013081394896215293},{"y":0.28052325581243331,"x":0.52469136622681145,"w":0.3045267401801216,"h":0.01162790690711013,"text":"about the problem, not just to save energy."},{"text":"Leo:","h":0.01017441816943776,"x":0.47942386788770897,"y":0.29505813962531025,"w":0.034979423946804422},{"text":"I see what you","x":0.52469136071556299,"y":0.29505813952125115,"w":0.10493826972113718,"h":0.011627906907110019},{"text":", but what about all those","y":0.29505813951156123,"w":0.17695473564995656,"x":0.75925925945897232,"h":0.01162790690711013},{"text":"candles? People burn hundreds of candles at Earth Hour","x":0.52457861593176458,"y":0.30712654586921473,"h":0.014760821355942477,"w":0.38703338623046868},{"y":0.32260596553122234,"w":0.4197530788845486,"x":0.52263375387048272,"text":"events and they produce a lot of CO2. It's all a waste of time.","h":0.014603336340216932},{"w":0.18518517388237843,"h":0.011773940345368938,"text":"Alice: Mmm, you have a","y":0.33712715869006993,"x":0.4794238770505802},{"h":0.011773940345368938,"x":0.5246913605798289,"w":0.40534979926215275,"y":0.35164835147122608,"text":"great event. And you know, people and even whole cities"},{"y":0.36482558164588452,"w":0.40123453776041673,"x":0.52469137978234293,"h":0.013117903255779995,"text":"make decisions to be more green because of Earth Hour."},{"text":"Leo: Well, maybe you're right. Would you like some help?","x":0.47736625366472163,"y":0.37936046539709589,"w":0.4197530788845486,"h":0.013104212714514007},{"w":0.078363155788845562,"x":0.63365792813829136,"text":"Thank you.","h":0.01361004411706368,"y":0.39363102386172777},{"h":0.013085958909015205,"w":0.15226337009006063,"text":"SPEAKING FOCUS","x":0.45473251096320011,"y":0.4215070641931622},{"y":0.44878590628761827,"h":0.015426056351354855,"w":0.069414185418022967,"text":"Agreeing","x":0.45191143933938721},{"x":0.45267489893572765,"h":0.01162790690711013,"text":"I think so (too).","w":0.10493826972113718,"y":0.46656976742822787},{"x":0.45467875372751337,"text":"(Yes,) I agree.","y":0.4808821817738993,"h":0.012072845381133401,"w":0.094757715861002623},{"x":0.45267489872197908,"y":0.49563953504946978,"w":0.13580246819390196,"h":0.013081394896215404,"text":"Exactly.\/Absolutely"},{"text":"That's\/You're right.","w":0.1316872406005859,"x":0.45267489940135308,"y":0.51017441878481717,"h":0.011803603060017154},{"w":0.088477367824978281,"x":0.69753086390129693,"h":0.014534882885320455,"text":"Disagreeing","y":0.44912790721286311},{"x":0.69730804499718158,"text":"I'm not sure.","w":0.088965555826822973,"h":0.010334487612618126,"y":0.46755247419720547},{"text":"I don't think so.","x":0.69753086529817288,"y":0.4811046511976077,"w":0.11316872490776908,"h":0.011627906907110019},{"w":0.074218173556857558,"h":0.012094922118134566,"x":0.6974588153815684,"y":0.49540602689656299,"text":"I disagree."},{"text":"To be honest, I don't think it","x":0.6995884827799479,"y":0.51017441876169578,"h":0.010233744347301288,"w":0.19753085666232639},{"y":0.52470930235169422,"text":"makes much sense.","x":0.70987654990308047,"w":0.13786007351345486,"h":0.0087209301803324868},{"w":0.31069959852430562,"x":0.4547325078537594,"h":0.01178534925451824,"y":0.54199372042965688,"text":"Agreeing in part\/Agreeing and disagreeing"},{"w":0.16460905287000865,"x":0.45267490017679252,"h":0.011627906907110019,"text":"Perhaps\/Maybe, but ...","y":0.55959302329063099},{"h":0.011627906907110019,"text":"I see what you mean, but ...","y":0.55959302329063099,"w":0.19958847045898442,"x":0.66872428661550087},{"text":"Maybe you're right...","y":0.57412790701156124,"w":0.15432098388671878,"h":0.011821857614083053,"x":0.45267490157515911},{"x":0.66872428205382195,"y":0.57412790701156124,"text":"You have a point, but ...","h":0.011821857614083053,"w":0.17078189425998269},{"y":0.60637521702784991,"h":0.014828872081810496,"x":0.45247103659156235,"text":"5 Choose the correct option.","w":0.2267994859483507},{"w":0.45061726888020837,"y":0.6250000001899737,"x":0.47942387960310573,"h":0.013147566718995307,"text":"1 A: I think air pollution in our city is awful. When are they going"},{"x":0.51646090948388867,"w":0.18312756008572051,"h":0.011773940345368827,"text":"to do something about it?","y":0.64089481928066816},{"w":0.3930041164822049,"text":"B: (Exactly.\/ I don't think so. You can't breathe normally.","h":0.013120184887896569,"x":0.49588477958468602,"y":0.65406976764394664},{"h":0.013081394896215293,"y":0.66715116296250276,"w":0.45473249647352437,"text":"2 A: I think governments should stop air travel. It pollutes the air","x":0.47942388090418425},{"x":0.51646091245127235,"w":0.19135801527235241,"h":0.011627906907110019,"y":0.68313953488220092,"text":"and causes global warming"},{"w":0.42592590332031249,"h":0.011627906907110019,"text":"B: I disagree \/ You have a point, but isn't that a bit extreme?","x":0.49794240345815627,"y":0.69767441853045675},{"text":"No air travel at all?","h":0.010204081632653073,"y":0.71075353223736948,"x":0.51851851830052997,"w":0.13168724060058601},{"w":0.27983539157443582,"h":0.011773940345368827,"x":0.47942387149673271,"y":0.72527472516156988,"text":"3 A: I think nuclear energy is the future."},{"y":0.73979591829278457,"w":0.39094648573133683,"text":"B: That's right. \/ I'm not sure. I think it's very dangerous.","x":0.49794240151018876,"h":0.011773940345368938},{"h":0.011773940345368938,"text":"4 A: I think in the city everybody should use public transport only.","x":0.47942387213883242,"y":0.75431711148456115,"w":0.45679012722439238},{"text":"B: You're right. \/ I disagree. But do you think people will agree?","w":0.4382715861002604,"x":0.49794239259801809,"h":0.011773940345368938,"y":0.76883830437472889},{"x":0.47942388019674581,"w":0.44650204128689236,"y":0.78178963926551415,"h":0.013343799058084804,"text":"5 A: I'd like to organise Earth Hour in our city. I think it's a great"},{"h":0.0087209301803325978,"y":0.79796511630518263,"x":0.51440329350477931,"w":0.037037035624186254,"text":"idea."},{"text":"B: I'm not sure. \/ Absolutely. Let's do it!","x":0.4979423893156627,"h":0.011627906907110019,"y":0.81104651157551488,"w":0.27983539157443571},{"text":"6","h":0.011627906907110019,"y":0.83430232547086358,"x":0.45267489725193599,"w":0.0123456785413954},{"x":0.46913579686629292,"h":0.013081394896215404,"w":0.43621398925781252,"text":"SPEAKING Do you agree with the speakers in Exercise 5?","y":0.83430232558968309},{"x":0.47942386937585729,"y":0.85029069790303424,"w":0.16666666666666669,"text":"Discuss with a partner.","h":0.011627906907110019},{"h":0.014534882885320566,"text":"ROLE-PLAY","x":0.4547325101754397,"y":0.87645348897158393,"w":0.10493826972113718},{"text":"6 37","y":0.87637362630703253,"w":0.043209877014160236,"x":0.56995884706905164,"h":0.013343799058084693},{"x":0.62962963355922208,"text":"Agreeing and disagreeing","w":0.20781892564561633,"h":0.013104212714514119,"y":0.87936046528202794},{"y":0.9040697676500028,"text":"• 37) Watch the video and practise. Then role-play your dialogue.","x":0.45884774691096786,"w":0.47119340684678823,"h":0.013120184887896458},{"x":0.93209876508487655,"y":0.0087209303574581343,"text":"6.37","w":0.05555555555555558,"h":0.017441860360665085},{"x":0.19958847825746173,"w":0.16872428046332466,"y":0.030523255984998499,"text":"SPEAKING","h":0.018895348349770358},{"x":0.19547325706510812,"y":0.072605965332460998,"w":0.19547324286566839,"text":"Agreeing and disagreeing","h":0.013343799058084804},{"y":0.093014128545208297,"w":0.13991768731011284,"h":0.013090522173248242,"text":"I can give a simple","x":0.19341563967827696},{"w":0.18724278767903646,"y":0.10753532210641326,"h":0.013104212714514119,"x":0.19341564337755995,"text":"opinion using basic fixed"},{"w":0.18724278767903643,"y":0.12205651506805437,"x":0.19341564553805377,"h":0.013117903255779995,"text":"expressions for agreeing"},{"x":0.19341564144940157,"text":"and disagreeing.","y":0.13500784915576669,"h":0.014701452509761848,"w":0.12345678541395397},{"y":0.18023255818756789,"text":"1","x":0.072016460822092065,"h":0.010174418169437871,"w":0.010288065804375551},{"text":"2","x":0.074074074196577661,"w":0.010288065804375551,"y":0.31540697713136634,"h":0.010174418169437871},{"h":0.010229180708784869,"x":0.098765425975557861,"y":0.18168604680190903,"w":0.29835391574435766,"text":"Match the sentence halves. Translate the"},{"y":0.19622093026737519,"h":0.011785349254518351,"x":0.098765440556915107,"text":"sentences with a partner.","w":0.18724278767903646},{"h":0.013081394896215404,"x":0.098765442601534234,"text":"1 You waste energy when you ...","w":0.23456788804796003,"y":0.21220930257611714},{"x":0.098325067338432243,"h":0.018365803094262056,"w":0.2251500786675347,"text":"2 You save energy when you ...","y":0.22420567048987683},{"x":0.11111112077486003,"text":"turn on all the lights in the house.","y":0.24843014131339691,"w":0.24074072943793406,"h":0.011773940345368938},{"x":0.09876543747076337,"y":0.2616279071848866,"text":"b turn off unnecessary lights.","w":0.20370369805230032,"h":0.013097367818164618},{"y":0.27616279088038065,"x":0.098765433996370958,"h":0.013083677276898853,"w":0.28395061916775177,"text":"c turn on a dishwasher that's half empty."},{"h":0.011627906907109908,"text":"d leave the car at home and cycle to work.","y":0.29069767439528227,"x":0.098765431942635984,"w":0.29835391574435766},{"h":0.011627906907110019,"w":0.31069959852430556,"text":"Read about Earth Hour. Do you think it's a","x":0.098765430182291614,"y":0.3154069767208636},{"w":0.20576131184895832,"h":0.011627906907110019,"x":0.098765434689248394,"y":0.32994186050711105,"text":"good idea? Why?\/Why not?"},{"x":0.041152257332859141,"text":"EARTH HOUR","w":0.36213992648654508,"y":0.3618524333470724,"h":0.026295133437990503},{"text":"THE FACTS","h":0.014598773075984117,"w":0.15637859768337675,"x":0.047325106014278681,"y":0.40109890086667621},{"h":0.011627906907110019,"x":0.90123456757049347,"text":"103","y":0.95494186057260766,"w":0.034979423946804533}]
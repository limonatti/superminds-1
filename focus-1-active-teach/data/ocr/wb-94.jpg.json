[{"x": 0.10733453372892743, "text": "2 Read the text again. Choose the correct answers A-C.", "y": 0.055639535144938475, "w": 0.4096601019965278, "h": 0.012672739536753685}, {"y": 0.07334302347488039, "w": 0.38640428331163196, "h": 0.012645348314774147, "x": 0.13059035136743963, "text": "1 The couple in the first paragraph had a problem because"}, {"h": 0.012741215719643087, "x": 0.15384615789053568, "y": 0.08715703978251148, "text": "A the flight they booked didn't go to the place", "w": 0.32558139377170137}, {"y": 0.10098024226573912, "x": 0.17526901217291904, "w": 0.09311135186089411, "h": 0.011745910713388487, "text": "they thought."}, {"x": 0.15205724743562554, "h": 0.012645348314774242, "text": "B the flight didn't leave from Birmingham.", "y": 0.11380813979610127, "w": 0.2951699490017361}, {"x": 0.15205726117027552, "w": 0.3166368272569445, "h": 0.012955776173285189, "text": "C they didn't check where the flight left from.", "y": 0.12759476563900687}, {"w": 0.24150266859266492, "x": 0.12880143961541465, "text": "2 The man on the flight to Denver", "y": 0.14162790744871753, "h": 0.012663609129427173}, {"y": 0.1535236851750212, "x": 0.15183822379523398, "w": 0.34033532036675346, "h": 0.015216184368202445, "text": "A asked the woman not to use her reclining seat."}, {"h": 0.014133574007220224, "y": 0.16803249086479938, "w": 0.3291592068142361, "text": "B had something that stopped the seat in front", "x": 0.15205724340266152}, {"h": 0.014008999697137814, "text": "of him from reclining.", "y": 0.180970755912642, "w": 0.14552132500542536, "x": 0.17328036937182656}, {"x": 0.15016884087570537, "text": "C was angry because he couldn't use his reclining seat.", "h": 0.014182593504013968, "w": 0.36156955295138893, "y": 0.19595755322666575}, {"text": "3 The man travelling to Darlington", "y": 0.20991279092727863, "h": 0.012690999602582876, "x": 0.12701252657738804, "w": 0.24508049858940972}, {"x": 0.1498905700169468, "y": 0.22284601209731095, "w": 0.1832205030653212, "h": 0.014680171873595337, "text": "A was on the wrong train."}, {"text": "B went past the station on his ticket.", "x": 0.15010638569424184, "h": 0.013968748925825373, "y": 0.23768528993278032, "w": 0.25431598239474823}, {"x": 0.15026833822608415, "text": "C didn't know that he couldn't travel to Darlington", "w": 0.3488372124565972, "y": 0.251642442096392, "h": 0.01264534831477405}, {"h": 0.012955776173285189, "x": 0.17173524354116287, "text": "with the ticket he bought.", "y": 0.26539711212411327, "w": 0.17531305948893233}, {"x": 0.12343471252289501, "w": 0.3542039320203993, "text": "4 When the trains got stuck in the Eurostar tunnel,", "y": 0.2794622096056943, "h": 0.012645348314774147}, {"x": 0.14847943858108628, "h": 0.011481246091828929, "y": 0.29327166063717414, "w": 0.3631484646267361, "text": "A some passengers moved from one train to another."}, {"y": 0.3072819771318571, "x": 0.14847943498194974, "h": 0.012686434773331489, "w": 0.35778174506293403, "text": "B only people with the correct tickets could change"}, {"x": 0.16994633363046086, "y": 0.3224563954739544, "text": "trains.", "w": 0.04114490085177952, "h": 0.0075872089888644875}, {"y": 0.3351017443421088, "x": 0.1484794358411927, "h": 0.011563418260119971, "w": 0.33094811333550345, "text": "C passengers got out and walked to the end of"}, {"text": "the tunnel.", "w": 0.07513416714138454, "x": 0.16994633418422722, "y": 0.3490116281159509, "h": 0.01021671126035137}, {"text": "5 The passengers going to Bilbao definitely did not", "x": 0.12343471368940717, "h": 0.014133574007220224, "y": 0.361583934850987, "w": 0.36135955810546877}, {"y": 0.37683139577361335, "x": 0.14490161117475453, "text": "spend Christmas Day", "h": 0.011449290040598003, "w": 0.14669052124023435}, {"y": 0.389458483791221, "w": 0.10733451843261715, "text": "A in England.", "x": 0.14669052211940997, "h": 0.011399073923537888}, {"text": "B in Bilbao. C on a ferry.", "y": 0.3906362815137434, "w": 0.21288013034396702, "h": 0.011485811295492138, "x": 0.27012522644996056}, {"y": 0.4097093024184171, "h": 0.011549723023541975, "text": "3 Match the underlined words in the text with the", "w": 0.3667262776692708, "x": 0.10017889598200153}, {"text": "definitions below.", "x": 0.1234347097994533, "y": 0.42361462105182246, "h": 0.010207581227436775, "w": 0.12701251559787324}, {"y": 0.4412815884320207, "text": "People who work at a railway station. station staff", "h": 0.012686434773331489, "w": 0.3452593655056424, "x": 0.14490162675821025}, {"text": "Checks before you get on a plane to make sure you", "x": 0.141323788372627, "w": 0.3542039320203993, "y": 0.45523255840075244, "h": 0.012745781297718117}, {"x": 0.14490161194480927, "y": 0.4691424420797542, "w": 0.24150268554687504, "h": 0.011399074297949806, "text": "aren't carrying anything dangerous."}, {"w": 0.3828264702690973, "text": "2 A seat on a plane or a bus which can be moved back", "x": 0.1216458036400488, "y": 0.4828971118398156, "h": 0.011536027412552254}, {"h": 0.01145385561867313, "w": 0.1502683342827691, "x": 0.1431127041466297, "text": "so that you can sleep.", "y": 0.49696220952161463}, {"w": 0.008944543202718092, "text": "3", "h": 0.008851743820341854, "x": 0.12164579628772862, "y": 0.5096075581748581}, {"text": "An adjective meaning something which is booked", "x": 0.14490162204284407, "h": 0.012659043551352046, "y": 0.5095938630883025, "w": 0.3381037394205729}, {"x": 0.1412303320930726, "h": 0.014546620665044164, "y": 0.5231393354565481, "w": 0.35797000461154516, "text": "(a hotel, flight, etc.) very near to the time the person"}, {"y": 0.5374273258325206, "x": 0.1431127025994425, "text": "needs them.", "h": 0.010248666937170475, "w": 0.08765652974446617}, {"y": 0.5512093861074434, "w": 0.34168155246310766, "h": 0.012955776173285286, "x": 0.14132380906957892, "text": "A place you can go to ask for help or information."}, {"x": 0.14114717293274023, "w": 0.34025363498263883, "text": "Television screens or electronic screens in airports", "h": 0.015045496746090773, "y": 0.577148230536434}, {"w": 0.35062611897786455, "x": 0.14132379513241525, "y": 0.5930668609370896, "text": "or railway stations which show when flights or trains", "h": 0.012713825246487289}, {"h": 0.016477974760833635, "text": "leave and where passengers should go.", "y": 0.6045173804880702, "w": 0.2922086588541667, "x": 0.13928160326363367}, {"y": 0.625890639929474, "w": 0.3562152099609375, "h": 0.014207808644332619, "x": 0.09470001917753627, "text": "4 Complete the text with one word in each gap."}, {"h": 0.010116278651819414, "w": 0.0322003576490614, "text": "000", "y": 0.6487063954313577, "x": 0.10375670838477163}, {"w": 0.03935599009195964, "h": 0.015174417977728975, "x": 0.11627907114364452, "text": "17/7", "y": 0.6651453489989263}, {"h": 0.018059566787003673, "x": 0.2880143156506855, "text": "Holiday Day i (and 2)", "y": 0.6662409750683305, "w": 0.1824686855740017}, {"text": "I was very happy when I booked a last-minute flight to", "w": 0.3291592068142361, "y": 0.6890117327427293, "x": 0.11270125197749735, "h": 0.011540592616215558}, {"text": "Turkey. It was a great deal - £150 cheaper than the normal", "y": 0.7003971120769158, "x": 0.11627907255156691, "w": 0.35241502549913195, "h": 0.011536027412552254}, {"w": 0.3220035807291667, "h": 0.011540592616215461, "text": "price. But the journey was terrible! What a nightmare!", "y": 0.7131976745114403, "x": 0.11627906522575661}, {"w": 0.3291592068142361, "h": 0.011458420447924517, "y": 0.7258430236805901, "text": "I got to the airport early and, of course, went to look at", "x": 0.11449015908542827}, {"w": 0.09522876315646701, "x": 0.11428186266884315, "h": 0.01326515268332686, "y": 0.7362816676830235, "text": "the departure 1"}, {"text": "to see where to check in. Next", "y": 0.7396570398179544, "w": 0.18783542209201387, "h": 0.00902978339350174, "x": 0.2737030371650844}, {"y": 0.7522202167609529, "h": 0.010294317850567381, "w": 0.3363148328993055, "text": "to my flight number, it said: Please go to the information", "x": 0.11270126396179614}, {"x": 0.1127012524325731, "h": 0.0075872089888644875, "text": "2", "y": 0.7625145351247538, "w": 0.010733451843261715}, {"text": ". So, I went and asked what was wrong. They", "x": 0.189624337026335, "w": 0.275491943359375, "y": 0.7650436048179856, "h": 0.010116278651819317}, {"h": 0.011522332175974353, "w": 0.33094811333550345, "y": 0.7764244186500668, "text": "said: The flight is leaving tomorrow at 5 a.m.! I decided", "x": 0.1144901608337392}, {"y": 0.790302346514938, "text": "to go home but the ticket office at the railway station was", "x": 0.11270125885341947, "h": 0.010207581227436775, "w": 0.3416815524631076}, {"x": 0.11449016571787865, "w": 0.1323792436387804, "y": 0.8004505815621716, "h": 0.010266927377411581, "text": "closed. The station 3"}, {"w": 0.15563505384657117, "y": 0.8028655236054655, "x": 0.3059034020123137, "h": 0.01149494132840683, "text": "didn't know why. I bought"}, {"y": 0.8133715018608179, "h": 0.012430878468799233, "w": 0.3096694607204861, "text": "a ticket on the train - it cost £10 extra. The next day.", "x": 0.11440855754267892}, {"y": 0.826814079563578, "x": 0.112701252984106, "w": 0.32737030029296876, "h": 0.011572547918622745, "text": "I got to the airport at 3 a.m. There were lots of security"}, {"h": 0.012681869944080102, "y": 0.8396511628938483, "x": 0.18604651190809857, "w": 0.23434704250759547, "text": ". Take your boots off, take your belt off."}, {"text": "You know the sort of thing. At last I got on the plane. I sat", "y": 0.8522965118155827, "h": 0.0114218995674423, "w": 0.3452593994140625, "x": 0.11270125273035685}, {"h": 0.011485811295492138, "text": "REMEMBER THIS", "y": 0.06438628142944117, "x": 0.558139538339056, "w": 0.1323792436387804}, {"h": 0.018776288411247222, "x": 0.5561035371530259, "text": "We form regular adverbs by adding -ly to an adjective.", "w": 0.3761734686957465, "y": 0.08843421644277692}, {"x": 0.5581395355779761, "y": 0.10482400733568686, "text": "Adverbs describe:", "w": 0.1252236090766059, "h": 0.010248666937170475}, {"text": "• how activities expressed by verbs are done,", "h": 0.012727520483065188, "x": 0.5581395389381636, "w": 0.31127010769314234, "y": 0.12131317671938006}, {"h": 0.013841751422262273, "y": 0.13470703125452435, "x": 0.5687336389604306, "text": "e.g. Suddenly,", "w": 0.10403540717230908}, {"x": 0.5563506307623011, "y": 0.14918772531830785, "text": "• when the events in a sentence happened,", "w": 0.2987477620442708, "h": 0.012672739536753588}, {"w": 0.08407870822482633, "x": 0.5670840797516298, "text": "e.g. Finally,", "h": 0.012759476534296113, "y": 0.1631250003117989}, {"y": 0.17544121554083966, "text": "• our feelings about the events that are talked about, e.g.", "x": 0.5561909880342623, "w": 0.3759809705946181, "h": 0.015187177933510489}, {"x": 0.5670840861766131, "text": "Unfortunately - it is/was unfortunate or unlucky,", "y": 0.1934738374705199, "w": 0.33094811333550345, "h": 0.012645348314774147}, {"w": 0.19856886121961814, "h": 0.011472116058914237, "text": "Strangely - it is/was strange,", "x": 0.5670840870780263, "y": 0.20729241860551756}, {"x": 0.5652951828173333, "y": 0.22129360455144495, "text": "Eventually - in the end, after a long time,", "w": 0.28622538248697915, "h": 0.013909883895075253}, {"y": 0.23516696739400048, "text": "Amazingly / Surprisingly - it is/was surprising,", "x": 0.5652951688996775, "h": 0.014133574007220224, "w": 0.3184257676866319}, {"y": 0.24911337202175743, "h": 0.013928143960904539, "x": 0.5635062630335571, "w": 0.37388193766276046, "text": "Hopefully - with hope that something will happen, etc."}, {"h": 0.014133574007220224, "text": "VOCABULARY PRACTICE | Adjectives", "w": 0.28801428900824644, "x": 0.5384615524726208, "y": 0.2818862818813872}, {"x": 0.5527728060890158, "h": 0.011508636564984728, "w": 0.3846153767903646, "text": "Look at the vocabulary in lesson 7.4 in the Students'", "y": 0.3072819770003574}, {"x": 0.5635062680474222, "w": 0.3792486572265624, "y": 0.3211462093913277, "h": 0.011426464771105508, "text": "Book. Complete the dialogues with one word in each"}, {"text": "gap. The first and last letters of the words are given.", "x": 0.5617173565570124, "h": 0.011563417885707956, "y": 0.335101744436949, "w": 0.37745975070529514}, {"y": 0.3553343024924043, "text": "Ava:", "x": 0.5617173528271714, "w": 0.03398926628960497, "h": 0.010116278651819317}, {"text": "Welcome back! How was your holiday in Greece?", "w": 0.32915920681423616, "h": 0.012677304366005072, "x": 0.6207513414229356, "y": 0.35530234656085874}, {"text": "Nick:", "x": 0.5599284453535431, "y": 0.36924418621333455, "w": 0.03935599009195967, "h": 0.010116278651819317}, {"text": "It was great! The islands were amazing and", "x": 0.6206428753882038, "y": 0.36866861778889387, "h": 0.013446507298989335, "w": 0.27929111056857636}, {"text": "the beaches were incredible!", "x": 0.6189624373652941, "y": 0.3831540699527873, "h": 0.012645348314774242, "w": 0.19320214165581595}, {"x": 0.5617173579572156, "w": 0.1073345184326171, "y": 0.4020216605343492, "h": 0.009029783393501837, "text": "Conversation 1"}, {"x": 0.56168313009124, "w": 0.03942443847656241, "y": 0.4184845056348797, "h": 0.009004825848534665, "text": "Gina:"}, {"h": 0.011431029974768718, "y": 0.4185108303975119, "w": 0.2683363003200956, "x": 0.6189624386592724, "text": "What did you like the most in Morocco?"}, {"text": "Sia:", "y": 0.43247093050475904, "w": 0.030411449008517777, "h": 0.010116278651819221, "x": 0.5581395345073691}, {"y": 0.4324709306099142, "w": 0.2379248555501302, "h": 0.011558852682044748, "text": "I really loved the markets with the c", "x": 0.6189624362007847}, {"y": 0.4463808144254618, "text": "clothes and jewellery - I bought a red and", "h": 0.012645348314774147, "w": 0.2790697564019097, "x": 0.620751349109719}, {"x": 0.6207513436825374, "y": 0.4601263539315376, "text": "gold scarf there.", "w": 0.10912343343098951, "h": 0.011545157445466848}, {"w": 0.10733452690972223, "x": 0.5599284418224197, "y": 0.4792587211605049, "text": "Conversation 2", "h": 0.008851743820341854}, {"h": 0.011540592616215461, "text": "Mario: The Coliseum in Rome is really impressive.", "x": 0.5599284478861913, "w": 0.34883721245659727, "y": 0.4956976746747761}, {"x": 0.5599284468439765, "y": 0.5095938627004142, "h": 0.011394509094286501, "w": 0.1234347025553385, "text": "Helen: Yes, it's s_"}, {"w": 0.16457960340711808, "y": 0.5095938629534188, "x": 0.7477638649631078, "text": "r! It's my favourite sight.", "h": 0.012659043551352046}, {"y": 0.5272608304349372, "h": 0.010207581227436775, "text": "Conversation 3", "x": 0.5599284456733754, "w": 0.10733451843261721}, {"h": 0.01019165824036304, "w": 0.03760762108696836, "x": 0.5563303579271669, "y": 0.5449768452569006, "text": "Karl:"}, {"y": 0.5449277976093282, "h": 0.012732086061140313, "x": 0.6171735296787213, "w": 0.2379248555501302, "text": "Where did you stay in Switzerland?"}, {"text": "Julie:", "w": 0.04138510386149086, "x": 0.5562305249157632, "h": 0.011821514200217528, "y": 0.5587040683872582}, {"h": 0.012700130009909388, "y": 0.5589244188658689, "text": "We stayed at a c", "x": 0.6135957071524445, "w": 0.1180679745144314}, {"y": 0.5571451065661255, "x": 0.8010489479307512, "w": 0.13118307325575085, "h": 0.014608275812885877, "text": "g hotel with a view"}, {"w": 0.24329159206814233, "y": 0.5728023464200979, "text": "of Lake Geneva. It was so beautiful!", "x": 0.6171735272217427, "h": 0.010207581227436775}, {"y": 0.5981250001708937, "x": 0.5330948126162707, "w": 0.20572450425889754, "text": "WORD STORE 7E | Tourism", "h": 0.012759476534296018}, {"w": 0.4096601019965278, "x": 0.5330948216612469, "text": "6 Complete the dialogues with the words from the box.", "y": 0.6221511630940664, "h": 0.012681869195256362}, {"w": 0.32915920681423616, "h": 0.011513201768647938, "x": 0.570661895161755, "text": "destination explored highlight monument", "y": 0.6485740073143885}, {"text": "population", "x": 0.5706056296544223, "y": 0.6624004259510845, "h": 0.011812520078803717, "w": 0.08598015679253479}, {"text": "tourists", "y": 0.6638808140680679, "w": 0.05903398725721565, "h": 0.0075872089888644875, "x": 0.6601073365145049}, {"w": 0.23076922946506084, "y": 0.6853779071486134, "h": 0.011485811295492138, "text": "Fran: What did you do in Paris?", "x": 0.5796064430313336}, {"w": 0.2933810424804688, "h": 0.012713825246487289, "text": "Leah: 1 explored the city. It was amazing!", "y": 0.6992193140777603, "x": 0.5760286171497477}, {"x": 0.5633418488621927, "w": 0.09692989773220495, "text": "Wayne: The", "y": 0.7150664850876128, "h": 0.013965866703419014}, {"h": 0.010221276464014675, "text": "of Australia is 25 million.", "x": 0.7728085891912428, "y": 0.7168862814665461, "w": 0.16279069688585068}, {"h": 0.011504071735733246, "x": 0.577817535056706, "text": "Jade: Really? I thought it was more!", "w": 0.2576028611924913, "y": 0.7309011629151467}, {"y": 0.7473401164762296, "w": 0.15205724080403638, "x": 0.5545617210112197, "h": 0.011554287852793362, "text": "2 Ruth: How many"}, {"h": 0.008851743820341951, "y": 0.7486046514088698, "x": 0.8175313073439379, "text": "visit France", "w": 0.07871198018391923}, {"y": 0.7611417433554347, "h": 0.011597326494726369, "x": 0.6332419080949628, "text": "every year?", "w": 0.07698666890462236}, {"y": 0.7751598838456019, "h": 0.010116278651819317, "x": 0.5742397158067333, "w": 0.03935599009195956, "text": "lan:"}, {"text": "Oh, more than 80 million!", "x": 0.6135957070086557, "w": 0.19499104817708335, "h": 0.011549722649130153, "y": 0.7749909748112682}, {"text": "3 Joe:", "x": 0.5544578642093221, "w": 0.05924169752332897, "h": 0.009571129010472426, "y": 0.7925036796296048}, {"w": 0.2844364929199219, "h": 0.011572548293034566, "x": 0.6332737070060498, "y": 0.7928633723123123, "text": "Alan is going to Antarctica for his holiday."}, {"h": 0.010361724338806898, "x": 0.5723909967780967, "y": 0.8066505332079735, "text": "Rick:", "w": 0.041264
43229174, "x": 0.5562830835012565, "h": 0.00929854295744361, "text": "6 corn", "y": 0.3601690424611479}, {"x": 0.8085867649511627, "text": "g pancakes", "y": 0.36039244190588066, "h": 0.011399074297949709, "w": 0.09123434278700093}, {"x": 0.5688729970754116, "h": 0.012709259668412161, "y": 0.384354693508161, "w": 0.30769229465060766, "text": "I love fruit pancakes. My favourites are with"}, {"w": 0.30769229465060766, "x": 0.5724508064015895, "y": 0.3983284886754617, "text": "strawberries. What are your favourite kinds?", "h": 0.012722955653813801}, {"h": 0.008851743820341951, "w": 0.007155635091993462, "text": "1", "x": 0.5509838997169728, "y": 0.4122383721652288}, {"x": 0.57066190174191, "y": 0.4122292418997171, "h": 0.011389943890623293, "w": 0.1270125155978733, "text": "When you have a"}, {"y": 0.41320419830816885, "h": 0.013242765850108498, "w": 0.10211283365885415, "text": "_, do you put", "x": 0.8156698794381044}, {"x": 0.5688729885067658, "text": "mustard or ketchup on it?", "y": 0.4274127908830198, "h": 0.012690999602582971, "w": 0.18783542209201387}, {"y": 0.4412815886597346, "x": 0.5474060858307197, "h": 0.014133574007220224, "text": "2 In Italy, they often put", "w": 0.18425759209526904}, {"text": "on bread. I", "y": 0.44245938622380454, "w": 0.08050089518229164, "h": 0.010244102107918991, "x": 0.8604651171971667}, {"y": 0.45523255830125176, "h": 0.015174417977729072, "text": "know it's unhealthy, but | prefer butter. Which do you", "w": 0.37745975070529514, "x": 0.5688729831983363}, {"text": "prefer on your bread?", "h": 0.012645348314774147, "w": 0.15742396036783857, "x": 0.5706619000188238, "y": 0.46914244191092686}, {"x": 0.549194991278784, "text": "3", "y": 0.48431686055945106, "w": 0.008944543202718092, "h": 0.008851743820341951}, {"y": 0.48431686063149365, "w": 0.18604649861653644, "h": 0.012713825246487289, "x": 0.5617173612462935, "text": "Some people always call"}, {"h": 0.013909883895075253, "x": 0.8747763882629347, "y": 0.4855813954356382, "text": "ketchup.", "w": 0.06618962181939014}, {"y": 0.4982084840647581, "x": 0.5688729913981411, "w": 0.2665473937988281, "h": 0.013928143960904539, "text": "Do you put ketchup on a lot of food?"}, {"x": 0.5474060883462037, "h": 0.012955776173285189, "text": "4 For lunch, I often have two", "y": 0.5119494583984637, "w": 0.21288013034396702}, {"x": 0.57066190439523, "w": 0.17173522949218745, "h": 0.011431029974768718, "text": "Sometimes, I have ham.", "y": 0.5272608302710584}, {"w": 0.010733451843261799, "x": 0.5474060827843917, "text": "5", "y": 0.5412209306101368, "h": 0.010116278651819317}, {"y": 0.5417891059413459, "x": 0.5579685522269686, "w": 0.10765023125542539, "h": 0.01215880086706001, "text": "I always have"}, {"h": 0.01147211568450232, "y": 0.5424854654304084, "w": 0.1377459716796875, "text": "with lots of milk on", "x": 0.7924865831002277}, {"h": 0.012645348314774147, "text": "them for breakfast.", "y": 0.5551308140882525, "w": 0.1359570651584201, "x": 0.568872987456568}, {"x": 0.5474060825756858, "text": "6", "h": 0.008851743820341854, "w": 0.010733451843261688, "y": 0.570305232630345}, {"text": "Jenny: This is a lovely", "y": 0.5703052324868737, "h": 0.013909883895075253, "x": 0.5670840748717231, "w": 0.159212883843316}, {"x": 0.8533094856320913, "y": 0.5715697676611495, "w": 0.09302324930826822, "h": 0.011440160007683409, "text": ". Thank you."}, {"text": "Mum: Well, it's a special day. You're eighteen. An adult.", "x": 0.5688729911839756, "h": 0.013937274368231051, "y": 0.5841877256872281, "w": 0.37924865722656254}, {"x": 0.5205724524492619, "text": "WORD STORE 2D | Cooking verbs", "w": 0.2701252237955729, "y": 0.6081362817227773, "h": 0.015311371841155259}, {"h": 0.015591295617582105, "x": 0.5186227945368597, "text": "4 Choose the correct option.", "y": 0.6283855802465781, "w": 0.2293163045247396}, {"x": 0.5688729909773175, "w": 0.2969588555230035, "text": "1 Fry / Slice the omelette for one minute", "y": 0.6739970932425449, "h": 0.011481246091828833}, {"x": 0.5921288027527619, "h": 0.010276057784738096, "y": 0.6890117327039623, "w": 0.09481216430664063, "text": "on each side."}, {"y": 0.7207848834599843, "x": 0.6082289836780759, "h": 0.013909883895075253, "w": 0.2397137620713976, "text": "2 Mix/ Chop the fruit into small"}, {"x": 0.6332737020318316, "y": 0.7359593026711013, "text": "pieces and put them into a bowl.", "w": 0.23434704250759542, "h": 0.012727520483065188}, {"y": 0.7701017443966827, "x": 0.550983910558964, "h": 0.012741215719643087, "w": 0.30948120117187494, "text": "3 Boil / Fry the potatoes in some water for"}, {"text": "about 25 minutes.", "w": 0.13416815016004768, "x": 0.5688729894324985, "y": 0.7851985561401992, "h": 0.011458420447924517}, {"text": "4 Slice / Mix the eggs with the potatoes,", "x": 0.5939177092950485, "h": 0.015174417977729072, "y": 0.8156250001617168, "w": 0.3005366685655382}, {"y": 0.8296080717193742, "x": 0.6204000348565241, "text": "then add salt and pepper.", "h": 0.014939059694751488, "w": 0.1849637518988715}, {"h": 0.01162790690711013, "text": "hot, you put some of", "y": 0.8793604651995458, "w": 0.1481481424967448, "x": 0.11111111270224487}, {"text": "the mixture into the", "y": 0.8938953490003102, "w": 0.13991769578721788, "h": 0.010343269425995505, "x": 0.10905349953437457}, {"x": 0.10905349912263448, "y": 0.9084302326898559, "text": "pan and make a pancake. You fry it on both sides.", "h": 0.01162790690711002, "w": 0.34362138536241316}, {"y": 0.9215070641023192, "h": 0.013085958909015205, "x": 0.10905350383853352, "text": "Take it out of the pan and put the fruit on top.", "w": 0.3209876505533854}, {"text": "Be careful not to let it burn.", "y": 0.879360465151096, "w": 0.19547324286566847, "h": 0.01162790690711002, "x": 0.5761316937677831}, {"text": "6 Slice / Boil the cheese thinly and put it", "y": 0.9127906981187528, "x": 0.5637860177913209, "w": 0.2962962849934896, "h": 0.013081394896215293}, {"y": 0.9273255814214616, "h": 0.008720930180332598, "x": 0.5864197563366381, "w": 0.10082304212782112, "text": "on the bread."}, {"text": "27", "w": 0.0246913570827908, "x": 0.911522634010045, "h": 0.013081394896215293, "y": 0.9563953489327063}]
[{"h": 0.024026162546894568, "w": 0.02683363172743057, "x": 0.09838998190014876, "y": 0.04425872088051865, "text": "3"}, {"y": 0.04552325600698508, "h": 0.024026162546894665, "x": 0.12880143094073218, "w": 0.030411449008517805, "text": "4"}, {"text": "READING", "w": 0.1502683342827691, "x": 0.21288014538097677, "h": 0.01896802322098491, "y": 0.01770348831574299}, {"h": 0.015280447668977633, "y": 0.058120415892368105, "text": "Part-time jobs • guessing meaning", "x": 0.21095554112732923, "w": 0.2614519755045573}, {"y": 0.07207848842255483, "x": 0.21109123776687574, "w": 0.24150266859266492, "h": 0.012722955653813704, "text": "from context • emphasis • work"}, {"w": 0.10554561191134984, "y": 0.08833483761983053, "text": "• collocations", "x": 0.21109123873722904, "h": 0.009034348222753223}, {"y": 0.12392441880181093, "x": 0.08050091004660165, "w": 0.37030409071180553, "text": "1 Read the texts and answer the questions. Write", "h": 0.011522332175974353}, {"w": 0.37924865722656254, "x": 0.10196780398063639, "text": "T (Tess), M (Matt) or S (Sylvie). Write N if a question", "y": 0.13780234689816565, "h": 0.014133574007220224}, {"w": 0.24508049858940972, "h": 0.013932709538979664, "x": 0.10196780254531555, "text": "doesn't match any of the people.", "y": 0.15174418593234187}, {"text": "Who ...", "x": 0.5527728099896887, "y": 0.032877907185718216, "h": 0.010308013461557103, "w": 0.05187835269504115}, {"text": "1 works outside?", "y": 0.04671931402551679, "w": 0.1270125155978733, "h": 0.010207581227436775, "x": 0.55277281069838}, {"w": 0.17173522949218745, "y": 0.05928249123416507, "h": 0.012955776173285189, "text": "2 works in the evening?", "x": 0.5527728172157428}, {"w": 0.008944543202718092, "h": 0.008851743820341854, "text": "3", "y": 0.07460755817485815, "x": 0.5527728088100899}, {"x": 0.57423971340567, "w": 0.3452593994140625, "text": "does the job because he/she can't find anything else?", "y": 0.07459386308830243, "h": 0.012659043551352143}, {"h": 0.008851743820341951, "text": "4", "x": 0.5527728088100899, "y": 0.0885174418957883, "w": 0.008944543202718092}, {"h": 0.011563418260119874, "x": 0.5724508029072535, "text": "sometimes wears special clothes?", "w": 0.23255813598632802, "y": 0.08833483738196454}, {"y": 0.10242732562176478, "w": 0.008944543202718092, "x": 0.5527728088100899, "h": 0.010116278651819317, "text": "5"}, {"h": 0.010248666937170475, "y": 0.10242732587467177, "x": 0.5688729888734646, "text": "works in an office?", "w": 0.13416815016004768}, {"y": 0.11760174451642788, "h": 0.008851743820341951, "x": 0.5527728089889808, "text": "6", "w": 0.008944543202718092}, {"y": 0.1162093861495946, "h": 0.012955776173285189, "x": 0.5760286195083549, "w": 0.32379248725043397, "text": "doesn't always earn the same amount of money?"}, {"text": "7", "x": 0.5509839000175463, "w": 0.010733451843261688, "h": 0.008851743820341951, "y": 0.13151162815305578}, {"text": "sometimes works with other people?", "x": 0.5706619056454182, "w": 0.2540250311957466, "h": 0.012645348314774147, "y": 0.13151162832626115}, {"w": 0.19499104817708335, "h": 0.011540592616215558, "x": 0.55098390587568, "y": 0.1452617329197642, "text": "8 does more than one job?"}, {"h": 0.011536027412552254, "x": 0.5509838992698055, "y": 0.15806686076343882, "text": "9 works for different businesses?", "w": 0.23255813598632813}, {"text": "10 can eat when he/she is working?", "y": 0.17313628167685646, "h": 0.0127503461269696, "w": 0.2540250311957465, "x": 0.5420393656633075}, {"y": 0.21851617289242345, "x": 0.09833147572026105, "text": "YoungPeople.ed", "w": 0.12712953355577258, "h": 0.01567114268829685}, {"h": 0.011431029974768718, "w": 0.1431126912434897, "text": "Home I Search I Contact", "x": 0.7674418636805808, "y": 0.2225581398173996}, {"h": 0.03416983316951707, "text": "Young people and ... money", "x": 0.09660106003153505, "y": 0.25164244146622705, "w": 0.6064400906032987}, {"text": "How can you earn a bit of extra pocket money? Here are some ideas.", "y": 0.2857848836114459, "h": 0.021620350761964384, "x": 0.09838997849611714, "w": 0.8157423909505208}, {"w": 0.017889086405436183, "h": 0.012645348314774242, "x": 0.37567084150211194, "text": "2", "y": 0.3123401166193207}, {"x": 0.1037567092057932, "y": 0.3262499996388474, "text": "Tess, aged 20", "w": 0.10912343343098958, "h": 0.012645349063597886}, {"text": "I'm a student and, to earn a little bit", "w": 0.26118067423502606, "x": 0.09838998499339936, "y": 0.35406976749388674, "h": 0.013909883895075253}, {"h": 0.013932709538979569, "w": 0.2576028611924913, "x": 0.10017889024454152, "text": "of money, I do leafleting for local", "y": 0.36924418578556556}, {"w": 0.2576028611924913, "text": "businesses. It's really dull work and", "h": 0.012955776173285286, "x": 0.1001788918008921, "y": 0.3855324908225506}, {"text": "quite tiring. I stand in the street all day", "x": 0.09838998052147493, "h": 0.012659044300175787, "y": 0.40084386247857756, "w": 0.2593917677137587}, {"x": 0.09838998635778966, "h": 0.012686434773331584, "y": 0.4160319769548221, "w": 0.25939176771375866, "text": "on Saturday and give people leaflets"}, {"y": 0.4310740071502871, "x": 0.09660107587031205, "text": "for pizza restaurants, shops and", "h": 0.014133574007220224, "w": 0.2593917677137587}, {"y": 0.44510224692750266, "w": 0.257930179172092, "h": 0.01544970953077192, "x": 0.09823458886516183, "text": "children's play areas. Sometimes, the"}, {"x": 0.0983899811658295, "w": 0.2576028611924913, "text": "company I am working for gives me", "h": 0.013909883895075253, "y": 0.46155523229719353}, {"w": 0.2576028611924913, "x": 0.09838998469892425, "y": 0.47661552379524325, "text": "an outfit to put on - like a snail outfit", "h": 0.012759475785472374}, {"h": 0.013909883895075253, "text": "for a French restaurant! I don't get", "y": 0.49190406962768035, "w": 0.261180674235026, "x": 0.09660107829691747}, {"y": 0.508343023495956, "w": 0.2576028611924913, "h": 0.012645348314774147, "x": 0.0983899847883697, "text": "paid much - £40 for a whole day."}, {"h": 0.014133574007220224, "w": 0.2576028611924913, "text": "Sometimes, two of us work together.", "y": 0.52333483751008, "x": 0.09838998443058794}, {"w": 0.2593917677137586, "h": 0.014133574007220224, "x": 0.09660107323167169, "text": "That's good because we can chat", "y": 0.5386462092641086}, {"h": 0.012645348314774147, "x": 0.096601076360514, "text": "and laugh together.", "y": 0.5551308141894152, "w": 0.1377459716796875}, {"text": "Matt, aged 16", "w": 0.10931557549370657, "y": 0.32586342584252836, "x": 0.3755747706411118, "h": 0.014683032380114404}, {"text": "I live in a small town and there aren't", "y": 0.35530234655686643, "x": 0.3703041151003865, "w": 0.2629695807562934, "h": 0.01141276953452761}, {"w": 0.261180674235026, "h": 0.013909883895075253, "text": "many part-time jobs for people of my", "y": 0.3705087210170336, "x": 0.37030412044062644}, {"w": 0.10769230312771272, "h": 0.0398749996006274, "y": 0.3806250001220078, "text": "any hot. +", "x": 0.36923077228229745}, {"w": 0.25760286119249126, "x": 0.3738819346989242, "h": 0.014133574007220224, "y": 0.3855324910228662, "text": "age. In fact, there aren't any. That's"}, {"text": "why I work for myself. I do tutoring.", "y": 0.4008438628032391, "w": 0.25939176771375866, "h": 0.013923579131653152, "x": 0.3720930275026913}, {"y": 0.41603197659388674, "h": 0.013909883895075349, "w": 0.25939176771375866, "text": "I'm very good at Maths and Sciences", "x": 0.3720930275026913}, {"x": 0.3719688852897335, "h": 0.014876747079704582, "text": "and a lot of children need help with", "y": 0.4305874924691396, "w": 0.25964396158854175}, {"text": "these subjects. I go to their homes", "x": 0.37209302392969346, "w": 0.2576028611924913, "y": 0.4475631770565893, "h": 0.012727520483065188}, {"h": 0.012645348314774147, "w": 0.25760286119249126, "y": 0.4628197677663048, "text": "after school and help them with", "x": 0.3720930216398904}, {"y": 0.4779941862445024, "text": "homework or revision. I only tutor", "x": 0.3720930270703717, "h": 0.012754910956220987, "w": 0.25939176771375866}, {"x": 0.3720930216398904, "w": 0.25760286119249126, "y": 0.49310469326314116, "h": 0.014133574007220224, "text": "one child a day, so I still get home"}, {"w": 0.2593917677137587, "y": 0.5083430235802582, "x": 0.3703041129007235, "h": 0.012645348314774242, "text": "by 5 p.m. I earn different amounts"}, {"y": 0.52333483751008, "h": 0.014133574007220224, "w": 0.2593917677137587, "text": "from different people. Some of the", "x": 0.37030411583900624}, {"y": 0.5398240073499944, "x": 0.36851520478355004, "w": 0.2593917677137587, "h": 0.012955776173285189, "text": "families don't have much money, so"}, {"h": 0.013909883895075253, "y": 0.5538662788088213, "x": 0.36851520417979333, "w": 0.2593917677137587, "text": "I don't charge much - but I never do"}, {"text": "it for free! When I have a lot of school", "y": 0.5703052328564622, "h": 0.01152689700522574, "w": 0.2593917677137587, "x": 0.3703041142903223}, {"h": 0.015573339574173454, "text": "work or when exams are coming up,", "y": 0.5829941243461035, "x": 0.3719154914549543, "w": 0.2580657111273871}, {"h": 0.012645348314774147, "x": 0.3685152092362945, "text": "I take a week off.", "w": 0.1252236090766059, "y": 0.6006540700286594}, {"x": 0.6511627950277679, "h": 0.012732085312316477, "text": "Sylvie, aged 17", "y": 0.327427798071524, "w": 0.11985688103569869}, {"text": "I don't have a regular job, but when", "x": 0.6440071598860648, "h": 0.014133574007220224, "w": 0.261180674235026, "y": 0.35530234636115154}, {"w": 0.261180674235026, "text": "I need money, I do babysitting. The", "x": 0.6440071551454566, "h": 0.013909883895075253, "y": 0.37050872085896674}, {"w": 0.261180674235026, "x": 0.6457960697876747, "y": 0.3843546931725162, "text": "great thing is that I can say \"Yes\" or", "h": 0.014133574007220224}, {"text": "'No'. It depends on what my plans", "w": 0.2597983127170138, "h": 0.015273577960389667, "x": 0.6455655499690219, "y": 0.40037512108238826}, {"w": 0.2576028611924913, "h": 0.012686434773331489, "text": "are, so l never miss any parties", "x": 0.647584971550445, "y": 0.4160319767946478}, {"w": 0.2576028611924913, "x": 0.6475849742785307, "text": "or concerts. I always work in the", "y": 0.4310740074827705, "h": 0.012955776173285093}, {"text": "evening and it isn't hard work at all.", "y": 0.4475631769090603, "w": 0.2593917677137587, "h": 0.01272752048306509, "x": 0.6457960682152732}, {"w": 0.2593917677137587, "h": 0.012645348314774147, "text": "The children I look after are asleep or", "x": 0.6457960687593997, "y": 0.462819767861145}, {"y": 0.4779941862866535, "text": "getting ready for bed when I arrive.", "x": 0.6457960682152732, "w": 0.2593917677137587, "h": 0.012754910956220987}, {"text": "I tell them a story, switch their lights", "x": 0.6422182463798036, "y": 0.4931046932262589, "w": 0.261180674235026, "h": 0.014133574007220224}, {"x": 0.6457960650030388, "text": "off and, after that, I can just sit and", "y": 0.5083430233078402, "w": 0.2576028611924913, "h": 0.013909883895075253}, {"x": 0.6440071546941045, "text": "watch television. There is even food", "h": 0.011508636564984633, "w": 0.2593917677137587, "y": 0.5247819770425086}, {"text": "for me to eat and, for four hours,", "x": 0.6440071605867207, "y": 0.539824007303628, "w": 0.2611806742350261, "h": 0.012955776173285189}, {"text": "I earn £24.", "h": 0.014155176073205182, "x": 0.6419991066716875, "y": 0.5543759003270397, "w": 0.08272808498806428}, {"w": 0.050089446173773866, "x": 0.3953488371546157, "h": 0.021497092883939837, "text": "10", "y": 0.7587209302468928}, {"x": 0.07493152289479377, "y": 0.8464549556456409, "text": "GLOSSARY", "h": 0.012947646943240389, "w": 0.0826950920952691}, {"x": 0.08641976219082204, "w": 0.24485595703125002, "y": 0.8806907380704981, "h": 0.013343799058084804, "text": "or organisations that sell something"}, {"h": 0.01162790690711002, "y": 0.8938953486782278, "x": 0.08641975573681912, "w": 0.11522633022732204, "text": "or offer a service"}, {"text": "something such as time, money.", "h": 0.011773940345368938, "y": 0.8822605964308506, "x": 0.35802468944291066, "w": 0.2201646084255643}, {"x": 0.3580246928249783, "h": 0.010204081632653073, "w": 0.10082304212782117, "text": "or a substance", "y": 0.8967817895110755}, {"h": 0.013343799058084804, "text": "because you can't for some reason", "x": 0.6090535034341443, "y": 0.8806907379312056, "w": 0.24279834323459204}, {"text": "40", "y": 0.9375000002989853, "w": 0.0246913570827908, "x": 0.0720164611293865, "h": 0.013081394896215404}]
[{"x": 0.10017889141176148, "h": 0.029084303370451706, "text": "5.4", "y": 0.06575581335992313, "w": 0.06440071529812283}, {"text": "READING", "x": 0.21639623005315545, "h": 0.018221414545382827, "w": 0.14681398179796007, "y": 0.038941618242239545}, {"w": 0.2701252237955729, "text": "Alternative education • word families", "x": 0.21645796280406204, "h": 0.011504071735733246, "y": 0.07840116297310458}, {"w": 0.22219002617730035, "x": 0.2126904864673105, "y": 0.09266784490862648, "text": "• phrasal verbs • collocations", "h": 0.01509324399142488}, {"text": "1 Read the text quickly and decide which classroom,", "w": 0.3899820963541666, "h": 0.013909883895075253, "x": 0.5277280916708595, "y": 0.050581395435638235}, {"w": 0.377860344780816, "h": 0.017065471131018344, "text": "A or B, looks like a classroom in the Waldorf School.", "x": 0.5507613268400031, "y": 0.0619635980851398}, {"w": 0.014311270183987146, "x": 0.550983899720171, "text": "A", "y": 0.08345930243339271, "h": 0.010116278651819317}, {"text": "B", "y": 0.0834593024317306, "w": 0.008944543202718092, "h": 0.0075872089888644875, "x": 0.6493738823342402}, {"w": 0.38492346869574645, "h": 0.015832186210026338, "text": "2 Read the text again. Are sentences 1-6 true (T) or", "x": 0.5293671775791366, "y": 0.10677415610502383}, {"y": 0.12357982746590046, "text": "false (F)?", "x": 0.5508685823062421, "w": 0.06642025841606991, "h": 0.012069996367292668}, {"text": "1 The writer gives four examples of how students", "x": 0.5525913058966997, "y": 0.1374711382884478, "w": 0.3491925387912327, "h": 0.015579347386687273}, {"x": 0.5742397171398607, "text": "and teachers can use technology", "y": 0.15300872098069432, "w": 0.23076922946506084, "h": 0.01266817395867856}, {"x": 0.5527728088726447, "text": "2", "h": 0.008851743820341951, "w": 0.010733451843261688, "y": 0.16944767449081016}, {"text": "The staff and parents agree about not using", "x": 0.5724508042168343, "y": 0.1680324910654629, "w": 0.30411448160807286, "h": 0.011531462208889044}, {"text": "technology at school.", "h": 0.012645348314774147, "x": 0.5724508098078311, "y": 0.18209302349174084, "w": 0.15384614732530377}, {"w": 0.010733451843261688, "x": 0.5527728088726447, "h": 0.008851743820341951, "text": "3", "y": 0.1972674419326706}, {"x": 0.5760286361674124, "y": 0.194729241899717, "text": "Students mustn't leave their desks during", "h": 0.011389943890623196, "w": 0.28443647596571175}, {"x": 0.5740546007679965, "y": 0.21181284509919926, "w": 0.06119047800699873, "h": 0.008893804498527825, "text": "lessons."}, {"y": 0.22255814000685703, "w": 0.3381037394205729, "h": 0.012645348314774242, "x": 0.5527728173797553, "text": "4 The writer doesn't say that students do better"}, {"h": 0.01156798308937126, "text": "without technology", "x": 0.5760286244951105, "y": 0.23773255845366414, "w": 0.13416815016004768}, {"x": 0.565295173523733, "y": 0.2491133724385432, "text": "The lessons at the school are interesting for", "w": 0.31127010769314234, "h": 0.012750346126969504}, {"x": 0.5760286258113296, "w": 0.09123434278700093, "y": 0.26681686063216187, "h": 0.008851743820341951, "text": "the students."}, {"w": 0.2933810424804688, "x": 0.5509838968277442, "h": 0.012645348314774242, "y": 0.27946220968999663, "text": "6 The writer says that 160 students go to"}, {"h": 0.012659043551352046, "y": 0.29209386313888386, "text": "the Waldorf School of the Peninsula.", "w": 0.2576028611924913, "x": 0.574239716881393}, {"text": "B", "y": 0.3439534884799043, "w": 0.012522361543443494, "h": 0.010116278651819317, "x": 0.49731663667013876}, {"h": 0.029084303370451706, "y": 0.4210901159020561, "w": 0.2576028611924913, "x": 0.12701252183667028, "text": "ALTERNATIVE"}, {"y": 0.4539680225879574, "w": 0.21824686686197914, "text": "EDUCATION", "h": 0.02908430337045161, "x": 0.17352415238296393}, {"w": 0.3649373711480035, "y": 0.5247819771335192, "x": 0.1252236184689321, "text": "Technology is changing our lives and many people", "h": 0.015174417977728975}, {"x": 0.12701253453333272, "w": 0.36493737114800345, "h": 0.014133574007220128, "y": 0.5398240069637683, "text": "believe that school pupils should all have laptops,"}, {"text": "look at interactive whiteboards and do all their", "y": 0.5545347358436017, "x": 0.1251100170418026, "w": 0.36694875081380207, "h": 0.014690836620675114}, {"y": 0.5703052330233449, "w": 0.3649373711480035, "h": 0.015174417977728975, "text": "homework online. Los Altos, California, is a city", "x": 0.12701253152796602}, {"x": 0.12522362527786704, "w": 0.3667262776692708, "text": "in an area known as 'Silicon Valley' because it is", "h": 0.015311371841155162, "y": 0.5841877253002995}, {"x": 0.12701253378199107, "text": "home to many technology companies such as", "y": 0.6006540695412705, "w": 0.36493737114800345, "h": 0.013909883895075253}, {"y": 0.6143864811009477, "w": 0.36532107883029513, "h": 0.018901525430300613, "x": 0.12681686502297496, "text": "Google, Apple, Yahoo and Hewlett-Packard. So"}, {"h": 0.015554699105906528, "x": 0.12686145771182952, "y": 0.6296870548653022, "text": "the Waldorf School of the Peninsula is a bit of", "w": 0.36522816975911454}, {"y": 0.6468767821491782, "x": 0.12681560530857472, "w": 0.07731691148546005, "h": 0.01504004006781739, "text": "a surprise"}, {"x": 0.12701252945283195, "h": 0.015311371841155259, "text": "The staff and parents here believe that there", "y": 0.6650631771720596, "w": 0.3649373711480035}, {"x": 0.12701253437233093, "w": 0.3649373711480035, "h": 0.015174417977728975, "text": "shouldn't be any technology in our schools. There", "y": 0.6790552326819204}, {"w": 0.3637232462565104, "x": 0.12673300506083143, "text": "are no computers in the classrooms. No screens", "y": 0.6933673633952931, "h": 0.018688700001162326}, {"y": 0.7077067059106363, "x": 0.12673250912816475, "w": 0.36546973334418403, "h": 0.018752323057677368, "text": "at all. The teachers write on blackboards and"}, {"h": 0.015174417977728975, "y": 0.7245784885338099, "w": 0.3649373711480035, "text": "the classrooms are full of books, posters and", "x": 0.12701253431866366}, {"h": 0.01807077667773416, "text": "magazines. There are wooden desks and pupils", "y": 0.7395780428956598, "w": 0.36535071478949654, "x": 0.12680603848239974}, {"x": 0.12701252870149024, "text": "write on paper with pens and pencils. This doesn't", "h": 0.015311371841155259, "w": 0.3649373711480035, "y": 0.7561462096425128}, {"text": "mean that the teachers just stand at the front of", "y": 0.7691811843015425, "h": 0.018833067219179902, "x": 0.12673443172650511, "w": 0.3672987535264757}, {"x": 0.12701253453333272, "y": 0.7878052327687758, "w": 0.36493737114800345, "h": 0.012704694839160775, "text": "the class and the students quietly do exercises."}, {"text": "They get up and do fun activities and play games", "x": 0.12701253392510378, "h": 0.015311371841155259, "y": 0.8016877252862491, "w": 0.3649373711480035}, {"x": 0.12677780913614273, "text": "that help them to learn and remember.", "w": 0.28299974229600694, "y": 0.8161454908892454, "h": 0.016663865750447125}, {"h": 0.015311371841155259, "x": 0.5134168217229349, "text": "Are the methods successful? It's difficult to say for", "y": 0.5209792419148556, "w": 0.3828264702690972}, {"x": 0.5116279049817306, "w": 0.3828264702690972, "text": "sure. Most of the students succeed in their exams", "y": 0.5374273256049698, "h": 0.013909883895075253}, {"x": 0.5134168217974727, "h": 0.015311371841155259, "y": 0.5512093859700066, "w": 0.3828264702690972, "text": "but is this success because of the school or because"}, {"y": 0.5650413097482383, "x": 0.5114336013103472, "h": 0.01917212560288751, "w": 0.38511586507161455, "text": "they have parents who think education is important?"}, {"x": 0.5134168223609791, "y": 0.581686046749217, "text": "People who like the school say that the students use", "w": 0.3828264702690972, "h": 0.015174417977728975}, {"y": 0.594845913692044, "x": 0.5131581645522576, "h": 0.018433133961922032, "w": 0.3833267550998264, "text": "their imagination more. The teachers certainly work"}, {"text": "hard to create imaginative lessons and the students", "w": 0.3828264702690972, "x": 0.513416821538081, "y": 0.612034883882647, "h": 0.015338762314311059}, {"text": "enjoy them. Parents also say that learning without", "x": 0.5134168146865605, "h": 0.016438953558030083, "y": 0.6272093024962393, "w": 0.3828264702690972}, {"y": 0.6422924185163319, "x": 0.5134168214307465, "text": "computers helps the children to develop better", "h": 0.015311371841155259, "w": 0.3828264702690972}, {"y": 0.6575581392945679, "w": 0.3828264702690972, "text": "problem solving skills and this actually helps them to", "x": 0.5134168207688502, "h": 0.016534820962899023}, {"text": "use computers later in life.", "y": 0.67399709290457, "w": 0.19499104817708324, "h": 0.013909883895075253, "x": 0.5134168210068668}, {"y": 0.6917005815249094, "h": 0.016548516199476924, "text": "However, others disagree. They say that students", "w": 0.3828264702690972, "x": 0.5134168160640202}, {"text": "who study at the school are unprepared for our", "x": 0.513175044092734, "y": 0.7049177237183415, "h": 0.01903080909260767, "w": 0.38333926730685763}, {"y": 0.7205538556957651, "text": "technological world when they leave. One thing is for", "h": 0.01903410766098905, "w": 0.3833325534396702, "x": 0.5131731691882765}, {"text": "sure. The schools are very popular. There are 160", "x": 0.5134168147044496, "w": 0.3828264702690972, "y": 0.7359593027654959, "h": 0.015174417977728975}, {"x": 0.5134168244625994, "y": 0.7522202168235114, "w": 0.3846153767903646, "h": 0.014133574007220224, "text": "Waldorf schools in the USA now and parents pay about"}, {"w": 0.3563120863172743, "text": "$20,000 a year to educate their children at them.", "x": 0.5132437181185702, "y": 0.7665415290474843, "h": 0.01709933293855578}, {"h": 0.018400717384118054, "w": 0.38316382514105907, "x": 0.5132818039681359, "y": 0.7821545435981271, "text": "What do you think? Do you agree with the parents"}, {"y": 0.7966187629636043, "h": 0.018253074062430034, "x": 0.5132324980690303, "w": 0.38499223497178814, "text": "or do you think students should use technology at"}, {"text": "school?", "w": 0.057304534912109295, "x": 0.5133870888056222, "h": 0.011530994568490804, "y": 0.8155499095983637}, {"x": 0.09465020509525507, "text": "GLOSSARY", "y": 0.8808139536103984, "w": 0.08230452643500433, "h": 0.01162790690711013}, {"text": "develop (v) - to grow or change into something bigger,", "y": 0.8982558141555744, "w": 0.3827160305447049, "h": 0.013081394896215293, "x": 0.109053513739993}, {"w": 0.19206665039062504, "x": 0.10667469136258591, "h": 0.014303746365677328, "text": "stronger, or more advanced", "y": 0.9129282459166537}, {"h": 0.013081394896215404, "w": 0.0246913570827908, "x": 0.09465020648946879, "y": 0.9476744189944796, "text": "64"}, {"x": 0.5246913588194043, "y": 0.8952119306275645, "text": "unprepared (adj) - not ready to deal with something", "h": 0.013343799058084804, "w": 0.36008229573567707}]
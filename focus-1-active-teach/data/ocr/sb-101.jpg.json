[{"y":0.018838304584283705,"text":"1) 3.51","x":0.086419753523843373,"w":0.053497941758897577,"h":0.011773940345368938},{"w":0.77058824327256936,"x":0.076470587456852535,"h":0.066666667465138052,"y":0.037499999392430983,"text":"ASTONISHING ANIMALS"},{"w":0.39300411648220485,"x":0.082304523737635624,"h":0.016091051805337542,"text":"Our planet is full of weird and wonderful","y":0.1118524335709179},{"h":0.014658099253847645,"text":"creatures. Meet three of them - animals","y":0.13069073747535753,"w":0.39094648573133678,"x":0.082304537704584388},{"text":"with surprising bodies, habits and abilities.","y":0.14952904217576268,"w":0.4218106757269966,"h":0.017660910518053408,"x":0.082304543952345238},{"x":0.092592596557650619,"y":0.18014128743930113,"text":"The animal that can't be true","h":0.016091051805337431,"w":0.32510287814670141},{"y":0.20486656228567546,"h":0.013343799058084804,"x":0.090534996627242403,"text":"When in 1798 zoologists in Britain first saw the skin","w":0.42181067572699649},{"w":0.42386830647786455,"y":0.22093023301228154,"x":0.09053498786189064,"h":0.014548574175153428,"text":"of an Australian platypus and a drawing of the animal,"},{"x":0.09259259985813717,"w":0.4197530788845486,"h":0.01162790690711013,"text":"they were sure it was a hoax. A creature like that could","y":0.23691860461330538},{"w":0.42181067572699654,"text":"not exist. Why not? First, it has fur, like cats and dogs,","h":0.014637563067665171,"x":0.092592609701659334,"y":0.25145348854764982},{"h":0.014708298154678223,"y":0.26726844554088902,"w":0.43209876166449657,"text":"s but also a flat bill like a duck, and a big thick tail like a","x":0.080246919064871039},{"x":0.090534994869697891,"w":0.42181067572699654,"h":0.014605617972333507,"y":0.28335949781625702,"text":"beaver. Secondly, it lays eggs and looks after them like"},{"w":0.41975307888454855,"h":0.013343799058084804,"text":"a bird, but when the young come out of the eggs, the","x":0.092592598675009616,"y":0.29788069071358436},{"text":"mother feeds them with her milk. On top of everything,","h":0.013081394896215404,"y":0.31395348862262873,"x":0.092592611553511062,"w":0.42181067572699649},{"w":0.4218106757269966,"h":0.014534882885320677,"x":0.090534993227036648,"y":0.32848837236547923,"text":"the platypus has a poisonous sting - like a snake! It"},{"y":0.34447674460385125,"w":0.33333333333333337,"text":"10 cannot kill a human, but it's very painful.","x":0.074074078240740596,"h":0.014628435790632444},{"h":0.014660380885963997,"text":"A platypus","x":0.54526749094262383,"y":0.34144426991716137,"w":0.096707814534505276},{"text":"Champion Runner","w":0.19753085666232639,"x":0.54938272122791965,"h":0.017660910518053408,"y":0.3763736267465474},{"x":0.54938272325645421,"w":0.38271603054470482,"y":0.40261627966925828,"h":0.014573672877001842,"text":"You probably know the cheetah is the fastest"},{"h":0.013106494346630582,"y":0.41860465146177606,"x":0.54938271349866585,"w":0.38065843370225694,"text":"runner among animals. It can run at up to 100"},{"text":"kilometres per hour. But after some 200 metres, it","x":0.55144033523220481,"h":0.013343799058084804,"y":0.43445839886217241,"w":0.38065843370225694},{"text":"needs to lie down and rest. The pronghorn, which","h":0.014683198704262934,"y":0.44897959181785474,"x":0.54938272056313753,"w":0.38065843370225694},{"x":0.52880657900611661,"h":0.01615037798320107,"w":0.4012345716688368,"text":"15 lives in the prairies of North America, can run","y":0.46350078474691014},{"x":0.54938273184698905,"y":0.48110465141332648,"w":0.38271603054470482,"text":"a few kilometres at ninety kilometres per hour,","h":0.013081394896215293},{"h":0.013081394896215293,"text":"and fifteen kilometres at sixty-five kilometres","x":0.54938271887418022,"y":0.49563953527354931,"w":0.38065843370225694},{"text":"per hour. Its whole body - heart, lungs, legs -","y":0.51162790711221218,"w":0.38271603054470482,"x":0.54938273025233886,"h":0.013097367818164618},{"x":0.54708117983147364,"text":"is a perfect machine for long-distance running.","w":0.38109907362196183,"h":0.01833438424150835,"y":0.52462056591687456},{"y":0.54199372068776897,"text":"20 But why? It doesn't need to run this fast now,","x":0.53292182259657117,"w":0.39917694091796874,"h":0.013343799058084804},{"x":0.54938271096094304,"y":0.55651491334064107,"text":"but 18,000 years ago there were cheetahs in","w":0.38065843370225694,"h":0.01470601652256176},{"x":0.54938271096094304,"w":0.38065843370225694,"y":0.57412790706001082,"text":"America. The pronghorn probably evolved to","h":0.011821857614083053},{"x":0.54938273184698905,"y":0.58866279085131101,"w":0.38271603054470482,"text":"escape them. This beautiful animal is not well-","h":0.013081394896215293},{"y":0.60319767507865751,"w":0.38271603054470482,"h":0.014541728530237052,"text":"known in Europe, but in America it is a symbol of","x":0.5493827296522017},{"w":0.39711934407552085,"y":0.61918604695596213,"h":0.013081394896215293,"x":0.5329218036481107,"text":"25 prairie life. You can see it in the emblem of the"},{"w":0.21810699462890626,"y":0.63500784942454425,"x":0.54938271818623274,"h":0.013343799058084693,"text":"province of Alberta, Canada."},{"x":0.1007807582182724,"text":"pronghorn","y":0.6292168725951659,"h":0.011915091629866703,"w":0.078273874918619785},{"y":0.664050235350236,"text":"Aliens in the ocean","x":0.088477369338793702,"h":0.017660910518053408,"w":0.21193415323893233},{"text":"An octopus has no fixed shape or colour. In danger, it will","x":0.090534979558698297,"w":0.43209876166449657,"y":0.69186046517907263,"h":0.013081394896215293},{"h":0.013108776727314142,"x":0.090534985628656972,"y":0.70784883733386905,"w":0.43209876166449651,"text":"change both. It can become like its surroundings and"},{"y":0.72370486665586831,"h":0.013343799058084804,"x":0.090534996706747015,"text":"difficult to see. Or it can look like a dangerous animal,","w":0.43415635850694445},{"h":0.013343799058084804,"x":0.072016468612022086,"text":"30 such as a sea snake, and scare an attacker away.","w":0.45061726888020831,"y":0.73822605959328458},{"x":0.090534985628656972,"h":0.013124748900696481,"w":0.43209876166449651,"text":"Octopuses are also intelligent. Their brains are large in","y":0.75431711126543444},{"x":0.090534987285397259,"text":"proportion to their body size. They can use tools and","y":0.76883830460025537,"w":0.42798353407118056,"h":0.014591927431067631},{"x":0.088477371852227149,"y":0.78488372122921801,"text":"solve problems: for example, open bottles to get food,","w":0.41769544813368054,"h":0.013081394896215293},{"y":0.80087209322534192,"x":0.090534992984088056,"h":0.013099649450281192,"w":0.39917694091796874,"text":"or use clever strategies to escape from an aquarium."},{"h":0.013085958909015316,"text":"35 It seems they are unhappy in a zoo or lab. But","y":0.8154069770613398,"x":0.072016456044238827,"w":0.3888888888888889},{"h":0.013343799058084693,"w":0.35185184054904517,"text":"they are so different from humans that it","x":0.088477368382884933,"y":0.83124018851174586},{"w":0.30246914333767361,"h":0.01179675778938416,"x":0.088477365512233133,"y":0.84576138165254289,"text":"is difficult for us to understand their"},{"x":0.086419754252668374,"text":"intelligence. In fact, it is a bit like","w":0.29423868815104171,"y":0.86185243317351334,"h":0.01460105470810058},{"text":"meeting intelligent aliens.","h":0.013081394896215293,"w":0.20164608425564234,"x":0.090534981260381897,"y":0.87790697718852029},{"h":0.016182323078532845,"x":0.64403292146627378,"text":"C octopus","y":0.91405023513970851,"w":0.090534981621636201},{"h":0.013081394896215293,"text":"101","y":0.95494186061875275,"x":0.90123456821178294,"w":0.034979423946804422}]
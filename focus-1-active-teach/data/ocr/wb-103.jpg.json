 {"text": "a film from the Internet in half a second.", "x": 0.5706618949754005, "h": 0.010207581227436775, "w": 0.2737030368381077, "y": 0.8016877257353162}, {"w": 0.008944543202718092, "text": "6", "x": 0.550983900044437, "h": 0.0075872089888644875, "y": 0.8168895349645795}, {"w": 0.34883721245659716, "x": 0.5599284362582848, "y": 0.8156250002511252, "text": "NOW: There are thousands of cheetahs in Africa.", "h": 0.010116278651819317}, {"text": "IN 20 YEARS:", "w": 0.10196779886881513, "h": 0.010207581227436872, "x": 0.5688729887140719, "y": 0.8307400722470873}, {"w": 0.09307073805067279, "h": 0.011576148262953539, "text": "any cheetahs", "x": 0.8175075642489671, "y": 0.8294372165223786}, {"w": 0.2665473937988281, "x": 0.5706619050504964, "text": "in Africa? Or will they only live in zoos?", "y": 0.8433032492701731, "h": 0.011522331801562532}, {"x": 0.13580247196917328, "text": "IN 20 YEARS:", "w": 0.10288065592447915, "y": 0.8735465120150874, "h": 0.010283943248131977}, {"y": 0.8735465117596233, "w": 0.09259258694118921, "h": 0.01162790690711002, "text": "to go fishing", "x": 0.3786008243277594}, {"y": 0.8865777081591802, "h": 0.011773940345368827, "x": 0.1316872430443701, "w": 0.248971184624566, "text": "in rivers. The water will be polluted."}, {"w": 0.29012346055772575, "y": 0.8952119309459053, "h": 0.010311324704947222, "text": "GRAMMAR: Train and Try Again page 135", "x": 0.5884773607447997}, {"x": 0.09465020598535358, "y": 0.9345930233778402, "text": "98", "h": 0.01162790690711013, "w": 0.0246913570827908}]
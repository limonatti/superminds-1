.0966010769093412, "h": 0.010116278651819317}, {"h": 0.008851743820341951, "text": "SPEAKING BANK", "x": 0.09123434649467252, "y": 0.7195203488725325, "w": 0.08228980170355901}, {"x": 0.09123434677498231, "text": "Order", "w": 0.025044723086886933, "h": 0.005058139325909658, "y": 0.7346947675282827}, {"x": 0.09123434579516912, "h": 0.00902978339350174, "y": 0.7459386283160695, "w": 0.1019677988688151, "text": "Are you ready to order?"}, {"y": 0.7675315882904288, "x": 0.0894454427877263, "h": 0.00902978339350174, "text": "I'd like a/an/some.../", "w": 0.09302324930826823}, {"text": "Can I have a/an/some", "x": 0.09095193240967257, "y": 0.7750268672511412, "w": 0.09174099392361111, "h": 0.0094161902739253}, {"y": 0.7991860466367451, "text": "What would you like to", "x": 0.08944544269828088, "h": 0.007605469429105692, "w": 0.09302324930826823}, {"text": "drink?", "y": 0.8067732558971422, "x": 0.08944543849674982, "w": 0.026833631727430557, "h": 0.006322674157387025}, {"h": 0.007646555513251116, "y": 0.8307400723318353, "text": "Large or small?", "x": 0.08765652938135005, "w": 0.06440071529812283}, {"y": 0.8421254512727394, "h": 0.00902978339350174, "text": "Anything else?", "x": 0.08586761992994875, "w": 0.06440071529812284}, {"w": 0.08586761474609374, "x": 0.08586762482731088, "h": 0.007851985559566801, "text": "No, thanks. That's it", "y": 0.8546886280314516}, {"x": 0.42367047787608764, "text": "The SHOW WHAT YOU'VE LEARNT", "y": 0.15162661863944815, "h": 0.012438237908084458, "w": 0.19373528374565968}, {"x": 0.42218246799141235, "h": 0.010116278651819317, "y": 0.16312500020897408, "w": 0.19320214165581595, "text": "tasks in the Vocabulary and Grammar"}, {"w": 0.1921610005696614, "x": 0.42178249193190426, "y": 0.17051803831952947, "text": "lessons help students to check their", "h": 0.015238981556806294}, {"h": 0.010207581227436872, "w": 0.18783542209201387, "text": "progress and be aware of their own", "x": 0.4221824698424843, "y": 0.1833438629061238}, {"x": 0.4239593547241123, "y": 0.19218010919407955, "h": 0.008910130352750232, "w": 0.0429578569200304, "text": "learning."}, {"y": 0.21970514099947933, "h": 0.01305935346692905, "w": 0.15272186279296873, "text": "SHOW WHAT YOU'VE LEARNT", "x": 0.4147006454789366}, {"x": 0.41323792298452483, "text": "7 Choose the correct option.", "y": 0.23773255839066001, "h": 0.010116278651819317, "w": 0.12880143059624566}, {"y": 0.2488290286341865, "x": 0.42370417447253633, "h": 0.01185392965478585, "text": "1 Iwork from / on / in home, so I don't need to dress", "w": 0.22768447875976566}, {"text": "smartly.", "y": 0.2592296513566262, "w": 0.033989266289605025, "h": 0.006322674157387121, "x": 0.43649373838173294}, {"y": 0.2654288854003703, "h": 0.011602909349792695, "text": "2 My mum works with / on / in a supermarket but", "w": 0.2132839796278212, "x": 0.42198089988635845}, {"text": "not on a checkout.", "h": 0.007651120716914421, "w": 0.07871198018391923, "x": 0.43649374058782575, "y": 0.2756046931114568}, {"h": 0.01349544292752916, "w": 0.21179755316840282, "x": 0.42001637835448363, "y": 0.2814377855463581, "text": "3 Kate is an actor/ acting / actress. Her dream is"}, {"y": 0.2920938627274268, "h": 0.0076009045998543055, "x": 0.4347048305327866, "w": 0.08407870822482638, "text": "to go to Hollywood"}, {"text": "4 I love working with / for / from animals. That's why", "w": 0.22421600341796877, "x": 0.42013375675428466, "h": 0.013585939768849661, "y": 0.2982439151319723}, {"h": 0.009982616617361236, "y": 0.3078496658266935, "text": "I work at our local 200.", "x": 0.434364688459757, "w": 0.09544358147515192}, {"y": 0.31604241893800095, "x": 0.42039356829448427, "w": 0.19856886121961803, "h": 0.010207581227436775, "text": "5 I don't want a badly- pay / money / paid job"}, {"w": 0.0733452606201172, "y": 0.3249854653151608, "text": "I want to be rich!", "x": 0.43291591945142033, "h": 0.0075872089888644875}, {"y": 0.33333159732155204, "x": 0.4237809958120434, "w": 0.1738741556803386, "text": "• Do you always work long / hand / team?", "h": 0.00968549835122447}, {"w": 0.2116577996148004, "x": 0.42366101115831695, "text": "My dad is a lawyer / plumber / mechanic People", "y": 0.3410415774033223, "h": 0.012145336268180505}, {"w": 0.21139940049913192, "h": 0.010810494379876752, "x": 0.4327707055498536, "text": "aften phone up in the middle of the night because", "y": 0.35011615216112063}, {"text": "there is water on their kitchen floor.", "x": 0.43269918466706636, "y": 0.35783466456796736, "h": 0.010291945951510109, "w": 0.14716171264648437}, {"text": "8 I work eight hours in / the / a day. start at 7 a.m.", "y": 0.36530887628459213, "w": 0.2188941107855903, "h": 0.01358905936836759, "x": 0.41824286083298845}, {"w": 0.07692307366265189, "y": 0.37556686059023336, "h": 0.0076100346327689005, "text": "and finish at 3 p,m", "x": 0.43291592387976524}, {"w": 0.2419241841634115, "h": 0.019525233416781116, "text": "Do you want a full time or part short/hait time job?", "y": 0.38269387446697845, "x": 0.4112441696456767}, {"x": 0.4273997500219934, "w": 0.21318601820203997, "text": "I don't want to work outside, so! don't want to be", "y": 0.3915779438186203, "h": 0.010666162730984731}, {"h": 0.00902978339350174, "text": "an accourtant / a gardener / a secretary.", "x": 0.43291592600629025, "y": 0.40084386269559075, "w": 0.16636850992838537}, {"h": 0.007587208988864585, "x": 0.6243291601469564, "text": "/10", "w": 0.01967799504597989, "y": 0.4172965117214107}, {"y": 0.4624513825700037, "w": 0.1954912990993924, "x": 0.4076604220704679, "h": 0.012365678389580179, "text": "The REMEMBER THIS boxes focus on"}, {"h": 0.014524806681953141, "y": 0.4719963169132441, "x": 0.40742916967469267, "text": "useful language nuances.", "w": 0.13684111701117618}, {"y": 0.4982084835913507, "h": 0.007605469803517514, "x": 0.4060822895328359, "text": "REMEMBER THIS", "w": 0.08228980170355898}, {"y": 0.5135705472791315, "h": 0.013013318781387916, "x": 0.4075742002209403, "w": 0.21518870035807297, "text": "College is a place where students go to study after"}, {"text": "secondary school. It is different from university.", "x": 0.40588643274131214, "w": 0.20082287258572046, "h": 0.011533430491974197, "y": 0.5223777059747263}, {"text": "If you leave school at the age of sixteen lafter", "x": 0.40608228806778845, "w": 0.19141323513454866, "h": 0.010294317850567286, "y": 0.5347202166555749}, {"w": 0.22059292263454866, "h": 0.012946823237174646, "x": 0.40581579059732487, "y": 0.5432791410871274, "text": "GCSE exams), you can go e.g. to a college of further"}, {"h": 0.013549645781947338, "x": 0.4040627983694157, "y": 0.5518541263586911, "text": "education and train for a specific job, or you can go to", "w": 0.22952351888020828}, {"text": "a sixth-form college - which is a two-year preparation", "y": 0.5604221382280313, "h": 0.013712663202939974, "w": 0.22947309705946184, "x": 0.40227942138254824}, {"y": 0.5703052327355003, "x": 0.4025044758086145, "text": "for A-level exams. When you have the right number of", "w": 0.23076922946506073, "h": 0.010116278651819317}, {"h": 0.01222264407774177, "w": 0.20803066677517368, "text": "A levels, you can apply for a place at a university.", "x": 0.40227220367660665, "y": 0.578585965645653}, {"h": 0.010983763197268815, "text": "In old universities, such as Oxford and Cambridge,", "x": 0.4022980978669433, "y": 0.591232264653494, "w": 0.21508936564127606}, {"text": "colleges are independent parts of the university.", "y": 0.6006540699764158, "h": 0.010230406496929367, "x": 0.4007155619731154, "w": 0.20572450425889754}, {"w": 0.20085998535156258, "h": 0.012338984322461909, "x": 0.4004529976774561, "text": "They can be located in different (often historic)", "y": 0.6080821238754364}, {"x": 0.398683482114694, "y": 0.6169152989818601, "text": "buildings. They usually offer many different subjects", "w": 0.22407567342122398, "h": 0.012464825642238067}, {"text": "Speaking tasks in the exam format help", "w": 0.1935595364040799, "x": 0.39874735344942475, "y": 0.6878248775570255, "h": 0.011610691125642565}, {"h": 0.010225841293266157, "w": 0.17710196601019967, "x": 0.3971377439179772, "text": "students prepare for their exams.", "y": 0.6980232560650786}, {"w": 0.060822898017035554, "text": "EXAM SPEAKING", "h": 0.007851985559566801, "x": 0.4239713784810469, "y": 0.7231678700810225}, {"text": "The SHOW THAT YOU'VE CHECKED", "x": 0.7278775648602948, "h": 0.011403764929582023, "y": 0.15711283382745442, "w": 0.19896828545464418}, {"x": 0.7280858689053649, "h": 0.010266927377411679, "y": 0.1680324909866521, "w": 0.1610017903645834, "text": "section in the Writing lessons is"}, {"y": 0.17703638690302204, "x": 0.7260798165889655, "text": "a useful checklist that accompanies", "h": 0.011995038366489854, "w": 0.18471421983506942}, {"y": 0.1871511630047179, "w": 0.11270124647352431, "h": 0.011504071735733246, "x": 0.7262969636147584, "text": "the final writing task."}, {"x": 0.7206618916498083, "w": 0.1525682237413194, "text": "SHOW THAT YOU'VE CHECKED", "h": 0.010968518270051906, "y": 0.2130113346795603}, {"w": 0.15817194620768238, "x": 0.7205471247869407, "y": 0.22779830664026307, "text": "Finished? Always check your writing", "h": 0.012642128372880895}, {"h": 0.011142719747357413, "text": "Can you tick / everything on this list?", "y": 0.2375745593401887, "w": 0.16323879665798602, "x": 0.7206770772948724}, {"y": 0.2527319905779165, "w": 0.05554997338189027, "h": 0.007937181477942598, "x": 0.7190944238944604, "text": "In my email:"}, {"h": 0.012029584973297387, "w": 0.19556777954101567, "text": "• I have started the email with an appropriate", "y": 0.26454152219436883, "x": 0.7188551503375527}, {"w": 0.1466905212402344, "h": 0.008851743820341951, "x": 0.7334525945229955, "text": "greeting, e.g. Greg, Hi Monica, etc.", "y": 0.27440406990287414}, {"h": 0.009029783393501837, "x": 0.7173524195310073, "text": "• I have explained the situation.", "y": 0.28699007224731016, "w": 0.1395348782009549}, {"text":
[{"x": 0.18962432865057444, "text": "EXAM SPEAKING", "y": 0.023948556291660848, "w": 0.2593917677137587, "h": 0.019237364620938613}, {"y": 0.08592711058229886, "w": 0.30085269504123263, "h": 0.014474456525451351, "x": 0.10718215904624621, "text": "1 In pairs, ask and answer the questions."}, {"h": 0.010248666937170475, "x": 0.1288014322167612, "y": 0.10482400714600672, "text": "PART 1", "w": 0.04651162465413411}, {"y": 0.12119291851266303, "x": 0.12842183069158591, "w": 0.1349366505940755, "h": 0.012846464387776558, "text": "Talk about sports."}, {"x": 0.1288014364407526, "h": 0.013909883895075253, "text": "1 Do you prefer watching or doing sports?", "y": 0.1353052324078403, "w": 0.3023255750868056}, {"x": 0.12701252639059715, "w": 0.3899820963541667, "h": 0.015311371841155259, "text": "2 What new sport would you like to try in the future? Why?", "y": 0.14918772539162692}, {"w": 0.37260335286458335, "x": 0.1267442609973648, "text": "3 Do you prefer team sports or individual sports? Why?", "y": 0.1619792954439493, "h": 0.017386504579537207}, {"y": 0.17703488396700925, "x": 0.1270125225577967, "w": 0.010733451843261715, "h": 0.008851743820341951, "text": "4"}, {"h": 0.016454932706881104, "y": 0.1763029105531688, "w": 0.35283491346571183, "text": "Have you ever tried a sport you didn't enjoy? Why?", "x": 0.15003655598161003}, {"h": 0.008851743820341951, "text": "5", "y": 0.19094476753619533, "w": 0.008944543202718092, "x": 0.12880143135034045}, {"x": 0.1484794337780857, "text": "Which sport is the most popular in your country?", "h": 0.015315936670406646, "w": 0.3381037394205729, "y": 0.19080324908070867}, {"text": "Why?", "y": 0.2035901160181237, "h": 0.013909883895075253, "x": 0.14847942821901186, "w": 0.04114490085177952}, {"x": 0.10173615384312584, "y": 0.22544166568132162, "w": 0.42621975368923615, "h": 0.018461399061154782, "text": "2 Look at the photos that show different types of holiday."}, {"text": "PART 1", "x": 0.12522361354090117, "h": 0.008851743820341951, "y": 0.24531976767213273, "w": 0.04472271813286674}, {"x": 0.12500380622845, "text": "Which of these types of holiday have you been on? Discuss in pairs.", "w": 0.4923739284939236, "y": 0.26087787056490086, "h": 0.017664017892486263}, {"h": 0.01138537906137181, "x": 0.5652951711347045, "text": "PART 2", "y": 0.10875000000294414, "w": 0.04830053541395396}, {"x": 0.5667073226439421, "w": 0.14569149441189233, "text": "Talk about holidays.", "y": 0.12392681041514653, "h": 0.014333887341220444}, {"x": 0.5651557165097918, "h": 0.015465205688338859, "y": 0.13890824496463977, "w": 0.28470221625434033, "text": "1 How did you spend your last holiday?"}, {"y": 0.15300872114929895, "x": 0.5670840766305254, "h": 0.01266817395867856, "w": 0.3434704928927951, "text": "2 What's the worst holiday you've ever been on?"}, {"x": 0.5776168230209825, "y": 0.16602176299976712, "text": "What's your favourite way of travelling on holiday? Why?", "w": 0.3778449164496528, "h": 0.017857206169018158}, {"y": 0.18007747719951303, "x": 0.5651433979798276, "h": 0.015374225106910727, "w": 0.3616459147135417, "text": "4 Do you prefer to go on holiday abroad or in your"}, {"text": "own country? Why?", "w": 0.1377459716796876, "x": 0.5867620771118557, "y": 0.19472924182046084, "h": 0.012654478722100659}, {"text": "5 Would you like to go on holiday alone? Why?/Why not?", "x": 0.5635062667054718, "h": 0.015352457550888862, "y": 0.2084702165000604, "w": 0.3828264702690972}, {"y": 0.5475436049865904, "x": 0.11449016219016073, "text": "PART 2", "h": 0.010116278651819317, "w": 0.04830053541395399}, {"y": 0.563982558039817, "w": 0.2862253824869792, "text": "In pairs, ask and answer the questions.", "x": 0.11449017387278944, "h": 0.013923579131653152}, {"text": "1 Do you prefer winter or summer activity holidays?", "y": 0.5827055595584932, "w": 0.3635046725802952, "h": 0.015602974271946396, "x": 0.11787956317336902}, {"y": 0.596614874345956, "h": 0.014769816553549631, "text": "2 What are the good and bad things about", "w": 0.30808763292100694, "x": 0.11607777717265214}, {"text": "a beach holiday?", "x": 0.13774597782924822, "y": 0.6120348840875257, "h": 0.012645348314774242, "w": 0.11806797451443143}, {"y": 0.6246316003379674, "text": "3 What places would you like to visit on", "h": 0.014785016925756686, "w": 0.28116285536024305, "x": 0.11610449479674022}, {"text": "a backpacking holiday?", "x": 0.1359570663346044, "w": 0.16457960340711805, "y": 0.6398546514872351, "h": 0.012645348314774147}, {"x": 0.5527728084277417, "y": 0.5665116279894974, "w": 0.012522361543443439, "h": 0.010116278651819317, "text": "4"}, {"w": 0.2969588555230035, "text": "What are the good and bad things about", "x": 0.567084083448993, "y": 0.5676985556707245, "h": 0.012722955653813801}, {"h": 0.012709260417235902, "w": 0.1359570651584201, "x": 0.5760286219228771, "text": "a camping holiday?", "y": 0.5816860468149967}, {"w": 0.37388193766276046, "text": "What type of working holiday would you like to go on?", "h": 0.015174417977728975, "x": 0.5688729799834678, "y": 0.5943313956306849}, {"text": "6 Which types of holiday are the most popular", "x": 0.5527728171914714, "h": 0.015311371841155259, "y": 0.6081362815204517, "w": 0.33273701985677084}, {"x": 0.5527728090515355, "h": 0.008851743820341951, "y": 0.636061046805127, "w": 0.010733451843261688, "text": "7"}, {"y": 0.6221511625297517, "x": 0.5742397110321186, "text": "with people in your country? Why?", "h": 0.013909883895075253, "w": 0.24329159206814244}, {"y": 0.6360108302695592, "w": 0.28085866292317707, "h": 0.014133574007220224, "x": 0.5724508144596995, "text": "Which of these types of holidays do you"}, {"x": 0.5706618977158318, "w": 0.11270124647352431, "text": "like best? Why?", "h": 0.012736650890391605, "y": 0.6499709305253891}, {"w": 0.6264619954427084, "x": 0.09104358732136657, "y": 0.6671835494544854, "text": "3 Read the instructions on your card. In pairs, take turns to role-play the conversation.", "h": 0.017152596019235324}, {"h": 0.01167567329716593, "text": "Student A", "y": 0.6953467563235657, "w": 0.07522254943847656, "x": 0.13591287648788797}, {"y": 0.6990581168688077, "w": 0.07346941630045578, "h": 0.010575626576420263, "x": 0.5509218218897344, "text": "Student B"}, {"h": 0.013763584711921724, "w": 0.24366785685221357, "text": "You're looking for a train station.", "y": 0.7184667422068444, "x": 0.13755533527525718}, {"w": 0.17352415296766496, "h": 0.012700130009909388, "x": 0.13595706628599455, "text": "Ask Student B for help.", "y": 0.7333754511031463}, {"h": 0.01391444872432664, "x": 0.13237925217380178, "text": "• Stop Student B politely and ask if he/she", "y": 0.7498646209910889, "w": 0.30769229465060766}, {"text": "speaks English.", "w": 0.10578223334418402, "y": 0.7632659413815642, "x": 0.15909457142761807, "h": 0.013671605199683001}, {"text": "• Ask which is the closest train station.", "y": 0.7767727039278294, "x": 0.13403166065652633, "w": 0.27938020494249133, "h": 0.013624618010400434}, {"w": 0.1520572408040365, "h": 0.011499506532070037, "text": "• Ask for directions.", "y": 0.7914801444588516, "x": 0.1341681620964909}, {"w": 0.3184257676866319, "h": 0.011403639127201192, "y": 0.8067732560016293, "text": "• Listen and repeat back directions to check", "x": 0.13416815770409005}, {"w": 0.14669052124023438, "x": 0.15742397198274502, "h": 0.011531462208889044, "y": 0.8205324910601939, "text": "that they are correct."}, {"text": "• Ask if the station is far.", "y": 0.8333284886282643, "w": 0.18246868557400175, "h": 0.011545157445466945, "x": 0.1323792559607629}, {"y": 0.847229241999158, "h": 0.015311371841155259, "w": 0.3381037394205729, "text": "• Thank Student B for his/her help and end the", "x": 0.1305903443102861}, {"x": 0.15563506473833177, "h": 0.006322674157387121, "text": "conversation", "y": 0.8624127907808632, "w": 0.08944543626573351}, {"text": "You're walking in your home town.", "x": 0.550983909124846, "w": 0.2540250311957465, "y": 0.7219900723027151, "h": 0.011440160007683312}, {"h": 0.013111844510377993, "w": 0.2061603800455729, "y": 0.7343255203438857, "text": "Student A needs directions.", "x": 0.5507826783511609}, {"y": 0.752220216763446, "text": "• Say yes, you speak English.", "x": 0.5474060797092403, "h": 0.014133574007220224, "w": 0.21466905381944446}, {"x": 0.5491949972329836, "w": 0.3023255750868056, "y": 0.7663081397573343, "h": 0.011431029974768718, "text": "• Tell Student A that Market Street Station"}, {"w": 0.1484794277615017, "y": 0.7814825583485089, "x": 0.570661897993131, "h": 0.010116278651819317, "text": "is the closest station."}, {"y": 0.7914419345631553, "h": 0.01735841770034407, "w": 0.33865753173828117, "text": "• Give directions: walk along Green Street past", "x": 0.5489091815170923}, {"y": 0.8079693141215734, "x": 0.5688729881125305, "w": 0.3023255750868056, "h": 0.015311371841155259, "text": "the library on the left, take the third turning"}, {"h": 0.012718390075738675, "y": 0.8219476747430491, "x": 0.5706618957536855, "w": 0.261180674235026, "text": "on the left, the station is on the right."}, {"text": "• Listen and check that Student B has", "y": 0.835843863138884, "h": 0.012659043551352046, "w": 0.2737030368381077, "x": 0.5456171784145776}, {"h": 0.015220518559755338, "text": "remembered the directions correctly.", "y": 0.8486273363963549, "x": 0.568686567637684, "w": 0.2633630201551649}, {"y": 0.8779069767339618, "text": "minute walk.", "x": 0.5720164618028929, "w": 0.08436214023166233, "h": 0.008720930180332487}, {"w": 0.21604938083224823, "x": 0.5452674937059608, "h": 0.013343799058084804, "y": 0.8908948196320458, "text": "• Respond and say goodbye."}, {"w": 0.0246913570827908, "x": 0.9012345681664234, "h": 0.01162790690711002, "text": "93", "y": 0.9418604652237706}]
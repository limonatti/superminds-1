[{"y":0.029069768468648727,"h":0.07558139339908132,"x":0.047325101519886628,"w":0.11728395250108507,"text":"0.6"},{"y":0.031725030622632877,"text":"AT HOME","h":0.019398776103787707,"x":0.20569868122010582,"w":0.15033103095160588},{"text":"Grammar: Prepositions, there is\/there are","y":0.074127907130380755,"h":0.013081394896215293,"w":0.31481479220920139,"x":0.19958849181720995},{"h":0.013343799058084693,"x":0.19753086690735788,"w":0.25102879842122394,"text":"Vocabulary: Rooms and furniture","y":0.09144426988555121},{"x":0.069958848338658203,"w":0.053497941758897577,"y":0.15973312414627872,"text":"(4) 1.12","h":0.011778503609601865},{"y":0.15843023312129323,"h":0.014646689596131246,"text":"WORD STORE 0.6","w":0.17283950805664064,"x":0.13168724337908708},{"text":"Rooms and furniture","y":0.15843023266563105,"h":0.011627906907110019,"x":0.31687242522083175,"w":0.17078189425998264},{"w":0.45679012722439233,"h":0.011773940345368938,"x":0.10288066226228927,"text":"Complete WORD STORE 0.6. Label the picture with the words","y":0.18014128720276568},{"text":"in the box. Then listen, check and repeat.","w":0.30452674018012149,"y":0.19466248027461941,"x":0.10082305028030955,"h":0.011773940345368938},{"x":0.09053498757762958,"text":"Where is the cat? Label the pictures with the prepositions in","y":0.22238372096504966,"w":0.45267486572265625,"h":0.011627906907110019},{"y":0.23691860492327521,"x":0.10082304533357347,"w":0.063786006503635001,"h":0.010334142148962666,"text":"the box."},{"text":"above behind between in in front of next to on","h":0.011627906907110019,"x":0.10905350817378784,"y":0.25581395332939072,"w":0.38683125813802083},{"text":"opposite under","x":0.10905349943330242,"y":0.27180232568888685,"w":0.11934155782063802,"h":0.01162790690711013},{"text":"on","y":0.37790697691271369,"w":0.018518517812093099,"x":0.16460905374827442,"h":0.0072674414426603384},{"text":"8","x":0.24074074108386254,"y":0.50436046507842169,"h":0.01162790690711013,"w":0.016460905075073223},{"y":0.59883720919179384,"w":0.010288065804375551,"x":0.076131687185260796,"text":"3","h":0.011627906907110019},{"w":0.46707817925347217,"h":0.011627906907110019,"text":"Mia and John work in the Upside-Down House. Read what they","y":0.60029069770923571,"x":0.094650203000150368},{"h":0.011627906907110019,"x":0.10082304175005637,"w":0.43209876166449651,"y":0.61482558150284039,"text":"say about it. Can people live in this house? Why?\/Why not?"},{"y":0.64678178957085508,"w":0.26337448120117191,"x":0.069958848957027253,"h":0.039264722371962213,"text":"Upside Down"},{"text":"This house is in Germany. In the living room there's a big sofa, a table","x":0.069958858022079087,"y":0.69897959150293232,"w":0.47119340684678818,"h":0.014683198704262934},{"w":0.47325100368923606,"x":0.069958852407782823,"text":"and a picture. There are two beds in the bedrooms, but you can't sleep","h":0.013343799058084804,"y":0.71350078468490108},{"h":0.014710579786794686,"w":0.47119340684678823,"text":"in them! There's a big kitchen. In the kitchen there's a cooker, a fridge,","x":0.067901242890048868,"y":0.72802197791071055},{"y":0.74127906994299864,"h":0.014607900353016956,"w":0.43621398925781252,"text":"a dishwasher, a table and chairs. In the bathroom there's a toilet,","x":0.069958855439680612},{"x":0.069958855929368818,"h":0.01459420981175108,"text":"a bath and a shower, but you can't use them. Everything in the","w":0.42181067572699649,"y":0.75581395366392889},{"x":0.069958849934393469,"text":"house is upside down!","y":0.77034883780879304,"h":0.014580518521918218,"w":0.15226337009006077},{"x":0.59248573557855277,"y":0.046459044254501425,"w":0.30473748101128473,"h":0.013481459026246867,"text":"4 Read REMEMBER THIS. Complete the"},{"text":"cartoon with there is or there are.","w":0.24897118462456602,"x":0.61934157129368406,"y":0.062401883655609836,"h":0.010272534713266057},{"w":0.13786008199055988,"x":0.59876543363434964,"h":0.011808167072817066,"text":"REMEMBER THIS","y":0.08866279067435201},{"x":0.5986166749126165,"text":"Singular","w":0.062025909423828129,"h":0.013800001219265945,"y":0.11155930193394192},{"text":"There is a cooker in the kitchen.","x":0.60082304775702078,"y":0.12637362641714767,"w":0.22427983601888024,"h":0.011773940345368938},{"w":0.27160493638780381,"h":0.011773940345368938,"x":0.6008230489254397,"y":0.14089481953867256,"text":"There is an armchair in the living room."},{"text":"there is = there's","x":0.5987654339293681,"y":0.15541601246616299,"h":0.0088281736269102407,"w":0.11728394402398001},{"y":0.17151162795500974,"text":"Plural","x":0.60082304547783072,"w":0.043209877014160125,"h":0.010174418169437871},{"w":0.24920506795247399,"x":0.60071752616492702,"h":0.012161950301525226,"y":0.18556215674492982,"text":"There are four chairs in the kitchen."},{"w":0.19753085666232639,"x":0.64609054203920702,"h":0.013343799058084804,"text":"only one room in my house.","y":0.21350078528811922},{"h":0.017347605299537938,"text":"one hundred rooms in my house!","y":0.44591011581846274,"w":0.23303029378255213,"x":0.72408162142473476},{"text":"Grammar page 125","y":0.48390894848148669,"w":0.15226337009006086,"h":0.013343799058084804,"x":0.59876543655990766},{"x":0.59465020589391138,"y":0.51162790706717065,"text":"5","h":0.010174418169437871,"w":0.012345678541395455},{"y":0.5116279070478984,"h":0.01162790690711013,"x":0.60699588942378813,"text":"Complete the text with there is or there are.","w":0.33127570258246519},{"w":0.32304524739583329,"y":0.52470930233386914,"x":0.61934157386724109,"h":0.013081394896215293,"text":"Then read the text again and draw the room."},{"x":0.62139918442667474,"w":0.28189298841688371,"h":0.013122467268580018,"text":"My bedroom is my favourite room in the","y":0.54356357923476017},{"w":0.30041151258680554,"text":"house! It's small, but I love it. There is","h":0.016159505260234019,"x":0.61934157019836678,"y":0.55651491328383085},{"h":0.010242871624334238,"y":0.57260596529468688,"w":0.16255143907335068,"text":"a bed. Next to the bed","x":0.62139918029185681},{"x":0.62123412453440952,"w":0.22057205200195318,"h":0.014196997721865223,"y":0.58562944984276921,"text":"a carpet. Opposite the bed 3"},{"w":0.32098765055338541,"h":0.011627906907110019,"text":"two small wardrobes. Between the wardrobes","x":0.6193415653268739,"y":0.60029069790303402},{"text":"_ a desk with a chair.","h":0.011627906907110019,"y":0.61482558162396428,"x":0.71810699749188212,"w":0.14197530110677081},{"w":0.20164608425564234,"h":0.011627906907110019,"x":0.71604938837629406,"y":0.62936046511475896,"text":"_ two posters above the bed."},{"y":0.6438953490658248,"w":0.21810699462890626,"text":"_ a guitar under the bed. Under","x":0.71810699383781029,"h":0.01162790690711013},{"h":0.008759720546297145,"text":"the window","x":0.61934156503506044,"y":0.6584302325358028,"w":0.08436214023166233},{"text":"a small table.","w":0.096707814534505165,"x":0.83127572075058009,"h":0.011783067248118395,"y":0.65697674431776276},{"x":0.72427983656288863,"w":0.19341562906901044,"y":0.67150706423290751,"h":0.010204081632653073,"text":"some CDs on the table and"},{"h":0.011773940345368938,"y":0.68602825744660456,"x":0.71604938603751733,"w":0.12757201300726995,"text":"_ a CD player too."},{"text":"6","x":0.59465020567805915,"h":0.010174418169437871,"y":0.70930232562942841,"w":0.010288065804375468},{"text":"SPEAKING Work in pairs and follow the","h":0.013343799058084804,"y":0.70918367337930488,"x":0.60905351561080012,"w":0.30658433702256938},{"x":0.61934156753763581,"h":0.010174418169437871,"w":0.092592586941189214,"text":"instructions.","y":0.7252906978484206},{"x":0.61934156798174422,"y":0.74127907001797766,"w":0.27572014702690972,"text":"1 Draw a picture of your bedroom, but","h":0.013081394896215293},{"h":0.01162790690711013,"text":"DON'T show your partner!","x":0.63786009104234975,"y":0.75581395342628976,"w":0.18518517388237843},{"text":"2 Describe your bedroom for your partner","y":0.76883830429974998,"w":0.29629628499348959,"x":0.62139918384070369,"h":0.013138439441962468},{"x":0.63580247484748742,"text":"to draw. Then listen to your partner's","w":0.25720163981119792,"h":0.013343799058084804,"y":0.78335949762476309},{"y":0.79788069109512505,"text":"description and draw his\/her bedroom.","x":0.63786008029718178,"w":0.27160493638780381,"h":0.013343799058084804},{"x":0.6378600852002555,"y":0.81240188379259792,"text":"Ask questions to help you, e.g. Where is","w":0.28189300537109374,"h":0.011773940345368938},{"x":0.63786008098305269,"w":0.27160493638780392,"y":0.82692307709338619,"text":"the bed? How many posters are there?","h":0.011773940345368938},{"x":0.62139918434445718,"y":0.84144427018826373,"w":0.18930040147569438,"text":"3 Compare your drawings.","h":0.011773940345368938},{"y":0.86482558147861555,"w":0.33333333333333326,"h":0.01162790690711013,"text":"7 Write five sentences about your flat\/house,","x":0.59465021131687235},{"text":"four true and one false. Read your sentences","y":0.87936046507842169,"h":0.01162790690711013,"w":0.32098765055338541,"x":0.61934156968215504},{"y":0.89389534879935195,"w":0.28395060221354174,"h":0.01162790690711013,"x":0.61934157487059538,"text":"to your partner. Can your partner guess"},{"h":0.011783067248118284,"text":"which sentence is false?","y":0.90697674441466214,"w":0.17283950805664072,"x":0.61934156359856585},{"h":0.013343799058084804,"text":"There are three rooms in my house\/flat. There","y":0.92425431741569275,"x":0.62139919054455728,"w":0.31893001980251745},{"x":0.62139917996873051,"y":0.94034536875330443,"w":0.13374485439724393,"h":0.010236026353701244,"text":"is a living room,..."},{"text":"9","y":0.9549418608099034,"w":0.012345678541395344,"h":0.01017441816943776,"x":0.91358024725193598}]
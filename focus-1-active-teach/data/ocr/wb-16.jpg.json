[{"y": 0.0543752353068456, "h": 0.013958396438226788, "w": 0.37950703938802083, "text": "2 Read the text and choose the correct answers A-C.", "x": 0.09290237431820642}, {"h": 0.010207581227436872, "y": 0.0745938627122285, "x": 0.11627907114608275, "w": 0.14847942776150175, "text": "1 Arthur doesn't like"}, {"y": 0.09104651205268299, "h": 0.0114218995674423, "text": "A working on a boat.", "x": 0.1395348847369697, "w": 0.15026833428276906}, {"x": 0.13953488768583502, "text": "B spending time away from his children.", "h": 0.01151320176864784, "y": 0.10482400728277519, "w": 0.2844364929199219}, {"y": 0.1176017444219734, "x": 0.13953488980691683, "w": 0.18246868557400173, "h": 0.012741215719642991, "text": "C the captain on his ship."}, {"text": "2 Arthur gets two months' holiday", "h": 0.012704694839160775, "x": 0.11449016623898615, "w": 0.24508049858940972, "y": 0.13530523281935714}, {"w": 0.23792485555013018, "y": 0.15036552320448643, "x": 0.13774598307019423, "h": 0.012759476534296018, "text": "A after working for three months."}, {"y": 0.16565407019221792, "text": "B once a year.", "w": 0.10554561191134984, "x": 0.13774597845100367, "h": 0.011408204330864305}, {"x": 0.1374911069829035, "text": "C at the same time each year.", "w": 0.21156299167209203, "y": 0.17786141238475903, "h": 0.01357242799407736}, {"y": 0.19590703953289096, "w": 0.10912343343098957, "h": 0.01021214643110008, "x": 0.11449016282386118, "text": "3 Arthur never"}, {"y": 0.21239620939132772, "w": 0.2039355977376302, "text": "A spends Christmas at home.", "x": 0.13774597912760694, "h": 0.011426464771105508}, {"h": 0.011563417885707956, "text": "B celebrates his children's birthdays.", "x": 0.13595707718686123, "y": 0.22635174444221795, "w": 0.25402503119574654}, {"x": 0.13595708194652117, "text": "C has a year when he is at home for all the special days.", "w": 0.36672627766927085, "h": 0.012645348314774147, "y": 0.24026162816819432}, {"x": 0.11270125264531777, "h": 0.010266927377411581, "y": 0.25670058156217174, "w": 0.10733452690972223, "text": "4 Arthur's wife"}, {"y": 0.2731395351449385, "x": 0.13595708270760332, "h": 0.012672739536753588, "text": "A doesn't do all the housework when Arthur is away.", "w": 0.3703040907118056}, {"text": "B doesn't go out to work.", "x": 0.13595707031675583, "y": 0.2869900720832087, "w": 0.18246868557400173, "h": 0.01144016038209523}, {"y": 0.3009593025448706, "text": "C isn't very well organised.", "x": 0.13595706997744836, "h": 0.011549722649130057, "w": 0.19141323513454864}, {"text": "5 When Arthur is at home, his wife", "y": 0.3186627909487997, "x": 0.11091234163070814, "w": 0.24686940511067712, "h": 0.010116278651819317}, {"h": 0.011508636564984633, "y": 0.3337093864030445, "text": "A is angry with him for changing the children's", "x": 0.13595706855427012, "w": 0.32379248725043397}, {"y": 0.34753885984288124, "h": 0.010532745187463315, "text": "bedtime.", "x": 0.1573597206499245, "w": 0.06452921549479165}, {"w": 0.35957065158420143, "x": 0.13416816707462545, "h": 0.012718390075738675, "text": "B is tired for the first week because of the changes.", "y": 0.3615839352444391}, {"x": 0.13416816859472241, "text": "C is happy to see how her husband spends time", "y": 0.3755668608844007, "h": 0.012713825246487289, "w": 0.3381037394205729}, {"x": 0.1574239768760782, "h": 0.009029783393501837, "y": 0.39063628141934875, "w": 0.12701251559787327, "text": "with their children."}, {"w": 0.2200357733832465, "x": 0.11091234861696345, "y": 0.407125451425092, "text": "6 In the future, Arthur wants to", "h": 0.011435594804020104}, {"h": 0.011385379061371907, "w": 0.3220035807291667, "text": "A work on ships that don't sail long distances.", "x": 0.1323792418357746, "y": 0.4236146210990197}, {"x": 0.13237925691667707, "y": 0.43617779793159406, "h": 0.011467550480839209, "w": 0.20035776774088543, "text": "B write about his life at sea."}, {"y": 0.45143895371082254, "h": 0.011435595178432022, "w": 0.31842576768663194, "text": "C stay at home and write stories for children.", "x": 0.13237924814237273}, {"x": 0.08586762523677799, "text": "3 Look at the underlined phrases in the text. Complete", "y": 0.47543772562866193, "h": 0.011408204330864305, "w": 0.40608228895399306}, {"y": 0.49063953530849685, "x": 0.10733453871455949, "h": 0.01149494132840683, "text": "the sentences with one word in each gap. The first", "w": 0.3667262776692708}, {"text": "letters are given.", "y": 0.5015741148233709, "w": 0.12627530415852867, "h": 0.0144913589739197, "x": 0.10677870224910173}, {"y": 0.5209792420630528, "h": 0.011389943890623196, "text": "My sister's son is fifteen. He's a bit difficult. I think", "w": 0.3381037394205729, "x": 0.13237925356788896}, {"text": "a lot of children are, at that age.", "h": 0.01151320176864784, "w": 0.2218246799045139, "x": 0.1305903471079695, "y": 0.5361627909538459}, {"h": 0.011476680888165721, "y": 0.5538662792416364, "w": 0.35599283854166663, "x": 0.1073345324107408, "text": "1 It's a very sad film. My eyes are always filled with"}, {"x": 0.128801431865971, "y": 0.5690406977468467, "text": "t", "w": 0.014311269124348935, "h": 0.007587208988864585}, {"h": 0.010207581227436872, "y": 0.5676985561193462, "w": 0.11091233995225697, "text": "when I watch it.", "x": 0.2003577816637046}, {"w": 0.37745975070529514, "text": "2 Don't wait for the day of the concert to buy tickets.", "y": 0.5816860467475548, "h": 0.012709260417235902, "x": 0.10375671160620749}, {"w": 0.1538461473253038, "h": 0.011403639127201192, "x": 0.12880143695154003, "y": 0.5955731047605228, "text": "We can buy them in a"}, {"x": 0.3470483018484396, "w": 0.10554561191134987, "h": 0.009029783393501837, "y": 0.5967509023623061, "text": "on the Internet."}, {"w": 0.3864042833116319, "h": 0.012750346126969504, "x": 0.10554562101562119, "y": 0.6081362813080339, "text": "3 This is the last day of our holiday. Don't spend the time"}, {"w": 0.2093023173014323, "h": 0.010207581227436775, "y": 0.6246254514042391, "x": 0.128801438755366, "text": "at your computer. Make the m"}, {"x": 0.3987499944028829, "text": "of the day.", "y": 0.6227550411309456, "w": 0.08085421244303387, "h": 0.012702127122706925}, {"w": 0.35420393202039935, "text": "Go swimming, go for a walk, have some local food.", "x": 0.12880143881985381, "h": 0.011517766972311145, "y": 0.6371886281625059}, {"h": 0.01138537906137181, "text": "My dad works three days on, three days o_", "w": 0.3023255750868055, "x": 0.11806798672612599, "y": 0.6524999998396084}, {"w": 0.23971376207139755, "x": 0.12701253261963802, "text": "so he often works at the weekend.", "y": 0.6650631769200436, "h": 0.010207581227436775}, {"w": 0.1291246795654297, "text": "My mum works f", "x": 0.1161650238976987, "h": 0.011855778126079703, "y": 0.6789726742440787}, {"y": 0.6803197676980319, "w": 0.16100179036458334, "x": 0.30590339551538287, "text": "home, so she is always", "h": 0.011440160007683409}, {"text": "there when we get back from school.", "y": 0.6941155233680449, "x": 0.1270125297998115, "w": 0.2558139377170139, "h": 0.011494941702818553}, {"x": 0.10554562520258173, "w": 0.35778174506293403, "h": 0.01138081348329678, "text": "6 We're in Australia! I can't believe it. We're on the", "y": 0.706875000424776}, {"w": 0.05032484690348307, "x": 0.1268948224078834, "y": 0.7229688595309077, "h": 0.009541932374561699, "text": "other s"}, {"x": 0.2307692306447123, "text": "of the world!", "y": 0.7207848837612996, "w": 0.08944543626573351, "h": 0.010234971700592574}, {"x": 0.09302325525621036, "w": 0.13595706515842013, "h": 0.01138537906137181, "text": "REMEMBER THIS", "y": 0.749864620935684}, {"y": 0.7726308140566392, "w": 0.1502683342827691, "text": "Expressions with 'of'", "h": 0.012645348314774147, "x": 0.09481216680315928}, {"w": 0.3810375637478299, "text": "The genitive form in English is often written with 'of\", e.g.", "x": 0.09481217101070033, "h": 0.012663609129427269, "y": 0.7941279072379617}, {"y": 0.8130216055326723, "h": 0.01413538616056478, "x": 0.09457735421646106, "w": 0.14007387797037762, "text": "the captain of a ship"}, {"y": 0.828270348887671, "h": 0.012677304366004975, "x": 0.09302325634858802, "w": 0.1377459716796875, "text": "a feeling of sadness"}, {"x": 0.0930232635675123, "text": "the last week of his leave", "y": 0.8421254512777856, "h": 0.010207581227436775, "w": 0.1735241360134549}, {"h": 0.012732086061140218, "y": 0.8560901163822204, "text": "a writer of children's books", "x": 0.091234352883145, "w": 0.18604649861653644}, {"text": "4 Read REMEMBER THIS. Put the words in the correct", "y": 0.0569040699646016, "h": 0.011408204330864402, "x": 0.5348837231355053, "w": 0.4025044759114583}, {"h": 0.010458935133386593, "y": 0.07190716033599279, "x": 0.5580630724595372, "text": "order.", "w": 0.04487564510769315}, {"y": 0.08833483762992286, "w": 0.2397137620713975, "x": 0.5796064487317432, "h": 0.011563417885708053, "text": "is / a / Lucy / English / of / teacher"}, {"h": 0.010207581227436872, "text": "ucy is a teacher of English", "x": 0.5867620812846047, "y": 0.10364620930197925, "w": 0.18067977905273436}, {"h": 0.011508636564984633, "y": 0.11620938640831346, "x": 0.5563506289013972, "text": "1 children / Elizabeth / a / three / of / is / mother", "w": 0.34883721245659727}, {"y": 0.1440839349020861, "h": 0.010207581227436775, "x": 0.5563506313563913, "w": 0.28622538248697915, "text": "2 the / is / of / last / school / this / week"}, {"text": "week / my / the / Saturday / favourite / is / day / of", "x": 0.5778175260995696, "y": 0.1731362815137434, "w": 0.35241502549913195, "h": 0.011485811295492138}, {"x": 0.5563506281157411, "y": 0.19979651167332252, "text": "4 my / of / skateboard / this / the / dreams / is", "w": 0.33273701985677073, "h": 0.011421899941854122}, {"text": "VOCABULARY PRACTICE | Phrasal verbs and collocations", "h": 0.012745781297718214, "x": 0.5313059113046086, "w": 0.4114490085177951, "y": 0.23773255837546167}, {"h": 0.01267273878792985, "y": 0.2579377259406781, "x": 0.5330948153761133, "text": "5 Look at the vocabulary in lesson 1.4 in the Students'", "w": 0.40250447591145844}, {"x": 0.5563506296547684, "y": 0.273139535092695, "text": "Book. Choose the correct word.", "w": 0.23076922946506073, "h": 0.010116278651819414}, {"w": 0.18783542209201398, "x": 0.5563506254093982, "text": "Our lives", "h": 0.027956721653576787, "y": 0.313604650789933}, {"y": 0.345094765640669, "text": "We are all different and here is your chance", "x": 0.5563506256021221, "w": 0.318425767686632, "h": 0.015311371841155259}, {"x": 0.5545617163057597, "text": "to tell other people about your typical day.", "y": 0.3591279068580583, "w": 0.318425767686632, "h": 0.013909883895075253}, {"w": 0.10933953179253475, "h": 0.014782548054030679, "text": "Joanna, aged 17", "x": 0.5544536691858958, "y": 0.38271773777779716}, {"x": 0.5545617316575339, "y": 0.4031994582146608, "text": "My mum gets up last / late / first, but I also get up", "w": 0.3416815524631076, "h": 0.015361587958215375}, {"y": 0.41968862813044705, "text": "early - at 7 o'clock every morning. Then | -take /", "x": 0.5527728069307345, "h": 0.014133574007220224, "w": 0.3166368611653645}, {"y": 0.4349999997390539, "h": 0.013909883895075349, "x": 0.5545617101638398, "w": 0.3184257676866319, "text": "wake / get up my brothers. They don't like getting"}, {"h": 0.014133574007220224, "text": "3off / up / on early, that's why I 'help' them O. We", "w": 0.3381037394205729, "x": 0.5563506371770123, "y": 0.45266696735937617}, {"x": 0.5527728056273469, "h": 0.013909883895075349, "w": 0.35062611897786455, "text": "*get / go / make dressed and have our breakfast. We", "y": 0.4678779069167688}, {"x": 0.5526573055192321, "w": 0.32221160888671874, "y": 0.48301598982814886, "h": 0.015544962900209866, "text": "Shave/ take / wash the dishes and go to school."}, {"text": "School finishes at half past three. At home, I look •for /", "x": 0.552772811771262, "h": 0.013909883895075349, "y": 0.50202034868691, "w": 0.35241502549913195}, {"y": 0.5170532488012092, "text": "after / up my two brothers. My parents finish work at", "x": 0.5527728053555805, "w": 0.3452593994140625, "h": 0.014133574007220224}, {"text": "five o'clock. At seven o'clock we eat together and then", "w": 0.3457095336914062, "h": 0.01721147452881189, "x": 0.5525328002178175, "y": 0.5301614600778867}, {"text": "I do my homework. I usually take the dog out / on/", "x": 0.5509838989822455, "y": 0.5461055959340739, "w": 0.34704830593532987, "h": 0.015347891972813735}, {"text": "up for a walk. I love our dog Maxy and I always enjoy", "x": 0.5509838916838454, "y": 0.5625947653697501, "h": 0.014133574007220224, "w": 0.3452593994140625}, {"text": "our walks. 1°go / fall / get asleep at ten o'clock! It's a", "x": 0.5509839013057424, "y": 0.5766279071005249, "h": 0.015174417977729072, "w": 0.35778174506293403}, {"x": 0.5509838936512975, "w": 0.34704830593532987, "y": 0.5930668604159798, "h": 0.013909883895075349, "text": "busy life, but at the weekend, I am free! And I can get"}, {"x": 0.5509839043782648, "w": 0.19856886121961814, "y": 0.606958483917229, "h": 0.013928143960904636, "text": "up early / late / first at last!"}, {"h": 0.01028518781765269, "y": 0.628473837367695, "w": 0.09123434278700082, "x": 0.5509839028641025, "text": "Comments (1)"}, {"text": "Wednesday 18th Apnil, 23.14", "y": 0.6284738374395747, "w": 0.1484794277615017, "h": 0.008851743820341951, "x": 0.7531305883777466}, {"y": 0.6461773255575496, "w": 0.3434704928927952, "h": 0.013909883895075349, "text": "Are you sure you go to bed at 10? Look at the time of", "x": 0.5509838924240342}, {"y": 0.6626162792256072, "text": "your post!", "h": 0.012654478722100659, "w": 0.06797853257921005, "x": 0.549194991700854}, {"x": 0.5223613654541529, "y": 0.7018168603401077, "text": "WORD STORE 1E | Daily routine", "w": 0.24865831163194452, "h": 0.013909883895075253}, {"w": 0.41860463460286457, "x": 0.5223613627075124, "y": 0.7258430229948678, "text": "6 Complete the sentences with the words from the box.", "h": 0.013909883895075253}, {"h": 0.0127366508903917, "text": "at for (x2) on (x2) out of to (x3)", "x": 0.5652951746163387, "w": 0.2683363003200955, "y": 0.7510424184577658}, {"x": 0.5688729886882091, "y": 0.7764244188239402, "h": 0.011522332175974353, "w": 0.2933810424804687, "text": "I don't want to stay at home on Saturdays."}, {"w": 0.008944543202718092, "y": 0.791598837302806, "x": 0.5474060827143833, "text": "1", "h": 0.007587208988864585}, {"y": 0.7903023465305219, "h": 0.01141276953452761, "text": "They like to go", "x": 0.5706618990684149, "w": 0.11627906799316401}, {"x": 0.7173524129698555, "h": 0.010207581227436872, "text": "museums and look at the", "y": 0.790302346567627, "w": 0.17710196601019967}, {"text": "beautiful things there.", "x": 0.5688729900582784, "h": 0.01275491095622089, "w": 0.15384614732530377, "y": 0.8042441861812757}, {"w": 0.008944543202718092, "text": "2", "x": 0.547406082513131, "h": 0.010116278651819317, "y": 0.8181540698078112}, {"w": 0.17069171481662326, "x": 0.5578419263289615, "y": 0.8163983155138437, "text": "Our cat often sits", "h": 0.01502368426064723}, {"text": "the sofa with us.", "w": 0.1180679745144314, "h": 0.011408204330864305, "x": 0.7298747764279364, "y": 0.8181540700657646}, {"w": 0.008944543202718092, "h": 0.0075872089888644875, "text": "3", "x": 0.547406082513131, "y": 0.8333284884529515}, {"w": 0.09135853237575953, "x": 0.5688108941191472, "text": "Aylin goes _", "y": 0.8318577481517243, "h": 0.014322294052757551}, {"text": "_ a run in the park every day.", "y": 0.8333284887968692, "w": 0.19677995469835075, "h": 0.011545157445466848, "x": 0.6797853357098586}, {"w": 0.014311270183987035, "h": 0.01138081348329678, "text": "4", "x": 0.5438282646217811, "y": 0.84597383733059}, {"y": 0.8459738375227634, "text": "Sometimes it's difficult to get bed in the winter", "x": 0.558139529589213, "w": 0.37745975070529514, "h": 0.015174417977728975}, {"text": "when it's so dark outside", "x": 0.5670840795313732, "y": 0.8609702167403226, "w": 0.17352415296766488, "h": 0.007851985559566801}, {"x": 0.5452674919286573, "h": 0.01162790690711013, "w": 0.18724278767903646, "y": 0.8735465117111737, "text": "5 At the weekend, we go"}, {"w": 0.1399176873101129, "text": "6 Boris usually lies", "x": 0.5452674914615417, "y": 0.8880813954321038, "h": 0.01162790690711002}, {"x": 0.7695473273692357, "text": "a swim at the beach.", "h": 0.01028394362241547, "y": 0.8735465116759399, "w": 0.15226337009006086}, {"text": "the sofa all weekend and", "y": 0.8880813956391183, "x": 0.7242798393489718, "w": 0.17695471869574653, "h": 0.010270252706866101}, {"y": 0.9026162791927793, "x": 0.5679012326566218, "w": 0.08641975402832025, "h": 0.008720930180332598, "text": "watches TV!"}, {"w": 0.20781892564561633, "text": "7 My grandparents never go", "x": 0.5452674953733508, "y": 0.9156200940473262, "h": 0.011773940345368938}, {"text": "8 My brother often goes", "w": 0.1831275600857205, "y": 0.9287790698302354, "x": 0.5452674962174278, "h": 0.013136157809845783}, {"h": 0.008904893506827105, "y": 0.9170591812050797, "text": "bed late.", "x": 0.792155291231305, "w": 0.061779950459798116}, {"w": 0.16872428046332466, "text": "the gym with his friends.", "x": 0.7695473259548945, "h": 0.013136157809845894, "y": 0.9287790697757295}, {"h": 0.013081394896215404, "text": "17", "x": 0.9053497949668349, "y": 0.9505813957386656, "w": 0.0246913570827908}]
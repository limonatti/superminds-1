[{"x":0.082304525439001033,"text":"READING","w":0.092592595418294274,"h":0.01162790690711013,"y":0.065406976791922977},{"y":0.091444270151926577,"text":"8 Read the text. Are statements 1-6 true (T) or false (F)?","w":0.4197530788845486,"x":0.07613169625731403,"h":0.011773940345368938},{"y":0.1279069764241213,"w":0.14403291490342882,"h":0.031976744743119512,"text":"Green","x":0.082304531231413153},{"h":0.033430231235090924,"y":0.12645348895488673,"w":0.17283950805664064,"text":"School","x":0.24691358002517763},{"w":0.11111111111111105,"text":"SPEAKING","h":0.013081394896215293,"y":0.063953488671078418,"x":0.52263374374485594},{"y":0.091444269850317506,"w":0.17489712185329864,"h":0.011773940345368938,"text":"9 Do the task in pairs.","x":0.52469135895503793},{"w":0.25720163981119792,"text":"Clothes Museum","x":0.59876543348946265,"y":0.12354651135031636,"h":0.021802325825114766},{"x":0.56378601224045399,"h":0.013115621623663531,"text":"• Learn all about the history of fashion.","w":0.32098765055338541,"y":0.16130298301921153},{"text":"• Special exhibition of 1920s clothes","y":0.17732558160349121,"w":0.30246914333767361,"x":0.56172839507499017,"h":0.013081394896215293},{"y":0.19466248019710009,"text":"showing now!","w":0.115226338704427,"x":0.57613168686177818,"h":0.011773940345368827},{"y":0.21075353196263324,"text":"• Buy books and posters in our shop.","h":0.013083677276898853,"x":0.56378600922027722,"w":0.30864196777343744},{"w":0.31275719536675339,"h":0.010363805237894375,"text":"Open Monday-Saturday, 9:30 a.m.-5:30 p.m.","x":0.56378601449769328,"y":0.2425431712450804},{"text":"Tickets: Adults: £10, Students: £5","w":0.23662550184461806,"h":0.011773940345368938,"y":0.25863422282649484,"x":0.5637860154357156},{"x":0.56378600968973713,"y":0.27616279097584306,"w":0.20164608425564234,"h":0.010336424155362622,"text":"Special discounts for groups!"},{"text":"Book online to get an extra discount","h":0.011785349254518351,"x":0.5637860122916265,"w":0.24897118462456602,"y":0.2919937206234553},{"w":0.18312756008572051,"h":0.010265689068349571,"text":"or phone 020 3456 75284.","x":0.56172839797497254,"y":0.30959302354609497},{"text":"Green School in Bali is an unusual school. It was","x":0.082304548506622707,"y":0.39825581414687028,"h":0.010299915795797809,"w":0.40123453776041668},{"x":0.082304536798522621,"h":0.01162790690711013,"y":0.41279069760022402,"text":"an experiment in 2010 by John and Cynthia","w":0.35185184054904517},{"y":0.41269031474443674,"w":0.047410825093587239,"h":0.010375184578648389,"text":"Hardy.","x":0.43411351690326938},{"x":0.082304548506622707,"h":0.011773940345368938,"w":0.40123453776041668,"y":0.42582417574090914,"text":"Everything in the school is 'green' - that means it's all"},{"y":0.44186046539747581,"text":"good for the environment. The classrooms are made of","x":0.082304522563215354,"w":0.4012345716688368,"h":0.010258843797716688},{"w":0.4012345716688368,"y":0.45486656206147802,"h":0.011773940345368938,"text":"bamboo. The light and power is from the sun. The school","x":0.082304528877515715},{"y":0.46938775527021215,"x":0.082304535332111559,"text":"also uses water from the river to produce energy.","w":0.35596706814236112,"h":0.011773940345368938},{"w":0.4012345716688368,"y":0.48979591826855962,"x":0.082304529880602065,"text":"The Hardys' experiment was successful and there are","h":0.011773940345368938},{"y":0.50431711144822411,"x":0.082304529880602065,"w":0.4012345716688368,"h":0.011773940345368827,"text":"now 160 students from more than twenty-five countries"},{"h":0.011773940345368938,"y":0.51883830437472889,"x":0.080246921963413279,"text":"- and it goes from kindergarten up to age eighteen. The","w":0.40123453776041668},{"x":0.082304529880602065,"text":"students at Green School don't only learn subjects such","y":0.53335949759789014,"w":0.4012345716688368,"h":0.010245153256450812},{"text":"as English and Maths, they also learn to grow organic","y":0.54651162774799533,"w":0.40123453776041668,"h":0.01162790690711013,"x":0.082304535955182834},{"w":0.40123453776041668,"x":0.082304548506622707,"h":0.011627906907110019,"text":"vegetables and other foods such as rice in the huge","y":0.56104651161427443},{"h":0.01162790690711013,"w":0.4012345716688368,"x":0.082304529880602065,"y":0.57558139531097985,"text":"school gardens. They look after the plants and learn to"},{"w":0.40123453776041668,"h":0.010354678335144918,"x":0.082304548506622707,"y":0.59011627931159882,"text":"cook them. The school also keeps some farm animals."},{"w":0.39917694091796874,"h":0.010340987793878931,"text":"The students also study building, making furniture and","x":0.08230452966447252,"y":0.60465116305190914},{"y":0.61918604653774068,"x":0.080246922038396631,"w":0.18724278767903646,"h":0.0087574385398972998,"text":"traditional art and dance."},{"x":0.082304520852824484,"w":0.4012345716688368,"text":"The Hardys want the local community to be a part of","y":0.63953488398214153,"h":0.010174418169437871},{"y":0.65261627901737518,"text":"Green School. They have a rule that twenty percent of","w":0.4012345716688368,"x":0.082304528877515715,"h":0.011627906907110019},{"x":0.080246923906223094,"text":"the students must be from Bali because they want local","w":0.4032921685112848,"h":0.011812730337050104,"y":0.6671511630193131},{"text":"children to learn about protecting the environment.","w":0.39917694091796874,"x":0.082304537648011419,"y":0.68168604648830544,"h":0.011799039795784227},{"h":0.010215490167518992,"w":0.40123453776041668,"y":0.69622093037749033,"text":"The children are often poor, so people from all over the","x":0.082304548506622707},{"x":0.082304529880602065,"h":0.010204081632653073,"y":0.71075353211018932,"w":0.4012345716688368,"text":"world pay for them to go to the school. The idea of green"},{"x":0.082304529880602065,"h":0.011773940345368827,"w":0.4012345716688368,"text":"living is becoming more popular and now people are","y":0.72370486674175871},{"x":0.08230452966447252,"text":"building eco-houses near the school so their children","w":0.39917694091796874,"y":0.73822605950099451,"h":0.010320451981980172},{"x":0.082304542745306061,"h":0.011627906907110019,"w":0.40123453776041662,"y":0.75145348821311164,"text":"can walk to school. The Hardys' dream is that one day"},{"w":0.30452674018012155,"text":"all the schools in the world will be 'green'.","x":0.082304536219952776,"y":0.76726844576342401,"h":0.010347833064511924},{"x":0.10266763649135321,"text":"1 At Green School, there is nothing bad","h":0.01480009866471943,"y":0.79808820964960958,"w":0.28022225273980039},{"text":"for the environment.","y":0.81395348846251936,"x":0.11728395232194815,"w":0.14403291490342879,"h":0.010222335812435479},{"y":0.82692307701840739,"x":0.10288067134016785,"w":0.31893001980251734,"h":0.013343799058084693,"text":"2 All the school's energy comes from the sun."},{"w":0.34979424370659723,"text":"3 The students at Green School are all teenagers.","x":0.10288066029690703,"y":0.84301412890968386,"h":0.011773940345368938},{"text":"4 At Green School, students also learn about","w":0.31275719536675345,"y":0.85596546322378042,"x":0.10288066075283726,"h":0.011773940345368938},{"h":0.013245303365087557,"y":0.87055758028253372,"text":"growing food.","x":0.10080096505171642,"w":0.096751980251736105},{"w":0.28852199978298609,"text":"5 There aren't any rules about how many","x":0.10061086255405557,"h":0.015535696709361946,"y":0.88329589739565373},{"h":0.010354678335144918,"text":"students must be from Bali.","x":0.098765439200243527,"y":0.8995290423593123,"w":0.19135801527235244},{"text":"6 Now, some students live in eco-houses","x":0.098765433841507433,"y":0.91405023550263953,"w":0.2901234605577257,"h":0.010368368876410794},{"text":"near the school.","y":0.93014128745592506,"w":0.11111111111111112,"h":0.011773940345368938,"x":0.09465020733882025},{"x":0.54935500506474,"text":"Student A","h":0.010377698266524904,"w":0.074129494561089415,"y":0.35745649977458727},{"x":0.54924082043454103,"w":0.18755023532443571,"h":0.011761352443245832,"y":0.38074732655548527,"text":"You work at the museum."},{"w":0.37860080295138898,"text":"• Greet Student B and ask how you can help him\/her.","y":0.39825581396177601,"h":0.013081394896215293,"x":0.54732511306477194},{"text":"• Then answer the questions.","x":0.54732510195238826,"w":0.20987653944227425,"y":0.41279069751543718,"h":0.01162790690711013},{"w":0.29423868815104171,"x":0.54732509841419119,"y":0.42582417576282938,"text":"• Use the information above to help you.","h":0.013129312164929408},{"text":"Student B","w":0.074182629055447036,"y":0.46636876627692392,"x":0.54932843781876828,"h":0.010576421087914789},{"h":0.013111058359430605,"w":0.33333333333333337,"x":0.54938271920438952,"text":"You want to visit the museum with your class.","y":0.48979591837646774},{"h":0.011773940345368938,"x":0.54938272367500962,"text":"Ask Student A about the following things:","y":0.50431711148456126,"w":0.30864196777343744},{"x":0.54732510267313894,"w":0.12962962680392798,"text":"• What\/see\/now?","h":0.010174418169437871,"y":0.5218023258898451},{"h":0.011627906907110019,"text":"• Shop?","x":0.5473251023327067,"y":0.53633720938559226,"w":0.065843620300293004},{"y":0.55087209320342179,"text":"• Ticket prices?","h":0.011627906907110019,"w":0.11316872490776908,"x":0.54938271612121825},{"text":"• Book\/online?","y":0.56395348842012605,"h":0.010222335812435479,"w":0.11316871643066406,"x":0.54732510841704096},{"y":0.61596425722717629,"w":0.090713077121310715,"h":0.013711020560990717,"x":0.52871753475984218,"text":"WRITING"},{"h":0.011773940345368938,"text":"10 In what order would you include sentences a-d in","y":0.64678178973163902,"w":0.38888888888888884,"x":0.52469136288580231},{"h":0.016797535086351845,"text":"a personal email?","y":0.65928537484285954,"x":0.54694035380223649,"w":0.13464893764919694},{"x":0.5514403377188557,"y":0.67732558140363652,"w":0.28189298841688371,"h":0.013081394896215293,"text":"a What are your plans for the weekend?"},{"text":"b I hope to hear from you soon!","y":0.69186046522146605,"w":0.22633743286132812,"h":0.013081394896215293,"x":0.55144034083956894},{"text":"c I hope you're fi ne and not too busy!","y":0.70639534913619473,"w":0.26748970879448786,"h":0.013081394896215293,"x":0.55144032811304433},{"text":"d I'm getting on fi ne on my course.","x":0.55144033643753609,"h":0.013081394896215293,"y":0.72093023276628188,"w":0.25102879842122394},{"x":0.524691371533203,"y":0.74563953484586365,"h":0.011817293975566634,"text":"11 Read the writing task and write an email.","w":0.32716047498914935},{"text":"You are living in a new town. Write an email to your","w":0.36008229573567707,"y":0.77470930233386914,"h":0.013081394896215293,"x":0.52880659270143437},{"w":0.14403291490342884,"text":"English friend, Alex.","x":0.5267489732753089,"y":0.78924418649084582,"h":0.013081394896215293},{"x":0.52469135658052768,"y":0.8065149137062203,"text":"• Ask about Alex;","w":0.13374485439724393,"h":0.011799039795784227},{"x":0.52674897121002673,"text":"• Describe your new school and activities;","y":0.82103610688588469,"w":0.30041151258680554,"h":0.011812730337050104},{"x":0.5288065933796362,"w":0.18312756008572051,"h":0.011627906907110019,"y":0.83575581398830556,"text":"• Ask about Alex's plans;"},{"h":0.01162790690711013,"y":0.85029069767289844,"x":0.52880658858115104,"w":0.21193415323893228,"text":"• Invite Alex to stay with you."},{"y":0.9505813954036032,"w":0.02880658467610675,"h":0.018895348349770358,"text":"71","x":0.9053497940816998}]
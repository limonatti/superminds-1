[{"h": 0.016630687618944224, "w": 0.26475848727756074, "x": 0.17710197061285954, "text": "TEXAM SPEAKING", "y": 0.02655523259707506}, {"w": 0.2987477620442708, "text": "1 In pairs, ask and answer the questions.", "h": 0.011563417885708053, "x": 0.10196780428645127, "y": 0.08833483767734295}, {"text": "PART 1", "x": 0.1234347047752482, "h": 0.008851743820341951, "y": 0.10748546534655139, "w": 0.04472271813286677}, {"x": 0.12343470601603024, "h": 0.010116278651819317, "y": 0.12392441883891595, "w": 0.1323792436387804, "text": "Talk about school."}, {"y": 0.1365697674923222, "x": 0.12343470239193778, "text": "1 How did you feel on your first day at secondary school?", "h": 0.012645348314774147, "w": 0.3846153767903646}, {"y": 0.14883113612734278, "w": 0.34558346218532987, "h": 0.015282760785374867, "x": 0.12327943436578828, "text": "2 What are the best and worst things about your"}, {"x": 0.14301966311504688, "w": 0.09857605828179253, "text": "school? Why?", "h": 0.013389144408573797, "y": 0.16401763697118638}, {"w": 0.3184257676866319, "x": 0.12343470511017232, "y": 0.17824007224664204, "text": "3 What's your favourite place in your school?", "h": 0.012704694839160775}, {"h": 0.012727520483065188, "text": "4 What must you do when you use the science lab", "y": 0.19220930279755474, "w": 0.35420393202039935, "x": 0.12343470739469}, {"y": 0.20604445989806597, "w": 0.07339143541124132, "h": 0.011530265963034591, "x": 0.1430896139351199, "text": "at school?"}, {"h": 0.014133574007220224, "w": 0.38461537679036456, "text": "5 What subjects do most students study at university?", "y": 0.21985559560625106, "x": 0.1216458047846029}, {"w": 0.3810375637478298, "h": 0.012722955653813801, "x": 0.10017889730765919, "text": "2 Look at the pictures that show free time activities.", "y": 0.2414485557128756}, {"h": 0.01138081348329678, "x": 0.11985688841109098, "text": "PART 1", "y": 0.26049418621838066, "w": 0.048300535413954}, {"text": "Which of these sports do you do? Discuss in pairs.", "w": 0.3667262776692708, "y": 0.2767824912705043, "x": 0.11985689723423756, "h": 0.014133574007220224}, {"text": "PART 2", "y": 0.10875000014574733, "x": 0.5599284448824684, "w": 0.04830053541395396, "h": 0.010207581227436872}, {"w": 0.13348661634657122, "h": 0.015622873512846514, "text": "Talk about sports.", "y": 0.122378296202617, "x": 0.561167357282278}, {"w": 0.16994632297092016, "h": 0.01141276953452761, "y": 0.13780234643568176, "text": "1 How do you keep fit?", "x": 0.5617173587143014}, {"w": 0.3864042833116319, "x": 0.561717354229694, "h": 0.01275491095622089, "y": 0.15174418634988038, "text": "2 Do you prefer winter sports or summer sports? Why?"}, {"text": "3", "y": 0.16565406989760517, "w": 0.008944543202718092, "h": 0.008851743820341951, "x": 0.561717352802338}, {"y": 0.17956395352369534, "h": 0.008851743820341854, "w": 0.010733451843261688, "text": "4", "x": 0.5599284439650716}, {"x": 0.5813953573433093, "h": 0.013909883895075253, "text": "Do you think it's important to try new sports? Why?", "y": 0.1656540696013359, "w": 0.3577817450629339}, {"text": "Why do you think people enjoy extreme sports", "x": 0.5813953530863293, "w": 0.32737030029296876, "y": 0.17941786981614385, "h": 0.014133574007220224}, {"h": 0.011462985651587725, "w": 0.1395348782009549, "y": 0.1934738375582063, "text": "such as kite surfing?", "x": 0.5831842615793078}, {"y": 0.20738372117631163, "text": "5", "x": 0.559928443845811, "h": 0.008851743820341854, "w": 0.010733451843261799}, {"x": 0.5813953414908333, "w": 0.2933810424804687, "y": 0.2072924189430471, "h": 0.011472115684502416, "text": "Which sports are the most popular among"}, {"w": 0.21288014729817706, "y": 0.21985559554618578, "x": 0.5813953486943818, "h": 0.014133574007220224, "text": "boys and girls in your country?"}, {"y": 0.4855813955140213, "h": 0.032877907116060257, "w": 0.11806797451443146, "text": "1211", "x": 0.31663685296767563}, {"y": 0.570305232893567, "x": 0.11806798069618873, "w": 0.04651162465413411, "h": 0.010116278651819317, "text": "PART 2"}, {"h": 0.01149494132840683, "y": 0.5853655235401312, "x": 0.11806798178690846, "w": 0.28443649291992185, "text": "In pairs, ask and answer the questions."}, {"text": "4", "y": 0.5867441863566485, "h": 0.010116278651819317, "w": 0.012522361543443439, "x": 0.5545617173499241}, {"h": 0.014133574007220224, "text": "What is good about doing a sport like karate?", "y": 0.5853655234659212, "x": 0.577817526138795, "w": 0.3184257676866319}, {"h": 0.010116278651819414, "x": 0.11806797884879251, "text": "1", "w": 0.01073345184326173, "y": 0.5993895349240904}, {"y": 0.5993895349341827, "h": 0.012672739536753685, "w": 0.2898031955295139, "text": "Do you think skateboarding is dangerous?", "x": 0.14311271809690057}, {"h": 0.012672739536753588, "y": 0.5993895350817118, "x": 0.5581395477539353, "w": 0.3381037394205729, "text": "5 What can you learn from playing a team sport"}, {"y": 0.6132400723836333, "h": 0.012704694839160775, "text": "Why?/Why not?", "x": 0.13953488566305897, "w": 0.11270124647352434}, {"x": 0.5778175320324976, "text": "like volleyball?", "h": 0.014133574007220224, "y": 0.6132400721322908, "w": 0.10196779886881513}, {"y": 0.6272093023977868, "x": 0.11806797881897738, "w": 0.010733451843261715, "h": 0.008851743820341951, "text": "2"}, {"text": "3", "h": 0.008851743820341951, "x": 0.11806797881897738, "w": 0.010733451843261715, "y": 0.6411191861187171}, {"w": 0.32558139377170137, "y": 0.6258032492718352, "x": 0.13953488329304023, "h": 0.014133574007220224, "text": "Would you prefer to do yoga or kung fu? Why?"}, {"y": 0.6272093025109269, "text": "6 Do you prefer doing indoor sports or outdoor", "w": 0.3398926459418402, "x": 0.5563506392831049, "h": 0.012727520483065188}, {"x": 0.14132379549543822, "text": "Do you like doing water sports such as kayaking?", "w": 0.3381037394205729, "y": 0.6411146207296542, "h": 0.012649913892849272}, {"y": 0.6407943549121317, "w": 0.09676722208658861, "h": 0.013295011279385024, "x": 0.5759455469608497, "text": "sports? Why?"}, {"y": 0.6548555959703479, "w": 0.11270124647352428, "text": "Why?/Why not?", "x": 0.13953488754141316, "h": 0.012955776173285189}, {"h": 0.014133574007220224, "text": "7 Which of these sports do you like best? Why?", "x": 0.5545617237378353, "y": 0.6536777976252324, "w": 0.3381037394205729}, {"x": 0.09302326531652176, "text": "3 Read the instructions on your card. In pairs, take turns to role-play the conversation.", "w": 0.6243291558159723, "h": 0.011458420447924517, "y": 0.6764485560453589}, {"x": 0.13946212484828935, "h": 0.009474899174934633, "y": 0.7040343527064188, "w": 0.07349077860514322, "text": "Student A"}, {"y": 0.7041737971896714, "x": 0.5527200685799651, "h": 0.011725079935810682, "text": "Student B", "w": 0.07345074123806428}, {"text": "You want to go to basketball summer day", "x": 0.13953489103853953, "y": 0.7282716606118834, "w": 0.30411448160807286, "h": 0.011481246091828929}, {"y": 0.7422819769666364, "text": "camp. Talk to the camp leader, Student B,", "x": 0.13953489331870325, "h": 0.011508636564984633, "w": 0.30769229465060766}, {"text": "and ask for advice.", "y": 0.7549273258322979, "x": 0.1395348882251039, "w": 0.1395348782009549, "h": 0.011426464771105508}, {"h": 0.012645348314774147, "y": 0.7726308143727727, "text": "• Introduce yourself to Student B and say that", "x": 0.13774597642293568, "w": 0.3291592068142361}, {"y": 0.7863763537151927, "h": 0.011545157819878766, "text": "you'd like to find out more about basketball", "x": 0.1610017885075812, "w": 0.3023255750868056}, {"w": 0.10017889234754773, "x": 0.16100178938078785, "h": 0.010230406871341188, "text": "summer camp", "y": 0.8028655232786963}, {"x": 0.13774598010175768, "text": "• Ask if you can join the camp.", "y": 0.8142509026941214, "h": 0.011490376124743525, "w": 0.22003577338324656}, {"x": 0.13774597557941345, "h": 0.011499506532070037, "y": 0.828270349034369, "w": 0.3202146742078993, "text": "• Say that you're worried that you aren't very"}, {"w": 0.13416815016004777, "x": 0.16100179421782937, "y": 0.842125451425092, "text": "good at basketball.", "h": 0.011435594804020104}, {"h": 0.011554287852793362, "w": 0.19499104817708332, "text": "Ask what you should wear.", "x": 0.14847942793888838, "y": 0.8560901165352411}, {"x": 0.5545617166034357, "y": 0.7270938626261065, "h": 0.012659044300175787, "w": 0.2969588555230035, "text": "You work at the sports centre. Student A"}, {"y": 0.7422819771215421, "h": 0.011508636564984633, "w": 0.12164579603407122, "text": "needs your help.", "x": 0.554561717188689}, {"x": 0.5527728153018763, "text": "• Respond and ask how you can help.", "y": 0.7587209304465784, "h": 0.011558853056456667, "w": 0.2737030368381076}, {"y": 0.772630814141164, "x": 0.5527728223874283, "h": 0.011389943890623293, "text": "• Say yes and explain that the camp is open", "w": 0.31305901421440974}, {"text": "to everyone.", "y": 0.78780523264066, "w": 0.08944543626573354, "h": 0.010116278651819414, "x": 0.5742397137097094}, {"y": 0.8004505817830199, "h": 0.012645348314774242, "text": "• Tell him/her that he shouldn't worry and that", "w": 0.33452592637803813, "x": 0.549194999512233}, {"text": "everyone is welcome.", "h": 0.011490376499155443, "w": 0.1520572408040365, "x": 0.5742397133785424, "y": 0.8142509023987431}, {"h": 0.010308013087145282, "w": 0.32558139377170137, "x": 0.5509839035166537, "y": 0.826814079600683, "text": "• Give advice on what Student A should wear"}, {"y": 0.8421254512822887, "h": 0.012700130009909485, "x": 0.572450807608159, "w": 0.1323792436387804, "text": "(tracksuit, trainers)."}, {"text": "• Say that it's important to bring a bottle of", "w": 0.31484792073567713, "x": 0.5491950049988877, "h": 0.014133574007220224, "y": 0.8546886280545751}, {"x": 0.1563786001431356, "y": 0.8822605966730988, "w": 0.30452674018012155, "text": "Thank Student B and end the conversation.", "h": 0.011773940345368938}, {"h": 0.01162790690711002, "text": "81", "y": 0.9374999999621426, "x": 0.907407407321301, "w": 0.022633745405409078}]
[{"x":0.078189300762738514,"text":"3.7","w":0.067901234096950966,"h":0.031976744743119512,"y":0.056686046432946058},{"y":0.030258885051962503,"text":"WRITING","w":0.14212528652615014,"x":0.20568632922813834,"h":0.020877579130594959},{"y":0.072605965500715741,"w":0.15020575629340277,"h":0.011773940345368938,"text":"An email of request","x":0.20164609454877186},{"h":0.010311324704947333,"y":0.094476744464215168,"w":0.18312757703993057,"text":"I can write a short email","x":0.19958847332845728},{"w":0.082405327690972197,"text":"of request.","h":0.01340160339930363,"y":0.10739803528789249,"x":0.20159568910547504},{"y":0.15843023252028221,"w":0.055555555555555566,"h":0.011627906907110019,"text":"(1) 2.13","x":0.090534980118312749},{"w":0.30041151258680554,"text":"Listen to the conversation between Rose","x":0.1522633825131815,"y":0.15843023273214163,"h":0.010329578884729518},{"x":0.09053498486147267,"h":0.011627906907110019,"text":"and her boss, Jeremy. What does Jeremy want Rose","w":0.38477366129557294,"y":0.17296511624121247},{"text":"to do? Complete the missing information.","y":0.18602825783069576,"w":0.31069956461588544,"x":0.088477380757900806,"h":0.013099648701714206},{"y":0.21013934786354804,"text":"> phone arrestaurant","w":0.1786200459798177,"x":0.044362773821775142,"h":0.021406446184430772},{"y":0.23110465105225897,"text":"order","h":0.011627906907110019,"x":0.07201646140468268,"w":0.051440327962239588},{"w":0.014403292338053389,"h":0.01017441816943776,"text":">","x":0.045267489489409521,"y":0.23837209331353693},{"text":"fors","w":0.032921810150146474,"h":0.010174418169437871,"y":0.22819767461198648,"x":0.19958847818967299},{"x":0.048335948262050135,"y":0.23773414922310199,"w":0.30002156575520833,"h":0.025782209363425457,"text":"> remember to order something fora."},{"text":"> need lunch bys","h":0.023164665306007359,"x":0.048121367196432112,"w":0.14226019965277778,"y":0.25784366872788156},{"w":0.1595904541015625,"h":0.02623372848965877,"text":"> prepare bags of","x":0.049533298048562262,"y":0.27203273812648798},{"text":"for customers","x":0.28395061617283951,"y":0.27180232587167641,"h":0.010174418169437871,"w":0.1111111111111111},{"x":0.29960203565251597,"h":0.02058665456726938,"y":0.21804912116280861,"text":"people (for the meeting)","w":0.19897947523328996},{"y":0.31540697713136634,"w":0.0123456785413954,"h":0.010174418169437871,"text":"2","x":0.065843621703239194},{"x":0.07613169613936302,"h":0.011627906907110019,"w":0.36008229573567707,"y":0.31540697670632867,"text":"What's Rose's problem? What do you think she"},{"y":0.32994186075539744,"text":"decides to do?","x":0.090534978647300188,"w":0.10905349731445314,"h":0.010325015246213098},{"w":0.29629628499348959,"y":0.35319767486293885,"h":0.013081394896215293,"text":"3 Read Email 1. What is wrong with it?","x":0.065843629931238656},{"y":0.37048665601584774,"x":0.09053498522011498,"text":"1 There is not enough information.","w":0.25102879842122394,"h":0.011780785616001932},{"w":0.23456788804796005,"y":0.38500784922204145,"x":0.090534989926637138,"text":"2 There is too much information.","h":0.010340987793878931},{"y":0.39952904253263766,"x":0.090534985948852981,"w":0.19547324286566839,"h":0.011808166698533684,"text":"3 The message is not clear."},{"h":0.011821857614083053,"y":0.41405023532590612,"x":0.090534987602344727,"text":"4 The request is not polite.","w":0.18930040147569444},{"x":0.090534986237099643,"text":"5 The message is too long.","y":0.42877906976592173,"w":0.19341562906901039,"h":0.01162790690711013},{"text":"To: Greg Sutter","y":0.46220930216659994,"w":0.10905349731445313,"h":0.011627906907110019,"x":0.074074073530702139},{"w":0.12551439921061197,"x":0.074074074545928612,"h":0.0087802563581960147,"text":"From: Rose Orton","y":0.47959183671162142},{"h":0.011817293975566634,"w":0.20781892564561635,"x":0.074074074193652778,"y":0.49563953497667756,"text":"Subject: Tomorrow's meeting"},{"w":0.037037035624186199,"h":0.01017441816943776,"x":0.074074075150869861,"y":0.51889534901121126,"text":"Greg,"},{"w":0.40123453776041662,"h":0.011627906907110019,"text":"Phone a restaurant and order lunch for the people at the","x":0.074074095831725584,"y":0.53633720928869311},{"text":"meeting. Order something for vegetarians, too. Prepare","y":0.55219780209901492,"h":0.011773940345368938,"w":0.3888888888888889,"x":0.074074078935185084},{"y":0.56671899512495949,"w":0.39094648573133683,"h":0.013343799058084693,"x":0.074074086146677237,"text":"bags of presents for everyone. Use the pens in my desk."},{"h":0.0087778564524987335,"text":"Rose","y":0.58863432752899525,"w":0.035007784101698122,"x":0.074059894306984994},{"h":0.013081394896215293,"text":"4 Read Email 2. Why is it better?","y":0.61337209341308419,"x":0.065843626066984962,"w":0.25308641221788192},{"x":0.074074074516641747,"y":0.65843023273830548,"w":0.1090534973144531,"h":0.011627906907110019,"text":"To: Greg Sutter"},{"text":"From: Rose Orton","y":0.67425431717805384,"w":0.12551439921061197,"h":0.010338705787479086,"x":0.074074077370002656},{"text":"Subject: Tomorrow's meeting","y":0.69017104805118556,"w":0.20817221747504339,"h":0.013462424465401024,"x":0.073898233842684943},{"text":"Greg,","x":0.074074074980935919,"h":0.011627906907110019,"y":0.71366279092628992,"w":0.039094649420844188},{"x":0.072016465648509762,"y":0.73110465129825863,"h":0.013081394896215293,"text":"IAl I've got a problem and I need your help with","w":0.32921810574001736},{"text":"tomorrow's meeting. I've got an exam in half an hour","w":0.37448557535807292,"y":0.74709302333908056,"h":0.011627906907110019,"x":0.072016465338796382},{"w":0.2592592536078559,"text":"and I haven't got the time to do this.","x":0.074074081220763269,"y":0.76295133444461161,"h":0.011773940345368938},{"x":0.069958841255144233,"y":0.78052325601603956,"text":"[BI Please could you phone a good restaurant and order","w":0.38888888888888884,"h":0.013081394896215404},{"x":0.072016461479231061,"text":"lunch for twelve people for tomorrow's meeting at","y":0.79651162797813113,"w":0.35596706814236112,"h":0.011627906907110019},{"x":0.074074089749308666,"w":0.37037034776475697,"h":0.013129312164929408,"y":0.81104651169070052,"text":"12:30? Could you order some vegetarian dishes, too?"},{"h":0.013343799058084804,"y":0.82692307716375602,"x":0.074074086149021404,"w":0.34773661295572916,"text":"Also, we need to prepare bags of presents for the"},{"y":0.84301412885881177,"w":0.38683125813802083,"h":0.011773940345368938,"text":"customers. There are twenty expensive pens in a box in","x":0.07407408673345868},{"text":"my desk and you could use those. The receptionist has","x":0.07407408904863505,"w":0.38271603054470488,"y":0.85753532172487257,"h":0.013104212714514119},{"y":0.87354651166272401,"w":0.24279834323459201,"x":0.07407408345814967,"text":"got company bags to put them in.","h":0.01162790690711013},{"h":0.011796758163667653,"text":"[cl Sorry to bother you, but I just don't have the time.","x":0.069958852170072139,"w":0.37448557535807286,"y":0.89244186049993346},{"h":0.010325015246213098,"y":0.90973312409528873,"text":"Thanks a lot,","x":0.07407407844298558,"w":0.092592586941189214},{"x":0.074074074384622449,"w":0.034979423946804478,"text":"Rose","y":0.9273255813633221,"h":0.0087209301803325978},{"w":0.024691357082790799,"x":0.06790123524461282,"h":0.01162790690711013,"text":"44","y":0.95639534879935195},{"h":0.01017441816943776,"text":"5","x":0.51440329209781221,"y":0.30959302330384697,"w":0.010288065804375579},{"x":0.54115226553642615,"w":0.37242797851562504,"y":0.30959302361293883,"text":"Read Rose's Email 2 again. Match explanations 1-3","h":0.013081394896215293},{"text":"with parts A-C of the email.","y":0.32412790736547925,"w":0.20987653944227436,"h":0.014569109612768805,"x":0.53703704101960359},{"text":"1 Rose asks Greg to do some things.","x":0.53909465569571036,"h":0.011773940345368938,"w":0.26337448120117191,"y":0.34301412890968397},{"x":0.5411522648780771,"y":0.35596546306521537,"text":"2 Rose introduces her problem.","w":0.22427983601888013,"h":0.013343799058084915},{"x":0.54115226729460031,"y":0.37048665615150678,"text":"3 Rose thanks Greg and says she's sorry for the","w":0.32921810574001731,"h":0.01178078561600171},{"text":"trouble.","y":0.38494858128137355,"w":0.057792583041720857,"h":0.012079581735272571,"x":0.55546584743743732},{"text":"6 Complete the WRITING FOCUS with words and","y":0.40843023300247383,"x":0.51440329887789082,"w":0.37448557535807292,"h":0.013081394896215182},{"y":0.42425431721328755,"h":0.011792194525151234,"x":0.54115226657714854,"w":0.18724278767903646,"text":"phrases in Rose's Email 2."},{"text":"WRITING FOCUS","w":0.13991769578721791,"x":0.51646090379363385,"h":0.013113339991547068,"y":0.4505494505234211},{"y":0.47370486668614942,"x":0.51440329213585878,"w":0.15432098388671878,"h":0.013343799058084693,"text":"An email of request"},{"x":0.51234568097772792,"w":0.10699588351779499,"text":"• Introduction","y":0.49254317123417923,"h":0.010363805237894375},{"y":0.5072674418589449,"text":"I've got a 'problem.","w":0.14403291490342884,"x":0.52469136327873822,"h":0.011627906907110019},{"x":0.52469135839041681,"text":"I need your\/some","w":0.123456785413954,"h":0.011627906907110019,"y":0.52034883705032098},{"text":"2","w":0.010288065804375579,"x":0.66872427998361472,"y":0.51889534879064769,"h":0.0087209301803325978},{"h":0.011819575607682986,"w":0.14403291490342873,"y":0.53488372100138692,"text":"Could you help me?","x":0.52469135967791536},{"x":0.52469136358088309,"h":0.013343799058084693,"y":0.54788069065907863,"w":0.19547324286566847,"text":"Could you do me a favour?"},{"x":0.51234568217719179,"h":0.01029535215728139,"w":0.096707814534505165,"text":"• Conclusion","y":0.56976744203446705},{"x":0.52457897181422919,"text":"(So) Sorry to","w":0.10104782104492194,"y":0.58379441158652012,"h":0.01264373399024854},{"x":0.52469135939185363,"h":0.011773940345368938,"w":0.067901234096950924,"y":0.59733124028675366,"text":"Thanks 5"},{"w":0.08230452643500441,"text":"• Requests","x":0.74279835509525505,"y":0.49254317103322098,"h":0.011817293975566523},{"x":0.75720164657921818,"text":"Please 3","h":0.010277098351782477,"y":0.50581395357879855,"w":0.05555555555555558},{"text":"you ...?","y":0.50792487661382857,"x":0.88448478203064285,"w":0.056127637227376237,"h":0.010236748720824806},{"y":0.52034883734477011,"x":0.75720165076808854,"w":0.14814814249674479,"h":0.013081394896215404,"text":"Could you please...?"},{"w":0.15843621148003473,"text":"Do you think you could","x":0.75720164893076447,"y":0.53488372087784031,"h":0.01181957598196659},{"text":"...?Could you also ...?","w":0.15226337009006086,"y":0.54788069104667547,"x":0.75720164575058013,"h":0.013343799058084804},{"h":0.0087209301803325978,"y":0.5872093022790198,"text":"you.","x":0.70370370438994734,"w":0.032921810150146502},{"w":0.17489712185329864,"text":". \/ Thank you very much.","x":0.66460905442828888,"h":0.01162790690711013,"y":0.59883720930080542},{"h":0.013343799058084804,"text":"7 Rewrite sentences 1-4 as polite requests. Use the","x":0.51440330130442768,"y":0.63069073756417926,"w":0.39094648573133683},{"text":"words in brackets.","x":0.53909465683037816,"y":0.64521193090240836,"w":0.13786007351345486,"h":0.011773940345368938},{"text":"1 Take this letter to the post office. (could\/please)","y":0.66279069777354938,"w":0.34979424370659717,"h":0.013081394896215293,"x":0.54115226523517868},{"x":0.55349794890984039,"text":"Could you please take this letter to the post office?","h":0.011627906907110019,"w":0.36213989257812496,"y":0.67732558143016597},{"x":0.53909465422939307,"w":0.24691357082790799,"h":0.01162790690711013,"y":0.69186046534489454,"text":"2 Phone the plumber. (think\/could)"},{"w":0.33950615776909721,"text":"3 Give these papers to Mr Flynn. (please\/favour)","y":0.70486656220936739,"h":0.013343799058084693,"x":0.54115227327594517},{"text":"4 Ask him to sign them. (also\/please)","x":0.54115226849938913,"w":0.26131686740451388,"y":0.72093023270307177,"h":0.010231462715184825},{"w":0.24691357082790799,"x":0.52057613886588139,"y":0.75145348851702531,"text":"SHOW WHAT YOU'VE LEARNT","h":0.010320451981980172},{"text":"8 Write an email to a colleague. Ask him\/her to do the","w":0.4012345716688368,"y":0.77747252740855743,"x":0.5144032943096144,"h":0.010318169975580105},{"h":0.013629883387399344,"w":0.36846923828125,"x":0.53902280937286096,"text":"things you cannot do. Use the WRITING FOCUS to","y":0.79034208465936528},{"h":0.011879524967546962,"x":0.53905849455367127,"text":"help you.","y":0.80510674895431733,"w":0.080319222344292451},{"x":0.53909465142525881,"w":0.384773661295573,"text":"You work in a small music shop. You don't feel well and","h":0.013343799058084693,"y":0.82260596553958321},{"h":0.010238307985817818,"text":"you're going home.","x":0.53909465605994533,"y":0.83866279084260686,"w":0.14403291490342884},{"y":0.85164835182128484,"text":"Things you haven't got time to do:","h":0.011773940345368938,"w":0.24279834323459204,"x":0.54115227275856115},{"y":0.86616954485184872,"text":"• send the three CDs on the desk to Mr L. Henderson","x":0.53909465621985897,"w":0.38065843370225694,"h":0.010283943248131866},{"w":0.35006568060980903,"x":0.55338709762001737,"h":0.015253620956157454,"y":0.87726149220534022,"text":"(the address is on a piece of paper with the CDs),"},{"w":0.34567901611328133,"x":0.53909465089397646,"h":0.013090522173248242,"text":"• email Mrs Young and tell her we've got the old","y":0.89389534922703762},{"h":0.011627906907110019,"text":"Beatles LP for her,","y":0.90843023278675494,"w":0.12962962680392798,"x":0.55761317216045025},{"text":"• phone the computer man. The system isn't working well.","y":0.92296511624121258,"w":0.39506171332465279,"h":0.011627906907110019,"x":0.53909466267923722}]
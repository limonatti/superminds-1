[{"text":"7.5","y":0.049418605420178618,"h":0.045058138142200943,"w":0.076131685045030387,"x":0.067901235320732098},{"y":0.031976744534050527,"w":0.17489712185329864,"h":0.020348836338875631,"x":0.20370370419680744,"text":"GRAMMAR"},{"h":0.013081394896215404,"text":"Present perfect + just\/yet\/already","y":0.074127907130380644,"w":0.25514402601453995,"x":0.19958848507229093},{"h":0.017817985319080742,"text":"I can use the Present Perfect with just,","y":0.091594930305152866,"x":0.19733070679813497,"w":0.29061431884765626},{"x":0.19753086860989533,"y":0.11028257451606327,"w":0.123456785413954,"h":0.01181044870493364,"text":"already and yet."},{"text":"1","y":0.15843023294531977,"w":0.010288065804375551,"h":0.010174418169437871,"x":0.063786008352956253},{"text":"SPEAKING Discuss the questions.","y":0.15843023255661937,"w":0.25720163981119792,"h":0.01162790690711013,"x":0.08024691993493592},{"text":"1 How many countries have you visited?","x":0.0884773702409659,"h":0.011773940345368938,"y":0.17582417582569598,"w":0.28395060221354163},{"x":0.08847737022589551,"y":0.19034536900536025,"h":0.011773940345368938,"text":"2 Which countries would you like to visit? Why?","w":0.33539093017578125},{"text":"2 Look at the photo with a partner. Match questions 1-5 with","w":0.45473249647352426,"y":0.21350078458800192,"h":0.013343799058084804,"x":0.061728394390124272},{"w":0.39506171332465279,"text":"answers a-e. Which things about Nancy surprised you?","x":0.088477368852077048,"y":0.22802197783428446,"h":0.013343799058084804},{"x":0.090534983141969255,"y":0.24709302340691008,"text":"1 Who is Nancy?","w":0.12139917161729602,"h":0.011627906907110019},{"x":0.090534985172190982,"text":"2 When did she start travelling? Why?","y":0.26162790691466209,"w":0.26954732259114583,"h":0.011627906907109908},{"x":0.09053497850859224,"w":0.27366255018446184,"h":0.011627906907110019,"y":0.27616279092628992,"text":"3 How many countries has she visited?"},{"h":0.010206363264769536,"y":0.28924418619144387,"x":0.090534984439032407,"w":0.15020575629340277,"text":"4 Where is she now?"},{"y":0.30376766080590012,"w":0.33950615776909726,"h":0.011773940345368938,"text":"5 Has she been to all the places on her list yet?","x":0.09053499035413444},{"text":"a So far, she has already visited forty countries (this does not include","x":0.055555565841009097,"w":0.47119340684678823,"y":0.32994186042725904,"h":0.011627906907109908},{"y":0.3430141288733467,"w":0.46502058241102434,"x":0.076131687978301235,"text":"the two - Mexico and Canada - she travelled to as a younger woman).","h":0.011773940345368827},{"h":0.011773940345368827,"text":"b She started travelling fourteen months ago, when she got the results","x":0.057613174081308088,"w":0.47325100368923612,"y":0.35753532193188708},{"h":0.011780785616001932,"y":0.37048665628232058,"text":"of some medical tests. They were not good, but she didn't feel ill. She","x":0.076131678969746749,"w":0.46090535481770828},{"x":0.076075386785042082,"w":0.46101986355251734,"text":"decided then that she wanted to realise her old dream: to travel a lot.","y":0.38340239461021941,"h":0.01197295959927791},{"w":0.47325100368923606,"x":0.055555561735629089,"h":0.011808167072817177,"text":"c No, she hasn't. On her original list there were only thirty countries:","y":0.39952904238848974},{"h":0.011773940345368938,"text":"the ones she wanted to see the most, like Japan or Peru. She visited","x":0.076131680122010159,"y":0.41130298266783394,"w":0.46090535481770828},{"x":0.076131706870096988,"w":0.46502054850260421,"y":0.42425431699526417,"text":"them all in the first year. Her new list contains seventy countries. For","h":0.011792194525151345},{"text":"example, she hasn't been to Mongolia yet, but she plans to go there","y":0.43749999997667754,"w":0.46502058241102434,"h":0.011627906907110019,"x":0.076131688753335494},{"text":"from India. She's very excited!","x":0.076131688651814633,"h":0.011773940345368938,"w":0.20781892564561633,"y":0.45054945046880768},{"x":0.057613176014740981,"y":0.46656976772002923,"text":"d Nancy is an eighty-eight year-old American woman who wants to visit","w":0.48148145887586807,"h":0.01027481634538252},{"x":0.076131694675122194,"y":0.47802197810671609,"text":"as many countries as possible before she dies. She is travelling with","w":0.45061726888020831,"h":0.011803603060017265},{"text":"her daughter.","y":0.49254317126446034,"w":0.092592586941189214,"h":0.010363805237894264,"x":0.076131691611709851},{"text":"e Nancy has just arrived in India and plans to stay there for two weeks.","y":0.50726744215074615,"x":0.055555549311784934,"w":0.48765431722005209,"h":0.010174418169437871},{"y":0.68602825762829056,"h":0.011773940345368938,"x":0.065843624319822242,"w":0.45473249647352432,"text":"3 Complete the GRAMMAR FOCUS with the Present Perfect"},{"text":"forms in blue in Exercise 2.","w":0.19998741997612846,"x":0.090324458762946105,"h":0.013501818550624822,"y":0.69878371844740927},{"y":0.72802197780400346,"text":"GRAMMAR FOCUS","x":0.065843621996969859,"w":0.15432098388671875,"h":0.013343799058084804},{"w":0.043209877014160181,"x":0.23456790085505985,"h":0.013081394896215293,"y":0.72819767477572961,"text":"629"},{"w":0.32098765055338535,"x":0.061728391595735434,"h":0.011627906907110019,"text":"Present Perfect with just, already and yet","y":0.75145348845535964},{"h":0.013138439441962357,"text":"• You use just to talk about things that happened a very short time","y":0.76883830457227897,"w":0.47530863444010418,"x":0.063786006056697028},{"text":"ago.","y":0.78633720927998885,"w":0.032921810150146474,"h":0.0087209301803324868,"x":0.086419753909837568},{"x":0.08641975958685634,"y":0.79941860468597981,"text":"She 'has just arrived in India.","h":0.011805885066417221,"w":0.2016460842556424},{"y":0.81671899527867931,"h":0.011773940345368938,"x":0.063786018974448508,"text":"• You use already in affirmative sentences for things that","w":0.40740739610460064},{"w":0.22633744981553822,"y":0.83124018842200642,"x":0.086419755287704125,"h":0.011783067248118284,"text":"happened earlier than expected."},{"x":0.086419753710359801,"w":0.039094649420844188,"h":0.011796757789384271,"text":"She 2","y":0.84576138156533343},{"w":0.055885696411132835,"text":"already","h":0.01244109915788727,"x":0.21794192609557339,"y":0.84697712499441946},{"h":0.011773940345368938,"y":0.84733124025161755,"w":0.1028806559244792,"text":"forty countries.","x":0.3765432104465396},{"x":0.063786017337922662,"w":0.47119340684678823,"h":0.01162790690711013,"y":0.86482558137202636,"text":"• You use (not) yet in questions and negative sentences for things"},{"w":0.45267489963107643,"h":0.01162790690711013,"text":"that haven't happened but probably will happen. Yet goes at the","x":0.086419755602843096,"y":0.87936046507842169},{"text":"end of the sentence.","h":0.010343269425995394,"y":0.89389534903664736,"x":0.08641975805221995,"w":0.14609052870008682},{"w":0.043209877014160153,"h":0.011778503609601865,"x":0.18106995933242609,"y":0.90973312416565855,"text":"_ she_"},{"y":0.92241098299309221,"w":0.068264414469401027,"text":"No, she 4","x":0.08623816298786148,"h":0.012736173776479842},{"h":0.013081394896215293,"text":". to Mongolia yet?","x":0.31275720378443084,"y":0.90843023256642719,"w":0.12757201300727},{"text":"there yet.","w":0.068011504279242629,"x":0.34768149133692189,"h":0.010548196370410712,"y":0.92423171569187001},{"x":0.063786008454489368,"w":0.024691357082790799,"y":0.95639534893016598,"h":0.011627906907110019,"text":"90"},{"h":0.014534882885320677,"y":0.01308139570434963,"x":0.74691358248813455,"w":0.072016457451714477,"text":"VIDEO"},{"text":"629","x":0.9094650202289094,"h":0.015988372371559811,"y":0.011627906919234654,"w":0.05555555555555558},{"text":"4 Complete the text with the correct form of","h":0.011773940345368938,"y":0.047880690830956807,"x":0.58024690917586974,"w":0.34567901611328122},{"x":0.60699589280124733,"h":0.011773940345368938,"w":0.30041151258680554,"text":"the verbs in brackets
17441816943776},{"text":"11-16","h":0.0087209301803324868,"w":0.043209877014160181,"x":0.11111111077275532,"y":0.53779069767976728},{"h":0.01017441816943776,"x":0.11111111051555367,"text":"16-18","y":0.55523255841770358,"w":0.043209877014160153},{"h":0.011627906907110019,"text":"Type of school","y":0.50145348845535975,"x":0.19135802353602704,"w":0.10699588351779515},{"x":0.18604082355584417,"y":0.51819017749011964,"w":0.054068374633789051,"h":0.014362218428631279,"text":"Primary"},{"y":0.5372677451597353,"text":"Secondary","h":0.011615914115726045,"w":0.074651701185438346,"x":0.18694126162357422},{"x":0.18724280052239053,"text":"post-GCSE\/Further","y":0.55523255810167749,"w":0.13580246819390193,"h":0.011627906907110019},{"y":0.50145348864420547,"text":"Year number","x":0.343621400165875,"w":0.096707814534505221,"h":0.010320451607696679},{"w":0.02880658467610675,"text":"1-6","h":0.01162790690711013,"y":0.51889534877512711,"x":0.33744855947950492},{"w":0.034979423946804422,"y":0.53779069775867105,"x":0.33950617245046616,"text":"7-11","h":0.0087209301803324868},{"y":0.55523255831970086,"w":0.047325100368923623,"text":"12-13","h":0.011627906907110019,"x":0.33744856146677277},{"x":0.10288066539546079,"y":0.59011627907805519,"w":0.32098765055338541,"h":0.013101931082397655,"text":"SPEAKING Are sentences 1-8 about typical"},{"w":0.34773661295572922,"x":0.10493828136164154,"text":"British (B) or Chinese (C) students? Discuss with","y":0.60596546314009703,"h":0.010313606337063796},{"y":0.61996618264829972,"x":0.10267481016852978,"h":0.012974611818322601,"text":"a partner.","w":0.072428156534830729},{"x":0.10288065429968817,"text":"1 They wear tracksuits in school.","y":0.63657770814706782,"h":0.011773940345368938,"w":0.23045267740885417},{"text":"2 Their typical school day is twelve hours long.","x":0.10699589032921791,"h":0.014715143051027724,"w":0.33333333333333331,"y":0.64952904257767907},{"h":0.011773940345368938,"y":0.66562009409577583,"x":0.10699589088856451,"w":0.32921810574001742,"text":"3 They start the day with a morning assembly"},{"y":0.68014128721730061,"text":"(= large meeting).","x":0.1193415670819368,"h":0.011773940345368938,"w":0.12551439921061197},{"x":0.10493827881254542,"y":0.69331395393270634,"w":0.30452674018012155,"h":0.013122466520013032,"text":"4 They start the day with morning exercise."},{"w":0.24485595703125002,"h":0.013108775978747156,"x":0.10493827727998539,"text":"5 They talk and laugh a lot in class.","y":0.70784883765363649},{"y":0.72238372115884797,"w":0.29629628499348959,"h":0.011627906907110019,"text":"6 In PE classes, students can choose what","x":0.10493827595318667},{"h":0.011773940345368938,"w":0.072016457451714408,"text":"they want.","x":0.098765432625308833,"y":0.73979591838968373},{"text":"7 After classes fi nish, they have two hours","y":0.75431711147244884,"w":0.29629628499348953,"x":0.10288066902588883,"h":0.011773940345368938},{"x":0.11927539247343746,"y":0.76428426502385138,"text":"of self-study.","h":0.012129143979897505,"w":0.086552098592122401},{"y":0.77904238605509579,"x":0.10288066439327868,"w":0.19958847045898437,"h":0.013108776727314142,"text":"8 Classes finish at 3:30 p.m."},{"text":"8","w":0.022633745405409078,"y":0.76308139552054877,"x":0.45061728377877697,"h":0.027616279278669942},{"x":0.078189300328264905,"y":0.80377906970634538,"h":0.0087209301803325978,"text":"3","w":0.010288065804375551},{"h":0.011773940345368938,"text":"SPEAKING Compare the sentences in Exercise 2","x":0.090534976424991101,"y":0.80376766089310947,"w":0.36831275092230903},{"w":0.26337448120117185,"h":0.011773940345368938,"y":0.81828885403643659,"text":"with your school. Discuss in groups.","x":0.10288066392616296},{"y":0.84733124053880982,"x":0.076131693250131263,"h":0.013133875429162445,"text":"WHILE YOU WATCH","w":0.19341562906901044},{"y":0.86773255820232842,"x":0.078189301077634832,"w":0.36008229573567713,"h":0.013081394896215293,"text":"4 & 20) Watch the video and check your ideas in"},{"text":"Exercise 2. Note down any other new information","x":0.10493827288913796,"h":0.01162790690711013,"w":0.35390947129991324,"y":0.88372093019470077},{"h":0.010299915795797809,"w":0.24074072943793401,"text":"about China and Chinese schools.","x":0.10288066809996287,"y":0.89825581414687028},{"text":"5","w":0.010288065804375579,"h":0.010174418169437649,"x":0.51440329230357351,"y":0.41860465154997106},{"h":0.013081394896215404,"text":"020)","y":0.4171511629261655,"w":0.049382714165581598,"x":0.53909465176494575},{"x":0.58847736425998265,"h":0.011627906907110019,"y":0.41860465125574731,"text":"Watch the first part of the video (up to 02:15)","w":0.32510287814670136},{"w":0.36831275092230897,"text":"again and complete the fact sheet with one word in","y":0.43168604695596202,"x":0.53909465097917486,"h":0.013081394896215404},{"h":0.0106696566008323,"text":"each gap.","y":0.44742679954586084,"x":0.5390261874931771,"w":0.072153388129340357},{"h":0.011789912518751278,"text":"Location: Liphook, a small '","w":0.20164608425564234,"x":0.54115226857176724,"y":0.46350078497550151},{"text":"in Britain.","y":0.46350078492705182,"h":0.011789912518751278,"x":0.82716049477055131,"w":0.069958843655056446},{"y":0.4795918367930001,"text":"School: a local, mixed","w":0.15432098388671878,"x":0.53909465288688752,"h":0.011773940345368938},{"text":"2","w":0.016460904015435096,"h":0.0058139530792714611,"x":0.69958847721038964,"y":0.47965116314059686},{"h":0.010651694736450668,"text":"school","x":0.79621655715358453,"y":0.47941252474893958,"w":0.059830258687337268},{"x":0.54115227330608595,"y":0.4941130298916292,"h":0.013343799058084804,"text":"Number of Chinese teachers in Liphook: 3","w":0.29218105740017353},{"h":0.010233744721584781,"w":0.28395061916775177,"x":0.54115226233045532,"y":0.51017441844426104,"text":"Number of students in Chinese classes: 4"},{"h":0.011789912893034771,"text":"Number of school hours in China:","y":0.52470930216660006,"x":0.53909465459362815,"w":0.23868311564127598},{"h":0.011776222351768895,"text":"Number of meals in Chinese schools: 6","x":0.54115226884845979,"y":0.5392441858875302,"w":0.26954732259114578},{"x":0.54093385838664299,"text":"Most important subject in Chinese schools:","h":0.017760597181095683,"y":0.55280271876167975,"w":0.31116831461588546},{"h":0.013145284338311858,"y":0.58575581427064238,"text":"AFTER YOU WATCH","x":0.51028806782146197,"w":0.19341562906901044},{"y":0.60901162813559218,"h":0.011627906907110019,"x":0.51234568606744046,"w":0.39506171332465279,"text":"6 SPEAKING Is the experiment a success? Are there"},{"y":0.62354651180807297,"text":"any problems? What can the Chinese teachers do","h":0.011627906907110019,"x":0.53909465175700877,"w":0.35596706814236112},{"text":"differently? Discuss in groups.","y":0.63657770828405591,"h":0.013131593797045982,"w":0.22016460842556418,"x":0.53909465327178574},{"h":0.010174418169437871,"x":0.51234567945358211,"w":0.012345678541395455,"text":"7","y":0.66424418619144387},{"x":0.52880658600950337,"w":0.39094648573133672,"y":0.66405023559007437,"text":"Read the summary of four weeks of the experiment","h":0.013343799058084804},{"y":0.67877906974411939,"h":0.011627906907110019,"text":"in the video. Write up to ten sentences to express","w":0.37037034776475697,"x":0.53703705204354746},{"text":"your opinion about the results of the experiment.","y":0.69331395352318914,"h":0.011627906907110019,"x":0.53909466004332218,"w":0.36419752332899302},{"w":0.38065843370225694,"h":0.010263407436233107,"x":0.53909465621985897,"text":"After the first day, the Chinese teachers can see that they","y":0.71938775508235209},{"text":"have problems with discipline and they have to find","w":0.34567901611328133,"y":0.73546511655723834,"x":0.5390946454413017,"h":0.010217771799635567},{"x":0.5390946579493392,"text":"a way to show the British students that learning can be","y":0.74999999996214262,"w":0.36831275092230908,"h":0.011773940345368938},{"y":0.76598837221978688,"x":0.5390946585258326,"w":0.36419752332899313,"h":0.010306761066430803,"text":"fun. So they decide to show them an old Chinese game"},{"text":"to help the pupils in Mathematics. In PE classes, they","h":0.011627906907110019,"x":0.53703705619072295,"y":0.780523255800321,"w":0.358024664984809},{"text":"teach students a traditional Chinese dance. They also have","x":0.53703704362762816,"y":0.79651162807007769,"w":0.37654320610894099,"h":0.01017441816943776},{"text":"a cooking class. To stop the problem with discipline,","y":0.81104651146892548,"w":0.34979424370659729,"x":0.5390946525637107,"h":0.011627906907110019},{"text":"the teachers have a meeting with the students' parents","x":0.53703705296947335,"y":0.82692307697226231,"h":0.011773940345368938,"w":0.37037034776475686},{"y":0.84301412877875204,"w":0.37037034776475697,"x":0.53909466768140724,"text":"and ask them for help. After 4 weeks of the experiment,","h":0.010204081632653073},{"w":0.37448557535807292,"h":0.010204081632653073,"text":"the class in the video and another class from the school","y":0.85753532200686611,"x":0.53703704147048359},{"h":0.01162790690711013,"x":0.5370370439670541,"w":0.37448557535807292,"y":0.87354651172086351,"text":"take the same exams in: Maths, Mandarin language and"},{"y":0.88953488386586266,"w":0.358024664984809,"x":0.53909466935944717,"h":0.01017441816943776,"text":"Science. The experimental class gets better results in"},{"text":"every subject.","x":0.53909465429499948,"y":0.90406976747667767,"w":0.094650200737847245,"h":0.011627906907110019},{"w":0.037037035624186199,"x":0.05967078222905918,"text":"116","h":0.013081394896215293,"y":0.9549418607641017}]
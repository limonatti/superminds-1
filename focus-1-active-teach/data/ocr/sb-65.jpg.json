[{"x":0.072016460390946502,"text":"4)) 2.40","w":0.055555555555555552,"h":0.013099649450281192,"y":0.050872093118752848},{"y":0.070324413420141729,"text":"TO THE","w":0.52383761935763895,"x":0.064551775155317986,"h":0.080184505348864343},{"y":0.1598837208899655,"w":0.5185185072157118,"h":0.069767441442660338,"text":"STARSI","x":0.08024692078955746},{"h":0.02975281516274253,"y":0.26433262141456237,"w":0.41681932237413194,"text":"Do you dream of learning more about space and","x":0.10625912301156575},{"w":0.39719251844618064,"text":"meeting some amazing scientists? Do you want","h":0.012949823023198692,"y":0.28567625083433168,"x":0.12547780823272495},{"y":0.3008720934410607,"w":0.42798353407118056,"h":0.014669508162996947,"text":"to learn new skills and make some great friends? Well,","x":0.09670782679157014},{"w":0.42592590332031249,"text":"you can do all these things and much more at Senior","x":0.098765448725646118,"y":0.31540697691599118,"h":0.013085958909015205},{"x":0.084362140515488376,"h":0.01464212633189832,"text":"5 Space School UK!","w":0.15432098388671875,"y":0.32994186095559552},{"text":"Senior Space School UK is a summer school at the","y":0.36028257487107451,"w":0.42181067572699654,"x":0.10082305377744831,"h":0.013343799058084804},{"y":0.37500000015363644,"text":"University of Leicester in England. It's for sixteen- to","w":0.42181067572699649,"x":0.100823061416337,"h":0.013147566718995307},{"y":0.38953488389273538,"text":"eighteen-year-olds and is eight days long. You do a mix","h":0.013133876177729431,"x":0.10082305370551202,"w":0.42386830647786455},{"w":0.42181067572699649,"h":0.011773940345368938,"text":"of classes and practical activities and it's a fun way to","x":0.100823061416337,"y":0.40541601271833683},{"text":"10 improve your science skills. In the evenings, you can relax","w":0.44444444444444448,"h":0.013343799058084915,"y":0.41993720593686845,"x":0.080246916255143977},{"x":0.10082304655168937,"y":0.43445839893484695,"w":0.35390947129991318,"h":0.013343799058084693,"text":"and there are quizzes, karaoke and a disco too."},{"text":"You spend three of the eight days at the university. First,","h":0.013343799058084693,"x":0.098765436302806944,"w":0.42592590332031249,"y":0.46350078458800192},{"w":0.42386830647786455,"h":0.013343799058084804,"text":"there are lectures - special classes - in Maths, Physics","x":0.10082305370551202,"y":0.47802197768893573},{"text":"and other subjects. Then, you concentrate on exciting","x":0.10082305538067191,"y":0.49254317145364945,"h":0.013343799058084804,"w":0.42181067572699649},{"x":0.080246919135802341,"h":0.014710579786794686,"y":0.50726744227827003,"text":"15 practical projects in the Science labs. For example,","w":0.44444444444444448},{"y":0.52315541565379586,"w":0.42592590332031249,"h":0.013343799058084804,"text":"you have to build a rocket using your new knowledge.","x":0.098765450500337318},{"x":0.10082305058191877,"h":0.013343799058084804,"w":0.37860080295138893,"y":0.53767660886374125,"text":"Everyone takes part and the best one wins a prize!"},{"y":0.55377906973541513,"text":"C","x":0.10288065855871757,"w":0.010288065804375551,"h":0.0087209301803325978},{"w":0.42592590332031249,"y":0.56671899536005799,"h":0.014676353059346559,"text":"In space, people and objects do not weigh anything,","x":0.098765436302806944},{"y":0.58124018813020528,"x":0.10082304861291959,"text":"so moving around is very different to Earth. Astronauts","w":0.42386830647786455,"h":0.013343799058084804},{"w":0.44238681369357635,"y":0.59733124003854687,"x":0.080246927129549145,"text":"20 practise for space-walks in water; that's why you spend","h":0.01313387617772932},{"y":0.61185243327271699,"x":0.1008230464867193,"w":0.42386830647786461,"h":0.013343799058084804,"text":"a few hours learning to scuba dive. After doing a short"},{"h":0.014365724716306261,"y":0.62602549451406964,"x":0.10070428725461308,"text":"course, you work in teams to move materials in the","w":0.42203525119357632},{"x":0.10082305370551202,"text":"correct order and build a structure - all under water. It's","y":0.64089481956047478,"w":0.42386830647786455,"h":0.011773940345368938},{"text":"a real challenge!","y":0.65541601237566349,"w":0.125514399210612,"h":0.013343799058084804,"x":0.10082304761691621},{"w":0.44238681369357641,"x":0.080246914998205188,"h":0.013099649450281081,"text":"25 On another evening you go camping. You must put up","y":0.68602825732437689},{"h":0.014683197955695948,"w":0.42592590332031255,"x":0.098765447645399213,"y":0.69897959214248773,"text":"your tent, collect wood for a fire and cook your food."},{"w":0.42181067572699649,"h":0.013127030532813055,"x":0.10082306247086371,"y":0.71507064367764928,"text":"When it's dark, you learn to identify different stars,"},{"w":0.42181067572699654,"h":0.01459420981175108,"text":"constellations (groups of stars) and other objects in the","x":0.10082305583506139,"y":0.72959183646375803},{"x":0.10082305012860072,"text":"night sky. After that, everyone has hot chocolate","w":0.3888888888888889,"y":0.74563953484586365,"h":0.011817293975566634},{"y":0.76017441880673731,"w":0.22222222222222221,"h":0.013081394896215293,"text":"30 sings around the campfire.","x":0.080246917283950489},{"y":0.51744186085229671,"h":0.01017441816943776,"x":0.55555555567805914,"w":0.010288065804375579,"text":"E"},{"w":0.36008229573567707,"y":0.53178963926551415,"h":0.013343799058084693,"text":"There's a trip to the National Space Centre to find","x":0.55555556295177733},{"x":0.55555556445212018,"y":0.54651162811511911,"text":"out about the difficulties of travelling to Mars.","h":0.013143002706195284,"w":0.36008229573567707},{"x":0.55555556295177733,"text":"There's lots to do: meeting scientists, watching","w":0.36008229573567707,"h":0.011773940345368938,"y":0.56240188381682266},{"y":0.57692307716375602,"w":0.36008229573567707,"text":"a show, exploring the centre and looking at the","h":0.013343799058084804,"x":0.55555556355191449},{"y":0.58949395091873713,"x":0.53273478118440076,"text":"35 equipment astronauts use in the International","h":0.015723165574964559,"w":0.38511996799045134},{"text":"Space Station.","y":0.60596546302998189,"w":0.11111111111111105,"x":0.55349794377572015,"h":0.011773940345368938},{"x":0.55349794979640887,"y":0.63500784913384645,"h":0.013343799058084693,"w":0.36419752332899302,"text":"If you want to learn how to fly, you can go indoor"},{"text":"skydiving. Flying like this is almost like moving in","h":0.016168632537266969,"x":0.55144033185402197,"y":0.64952904218048968,"w":0.36419752332899302},{"x":0.55349794968666932,"y":0.66405023551509534,"w":0.36419752332899302,"h":0.014913657770800559,"text":"space but it's not easy! The teacher shows you"},{"text":"40 how to move and then you get to fly. At the end","y":0.68014128711081911,"w":0.38271603054470493,"h":0.013343799058084804,"x":0.53292181533464356},{"h":0.013343799058084804,"x":0.55555556355191449,"w":0.36008229573567707,"y":0.69466248019964039,"text":"of the activity, watch as the teacher demonstrates"},{"w":0.23251027425130211,"h":0.013343799058084804,"x":0.5534979531692733,"y":0.70918367347620392,"text":"some fantastic skydiving tricks."},{"y":0.7369186047139562,"h":0.01308139564478239,"text":"Space School UK is an amazing opportunity to","w":0.36213989257812496,"x":0.55349795175620509},{"x":0.55144033248791702,"y":0.75145348878989782,"h":0.014637563067665282,"text":"learn and have fun. Book your place now!","w":0.3312757025824653},{"text":"65","x":0.90534979488600031,"y":0.95494186061875275,"w":0.024691357082790799,"h":0.013081394896215293}]
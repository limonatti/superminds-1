[{"y": 0.06196220871034102, "h": 0.029084303370451706, "x": 0.11627907121027609, "w": 0.06261180453830295, "text": "3.7"}, {"h": 0.01935972241288051, "w": 0.13785296122233073, "x": 0.23250464551891634, "y": 0.036475661916397076, "text": "WRITING"}, {"text": "An email of request", "w": 0.14669052124023438, "x": 0.23076923036378263, "h": 0.011567983089371358, "y": 0.07694945864980612}, {"h": 0.010116278651819317, "y": 0.14036337213339267, "text": "1", "x": 0.10375670866393863, "w": 0.010733451843261715}, {"y": 0.14162790744871753, "x": 0.11270125903452285, "w": 0.35420393202039935, "h": 0.012663609129427173, "text": "Complete the email with one word in each gap."}, {"w": 0.18671340942382814, "y": 0.15271875837172535, "text": "The first letters are given.", "x": 0.12490368251418064, "h": 0.015009082198573314}, {"y": 0.36158393491767005, "x": 0.10554561873447615, "w": 0.09838997734917534, "text": "To: Ben Taylor", "h": 0.011453855618673034}, {"w": 0.13595706515842015, "x": 0.10733452727767721, "text": "From: Jane Simpson", "y": 0.37925090286250335, "h": 0.01275491095622089}, {"w": 0.1252236090766059, "h": 0.01152689700522574, "x": 0.10554562047660461, "text": "Subject: Overtime", "y": 0.39691787014884994}, {"text": "Ben,", "x": 0.10486419316366491, "y": 0.41801941386677566, "h": 0.012160592053341206, "w": 0.03592456393771701}, {"text": "We have got a problem - a nice problem but we 'n", "y": 0.435000000086801, "w": 0.3291592068142361, "h": 0.013909883895075253, "x": 0.10554562150343644}, {"w": 0.06618962181939018, "y": 0.45017441876049086, "h": 0.012700130009909388, "text": "your help.", "x": 0.10554561838368594}, {"w": 0.3473573133680556, "h": 0.015694696188833734, "text": "Our new holidays are very popular and we are getting", "y": 0.4661548325607442, "x": 0.1053850745583429}, {"x": 0.10554562984534945, "w": 0.3703040907118056, "text": "hundreds of phone calls. Lots of people want information", "y": 0.4817193138527623, "h": 0.014133574007220224}, {"h": 0.013909883895075253, "text": "and our telephone sales staff can't answer them all. Could", "x": 0.10375670310511358, "y": 0.4956976745054057, "w": 0.3738819376627604}, {"h": 0.011074935477563198, "x": 0.10517177731222735, "text": "you do me a 2f", "w": 0.09546165466308595, "y": 0.5101748229118848}, {"y": 0.5095938630267379, "w": 0.09660107082790803, "x": 0.2647584993355988, "h": 0.015311371841155259, "text": "? Could you 3p"}, {"h": 0.011473318295358319, "y": 0.5108258407185748, "x": 0.42752961642729753, "text": "find ten", "w": 0.0537064192030165}, {"y": 0.5247819767946478, "h": 0.012686434773331489, "x": 0.10554563101971876, "text": "or more people to work an extra four hours every day this", "w": 0.37209299723307293}, {"y": 0.5398240072825524, "h": 0.012955776173285189, "x": 0.10375672121101123, "w": 0.3935599093967014, "text": "week, starting today? We can offer them E20 an hour for this."}, {"text": "Please *c", "x": 0.1036985358349609, "w": 0.05915033552381728, "h": 0.01291914222042485, "y": 0.5562584522694777}, {"text": "you let me know how many people want", "x": 0.2218246888134144, "w": 0.2576028611924913, "h": 0.014133574007220224, "y": 0.5574909746418977}, {"w": 0.21645796034071182, "h": 0.013909883895075349, "x": 0.10196780249959034, "y": 0.5703052324552603, "text": "the extra work before 2 p.m. I'm 5s."}, {"h": 0.013025402549371904, "x": 0.37741063349928, "y": 0.5726442751494714, "text": "not to give you", "w": 0.09669930352105038}, {"text": "more time b", "y": 0.58528563771898, "h": 0.010504305612309264, "w": 0.0823835923936632, "x": 0.10549872341992385}, {"y": 0.5867441863393426, "x": 0.2468694077491235, "text": "I need to tell Mr Collins at our meeting.", "w": 0.2450804985894097, "h": 0.01275491095622089}, {"h": 0.010116278651819317, "w": 0.01967799504597982, "text": "7T", "x": 0.10375670942393911, "y": 0.6057122094691485}, {"h": 0.010221276464014675, "text": "very much.", "x": 0.18067978362531215, "y": 0.6081362815508485, "w": 0.08050089518229167}, {"text": "Jane", "y": 0.625944767561486, "h": 0.008851743820341951, "x": 0.10196780003056767, "w": 0.032200357649061415}, {"w": 0.37593950059678816, "h": 0.014442387401842494, "x": 0.09467709896971899, "text": "2 Put the words in the correct order to make polite", "y": 0.6560751940435441}, {"x": 0.11802493599539572, "y": 0.6738335310041622, "text": "requests.", "w": 0.06627571105957032, "h": 0.009178868200804715}, {"text": "favour? / you / a / Could / me / do", "w": 0.2361359490288628, "x": 0.12880143398288524, "y": 0.6890117328723442, "h": 0.011540592616215461}, {"h": 0.010271492581074886, "w": 0.18425759209526907, "x": 0.13237925210382648, "text": "Could you do me a favour?", "y": 0.7030813953892066}, {"w": 0.3738819037543403, "text": "1 you / please? / also / for me, / think / Do / check this", "h": 0.011485811295492138, "x": 0.11627907766963985, "y": 0.7168862815137435}, {"text": "email / you could", "x": 0.13953488573026193, "h": 0.011504071361321424, "y": 0.7309011631396016, "w": 0.11806797451443143}, {"x": 0.1162790695455325, "h": 0.011389943890623196, "y": 0.7726308141253575, "w": 0.37209303114149306, "text": "2 come / early / to work / you could / Do / tomorrow /"}, {"y": 0.7863763534246376, "x": 0.13595707072028423, "text": "think / you / please?", "h": 0.014133574007220224, "w": 0.14132378472222223}, {"y": 0.8282703491300402, "w": 0.3846153767903646, "h": 0.012677304366004975, "x": 0.1144901601066067, "text": "3 Could / before 4 p.m.? / comments and suggestions /"}, {"x": 0.13595706788889855, "w": 0.26654739379882814, "text": "send it / with your / you please / to me", "h": 0.010257797344496987, "y": 0.8433032490003081}, {"w": 0.406082288953993, "x": 0.5402504442677859, "y": 0.05300090238820525, "text": "3 Complete the email with the requests from Exercise 2", "h": 0.011490376499155346}, {"h": 0.011554287852793362, "text": "Hi Sandra,", "y": 0.09484011650152026, "w": 0.06976743910047745, "x": 0.5491949931331244}, {"y": 0.10992779800995937, "w": 0.3220035807291667, "h": 0.015311371841155259, "x": 0.5456171733205686, "text": "I've got a problem. Could you do me a favour?"}, {"h": 0.012681869195256459, "w": 0.3363148328993055, "text": "I need some help with the new computer program.", "y": 0.1264169677528283, "x": 0.5456171852498105}, {"w": 0.3237924872504341, "h": 0.013928143960904539, "x": 0.5474060851941032, "text": "Mr Bryant wants to have it by tomorrow morning.", "y": 0.14036337199330537}, {"h": 0.011449290415009824, "x": 0.7996422220347849, "text": ".? I think we can finish", "y": 0.15546931411486528, "w": 0.14311269124348958}, {"text": "it before 9 p.m. today.?", "w": 0.15563505384657117, "y": 0.16685469345924162, "x": 0.5456171792484497, "h": 0.015311371841155259}, {"text": "I want to send it to Mr Bryant but it has to be perfect.", "y": 0.1833438627847165, "x": 0.5456171661330611, "w": 0.34883721245659727, "h": 0.011394509094286501}, {"w": 0.1359570651584202, "h": 0.011508636564984633, "text": "? Thanks a lot. I hate", "y": 0.19853197709309003, "x": 0.7906976762579991}, {"w": 0.3631484646267361, "h": 0.012690999602582971, "y": 0.21239620939637394, "text": "writing official letters and it's nice to have your opinion", "x": 0.545617183950794}, {"w": 0.11091233995225691, "x": 0.5456171762671631, "h": 0.015311371841155162, "y": 0.22495938634936719, "text": "One last thing. 4."}, {"text": "Mr Bryant is coming at 9 a.m. and I want to make sure that", "y": 0.2414485558393291, "w": 0.37924865722656254, "h": 0.012722955653813801, "x": 0.5456171729251804}, {"y": 0.2554360465636542, "h": 0.013909883895075253, "w": 0.3595706515842013, "text": "everything is working OK. Can you be here by 7.30 a.m.?", "x": 0.545617180880529}, {"x": 0.5438282692078701, "h": 0.013932709538979664, "text": "I'll get some breakfast for us.", "y": 0.26932310448893587, "w": 0.19320214165581595}, {"text": "?", "x": 0.9338103759165302, "w": 0.008944543202718092, "y": 0.16944767449081016, "h": 0.008851743820341951}, {"h": 0.012109099940702852, "w": 0.08962534586588533, "y": 0.29680155468750397, "text": "Thanks a lot.", "x": 0.5437383120851299}, {"y": 0.31099844031893914, "text": "Helen", "x": 0.5455746693238147, "h": 0.011535095875874372, "w": 0.04122990926106784}, {"x": 0.5474060817879884, "w": 0.23971377902560764, "y": 0.35648014433239816, "h": 0.011499506532069942, "text": "SHOW WHAT YOU'VE LEARNT"}, {"w": 0.38103756374782993, "y": 0.3831540699551176, "x": 0.5402504536582853, "h": 0.011408204330864402, "text": "4 Imagine that you run a restaurant and one day you"}, {"y": 0.39691786987454714, "h": 0.011526897379637658, "w": 0.35778174506293403, "text": "cannot come to work. It just happens that on that", "x": 0.5563506256796243}, {"y": 0.41097383742332266, "x": 0.5581395552486494, "w": 0.3738819037543403, "h": 0.011462985651587725, "text": "day health inspectors are to inspect your restaurant."}, {"h": 0.012649913144025533, "y": 0.423614621267722, "x": 0.5581395351012106, "w": 0.35778174506293403, "text": "On top of this, two new waiters are going to start"}, {"text": "work. Write an email to the head waiter/waitress.", "y": 0.4387936049233636, "h": 0.010116278651819317, "w": 0.35599283854166663, "x": 0.5563506245797929}, {"h": 0.011417334363778996, "text": "In your email:", "y": 0.4526669676476731, "x": 0.5545617190137141, "w": 0.10196779886881513}, {"h": 0.011540592616215461, "x": 0.5563506308363438, "text": "• explain the situation.", "w": 0.16636850992838548, "y": 0.471511732682664}, {"x": 0.5544541699609421, "h": 0.013877065947770275, "text": "• ask him/her to check that it's clean in the restaurant,", "y": 0.484388583406722, "w": 0.37951717800564233}, {"text": "to train the new waiters and to buy fresh food", "x": 0.5778175417169351, "h": 0.0127503461269696, "w": 0.31127010769314245, "y": 0.499386281645243}, {"w": 0.06618962181939025, "text": "products.", "x": 0.5796064424296011, "h": 0.01138081348329678, "y": 0.5146656978884387}, {"w": 0.34704830593532987, "x": 0.5545617126852868, "y": 0.528438628383897, "text": "• apologise for asking him/her to do all this work.", "h": 0.012955776173285189}, {"text": "• thank him/her for his/her efforts.", "w": 0.24508049858940972, "h": 0.01138537906137181, "x": 0.5545617225896122, "y": 0.5437499999239107}, {"w": 0.2504472181532118, "h": 0.012672739536753685, "text": "SHOW THAT YOU'VE CHECKED", "x": 0.5402504542507645, "y": 0.5841877252677264}, {"w": 0.2665473937988281, "x": 0.5384615413608723, "text": "Finished? Always check your writing.", "y": 0.6093140796316282, "h": 0.014133574007220224}, {"text": "Can you tick / everything on this list?", "y": 0.6234156976189594, "w": 0.2701252237955729, "h": 0.013909883895075349, "x": 0.5384615361195064}, {"w": 0.08951484680175781, "h": 0.01289273270631095, "text": "In my email:", "x": 0.5366379253654747, "y": 0.6485827035409368}, {"y": 0.6670569366759369, "text": "• I have started the email with an appropriate", "x": 0.540094436445832, "w": 0.32231275770399304, "h": 0.01528327073431184}, {"text": "greeting, e.g. Greg, Hi Monica, etc.", "x": 0.5635062653967083, "y": 0.6827301440576499, "w": 0.24508049858940972, "h": 0.014133574007220224}, {"x": 0.5384615352674698, "text": "• I have explained the situation.", "y": 0.7043231048920225, "w": 0.23076922946506073, "h": 0.01266817395867856}, {"x": 0.5384615467722115, "text": "• I have listed all my requests in a clear", "h": 0.011481246091828833, "w": 0.2790697564019097, "y": 0.7282716605865928}, {"text": "and kind way.", "x": 0.5616279560657661, "y": 0.7419250554053969, "w": 0.09856877644856776, "h": 0.013359191460729938}, {"text": "• I have mentioned my expectations.", "h": 0.012695565180658001, "x": 0.5384615409766044, "y": 0.7650436047543134, "w": 0.2647584872775608}, {"w": 0.33273701985677084, "x": 0.5366726325965315, "h": 0.014133574007220224, "text": "• I have apologised for the whole situation and", "y": 0.7863763540628144}, {"x": 0.5617173634122637, "y": 0.8004505816987176, "text": "expressed my thanks for helping me.", "h": 0.012645348314774147, "w": 0.2540250311957466}, {"x": 0.5384615406307475, "y": 0.8205324909676842, "w": 0.18962432861328127, "h": 0.010266927377411581, "text": "• I have used contractions"}, {"y": 0.8345930234917409, "w": 0.16994632297092005, "h": 0.012645348314774147, "x": 0.5581395414662395, "text": "(e.g. I'm / aren't / that's)."}, {"h": 0.012732085312316574, "text": "• I have checked my spelling", "x": 0.5366726370689722, "y": 0.8560901165149966, "w": 0.21109122382269963}, {"x": 0.9051878350219661, "y": 0.7625145350707285, "text": "O", "w": 0.021466905805799685, "h": 0.015174417977728975}, {"x": 0.11316872891489045, "y": 0.8837209303037123, "text": "4 until / you / at work / this evening? / stay / 7 p.m. / Could", "h": 0.01162790690711013, "w": 0.3827160305447049}, {"y": 0.9345930232179568, "h": 0.01162790690711002, "x": 0.09670781884393467, "text": "44", "w": 0.022633745405409078}, {"x": 0.5370370427989902, "y": 0.8793604649572976, "h": 0.01162790690711002, "w": 0.19547324286566836, "text": "• My text is neat and clear."}]
3179475, "h": 0.010207581227436775, "w": 0.10733452690972223, "text": "B don't have to"}, {"x": 0.8282647574911841, "y": 0.3274277977628919, "text": "C must", "w": 0.060822898017035554, "h": 0.010207581227436872}, {"y": 0.34774709313234353, "x": 0.5545617171859406, "h": 0.008851743820341854, "w": 0.01252236154344355, "text": "*"}, {"text": "*", "w": 0.012522361543443439, "x": 0.5742397135932158, "y": 0.34774709311759067, "h": 0.008851743820341854}, {"text": "Complete the dialogues with the phrases", "x": 0.613595706361933, "h": 0.01265904355135195, "y": 0.3477470934425403, "w": 0.2969588555230035}, {"y": 0.3615839352025107, "x": 0.5545617210661961, "text": "from the box. There are three extra phrases.", "h": 0.011453855244261308, "w": 0.3237924872504341}, {"y": 0.38694767450540557, "w": 0.32915920681423605, "text": "don't have to speak don't have to wait must be", "x": 0.5688729891241879, "h": 0.013909883895075349}, {"text": "must say should get should go should l do", "y": 0.40084386308830244, "w": 0.3202146742078993, "h": 0.012659043551352143, "x": 0.5688729881017748}, {"y": 0.4134070394110381, "h": 0.014133574007220224, "text": "should 1 go should I say shouldn't look should sit", "w": 0.35957065158420143, "x": 0.5688729956300818}, {"text": "shouldn't wait should wait should look", "x": 0.5688729912799142, "y": 0.4286773259587513, "h": 0.011426464771105508, "w": 0.28085866292317707}, {"y": 0.45266696772121495, "text": "Ms L.: Cathy, your turn.", "h": 0.012681869195256459, "w": 0.16815741644965287, "x": 0.552772814449592}, {"text": "C:", "x": 0.5545617178630636, "w": 0.030411449008517777, "y": 0.46661337225480004, "h": 0.008851743820341951}, {"x": 0.6028622530806848, "y": 0.46523014474851576, "w": 0.3452593994140625, "h": 0.014133574007220224, "text": "This is from Romeo and Juliet. 'A rose by any other"}, {"w": 0.19499104817708335, "text": "name would smell as sweet.'", "x": 0.6028622556669742, "y": 0.4792587213550087, "h": 0.011490376124743525}, {"h": 0.012955776173285286, "w": 0.31305901421440974, "x": 0.5527728210830158, "y": 0.49428249065394597, "text": "Ms L.: You must say it louder. I can't hear you."}, {"y": 0.5222529071328065, "h": 0.01138081348329678, "x": 0.5527728095208383, "w": 0.01967799504597989, "text": "C:"}, {"text": "And you'-", "w": 0.13061767578124994, "x": 0.599351827189498, "h": 0.03189416095237865, "y": 0.4989416089589419}, {"h": 0.011545157445466945, "y": 0.5070784886862223, "text": "at us, not at the floor.", "x": 0.7924865790224486, "w": 0.144901614718967}, {"y": 0.520988372186527, "x": 0.6028622544496248, "w": 0.008944543202718092, "h": 0.0075872089888644875, "text": "2"}, {"w": 0.06618962181939014, "y": 0.5221570397487905, "text": "_ it again?", "x": 0.7245080518959102, "h": 0.012741215719643087}, {"y": 0.5361627909336013, "x": 0.5527728112802417, "w": 0.130590337117513, "text": "Ms L.: Yes, please.", "h": 0.012690999602582876}, {"w": 0.021466903686523375, "x": 0.5527728096057544, "text": "C:", "y": 0.5500726746062804, "h": 0.01138081348329678}, {"w": 0.343470458984375, "h": 0.012645348314774147, "x": 0.6028622617421595, "text": "Er... er ...'A sweet by any other name would smell", "y": 0.5488081398593281}, {"text": "like a rose.'", "x": 0.5992191730475827, "y": 0.5625025478689915, "h": 0.01307629934717179, "w": 0.08242033216688371}, {"text": "Ms L.: Stop, stop. I think you 3", "y": 0.5753633722168041, "w": 0.20572450425889766, "h": 0.015174417977728975, "x": 0.5509839040646477}, {"w": 0.06273005591498482, "y": 0.5764802047056646, "h": 0.0129407532722942, "text": "for a few", "x": 0.8729283537057008}, {"w": 0.33273701985677084, "h": 0.011536027412552254, "text": "minutes. You're very nervous. Melanie, you go next.", "y": 0.5916471118661601, "x": 0.6010733560823478}, {"x": 0.7638640433266847, "w": 0.021466903686523375, "text": "***", "y": 0.6069767443798821, "h": 0.006322674157387025}, {"h": 0.011380813483296684, "text": "C:", "x": 0.5509839005447075, "y": 0.6183575582955974, "w": 0.03756708357069227}, {"h": 0.017975643120087415, "x": 0.5882954531520357, "text": "I feel terrible, Damien. What\"", "w": 0.21533966064453125, "y": 0.6148428723723516}, {"y": 0.6170930233859772, "w": 0.008944543202718092, "x": 0.9248658322298873, "h": 0.008851743820341951, "text": "?"}, {"h": 0.012741215719642991, "y": 0.6309070398752441, "x": 0.7280858647333117, "text": "home and forget about the", "w": 0.18962432861328127}, {"y": 0.6588226747304036, "h": 0.012645348314774242, "x": 0.5491949905764706, "text": "D:", "w": 0.023255814446343392}, {"y": 0.7169912792155148, "h": 0.010116278651819317, "x": 0.5509839007551853, "w": 0.01967799504597989, "text": "C:"}, {"text": "school play?", "x": 0.5991820050853527, "w": 0.08965030246310757, "h": 0.014582920642536018, "y": 0.6445762721029018}, {"text": "No, you shouldn't, Cathy. You•", "x": 0.601073354081147, "w": 0.21288013034396702, "h": 0.015357023128963988, "y": 0.6575581396586646}, {"w": 0.32915920681423616, "h": 0.011481245717417108, "x": 0.6010733521086837, "y": 0.6739970934480318, "text": "here with me and watch the others. Look, they're"}, {"h": 0.013909883895075349, "x": 0.6010733511664875, "y": 0.6866424416342938, "text": "making mistakes too. You?", "w": 0.18246868557400175}, {"text": "again", "y": 0.6879069767896016, "h": 0.011380813483296684, "w": 0.03935599009195956, "x": 0.9033989282694646}, {"y": 0.7003971121400174, "x": 0.597495526656536, "text": "today. Ask Ms Lee if you can do it on Thursday.", "w": 0.3237924872504341, "h": 0.014133574007220224}, {"h": 0.013909883895075253, "w": 0.046511628892686674, "text": "No, 18", "x": 0.5992844361082184, "y": 0.7144622093543519}, {"h": 0.0075872089888644875, "text": "19", "x": 0.7745974955907162, "y": 0.7144622093326026, "w": 0.016100178824530742}, {"text": "brave and try again now. It's like falling off a horse.", "y": 0.7280645106549676, "h": 0.014616610220623374, "x": 0.6009909781256277, "w": 0.34004645453559024}, {"w": 0.041144900851779465, "h": 0.010244101733507266, "x": 0.6010733453446189, "text": "You 10", "y": 0.7435465118910753}, {"x": 0.7620751332666346, "y": 0.7435465118385433, "text": "back on immediately.", "w": 0.144901614718967, "h": 0.012645348314774147}, {"text": "The only problem is ... doing this is worse than", "w": 0.31305901421440974, "x": 0.6010733582774104, "y": 0.7573240072488315, "h": 0.012955776173285286}, {"h": 0.013909883895075253, "w": 0.1252236090766059, "x": 0.5974955284223411, "text": "falling off a horse!", "y": 0.771366279030115}, {"w": 0.24150268554687504, "text": "SHOW WHAT YOU'VE LEARNT", "h": 0.011485811295492138, "x": 0.09838998274406824, "y": 0.7941279071486131}, {"text": "5 Complete the sentences with the correct form of the modal verbs. Do not use the words in brackets.", "x": 0.08944543256884667, "h": 0.012759476534296018, "y": 0.8156250003117989, "w": 0.704830050998264}, {"x": 0.1270125372144267, "h": 0.01649830008241671, "y": 0.8307400719743054, "w": 0.7459749348958333, "text": "You shouldn't go to university just because your parents think it's a good idea. Do what is best for you. (don't)"}, {"y": 0.8472292419418681, "x": 0.10733452628733839, "text": "1 We", "h": 0.011389943890623196, "w": 0.07692307366265191}, {"y": 0.8459738373862175, "w": 0.522361348470052, "h": 0.012645348314774147, "x": 0.26833632910427, "text": "finish our project tonight. We can give it to our teacher next Monday. (must)"}, {"x": 0.10375670855738033, "w": 0.01431127018398709, "text": "2", "h": 0.006322674157387121, "y": 0.8624127907808632}, {"w": 0.6565295410156251, "x": 0.2450804887972769, "y": 0.8609702167708704, "text": "tell my narents where I'm aoing and who I'm aoing with but I alwavs tell them anwav (should)", "h": 0.007851985559566706}, {"h": 0.008720930180332487, "text": "4", "y": 0.8895348836598339, "x": 0.10699588469040483, "w": 0.010288065804375537}, {"x": 0.10699588489616614, "y": 0.9171511629621594, "w": 0.010288065804375551, "h": 0.008720930180332487, "text": "6"}, {"text": "You", "y": 0.8750000000904266, "w": 0.02880658467610675, "h": 0.01017441816943776, "x": 0.12962962916400425}, {"text": "You", "y": 0.8895348836985933, "w": 0.028806582556830496, "h": 0.008720930180332598, "x": 0.12962963101239408}, {"text": "Dan, you", "x": 0.13168724474733454, "h": 0.01162790690711013, "y": 0.9026162790319101, "w": 0.061728392706977}, {"x": 0.12962963005410277, "y": 0.9171511627586711, "h": 0.008720930180332487, "text": "You", "w": 0.026748970879448775}, {"text": "start doing your homework soon. It's getting late. (must)", "w": 0.38683125813802083, "y": 0.8750000003898284, "h": 0.013147565970428321, "x": 0.2695473356429237}, {"w": 0.3086419677734375, "text": "write in this book. It's a library book. (should)", "x": 0.2695473237264501, "y": 0.8895348840112112, "h": 0.01017441816943776}, {"x": 0.30452674992203593, "y": 0.9026162791530341, "text": "feed your cat only twice a day. It's really very fat. (should)", "w": 0.39506171332465284, "h": 0.01162790690711002}, {"x": 0.2716049594699099, "text": "do all the housework. Ask your children to help you. (don't)", "y": 0.9171511627286155, "w": 0.40534976535373257, "h": 0.011812730337050104}, {"x": 0.9012345677690127, "w": 0.020576131608751158, "h": 0.010174418169437871, "y": 0.9142441863246802, "text": "16"}, {"h": 0.013143002706195395, "y": 0.9403453692331913, "x": 0.584362142606136, "w": 0.2962962849934896, "text": "GRAMMAR: Train and Try Again page 132"}, {"y": 0.9491279070842356, "w": 0.0246913570827908, "h": 0.01162790690711002, "text": "62", "x": 0.088477366520333}]
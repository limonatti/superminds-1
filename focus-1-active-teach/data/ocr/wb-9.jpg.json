6628960497}, {"text": "Stan:", "y": 0.49190406984996243, "w": 0.03935599009195967, "h": 0.010116278651819317, "x": 0.5384615393905139}, {"w": 0.03424446317884666, "y": 0.5207705091018723, "h": 0.01055200493292693, "text": "Mel:", "x": 0.5383339404306435}, {"w": 0.0430983013576931, "h": 0.011757543689507363, "text": "Stan:", "y": 0.5352650553182481, "x": 0.5356086678618527}, {"x": 0.534883721340772, "w": 0.03756708357069227, "text": "Mel:", "y": 0.5766279070798949, "h": 0.012645348314774147}, {"h": 0.011701846931815547, "text": "Stan:", "x": 0.5347958324261991, "y": 0.6055516927022984, "w": 0.04132067786322702}, {"h": 0.01138081348329678, "x": 0.5348837222886603, "text": "Mel:", "w": 0.035778172810872366, "y": 0.6335319768654737}, {"y": 0.6485904352646739, "w": 0.03945926666259758, "x": 0.5366209932781418, "h": 0.00908366425373069, "text": "Stan:"}, {"h": 0.01138081348329678, "y": 0.6765261629878575, "x": 0.5348837225391075, "text": "Mel:", "w": 0.03577817281087248}, {"y": 0.6915091103021915, "h": 0.009234686267935405, "x": 0.5365880321740957, "text": "Stan:", "w": 0.039525188869900085}, {"y": 0.7195203490169817, "h": 0.01138081348329678, "x": 0.5348837212715659, "w": 0.03398926628960508, "text": "Mel:"}, {"text": "Stan:", "x": 0.533094812168028, "w": 0.041144900851779465, "h": 0.01138081348329678, "y": 0.7473401164003575}, {"text": "Mel:", "x": 0.53488372117094, "w": 0.03398926628960508, "h": 0.011380813483296684, "y": 0.7751598838137659}, {"w": 0.289803229437934, "h": 0.014133574007220128, "x": 0.6046511617121599, "y": 0.4601263539837811, "text": "Tonight there is a party at Stan's house..."}, {"h": 0.012754910956220987, "x": 0.5921288035908623, "y": 0.47799418623547, "text": "Hi, Stan. Happy birthday!", "w": 0.17710196601019967}, {"text": "Thanks, Mel. Hey, everyone, '_", "y": 0.4906395350075018, "h": 0.015174417977728975, "w": 0.22182467990451382, "x": 0.592128807185489}, {"y": 0.5070784886352614, "x": 0.590339892949808, "text": "is Mel.", "w": 0.04830053541395407, "h": 0.010116278651819414}, {"h": 0.011389943890623293, "w": 0.041144900851779465, "text": "Er, hi.", "x": 0.592128801792357, "y": 0.5209792420346007}, {"h": 0.008851743820341951, "text": "2", "x": 0.5903398928998992, "y": 0.5336337210656648, "w": 0.016100178824530742}, {"text": "console and 3", "y": 0.54880813982816, "h": 0.010253232140833683, "x": 0.5921288010797848, "w": 0.09660107082790803}, {"w": 0.23434704250759542, "h": 0.011558852682044748, "x": 0.6905187887819805, "text": "is Max over there with the games", "y": 0.5347202167870745}, {"x": 0.7799642250628598, "y": 0.5512093863874605, "text": "are my games.", "w": 0.10375670539008253, "h": 0.010244101733507266}, {"text": "He loves video games.", "w": 0.15563505384657117, "x": 0.5939177161357485, "y": 0.5625947652005373, "h": 0.011504071735733246}, {"x": 0.5917432756562938, "y": 0.5733834980918977, "text": "Oh, I see. And who are *", "w": 0.1725964016384549, "h": 0.01896156237013505}, {"text": "people", "h": 0.012645348314774147, "x": 0.8533094815104942, "w": 0.05366726345486106, "y": 0.5778924420458105}, {"h": 0.010207581227436872, "y": 0.5904693141807427, "x": 0.5921288020627699, "text": "on the sofa?", "w": 0.08765652974446614}, {"x": 0.5903398902977517, "y": 0.6044476743789521, "text": "Oh, they're my cousins - Jeff and Tina.", "w": 0.2719141303168403, "h": 0.013909883895075349}, {"w": 0.04651162889268656, "x": 0.5903398924588444, "text": "They 5", "h": 0.013923579131653152, "y": 0.6183438626767856}, {"y": 0.619521660628744, "text": "new smartphones.", "x": 0.7298747818850226, "w": 0.1270125155978732, "h": 0.011481246091828833}, {"x": 0.5903398936602773, "text": "And who is the girl with the digital camera?", "y": 0.6335319767203402, "w": 0.3023255750868056, "h": 0.013909883895075253}, {"w": 0.32737030029296876, "h": 0.012955776173285189, "text": "That's Amanda. She likes photography, but she", "x": 0.5903398969145941, "y": 0.6485740072524445}, {"x": 0.5903398930676929, "y": 0.6613517445164279, "text": "6", "w": 0.008944543202718092, "h": 0.008851743820341951}, {"y": 0.6608575309755697, "text": "a camera. It's my camera", "x": 0.6902378756923954, "h": 0.01451546959928655, "w": 0.17231346978081608}, {"y": 0.6764485556285732, "h": 0.012722955653813801, "x": 0.5903399005110308, "w": 0.2790697564019098, "text": "And what about the girl with the tablet?"}, {"h": 0.014133574007220224, "text": "That's my friend Carly. She?", "w": 0.19677995469835063, "x": 0.5903398988583382, "y": 0.6890117326664118}, {"x": 0.8765652952362921, "h": 0.010116278651819317, "w": 0.03220035764906137, "text": "take", "y": 0.6904360465519972}, {"x": 0.5903398962387204, "w": 0.14311269124348958, "y": 0.7043231046711743, "h": 0.010207581227436872, "text": "videos on the tablet."}, {"text": "Cool. ... Well, it's nice to see you Stan, but", "x": 0.5903398955390349, "h": 0.014133574007220224, "y": 0.7180640796316282, "w": 0.2969588555230035}, {"y": 0.735959302483974, "text": "stay.", "x": 0.6976744190734444, "w": 0.03398926628960508, "h": 0.010116278651819317}, {"text": "Oh, please stay!?", "w": 0.1252236090766059, "h": 0.015311371841155259, "x": 0.5885509872327167, "y": 0.7459386284424632}, {"text": "nice snacks", "x": 0.805008945044513, "y": 0.7473401163194391, "w": 0.08050089518229164, "h": 0.010116278651819414}, {"text": "in the kitchen.", "x": 0.5867620753461036, "y": 0.7624277977942826, "h": 0.011467550855250933, "w": 0.10375670539008253}, {"text": "Sorry, I 10", "x": 0.5885509848374075, "y": 0.7749909751030398, "h": 0.014133574007220224, "w": 0.06797853257921005}, {"x": 0.7471963850488619, "w": 0.13343657599555114, "y": 0.7732416080706107, "h": 0.016479514342352786, "text": "time. See you later."}, {"h": 0.01162790690711013, "text": "10", "x": 0.0679012352857651, "y": 0.9360465116045845, "w": 0.0246913570827908}]
[{"h": 0.020415162454873646, "w": 0.2826475863986545, "x": 0.13953488502709746, "text": "EXAM SPEAKING", "y": 0.006281588323801081}, {"w": 0.3112701076931424, "text": "1 In pairs, ask and answer the questions.", "h": 0.012645348314774147, "x": 0.08944545223571844, "y": 0.0682848839821478}, {"text": "PART 1", "x": 0.11091234450232533, "h": 0.010212146056688161, "y": 0.08715703971762263, "w": 0.048300535413953974}, {"x": 0.10912343666877171, "h": 0.014133574007220224, "y": 0.10364620910604165, "w": 0.17531305948893228, "text": "Talk about your family."}, {"y": 0.11760174434776346, "x": 0.10912343422163448, "text": "1 How big is your family?", "h": 0.015174417977728975, "w": 0.19141323513454864}, {"y": 0.13269855562857333, "w": 0.2898031955295139, "h": 0.012722955653813704, "x": 0.11091236055366867, "text": "2 Have you got any brothers or sisters?"}, {"x": 0.11091234369381091, "w": 0.008944543202718092, "text": "3", "h": 0.008851743820341951, "y": 0.1466860465469511}, {"w": 0.23076922946506076, "x": 0.12522361600688517, "y": 0.14668604656208967, "text": "What are your parents' names?", "h": 0.012709260417235902}, {"h": 0.015937577154662232, "text": "4 How many rooms are there in your house or flat?", "y": 0.16052094059216726, "w": 0.37238518608940974, "x": 0.10895534885198571}, {"y": 0.17577034898196814, "w": 0.32737030029296876, "h": 0.013909883895075253, "x": 0.11091234821368251, "text": "5 What furniture have you got in your room?"}, {"h": 0.014133574007220224, "w": 0.391771002875434, "text": "2 Look at the photos that show free time activities.", "y": 0.2010108303201406, "x": 0.08407872430468002}, {"w": 0.04841580708821615, "h": 0.010394471147860953, "x": 0.1072768903296225, "text": "PART 1", "y": 0.2211545086776617}, {"h": 0.013909883895075349, "x": 0.10733452633650852, "text": "Which of these activities do you do? Discuss in pairs.", "y": 0.2389970929256455, "w": 0.40071556939019093}, {"text": "PART 2", "w": 0.050089446173773866, "y": 0.08833483746099795, "x": 0.5635062606340433, "h": 0.011563418260119874}, {"text": "Talk about your day.", "y": 0.10622093045500855, "x": 0.5652951747452193, "w": 0.15384614732530388, "h": 0.011558853056456667}, {"w": 0.30590338812934026, "h": 0.013909883895075253, "text": "1 What things do you do every morning?", "y": 0.12013081369254236, "x": 0.5635062628002675}, {"w": 0.275491943359375, "h": 0.012704694839160775, "y": 0.13530523297742394, "text": "2 Who wakes you up in the morning?", "x": 0.5652951764419583}, {"w": 0.22003577338324654, "x": 0.5635062663271603, "h": 0.013937274368231051, "y": 0.14918772560819465, "text": "3 How do you get to school?"}, {"text": "4 What do you do after school?", "y": 0.16312500041928446, "w": 0.23613594902886292, "h": 0.012759475785472277, "x": 0.5652951734283235}, {"y": 0.17829941872427676, "h": 0.008851743820341854, "w": 0.017889086405436183, "text": "5", "x": 0.5652951708700309}, {"x": 0.5849731670389464, "h": 0.015338762314311059, "text": "What time do you fall asleep?", "y": 0.1770348838826471, "w": 0.21645796034071174}, {"text": "PART 2", "x": 0.10196780083059007, "w": 0.04830053541395399, "y": 0.6044476747121037, "h": 0.008851743820341951}, {"h": 0.011504071735733342, "w": 0.2969588555230035, "y": 0.6221511630099867, "text": "In pairs, ask and answer the questions.", "x": 0.10017889437624414}, {"y": 0.6360108300650286, "text": "1 Do you think listening to music is fun?", "x": 0.10196779799053483, "h": 0.012695565180658001, "w": 0.29338104248046876}, {"x": 0.1215667431068254, "w": 0.11643717447916667, "y": 0.6496331074982549, "h": 0.014585529544293234, "text": "Why?/Why not?"}, {"w": 0.289803229437934, "y": 0.6650631767209446, "x": 0.09838997866207051, "h": 0.014133574007220224, "text": "2 Do you like reading? Why?/Why not?"}, {"y": 0.679055232977424, "h": 0.012704694839160872, "w": 0.30769229465060766, "text": "3 Do you like spending time with friends?", "x": 0.10017889793408793}, {"y": 0.6928577753438596, "x": 0.12162025870375041, "w": 0.11633014255099826, "h": 0.014124565658156132, "text": "Why?/Why not?"}, {"h": 0.015174417977728975, "y": 0.7068750002502343, "x": 0.09838998384738251, "w": 0.35062611897786455, "text": "4 Do you enjoy playing sports? Why?/Why not?"}, {"text": "5 Do you prefer listening to music or playing music?", "y": 0.6360108305183486, "h": 0.015311371841155259, "w": 0.3828264702690972, "x": 0.5545617179513189}, {"h": 0.013909883895075253, "text": "Why?", "y": 0.6512354651683053, "x": 0.5778175309026082, "w": 0.04293381161159937}, {"h": 0.015311371841155259, "x": 0.554561715466345, "text": "6 Do you prefer playing sports or playing video", "w": 0.35062611897786455, "y": 0.6650631768306352}, {"x": 0.5778175306529773, "text": "games? Why?", "y": 0.6803197677152371, "w": 0.10017889234754773, "h": 0.012645348314774147}, {"y": 0.6941155231096464, "w": 0.3935599093967014, "h": 0.012759476534296018, "x": 0.554561731795388, "text": "7 Which of these free time activities do you like best?"}, {"h": 0.013909883895075253, "x": 0.5760286243546215, "y": 0.7081395346227748, "text": "Why?", "w": 0.04293380737304686}, {"y": 0.7334071743214852, "x": 0.0750729339436004, "w": 0.6494919162326389, "h": 0.014814395525825629, "text": "3 Read the instructions on your card. In pairs, take turns to role-play the conversation."}, {"x": 0.1233980855168264, "h": 0.010398030306888384, "text": "Student A", "y": 0.7636381943169376, "w": 0.0769963158501519}, {"x": 0.5526678070782269, "w": 0.07534417046440967, "h": 0.012094193856208395, "text": "Student B", "y": 0.764686914845452}, {"w": 0.23434704250759547, "x": 0.12343471065586231, "text": "This is your survey about films.", "y": 0.787805232819357, "h": 0.012704694839160775}, {"y": 0.8028655236001966, "x": 0.1234347055754712, "w": 0.22182467990451388, "h": 0.01149494132840683, "text": "Ask Student B the questions."}, {"h": 0.01495397701160146, "y": 0.8188965574936632, "w": 0.09867504543728298, "text": "• Say hello.", "x": 0.11971435576373046}, {"h": 0.012645348314774242, "text": "• Ask if he/she likes watching films.", "y": 0.8345930235170316, "w": 0.2647584872775608, "x": 0.12164580549658024}, {"x": 0.11985689172887855, "text": "• Ask what sort of films he/she likes.", "h": 0.012741215719643087, "w": 0.2719141303168403, "y": 0.8484070398647061}, {"text": "Answer Student A's questions for", "y": 0.7890697677243763, "h": 0.011440160007683409, "x": 0.554561719840757, "w": 0.2522361246744791}, {"x": 0.5545617224099983, "y": 0.8028655233625532, "w": 0.15742396036783857, "h": 0.012955776173285189, "text": "a survey about films."}, {"text": "• Say if you like watching films.", "x": 0.5509839050610502, "h": 0.014133574007220128, "y": 0.8205324910839853, "w": 0.23434704250759553}, {"x": 0.5509838996843929, "text": "•", "w": 0.014311270183987146, "y": 0.8358575582338699, "h": 0.008851743820341951}, {"h": 0.013909883895075253, "x": 0.5652951666139711, "text": "Say what kind of films you like.", "y": 0.8345930232161615, "w": 0.22898032294379345}, {"x": 0.5527728128027907, "w": 0.24508049858940972, "text": "• Say who your favourite actor is", "y": 0.848407039833093, "h": 0.012741215719642991}, {"w": 0.246913570827908, "h": 0.011773940345368938, "text": "Ask what his/her favourite film is.", "y": 0.8763736262233491, "x": 0.13580247418824076}, {"h": 0.01648863219017138, "x": 0.12119074243048267, "w": 0.3296608479817708, "y": 0.8895364948470744, "text": "• Ask how often he/she goes to the cinema."}, {"y": 0.905416012579152, "w": 0.31687242296006946, "x": 0.12139918263519156, "h": 0.013343799058084693, "text": "• Say thank you and end the conversation."}, {"x": 0.5514403409264749, "y": 0.876373626425852, "w": 0.2880658298068577, "h": 0.014614745249366456, "text": "• Say how often you go to the cinema."}, {"text": "21", "w": 0.0246913570827908, "x": 0.9197530871993453, "y": 0.956395348799352, "h": 0.01162790690711013}]
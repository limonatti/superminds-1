[{"h": 0.01896802322098491, "w": 0.21824686686197917, "x": 0.07692308023627334, "text": "WRITING BANK", "y": 0.022761628114071515}, {"w": 0.30948120117187494, "text": "Making requests and enquiries", "h": 0.016489169675090294, "x": 0.08228981344208873, "y": 0.09736462115081781}, {"text": "Informal phrases", "x": 0.0787119836423054, "h": 0.015174417977728975, "y": 0.12392441906985648, "w": 0.144901614718967}, {"x": 0.08050089552001219, "h": 0.016502864911668098, "y": 0.142892442031123, "w": 0.35062611897786455, "text": "Can you ..., please? / Could you please ...?"}, {"y": 0.1707122092310598, "x": 0.08050089706063122, "text": "Let me know if you can (come).", "h": 0.013909883895075253, "w": 0.2558139546712239}, {"y": 0.19708483741840135, "w": 0.17889087253146702, "h": 0.014133574007220224, "x": 0.07871198546950804, "text": "Could you tell me ...?"}, {"x": 0.07871198795471981, "w": 0.2218246799045139, "text": "Could you do me a favour?", "h": 0.015311371841155259, "y": 0.22378158846318857}, {"w": 0.16457960340711808, "x": 0.07871198823382915, "y": 0.2516424417022626, "text": "Could you help me?", "h": 0.013909883895075253}, {"h": 0.013909883895075349, "text": "Do you think you could ...?", "y": 0.2794622092531891, "w": 0.22540249294704862, "x": 0.07692308043166356}, {"y": 0.30728197677302926, "w": 0.15384614732530383, "h": 0.013909883895075253, "x": 0.07692307994498075, "text": "Could you also ...?"}, {"h": 0.012727520483065188, "w": 0.12880143059624566, "text": "Formal phrases", "y": 0.3388131768879847, "x": 0.08050089686645669}, {"w": 0.2880142890082465, "h": 0.015174417977728975, "x": 0.07513418092074252, "text": "Would it be possible for you to ...?", "y": 0.3578633725961646}, {"h": 0.014133574007220224, "x": 0.07692308348427733, "text": "I'd be grateful if you could...", "y": 0.38435469297862085, "w": 0.2397137620713976}, {"text": "I'm writing to ask for your help/advice ...", "w": 0.3363148328993055, "y": 0.41340703950060953, "x": 0.07513417988308416, "h": 0.014133574007220224}, {"text": "I am writing to inquire about ...", "y": 0.44245938610744334, "x": 0.07513417190822654, "w": 0.2576028611924913, "h": 0.012955776173285189}, {"w": 0.20214669121636286, "h": 0.01655308102872831, "text": "Making suggestions", "y": 0.4766155236193275, "x": 0.07513416983010118}, {"w": 0.2701252237955729, "h": 0.013909883895075253, "y": 0.5070784882723753, "text": "I think I/you/we should (go to) ...", "x": 0.07155635323638168}, {"w": 0.27586702134874136, "x": 0.07314590312896228, "h": 0.016147626694359114, "y": 0.5332414975137514, "text": "Perhaps I/you/we could (go to) ..."}, {"text": "What do you think about (going to) ...?", "y": 0.5614169673255048, "w": 0.3130590142144097, "h": 0.014133574007220224, "x": 0.07155636442678431}, {"y": 0.5880087214333739, "h": 0.015174417977728975, "w": 0.2576028611924913, "text": "What/How about (going to) ...?", "x": 0.07155635191717118}, {"x": 0.07155635236025511, "h": 0.013909883895075253, "text": "How do you feel about ...?", "y": 0.6158284884241194, "w": 0.22003577338324654}, {"text": "Would you like me to ...?", "x": 0.06976744280311974, "w": 0.2075134107801649, "y": 0.6422924190543023, "h": 0.014133574007220224}, {"h": 0.014133574007220224, "w": 0.1842575920952691, "y": 0.6701669673232467, "text": "Why don't we (go) ...?", "x": 0.06976744856008332}, {"y": 0.6992193139852504, "text": "Let's go to ...", "x": 0.07155635148252705, "h": 0.011449290415009921, "w": 0.10733452690972224}, {"x": 0.5149977199722656, "w": 0.37424563937717015, "y": 0.09616884065221905, "h": 0.020921480345812017, "text": "Opening formulas: emails and letters"}, {"w": 0.1466905212402344, "y": 0.1251889537702198, "x": 0.5116279075820295, "h": 0.015361587958215375, "text": "Informal phrases"}, {"y": 0.1452617327981342, "h": 0.014133574007220224, "w": 0.12880143059624571, "text": "Dear Margaret,", "x": 0.5134168176177983}, {"y": 0.17274329877838593, "x": 0.5123871387795399, "w": 0.07552334255642368, "h": 0.016175974164198397, "text": "Hi Anne,"}, {"h": 0.015174417977729072, "y": 0.2035901165419494, "x": 0.5116279077118351, "w": 0.1341681586371528, "text": "Formal phrases"}, {"text": "Dear Mr and Mrs Edwards,", "y": 0.2237815882987991, "h": 0.015311371841155162, "w": 0.21824686686197914, "x": 0.511627906068116}, {"h": 0.014133574007220224, "text": "Dear Ms Brennon,", "y": 0.25283393486905187, "x": 0.5116279090661289, "w": 0.1502683342827691}, {"h": 0.01649830008241671, "x": 0.5116279075395495, "text": "Refusing suggestions", "w": 0.21466905381944446, "y": 0.28699007200027354}, {"x": 0.5098389996491527, "y": 0.31604241864700056, "text": "It doesn't sound very good.", "w": 0.22898032294379345, "h": 0.015311371841155259}, {"text": "I'm sorry but I can't join you.", "h": 0.014133574007220224, "x": 0.5080500916122338, "w": 0.2379248555501302, "y": 0.34509476530652344}, {"h": 0.012713825246487384, "y": 0.3729693140271788, "x": 0.5098390040739214, "text": "I'm not really into ...", "w": 0.16815741644965276}, {"x": 0.5098390022143083, "y": 0.40830324940785406, "text": "Responding to good and bad news", "w": 0.35420393202039935, "h": 0.01658047150188411}, {"w": 0.11470642089843752, "x": 0.5079419587822313, "text": "You're joking!", "h": 0.014827736568795232, "y": 0.4370701433887659}, {"y": 0.46405234639813137, "text": "That's good/great/fantastic news!", "x": 0.5062611855024337, "w": 0.2772808498806423, "h": 0.015311371841155259}, {"x": 0.5062611807761556, "text": "That's awful/terrible!", "y": 0.49190406994984864, "w": 0.17352415296766488, "h": 0.011408204330864402}, {"w": 0.23076922946506084, "h": 0.013909883895075349, "text": "I'm really sorry to hear that.", "x": 0.5062611836395626, "y": 0.5197238371095845}, {"x": 0.5062611817987966, "y": 0.5475436050388338, "text": "Congratulations!", "w": 0.1377459716796875, "h": 0.012645348314774147}, {"h": 0.01162790690711013, "text": "138", "x": 0.057613169122276764, "y": 0.9476744185667938, "w": 0.03497942394680448}]
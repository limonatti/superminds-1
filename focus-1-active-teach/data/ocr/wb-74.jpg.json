[{"y": 0.025126353640314493, "h": 0.018059566787003576, "w": 0.26118067423502606, "text": "EXAM SPEAKING", "x": 0.19499106040782976}, {"h": 0.012741215719643087, "y": 0.08715703983309285, "x": 0.11091235040382433, "w": 0.3023255750868056, "text": "1 In pairs, ask and answer the questions."}, {"y": 0.10622093029444857, "h": 0.0076328602766732164, "text": "PART 1", "x": 0.1323792486482357, "w": 0.04472271813286677}, {"x": 0.13237925053349114, "text": "Talk about people.", "h": 0.011549722649130153, "y": 0.1224909747775473, "w": 0.13595706515842015}, {"y": 0.13656976761372958, "x": 0.13237925882945642, "w": 0.2790697564019097, "h": 0.011440160007683312, "text": "1 Who is your favourite film character?"}, {"text": "What does he/she look like?", "h": 0.01023040649692927, "x": 0.15384615664009124, "w": 0.19677995469835072, "y": 0.15036552357723615}, {"w": 0.010733451843261743, "y": 0.16438953512979992, "x": 0.13059034008910259, "h": 0.008851743820341951, "text": "2"}, {"y": 0.16438953508171172, "text": "Can you describe his/her personality?", "w": 0.26475848727756074, "x": 0.15563507094082601, "h": 0.012672739536753685}, {"x": 0.13237924904562962, "text": "3", "w": 0.00894454320271812, "y": 0.1782994187348145, "h": 0.008851743820341951}, {"y": 0.17824007236677278, "w": 0.3470483059353298, "h": 0.012704694839160775, "x": 0.15384614767634225, "text": "Who is the most creative person you know? Why?"}, {"y": 0.19181874215378514, "w": 0.290003424750434, "text": "4 Are you sociable or unsociable? Why?", "x": 0.13047735063837573, "h": 0.013138459202184588}, {"h": 0.012649913892849175, "text": "5 What clothes do you never wear? Why?", "x": 0.13059033821275876, "y": 0.2061146205715873, "w": 0.3005366685655382}, {"x": 0.10721273231757453, "text": "2 Look at the photos of the students' schools.", "w": 0.3419425455729166, "h": 0.014263851358572078, "y": 0.2260382396197723}, {"x": 0.1270125233708405, "h": 0.01144016038209523, "y": 0.24531976753469606, "w": 0.04830053541395399, "text": "PART 1"}, {"y": 0.2613545922074392, "x": 0.12863915391551745, "h": 0.014836593655472602, "text": "Take turns to describe the people in the photos.", "w": 0.35099616156684027}, {"text": "PART 2", "x": 0.570648307333796, "y": 0.10871007666990162, "w": 0.05190553029378253, "h": 0.008931590891056503}, {"y": 0.12518895374454353, "text": "Talk about school.", "x": 0.5742397184906872, "h": 0.011435595178431925, "w": 0.1323792436387804}, {"text": "1", "y": 0.13909883732892786, "x": 0.5742397144211862, "w": 0.012522360483805284, "h": 0.008851743820341951}, {"h": 0.011499506532070037, "y": 0.1389801443745493, "text": "What are your favourite and least favourite", "x": 0.5885509955488761, "w": 0.30769229465060766}, {"y": 0.1669186049233636, "h": 0.010116278651819317, "text": "2", "x": 0.570661896035019, "w": 0.014311270183987035}, {"w": 0.012522361543443439, "x": 0.5724508048275627, "h": 0.010116278651819317, "text": "3", "y": 0.18082848847990432}, {"x": 0.5957066225893648, "text": "subjects at school? Why?", "y": 0.15427325620162452, "h": 0.012645348314774147, "w": 0.17889087253146707}, {"x": 0.5992844379356972, "h": 0.011444725211346617, "y": 0.16685469330046893, "w": 0.275491943359375, "text": "How do you revise for exams and tests?"}, {"w": 0.2933810424804687, "x": 0.5974955301610774, "y": 0.18082848854900824, "text": "Where do you go in your breaks at school", "h": 0.012722955653813801}, {"h": 0.011389943890623293, "w": 0.1484794277615017, "text": "and what do you do?", "x": 0.5974955281049379, "y": 0.1947292420346007}, {"x": 0.5686635066894982, "y": 0.20672537015487163, "h": 0.016900426644280514, "w": 0.32238918728298604, "text": "4 What do students do after primary school"}, {"y": 0.22236795933916415, "h": 0.013025708818263468, "w": 0.11636071946885851, "text": "in your country?", "x": 0.5938768870468968}, {"x": 0.5706619011165169, "text": "5 What do you want to do after secondary school?", "y": 0.23634476566429757, "h": 0.012955776173285189, "w": 0.3649373711480035}, {"y": 0.48684593061013676, "x": 0.5706618966186195, "h": 0.010116278651819317, "text": "B", "w": 0.010733451843261688}, {"text": "PART 2", "y": 0.5083430234015612, "w": 0.04830053541395399, "h": 0.010280622988401303, "x": 0.12164579709624304}, {"y": 0.52351772378602, "h": 0.015588628307576576, "text": "In pairs, ask and answer the questions about the photos.", "w": 0.4117418755425347, "x": 0.12328515851559341}, {"text": "Student A's photo", "h": 0.012732085312316574, "w": 0.13416815016004777, "x": 0.12343471013911742, "y": 0.5449277981157828}, {"x": 0.12140363780996924, "h": 0.015665779612985327, "text": "1 What are the students doing?", "y": 0.5574034892637696, "w": 0.23304295857747395}, {"text": "2 What are they wearing?", "x": 0.12343470263914513, "h": 0.011499506532070037, "w": 0.18783542209201387, "y": 0.5739801444407868}, {"w": 0.3220035807291667, "text": "3 Where in the school do you think they are?", "x": 0.12343470659427169, "h": 0.01266817395867856, "y": 0.5880087211155779}, {"w": 0.1717352294921875, "x": 0.12164579992295817, "y": 0.6018546931740153, "text": "4 What are they using?", "h": 0.011444725211346714}, {"text": "5", "w": 0.010733451843261715, "h": 0.008851743820341951, "x": 0.12164579661861957, "y": 0.6158284884917185}, {"w": 0.32737030029296876, "h": 0.012722955653813801, "text": "Do they look like they're enjoying their lesson?", "x": 0.1431126977068253, "y": 0.6158284886333106}, {"w": 0.1341681586371528, "x": 0.5652951699658602, "text": "Student B's photo", "y": 0.5475436050388338, "h": 0.012695564431834358}, {"text": "1 Who can you see in the photo?", "y": 0.5614169673413114, "w": 0.24150268554687504, "h": 0.014133574007220224, "x": 0.5652951705794886}, {"w": 0.2576028611924913, "h": 0.013928143960904539, "text": "2 What do you think they're doing?", "x": 0.5652951730531282, "y": 0.5753633719174333}, {"y": 0.5892732560029119, "text": "3 Where do you think they are?", "x": 0.567084078742481, "w": 0.22719141642252605, "h": 0.012645348314774147}, {"text": "4 What style of clothes are they wearing?", "x": 0.5652951667644374, "y": 0.6030324907213879, "w": 0.2969588555230035, "h": 0.012955776173285286}, {"x": 0.5635062587457635, "text": "5 Do they look happy? Why?/Why not?", "y": 0.6170930232066774, "w": 0.2844364929199219, "h": 0.013909883895075349}, {"x": 0.14311270332853301, "text": "Why?/Why not?", "h": 0.012654478722100659, "w": 0.11270124647352428, "y": 0.6297292419830439}, {"text": "Read the instructions on your card. In pairs, take turns to role-play the conversation.", "x": 0.12164579641053573, "y": 0.653677798147396, "w": 0.6100179036458334, "h": 0.012732085312316574}, {"text": "Student A", "h": 0.0118197660712989, "x": 0.14483623132354842, "y": 0.6813648260268946, "w": 0.07526492648654515}, {"w": 0.07532947964138459, "x": 0.563408606376516, "h": 0.010867223016621772, "text": "Student B", "y": 0.6837379000469762}, {"x": 0.1449016122288588, "y": 0.7055009028941167, "text": "You're a tourist and you want to visit the", "h": 0.012754910956220987, "w": 0.3005366685655382}, {"x": 0.1466905197828735, "y": 0.7195203492619854, "w": 0.29874776204427084, "h": 0.011499506157658119, "text": "Old School Museum. Student B works at"}, {"y": 0.733375450913466, "w": 0.3148479207356771, "h": 0.012700130009909485, "x": 0.14490161900008047, "text": "the tourist information office. Ask him/her"}, {"h": 0.010454634638899956, "text": "questions.", "x": 0.1448587535111204, "y": 0.7484354733739927, "w": 0.07879770067003036}, {"x": 0.14288170522143914, "y": 0.7630750435562282, "text": "• Start the conversation in a polite way.", "w": 0.28850209554036454, "h": 0.015634419625416607}, {"x": 0.14311270739832954, "w": 0.27906975640190973, "y": 0.7789169675947616, "h": 0.012681869195256362, "text": "• Say that you want information about"}, {"w": 0.17710196601019965, "x": 0.16636851787146542, "h": 0.011572548293034566, "y": 0.7928633723154738, "text": "the Old School Museum."}, {"h": 0.015455542867364438, "y": 0.8046332338684864, "text": "• Ask how much it costs to get in.", "w": 0.25094063652886284, "x": 0.14111656352089458}, {"text": "• Ask about opening times.", "y": 0.818395298825119, "w": 0.20645265367296006, "h": 0.016067423183565143, "x": 0.14098336484863289}, {"h": 0.011458420822336338, "y": 0.8345930233486496, "w": 0.2629695807562934, "x": 0.14132379448321292, "text": "• Ask for directions to the museum."}, {"y": 0.848407039833093, "w": 0.21288013034396702, "text": "• Ask if you can book online.", "h": 0.012741215719642991, "x": 0.14132380241895254}, {"w": 0.31127010769314234, "y": 0.7068750002224504, "x": 0.5652951818242695, "text": "You work at the tourist information office.", "h": 0.011380813483296684}, {"x": 0.5652951782265043, "w": 0.2629695807562934, "h": 0.01141276953452761, "y": 0.7207848839771016, "text": "Student A wants some information."}, {"text": "Answer his/her questions.", "y": 0.7345532489716333, "x": 0.5652951743957055, "w": 0.19320214165581595, "h": 0.011522332175974353}, {"y": 0.7522202166181496, "w": 0.2558139546712239, "h": 0.011558853056456667, "text": "• Respond to how Student A starts", "x": 0.5635062588227064}, {"x": 0.586762073121903, "w": 0.12164579603407122, "text": "the conversation.", "h": 0.010253232140833683, "y": 0.766308139786009}, {"x": 0.5635062618048159, "text": "• Ask what exactly Student A wants to know.", "y": 0.7800947652005373, "w": 0.3202146742078993, "h": 0.011504071735733246}, {"y": 0.7941279074487175, "w": 0.2790697564019098, "h": 0.012663609129427173, "x": 0.5617173586505657, "text": "• Tell him/her ticket prices: £8 adults /"}, {"h": 0.014133574007220224, "x": 0.5849731684154734, "y": 0.8079693137168248, "text": "f4 children / £20 family ticket.", "w": 0.20930231730143234}, {"y": 0.8219476746798221, "x": 0.5617173550897231, "w": 0.30769229465060766, "h": 0.012718390075738675, "text": "• Tell him/her the museum opening times:"}, {"x": 0.5849731637877048, "h": 0.012659043551352046, "text": "8.30 a.m. - 5.30 p.m.", "y": 0.8358438631641748, "w": 0.1484794277615017}, {"x": 0.5617173644599285, "w": 0.31127010769314234, "h": 0.011563418260119874, "text": "• Tell him/her that the museum is on North", "y": 0.8495848375084182}, {"y": 0.8762754913141432, "text": "the conversation.", "h": 0.011882380001960402, "w": 0.123928468492296, "x": 0.16439251991150078}, {"text": "• Say yes and say that there is also an app.", "y": 0.8779069769462722, "w": 0.3065843370225695, "h": 0.013081394896215293, "x": 0.5617284127301417}, {"h": 0.013343799058084693, "x": 0.5617283987042462, "w": 0.21604938083224823, "y": 0.8908948193958538, "text": "• Respond and say goodbye."}, {"w": 0.0246913570827908, "h": 0.013081394896215404, "x": 0.9176954734750655, "y": 0.9491279072757295, "text": "69"}]
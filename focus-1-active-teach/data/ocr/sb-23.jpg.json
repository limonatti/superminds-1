[{"x":0.08424665566616138,"text":"READING","w":0.094881176418728314,"y":0.063522874875213353,"h":0.013942622689287476},{"y":0.091569767358961607,"w":0.0123456785413954,"h":0.0087209301803325978,"text":"8","x":0.078189300544117116},{"y":0.09144426999566635,"h":0.011773940345368938,"x":0.10493827847403053,"w":0.36831275092230903,"text":"Read the text and choose the correct answer, A, B"},{"w":0.037037035624186185,"y":0.10596546308559118,"h":0.010313606337063796,"text":"or C.","x":0.10493827241424435},{"x":0.075964837787735176,"y":0.14493449505700695,"text":"Morning","h":0.040072870778513514,"w":0.1937493387858073},{"x":0.074074076217287177,"text":"blues?","w":0.15843621148003473,"h":0.037790696699540716,"y":0.18459302397944477},{"y":0.23255814022942045,"w":0.17078189425998264,"text":"No!","h":0.084302324327980904,"x":0.072016460846689057},{"y":0.34011627921129151,"x":0.07407408490145953,"text":"Buzzzz ... it's the alarm in your phone. You wake up. You get","h":0.013101931082397655,"w":0.39506171332465279},{"text":"up. You go to the bathroom, get dressed, prepare for school ...","y":0.35465116279898545,"w":0.40534976535373268,"x":0.072016469483627707,"h":0.013088240541131668},{"x":0.071994993687388237,"y":0.37055474506079278,"h":0.013250975256999253,"w":0.10292359246148003,"text":"Aaargh! Awful?"},{"text":"Susie Brown, one of her school's best football players, says","h":0.013081394896215293,"x":0.074074080555555366,"y":0.38808139550247378,"w":0.3888888888888889},{"x":0.07201645372734776,"y":0.40261627932030319,"w":0.39300411648220485,"h":0.013081394896215293,"text":"the morning is not a problem for her. Today she tells us how"},{"text":"to be happy in the morning.","y":0.4186046511976077,"w":0.18518517388237846,"h":0.011627906907110019,"x":0.072016468871567901},{"h":0.013343799058084804,"x":0.086419756975308598,"w":0.38888888888888895,"y":0.43877550999213888,"text":"I pack my schoolbag in the evening. I don't want to look for"},{"w":0.26543209499782983,"h":0.013343799058084804,"x":0.086419753074277322,"y":0.45486656166428874,"text":"my English book at 7:45 in the morning!"},{"y":0.47238372101349924,"h":0.011627906907110019,"text":"I never get up late. You need time to enjoy your morning.","w":0.37037034776475697,"x":0.086419770562065776},{"x":0.08641975545799975,"y":0.48691860485930516,"h":0.013081394896215293,"text":"I get up at six every day.","w":0.16460905287000871},{"text":"I have a shower. It wakes me up and it's fun.","x":0.086419762441526687,"y":0.50581395352318914,"w":0.29629628499348959,"h":0.011627906907110019},{"w":0.36213992648654514,"x":0.08436213853999211,"text":"I enjoy the first drink of the day. It can be coffee, tea or","y":0.52315541574839053,"h":0.014635281435548819},{"text":"orange juice. I always listen to music as I have that first","w":0.36419752332899302,"h":0.013343799058084804,"x":0.088477368822471925,"y":0.53767660933977912},{"x":0.08847736976608031,"y":0.55376766072584049,"h":0.010204081632653073,"w":0.28600823296440969,"text":"drink. You can also read or watch the news."},{"text":"I sit down and have a good breakfast - not a banana on the","x":0.086419764507445374,"y":0.57103610676476069,"w":0.39094648573133683,"h":0.011812730337050215},{"w":0.39094648573133683,"text":"bus to school! It's really important. You need your breakfast.","h":0.013145285086878844,"x":0.088477378327747172,"y":0.58575581413619471},{"h":0.01162790690711013,"y":0.60465116273830544,"x":0.086419757562089999,"text":"I usually walk to school, or go for a walk with my brother's","w":0.38477366129557289},{"text":"dog. I spend twenty to thirty minutes in the fresh air every","h":0.013081394896215404,"y":0.6191860467016016,"x":0.088477379457090138,"w":0.37860080295138887},{"x":0.088477363363835923,"y":0.63372093053154344,"w":0.22633744981553816,"h":0.013081394896215404,"text":"morning before school - it's great!"},{"h":0.013343799058084804,"text":"We hope these ideas help you. You too can have a happy","x":0.072016466077284472,"w":0.37242797851562504,"y":0.6554160125417765},{"w":0.17695473564995662,"h":0.014655816873164196,"text":"morning - every morning!","x":0.072016461547449631,"y":0.66993720581949623},{"h":0.010204081632653073,"x":0.10493827229938268,"w":0.055555555555555552,"text":"1 Susie","y":0.71075353211018932},{"x":0.12139917684418275,"h":0.010204081632653073,"y":0.72527472541703386,"text":"A is a teacher.","w":0.10082304212782117},{"text":"B plays football.","h":0.011773940345368938,"y":0.72370486662063471,"x":0.2901234600524818,"w":0.11728394402398007},{"h":0.010320451607696679,"x":0.12345679858160648,"y":0.73822605982682854,"w":0.18724278767903646,"text":"C coaches a football team."},{"x":0.10493827812992297,"text":"2 Susie prepares for school","y":0.75274725269046672,"w":0.19547324286566842,"h":0.011787630886634815},{"y":0.76730633924853675,"h":0.01200964237494595,"w":0.13001332600911458,"x":0.1212446747358653,"text":"A in the morning."},{"y":0.76726844586032328,"text":"B in the afternoon.","w":0.13991768731011289,"h":0.010347833064511924,"x":0.28600823220228244},{"text":"C in the evening.","w":0.123456785413954,"x":0.12139918136709699,"y":0.78178963911035748,"h":0.011815011969166567},{"x":0.1049382761430603,"text":"3 As she has her morning drink, Susie","y":0.79651162785458451,"w":0.26543209499782988,"h":0.01162790690711013},{"h":0.011627906907110019,"x":0.12345679061570659,"text":"A listens to music.","w":0.12757201300727,"y":0.80959302314528214},{"h":0.01049908588595061,"text":"B reads.","w":0.061834013197157089,"x":0.29007064669337557,"y":0.81088417800606549},{"w":0.14446880764431425,"y":0.824039837231195,"x":0.12323908294031589,"text":"C watches the news.","h":0.011782029360018043},{"x":0.10493827570599838,"y":0.83866279086077533,"h":0.010238307985817818,"w":0.15226337009006075,"text":"4 Susie has breakfast"},{"h":0.010644657458390716,"x":0.12134077998621637,"y":0.85296255495966777,"text":"A at home.","w":0.080363710191514753},{"x":0.29423868721681024,"text":"B on the bus.","h":0.010224617444551831,"y":0.85319767466043617,"w":0.09465020073784719},{"w":0.082304526435004355,"text":"C at school.","y":0.86773255815474659,"h":0.0087209301803324868,"x":0.12345679017755953},{"x":0.10493827611219608,"w":0.2098765394422743,"text":"5 Before school, Susie always","h":0.011773940345368938,"y":0.88069073786689178},{"h":0.011773940345368938,"w":0.21604938083224823,"text":"A takes her dog out for a walk.","y":0.89521193080550909,"x":0.12139917429581014},{"w":0.24074072943793398,"h":0.011778503983885469,"y":0.90973312385193705,"x":0.12345679878411933,"text":"B goes for a walk with her brother."},{"y":0.92425431703160144,"text":"C spends some time outside.","w":0.20781892564561633,"x":0.12139918175023708,"h":0.011792194525151345},{"y":0.063953488319700824,"h":0.011627906907110019,"x":0.53292181239748115,"w":0.1069958835177951,"text":"SPEAKING"},{"y":0.091444269850317506,"h":0.011773940345368938,"text":"9 Complete the sentences with the correct words.","x":0.52469135223973085,"w":0.384773661295573},{"h":0.013088240541131779,"w":0.27572014702690972,"x":0.55349795577323901,"y":0.10465116299278376,"text":"The first letter of each word is given."},{"x":0.55349794937035834,"text":"1 What k of music do you like?","y":0.12354651180807286,"h":0.011627906907110019,"w":0.24279834323459193},{"text":"2 Who's your f","w":0.1316872406005859,"h":0.013131593797045871,"y":0.13657770818110049,"x":0.5534979456805027},{"text":"_ actor?","y":0.13808139547560083,"h":0.010270252706866101,"x":0.70164609094117725,"w":0.0576131693522135},{"w":0.30452674018012149,"x":0.55349794856563195,"text":"3 What do you th of Jennifer Lawrence?","y":0.14952904216816199,"h":0.013343799058084804},{"x":0.55349794096780169,"text":"4 I hate rap. What ab you?","h":0.013343799058084804,"w":0.2139917670355902,"y":0.16562009393115484},{"x":0.55555555850362892,"w":0.16049382527669276,"text":"5 Do you I football?","h":0.011773940345368938,"y":0.18014128716642852},{"x":0.55349794622275272,"w":0.34773661295572922,"h":0.013122466520013032,"y":0.1933139538782005,"text":"6 What's your favourite TVs? | love Sherlock."},{"y":0.21802325625828767,"x":0.52469136643555359,"text":"10 Do the task in pairs.","w":0.17901233249240445,"h":0.013138439441962357},{"y":0.26143371153028283,"x":0.55344689316068807,"h":0.010562809146180463,"text":"Student A","w":0.076233783298068514},{"x":0.5534979583192674,"h":0.011819575981966479,"y":0.28488372089237524,"text":"You are on a language course in the UK. You meet","w":0.37037034776475697},{"text":"Student B for the first time. Start the conversation.","y":0.29941860468597992,"x":0.55349795054635242,"w":0.37654320610894099,"h":0.01180588506641711},{"w":0.24485595703124996,"y":0.31671899538658743,"x":0.55144033153238603,"h":0.013343799058084693,"text":"• Say hello and introduce yourself."},{"h":0.011783067248118284,"x":0.55144034036712852,"y":0.33124018853101811,"text":"• Ask Student B what music he\/she likes.","w":0.29218105740017353},{"x":0.5514403461344064,"text":"• Reply to Student B and ask what films he\/she likes.","w":0.37448557535807292,"h":0.013081394896215293,"y":0.34447674443658227},{"y":0.35901162791526442,"text":"• Reply. Ask Student B about his\/her favourite sport.","w":0.37242797851562504,"x":0.55144033437044526,"h":0.013081394896215404},{"y":0.39678178972293487,"w":0.074074071248372397,"h":0.0087414659922314675,"text":"Student B","x":0.55349794472560798},{"h":0.011773940345368938,"y":0.41993720550918279,"w":0.37037034776475697,"text":"You are on a language course in the UK. You meet","x":0.5534979583192674},{"w":0.20576131184895829,"text":"Student A for the first time.","h":0.010309042698547266,"y":0.43445839892614257,"x":0.55349794747058256},{"y":0.45203488379208445,"w":0.31481479220920139,"h":0.01162790690711013,"text":"• Reply to Student A and introduce yourself.","x":0.55144033658572866},{"w":0.36625512017144091,"text":"• Reply to Student A and ask about the same thing.","x":0.55144033919411506,"y":0.46507064349596328,"h":0.013127030532813055},{"x":0.55144034457404989,"h":0.011773940345368938,"text":"• Reply. Ask Student A about his\/her favourite sport.","w":0.37448557535807292,"y":0.47959183664765115},{"text":"• Reply.","y":0.4941130299824722,"w":0.065843620300293004,"x":0.54938271714752152,"h":0.013343799058084804},{"y":0.54796511643270629,"text":"WRITING","w":0.090534981621636312,"x":0.53292181050605425,"h":0.013081394896215293},{"y":0.57558139555697951,"text":"11 Read the email from your new online English friend,","h":0.013115621623663642,"x":0.52469136819219375,"w":0.4115226236979167},{"w":0.37037034776475697,"h":0.013101931082397655,"text":"Mark. Then write a reply, answering his questions.","x":0.55349795670747048,"y":0.59011627907805519},{"text":"To:","w":0.02674897087944883,"h":0.010174418169437871,"y":0.63081395387555239,"x":0.53497942440252522},{"x":0.53493012793883221,"y":0.64659422087925855,"w":0.084460728963216103,"h":0.010590628140388136,"text":"From: Mark"},{"text":"I'm very happy to be your online friend! Please","h":0.011773940345368827,"x":0.53497942778842744,"w":0.32921810574001742,"y":0.66562009403763633},{"w":0.36213989257812496,"h":0.013081394896215293,"text":"write and tell me about yourself. Have you got a big","x":0.53703704644070438,"y":0.6816860465199156},{"text":"family? What music do you like? What subjects","x":0.53497941900927826,"y":0.69897959198963544,"h":0.011776221977485402,"w":0.32921810574001731},{"x":0.53703703597926178,"h":0.011627906907110019,"y":0.71656976752512713,"text":"do you enjoy at school?","w":0.16460905287000871},{"y":0.95639534880973409,"w":0.024691357082790799,"h":0.011627906907110019,"text":"23","x":0.91152263439217296}]
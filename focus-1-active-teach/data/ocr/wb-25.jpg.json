[{"x": 0.20922390817203637, "y": 0.01868744773792894, "text": "WRITING", "w": 0.14326953464084205, "h": 0.02079370930737103}, {"text": "An informal email", "h": 0.012718390075738675, "x": 0.20751341597177386, "w": 0.13595706515842015, "y": 0.06069767475569434}, {"h": 0.011504071735733246, "y": 0.1275947651857843, "x": 0.07692308982851236, "text": "1 Which of these expressions should not be used when:", "w": 0.4203935411241319}, {"x": 0.09838998337578017, "y": 0.14526173279331073, "text": "starting an email:", "w": 0.12701251559787327, "h": 0.011540592616215558}, {"w": 0.11806797451443142, "x": 0.10017889097772771, "text": "1 A Dear Dave", "h": 0.01027149258107479, "y": 0.15933139538920665}, {"y": 0.1604514620510968, "text": "B Hi Dave", "x": 0.2539906700584157, "w": 0.07341400994194874, "h": 0.00914068043877494}, {"x": 0.3881932048679088, "text": "C I'm Dave", "y": 0.16057310474704645, "w": 0.08407870822482638, "h": 0.010207581227436872}, {"w": 0.130590337117513, "h": 0.012645348314774147, "text": "finishing an email:", "x": 0.09838998342395071, "y": 0.17703488408752568}, {"x": 0.10017889520665865, "y": 0.1922093024704976, "text": "2 A Write soon", "w": 0.11985688103569878, "h": 0.008851743820341951}, {"y": 0.19080324879964453, "text": "B Thanks for your email", "x": 0.25402504915854707, "h": 0.012955776173285189, "w": 0.16994632297092016}, {"y": 0.2061146209404099, "h": 0.01264991389284937, "x": 0.12343470891682504, "w": 0.19499104817708332, "text": "C Say hello to your parents"}, {"h": 0.011554287852793457, "text": "3 A All the best", "w": 0.12701252407497832, "x": 0.09838998216133528, "y": 0.21985559558787907}, {"x": 0.254025052595786, "h": 0.012955776173285189, "w": 0.23971376207139755, "text": "B Nice to see you C Bye for now", "y": 0.21985559587550774}, {"x": 0.10017889253786431, "w": 0.10196779886881509, "y": 0.23393895374958967, "h": 0.012645348314774147, "text": "4 See you ..."}, {"text": "A best", "x": 0.12156564100298839, "h": 0.010549397528817001, "y": 0.24889681282496487, "w": 0.05382757398817273}, {"y": 0.24911337227038396, "text": "B soon", "x": 0.25402504612564575, "w": 0.05187835269504121, "h": 0.010116278651819317}, {"text": "C in June", "w": 0.06976743910047745, "h": 0.010116278651819317, "x": 0.3881932026545913, "y": 0.24911337236522413}, {"text": "5 Have a", "x": 0.10015319563135403, "y": 0.26293174598252106, "w": 0.07160774230957032, "h": 0.010299298651381869}, {"text": "A good time", "x": 0.1198568873499101, "y": 0.27819767474304896, "h": 0.012718390075738675, "w": 0.09660107082790798}, {"text": "B good trip", "x": 0.2504472293179382, "y": 0.27819767461659545, "h": 0.012718390075738675, "w": 0.08944543626573354}, {"x": 0.09660107262355243, "w": 0.24686940511067706, "y": 0.29084302299486786, "h": 0.013909883895075349, "text": "6 A Regards, Tom B Love, Tom"}, {"x": 0.386404293818182, "w": 0.04472271813286677, "y": 0.2767824909021271, "h": 0.011531462208889044, "text": "C fun"}, {"h": 0.011394509094286501, "y": 0.29209386271095206, "w": 0.09838997734917532, "x": 0.38640429658182257, "text": "C You're Tom"}, {"text": "2 Change the underlined words to contractions.", "y": 0.31604241882658846, "w": 0.391771002875434, "h": 0.012736650890391605, "x": 0.07334526370837735}, {"y": 0.3552019472264073, "w": 0.06093210432264541, "h": 0.012910058988991328, "text": "Hi Sofia,", "x": 0.08223520058147736}, {"y": 0.3729693144435191, "text": "Thanks for your email. I'm / I am glad you want to write", "h": 0.014133574007220224, "w": 0.39534881591796867, "x": 0.08050090015818925}, {"x": 0.08228980381784377, "y": 0.38821220941013684, "text": "to me. I'", "w": 0.06440071529812282, "h": 0.010276057784738096}, {"w": 0.20214669121636286, "x": 0.20751341394011918, "y": 0.38821220926267314, "text": "/ do not speak Spanish, so?", "h": 0.013909883895075253}, {"h": 0.012681869195256459, "text": "it is lucky that your English is so good.", "x": 0.08050089820472825, "w": 0.2719141303168403, "y": 0.40465116297604303}, {"x": 0.08050090701119075, "y": 0.4196886283327726, "h": 0.014133574007220224, "w": 0.3398926459418403, "text": "What are you interested in? I love travelling and"}, {"w": 0.12164579603407119, "y": 0.43499999980228055, "x": 0.08050089599012, "text": "photography.\"", "h": 0.013909883895075349}, {"y": 0.4349999999508634, "h": 0.013909883895075349, "text": "_/ I have got a blog with photos of", "x": 0.23971377550782033, "w": 0.24865831163194443}, {"x": 0.08050089695891337, "text": "my holidays on it. Click here. Do you like them?", "y": 0.4514389538128164, "w": 0.33273701985677084, "h": 0.012645348314774147}, {"y": 0.4666133724284508, "w": 0.01967799504597982, "h": 0.010116278651819317, "x": 0.07871198635446985, "text": "14"}, {"h": 0.012750346126969504, "x": 0.15921288646765827, "y": 0.4666133723036595, "text": "/ do not think they are very good but they are", "w": 0.32915920681423605}, {"y": 0.4817193139549197, "x": 0.08050089770923345, "w": 0.3792486572265625, "h": 0.012713825246487289, "text": "my photos! My next holiday (next week!) is in Greece!"}, {"x": 0.15026833439023765, "h": 0.012663609129427173, "text": "/ It is great that you can come to England. My", "y": 0.4982084836958378, "w": 0.32558139377170137}, {"x": 0.08050090005736406, "w": 0.18246868557400175, "h": 0.014133574007220224, "text": "mum is very excited but •", "y": 0.5119494584723259}, {"w": 0.14669052124023435, "x": 0.32379248352120665, "text": "/ she is worried. She", "y": 0.5134011631151421, "h": 0.012681869195256459}, {"y": 0.5284386283675473, "x": 0.15026834916761195, "w": 0.2880142890082465, "h": 0.014133574007220224, "text": "/ does not know how to cook Spanish food"}, {"h": 0.012732085312316574, "y": 0.5449277981790096, "w": 0.38461537679036456, "text": "She wants to know what you like so she can find it on the", "x": 0.07871198479354768}, {"h": 0.012645348314774242, "text": "Internet! Say hello to your family. See you in July.", "y": 0.560188953781203, "w": 0.34704830593532987, "x": 0.07692306988564465}, {"x": 0.07863932907031676, "text": "Bye for now,", "h": 0.014383965674720476, "w": 0.0895907508002387, "y": 0.5789199355953202}, {"text": "Ruby", "y": 0.5955959305814621, "h": 0.01138081348329678, "x": 0.08050089504828532, "w": 0.03756708357069227}, {"x": 0.06976744714700488, "y": 0.627209302586799, "w": 0.3792486572265625, "h": 0.01272752048306509, "text": "3 Complete the email with one word in each gap."}, {"text": "The last letters are given.", "x": 0.09447361476940336, "h": 0.015436350516033433, "y": 0.640480525427307, "w": 0.19029149373372395}, {"x": 0.07871198620316973, "text": "Hi Ruby,", "w": 0.060822898017035595, "y": 0.6827301444006711, "h": 0.012955776173285189}, {"h": 0.012713825246487289, "x": 0.08050089008954062, "text": "Thanks for your email. I love your photos! I can teach you", "y": 0.6992193138691121, "w": 0.4042933824327256}, {"x": 0.07871199131424811, "w": 0.4078711954752604, "text": "some Spanish if you like and then you can come to Spain,", "y": 0.7157084836326111, "h": 0.012663609129427173}, {"x": 0.07513417069072634, "h": 0.013909883895075253, "y": 0.7309011625297516, "w": 0.2629695807562934, "text": "take lots of photos and try our food!"}, {"y": 0.7473401165954571, "x": 0.07692307711586704, "h": 0.01138081348329678, "w": 0.03398926628960504, "text": "I'm'"}, {"x": 0.2036929234500362, "y": 0.7450148078663825, "text": "d in travel too. I sometimes go to", "w": 0.23484812418619794, "h": 0.015475257897635314}, {"y": 0.7624277980841693, "x": 0.07871200356536533, "h": 0.012732085312316574, "w": 0.39892662896050346, "text": "Morocco - it isn't far from my town! I love the food there"}, {"text": "and the people. They are very friendly. I like Moroccan", "w": 0.3810375637478298, "x": 0.07692308176651434, "y": 0.7789169676896016, "h": 0.012681869195256459}, {"text": "music too. Do you like 2", "x": 0.07871199110020793, "h": 0.011485811295492138, "y": 0.7941279070643108, "w": 0.16636850992838542}, {"y": 0.7941279072750668, "x": 0.33273702903149355, "text": "t? What kind of", "h": 0.011485811295492138, "w": 0.11449016147189672}, {"y": 0.8091471118121946, "w": 0.18783542209201387, "text": "music are you interested 3", "x": 0.07692307795220409, "h": 0.012955776173285189}, {"text": "n? Please say", "y": 0.8104172653448402, "w": 0.09667864481608074, "h": 0.012944539324901617, "x": 0.3541651507948815}, {"y": 0.825636281429441, "h": 0.011485811295492138, "text": "thank you to your mum but I want to eat real English", "w": 0.3756708441840278, "x": 0.07692307898133133}, {"text": "food when I am in England. 4", "x": 0.07692308224741456, "y": 0.8409156977619855, "h": 0.011417334738190914, "w": 0.20572450425889754}, {"y": 0.8409156974482472, "text": "y hello to your", "h": 0.013909883895075253, "w": 0.10733452690972223, "x": 0.37030411321776857}, {"text": "parents. See you s", "x": 0.07692307606378296, "w": 0.12701252407497832, "y": 0.8560901165227244, "h": 0.012732085312316574}, {"x": 0.29338103734786225, "y": 0.8573546514769199, "w": 0.17889087253146702, "h": 0.01146755085525103, "text": "_n. I hope you like Greece."}, {"w": 0.2504472181532118, "text": "SHOW WHAT YOU'VE LEARNT", "x": 0.5438282710665068, "y": 0.041615523489549784, "h": 0.011494941328406732}, {"h": 0.010234971700592574, "w": 0.3667262776692708, "x": 0.5366726430079406, "text": "4 You want to write to someone from a different", "y": 0.06828488387932287}, {"w": 0.35599283854166663, "text": "country. You see this message on a website and", "h": 0.012955776173285189, "x": 0.5545617143308365, "y": 0.08205324909470274}, {"text": "decide to write an email to Marysa.", "x": 0.5545617268259883, "h": 0.01138537906137181, "y": 0.09736462106213754, "w": 0.2665473937988282}, {"x": 0.5545617254303106, "h": 0.012686434773331584, "y": 0.11503158818965144, "w": 0.30411448160807286, "text": "• Start and finish the email appropriately."}, {"y": 0.12898255806826903, "x": 0.5509838938835082, "text": "• Tell Marysa about yourself (age, town, family).", "h": 0.013923579131653152, "w": 0.34883721245659727}, {"y": 0.14289244227974954, "w": 0.2933810424804687, "h": 0.012645348314774147, "x": 0.579606434931501, "text": "Ask questions about her life and hobbies."}, {"x": 0.554561731957304, "w": 0.3649373711480035, "text": "• Tell her about your interests and how you spend", "h": 0.011536027412552254, "y": 0.15806686059483419}, {"w": 0.10554561191134981, "x": 0.5778175335568475, "y": 0.17195848383864096, "text": "your free time.", "h": 0.011399073923537888}, {"h": 0.010116278651819414, "text": "HI!", "y": 0.41729651188746236, "w": 0.030411449008517777, "x": 0.5688729871773154}, {"y": 0.43247092997161213, "w": 0.3023255750868056, "h": 0.013914448724326735, "x": 0.5688729913251124, "text": "My name is Marysa. I'm a Dutch girl"}, {"h": 0.011549722649130153, "w": 0.3005366685655382, "text": "from a small town near Amsterdam.", "y": 0.44874097486395714, "x": 0.5688729870052452}, {"w": 0.33273701985677073, "h": 0.012645348314774242, "x": 0.5688729969141906, "text": "1 am 18 years old. I speak Dutch, English", "y": 0.4628197676398512}, {"h": 0.01149494132840683, "x": 0.5688729949422661, "text": "and German, I want to find friends from", "y": 0.47661552351484043, "w": 0.33094811333550345}, {"text": "all over Europe.", "w": 0.1341681586371528, "y": 0.4919040699898923, "x": 0.5688729882127296, "h": 0.011408204330864402}, {"text": "Please write to me at marysaiz@polinl", "y": 0.5095938630883025, "x": 0.5688729915220204, "w": 0.32558139377170137, "h": 0.012659043551352046}, {"w": 0.2593917677137587, "h": 0.011408204330864305, "text": "SHOW THAT YOU'VE CHECKED", "y": 0.5841877256033713, "x": 0.533094816411457}, {"w": 0.275491943359375, "h": 0.012677304366005072, "y": 0.6107703490562757, "text": "Finished? Always check your writing.", "x": 0.5330948177359356}, {"w": 0.2790697564019098, "x": 0.5330948196779104, "h": 0.014133574007220224, "y": 0.6246254514434639, "text": "Can you tick / everything on this list?"}, {"text": "In my email invitation:", "y": 0.6499709304202339, "w": 0.16815741644965276, "h": 0.01155885305645657, "x": 0.5313059092617568}, {"y": 0.672732558353555, "h": 0.011567983089371358, "w": 0.2933810424804688, "text": "• I have started the email correctly, e.g.", "x": 0.534883723363224}, {"x": 0.5598693748678883, "h": 0.011728764897219133, "text": "HiMarysa", "y": 0.687733001195656, "w": 0.06630776299370655}, {"text": "• I have given personal information about myself", "x": 0.5330036324016949, "w": 0.35982340494791665, "y": 0.7042944532500706, "h": 0.015096216072674688}, {"h": 0.012645348314774147, "w": 0.19499104817708335, "y": 0.7207848839505344, "text": "- my town, family, age, etc.", "x": 0.5581395409606533}, {"y": 0.7422819770267018, "text": "• I have asked Marysa about herself.", "x": 0.5330948160742994, "h": 0.011508636564984633, "w": 0.2683363003200955}, {"x": 0.5330948169887274, "w": 0.2576028611924913, "y": 0.7663081397961014, "h": 0.012645348314774147, "text": "• I have talked about my interests."}, {"w": 0.32558139377170137, "y": 0.7903023464936396, "x": 0.533094817022915, "h": 0.01141276953452761, "text": "• I have talked about my free time activities."}, {"y": 0.8118313954836012, "h": 0.012645348314774147, "w": 0.3363148328993055, "text": "• I have asked Marysa about her interests and", "x": 0.5330948252915516}, {"y": 0.8256185622661691, "x": 0.5563119252629537, "w": 0.0716337500678168, "h": 0.011626247189105203, "text": "free time."}, {"h": 0.011476680888165624, "y": 0.8484070397911644, "x": 0.5330948248206917, "w": 0.31127010769314234, "text": "• I have used the Present Simple correctly."}, {"y": 0.8720565147372679, "text": "e a good trip!", "h": 0.011773940345368938, "x": 0.17078189425465773, "w": 0.10493826972113718}, {"text": "_I the best,", "y": 0.8908948196331492, "h": 0.011773940345368938, "w": 0.07818929884168835, "x": 0.16872427964294187}, {"h": 0.010850054502861473, "x": 0.07595100739732343, "w": 0.03739839765760633, "text": "Sofia", "y": 0.9095459029351282}, {"x": 0.07201646119993324, "w": 0.0246913570827908, "y": 0.9520348838180397, "text": "20", "h": 0.01162790690711002}, {"w": 0.22839504665798604, "y": 0.8720565149310663, "h": 0.011773940345368938, "text": "• I have checked my spelling.", "x": 0.5246913693664801}, {"x": 0.5246913625319493, "y": 0.8952119311835444, "text": "• My text is neat and clear.", "h": 0.013343799058084804, "w": 0.20987653944227425}]
0.5581395436354485, "h": 0.01264534831477405, "text": "B The café is between the bank and the post office."}, {"y": 0.38553249090685293, "h": 0.012955776173285189, "w": 0.2790697564019097, "text": "C The bookshop is opposite the school.", "x": 0.5563506324728674}, {"y": 0.39959302355918264, "x": 0.5563506331590912, "w": 0.3005366685655382, "h": 0.012645348314774242, "text": "D The theatre is next to the railway station."}, {"h": 0.012741215719643087, "y": 0.41340703983309296, "x": 0.556350629440666, "w": 0.20393559773763015, "text": "E The stadium is in the park."}, {"text": "4 Look at the map from Exercise 3. Complete the", "y": 0.43604253117554015, "h": 0.013700858746194661, "w": 0.3634115261501736, "x": 0.5311794598118296}, {"h": 0.011435595178431925, "text": "dialogue with one word in each gap. The first letters", "y": 0.4514389536855319, "x": 0.5563506270362404, "w": 0.37388193766276046}, {"h": 0.011921809399601415, "x": 0.554479531237547, "text": "are given.", "w": 0.0735096316867404, "y": 0.4638138044130751}, {"x": 0.5545617092151514, "y": 0.4843168607579471, "text": "Max: Do you want to meet at my favourite café?", "w": 0.3452593994140625, "h": 0.012713825246487289}, {"text": "Abbie: OK. How do I get to it? I'm coming by train.", "h": 0.012663609129427173, "x": 0.5545617235694067, "w": 0.35420393202039935, "y": 0.4982084836642244}, {"h": 0.011380813483296684, "y": 0.5121366280472324, "x": 0.5527728085575281, "text": "Max:", "w": 0.03756708357069227}, {"x": 0.6100178966561518, "y": 0.5119494583457748, "text": "Come out of the railway station and 't", "w": 0.2540250311957465, "h": 0.012955776173285189}, {"w": 0.07530657450358069, "x": 0.604564960556751, "text": "left. Go ?p", "h": 0.013166809667318737, "y": 0.5257857812063264}, {"y": 0.5272608303026718, "text": "the theatre and then go", "x": 0.7406082262398908, "w": 0.16100179036458329, "h": 0.011431029974768718}, {"x": 0.6064400720030064, "text": "За", "y": 0.5399563954313578, "w": 0.017889086405436183, "h": 0.010116278651819317}, {"w": 0.2415026685926649, "h": 0.01155885305645657, "text": "_ the road. There's a crossing there.", "x": 0.6708407985301432, "y": 0.5412209304887295}, {"x": 0.606440072449781, "y": 0.5538662792574431, "text": "Go *s", "w": 0.041144900851779576, "h": 0.011476680888165624}, {"y": 0.5538662792888339, "text": "on, Sa", "x": 0.7084078734154443, "h": 0.012654478722100659, "w": 0.04293380737304686}, {"y": 0.5551308142467648, "h": 0.010212146056688258, "x": 0.8067978516038453, "w": 0.08050089518229164, "text": "Oak Road."}, {"h": 0.01138081348329678, "text": "•G", "w": 0.021466903686523486, "x": 0.60465116331774, "y": 0.5665116279998124}, {"x": 0.6887298756297237, "h": 0.011545157819878766, "w": 0.23076922946506073, "text": "across the road again and the café", "y": 0.5688763537151926}, {"x": 0.6028622554220133, "w": 0.09838997734917543, "y": 0.5816860468099504, "h": 0.011531462208889044, "text": "is there. It's b"}, {"text": "_ a bank and a post office.", "x": 0.7531305930056336, "h": 0.013909883895075253, "y": 0.5829505812703403, "w": 0.17710196601019967}, {"y": 0.5955731047976279, "text": "Abbie: Great, thanks.", "x": 0.5527728126257098, "w": 0.15205724080403638, "h": 0.010207581227436775}, {"text": "4 hours later...", "w": 0.10206091139051654, "h": 0.011804939736528037, "x": 0.5527262539873201, "y": 0.6181454952585175}, {"text": "Abbie: The train arrived and | started walking but", "x": 0.5527728217517989, "y": 0.6360108306052039, "w": 0.3398926459418402, "h": 0.012695564431834262}, {"text": "I think I went wrong. I came out of the station", "x": 0.6028622691301235, "y": 0.651235465283102, "h": 0.010294318224979204, "w": 0.31305901421440974}, {"text": "and I turned ®r", "x": 0.6046511660288704, "y": 0.6638808141203112, "h": 0.010212146056688258, "w": 0.10375670539008253}, {"x": 0.7656529499491145, "w": 0.1359570651584201, "y": 0.6650631770043458, "h": 0.010207581227436775, "text": ". I went across Park"}, {"x": 0.6044895824245328, "w": 0.3331240
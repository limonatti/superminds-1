27, "x": 0.06251243091529915, "w": 0.13257799784342447, "h": 0.016065299519563037}, {"w": 0.40429338243272567, "h": 0.014133574007220224, "text": "I'm writing to tell you how sorry l am to ... (about) ...", "y": 0.4715117328297476, "x": 0.06261181115394114}, {"w": 0.35957065158420143, "h": 0.016585037079959137, "y": 0.5056678697261272, "text": "Closing formulas: emails and letters", "x": 0.06261180754868655}, {"w": 0.14631749471028643, "x": 0.05832487201508578, "h": 0.019914973685887776, "y": 0.5300150774647708, "text": "Informal phrases"}, {"text": "Best wishes", "y": 0.5526017444582474, "w": 0.09481216430664063, "h": 0.010116278651819317, "x": 0.06261180574918418}, {"y": 0.5790839352334558, "h": 0.015311371841155259, "w": 0.1842575920952691, "text": "Bye for now/See you!!", "x": 0.060822905718912794}, {"x": 0.05903399162198282, "h": 0.012663609129427173, "text": "Love/Take care!/All the best", "y": 0.6069584835272331, "w": 0.22182467990451388}, {"text": "Yours sincerely,", "x": 0.05693129341239477, "w": 0.12966210259331595, "y": 0.6569785763444405, "h": 0.014247910399729653}, {"h": 0.014110297571450795, "w": 0.075208011203342, "y": 0.6852777000697968, "text": "Regards,", "x": 0.05720815991702138}, {"y": 0.08205324889359385, "text": "Disagreeing with opinions", "x": 0.5152057255207801, "h": 0.017845006333361474, "w": 0.2629695807562934}, {"x": 0.5116279156969464, "w": 0.3846153767903646, "y": 0.11254360499623722, "h": 0.015174417977728975, "text": "I disagree that/with .../ I don't agree that/with ..."}, {"w": 0.18067977905273447, "y": 0.13898014447399012, "x": 0.5134168211400012, "h": 0.015311371841155259, "text": "I am totally against ..."}, {"y": 0.16685469313713316, "h": 0.011444725211346617, "w": 0.18425759209526904, "text": "I see your point but ...", "x": 0.5134168180549296}, {"y": 0.19154692000951604, "x": 0.5131520497022789, "w": 0.24745001898871521, "h": 0.017240749791210746, "text": "I'm afraid I can't agree with ..."}, {"h": 0.0173306408341611, "y": 0.2
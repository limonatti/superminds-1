[{"x":0.061728394482934261,"text":"2.4","w":0.08436214023166233,"h":0.046511627628440189,"y":0.049418604848570635},{"y":0.031764623366047684,"text":"READING","w":0.15031977335611979,"x":0.20158908566514078,"h":0.020773079181952592},{"y":0.074648339283843623,"w":0.070956755744086386,"h":0.011299165489160878,"text":"Matching","x":0.19713905296328038},{"h":0.011796757789384271,"y":0.095761381638007959,"w":0.16049382527669268,"text":"I can identify specific","x":0.19547325397687995},{"w":0.21399176703559028,"text":"information in a short article","h":0.01162790690711013,"y":0.10901162801446818,"x":0.19547324960977694},{"y":0.1235465117111737,"w":0.14197530110677081,"h":0.011627906907110019,"text":"on a familiar topic.","x":0.19753087033138816},{"w":0.010288065804375537,"text":"1","x":0.059670781809746387,"y":0.16860465121082369,"h":0.010174418169437871},{"x":0.076131690935852162,"h":0.013106495095197568,"text":"SPEAKING Look at the photos. Think of two","w":0.33744856092664938,"y":0.16860465117107837},{"text":"typical food items for each place. Discuss with","y":0.18313953532805516,"w":0.33950615776909721,"x":0.086419761890485669,"h":0.013092803805364706},{"y":0.19893883891400543,"text":"a partner.","w":0.072121607462565088,"x":0.086367179745014025,"h":0.010552554527294644},{"y":0.22093023260617262,"text":"2","h":0.01017441816943776,"x":0.059670782059892152,"w":0.0123456785413954},{"w":0.36213989257812501,"h":0.011627906907110019,"text":"Read texts A-C quickly. Do they mention any of","x":0.076131693765807362,"y":0.22238372101349924},{"text":"the food you talked about?","w":0.20370369805230032,"h":0.013081394896215293,"y":0.23546511628735745,"x":0.08436214037714207},{"x":0.074074081060581734,"y":0.2601744184456698,"w":0.28395060221354168,"h":0.011803603434300647,"text":"Match texts A-C with text types 1-3."},{"text":"1 An extract from a tourist information book","h":0.010318169975580105,"x":0.086419750652113339,"w":0.31069959852430556,"y":0.27747252742066975},{"w":0.23868311564127603,"h":0.011785349254518351,"text":"2 An advertisement for an activity","x":0.086419763029841945,"y":0.29199372042965677},{"text":"3 An informal email to a friend","x":0.086419756188814117,"y":0.30651491376788598,"h":0.010345551058111968,"w":0.21604938083224826},{"x":0.053497942695473248,"h":0.01162790690711013,"y":0.34011627898830543,"text":"1) 1.52","w":0.055555555555555559},{"y":0.38069073824028454,"w":0.29629628499348953,"h":0.026295133437990614,"text":"TALING CHAN","x":0.049382723346876579},{"x":0.48353909947179219,"h":0.014546292543036965,"w":0.20370369805230037,"y":0.053767660672879081,"text":"EXAM FOCUS Matching"},{"y":0.076923077181924704,"text":"4 Read the texts again. Match questions 1-7 to places","x":0.48148148346012554,"w":0.40946502685546871,"h":0.013343799058084804},{"w":0.24485595703125007,"y":0.091444270030802577,"h":0.011773940345368938,"text":"A-C. There is one extra question.","x":0.50823045492058905},{"y":0.11028257440705158,"x":0.50617285059075989,"text":"1 Which market can you visit every day?","w":0.28395060221354163,"h":0.01181044870493364},{"w":0.33950615776909721,"y":0.12354651157551477,"x":0.506172850436439,"text":"2 Where do you have to pay to visit the market?","h":0.011627906907110019},{"y":0.13808139531097985,"x":0.5061728518616978,"w":0.33539093017578125,"h":0.01162790690711013,"text":"3 Where can you walk round the market or take"},{"h":0.011627906907110019,"y":0.15261627891078611,"x":0.50617284371192217,"text":"another form of transport?","w":0.18724278767903646},{"x":0.50823045542144896,"text":"4 In which text does the writer mention food for","y":0.16715116296469967,"w":0.33744856092664932,"h":0.010242871624334238},{"text":"people who don't eat meat?","y":0.18445839875416215,"w":0.19753085666232639,"h":0.011773940345368938,"x":0.50823045636175757},{"w":0.37448557535807292,"x":0.50823046647048331,"h":0.010331860516846092,"text":"5 In which text does the writer describe his\/her food?","y":0.19767441876169578},{"h":0.013081394896215293,"w":0.36213989257812507,"x":0.50823046543933259,"y":0.21220930271540983,"text":"6 Which market is very expensive but good to visit?"},{"w":0.35390947129991313,"h":0.011627906907110019,"x":0.50617283194263618,"y":0.22674418611766589,"text":"7 Which market is the best place to visit if you like"},{"w":0.06598623063829212,"h":0.012037644768060685,"text":"seafood?","x":0.5184472144485438,"y":0.23816722405834423},{"x":0.48148148160398502,"text":"5","y":0.27180232596857568,"w":0.010288065804375579,"h":0.01017441816943776},{"y":0.27180232561621243,"h":0.011627906907110019,"w":0.25102879842122394,"x":0.50617284777155525,"text":"SPEAKING Discuss the questions."},{"y":0.28924418613946823,"text":"1 Which place would you most like to visit? Why?","w":0.34773661295572911,"h":0.011776221977485402,"x":0.50617284230814374},{"text":"2 Which food sounds most interesting? Why?","w":0.32098765055338541,"x":0.50617284540231944,"y":0.30376766078409789,"h":0.011773940345368938},{"x":0.60905349799249586,"text":"B","y":0.36191860483132876,"w":0.014403292338053375,"h":0.011627906907109908},{"h":0.011773940345368938,"x":0.62551440468714004,"text":"Hi Sam!","w":0.063786006503634973,"y":0.38226059655197475},{"h":0.014598773075984006,"text":"How are you? I'm still in Finland.","w":0.25102879842122394,"x":0.62551440691078719,"y":0.40109890074312982},{"w":0.27366255018446184,"y":0.41860465129825863,"x":0.62551440734089658,"text":"Today we're at Kauppatori Market -","h":0.013106494346630582},{"x":0.62551440202214759,"y":0.43445839911653295,"h":0.013343799058084693,"w":0.27160493638780381,"text":"it's right next to the sea! It's one of"},{"h":0.01162790690711013,"x":0.62551440412659964,"y":0.45203488387202628,"text":"the best places in the world to eat","w":0.26543209499782983},{"x":0.62551440355651622,"text":"fresh fish. The cooks all use local","h":0.011627906907110019,"y":0.46802325588510785,"w":0.25514402601453989},{"w":0.27572016398111976,"text":"ingredients, of course. The market's","y":0.48390894789038108,"h":0.013343799058084693,"x":0.62551440590381591},{"x":0.62551440525202329,"w":0.25308641221788186,"text":"got around thirty food stalls and","h":0.014637563067665282,"y":0.50145348887295427},{"h":0.013343799058084804,"w":0.27777777777777779,"text":"some have got covered areas where","y":0.51726844611613076,"x":0.62551440676440317},{"w":0.27572016398111987,"h":0.011819575607682986,"y":0.53488372108132876,"x":0.62551440105470768,"text":"you can sit. We can watch the boats"},{"y":0.55087209317689234,"text":"from our table! I've got grilled salmon","w":0.29423868815104171,"x":0.62551440372283296,"h":0.013099649450281081},{"y":0.56671899530191838,"h":0.014676353059346448,"x":0.62345679932460452,"w":0.29218105740017353,"text":"with potatoes and it's really delicious"},{"y":0.58281004740032749,"h":0.013120184887896458,"text":"(better than fast food!!). Later, I want","x":0.62757201806512009,"w":0.28600823296440969},{"h":0.013131593797045982,"w":0.24691357082790799,"x":0.62551440491526422,"y":0.60029069795523538,"text":"to buy some fruit from the food"},{"x":0.62551440097736632,"text":"market - I hope they speak English!","y":0.61773255860578935,"h":0.014534882885320677,"w":0.27777777777777779},{"text":"Love, Anna","w":0.084412180582682295,"h":0.011810468167674837,"y":0.63799011466433675,"x":0.62754699697165106},{"text":"ome and visit the Taling Chan","y":0.68168604640109609,"h":0.011799039795784227,"x":0.076131685092050094,"w":0.22839506361219619},{"w":0.27609151204427079,"x":0.054014170784992863,"text":"Floating Market here in Bangkok.","y":0.68657886990107309,"h":0.035770464168051519},{"x":0.049382724401584206,"text":"The visit lasts a few hours and is","h":0.011627906907110019,"w":0.23868311564127603,"y":0.71656976741853795},{"x":0.049382727111498131,"w":0.2304526604546441,"text":"available only at the weekend.","h":0.014637563067665282,"y":0.7339089481424369},{"x":0.049382711587818894,"w":0.47325103759765624,"h":0.014548574923720414,"y":0.76452119284347886,"text":"Meet your tour guide at 11 a.m. and go by bus to the floating"},{"y":0.78178963929954659,"x":0.047325109256914792,"text":"market. Walk round and hear about the history of the area. See","w":0.48765431722005204,"h":0.01491365777080067},{"y":0.80087209348951016,"x":0.045267486207494836,"h":0.014669507414430072,"text":"the boats, full of fresh fruit and vegetables, and then stop to eat.","w":0.49588477240668399},{"x":0.04732509733724536,"h":0.016091051805337542,"y":0.81828885395059892,"text":"For lunch you can try traditional Thai dishes like pad thai (noodles)","w":0.51234568277994796},{"text":"and tom yum goong (a spicy soup with a hot, strong taste). Then,","y":0.83575581378307384,"x":0.047325106452086943,"w":0.5,"h":0.015988372371559811},{"w":0.48765431722005215,"y":0.85319767477826991,"x":0.047325109641002679,"h":0.014541728530237052,"text":"get on a boat and travel back through the market for the return"},{"h":0.013117903255779995,"x":0.045267492917209134,"y":0.87205651503777348,"text":"journey. Don't forget your camera!","w":0.27160493638780381},{"y":0.90541601219177048,"h":0.016095615818137454,"x":0.047325114633969809,"w":0.50617282443576384,"text":"Prices start from £20 per person and include a full meal (lunch)."},{"y":0.92296511615797017,"text":"Contact the office to buy your ticket.","h":0.015988372371559811,"x":0.047325112235765389,"w":0.29629628499348959},{"text":"28","y":0.95494186063086528,"h":0.013081394896215404,"w":0.026748970879448788,"x":0.061728395441619913}]
[{"h": 0.011540592616215558, "w": 0.34704827202690974, "x": 0.11806798700383815, "y": 0.03651173275115959, "text": "Read the text and decide which restaurant A-C"}, {"y": 0.0505813958208106, "h": 0.012645348314774147, "x": 0.11806798891042528, "w": 0.3953488159179688, "text": "is best for customers 1-4. One customer doesn't have"}, {"text": "a suitable restaurant.", "w": 0.1556350538465712, "x": 0.11985689362680382, "h": 0.010308013461557103, "y": 0.06556407935272468}, {"h": 0.011522332175974353, "y": 0.08205324897163326, "text": "1 ' love hot food from China and India, I'd like", "x": 0.11985689590345715, "w": 0.3327370198567708}, {"y": 0.09610465129755481, "x": 0.1413237994199245, "w": 0.3023255750868056, "h": 0.012645349063597789, "text": "to try food from a different country in Asia.'"}, {"w": 0.3667262776692708, "y": 0.10992779814739614, "text": "2 I don't eat meat. I think it is wrong to kill animals for", "x": 0.11806798206578227, "h": 0.012732085312316477}, {"y": 0.12392441849650303, "x": 0.13953488069935177, "w": 0.3559928385416667, "text": "food. I don't even like seeing other people eat meat.\"", "h": 0.013909883895075349}, {"w": 0.2933810424804687, "x": 0.12701251501498345, "text": "1 love traditional English breakfasts with", "y": 0.1389801443745493, "h": 0.011499506532070037}, {"w": 0.2307692294650608, "h": 0.01266817395867856, "x": 0.14132379553133362, "text": "sausages, bacon and fried eggs.'", "y": 0.15300872134951699}, {"text": "4 I haven't got a job. I have a lot of time in the", "x": 0.1180679807957753, "y": 0.16565406987059259, "h": 0.012645348314774147, "w": 0.3345259263780382}, {"text": "middle of the day but I haven't got money for food.'", "y": 0.18082848817437366, "w": 0.3506261189778646, "h": 0.013909883895075349, "x": 0.1377459788831606}, {"w": 0.36520314534505205, "y": 0.2035265151976669, "h": 0.014943882119354355, "text": "2 Read the text again. Match questions 1-9 with", "x": 0.09288389425437865}, {"w": 0.3705127970377604, "h": 0.01299
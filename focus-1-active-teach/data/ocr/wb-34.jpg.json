.7294494583984636, "h": 0.012955776173285189, "w": 0.32558139377170137}, {"x": 0.12880143486331763, "h": 0.007587208988864585, "y": 0.744811046636745, "w": 0.07871198018391926, "text": "restaurants."}, {"w": 0.1538461473253038, "x": 0.1288014363105144, "y": 0.7573240072511618, "text": "I've got the chance to", "h": 0.011513201768647938}, {"h": 0.012191131330138947, "w": 0.09142987569173178, "text": "the guitar _", "x": 0.33979490206484153, "y": 0.7583157715397006}, {"x": 0.4597495536570614, "y": 0.7599854653362365, "h": 0.0075872089888644875, "w": 0.039355990091959614, "text": "some"}, {"y": 0.7726308141624624, "h": 0.010212146056688258, "w": 0.15742396036783854, "text": "really good musicians.", "x": 0.1288014392555559}, {"x": 0.10733452636375723, "text": "2", "y": 0.7852761629261299, "h": 0.008851743820341951, "w": 0.008944543202718092}, {"y": 0.7991860465838333, "x": 0.10554561741921342, "h": 0.008851743820341951, "text": "3", "w": 0.008944543202718105}, {"text": "Where do you want to", "y": 0.7851985560822413, "w": 0.15742396036783857, "h": 0.011458420447924517, "x": 0.1270125252424374}, {"y": 0.7864893378740538, "h": 0.010218998542331178, "text": "dinner?", "w": 0.05370586819118922, "x": 0.3917517175141793}, {"text": "My dad always _", "h": 0.013591069211168025, "w": 0.11703126695421007, "x": 0.12841360934057144, "y": 0.7990115272955657}, {"x": 0.3378599877597177, "text": "the meal when we go", "y": 0.7987907747846995, "w": 0.15259441799587675, "h": 0.013419530176513886}, {"y": 0.8142509026719922, "w": 0.28085866292317707, "h": 0.011490376124743525, "x": 0.1288014405777674, "text": "out to a restaurant with the whole family"}, {"h": 0.011499506532070037, "x": 0.1055456169155513, "y": 0.8282703490596598, "text": "4 To get to the toilet,", "w": 0.15921288384331594}, {"y": 0.8282703490145701, "x": 0.3685152106939077, "w": 0.12701251559787324, "h": 0.010116278651819317, "text": "the stairs and turn"}, {"x": 0.12522361507362362, "h": 0.008851743820341854, "text": "left.", "y": 0.8421802327199164, "w": 0.0286225382486979}, {"x": 0.10531285780500386, "w": 0.38147206624348956, "h": 0.01639750092468538, "text": "5 The tables in the restaurant are very big, so you can", "y": 0.8535383700112544}, {"w": 0.010733451843261799, "x": 0.54025044772178, "text": "5", "y": 0.19094476781943912, "h": 0.010116278651819317}, {"y": 0.04552325611227603, "x": 0.5563506256625481, "w": 0.1359570651584201, "h": 0.011403639127201095, "text": "REMEMBER THIS"}, {"h": 0.012659043551352046, "y": 0.07459386316417456, "w": 0.3881931898328993, "text": "The word meal means everything we eat, e.g. for breakfast", "x": 0.556350625805077}, {"h": 0.012955776173285189, "text": "or dinner. Some meals, e.g. dinner, consist of courses, e.g", "y": 0.08833483771927135, "w": 0.3810375637478298, "x": 0.556350632549162}, {"x": 0.5563506301580883, "text": "soup, meat and vegetables, dessert. The word ingredients", "h": 0.012645348314774147, "w": 0.3881931898328994, "y": 0.10242732605336874}, {"text": "means the food items a particular dish is made from, e.g.", "y": 0.1162093861495946, "h": 0.012955776173285189, "x": 0.5563506306807944, "w": 0.37567084418402774}, {"x": 0.5527728186255896, "y": 0.13024709287295655, "w": 0.3881931898328993, "h": 0.013909883895075253, "text": "to make spaghetti bolognese or Yorkshire pudding (a dish)"}, {"text": "we need cheese and tomatoes, or flour, milk and eggs", "x": 0.5545617224131284, "h": 0.011540592616215461, "y": 0.14526173277750407, "w": 0.3667262776692709}, {"x": 0.5525773493934587, "text": "(ingredients).", "w": 0.0916252644856771, "y": 0.1573960478038751, "h": 0.01525150937724203}, {"h": 0.011522332175974353, "x": 0.5635062690828777, "text": "Read REMEMBER THIS. Put the words in bold from", "y": 0.19080324900535425, "w": 0.3738819037543403}, {"x": 0.5635062619518341, "w": 0.34704830593532987, "text": "the text on page 28 under the correct heading.", "y": 0.20611462106529882, "h": 0.01138537906137181}, {"x": 0.5688729846833208, "h"
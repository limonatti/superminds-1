[{"x": 0.1073345273691613, "text": "4.8", "y": 0.005058139273937702, "w": 0.035778172810872394, "h": 0.013909883895075253}, {"y": 0.002355595688464379, "w": 0.26475848727756074, "h": 0.021670566879024595, "x": 0.17889087984703617, "text": "EXAM SPEAKING"}, {"h": 0.013909883895075253, "x": 0.09481217494661028, "y": 0.06702034879755686, "text": "1 In pairs, ask and answer the questions.", "w": 0.30769229465060766}, {"y": 0.08715703980741658, "x": 0.118067978664634, "w": 0.04472271813286674, "h": 0.00902978339350174, "text": "PART 1"}, {"x": 0.11449016263510234, "h": 0.012690999602582876, "text": "Talk about jobs.", "y": 0.1036462094701385, "w": 0.11985688103569878}, {"x": 0.11429692249697407, "w": 0.40106096055772567, "h": 0.01758171393122486, "text": "1 Would you like to work with animals? Why?/Why not?", "y": 0.11713110360541693}, {"w": 0.3598660956488715, "x": 0.1143248948437161, "text": "2 Would you prefer to work for a big company or", "y": 0.13144517610083903, "h": 0.01687113415893671}, {"y": 0.14668604646971733, "x": 0.13774597862443008, "w": 0.16994632297092013, "h": 0.013909883895075253, "text": "a small company? Why?"}, {"h": 0.01675186900885966, "y": 0.1592755456333715, "w": 0.33124867757161464, "text": "3 What jobs do the people in your family do?", "x": 0.11432278474141523}, {"h": 0.016543950621401796, "text": "4 Would you prefer to have a well-paid boring job or", "y": 0.1731362819589214, "w": 0.3864042833116319, "x": 0.11270126113488169}, {"x": 0.13595706751437964, "text": "a badly-paid interesting job? Why?", "h": 0.013909883895075253, "w": 0.24865831163194446, "y": 0.18841569764003505}, {"text": "5 What voluntary work would you like to do? Why?", "y": 0.2020447312933439, "h": 0.016847134359476764, "x": 0.112520100480747, "w": 0.3688435533311632}, {"x": 0.09106068371626738, "y": 0.22375749934254227, "w": 0.2847653537326389, "h": 0.01404009834523674, "text": "2 Look at the photos of the students."}, {"text": "PART 1", "x": 0.11257792249432089, "h": 0.00838147130683882, "y": 0.2436581015421834, "w": 0.046758287217881944}, {"x": 0.11242924541788323, "text": "Take turns to describe the people in the photos.", "w": 0.3529610188802083, "y": 0.258282067093131, "h": 0.016996658726289433}, {"h": 0.0108682608862647, "x": 0.5562037054284836, "text": "PART 2", "y": 0.09067052064701749, "w": 0.050383288065592446}, {"x": 0.55635063291135, "w": 0.14311269124348958, "text": "Talk about people.", "y": 0.1074854653774966, "h": 0.012649913892849272}, {"x": 0.5563506292177581, "h": 0.014133574007220224, "y": 0.12131317672094462, "w": 0.33094811333550345, "text": "1 What does your favourite teacher look like?"}, {"y": 0.135305232777206, "x": 0.558139534974166, "h": 0.012704694839160775, "w": 0.3202146742078993, "text": "2 How often do you go to the hairdresser's?"}, {"x": 0.5581395352710321, "y": 0.14921511640923313, "text": "3", "w": 0.008944543202718092, "h": 0.008851743820341854}, {"y": 0.14909598236423352, "x": 0.5776305900621489, "h": 0.014848645224037522, "w": 0.2543855455186632, "text": "Can you describe your personality?"}, {"text": "4 Who is the kindest person you know? Why?", "w": 0.33308861626519093, "x": 0.5543692511185493, "y": 0.16304086403936371, "h": 0.01619950220472968}, {"text": "5 Are you usually relaxed or energetic? Why?", "x": 0.5545617181980802, "h": 0.014133574007220128, "y": 0.1782400720058374, "w": 0.33094811333550345}, {"y": 0.5181716197513065, "x": 0.10364335057490127, "text": "PART 2", "h": 0.010691644078127241, "w": 0.05031616210937502}, {"y": 0.5339648520028432, "w": 0.4171379937065972, "text": "In pairs, ask and answer the questions about the photos.", "x": 0.10537890161620188, "h": 0.015266820575355989}, {"text": "Student A's photo", "y": 0.5533148143102462, "w": 0.13705523173014322, "h": 0.01698435779943359, "x": 0.103187622709098}, {"y": 0.5689635486312956, "h": 0.015702612752948927, "text": "1 Which girl has longer hair?", "w": 0.21496075100368922, "x": 0.10180099272937165}, {"text": "2", "x": 0.10375670869375375, "y": 0.5842151163512752, "h": 0.008851743820341854, "w": 0.01073345184326173}, {"y": 0.584187725892715, "text": "Who is the tallest person in the group?", "h": 0.014133574007220224, "w": 0.27370303683810765, "x": 0.12880143643336112}, {"text": "3", "x": 0.10375670865356044, "w": 0.008944543202718092, "y": 0.5981250000722055, "h": 0.008851743820341951}, {"x": 0.12701252781917163, "y": 0.5981250004719734, "w": 0.28443647596571175, "h": 0.012759475785472374, "text": "Can you describe the students' clothes?"}, {"w": 0.008944543202718092, "text": "4", "x": 0.10375670865356044, "y": 0.6120348837931358, "h": 0.008851743820341951}, {"x": 0.1037567086311991, "h": 0.010116278651819317, "text": "5", "y": 0.6259447674822298, "w": 0.008944543202718092}, {"text": "Who do you think is the most stylish? Why?", "x": 0.12522361755245412, "h": 0.013909883895075253, "w": 0.30769229465060766, "y": 0.612034883665471}, {"w": 0.29184288872612846, "text": "Do you think these students are friendly?", "x": 0.12509733105600873, "h": 0.015475160550554758, "y": 0.6258746791579172}, {"w": 0.11627906799316406, "x": 0.12343470612864157, "y": 0.6411146208561077, "text": "Why?/Why not?", "h": 0.012649913892849175}, {"text": "Student B's photo", "w": 0.1359570651584201, "h": 0.012700130009909388, "x": 0.5527728102353398, "y": 0.558924418802642}, {"w": 0.36524451361762145, "h": 0.0151482196318974, "text": "1 Does the woman have longer hair than the men?", "x": 0.5543822613046298, "y": 0.5714794525838507}, {"w": 0.20751341078016494, "x": 0.5527728125288204, "text": "2 Who is the tallest person?", "y": 0.5867441860753547, "h": 0.013932709538979664}, {"text": "3 Whose hair do you like best? Why?", "y": 0.5997115606702356, "w": 0.27052837795681417, "h": 0.015152759749966825, "x": 0.5525784476631747}, {"w": 0.3527786254882812, "h": 0.015437970970511835, "text": "4 Do you think these people's clothes are trendy", "x": 0.5525806778415937, "y": 0.614482815753016}, {"y": 0.6269147282247188, "text": "or old-fashioned? Why?", "x": 0.5739870741498745, "w": 0.1705778333875868, "h": 0.015765665954631202}, {"text": "5 Do you think these people are confident?", "x": 0.5527728069307345, "y": 0.643470216426139, "w": 0.3166368611653645, "h": 0.012955776173285189}, {"x": 0.5688729883062905, "text": "Why?/Why not?", "y": 0.657558139821392, "w": 0.11806797451443152, "h": 0.012645348314774147}, {"x": 0.0785580188072413, "text": "3 Read the instructions on your card. In pairs, take turns to role-play the conversation.", "h": 0.016714619522921036, "w": 0.6407174343532985, "y": 0.6758939475858537}, {"text": "Student A", "x": 0.12517439268198322, "y": 0.7041774940711978, "w": 0.07702151828342013, "h": 0.011717686050635459}, {"text": "Student B", "h": 0.011525477609909901, "x": 0.5509615490874042, "y": 0.7068026678703168, "w": 0.07338996039496526}, {"w": 0.32915920681423616, "x": 0.1270125286859051, "h": 0.012955776173285189, "text": "You want to change your hairstyle. Ask your", "y": 0.7294494581371266}, {"x": 0.12343470760980646, "y": 0.7435465115302968, "text": "friend, Student B, for his/her opinion.", "h": 0.013909883895075253, "w": 0.2844364929199219}, {"x": 0.12522361635298837, "y": 0.7612500002106362, "w": 0.2969588555230034, "h": 0.012645348314774242, "text": "• Tell Student B you're thinking of a new"}, {"y": 0.7749909748163144, "w": 0.3184257337782118, "h": 0.012955776173285189, "x": 0.14847943549610598, "text": "hairstyle and ask him/her to help you choose"}, {"h": 0.011440160007683409, "text": "a new style.", "x": 0.14847943083093798, "y": 0.7890697676980319, "w": 0.08407870822482638}, {"x": 0.1234347040826564, "y": 0.8028655232044865, "text": "• Suggest getting a spiky haircut.", "w": 0.24865831163194446, "h": 0.012759476534296018}, {"x": 0.13774598258363077, "w": 0.2093023173014323, "y": 0.8168895351870897, "h": 0.012672739536753588, "text": "Suggest having shorter hair."}, {"w": 0.2915921359592014, "x": 0.12164578884061408, "h": 0.01152689700522574, "y": 0.8319178702173456, "text": "• Show Student B a style you like in the"}, {"h": 0.012645348314774242, "y": 0.8459738374389064, "text": "Students' Book and ask his/her opinion.", "w": 0.2844364929199219, "x": 0.14669052274844685}, {"text": "• Ask if he/she can come to the hairdrescer'e", "y": 0.8597924188960727, "w": 0.33094811333550345, "h": 0.00902978339350174, "x": 0.11985689559074551}, {"h": 0.015288361986621606, "y": 0.7304416697198715, "w": 0.31880401611328124, "x": 0.5507777077306034, "text": "Your friend, Student A, wants your opinion"}, {"y": 0.7447608304977185, "w": 0.30948120117187494, "text": "about changing his/her hairstyle. Answer", "h": 0.012695564431834262, "x": 0.5509839038192504}, {"w": 0.1341681501600478, "y": 0.7599854653724505, "x": 0.5509839056892069, "text": "his/her questions.", "h": 0.011472115684502416}, {"x": 0.5509839070425956, "w": 0.19677995469835075, "h": 0.011435595178431925, "y": 0.7776889536444346, "text": "• Agree to help Student A"}, {"text": "• Say that you aren't sure about the style", "y": 0.7914801443482048, "x": 0.5491949968442433, "w": 0.3005366685655382, "h": 0.011499506532070037}, {"y": 0.8042494001854694, "w": 0.12441658867730032, "h": 0.01435833943019279, "text": "he/she suggests.", "x": 0.5701562018560778}, {"x": 0.5454487892490589, "w": 0.33664876302083324, "text": "• Say that you think the style he/she suggests", "h": 0.016396027988475198, "y": 0.8188991165418489}, {"y": 0.8343451427984929, "h": 0.00934750479481278, "w": 0.05204335106743707, "text": "is cool.", "x": 0.5705793983751506}, {"h": 0.012741215719642991, "y": 0.848407039833093, "x": 0.5474060906188225, "w": 0.2647584872775607, "text": "• Say that the picture looks perfect."}, {"h": 0.011930625891573232, "x": 0.1460376246563325, "text": "with you.", "y": 0.8733951521270932, "w": 0.06594944424099392}, {"x": 0.12126336462972782, "w": 0.33362681070963546, "text": "• Thank Student B and end the conversation.", "h": 0.013496482765281592, "y": 0.8863907792500206}, {"text": "57", "y": 0.9418604650784217, "w": 0.0246913570827908, "x": 0.9094650212528432, "h": 0.01162790690711013}]
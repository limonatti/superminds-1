.1810699597896372, "h": 0.01162790690711013}, {"x": 0.28806584374856004, "y": 0.8995290422915907, "h": 0.011808167072817066, "w": 0.19958847045898437, "text": "young children to play tennis."}, {"text": "Can you put some photos of us in the newspaper?", "h": 0.013081394896215293, "x": 0.1790123516878859, "y": 0.9127906979188982, "w": 0.3230452473958334}, {"x": 0.17283951192116218, "y": 0.9258241757409092, "w": 0.2695473225911459, "h": 0.011773940345368938, "text": "Of course. What time are the lessons?"}, {"h": 0.01162790690711002, "y": 0.8750000001074913, "x": 0.6111111069444446, "w": 0.33333333333333326, "text": "some people like them. I sometimes watch films"}, {"y": 0.8880813954850653, "w": 0.020576131608751047, "h": 0.007267441442660338, "text": "14", "x": 0.6111111114932924}, {"text": "_ TV but not often. I just prefer doing", "x": 0.6563786074145406, "w": 0.2551440260145399, "y": 0.8895348841107587, "h": 0.013133875429162445}, {"y": 0.9040697676049614, "w": 0.25925925360785596, "x": 0.6111111171775534, "text": "exercise. It's great. Run with me later.", "h": 0.01017441816943776}, {"h": 0.01162790690711002, "text": "Ray:", "x": 0.5534979434308673, "w": 0.039094649420844174, "y": 0.9171511627286155}, {"h": 0.011812730337050215, "y": 0.9171511627891775, "text": "Let's run now, to the pizza restaurant.", "x": 0.6111111174658002, "w": 0.2572016398111978}, {"x": 0.11092941204805279, "w": 0.0374004364013672, "text": "Paul:", "y": 0.9254704175939716, "h": 0.009524281021189962}, {"w": 0.0246913570827908, "x": 0.9115226345244483, "h": 0.013081394896215293, "text": "15", "y": 0.9505813954843052}]
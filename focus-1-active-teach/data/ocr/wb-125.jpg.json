[{"x": 0.06618962139129972, "y": 0.011380813812836062, "text": "VOCABULARY BANK", "w": 0.2915921359592014, "h": 0.01896802322098491}, {"text": "PEOPLE", "h": 0.012645348314774147, "x": 0.06261180878892314, "w": 0.07155634562174479, "y": 0.06575581426890031}, {"h": 0.012741215719642991, "y": 0.0871570400438487, "x": 0.06440071634954118, "text": "1 Complete the text with the correct words.", "w": 0.33094811333550345}, {"x": 0.08732592595274127, "y": 0.0994219790658436, "text": "The first letters are given.", "w": 0.18853057861328124, "h": 0.015239029481522833}, {"w": 0.20800789727105035, "x": 0.08919819948225426, "text": "We are family", "h": 0.02625891967800978, "y": 0.13798245895265931}, {"y": 0.16803249091605443, "text": "- but are we the same?", "x": 0.09838997686444635, "w": 0.32021467420789934, "h": 0.020415162454873646}, {"x": 0.08765654335493954, "text": "When there is more than one child in a family, everyone", "y": 0.20611462098859562, "w": 0.3685151841905382, "h": 0.010207581227436872}, {"w": 0.3703040907118056, "h": 0.011517766597899227, "text": "starts looking for similarities and differences", "x": 0.08765653875262444, "y": 0.22129360507593884}, {"x": 0.08765653843544056, "y": 0.2351669675370264, "text": "between them. For example, my two cousins", "w": 0.3685151841905382, "h": 0.011417334363778996}, {"y": 0.2516424420378258, "text": "(my aunt's daughters) are not similar in looks.", "x": 0.08586763841387492, "h": 0.010221276464014675, "w": 0.3720929972330729}, {"y": 0.2668168608898923, "h": 0.01153602703814043, "x": 0.08586763040438351, "w": 0.3703040907118056, "text": "Jo (17) is short, but her sister Anna (18) is really"}, {"h": 0.012663609129427173, "text": "tall. Jo's hair is curly, but Anna's is 's", "w": 0.29159213595920136, "x": 0.0840787105385865, "y": 0.28070848352723315}, {"x": 0.08389030128901305, "h": 0.015287057535742998, "w": 0.2526358371310764, "text": "Jo is well-built, but her sister is 4t", "y": 0.29448510990371174}, {"x": 0.3971377458036468, "w": 0.06082289801703561, "y": 0.2959011628938483, "h": 0.012681869944080102, "text": "-. Their"}, {"text": "styles are different too! Anna loves smart clothes", "x": 0.08586761877217687, "h": 0.010116278651819317, "y": 0.31234011642481707, "w": 0.3703041246202257}, {"y": 0.32742779772074077, "text": "(especially elegant dresses),", "x": 0.08407871289921448, "w": 0.22361358642578122, "h": 0.010207581227436775}, {"text": "while Jo prefers", "w": 0.1502683342827691, "h": 0.010207581227436872, "x": 0.3059033974382219, "y": 0.3274277977628919}, {"text": "3c.", "x": 0.08228980370688488, "y": 0.34015988382408086, "w": 0.01967799504597982, "h": 0.012645348314774242}, {"text": "clothes: jeans and T-shirts. The girls", "x": 0.17531306216542406, "y": 0.34268895377088804, "h": 0.011435594804020104, "w": 0.28085866292317707}, {"text": "look different, but they have similar personalities", "x": 0.08407871661075379, "y": 0.3578633723441485, "h": 0.010116278651819317, "w": 0.36851518419053825}, {"x": 0.08579650427183803, "w": 0.12891521877712675, "y": 0.3711666837687451, "h": 0.012813206132138147, "text": "They are both 4e"}, {"x": 0.2754919560609911, "w": 0.18067977905273436, "y": 0.37296931389567917, "h": 0.011449290415009921, "text": "- - they love sport and"}, {"h": 0.014133574007220224, "y": 0.38553249092275726, "w": 0.23255813598632813, "x": 0.08586762507481442, "text": "being active. They are really 5s"}, {"text": "too, and", "y": 0.3878735886557436, "w": 0.06106974283854166, "h": 0.012058055250222927, "x": 0.3934365059766202}, {"y": 0.4031994584592949, "w": 0.3703040907118056, "h": 0.010303448257893895, "text": "spend a lot of time with their friends. And they", "x": 0.08586763634356044}, {"y": 0.41578839240608534, "text": "are definitely the most °c", "h": 0.015815707595770116, "w": 0.19547971937391495, "x": 0.08383704099090551}, {"x": 0.34168157524266546, "y": 0.41851083040278086, "text": "- young people", "w": 0.11270124647352431, "h": 0.01143102997476862}, {"w"
[{"x": 0.10733452577819028, "h": 0.024026162546894568, "text": "8.", "y": 0.0657558139037745, "w": 0.02862254036797418}, {"text": ".3", "x": 0.12701252161828597, "h": 0.025290696629548293, "w": 0.03935599433051218, "y": 0.06575581429527569}, {"w": 0.008944543202718105, "text": "1", "x": 0.08944543852088305, "h": 0.008851743820341951, "y": 0.1441569769797273}, {"w": 0.35778174506293403, "x": 0.1127012607422359, "y": 0.14408393524443913, "text": "Read the text. Complete gaps 1-4 with the words", "h": 0.012718390075738675}, {"text": "from the box. There are two extra words.", "w": 0.29927130805121527, "h": 0.015380438845940885, "x": 0.11065086491143095, "y": 0.15668782325087208}, {"w": 0.34048563639322915, "h": 0.017270916153807953, "text": "bright clear dry heavy light strong wet", "x": 0.13025581872461606, "y": 0.1823087375478999}, {"w": 0.2224998474121094, "x": 0.10169149776108491, "text": "Extract from Students' Book recording", "y": 0.22036423611582776, "h": 0.015005523039545787}, {"text": "(4) 3.46", "y": 0.22328748729686798, "w": 0.054051513671874996, "h": 0.01118665323360728, "x": 0.3271781793018309}, {"w": 0.3797874959309896, "h": 0.017842210225680253, "text": "P: And here's Nick Newman with the late-night weather.", "x": 0.0981273054501273, "y": 0.24372836924516525}, {"y": 0.2607805663567621, "text": "NN: Good evening. Well, it seems spring's almost here.", "x": 0.09989913487748153, "w": 0.37800587972005206, "h": 0.017620043220933128}, {"text": "Across the British Isles, tomorrow will be warmer,", "x": 0.1286457795702901, "y": 0.274624219966329, "w": 0.3368330552842882, "h": 0.017611016900100345}, {"x": 0.13237925333083794, "text": "but not everywhere...", "y": 0.2895784886754617, "w": 0.1520572408040365, "h": 0.012722955653813801}, {"x": 0.13043855078294198, "text": "So, let's look at the weather in more detail, and", "h": 0.01421296354665649, "w": 0.3061865912543403, "y": 0.3034252775465391}, {"text": "I'll start with the south. In all of southern England,", "x": 0.13033963201564197, "y": 0.3157599640864688, "w": 0.32257161458333333, "h": 0.01617581391592738}, {"text": "tomorrow will be the sunniest day of the week; it will", "h": 0.012686434773331489, "x": 0.1288014488620162, "y": 0.3325315881791137, "w": 0.343470458984375}, {"w": 0.08944543626573351, "x": 0.12880143157643562, "h": 0.012955776173285189, "text": "be dry, with 1", "y": 0.3450947656864269}, {"x": 0.2860188370566998, "y": 0.3449744379531596, "text": "skies and sunshine all day.", "h": 0.014399309072253503, "w": 0.18122372097439238}, {"x": 0.12880143716001802, "y": 0.35912790744871753, "w": 0.19856886121961803, "h": 0.012663609129427173, "text": "In most places, there'll be a 2"}, {"y": 0.3628695159056059, "w": 0.06801326751708986, "h": 0.011484805625268277, "x": 0.39533147014162434, "text": "wind, but"}, {"h": 0.012713825246487384, "text": "it will still feel quite warm; temperatures will be", "x": 0.12880143255168536, "y": 0.3729693140271788, "w": 0.3202146742078993}, {"x": 0.12701252427783694, "y": 0.38694767472197333, "text": "around eighteen degrees in most of the area and", "w": 0.3363148328993055, "h": 0.012718390075738675}, {"x": 0.1270125276856972, "w": 0.2057245042588976, "y": 0.4008438628268677, "h": 0.011394509094286501, "text": "will get to twenty in Cornwall."}, {"w": 0.33320383707682294, "x": 0.1267686477740138, "h": 0.016777990974674133, "y": 0.412424349697142, "text": "Across Wales and the Midlands, the morning will"}, {"h": 0.012645348314774147, "y": 0.4286773258173222, "text": "be foggy, but the fog should soon clear. After", "w": 0.31305901421440974, "x": 0.1270125353793783}, {"text": "that we can expect a sunny day with some cloud.", "y": 0.4424593861390568, "w": 0.3363148328993056, "h": 0.012955776173285189, "x": 0.12522362532136683}, {"h": 0.0187354475668622, "y": 0.45343726224072395, "w": 0.3387724134657118, "x": 0.1248897841922132, "text": "There will be a few showers with the possibility of"}, {"y": 0.4666329176323684, "w": 0.3369700113932292, "text": "thunder in the late afternoon. The morning won't", "h": 0.018659358093454502, "x": 0.124901120678248}, {"w": 0.34231631808810764, "y": 0.4810641730504426, "x": 0.12488163554172148, "text": "be very warm - only eight degrees, I'm afraid. But", "h": 0.018169571983254782}, {"x": 0.12343472371706538, "w": 0.34525936550564235, "h": 0.012645348314774147, "y": 0.49696220960569426, "text": "it should get warmer during the afternoon and the"}, {"text": "temperature will rise to fourteen degrees.", "y": 0.5119494581877079, "x": 0.12343471612750935, "w": 0.2826475694444444, "h": 0.012955776173285286}, {"y": 0.5232713438613081, "w": 0.3315595160590278, "h": 0.01739885343110949, "text": "In the north of England, Saturday will be a windy", "x": 0.12314126701282413}, {"x": 0.12161211330364372, "w": 0.1038240729437934, "text": "day, and that?", "h": 0.014162924900812343, "y": 0.5385653400478476}, {"h": 0.014956878703423795, "w": 0.17426132202148437, "x": 0.2930888986336294, "y": 0.5390764143065381, "text": "west wind will bring rainy"}, {"y": 0.550043594368943, "h": 0.01721163327943543, "x": 0.12320527067314054, "w": 0.32073933919270836, "text": "weather from the Atlantic. It will be cloudy with"}, {"text": "showers most of the day but there will be some", "w": 0.323792487250434, "x": 0.12164579896870059, "h": 0.012645348314774147, "y": 0.5665116281429037}, {"h": 0.011531462208889044, "y": 0.5816860467677994, "text": "sunny moments. Temperatures will be around", "x": 0.11985689196852575, "w": 0.31305901421440974}, {"y": 0.594331395641668, "x": 0.12164579655862162, "w": 0.3452593994140625, "h": 0.012645348314774242, "text": "thirteen degrees, but it will feel colder in the wind."}, {"w": 0.33152835422092014, "y": 0.6056534598485939, "text": "Now for Scotland and Northern Ireland. Well, it's", "x": 0.12134857222998606, "h": 0.016977724719133648}, {"y": 0.6206994583564102, "x": 0.12164580403906926, "w": 0.34525936550564235, "text": "definitely not spring here yet. There will be a lot of", "h": 0.014133574007220224}, {"w": 0.3492163764105903, "x": 0.12141716019797583, "text": "cloud around and quite a lot of rain. The Highlands", "y": 0.6351823265405164, "h": 0.01576519045158413}, {"w": 0.31157636854383686, "h": 0.013956507156041584, "x": 0.1197307369434377, "text": "will have the wettest weather. The rain will be", "y": 0.6484225114665552}, {"text": "there, and high up in the mountains", "x": 0.19677996782515203, "y": 0.6638808141894152, "h": 0.012645348314774147, "w": 0.2450804985894097}, {"text": "it may still snow tonight and tomorrow night.", "y": 0.6776263535674408, "w": 0.3059033881293403, "h": 0.012955776173285189, "x": 0.11806798775554446}, {"w": 0.3134765285915799, "y": 0.6903459990310233, "h": 0.015589050644141223, "text": "Temperatures at best around eleven degrees.", "x": 0.11784409083082172}, {"w": 0.24508049858940972, "h": 0.012745780548894378, "text": "WORD STORE 8D | The weather", "y": 0.7282716610082021, "x": 0.0697674450553249}, {"x": 0.06966526053940764, "w": 0.388407728407118, "text": "2 Complete the collocations with the words from the", "y": 0.7484373642370669, "h": 0.013268215372243953}, {"h": 0.01156399897289624, "text": "box in Exercise 1.", "x": 0.09282353188821592, "y": 0.7624129115096231, "w": 0.12744127909342445}, {"h": 0.010131928318244006, "x": 0.0928637588814528, "text": "sunshine:", "w": 0.06650861952039931, "y": 0.7795779311646287}, {"y": 0.7827470931951249, "w": 0.04293381161159937, "x": 0.2862254023158461, "h": 0.011380813483296684, "text": "bright"}, {"h": 0.011555269186247082, "y": 0.7965697490881248, "x": 0.08939941800974821, "text": "skies:", "w": 0.0430258517795139}, {"y": 0.8307994189822298, "h": 0.010116278651819317, "x": 0.0894454382741699, "text": "wind:", "w": 0.04114490085177952}, {"y": 0.8004505815727095, "h": 0.010266927377411679, "x": 0.3774597501950796, "w": 0.08050089518229164, "text": "(no clouds)"}, {"text": "cloudy / overcast (clouds)", "x": 0.2862253994195665, "w": 0.17352415296766494, "h": 0.010116278651819317, "y": 0.8168895351432763}, {"text": "strong", "x": 0.2844364947573591, "w": 0.04472271813286677, "h": 0.010116278651819317, "y": 0.8345930235912417}, {"w": 0.5192861599392361, "h": 0.02347395898633057, "x": 0.22157467988724408, "y": 0.03875698397921442, "text": "LISTENING LANGUAGE PRACTICE"}, {"h": 0.017916994499385604, "x": 0.21779568479469213, "y": 0.07721089067507382, "text": "The weather • word building", "w": 0.21381898668077254}, {"text": "REMEMBER BETTER", "y": 0.08833483766868999, "h": 0.012955776173285189, "w": 0.159212883843316, "x": 0.5420393557348715}, {"y": 0.11145175667219125, "x": 0.5418064296812718, "text": "Learning antonyms can help you keep talking about a topic", "w": 0.3832389662000868, "h": 0.016054687938965688}, {"h": 0.013909883895075253, "w": 0.32558139377170137, "text": "even if you forget a word which you want to use.", "x": 0.5420393526669222, "y": 0.1251889531694682}, {"h": 0.015363674181032717, "text": "Compare these two students trying to say that", "x": 0.5418044238429445, "y": 0.13932725711399363, "w": 0.3099104139539931}, {"text": "the wind was light.", "y": 0.15427325602797368, "h": 0.011403639127201192, "x": 0.5402504527258098, "w": 0.1270125155978733}, {"w": 0.3385215928819445, "h": 0.015810320558100367, "x": 0.5417758248387391, "text": "The wind was very er ... er ... weak.... er low ... er soft", "y": 0.17276848860072913}, {"x": 0.878354205729214, "y": 0.17829941863997442, "text": "...er", "w": 0.03935599009195967, "h": 0.008851743820341854}, {"text": "The wind was very ... it wasn't strong at all.", "w": 0.26510691324869795, "x": 0.5400729637346252, "y": 0.18706619884400874, "h": 0.014421514690137584}, {"y": 0.20682699157558312, "h": 0.015837917706596344, "w": 0.35110782199435764, "text": "Complete the second sentence in each pair using", "x": 0.5489595362378101}, {"h": 0.014534482232930366, "y": 0.22087501501809245, "x": 0.5469127934125919, "w": 0.15298182169596364, "text": "the correct antonym."}, {"y": 0.23899709295725893, "h": 0.013909883895075253, "text": "There was pleasant, light wind, so we weren't too", "x": 0.5706619093702635, "w": 0.3363148328993055}, {"x": 0.5706618982858862, "text": "hot on the beach.", "h": 0.010207581227436775, "y": 0.25283393485993494, "w": 0.12164579603407122}, {"y": 0.26681686075794725, "x": 0.5706618967375124, "w": 0.3452593994140625, "h": 0.012713825246487289, "text": "The wind wasn't strong and it was cool on the beach."}, {"text": "1", "h": 0.008851743820341951, "x": 0.5456171738100329, "w": 0.010733451843261688, "y": 0.280726744258252}, {"w": 0.3452593994140626, "y": 0.2807084838365988, "x": 0.5670840776632727, "h": 0.015311371841155162, "text": "Wake up and look out of the window. The sky isn't"}, {"y": 0.2944494581560946, "text": "cloudy at all.", "w": 0.08944543626573354, "x": 0.5670840808385107, "h": 0.012955776173285189}, {"x": 0.5670840751665749, "text": "Wake up and look out of the window. The sky is", "w": 0.32737030029296876, "y": 0.30854651184697335, "h": 0.012645348314774147}, {"y": 0.32206068642574753, "w": 0.07895914713541663, "h": 0.013436766600350718, "x": 0.566960498971805, "text": "beautifully."}, {"y": 0.3350250254175051, "w": 0.35992204454210064, "text": "2 I don't need a coat. It's raining but it's a light rain.", "x": 0.5436648168521091, "h": 0.015173855611133219}, {"h": 0.01525863368588671, "text": "I don't need a coat. The rain isn't very _", "x": 0.5668049729544895, "y": 0.34794947105525714, "w": 0.2653416442871094}, {"x": 0.5668828149418124, "text": "The weather in France wasn't great but, fortunately,", "w": 0.35281677246093746, "h": 0.015383298603636212, "y": 0.3628380036120058}, {"x": 0.5635062614833224, "h": 0.01266817395867856, "y": 0.37807310481825795, "w": 0.07334526062011726, "text": "it was dry."}, {"y": 0.39066690198322446, "x": 0.5669105010399198, "h": 0.015013146813595666, "text": "The weather in France wasn't great but, fortunately,", "w": 0.3509600490993924}, {"text": "it wasn't", "x": 0.565295169256355, "y": 0.40591569789520693, "w": 0.05724508073594825, "h": 0.008851743820341951}, {"y": 0.4185610466051317, "text": "4", "x": 0.5420393565023406, "h": 0.0075872089888644875, "w": 0.010733451843261688}, {"text": "There was light snow but it was safe to drive.", "y": 0.41851083069793654, "x": 0.5652951804433797, "w": 0.30590338812934026, "h": 0.012695564431834262}, {"h": 0.016082550919873602, "y": 0.4304309419537128, "text": "It was safe to drive because the snow wasn't very", "x": 0.5650803056176396, "w": 0.3332140774197049}, {"y": 0.47317323281294166, "h": 0.019110880810431184, "text": "VOCABULARY PRACTICE | Word building 1", "x": 0.5148709113211432, "w": 0.3280196465386285}, {"w": 0.39713772243923606, "x": 0.5169946401220636, "h": 0.013909883895075253, "text": "3 Look at the vocabulary in lesson 8.3 in the Students'", "y": 0.49569767415765864}, {"x": 0.5402504490800687, "text": "Book. Complete the sentences with the correct form", "y": 0.5107716606656262, "h": 0.011481246091828833, "w": 0.37388193766276046}, {"x": 0.5402504553791299, "h": 0.011508636564984633, "y": 0.5247819769950886, "w": 0.17173522949218756, "text": "of the word in brackets."}, {"w": 0.13416815016004768, "x": 0.5617173579253429, "y": 0.5424854654938578, "text": "A: Where's Verona?", "h": 0.010294317850567286}, {"h": 0.015315936670406646, "w": 0.20751341078016494, "text": "B: It's in northern Italy. (north)", "x": 0.5581395393837483, "y": 0.5551308142127551}, {"x": 0.5384615421753196, "y": 0.5703052328193571, "h": 0.012704694839160775, "w": 0.3237924872504341, "text": "1 A: My cousins have a holiday house in Brest."}, {"y": 0.5829505815672179, "h": 0.011444725211346617, "w": 0.144901614718967, "text": "B: Oh? Where's that?", "x": 0.5599284423338463}, {"x": 0.5580857565837424, "text": "A: It's in", "y": 0.5979709012245373, "h": 0.010424476513363402, "w": 0.057352638244628884}, {"y": 0.5981250002511252, "x": 0.7066189609891961, "h": 0.010116278651819317, "text": "France. (west)", "w": 0.09481216430664063}, {"text": "2 A: Where are you going for your holiday this year?", "y": 0.6105257743926197, "w": 0.36523101806640623, "h": 0.014725179173025417, "x": 0.5365137099775754}, {"y": 0.6231639023305213, "h": 0.01572856997755033, "text": "B: I'm not sure where exactly yet, but it'll be", "w": 0.299240247938368, "x": 0.5596814843375802}, {"text": "somewhere warm in", "h": 0.011467550855250933, "w": 0.1484794277615018, "x": 0.57602861995944, "y": 0.6398546514189621}, {"h": 0.01146755085525103, "w": 0.11091233995225691, "x": 0.7996422184555949, "text": "Europe. (south)", "y": 0.6398546512082063}, {"w": 0.19320214165581595, "text": "3A: Does it rain a lot in the", "h": 0.010207581227436872, "x": 0.5348837258626107, "y": 0.6525000001773607}, {"text": "part of the", "x": 0.810288557456613, "h": 0.011926296351188415, "y": 0.6534917934935685, "w": 0.06994166904025612}, {"x": 0.5723591506014807, "h": 0.0133640228712171, "y": 0.6660505467761417, "w": 0.0967843797471788, "text": "country? (east)"}, {"y": 0.6803197673421426, "x": 0.5563506290778454, "text": "B: No, actually. It's very dry there.", "h": 0.013909883895075253, "w": 0.23076922946506073}, {"y": 0.7030813956622983, "w": 0.32915920681423616, "h": 0.015174417977728975, "x": 0.5080500883639016, "text": "VOCABULARY PRACTICE | Word building 2"}, {"x": 0.5098390139503282, "w": 0.3971377224392362, "text": "4 Look at the vocabulary in lesson 8.3 in the Students'", "h": 0.012955776173285189, "y": 0.7231678701264979}, {"w": 0.24015616522894967, "x": 0.532889085524224, "y": 0.7367538896688851, "text": "Book. Choose the correct option.", "h": 0.013734441991317162}, {"h": 0.015937915622972865, "text": "1 It's very wind / windy today. Be careful when you drive.", "y": 0.753553907338816, "w": 0.3743091159396701, "x": 0.5328756692296255}, {"y": 0.7681806842983406, "w": 0.3151267496744792, "h": 0.013386861993947959, "x": 0.5329506981541533, "text": "2 The sun / sunny is shining. It's a beautiful day!"}, {"h": 0.013909883895075253, "w": 0.35062611897786455, "text": "We get a lot of fog./ foggy here because of the lake.", "y": 0.78274709295199, "x": 0.542039351155075}, {"w": 0.314847920735677, "h": 0.014133574007220224, "x": 0.5420393641044335, "text": "It's very cloud / cloudy. Do you think it will rain?", "y": 0.7965839347570502}, {"h": 0.008851743820341951, "x": 0.5313059038011455, "text": "5", "y": 0.8105668607954977, "w": 0.008944543202718092}, {"text": "It may rain / rainy later, so take a coat.", "w": 0.2540250311957466, "y": 0.8105668607212878, "x": 0.54203935852258, "h": 0.011536027412552254}, {"text": "6", "y": 0.8244767445164278, "x": 0.5313059038011455, "w": 0.008944543202718092, "h": 0.008851743820341951}, {"w": 0.343470458984375, "h": 0.012663609129427173, "text": "It was a fog / foggy morning when Dad crashed into", "y": 0.824458483632611, "x": 0.545617191259154}, {"w": 0.14311269124348958, "h": 0.010303448257893895, "y": 0.8381994585098763, "text": "the car in front of him.", "x": 0.5527728153800441}, {"w": 0.2540250311957465, "x": 0.52772809580642, "h": 0.013909883895075253, "y": 0.8510319766729201, "text": "7 It's a horrible, rain / rainy day today."}, {"text": "day / weather:", "w": 0.10493826972113716, "y": 0.8982558137945071, "x": 0.08847736647688, "h": 0.01162790690711002}, {"h": 0.014534882885320677, "w": 0.03497942394680448, "x": 0.281893003690178, "text": "light", "y": 0.8822674420965839}, {"h": 0.013145285086878844, "x": 0.28395061750949935, "text": "wet (rain)", "y": 0.901098900835066, "w": 0.06378600650363497}, {"x": 0.3765241406583741, "w": 0.05765130784776473, "text": "(no rain)", "h": 0.01028272383254214, "y": 0.918550498379917}, {"x": 0.5493827189764747, "w": 0.07201645745171437, "text": "every day.", "y": 0.8806907380133444, "h": 0.010297633789397853}, {"w": 0.39125430636935754, "x": 0.5245316426785317, "h": 0.014392453797009486, "text": "9 What a lovely day. There isn't a cloud / cloudy in the sky.", "y": 0.8921230649813308}, {"h": 0.013081394896215293, "text": "10 There will be a strong wind / windy all day. Great for", "x": 0.5185185201658818, "y": 0.9069767443881326, "w": 0.3909464857313367}, {"x": 0.5514403294383526, "w": 0.08436214023166233, "y": 0.9200581393759023, "text": "windsurfing.", "h": 0.01162790690711013}, {"text": "99", "y": 0.9404069768069796, "w": 0.0246913570827908, "h": 0.013081394896215293, "x": 0.8827160495964647}]
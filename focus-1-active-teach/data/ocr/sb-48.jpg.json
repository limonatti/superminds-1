[{"y":0.42568186236123795,"x":0.036339733905529761,"w":0.18657979329427082,"h":0.043985112308520091,"text":"People"},{"x":0.034979426776767686,"w":0.27366255018446184,"text":"You can't judge a book by its cover.","y":0.47959183698218932,"h":0.014594209063184205},{"y":0.50103601238618334,"text":"A proverb","w":0.080541822645399302,"x":0.032774355896515207,"h":0.015369835977838808},{"x":0.10699588546523106,"text":"B","w":0.030864196353488499,"h":0.026162789792430696,"y":0.53197674482554547},{"text":"C","w":0.034979423946804478,"x":0.16666666671315469,"y":0.53197674485669166,"h":0.026162789792430696},{"h":0.0074568288854003351,"w":0.037037035624186206,"y":0.57692307679023269,"text":"B B C","x":0.049382717218771084},{"x":0.1234567904931092,"h":0.011773940345368938,"y":0.71075353234724448,"w":0.1358024681939019,"text":"SUPER SIBLINGS"},{"x":0.034979425427497247,"h":0.013081394896215293,"w":0.049382714165581591,"text":"C16","y":0.75436046525174705},{"x":0.080246913486569219,"text":"Watch the BBC video.","w":0.17901234944661459,"y":0.75431711132357393,"h":0.013124748900696481},{"x":0.032921820487517614,"h":0.014591927431067631,"w":0.28806582980685758,"y":0.76883830468019732,"text":"For the worksheet, go to page 114."},{"w":0.026748970879448795,"text":"48","x":0.055555555980028697,"y":0.95639534901991574,"h":0.013081394896215293},{"x":0.42386831386894563,"text":"4.1","h":0.045058138142201054,"y":0.047965117257024459,"w":0.076131685045030428},{"text":"VOCABULARY","y":0.030523256130347343,"x":0.55349794211418613,"w":0.21399176703559031,"h":0.018895348349770358},{"y":0.072605965158042407,"x":0.55555557030071145,"w":0.3230452473958334,"h":0.013343799058084804,"text":"Appearance • adjective order • personality"},{"w":0.33744856092664932,"text":"I can use language related to appearance and","x":0.55349793838441197,"y":0.094476744455962103,"h":0.013081394896215293},{"text":"personality.","w":0.088829761081271719,"y":0.10830046759061185,"x":0.55537935961673091,"h":0.013050227561962613},{"h":0.011821857614083053,"y":0.16405023536865571,"text":"SHOW WHAT YOU KNOW","x":0.41152263552577639,"w":0.20987653944227436},{"w":0.010288065804375524,"text":"1","x":0.40740740755563115,"h":0.0087209301803325978,"y":0.18749999995343836},{"h":0.011627906907110019,"text":"Think about adjectives to describe parts of the face and write","x":0.4279835511095838,"y":0.18749999996214262,"w":0.45884772406684032},{"text":"down as many as you can in one minute. Compare with a partner.","x":0.43209876257896906,"y":0.20203488379208445,"w":0.47942386203342013,"h":0.01162790690711013},{"text":"hair","y":0.22220370784490162,"w":0.031098723941379081,"h":0.010534444446653524,"x":0.43198150177710692},{"x":0.43004115624648354,"text":"red, light, ...","h":0.013343799058084693,"w":0.092592586941189214,"y":0.24254317090493727},{"x":0.55965080446114424,"w":0.035019378662109357,"h":0.010243154582647906,"y":0.22525632985492583,"text":"eyes"},{"w":0.049382714165581598,"text":"big,...","y":0.24273255813801475,"h":0.011627906907110019,"x":0.55967078345218857},{"text":"ears","x":0.67901234585085279,"w":0.032921810150146391,"y":0.22529069786061029,"h":0.0072674414426602274},{"w":0.061728392706976942,"x":0.67901234685638812,"y":0.24127906960846057,"text":"small, ...","h":0.011627906907110019},{"text":"nose","w":0.037258758544921888,"y":0.22504981008496583,"x":0.79824304850820249,"h":0.0092027056348192859},{"h":0.011817293975566523,"w":0.059670778910319022,"x":0.79629629679312575,"text":"long, ...","y":0.24254317110589541},{"h":0.011627906907110019,"x":0.43209876580029888,"text":"SPEAKING Describe your face. Compare with a partner.","y":0.27034883718597991,"w":0.41358025444878471},{"x":0.43209878025883564,"w":0.38683125813802088,"text":"I've got red hair and big green eyes. My ears are small.","h":0.013081394896215293,"y":0.2892441860547994},{"h":0.013081394896215404,"text":"Home","x":0.44855967110650957,"y":0.35610465144360748,"w":0.049382714165581598},{"y":0.35412583349509585,"text":"Me and Buddy","h":0.017039030275689093,"w":0.11550924513075078,"x":0.56364455549745007},{"y":0.35587719092370818,"text":"Interests","x":0.73037563516331427,"w":0.076285764906141473,"h":0.013536315510748409},{"w":0.082652537027994799,"x":0.87636920375530214,"h":0.012927062844556358,"y":0.35545507309903435,"text":"Favourites"},{"w":0.48919019911024308,"x":0.42515798894242607,"h":0.06370318066942815,"text":"Me and Buddy","y":0.40637515413900505},{"h":0.016164068524466835,"text":"People say that Buddy looks exactly like me.","y":0.4780219781118944,"w":0.43004113091362844,"x":0.44032923308228039},{"text":"I think they're right. What do you think?","y":0.49843014101881433,"w":0.39711934407552085,"h":0.017660910518053297,"x":0.43827160084583749},{"x":0.44032922549672054,"y":0.52616279065981697,"text":"What do we look like?","h":0.011627906907110019,"w":0.18930040147569444},{"y":0.54651162835385125,"h":0.014712861418911261,"x":0.43827160919194486,"text":"We've both got a lot of long dark curly hair I am tall","w":0.39094648573133683},{"w":0.38065843370225688,"y":0.56240188411127201,"x":0.44032921460463287,"h":0.013343799058084804,"text":"and he's really big for a dog. You can say we're both"},{"x":0.4403292351924189,"w":0.36213989257812501,"h":0.011778503983885358,"text":"well-built. We're young (he's only one year old),","y":0.57848837212784032},{"w":0.3703703816731771,"text":"fit and sporty, and we always go jogging together.","h":0.014628435790632333,"x":0.44032921510109518,"y":0.59447674452079491},{"h":0.013081394896215293,"y":0.60901162791526442,"w":0.33950615776909721,"text":"But we've got different eyes: his are small and","x":0.44238684316620569},{"x":0.44032921533752378,"w":0.31687242296006946,"h":0.013343799058084804,"y":0.62637362625858284,"text":"brown and mine are big and green. And, of"},{"w":0.31317966037326395,"h":0.018320194406075241,"text":"course, we're both VERY good-looking! ;)","x":0.44013009979733042,"y":0.64047259343707896},{"text":"What are we like?","h":0.011773940345368827,"y":0.66562009408791911,"x":0.44032922020188325,"w":0.15226337009006086},{"w":0.3086419677734375,"h":0.014669508162996947,"x":0.44032921967001254,"y":0.68445839845823475,"text":"Buddy's very sociable and he's got lots of"},{"y":0.70054945048962436,"w":0.33333333333333337,"text":"friends:). When we go for a jog, he runs up to","x":0.44032921810699588,"h":0.014566827980652342},{"h":0.013081394896215293,"text":"every dog we meet. I'm not unfriendly but I","x":0.44238683281658586,"y":0.71656976745014822,"w":0.32098765055338541},{"text":"don't talk to people I don't know. He's really","w":0.32510287814670141,"x":0.44032922257273971,"h":0.014637563067665282,"y":0.73390894828778575},{"x":0.44032922469939551,"w":0.35596706814236112,"y":0.74999999985092392,"h":0.014534883633887552,"text":"clever and he understands everything that I say"},{"h":0.013081394896215293,"y":0.76598837224665972,"x":0.44032923130063639,"w":0.33950615776909721,"text":"to him. He also knows how to open the fridge"},{"text":"when he's hungry. But he's a little shy when","x":0.4423868363693978,"h":0.011815011969166567,"y":0.78178963910066746,"w":0.32098765055338541},{"text":"people come to see me and prefers to hide under","h":0.016723968919068355,"y":0.79514329691747365,"x":0.44014040976261326,"w":0.37073676215277773},{"x":0.43819398618636984,"h":0.013539811318485917,"w":0.076286926269531263,"text":"the table.","y":0.81372428037732325},{"x":0.44238683444968224,"y":0.8357558146135412,"w":0.25720163981119787,"text":"What have we got in common?","h":0.014715143051027724},{"h":0.014674071427229984,"text":"We're both really interesting and funny and have a great","x":0.43827161265090503,"y":0.85596546309682553,"w":0.42181067572699654},{"text":"sense of humour I love telling jokes and he loves playing","y":0.87205651513236804,"w":0.42181067572699654,"x":0.4382716172033741,"h":0.014571391244885268},{"x":0.43827160996949738,"text":"jokes on me, like hiding my slippers... and food. We're both","w":0.44032921685112852,"h":0.013081394896215293,"y":0.88808139550247389},{"y":0.90541601221829959,"text":"very positive and we smile a lot. He's my best friend.","x":0.43827160090020584,"w":0.3888888888888889,"h":0.014642127080465306},{"x":0.44032922723946261,"y":0.92877906990290982,"text":"So what about you? Does your dog look like you? Upload your photo and","w":0.47942386203342008,"h":0.013136157809845894},{"x":0.44032921978413142,"w":0.10905349731445313,"y":0.94331395345051472,"text":"write about you.","h":0.01162790690711013}]
[{"y": 0.026555232575999444, "h": 0.016630688367767866, "w": 0.2540250481499566, "text": "EXAM SPEAKING", "x": 0.19141323409437178}, {"h": 0.016488639507913412, "y": 0.08462186913394429, "x": 0.09986936941408228, "w": 0.3029128011067709, "text": "1 In pairs, ask and answer the questions."}, {"y": 0.10465675493726424, "h": 0.010715560009333172, "text": "PART 1", "x": 0.11973456077914212, "w": 0.04854518890380859}, {"x": 0.11933926536779599, "text": "Talk about holidays.", "h": 0.01663287493296053, "y": 0.11932684516616573, "w": 0.14780578613281248}, {"y": 0.1353052327028984, "x": 0.12164580504912502, "w": 0.309481201171875, "h": 0.013909883895075253, "text": "1 What's the best holiday you've ever had?"}, {"text": "2 Where do you think you'll go on your next holiday?", "h": 0.017221161312144632, "x": 0.12135954381221963, "w": 0.3779225667317708, "y": 0.14864048464239712}, {"w": 0.00894454320271812, "y": 0.16312500010381883, "x": 0.12164579648898083, "h": 0.008851743820341951, "text": "3"}, {"y": 0.16312499989185195, "text": "Would you prefer to stay in a youth hostel", "w": 0.2951699490017361, "x": 0.1413237862325847, "h": 0.013937274368231051}, {"x": 0.11627906951897592, "text": "4", "w": 0.01252236154344348, "y": 0.19094476771406124, "h": 0.010116278651819414}, {"y": 0.17824007249954893, "w": 0.16100179036458334, "h": 0.012704694839160872, "x": 0.14311270231323603, "text": "or at a campsite? Why?"}, {"y": 0.19080324889394168, "w": 0.2987477620442708, "text": "Which foreign countries have you visited?", "x": 0.13237925198323122, "h": 0.014133574007220224}, {"h": 0.008851743820341951, "text": "5", "x": 0.11806797872953192, "y": 0.20485465140886977, "w": 0.010733451843261715}, {"x": 0.13200783267721009, "text": "Which continent in the world would you most like", "w": 0.3532071261935764, "h": 0.022065613312841754, "y": 0.2002850177378031}, {"x": 0.13774597418400789, "h": 0.014133574007220224, "y": 0.21867779766000717, "w": 0.10017889234754773, "text": "to visit? Why?"}, {"y": 0.23886652514106096, "x": 0.0927366786155441, "h": 0.016384642872999667, "text": "2 Look at the photos of the animals.", "w": 0.27253387451171873}, {"text": "PART 1", "x": 0.11441227671811852, "y": 0.2590687764114891, "w": 0.04666739569769965, "h": 0.011702563556092793}, {"y": 0.27387516631711295, "text": "Take turns to describe the photos.", "x": 0.11229322713036885, "h": 0.018176396762420974, "w": 0.2531280178493923}, {"text": "PART 2", "y": 0.1099277977839675, "x": 0.5617173526418603, "w": 0.04830053541395396, "h": 0.010207581227436872}, {"h": 0.01360601123919986, "y": 0.12577091237086796, "text": "Talk about the environment.", "x": 0.5632228399479678, "w": 0.20630279541015628}, {"y": 0.14036337206917743, "h": 0.013928143960904636, "text": "1 Which wild animal would you most like to see in its", "x": 0.5617173592817692, "w": 0.37924865722656254}, {"w": 0.15563505384657128, "x": 0.5831842633271617, "h": 0.014133574007220224, "text": "natural habitat? Why?", "y": 0.1554693138179876}, {"x": 0.5617173527009094, "text": "2", "y": 0.16818313960708922, "h": 0.008851743820341854, "w": 0.010733451843261799}, {"x": 0.5755796943112435, "h": 0.02320917942033349, "y": 0.1654733522012668, "w": 0.3604643419053819, "text": "Would you prefer to live in a forest, in the mountains,"}, {"w": 0.3316403198242187, "x": 0.5846679154332881, "y": 0.17974857877259065, "text": "on a small island on a lake or at the seaside? Why?", "h": 0.01910623585704429}, {"h": 0.020197223308714752, "w": 0.3227539401584202, "text": "What's your favourite type of weather? Why?", "x": 0.573882083011986, "y": 0.1942474438238852}, {"x": 0.55813953503323, "y": 0.20991279084342174, "h": 0.010116278651819317, "w": 0.014311270183987146, "text": "4"}, {"y": 0.21117732586324303, "h": 0.015352457550888862, "w": 0.31305901421440974, "text": "What do you think is the biggest danger to", "x": 0.570661902217482}, {"x": 0.5829412245207982, "text": "the environment in your country at the moment?", "y": 0.2249570649120886, "h": 0.01532233312241866, "w": 0.3385132175021701}, {"y": 0.2376362501639371, "x": 0.5596421929108576, "h": 0.01710798859165896, "text": "5 What things can we all do to help the environment?", "w": 0.38328338623046876}, {"text": "1310", "y": 0.3692441862403471, "w": 0.026833629608154302, "h": 0.006322674157387121, "x": 0.16457960693116436}, {"y": 0.5120835050271347, "h": 0.011487059210181635, "text": "PART 2", "w": 0.04835048675537111, "x": 0.105520642614878}, {"text": "In pairs, ask and answer the questions about the photos.", "h": 0.01710851651236472, "w": 0.40295762803819446, "x": 0.10532744860783858, "y": 0.5284803846577641}, {"x": 0.10375670842739854, "y": 0.5488081395869101, "text": "Student A's photo", "w": 0.13416815863715278, "h": 0.013909883895075253}, {"text": "1 What types of landscape does the photo show?", "h": 0.018484365483914047, "x": 0.1035289396558964, "w": 0.35641815185546877, "y": 0.5626471505893764}, {"h": 0.015325066328909419, "y": 0.5778924423636064, "x": 0.1162790733753511, "text": "What can you see in the photo?", "w": 0.23255813598632813}, {"x": 0.12522361749394773, "y": 0.5916471115777127, "text": "What are the people doing?", "w": 0.19856886121961803, "h": 0.014133574007220224}, {"w": 0.18067977905273438, "x": 0.12701252815401434, "text": "What is the animal doing?", "h": 0.013909883895075253, "y": 0.6057122094470844}, {"y": 0.6195216603015294, "text": "What do you think will happen to this animal's", "x": 0.1252236070150129, "w": 0.3202146742078993, "h": 0.012745781297718117}, {"x": 0.12522361661096126, "text": "home in the future?", "y": 0.6335319769025787, "w": 0.1377459716796875, "h": 0.010116278651819317}, {"w": 0.1341681501600478, "h": 0.013909883895075253, "text": "Student B's photo", "x": 0.5366726316954681, "y": 0.5538662788088213}, {"x": 0.5380171645606604, "y": 0.5656000212829019, "text": "1 What can you see in this photo?", "w": 0.2459565056694878, "h": 0.018523484033798058}, {"y": 0.581401237571978, "text": "2 What animals does the photo show?", "x": 0.5346439436693979, "h": 0.016498481297751184, "w": 0.27953209771050347}, {"y": 0.5918023256536008, "h": 0.008851743820341951, "x": 0.10375670869375375, "w": 0.01073345184326173, "text": "3"}, {"h": 0.0075872089888644875, "text": "4", "w": 0.008944543202718092, "x": 0.1037567086311991, "y": 0.605712209383184}, {"x": 0.10375670881008997, "h": 0.008851743820341854, "w": 0.008944543202718105, "text": "5", "y": 0.619622093353637}, {"x": 0.5366726299415748, "w": 0.008944543202718092, "y": 0.5968604651781695, "h": 0.0075872089888644875, "text": "3"}, {"text": "What are the animals doing?", "x": 0.5581395367934285, "h": 0.015311371841155259, "y": 0.59675090222915, "w": 0.20214669121636286}, {"y": 0.6107703489096376, "text": "4", "x": 0.5366726302501045, "w": 0.010733451843261688, "h": 0.0075872089888644875}, {"text": "What other things can you see in the water?", "w": 0.30590338812934026, "h": 0.012677304366004975, "x": 0.5599284493387288, "y": 0.6107703492564938}, {"text": "5", "x": 0.5366726299519529, "y": 0.623415697714788, "w": 0.010733451843261799, "h": 0.010116278651819317}, {"text": "What do you think will happen to this animal", "x": 0.5456171677939842, "y": 0.6246254514615287, "h": 0.014133574007220224, "w": 0.32379248725043397}, {"text": "in the future?", "x": 0.5563506257667258, "y": 0.638590116530195, "h": 0.010116278651819317, "w": 0.09660107082790803}, {"x": 0.07847344413590558, "w": 0.6319324408637153, "y": 0.653669764593929, "h": 0.019280853305912993, "text": "3 Read the instructions on your card. In pairs, take turns to role-play the conversation."}, {"x": 0.12701252248063907, "w": 0.0733452606201172, "y": 0.6827301443054454, "h": 0.009029783393501837, "text": "Student A"}, {"h": 0.010732483799276797, "y": 0.6863343391893953, "w": 0.07351054721408423, "x": 0.5437456199731808, "text": "Student B"}, {"text": "You and Student B are talking about", "y": 0.7055009025616332, "w": 0.2683363003200955, "h": 0.014133574007220224, "x": 0.125223622961598}, {"y": 0.7195203490984269, "w": 0.30769229465060766, "h": 0.012677304366005072, "text": "eco-week. Tell Student B your ideas. Then", "x": 0.12522362319347968}, {"y": 0.7333754515089488, "text": "listen to his/her ideas and say if you agree/", "h": 0.014133574007220224, "w": 0.318425767686632, "x": 0.1234346971495285}, {"x": 0.12517328939460268, "y": 0.7471841088198888, "text": "disagree.", "w": 0.0698680920071072, "h": 0.011692828848043514}, {"w": 0.3148479207356771, "x": 0.12164581100962109, "y": 0.7650436045166702, "text": "• Say that planting a tree in the playground", "h": 0.013909883895075349}, {"h": 0.011417334738190914, "text": "will help the environment", "x": 0.14490160979866726, "w": 0.178890872531467, "y": 0.7789169673997147}, {"x": 0.12164578917993993, "y": 0.7928633723795315, "h": 0.0127503461269696, "w": 0.3184257676866319, "text": "• Say that all students should walk to school"}, {"w": 0.270828382703993, "y": 0.8048732186882601, "x": 0.14457972498203428, "text": "during eco-week because this will help", "h": 0.01722538467779062}, {"y": 0.8204662754466587, "h": 0.011814541902783117, "text": "stop pollution.", "x": 0.14485401999156128, "w": 0.10206297980414497}, {"x": 0.1196745086599787, "h": 0.014511420709561766, "text": "• Agree that Student B has a point.", "y": 0.8343222686594525, "w": 0.2561564127604167}, {"text": "• Listen, disagree and explain why.", "x": 0.11955027613148057, "h": 0.016351573320932743, "w": 0.2563936360677083, "y": 0.8471834464665965}, {"w": 0.25827551947699656, "text": "You and Student A are talking about", "x": 0.5434842077650981, "h": 0.017048045254786575, "y": 0.7073975662691658}, {"w": 0.3314685397677952, "x": 0.5435841426104673, "y": 0.7219490337937015, "text": "eco-week. Listen to Student A's ideas and say if", "h": 0.01687267523810315}, {"text": "you agree/disagree. Then tell him/her your ideas.", "w": 0.3492861599392362, "h": 0.017230344885953472, "x": 0.5400371308278732, "y": 0.7375643317139029}, {"w": 0.2486583116319444, "h": 0.011426464771105508, "text": "• Listen and agree with Student A", "x": 0.5420393624979811, "y": 0.7561462093649832}, {"w": 0.2719141303168403, "x": 0.540250444859469, "text": "• Listen, agree in part with Student A", "y": 0.7701017444053355, "h": 0.011563417885708053}, {"text": "and explain why", "y": 0.7840116282187757, "w": 0.11627906799316401, "h": 0.012645348314774147, "x": 0.5617173521393751}, {"w": 0.2829495578342014, "h": 0.013264239118417667, "text": "• Now share your ideas with Student A", "x": 0.5400937436862321, "y": 0.7973683381005846}, {"y": 0.8105668605155779, "text": "Say that everyone should turn off all", "x": 0.5635062626776682, "w": 0.2522361246744791, "h": 0.012713825246487289}, {"text": "the lights and electrical devices all week to", "x": 0.561717358203814, "y": 0.8256362815187896, "w": 0.3005366685655382, "h": 0.012750346126969504}, {"x": 0.5613799870549405, "text": "save electricity.", "y": 0.8375104893441989, "w": 0.1081059265136719, "h": 0.01385144419618464}, {"x": 0.5384615410677869, "text": "• Agree that Student A has a point.", "h": 0.012695564431834262, "w": 0.2558139546712239, "y": 0.8535108306557855}, {"text": "• Say yes and end the conversation.", "y": 0.8763736262585828, "h": 0.013343799058084693, "w": 0.2633744812011719, "x": 0.11934157037335082}, {"x": 0.561728399924467, "w": 0.20370369805230037, "h": 0.013343799058084804, "y": 0.8806907380801879, "text": "the week will help the planet."}, {"h": 0.016616833266133946, "y": 0.8932907035121764, "x": 0.5327115383200154, "w": 0.35643564860026034, "text": "• Offer to tell your teacher the ideas you both have."}, {"y": 0.9520348836976079, "w": 0.03703703562418614, "h": 0.01162790690711002, "text": "105", "x": 0.8868312767969604}]
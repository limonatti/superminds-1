[{"x": 0.20566544901331782, "y": 0.025057178453289766, "text": "READING", "w": 0.14859754774305553, "h": 0.019435061564944702}, {"text": "Working away from home", "h": 0.014133574007220224, "x": 0.20214669578325317, "w": 0.19499104817708335, "y": 0.06556407975281286}, {"h": 0.012700130009909388, "y": 0.08087545108207075, "x": 0.20035778381089003, "text": "• phrasal verbs and collocations", "w": 0.24329159206814238}, {"x": 0.20035778257306652, "y": 0.09484011601812371, "text": "• daily routine", "w": 0.11091233995225691, "h": 0.013909883895075253}, {"w": 0.34883721245659716, "x": 0.5402504412895905, "text": "Read the text quickly and choose the best title.", "h": 0.012672739536753685, "y": 0.04043772538153459}, {"y": 0.05690406950649584, "text": "A I love my long holidays at home", "x": 0.5420393574178279, "w": 0.24686940511067712, "h": 0.013909883895075253}, {"x": 0.5438282813414931, "text": "B Life is difficult when my husband comes home", "y": 0.07459386312202343, "w": 0.3416815524631077, "h": 0.012659043551352046}, {"w": 0.23434704250759553, "h": 0.012695564431834262, "text": "C This is not the right job for me", "x": 0.5420393608422069, "y": 0.09226083061363417}, {"x": 0.08944544684427247, "y": 0.364186046392942, "text": "Arthur lives in Portsmouth with his wife and three", "w": 0.46690517849392366, "h": 0.013909883895075253}, {"y": 0.38062500014441103, "text": "children. He has a good job but he isn't happy. Arthur is", "x": 0.08944544611381111, "h": 0.017863267148014502, "w": 0.5223613484700521}, {"y": 0.39959302315775824, "h": 0.016562211436054724, "x": 0.08765653879845205, "w": 0.5223613484700521, "text": "the captain of a large tanker. He loves ships and the sea"}, {"h": 0.01652569055557251, "text": "and is good at his job. He earns a lot of money and has", "w": 0.5134168158637153, "x": 0.0876565338615233, "y": 0.41729651179856475}, {"x": 0.08765653701859971, "h": 0.016489169675090197, "w": 0.5152057223849826, "text": "a lot of free time at work to study languages and write.", "y": 0.43499999998097766}, {"x": 0.08765653214076634, "w": 0.22182467990451388, "y": 0.45143895363278314, "h": 0.017717183626085445, "text": "So what's the problem?"}, {"text": "Arthur has a 'three months on", "x": 0.08944544572109951, "h": 0.011449290415009824, "y": 0.4855813953942529, "w": 0.2558139377170139}, {"y": 0.5005640794892705, "text": "= two months off' contract, which", "x": 0.08586762024270324, "w": 0.2593917677137587, "h": 0.012955776173285189}, {"text": "means that he goes to sea for three", "w": 0.2593917677137587, "h": 0.012645348314774147, "x": 0.08586761808110528, "y": 0.5146656979777873}, {"text": "months and then has two months'", "x": 0.08765652997444559, "y": 0.5284386281111625, "w": 0.2576028611924913, "h": 0.010253232515245504}, {"text": "holiday. This means that some years", "x": 0.08586762499821901, "y": 0.5424854653269152, "h": 0.012649913892849272, "w": 0.2593917677137587}, {"text": "he isn't at home for Christmas,", "x": 0.08586762564669843, "y": 0.5574909748059993, "h": 0.011549722649130153, "w": 0.2593917677137587}, {"x": 0.08407871737264795, "w": 0.26118067423502606, "y": 0.5715697676524966, "h": 0.012645348314774147, "text": "some years he is away during the"}, {"x": 0.08586762106261984, "w": 0.25939176771375866, "y": 0.5841877254870101, "h": 0.013937274368231051, "text": "summer holidays and every year"}, {"h": 0.017093347590752896, "y": 0.5963534531766267, "w": 0.2616837395562066, "x": 0.08384396222775713, "text": "he misses someone's birthday,"}, {"text": "school shows and other special", "y": 0.6132400722466419, "w": 0.2593917677137587, "h": 0.012704694839160872, "x": 0.08586762564669843}, {"y": 0.6272093021858198, "w": 0.25939176771375866, "h": 0.013909883895075349, "text": "days. His children are twelve, ten", "x": 0.08407871580024641}, {"y": 0.6411146209563141, "text": "and six and they grow quickly", "h": 0.013914448724326735, "w": 0.25939176771375866, "x": 0.08407871267710997}, {"x": 0.08394978107069448, "y": 0.6558508987524574, "text": "at that age.", "w": 0.08433657328287761, "h": 0.01353076044833183}, {"w": 0.2597981431749132, "x": 0.08389263034209436, "y": 0.670859739701264, "text": "When Arthur comes home, the", "h": 0.015036558037630415}, {"h": 0.013909883895075253, "text": "children spend a day or two just", "x": 0.08407871111181484, "w": 0.2593917677137587, "y": 0.6866424415995189}, {"x": 0.08228980860699493, "y": 0.7018168602895264, "h": 0.013909883895075253, "w": 0.26118067423502606, "text": "looking at him and trying to think"}, {"w": 0.261180674235026, "y": 0.7157084836958378, "x": 0.08228980381868259, "text": "of what to say. The last week of his", "h": 0.012663609129427173}, {"y": 0.7294494582382893, "h": 0.012955776173285189, "text": "leave is filled with tears. There are", "x": 0.08050089572203224, "w": 0.2629695807562934}, {"h": 0.012695564431834358, "y": 0.7447608305925586, "w": 0.25939176771375866, "x": 0.08228980703459349, "text": "also good times. The family have"}, {"x": 0.0822898067257938, "y": 0.7587209304395813, "text": "parties to celebrate any birthdays", "w": 0.2593917677137587, "h": 0.0127366508903917}, {"h": 0.013909883895075253, "y": 0.4855813952143447, "w": 0.25939176771375877, "text": "missed and they sometimes have", "x": 0.3720930281511707}, {"w": 0.2558139546712239, "text": "Christmas dinner in November", "y": 0.49938628142439495, "h": 0.010221276464014675, "x": 0.37388193356182386}, {"w": 0.2576028611924913, "h": 0.012681869944080102, "x": 0.3720930256351198, "y": 0.5134011628411594, "text": "or January but there is always"}, {"x": 0.3703041139815226, "w": 0.25939176771375866, "h": 0.014133574007220224, "y": 0.5272608303812598, "text": "a feeling of sadness that they can't"}, {"w": 0.1896243286132812, "h": 0.013909883895075253, "x": 0.3703041166593701, "y": 0.5424854649912706, "text": "happen at the right time."}, {"w": 0.2598493957519531, "h": 0.015228086172028121, "y": 0.5576965216445653, "x": 0.37009957619239886, "text": "Life is also difficult for his wife,"}, {"x": 0.37030411830471877, "text": "Theresa. She is a teacher and, for", "y": 0.5728023468834127, "w": 0.2593917677137586, "h": 0.014133574007220224}, {"w": 0.2576028611924913, "text": "three months, has no husband to", "x": 0.3720930280799617, "h": 0.01266817395867856, "y": 0.5880087211071479}, {"h": 0.013932709538979664, "text": "help her with shopping, cooking.", "w": 0.2593917677137587, "x": 0.6601073359463407, "y": 0.1605731043624824}, {"w": 0.2576028611924913, "x": 0.6601073376327347, "text": "cleaning and checking homework.", "y": 0.17577034907313618, "h": 0.012677304366004975}, {"w": 0.2593917677137587, "text": "She is very strict, so the children", "x": 0.6583184298059114, "h": 0.013909883895075253, "y": 0.18841569741347253}, {"y": 0.20359011645598502, "w": 0.2593917677137587, "x": 0.6583184295748439, "text": "help with the housework, go to bed", "h": 0.012732086061140313}, {"text": "at nine o'clock and get up for school", "y": 0.21623546558148435, "x": 0.6583184277889167, "w": 0.2593917677137587, "h": 0.015174417977728975}, {"x": 0.6601073313763737, "w": 0.2558139546712239, "h": 0.012955776173285189, "text": "without any problems. Theresa", "y": 0.2312409748668958}, {"w": 0.2580658467610677, "x": 0.6580853787677556, "y": 0.24358136634347252, "h": 0.015964113219980702, "text": "prepares dinners in advance and"}, {"x": 0.6583184295748439, "text": "makes the most of every hour", "y": 0.2591155231412596, "w": 0.2593917677137587, "h": 0.012759476534296018}, {"x": 0.6583184261833711, "w": 0.2593917677137587, "h": 0.013909883895075349, "text": "of the day. Then, Arthur comes", "y": 0.27313953497052185}, {"y": 0.2869900723414821, "w": 0.2593917677137587, "text": "home. He ignores the normal", "h": 0.012704694839160775, "x": 0.65831842309005}, {"w": 0.2611806742350261, "text": "bedtimes because he wants to tell", "x": 0.654740607784097, "h": 0.012955776173285189, "y": 0.2995532488523336}, {"y": 0.314864621066961, "h": 0.01391444872432664, "x": 0.6565295205003914, "w": 0.2593917677137587, "text": "his children stories and play with"}, {"y": 0.328605595511411, "h": 0.014133574007220224, "x": 0.6565295212191492, "w": 0.2593917677137587, "text": "them. The children stop doing"}, {"x": 0.6583184295110889, "text": "housework and, because they go", "y": 0.3439169676476732, "h": 0.011417334363778899, "w": 0.2576028611924913}, {"h": 0.0127503461269696, "y": 0.3578633722699385, "text": "to bed late, they are tired when", "x": 0.658318430584434, "w": 0.2576028611924913}, {"text": "they get up in the morning.", "y": 0.3705087206692864, "h": 0.013909883895075349, "x": 0.6565295210849811, "w": 0.2593917677137587}, {"h": 0.011531462583300867, "y": 0.3855324908122356, "x": 0.6583184252177078, "text": "Of course, Theresa understands", "w": 0.2576028611924913}, {"y": 0.3995930233078403, "w": 0.2576028611924913, "x": 0.6565295161658294, "h": 0.013909883895075349, "text": "and is pleased to see her family so"}, {"h": 0.014133574007220224, "text": "happy, but it takes a week or more", "x": 0.6565295193654206, "y": 0.4134070394215761, "w": 0.2576028611924913}, {"h": 0.013909883895075253, "y": 0.4274127905631819, "x": 0.6547406142688912, "text": "to get life back to normal when", "w": 0.261180674235026}, {"y": 0.4412815883793317, "h": 0.012686434773331489, "x": 0.6583184271510822, "w": 0.17889087253146696, "text": "Arthur goes back to sea."}, {"text": "Now, Arthur wants to find a job", "x": 0.6583184277269998, "y": 0.45894855599793904, "w": 0.2558139546712239, "h": 0.011458420447924517}, {"y": 0.47151173264322865, "h": 0.014133574007220224, "w": 0.2593917677137587, "text": "on land but he knows it isn't easy.", "x": 0.6547406114025124}, {"h": 0.013932709538979664, "y": 0.48682310445416116, "x": 0.6547406131243371, "w": 0.2593917677137587, "text": "What can a ship's captain do when"}, {"y": 0.49938628160264653, "h": 0.015311371841155162, "text": "he isn't on a ship? Arthur's dream", "x": 0.6529516989737214, "w": 0.261180674235026}, {"x": 0.6529517048502864, "text": "is to be a writer of children's books", "h": 0.011417334738190817, "y": 0.5146656978715783, "w": 0.2611806742350261}, {"y": 0.5272608305183486, "x": 0.6547406097883698, "w": 0.2576028611924913, "h": 0.015311371841155259, "text": "and work from home. This dream"}, {"text": "cheers him up when he is on the", "h": 0.012645348314774242, "x": 0.6547406124758576, "w": 0.2593917677137587, "y": 0.5437500002106361}, {"w": 0.2576028611924913, "y": 0.557490974786039, "x": 0.6547406086748719, "h": 0.01154972302354207, "text": "other side of the world and still"}, {"y": 0.5715697676390201, "text": "has two months before he sees his", "w": 0.2611806742350261, "x": 0.6529517048502864, "h": 0.011440160007683409}, {"x": 0.6529517006997606, "text": "family again.", "w": 0.10196779886881513, "y": 0.5853655235734065, "h": 0.014133574007220224}, {"y": 0.8143604652375669, "w": 0.0733452606201172, "h": 0.011380813483296684, "x": 0.07155634992249954, "text": "GLOSSAR"}, {"y": 0.8333284886965372, "w": 0.23971377902560764, "text": "tanker (n) - a large ship that carries", "x": 0.08050089024271201, "h": 0.012722955653813801}, {"h": 0.01138081348329678, "text": "oil", "x": 0.0805008951648455, "y": 0.8472383721858587, "w": 0.01967799504597982}, {"x": 0.33810375732013276, "text": "leave (n) - time that you are allowed", "w": 0.24329159206814233, "h": 0.012722954904990062, "y": 0.8333284887913776}, {"x": 0.3381037563894334, "h": 0.012654478722100659, "y": 0.8472292417361584, "w": 0.20214669121636292, "text": "to spend away from your work"}, {"y": 0.8333284882059872, "x": 0.6046511674349307, "h": 0.013909883895075253, "text": "strict (adj) - expecting people to obey rules", "w": 0.2987477620442709}, {"text": "or to do what you say", "x": 0.6082289862208313, "y": 0.8484070396222395, "w": 0.14311269124348958, "h": 0.011476681262577447}, {"x": 0.06790123486248467, "w": 0.0246913570827908, "text": "16", "y": 0.9375000002989855, "h": 0.013081394896215293}]
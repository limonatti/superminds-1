45184326171, "text": "can learn them.", "x": 0.5778175368480921, "y": 0.7321656978833927, "h": 0.010239536904255879}, {"x": 0.5295169952664296, "h": 0.011426464771105508, "text": "WORD STORE 6E | Collocations", "y": 0.7549273257713291, "w": 0.24150268554687504}, {"text": "7 Choose the correct option.", "x": 0.5313059057151539, "h": 0.011549722649130153, "w": 0.21645796034071174, "y": 0.7749909747775473}, {"w": 0.04293380737304686, "text": "Amy:", "x": 0.5527728103116877, "h": 0.012645348314774242, "y": 0.7928633725123075}, {"w": 0.3005366685655382, "x": 0.6010733448466287, "y": 0.7914801442109907, "text": "I want to keep / do fit. What do you think", "h": 0.012955776173285189}, {"text": "I should do?", "w": 0.08952251858181426, "h": 0.011687187584728972, "x": 0.6099793500104302, "y": 0.8066200689570638}, {"w": 0.03935599009195967, "h": 0.008851743820341854, "text": "Lou:", "x": 0.5527728106188979, "y": 0.8206831396966605}, {"w": 0.241502668592665, "x": 0.6118068092635959, "text": "I think you should 2go / join a gym.", "y": 0.8193546928099187, "h": 0.012709260417235902}, {"text": "There's a new one in the town and it 3runs /", "y": 0.8345930234913551, "w": 0.2951699490017361, "h": 0.008851743820341951, "x": 0.6135957028247133}, {"w": 0.18604649861653644, "h": 0.011476680888165624, "text": "gives classes for teenagers.", "x": 0.613595715450229, "y": 0.8484070397911644}, {"y": 0.8636773259995418, "text": "Amy.", "x": 0.5491949950074586, "w": 0.046511624654134165, "h": 0.005058138951497837}, {"text": "That counde arostl", "x": 0.610017888477618, "y": 0.8609702166454825, "w": 0.130590337117513, "h": 0.007851985559566801}, {"text": "my sister but, at times, she makes me angry.", "y": 0.8793604651026464, "w": 0.30658433702256943, "h": 0.01162790690711013, "x": 0.10493828927335158}, {"text": "At that time = then: When / was young, I played tennis.", "y": 0.898255814016282, "x": 0.1069958920836147, "w": 0.3827160305447048, "h": 0.013081394896215293}, {"y": 0.912790697867800